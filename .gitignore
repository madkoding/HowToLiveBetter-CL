# Artefactos locales
__pycache__/
*.pyc
verificacion.json
datos.json.tmp
.DS_Store

# Cachés de descarga de fuentes: no son contenido, se regeneran
.fuentes/
_cache/
_raw/
tools/.cache/
docs/investigacion/.venv/
docs/investigacion/_cache/
docs/investigacion/_raw/
docs/investigacion/*.py

# Dossiers de redacción (_brief): contienen el texto original en inglés con fuentes
# del país de origen. Son material de trabajo interno, no capítulos de la guía.
docs/briefs/

# Se conserva a propósito: docs/investigacion/*.md (informes con fuentes citadas),
# docs/investigacion/anclas-verificadas.md y docs/verificacion/ (registro de pendientes).
