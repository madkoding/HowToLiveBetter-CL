# Artefactos locales
__pycache__/
*.pyc
verificacion.json
datos.json.tmp
.DS_Store

# Cachés de descarga de fuentes: no son contenido, se regeneran
.fuentes/
_cache/
_raw/
tools/.cache/
docs/investigacion/.venv/
docs/investigacion/_cache/
docs/investigacion/_raw/
docs/investigacion/*.py

# Dossiers de redacción (_brief): contienen el texto original en inglés con fuentes
# del país de origen. Son material de trabajo interno, no capítulos de la guía.
docs/briefs/

# Los .xml crudos de LeyChile no se versionan: son JSON con HTML embebido, duplican los .txt
# (que sí se conservan, ya limpios y citados por los capítulos) y se regeneran con tools/leychile.py.
docs/investigacion/fuentes/*.xml

# Se conserva a propósito: docs/investigacion/*.md (informes con fuentes citadas),
# docs/investigacion/anclas-verificadas.md, docs/investigacion/fuentes/*.txt
# y docs/verificacion/ (registro de pendientes).
