    <script>
      $(document).ready(function() {

        $('#cerrarSesion').click(function(){
                window.location.href="https://api.claveunica.gob.cl/api/v1/accounts/app/logout";
                setTimeout(function(){
                    window.location.href= $(location).attr('pathname').split("/")[0]+"/logout-claveunica";
                }, 1000);
        });

        $('#select').select2({
          ajax: {
            url: "https://www.hospitaldigital.gob.cl/search",
            dataType: 'json',
            delay: 250,
            cache: false,
            data: function (params) {
              return {
                q: params.term,
                _token: "a4vC455Mbtzm4UzRtybBMWe0QHbqloOA2tbF3TTx"
              };
            },
            processResults: function(data, params) {
              return {
                results: data
              };
            },
          },
          placeholder: "Escribe tu búsqueda",
          allowClear: true,
          width: 'style'
        });

        $('#select').on('select2:select', function (e) {
          var data = e.params.data;
          window.location.href = data.url;
        });

        let viewModal = localStorage.getItem("showModal");
        if(!viewModal && /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent)){
          $('#modalDownloadApp').modal('show');
          localStorage.setItem("showModal", true)
        }


        (function() {
          // new UIMorphingButton( document.querySelector('.inclusividad__container'), {
          //   closeEl: '.icon-close'
          // } );
        })();
      });
