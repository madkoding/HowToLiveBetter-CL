<script>
    var eventsToCapture = 'keydown click play change load blur focus beforeprint drag dblclick';
        $(window).on(eventsToCapture, function(event) {
            var eventTargetIsBlank = event.target.name == undefined || event.target.name == '';
            var eventTargetName = eventTargetIsBlank ? 'body' : event.target.name;
            var page;
            if (
                window.location.pathname.split('/').slice(-1) == '' ||
                window.location.pathname.split('/').slice(-1) == null ||
                window.location.pathname.split('/').slice(-1) == undefined
            ) {
                page = 'index';
            } else {
                page = window.location.pathname.split('/').slice(-1);
            }
            var eventTargetValueIsBlank = event.target.value == undefined || event.target.value == '';
            var eventTargetValue = eventTargetValueIsBlank ? 'default' : event.target.value;
            var settings = {
            async: true,
            crossDomain: true,
            url: 'https://clickstream.minsal.cl',
            method: 'POST',
            headers: {
                event: event.type,
                site: 'hospitaldigital',
                page: page,
                target: eventTargetName,
                value: eventTargetValue
            }
            };
            console.log(settings)
            //$.ajax(settings).done(function(response) { console.log(response); } );
        });
</script>

<script>
    $("#user-rol-button").click(function(){
        $("#init-modal-ayuda").hide();
        $("#user-modal-ayuda").show();
    });

    $("#prestador-rol-button").click(function(){
        $("#init-modal-ayuda").hide();
        $("#prestador-modal-ayuda").show();
    });

    $("#modal-ayuda-not-found").click(function(){
        $("#user-modal-ayuda").hide();
        $("#not-found-modal-ayuda").show();
    });

    $('#modalAyuda').on('hidden.bs.modal', function (e) {
        $("#prestador-modal-ayuda").hide();
        $("#user-modal-ayuda").hide();
        $("#not-found-modal-ayuda").hide();
        $("#init-modal-ayuda").show();
    });

    $("#modal-ayuda-scroll").on('scroll', function() {
        $(".popover").hide();
    });

    $(function () {
        $('[data-toggle="popover"]').popover()
    });

    $("#search-problema-modal").on("keyup", function() {
        var value = $(this).val().toLowerCase();
        $("#problemas-list-modal a").filter(function() {
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
        });
    });

</script>
