  font-size: 13px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  opacity: 0.9;
}

#pni-review-app .pni-score-card strong {
  display: block;
  margin: 14px 0 4px;
  color: #ffffff;
  font-size: 46px;
  line-height: 1;
  font-weight: 900;
}

#pni-review-app .pni-score-card em {
  display: block;
  margin-bottom: 16px;
  font-size: 18px;
  font-style: normal;
  font-weight: 800;
}

#pni-review-app .pni-score-track {
  height: 10px;
  overflow: hidden;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.26);
}

#pni-review-app .pni-score-track i {
  display: block;
  height: 100%;
  border-radius: 999px;
  background: #ffffff;
  transition: width 0.45s ease;
}

#pni-review-app .pni-executive-copy {
  padding: 22px;
  border-radius: 22px;
  background: #f8fafc;
  border: 1px solid #dbe4ef;
}

#pni-review-app .pni-executive-copy h2 {
  margin: 0 0 10px;
  color: #073b7a;
}

#pni-review-app .pni-executive-copy p {
  margin: 0;
  color: #334155;
  font-size: 15px;
  line-height: 1.65;
}

#pni-review-app .pni-executive-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 16px;
}

#pni-review-app .pni-executive-card {
  padding: 16px;
  border-radius: 16px;
  background: #ffffff;
  border: 1px solid #dbe4ef;
}

#pni-review-app .pni-executive-card strong {
  display: block;
  margin-bottom: 6px;
  color: #073b7a;
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

#pni-review-app .pni-executive-card span {
  color: #1f2937;
  font-size: 18px;
  font-weight: 900;
}

#pni-review-app .pni-executive-two-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  margin: 16px 0 18px;
}

#pni-review-app .pni-executive-three-col {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 14px;
  margin-top: 18px;
}

#pni-review-app .pni-mini-panel {
  padding: 18px;
  border-radius: 18px;
  background: #f8fafc;
  border: 1px solid #dbe4ef;
}

#pni-review-app .pni-mini-panel h3 {
  margin: 0 0 12px;
  color: #073b7a;
  font-size: 18px;
}

#pni-review-app .pni-mini-panel ul,
#pni-review-app .pni-mini-panel ol {
  margin: 0;
  padding-left: 20px;
}

#pni-review-app .pni-mini-panel li {
  margin-bottom: 8px;
  color: #334155;
  line-height: 1.45;
}

#pni-review-app .pni-mini-panel li:last-child {
  margin-bottom: 0;
}

#pni-review-app .pni-empty-mini {
  color: #64748b;
  font-size: 14px;
  font-weight: 700;
}

/* Estadísticas */
#pni-review-app .pni-stat-list {
  display: grid;
  gap: 8px;
}

#pni-review-app .pni-stat-row {
  padding: 10px 12px;
  border-radius: 13px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
}

#pni-review-app .pni-stat-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 6px;
}

#pni-review-app .pni-stat-label span {
  color: #334155;
  font-size: 13px;
  font-weight: 800;
}

#pni-review-app .pni-stat-label strong {
  color: #073b7a;
  font-size: 13px;
  font-weight: 900;
}

#pni-review-app .pni-stat-bar {
  height: 8px;
  max-width: 760px;
  border-radius: 999px;
  overflow: hidden;
  background: #e5e7eb;
}

#pni-review-app .pni-stat-bar i {
  display: block;
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #0072bc, #0f766e);
}

/* Radar/indicadores de calidad */
#pni-review-app .pni-quality-panel {
  margin-top: 18px;
}

#pni-review-app .pni-quality-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 12px;
}

#pni-review-app .pni-quality-item {
  padding: 14px;
  border-radius: 15px;
  background: #ffffff;
  border: 1px solid #e2e8f0;
}

#pni-review-app .pni-quality-item span {
  display: block;
  min-height: 34px;
  color: #334155;
  font-size: 13px;
  font-weight: 800;
  line-height: 1.25;
}

#pni-review-app .pni-quality-item strong {
  display: block;
  margin: 8px 0;
  color: #073b7a;
  font-size: 20px;
  font-weight: 900;
}

#pni-review-app .pni-quality-track {
  height: 8px;
  border-radius: 999px;
  overflow: hidden;
  background: #e5e7eb;
}

#pni-review-app .pni-quality-track i {
  display: block;
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #0072bc, #0f766e);
}

/* =========================================================
   RESULTADOS Y TABLA
   ========================================================= */

#pni-review-app .pni-review-results-panel {
  margin-top: 20px;
}

#pni-review-app .pni-review-filters {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 230px 230px;
  gap: 12px;
  margin: 16px 0;
}

#pni-review-app .pni-review-table-wrap {
  width: 100%;
  overflow-x: auto;
  border: 1px solid #dbe4ef;
  border-radius: 18px;
  background: #ffffff;
}

#pni-review-app .pni-review-table {
  width: 100%;
  min-width: 1040px;
  table-layout: fixed;
  border-collapse: collapse;
}

#pni-review-app .pni-review-table thead th {
  position: sticky;
  top: 0;
  z-index: 1;
  background: #073b7a;
  color: #ffffff;
  padding: 12px 10px;
  font-size: 13px;
  line-height: 1.3;
  text-align: left;
  font-weight: 800;
  white-space: nowrap;
}

#pni-review-app .pni-review-table tbody td {
  padding: 12px 10px;
  border-bottom: 1px solid #edf2f7;
  color: #334155;
  font-size: 14px;
  line-height: 1.45;
  vertical-align: top;
  word-break: normal;
  overflow-wrap: anywhere;
}

#pni-review-app .pni-review-table tbody tr:nth-child(even) {
  background: #f8fafc;
}

#pni-review-app .pni-review-table tbody tr:hover {
  background: #eef6ff;
}

/* Anchos de columnas */
#pni-review-app .pni-review-table th:nth-child(1),
#pni-review-app .pni-review-table td:nth-child(1) {
  width: 58px;
}

#pni-review-app .pni-review-table th:nth-child(2),
#pni-review-app .pni-review-table td:nth-child(2) {
  width: 70px;
}

#pni-review-app .pni-review-table th:nth-child(3),
#pni-review-app .pni-review-table td:nth-child(3) {
  width: 125px;
}

#pni-review-app .pni-review-table th:nth-child(4),
#pni-review-app .pni-review-table td:nth-child(4) {
  width: 95px;
}

#pni-review-app .pni-review-table th:nth-child(5),
#pni-review-app .pni-review-table td:nth-child(5) {
  width: 190px;
  max-width: 190px;
}

#pni-review-app .pni-review-table th:nth-child(6),
#pni-review-app .pni-review-table td:nth-child(6) {
  width: 250px;
}

#pni-review-app .pni-review-table th:nth-child(7),
#pni-review-app .pni-review-table td:nth-child(7) {
  width: 270px;
}

#pni-review-app .pni-empty-row td {
  text-align: center;
  color: #64748b;
  padding: 28px 16px !important;
}

/* =========================================================
   BADGES
   ========================================================= */

#pni-review-app .pni-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 5px 9px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 800;
  white-space: nowrap;
}

#pni-review-app .pni-badge.tipo-ortografia {
  background: #fff1f2;
  color: #be123c;
}

#pni-review-app .pni-badge.tipo-redaccion {
  background: #fff7ed;
  color: #c2410c;
}

#pni-review-app .pni-badge.tipo-estilo {
  background: #eef6ff;
  color: #075985;
}

#pni-review-app .pni-badge.tipo-terminologia {
  background: #ecfdf5;
  color: #047857;
}

#pni-review-app .pni-badge.tipo-formato {
  background: #f1f5f9;
  color: #475569;
}

#pni-review-app .pni-badge.tipo-coherencia {
  background: #fef9c3;
  color: #854d0e;
}

#pni-review-app .pni-priority-alta {
  color: #b91c1c;
  font-weight: 900;
}

#pni-review-app .pni-priority-media {
  color: #b45309;
  font-weight: 900;
}

#pni-review-app .pni-priority-baja {
  color: #047857;
  font-weight: 900;
}

/* Prioridades como etiquetas visuales si el JS las envuelve en span */
#pni-review-app .pni-priority-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 5px 9px;
  border-radius: 999px;
  font-size: 12px;
  font-weight: 900;
}

#pni-review-app .pni-priority-badge.alta {
  background: #fff1f2;
  color: #b91c1c;
}

#pni-review-app .pni-priority-badge.media {
  background: #fffbeb;
  color: #b45309;
}

#pni-review-app .pni-priority-badge.baja {
  background: #ecfdf5;
  color: #047857;
}

/* =========================================================
   OCULTAR ELEMENTOS RESIDUALES
   ========================================================= */

#pni-review-app .pni-regulatory-panel,
#pni-review-app #pniRegulatoryPanel {
  display: none !important;
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1180px) {
  #pni-review-app .pni-executive-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  #pni-review-app .pni-executive-three-col {
    grid-template-columns: 1fr;
  }

  #pni-review-app .pni-quality-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 1080px) {
  #pni-review-app .pni-review-layout {
    grid-template-columns: 1fr;
  }

  #pni-review-app .pni-review-side {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 980px) {
  #pni-review-app {
    max-width: 100% !important;
  }

  #pni-review-app .pni-executive-top {
    grid-template-columns: 1fr;
  }

  #pni-review-app .pni-executive-grid,
  #pni-review-app .pni-executive-two-col {
    grid-template-columns: 1fr;
  }

  #pni-review-app .pni-review-panel-header.results {
    flex-direction: column;
    align-items: stretch;
  }

  #pni-review-app .pni-export-actions,
  #pni-review-app .pni-review-btn.export,
  #pni-review-app #pniExportReportBtn {
    width: 100%;
  }

  #pni-review-app .pni-review-table {
    min-width: 980px;
  }
}

@media (max-width: 720px) {
  #pni-review-app {
    padding: 18px 10px 34px;
  }

  #pni-review-app .pni-review-hero {
    border-radius: 22px;
    padding: 28px 20px;
  }

  #pni-review-app .pni-review-logo {
    width: 128px;
  }

  #pni-review-app .pni-review-panel {
    border-radius: 20px;
    padding: 18px;
  }

  #pni-review-app .pni-review-side {
    display: flex;
  }

  #pni-review-app .pni-review-kpis {
    grid-template-columns: 1fr 1fr;
  }

  #pni-review-app .pni-review-filters {
    grid-template-columns: 1fr;
  }

  #pni-review-app .pni-review-actions {
    flex-direction: column;
  }

  #pni-review-app .pni-review-btn {
    width: 100%;
  }

  #pni-review-app .pni-review-field textarea {
    min-height: 260px !important;
  }

  #pni-review-app .pni-quality-grid {
    grid-template-columns: 1fr;
  }
}
.pni-texto-detectado {
  max-width: 260px;
  width: 260px;
  white-space: normal;
  word-break: normal;
  overflow-wrap: anywhere;
  line-height: 1.45;
}

.pni-detected-details summary {
  cursor: pointer;
  color: #0f477f;
  font-weight: 700;
  line-height: 1.45;
}

.pni-detected-details summary:hover {
  text-decoration: underline;
}

.pni-detected-full {
  margin-top: 10px;
  padding: 12px;
  border-radius: 10px;
  background: #f8fafc;
  border: 1px solid #dbe4ef;
  color: #334155;
  max-height: 220px;
  overflow: auto;
}</style><script>/* =========================================================
   PNI Insight 3.0 · JS v7 AJUSTES SOLICITADOS
   Corrección robusta para WordPress / Divi
   - No depende de DOMContentLoaded exclusivamente
   - No falla si el JS carga antes que el HTML
   - Evita recarga del formulario
   - Usa delegación de eventos
   - Carga CSV oficiales del Observatorio
   - Genera análisis, productos, copia y descarga HTML
========================================================= */

(function () {
  'use strict';

  const APP_ID = 'pni-app';
  const TARGET_META = 85;
  const DATA_CUT_LIMIT = new Date(2026, 5, 25);
  const DATA_CUT_LABEL = '25-Jun-2026';

  const DATA_URLS = {
    nacional: 'https://vacunas.minsal.cl/wp-content/uploads/2026/06/Dashboard_Data.csv',
    regiones: 'https://vacunas.minsal.cl/wp-content/uploads/2026/06/Cobertura_Regiones.csv',
    servicios: 'https://vacunas.minsal.cl/wp-content/uploads/2026/06/Cobertura_SS.csv',
    grupos: 'https://vacunas.minsal.cl/wp-content/uploads/2026/06/Cobertura_Grupos.csv'
  };

  const state = {
    root: null,
    initialized: false,
    dataLoaded: false,
    loading: false,
    currentProduct: null,
    focusGroup: 'Total',
    lastPrompt: '',
    generatedAt: '',
    national: null,
    rankings: {
      regiones: [],
      servicios: [],
      grupos: []
    },
    data: {
      nacional: [],
      regiones: [],
      servicios: [],
      grupos: []
    },
    analysis: {
      narrative: '',
      findings: [],
      risks: [],
      opportunities: [],
      recommendations: [],
      territories: [],
      positives: [],
      nextActions: []
    }
  };

  /* =========================================================
     UTILIDADES DOM
  ========================================================= */

  function root() {
    if (!state.root || !document.body.contains(state.root)) {
      state.root = document.getElementById(APP_ID);
    }
    return state.root;
  }

  function $(selector, scope) {
    const base = scope || root() || document;
    return base.querySelector(selector);
  }

  function $$(selector, scope) {
    const base = scope || root() || document;
    return Array.from(base.querySelectorAll(selector));
  }

  function setText(selector, value) {
    const el = $(selector);
    if (el) el.textContent = value == null ? '' : String(value);
  }

  function setHTML(selector, value) {
    const el = $(selector);
    if (el) el.innerHTML = value == null ? '' : String(value);
  }

  function show(selectorOrEl) {
    const el = typeof selectorOrEl === 'string' ? $(selectorOrEl) : selectorOrEl;
    if (!el) return;
    el.hidden = false;
    el.classList.remove('is-hidden');
  }

  function hide(selectorOrEl) {
    const el = typeof selectorOrEl === 'string' ? $(selectorOrEl) : selectorOrEl;
    if (!el) return;
    el.hidden = true;
    el.classList.add('is-hidden');
  }

  function scrollToAppElement(selectorOrEl) {
    const el = typeof selectorOrEl === 'string' ? $(selectorOrEl) : selectorOrEl;
    if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function escapeHTML(value) {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function normalizeText(value) {
    return String(value ?? '')
      .trim()
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/ñ/g, 'n')
      .replace(/[^a-z0-9]+/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function fmtInt(value) {
    return new Intl.NumberFormat('es-CL').format(Math.round(Number(value) || 0));
  }

  function fmtPct(value) {
    return new Intl.NumberFormat('es-CL', {
      minimumFractionDigits: 2,
      maximumFractionDigits: 2
    }).format(Number(value) || 0) + '%';
  }

  function fmtNow() {
    return new Intl.DateTimeFormat('es-CL', {
      day: '2-digit',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    }).format(new Date());
  }

  function num(value) {
    if (value === undefined || value === null) return 0;
    const clean = String(value)
      .trim()
      .replace(/\s/g, '')
      .replace(/\./g, '')
      .replace(',', '.')
      .replace(/%/g, '');
    const n = Number(clean);
    return Number.isFinite(n) ? n : 0;
  }

  function getAny(row, names) {
    for (const name of names) {
      if (Object.prototype.hasOwnProperty.call(row, name) && row[name] !== '') return row[name];
    }
    return '';
  }

  function fileName(value) {
    return String(value || 'PNI_Insight')
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-zA-Z0-9]+/g, '_')
      .replace(/^_+|_+$/g, '')
      .slice(0, 90) || 'PNI_Insight';
  }

  /* =========================================================
     CSV
  ========================================================= */

  function parseCSVLine(line, delimiter) {
    const output = [];
    let current = '';
    let inQuotes = false;

    for (let i = 0; i < line.length; i++) {
      const ch = line[i];
      const next = line[i + 1];

      if (ch === '"' && inQuotes && next === '"') {
        current += '"';
        i++;
      } else if (ch === '"') {
        inQuotes = !inQuotes;
      } else if (ch === delimiter && !inQuotes) {
        output.push(current.trim());
        current = '';
      } else {
        current += ch;
      }
    }

    output.push(current.trim());
    return output;
  }

  function normalizeHeader(value) {
    return String(value || '')
      .trim()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-zA-Z0-9]+/g, '_')
      .replace(/^_+|_+$/g, '');
  }

  function parseCSV(text) {
    const lines = String(text || '')
      .replace(/^\uFEFF/, '')
      .split(/\r?\n/)
      .filter(line => line.trim() !== '');

    if (!lines.length) return [];

    const delimiter = lines[0].includes(';') ? ';' : ',';
    const headers = parseCSVLine(lines[0], delimiter).map(normalizeHeader);

    return lines.slice(1).map(line => {
      const cells = parseCSVLine(line, delimiter);
      const row = {};
      headers.forEach((header, index) => {
        row[header] = cells[index] !== undefined ? cells[index].trim() : '';
      });
      return row;
    });
  }

  async function fetchCSV(url) {
    const finalUrl = url + (url.includes('?') ? '&' : '?') + 'nocache=' + Date.now();
    const response = await fetch(finalUrl, { cache: 'no-store' });
    if (!response.ok) throw new Error('No se pudo cargar ' + url);
    return parseCSV(await response.text());
  }

  /* =========================================================
     NORMALIZACIÓN DE DATOS
  ========================================================= */

  function normalizeNationalRows(rows) {
    return (rows || []).map(row => {
      const coverage = num(getAny(row, ['Cobertura', 'Cobertura_2026', 'Avance', 'Porcentaje']));
      const vaccinated = num(getAny(row, ['Vacunados_Acumulados', 'Vacunados', 'Acumulados', 'Total_Vacunados']));
      const population = num(getAny(row, ['Poblacion_Objetivo', 'Poblacion', 'POB_OBJETIVO', 'Denominador']));
      const year = num(getAny(row, ['Ano', 'Anio', 'Year']));
      const day = num(getAny(row, ['Dia_Campana', 'Dia', 'DiaCampana']));
      const group = String(getAny(row, ['Grupo', 'Grupo_objetivo', 'Grupo_Objetivo']) || 'Total');
      const date = String(getAny(row, ['Fecha', 'fecha', 'Fecha_Corte']) || '');
      return { raw: row, coverage, vaccinated, population, year, day, group, date };
    });
  }

  function normalizeTerritoryRows(rows, type) {
    return (rows || []).map(row => {
      const name = String(getAny(row, type === 'region'
        ? ['Region', 'REGION', 'Nombre', 'Territorio']
        : type === 'group'
          ? ['Grupo', 'Grupo_objetivo', 'Grupo_Objetivo', 'Nombre', 'Territorio']
          : ['Servicio_de_Salud', 'Servicio', 'SS', 'Nombre', 'Territorio']
      ) || '').trim();

      const region = String(getAny(row, ['Region', 'REGION']) || '').trim();
      const group = String(getAny(row, ['Grupo', 'Grupo_objetivo', 'Grupo_Objetivo']) || 'Total').trim();
      const coverage = num(getAny(row, ['Cobertura', 'Avance', 'Porcentaje']));
      const vaccinated = num(getAny(row, ['Vacunados', 'Vacunados_Acumulados', 'Acumulados', 'Total']));
      const population = num(getAny(row, ['Poblacion_Objetivo', 'Poblacion', 'Denominador']));
      const gap = Math.max(0, Math.round(population * TARGET_META / 100 - vaccinated));
      return { raw: row, name, region, group, coverage, vaccinated, population, gap };
    }).filter(item => item.name && item.coverage > 0);
  }

  function parseDateLoose(value) {
    const raw = String(value || '').trim().toLowerCase();
    if (!raw) return null;

    const monthMap = {
      ene: 0, enero: 0,
      feb: 1, febrero: 1,
      mar: 2, marzo: 2,
      abr: 3, abril: 3,
      may: 4, mayo: 4,
      jun: 5, junio: 5,
      jul: 6, julio: 6,
      ago: 7, agosto: 7,
      sep: 8, sept: 8, septiembre: 8,
      oct: 9, octubre: 9,
      nov: 10, noviembre: 10,
      dic: 11, diciembre: 11
    };

    let m = raw.match(/^(\d{1,2})[-\/ ]([a-záéíóúñ]{3,10})(?:[-\/ ](\d{2,4}))?$/i);
    if (m) {
      const day = Number(m[1]);
      const monKey = m[2].normalize('NFD').replace(/[\u0300-\u036f]/g, '').slice(0, 3);
      const month = monthMap[monKey];
      let year = m[3] ? Number(m[3]) : 2026;
      if (year < 100) year += 2000;
      if (Number.isFinite(day) && month !== undefined && Number.isFinite(year)) return new Date(year, month, day);
    }

    m = raw.match(/^(\d{1,2})[-\/](\d{1,2})(?:[-\/](\d{2,4}))?$/);
    if (m) {
      const day = Number(m[1]);
      const month = Number(m[2]) - 1;
      let year = m[3] ? Number(m[3]) : 2026;
      if (year < 100) year += 2000;
      return new Date(year, month, day);
    }

    const parsed = new Date(raw);
    return Number.isNaN(parsed.getTime()) ? null : parsed;
  }

  function groupMatches(rowGroup, selectedGroup) {
    const rg = normalizeText(rowGroup || 'Total');
    const sg = normalizeText(selectedGroup || 'Total');
    if (!sg || sg === 'total') return rg.includes('total');
    if (sg.includes('persona') && sg.includes('mayor')) {
      return rg.includes('persona') && (rg.includes('mayor') || rg.includes('60') || rg.includes('65'));
    }
    if (sg.includes('nino') || sg.includes('nina') || sg.includes('6 meses')) {
      return rg.includes('nino') || rg.includes('nina') || rg.includes('infantil') || rg.includes('6 meses') || rg.includes('5 anos');
    }
    if (sg.includes('embarazada')) return rg.includes('embarazada');
    return rg.includes(sg) || sg.includes(rg);
  }

  function pickLatestNational(selectedGroup) {
    const group = selectedGroup || state.focusGroup || 'Total';
    const today = DATA_CUT_LIMIT;
    const rows = normalizeNationalRows(state.data.nacional)
      .filter(row => row.date && (row.coverage > 0 || row.vaccinated > 0))
      .filter(row => groupMatches(row.group, group));

    const usable = rows.filter(row => {
      const d = parseDateLoose(row.date);
      const rawDate = normalizeText(row.date);
      /*
        Evita que registros programáticos o de cierre anual (por ejemplo 31-dic)
        sean interpretados como corte real de campaña. El corte real debe venir del
        último registro efectivo disponible en el Observatorio.
      */
      if (rawDate.includes('31-dic') || rawDate.includes('31/12') || rawDate.includes('31-12')) return false;
      return !d || d <= today;
    });

    const selectedRows = usable.length ? usable : rows.filter(row => {
      const rawDate = normalizeText(row.date);
      return !(rawDate.includes('31-dic') || rawDate.includes('31/12') || rawDate.includes('31-12'));
    });
    if (!selectedRows.length && rows.length) selectedRows.push(...rows);
    if (!selectedRows.length && group !== 'Total') return pickLatestNational('Total');
    if (!selectedRows.length) return null;

    selectedRows.sort((a, b) => {
      const da = parseDateLoose(a.date);
      const db = parseDateLoose(b.date);
      if (da && db && da.getTime() !== db.getTime()) return da - db;
      if (a.year !== b.year) return a.year - b.year;
      if (a.day !== b.day) return a.day - b.day;
      return a.coverage - b.coverage;
    });

    const latest = selectedRows.at(-1);
    const gap = Math.max(0, Math.round(latest.population * TARGET_META / 100 - latest.vaccinated));

    return {
      fecha: DATA_CUT_LABEL,
      dia: latest.day || '--',
      cobertura: latest.coverage,
      vacunados: latest.vaccinated,
      poblacion: latest.population,
      brecha: gap,
      grupo: latest.group || group
    };
  }

  function rebuildRankings() {
    const selectedGroup = state.focusGroup || 'Total';
    const regionRows = normalizeTerritoryRows(state.data.regiones, 'region')
      .filter(row => groupMatches(row.group, selectedGroup));
    const ssRows = normalizeTerritoryRows(state.data.servicios, 'ss')
      .filter(row => groupMatches(row.group, selectedGroup));
    const groupRows = normalizeTerritoryRows(state.data.grupos, 'group');

    state.rankings.regiones = uniqueBestByName(regionRows).sort((a, b) => b.coverage - a.coverage);
    state.rankings.servicios = uniqueBestByName(ssRows).sort((a, b) => b.coverage - a.coverage);
    state.rankings.grupos = uniqueBestByName(groupRows).sort((a, b) => a.coverage - b.coverage);
  }

  function uniqueBestByName(rows) {
    const map = new Map();
    rows.forEach(row => {
      const key = normalizeText(row.name);
      if (!key) return;
      const current = map.get(key);
      if (!current || row.coverage > current.coverage) map.set(key, row);
    });
    return Array.from(map.values());
  }

  /* =========================================================
     CARGA DE DATOS
  ========================================================= */

  async function loadData() {
    setDataStatus('Cargando datos del Observatorio...', 'loading');

    try {
      const [nacional, regiones, servicios, grupos] = await Promise.allSettled([
        fetchCSV(DATA_URLS.nacional),
        fetchCSV(DATA_URLS.regiones),
        fetchCSV(DATA_URLS.servicios),
        fetchCSV(DATA_URLS.grupos)
      ]);

      state.data.nacional = nacional.status === 'fulfilled' ? nacional.value : [];
      state.data.regiones = regiones.status === 'fulfilled' ? regiones.value : [];
      state.data.servicios = servicios.status === 'fulfilled' ? servicios.value : [];
      state.data.grupos = grupos.status === 'fulfilled' ? grupos.value : [];

      state.national = pickLatestNational(state.focusGroup);
      rebuildRankings();
      buildAnalysis();
      updateDashboard();
      setDataStatus('Observatorio sincronizado', 'ok');
      logActivity('Datos sincronizados', 'Se cargaron los archivos CSV disponibles del Observatorio.', 'success');
    } catch (error) {
      console.warn('PNI Insight: error al cargar datos', error);
      loadFallbackData();
      updateDashboard();
      setDataStatus('Datos de respaldo cargados', 'warning');
      logActivity('Carga con respaldo', 'No fue posible cargar todos los CSV. Se usaron valores de referencia.', 'warning');
    }
  }

  function loadFallbackData() {
    state.national = {
      fecha: '25-jun',
      dia: 117,
      cobertura: 75.82,
      vacunados: 7607100,
      poblacion: 10033617,
      brecha: 921474,
      grupo: 'Total'
    };
    state.rankings.servicios = [
      { name: 'S.S. Tarapacá', coverage: 83.09 },
      { name: 'S.S. Del Maule', coverage: 79.84 },
      { name: 'S.S. Ñuble', coverage: 78.48 },
      { name: 'S.S. Coquimbo', coverage: 71.41 },
      { name: 'S.S. Magallanes', coverage: 71.69 }
    ].sort((a, b) => b.coverage - a.coverage);
    state.rankings.regiones = [];
    state.rankings.grupos = [
      { name: 'Personas mayores', coverage: 60.62 },
      { name: 'Niños/as 6 meses a 5 años', coverage: 60.81 },
      { name: 'Embarazadas', coverage: 66.59 },
      { name: 'Total', coverage: 75.82 }
    ];
    buildAnalysis();
  }

  function setDataStatus(text, mode) {
    const rootEl = root();
    if (!rootEl) return;
    rootEl.dataset.status = mode || 'ok';
    const status = $('.status-online');
    if (status) {
      const dot = status.querySelector('.status-dot');
      status.innerHTML = '';
      if (dot) status.appendChild(dot);
      status.appendChild(document.createTextNode(' ' + text));
    }
  }

  function updateDashboard() {
    const n = state.national || {};
    const topSS = state.rankings.servicios[0];
    const lowSS = state.rankings.servicios.filter(x => x.coverage < 75);
    const lowGroup = state.rankings.grupos.find(x => !normalizeText(x.name).includes('total'));

    setText('#heroFecha', DATA_CUT_LABEL);
    setText('#heroCobertura', n.cobertura ? fmtPct(n.cobertura) : '--');
    setText('#heroLowServices', lowSS.length ? `${lowSS.length} bajo 75%` : 'Sin SS bajo 75%');
    setText('#heroLowestGroup', lowGroup ? `${lowGroup.name} · ${fmtPct(lowGroup.coverage)}` : 'Sin datos');
    setText('#heroTopTerritory', topSS ? `${topSS.name} · ${fmtPct(topSS.coverage)}` : 'Sin datos');

    setText('#operationCoverage', n.cobertura ? fmtPct(n.cobertura) : '--');
    setText('#operationGap', n.brecha ? fmtInt(n.brecha) : '--');
    setText('#operationDate', DATA_CUT_LABEL);
    setText('#activeAnalysisCut', DATA_CUT_LABEL);

    const bar = $('#coverageProgress');
    if (bar && n.cobertura) bar.style.width = Math.max(0, Math.min(100, n.cobertura)) + '%';

    fillInitialFindingCards(lowSS, lowGroup, topSS);
  }

  function fillInitialFindingCards(lowSS, lowGroup, topSS) {
    const cards = $$('.finding');
    if (cards[0]) {
      cards[0].querySelector('h3').textContent = lowGroup ? lowGroup.name : 'Grupo objetivo';
      cards[0].querySelector('p').textContent = lowGroup
        ? `Registra la menor cobertura observada (${fmtPct(lowGroup.coverage)}).`
        : 'Pendiente de información por grupo objetivo.';
    }
    if (cards[1]) {
      cards[1].querySelector('h3').textContent = 'Servicios de Salud';
      cards[1].querySelector('p').textContent = lowSS.length
        ? `${lowSS.length} Servicios de Salud permanecen bajo 75%.`
        : 'No se identifican Servicios bajo 75%.';
    }
    if (cards[2]) {
      cards[2].querySelector('h3').textContent = topSS ? topSS.name : 'Territorio destacado';
      cards[2].querySelector('p').textContent = topSS
        ? `Lidera el avance territorial con ${fmtPct(topSS.coverage)}.`
        : 'Pendiente de datos territoriales.';
    }
  }


  function updateSelectedGroupUI() {
    setText('#activeGroupLabel', state.focusGroup || 'Total');
    $$('.group-option').forEach(btn => {
      btn.classList.toggle('active', btn.dataset.group === state.focusGroup);
    });
  }

  function setFocusGroup(group, rerun) {
    state.focusGroup = group || 'Total';
    state.national = pickLatestNational(state.focusGroup) || state.national;
    rebuildRankings();
    buildAnalysis(state.lastPrompt || `Resumen nacional para ${state.focusGroup}`);
    updateDashboard();
    updateSelectedGroupUI();
    if (rerun) {
      renderAnalysis();
      show('#analysisResult');
      show('#productsArea');
      show('#intelligenceCenter');
      show('#operationsPanel');
      show('#deepDivePanel');
      show('#exportCenter');
      /* No desplazamos la página al cambiar grupo objetivo: sólo actualizamos datos en pantalla. */
    }
  }

  function selectedGroupLabel() {
    return state.focusGroup && state.focusGroup !== 'Total' ? state.focusGroup : 'Total campaña';
  }

  /* =========================================================
     MOTOR DE ANÁLISIS
  ========================================================= */

  function buildAnalysis(prompt) {
    const n = state.national || {};
    const ss = state.rankings.servicios || [];
    const top = ss[0];
    const bottom = ss.length ? ss[ss.length - 1] : null;
    const under75 = ss.filter(x => x.coverage < 75);
    const over85 = ss.filter(x => x.coverage >= 85);
    const lowGroup = state.focusGroup === 'Total'
      ? (state.rankings.grupos || []).find(x => !normalizeText(x.name).includes('total'))
      : (state.rankings.grupos || []).find(x => groupMatches(x.name, state.focusGroup));

    const coverage = n.cobertura || 0;
    const gap = n.brecha || 0;
    const groupText = state.focusGroup === 'Total' ? 'para el total de campaña' : `para el grupo ${state.focusGroup}`;

    state.analysis.narrative = `Al corte ${n.fecha || 'disponible'}, la Campaña de Vacunación contra Influenza 2026 registra ${groupText} una cobertura de ${coverage ? fmtPct(coverage) : '--'}, equivalente a ${n.vacunados ? fmtInt(n.vacunados) : '--'} personas vacunadas. Para alcanzar la meta programática de ${TARGET_META}%, se estima una brecha de ${gap ? fmtInt(gap) : '--'} personas. ${top ? `El mayor avance territorial para este filtro corresponde a ${top.name} (${fmtPct(top.coverage)}).` : ''} ${bottom ? `El territorio con menor cobertura para este filtro es ${bottom.name} (${fmtPct(bottom.coverage)}).` : ''}`;

    state.analysis.findings = [
      coverage >= 85
        ? `La cobertura del filtro seleccionado alcanza o supera la meta programática de ${TARGET_META}%.`
        : coverage >= 75
          ? `La cobertura del filtro seleccionado supera el umbral operacional de 75%, pero permanece bajo la meta programática.`
          : `La cobertura del filtro seleccionado permanece bajo el umbral operacional de 75%.`,
      top ? `${top.name} presenta el mayor avance entre Servicios de Salud, con ${fmtPct(top.coverage)}.` : 'No se dispone de ranking de Servicios de Salud.',
      bottom ? `${bottom.name} presenta la menor cobertura territorial, con ${fmtPct(bottom.coverage)}.` : 'No se dispone de información territorial suficiente.',
      lowGroup ? `El grupo con menor cobertura identificada es ${lowGroup.name}, con ${fmtPct(lowGroup.coverage)}.` : 'No se dispone de datos suficientes por grupo objetivo.'
    ];

    state.analysis.risks = [
      gap > 0 ? `Persisten ${fmtInt(gap)} personas pendientes para alcanzar la meta de ${TARGET_META}%.` : 'No se observa brecha pendiente a la meta programática.',
      under75.length ? `${under75.length} Servicios de Salud permanecen bajo 75%.` : 'No se identifican Servicios bajo 75%.',
      lowGroup ? `El menor avance por grupo objetivo requiere seguimiento: ${lowGroup.name}.` : 'Se requiere revisar calidad de datos por grupos objetivo.'
    ];

    state.analysis.opportunities = [
      over85.length ? `${over85.length} Servicios de Salud ya alcanzan o superan 85%.` : 'Existe oportunidad de acelerar territorios cercanos al 85%.',
      top ? `La experiencia de ${top.name} puede orientar estrategias de refuerzo territorial.` : 'Identificar buenas prácticas territoriales según avance.',
      'Reforzar acciones focalizadas en territorios y grupos bajo umbral.'
    ];

    state.analysis.recommendations = [
      'Mantener seguimiento operativo de brechas a nivel regional y por Servicio de Salud.',
      under75.length ? `Priorizar refuerzo en ${under75.slice(0, 5).map(x => x.name).join(', ')}.` : 'Mantener monitoreo preventivo en Servicios cercanos al umbral.',
      lowGroup ? `Focalizar mensajes y operativos en ${lowGroup.name}.` : 'Actualizar análisis por grupo objetivo cuando se disponga de datos completos.',
      'Utilizar esta síntesis como insumo para reuniones de seguimiento con equipos territoriales.'
    ];

    state.analysis.territories = under75.slice(0, 6).map(x => `${x.name}: ${fmtPct(x.coverage)}`);
    state.analysis.positives = [
      top ? `${top.name} lidera con ${fmtPct(top.coverage)}.` : 'Ranking territorial pendiente.',
      over85.length ? `${over85.length} Servicios de Salud sobre 85%.` : 'Se observan territorios cercanos a meta programática.'
    ];
    state.analysis.nextActions = state.analysis.recommendations.slice(0, 4);

    if (prompt) state.lastPrompt = prompt;
  }

  async function runAnalysis(prompt) {
    const cleanPrompt = String(prompt || '').trim() || 'Resume la situación nacional de la campaña';
    state.lastPrompt = cleanPrompt;
    state.generatedAt = fmtNow();

    show('#analysisPanel');
    setAnalysisStatus(`Analizando campaña para ${selectedGroupLabel()}...`);
    await animateTimeline();

    if (!state.national) loadFallbackData();
    buildAnalysis(cleanPrompt);
    renderAnalysis();

    show('#analysisResult');
    show('#productsArea');
    show('#intelligenceCenter');
    show('#operationsPanel');
    show('#deepDivePanel');
    show('#exportCenter');
    hide('#systemActivity');
    show('#quickSettings');
    setText('#activeAnalysisName', titleFromPrompt(cleanPrompt));
    setText('#activeAnalysisStatus', 'Análisis generado');
    logActivity('Análisis generado', titleFromPrompt(cleanPrompt), 'success');
  }

  function titleFromPrompt(prompt) {
    const p = normalizeText(prompt);
        if (p.includes('minuta')) return 'Minuta ejecutiva';
    if (p.includes('whatsapp')) return 'Mensaje WhatsApp';
    if (p.includes('correo')) return 'Correo institucional';
    if (p.includes('servicio')) return 'Servicios prioritarios';
    if (p.includes('grupo') || p.includes('embarazada') || p.includes('mayores')) return 'Análisis por grupos objetivo';
    return 'Resumen nacional';
  }

  function setAnalysisStatus(text) {
    const status = $('.analysis-status');
    if (status) status.innerHTML = `<span class="analysis-dot"></span>${escapeHTML(text)}`;
  }

  function animateTimeline() {
    const items = $$('#analysisTimeline li');
    items.forEach(li => li.classList.remove('active', 'done'));

    return new Promise(resolve => {
      let index = 0;
      const timer = setInterval(() => {
        if (items[index - 1]) {
          items[index - 1].classList.remove('active');
          items[index - 1].classList.add('done');
        }
        if (items[index]) {
          items[index].classList.add('active');
          index += 1;
        } else {
          clearInterval(timer);
          setAnalysisStatus('Análisis listo');
          resolve();
        }
      }, 420);
    });
  }

  function renderAnalysis() {
    const a = state.analysis;
    const n = state.national || {};

    setText('#nationalNarrative', a.narrative);
    fillList('#riskList', a.risks);
    fillList('#opportunityList', a.opportunities);
    fillList('#recommendationList', a.recommendations);
    fillList('#riskInsights', a.risks);
    fillList('#territoryInsights', a.territories.length ? a.territories : ['No se identifican territorios bajo umbral con los datos disponibles.']);
    fillList('#positiveInsights', a.positives);
    fillList('#nextActions', a.nextActions);

    setText('#analysisConfidence', state.data.nacional.length ? '100%' : 'Referencia');
    setText('#activeAnalysisCut', DATA_CUT_LABEL);
  }

  function fillList(selectorOrEl, items) {
    const el = typeof selectorOrEl === 'string' ? $(selectorOrEl) : selectorOrEl;
    if (!el) return;
    const arr = Array.isArray(items) && items.length ? items : ['Sin información disponible.'];
    el.innerHTML = arr.map(item => `<li>${escapeHTML(item)}</li>`).join('');
  }

  function appendMessage(type, text) {
    const chat = $('#chatWindow');
    if (!chat) return;
    const isUser = type === 'user';
    const message = document.createElement('div');
    message.className = 'message ' + (isUser ? 'user-message' : 'assistant-message');
    message.innerHTML = `
      <div class="avatar">${isUser ? 'Tú' : 'AI'}</div>
      <div class="bubble"><p>${escapeHTML(text)}</p></div>
    `;
    chat.appendChild(message);
    chat.scrollTop = chat.scrollHeight;
  }

  /* =========================================================
     PRODUCTOS
  ========================================================= */

  function generateProduct(product) {
    if (!state.analysis.narrative) buildAnalysis(state.lastPrompt || 'Resumen nacional');
    state.currentProduct = product || 'informe';

    let templateId = 'templateInforme';
    let title = 'Informe ejecutivo';

    if (product === 'minuta') { templateId = 'templateMinuta'; title = 'Minuta ejecutiva'; }
    if (product === 'correo') { templateId = 'templateCorreo'; title = 'Correo institucional'; }
    if (product === 'whatsapp') { templateId = 'templateWhatsapp'; title = 'Mensaje WhatsApp'; }

    setText('#previewTitle', title);
    show('#previewArea');

    const canvas = $('#previewCanvas');
    const template = $('#' + templateId);
    if (!canvas) return;

    if (template && 'content' in template) {
      canvas.innerHTML = '';
      const fragment = template.content.cloneNode(true);
      hydrateProduct(fragment, product);
      canvas.appendChild(fragment);
    } else {
      canvas.innerHTML = fallbackProductHTML(product, title);
    }

    logActivity('Producto generado', title, 'success');
    scrollToAppElement('#previewArea');
  }

  function hydrateProduct(fragment, product) {
    const n = state.national || {};
    const a = state.analysis;
    fragment.querySelectorAll('.js-cut-date').forEach(el => el.textContent = DATA_CUT_LABEL);
    fragment.querySelectorAll('.js-coverage').forEach(el => el.textContent = n.cobertura ? fmtPct(n.cobertura) : '--');
    fragment.querySelectorAll('.js-vaccinated').forEach(el => el.textContent = n.vacunados ? fmtInt(n.vacunados) : '--');
    fragment.querySelectorAll('.js-gap').forEach(el => el.textContent = n.brecha ? fmtInt(n.brecha) : '--');
    fragment.querySelectorAll('.js-narrative').forEach(el => el.textContent = narrativeForProduct(product));
    fragment.querySelectorAll('.js-findings').forEach(el => fillList(el, a.findings));
    fragment.querySelectorAll('.js-risks').forEach(el => fillList(el, a.risks));
    fragment.querySelectorAll('.js-recommendations').forEach(el => fillList(el, a.recommendations));
    fragment.querySelectorAll('.js-whatsapp-text').forEach(el => el.textContent = buildWhatsAppText());
    fragment.querySelectorAll('.js-email-subject').forEach(el => el.textContent = `Actualización Campaña Influenza 2026 (${selectedGroupLabel()}) - ${n.fecha || 'último corte'}`);
    fragment.querySelectorAll('.js-email-body').forEach(el => el.textContent = buildEmailText());
  }

  function narrativeForProduct(product) {
    if (product === 'correo') return buildEmailText();
    if (product === 'whatsapp') return buildWhatsAppText();
    if (product === 'minuta') return 'Minuta ejecutiva preparada con base en la situación nacional, principales brechas y recomendaciones de seguimiento.';
    return state.analysis.narrative;
  }

  function buildWhatsAppText() {
    const n = state.national || {};
    const top = state.rankings.servicios[0];
    const bottom = state.rankings.servicios.length ? state.rankings.servicios[state.rankings.servicios.length - 1] : null;
    return `📊 Influenza 2026\nCorte: ${n.fecha || '--'}\nCobertura nacional: ${n.cobertura ? fmtPct(n.cobertura) : '--'}\nVacunados: ${n.vacunados ? fmtInt(n.vacunados) : '--'}\nBrecha 85%: ${n.brecha ? fmtInt(n.brecha) : '--'}\n\n🏥 Mayor avance: ${top ? top.name + ' (' + fmtPct(top.coverage) + ')' : '--'}\n⚠️ Menor cobertura: ${bottom ? bottom.name + ' (' + fmtPct(bottom.coverage) + ')' : '--'}\n\nPNI · MINSAL`;
  }

  function buildEmailText() {
    const a = state.analysis;
    return `Estimadas/os:\n\nJunto con saludar, se informa actualización de la Campaña de Vacunación contra Influenza 2026.\n\n${a.narrative}\n\nHallazgos principales:\n- ${a.findings.join('\n- ')}\n\nRecomendaciones:\n- ${a.recommendations.join('\n- ')}\n\nSaludos cordiales,\nPrograma Nacional de Inmunizaciones\nMinisterio de Salud`;
  }

  function fallbackProductHTML(product, title) {
    return `
      <article class="report-document">
        <h1>${escapeHTML(title)}</h1>
        <p>${escapeHTML(narrativeForProduct(product))}</p>
        <h2>Hallazgos</h2>
        <ul>${state.analysis.findings.map(x => `<li>${escapeHTML(x)}</li>`).join('')}</ul>
        <h2>Recomendaciones</h2>
        <ul>${state.analysis.recommendations.map(x => `<li>${escapeHTML(x)}</li>`).join('')}</ul>
      </article>`;
  }

  function copyCurrentProduct() {
    const canvas = $('#previewCanvas');
    const text = canvas ? canvas.innerText.trim() : '';
    if (!text) return;
    navigator.clipboard?.writeText(text).then(() => {
      logActivity('Texto copiado', 'El producto fue copiado al portapapeles.', 'success');
    }).catch(() => {
      logActivity('Copiar texto', 'Seleccione manualmente el contenido para copiar.', 'warning');
    });
  }

  function downloadCurrentProduct() {
    const canvas = $('#previewCanvas');
    if (!canvas) return;
    const html = `<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><title>PNI Insight</title><style>body{font-family:Arial,sans-serif;margin:40px;color:#0f172a;line-height:1.5}h1,h2,h3{color:#075985}.report-document,.brief-document,.email-document,.whatsapp-document,.infographic-document,.ppt-deck{max-width:900px;margin:auto;border:1px solid #dbeafe;border-radius:24px;padding:32px}</style></head><body>${canvas.innerHTML}</body></html>`;
    const blob = new Blob([html], { type: 'text/html;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = fileName($('#previewTitle')?.textContent || 'PNI_Insight') + '.html';
    document.body.appendChild(a);
    a.click();
    a.remove();
    URL.revokeObjectURL(url);
    logActivity('Descarga generada', 'Se descargó una versión HTML del producto.', 'success');
  }

  /* =========================================================
     ACTIVIDAD / UI
  ========================================================= */

  function logActivity(title, description, type) {
    const log = $('#activityLog');
    if (!log) return;
    const item = document.createElement('article');
    item.className = 'activity-item';
    item.innerHTML = `
      <span class="activity-dot ${escapeHTML(type || 'info')}"></span>
      <div><strong>${escapeHTML(title)}</strong><p>${escapeHTML(description || '')}</p></div>
    `;
    log.prepend(item);
  }

  function resetConversation() {
    const chat = $('#chatWindow');
    if (chat) {
      chat.innerHTML = `
        <div class="message assistant-message">
          <div class="avatar">AI</div>
          <div class="bubble"><p>Nueva conversación iniciada. Indique qué desea analizar o preparar.</p></div>
        </div>`;
    }
    hide('#analysisPanel');
    hide('#analysisResult');
    hide('#productsArea');
    hide('#previewArea');
    hide('#intelligenceCenter');
    hide('#operationsPanel');
    hide('#deepDivePanel');
    hide('#exportCenter');
    hide('#systemActivity');
    hide('#quickSettings');
    logActivity('Nueva conversación', 'Se inició una nueva conversación.', 'info');
  }

  function hideWordPressChrome() {
    const selectors = [
      '#main-header', '#top-header', '#main-footer', 'footer#main-footer',
      '.et-l--header', '.et-l--footer'
    ];
    selectors.forEach(selector => {
      document.querySelectorAll(selector).forEach(el => {
        if (!el.closest('#' + APP_ID)) el.style.display = 'none';
      });
    });
  }

  /* =========================================================
     EVENTOS ROBUSTOS
  ========================================================= */

  function handleSubmit(event) {
    const form = event.target && event.target.closest ? event.target.closest('#composer') : null;
    if (!form) return;
    event.preventDefault();
    event.stopPropagation();
    sendPrompt();
    return false;
  }

  function sendPrompt() {
    const input = $('#promptInput');
    const value = input ? input.value.trim() : '';
    if (input) input.value = '';
    runAnalysis(value || 'Resume la situación nacional de la campaña');
  }

  function handleClick(event) {
    const app = root();
    if (!app) return;
    const target = event.target;
    if (!target || !app.contains(target)) return;

    const sendButton = target.closest('#sendPrompt');
    if (sendButton) {
      event.preventDefault();
      event.stopPropagation();
      sendPrompt();
      return;
    }

    const suggestion = target.closest('.prompt-suggestions button');
    if (suggestion) {
      event.preventDefault();
      runAnalysis(suggestion.dataset.prompt || suggestion.textContent.trim());
      return;
    }

    const decision = target.closest('.decision-card');
    if (decision) {
      event.preventDefault();
      event.stopPropagation();
      runAnalysis(decision.dataset.prompt || decision.textContent.trim());
      return;
    }

    const product = target.closest('.product-card');
    if (product) {
      event.preventDefault();
      generateProduct(product.dataset.product || 'informe');
      return;
    }

    const groupOption = target.closest('.group-option');
    if (groupOption) {
      event.preventDefault();
      event.stopPropagation();
      setFocusGroup(groupOption.dataset.group || 'Total', !!state.analysis.narrative);
      return;
    }

    const deepDive = target.closest('.deep-dive-card');
    if (deepDive) {
      event.preventDefault();
      runAnalysis('Profundiza el análisis en ' + (deepDive.dataset.deepDive || 'campaña'));
      return;
    }

    const exportAction = target.closest('.export-action');
    if (exportAction) {
      event.preventDefault();
      const action = exportAction.dataset.export;
      if (action === 'copy') copyCurrentProduct();
      else if (action === 'html') downloadCurrentProduct();
      else appendMessage('assistant', 'Esa exportación avanzada estará disponible en una etapa posterior. Por ahora puede usar Copiar texto o Descargar HTML.');
      return;
    }

    const copy = target.closest('#copyProduct');
    if (copy) { event.preventDefault(); copyCurrentProduct(); return; }

    const download = target.closest('#downloadProduct');
    if (download) { event.preventDefault(); downloadCurrentProduct(); return; }

    const newChat = target.closest('.new-chat');
    if (newChat) { event.preventDefault(); resetConversation(); return; }

    const conversation = target.closest('.conversation');
    if (conversation) {
      event.preventDefault();
      $$('.conversation').forEach(x => x.classList.remove('active'));
      conversation.classList.add('active');
      runAnalysis(conversation.dataset.prompt || conversation.textContent.trim());
    }
  }

  function handleKeydown(event) {
    const app = root();
    if (!app) return;
    const input = event.target && event.target.id === 'promptInput' ? event.target : null;
    if (!input) return;
    if (event.key === 'Enter' && !event.shiftKey) {
      event.preventDefault();
      sendPrompt();
    }
  }

  function bindGlobalEventsOnce() {
    if (window.__PNI_INSIGHT_3_EVENTS_BOUND__) return;
    window.__PNI_INSIGHT_3_EVENTS_BOUND__ = true;
    document.addEventListener('submit', handleSubmit, true);
    document.addEventListener('click', handleClick, true);
    document.addEventListener('keydown', handleKeydown, true);
  }

  /* =========================================================
     INICIALIZACIÓN ROBUSTA
  ========================================================= */

  function init() {
    const app = root();
    if (!app) return false;
    if (state.initialized) return true;

    state.initialized = true;
    document.body.classList.add('pni-insight-mode');
    hideWordPressChrome();
    bindGlobalEventsOnce();

    hide('#analysisPanel');
    hide('#analysisResult');
    hide('#productsArea');
    hide('#previewArea');
    hide('#intelligenceCenter');
    hide('#operationsPanel');
    hide('#historyPanel');
    hide('#deepDivePanel');
    hide('#exportCenter');
    hide('#systemActivity');
    hide('#quickSettings');

    updateSelectedGroupUI();
    loadData();
    return true;
  }

  function waitForAppAndInit(attempt) {
    if (init()) return;
    if ((attempt || 0) > 80) return;
    setTimeout(() => waitForAppAndInit((attempt || 0) + 1), 100);
  }

  bindGlobalEventsOnce();

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => waitForAppAndInit(0));
  } else {
    waitForAppAndInit(0);
  }

  window.PNIInsight3 = {
    state,
    init,
    loadData,
    runAnalysis,
    generateProduct,
    setFocusGroup,
    resetConversation
  };
})();
</script><style class="wpcode-css-snippet">/* =========================================================
   PNI Insight 3.0 · CSS v2 PRO
   Experiencia tipo asistente / Copilot institucional
   Programa Nacional de Inmunizaciones · Ministerio de Salud
   ========================================================= */

/* =========================================================
   0. INTEGRACIÓN WORDPRESS / DIVI
   ========================================================= */

body:has(#pni-app) #main-header,
body:has(#pni-app) #top-header,
body:has(#pni-app) #main-footer,
body:has(#pni-app) footer#main-footer,
body:has(#pni-app) .et-l--header,
body:has(#pni-app) .et-l--footer{
  display:none !important;
}

body:has(#pni-app),
body:has(#pni-app) #page-container,
body:has(#pni-app) #et-main-area,
body:has(#pni-app) #main-content,
body:has(#pni-app) .entry-content{
  margin:0 !important;
  padding:0 !important;
  background:#eaf4fb !important;
  overflow-x:hidden !important;
}

body:has(#pni-app) .et_pb_section,
body:has(#pni-app) .et_pb_row,
body:has(#pni-app) .et_pb_column,
body:has(#pni-app) .et_pb_code,
body:has(#pni-app) .et_pb_code_inner{
  max-width:none !important;
  width:100% !important;
  margin:0 !important;
  padding:0 !important;
}

body.pni-insight-mode #main-header,
body.pni-insight-mode #top-header,
body.pni-insight-mode #main-footer,
body.pni-insight-mode .et-l--header,
body.pni-insight-mode .et-l--footer{
  display:none !important;
}

/* =========================================================
   1. TOKENS
   ========================================================= */

#pni-app{
  --pni-blue-950:#04213f;
  --pni-blue-900:#062b4f;
  --pni-blue-800:#06466f;
  --pni-blue-700:#075985;
  --pni-blue-600:#0072bc;
  --pni-blue-500:#0ea5e9;
  --pni-blue-100:#e0f2fe;
  --pni-red:#ef3340;
  --pni-green:#008766;
  --pni-orange:#f59e0b;
  --pni-sky:#edf8ff;
  --pni-ink:#122033;
  --pni-muted:#66758b;
  --pni-line:#d8ecfb;
  --pni-card:rgba(255,255,255,.86);
  --pni-card-solid:#ffffff;
  --pni-shadow:0 24px 70px rgba(6,43,79,.16);
  --pni-shadow-soft:0 12px 35px rgba(6,43,79,.10);
  --pni-radius-xl:28px;
  --pni-radius-lg:22px;
  --pni-radius-md:16px;
  font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  color:var(--pni-ink);
  min-height:100vh;
  display:grid;
  grid-template-columns:272px minmax(0,1fr);
  background:
    radial-gradient(circle at 20% 5%, rgba(14,165,233,.18), transparent 24%),
    radial-gradient(circle at 82% 12%, rgba(0,114,188,.12), transparent 28%),
    linear-gradient(135deg,#eef8ff 0%,#f8fbff 45%,#edf7ff 100%);
  isolation:isolate;
}

#pni-app *,
#pni-app *::before,
#pni-app *::after{box-sizing:border-box;}
#pni-app button,
#pni-app textarea,
#pni-app select{font-family:inherit;}
#pni-app button{cursor:pointer;}
#pni-app [hidden]{display:none !important;}

/* =========================================================
   2. SIDEBAR
   ========================================================= */

.sidebar{
  position:sticky;
  top:0;
  height:100vh;
  display:flex;
  flex-direction:column;
  padding:22px 16px;
  background:
    linear-gradient(180deg,rgba(4,33,63,.98),rgba(6,70,111,.96)),
    radial-gradient(circle at top left,rgba(14,165,233,.26),transparent 38%);
  color:#fff;
  box-shadow:18px 0 55px rgba(5,42,78,.20);
  overflow:hidden;
  z-index:2;
}
.sidebar::after{
  content:"";
  position:absolute;
  inset:auto -70px -90px auto;
  width:220px;height:220px;border-radius:999px;
  background:rgba(14,165,233,.20);
  filter:blur(20px);
}
.sidebar-top{position:relative;z-index:1;margin-bottom:20px;}
.new-chat{
  width:100%;
  border:1px solid rgba(255,255,255,.24);
  background:rgba(255,255,255,.12);
  color:#fff;
  padding:14px 16px;
  border-radius:18px;
  display:flex;
  gap:10px;
  align-items:center;
  font-weight:800;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.18);
  backdrop-filter:blur(18px);
}
.new-chat span{font-size:19px;line-height:1;}
.conversation-title{
  position:relative;z-index:1;
  font-size:11px;
  letter-spacing:.18em;
  text-transform:uppercase;
  color:rgba(255,255,255,.58);
  font-weight:800;
  margin:10px 10px 12px;
}
.conversation-list{position:relative;z-index:1;display:grid;gap:8px;}
.conversation{
  width:100%;
  border:0;
  text-align:left;
  color:rgba(255,255,255,.86);
  background:transparent;
  padding:12px 12px;
  border-radius:15px;
  display:flex;
  align-items:center;
  gap:10px;
  font-weight:700;
  transition:.18s ease;
}
.conversation:hover{background:rgba(255,255,255,.12);transform:translateX(2px);}
.conversation.active{background:#fff;color:var(--pni-blue-900);box-shadow:0 12px 26px rgba(0,0,0,.22);}
.conversation-icon{
  width:30px;height:30px;border-radius:12px;
  display:grid;place-items:center;
  background:rgba(255,255,255,.14);
}
.conversation.active .conversation-icon{background:#eaf6ff;}
.sidebar-footer{
  position:relative;z-index:1;
  margin-top:auto;
  padding-top:18px;
  border-top:1px solid rgba(255,255,255,.16);
  display:grid;
  gap:8px;
}
.sidebar-footer button{
  border:0;background:transparent;color:rgba(255,255,255,.82);
  text-align:left;font-weight:800;padding:10px;border-radius:12px;
}
.sidebar-footer button:hover{background:rgba(255,255,255,.12);color:#fff;}

/* =========================================================
   3. MAIN & HEADER
   ========================================================= */

.main{
  min-width:0;
  display:flex;
  flex-direction:column;
  gap:18px;
  padding:24px clamp(18px,3vw,38px) 36px;
  max-width:1500px;
  width:100%;
  margin:0 auto;
}
.header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:22px;
  padding:18px 22px;
  border:1px solid rgba(216,236,251,.9);
  border-radius:var(--pni-radius-xl);
  background:rgba(255,255,255,.76);
  backdrop-filter:blur(20px);
  box-shadow:var(--pni-shadow-soft);
}
.header-left{display:flex;align-items:center;gap:20px;min-width:0;}
.logo{
  width:108px;
  height:auto;
  display:block;
  filter:drop-shadow(0 10px 22px rgba(6,43,79,.20));
}
.header small,
.section-header small,
.products-header small,
.preview-header small,
.result-header small,
.assistant-header small{
  display:block;
  color:#0072bc;
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:.16em;
  font-weight:900;
  margin-bottom:4px;
}
.header h1{
  margin:0;
  font-size:clamp(26px,3vw,42px);
  letter-spacing:-.05em;
  color:var(--pni-blue-950);
}
.status-online{
  display:flex;align-items:center;gap:10px;
  padding:11px 14px;border-radius:999px;
  background:#e8fff6;color:#00634c;
  border:1px solid #baf0dd;font-weight:900;
  white-space:nowrap;
}
.status-dot{width:10px;height:10px;background:#0aa870;border-radius:50%;box-shadow:0 0 0 6px rgba(10,168,112,.12);}

/* =========================================================
   4. HERO INTELIGENTE
   ========================================================= */

.hero{
  order:1;
  position:relative;
  overflow:hidden;
  display:grid;
  grid-template-columns:minmax(0,1.4fr) minmax(280px,.7fr);
  gap:22px;
  min-height:0;
  padding:28px;
  border-radius:var(--pni-radius-xl);
  background:
    linear-gradient(145deg,rgba(255,255,255,.86),rgba(245,251,255,.88)),
    radial-gradient(circle at 25% 15%,rgba(14,165,233,.18),transparent 35%);
  border:1px solid rgba(216,236,251,.92);
  box-shadow:var(--pni-shadow);
}
.hero::before{
  content:"";
  position:absolute;
  inset:0;
  background:linear-gradient(90deg,rgba(0,114,188,.08),transparent 45%);
  pointer-events:none;
}
.hero-left,.hero-right{position:relative;z-index:1;}
.hero-left h2{
  margin:0 0 10px;
  font-size:clamp(28px,4vw,54px);
  line-height:1.02;
  letter-spacing:-.06em;
  color:var(--pni-blue-950);
  max-width:820px;
}
.hero-left p{
  margin:0;
  max-width:760px;
  color:#3e4e66;
  font-size:16px;
  line-height:1.65;
  font-weight:600;
}
.hero-intelligence-list{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:12px;
  margin-top:24px;
}
.hero-intelligence-item{
  display:grid;
  grid-template-columns:auto 1fr;
  gap:10px 12px;
  align-items:start;
  background:rgba(255,255,255,.84);
  border:1px solid var(--pni-line);
  border-radius:18px;
  padding:14px;
  box-shadow:0 12px 25px rgba(6,43,79,.08);
}
.hero-intelligence-item span{width:11px;height:11px;border-radius:50%;margin-top:5px;background:var(--pni-blue-600);}
.hero-intelligence-item.high span{background:#ef3340;box-shadow:0 0 0 6px rgba(239,51,64,.10);}
.hero-intelligence-item.medium span{background:#f59e0b;box-shadow:0 0 0 6px rgba(245,158,11,.12);}
.hero-intelligence-item.good span{background:#008766;box-shadow:0 0 0 6px rgba(0,135,102,.12);}
.hero-intelligence-item strong{font-size:13px;color:var(--pni-blue-950);}
.hero-intelligence-item small{grid-column:2;color:var(--pni-muted);font-weight:700;font-size:12px;line-height:1.35;}
.hero-right{display:grid;gap:12px;align-content:center;}
.hero-card{
  padding:18px 20px;
  border-radius:20px;
  background:rgba(255,255,255,.88);
  border:1px solid var(--pni-line);
  box-shadow:0 15px 35px rgba(6,43,79,.09);
}
.hero-card small{display:block;text-transform:uppercase;letter-spacing:.13em;color:#71829a;font-size:11px;font-weight:900;margin-bottom:7px;}
.hero-card strong{font-size:clamp(22px,2.6vw,34px);color:var(--pni-blue-900);letter-spacing:-.04em;}

/* =========================================================
   5. HALLAZGOS Y CHAT
   ========================================================= */

.today{order:2;}
.assistant-area{order:3;}
.analysis-panel{order:4;}
.analysis-result{order:5;}
.products-area{order:6;}
.preview-area{order:7;}
.intelligence-center{order:8;}
.operations-panel{order:9;}
.history-panel{order:10;}
.deep-dive-panel{order:11;}
.export-center{order:12;}
.system-activity{order:13;}
.quick-settings{order:14;}
.footer{order:15;}

.section-title{
  font-size:16px;
  font-weight:900;
  color:var(--pni-blue-950);
  margin:0 0 12px;
}
.cards{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:14px;
}
.finding{
  background:var(--pni-card);
  border:1px solid var(--pni-line);
  border-radius:20px;
  padding:18px;
  box-shadow:var(--pni-shadow-soft);
  min-height:150px;
  position:relative;
  overflow:hidden;
}
.finding::before{content:"";position:absolute;inset:0 auto 0 0;width:5px;background:var(--pni-blue-600);}
.finding.critical::before{background:var(--pni-red);}
.finding.warning::before{background:var(--pni-orange);}
.finding.success::before{background:var(--pni-green);}
.finding.info::before{background:var(--pni-blue-500);}
.finding small{display:block;text-transform:uppercase;letter-spacing:.13em;font-weight:900;color:#71829a;font-size:10px;margin-bottom:10px;}
.finding h3{margin:0 0 8px;color:var(--pni-blue-950);font-size:20px;letter-spacing:-.03em;}
.finding p{margin:0;color:#536278;line-height:1.55;font-weight:600;}

.assistant-area,
.analysis-panel,
.analysis-result,
.products-area,
.preview-area,
.intelligence-center,
.operations-panel,
.history-panel,
.deep-dive-panel,
.export-center,
.system-activity,
.quick-settings,
.footer{
  background:rgba(255,255,255,.82);
  border:1px solid rgba(216,236,251,.95);
  border-radius:var(--pni-radius-xl);
  box-shadow:var(--pni-shadow-soft);
}
.assistant-area{padding:24px;}
.assistant-header,
.result-header,
.products-header,
.preview-header,
.section-header{
  display:flex;
  justify-content:space-between;
  gap:20px;
  align-items:flex-start;
  margin-bottom:18px;
}
.assistant-header h2,
.result-header h2,
.products-header h2,
.preview-header h2,
.section-header h2{
  margin:0;
  color:var(--pni-blue-950);
  font-size:clamp(22px,2.4vw,32px);
  letter-spacing:-.04em;
}
.assistant-mode,
.result-meta,
.analysis-score{
  padding:10px 13px;
  border-radius:999px;
  background:#eaf6ff;
  color:var(--pni-blue-700);
  border:1px solid var(--pni-line);
  font-weight:900;
  font-size:12px;
  white-space:nowrap;
}
.chat-window{
  min-height:230px;
  border:1px solid var(--pni-line);
  border-radius:24px;
  padding:20px;
  background:linear-gradient(180deg,#fbfdff,#f8fbff);
  overflow:auto;
}
.message{display:flex;gap:14px;margin-bottom:14px;}
.avatar{
  width:38px;height:38px;border-radius:15px;
  display:grid;place-items:center;
  background:linear-gradient(135deg,var(--pni-blue-700),var(--pni-blue-500));
  color:#fff;font-weight:900;font-size:12px;
  box-shadow:0 10px 24px rgba(0,114,188,.25);
  flex:0 0 auto;
}
.bubble{
  max-width:760px;
  background:#fff;
  border:1px solid var(--pni-line);
  border-radius:18px;
  padding:16px 18px;
  box-shadow:0 12px 30px rgba(6,43,79,.08);
}
.bubble p{margin:0 0 10px;line-height:1.6;color:#344258;font-weight:600;}
.bubble p:last-child{margin-bottom:0;}
.muted{color:#7a8798 !important;font-size:13px;}
.prompt-suggestions{display:flex;flex-wrap:wrap;gap:8px;margin:14px 0 12px;}
.prompt-suggestions button{
  border:1px solid var(--pni-line);
  color:var(--pni-blue-800);
  background:#fff;
  border-radius:999px;
  padding:10px 14px;
  font-weight:900;
  box-shadow:0 8px 18px rgba(6,43,79,.07);
}
.prompt-suggestions button:hover{background:#eaf6ff;transform:translateY(-1px);}
.composer{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:stretch;}
.composer textarea{
  width:100%;resize:none;min-height:70px;
  border:1px solid var(--pni-line);
  border-radius:20px;
  padding:17px 18px;
  font-size:15px;
  color:var(--pni-ink);
  outline:none;
  background:#fff;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.9);
}
.composer textarea:focus{border-color:#7ed3ff;box-shadow:0 0 0 5px rgba(14,165,233,.13);}
.composer button,
.preview-actions button{
  border:0;border-radius:20px;padding:0 24px;
  background:linear-gradient(135deg,var(--pni-blue-700),var(--pni-blue-500));
  color:#fff;font-weight:900;
  box-shadow:0 15px 30px rgba(0,114,188,.25);
}
.preview-actions button:first-child{background:#fff;color:var(--pni-blue-700);border:1px solid var(--pni-line);box-shadow:var(--pni-shadow-soft);}

/* =========================================================
   6. TIMELINE Y RESULTADOS
   ========================================================= */

.analysis-panel,.analysis-result,.products-area,.preview-area,.intelligence-center,.operations-panel,.history-panel,.deep-dive-panel,.export-center,.system-activity,.quick-settings{padding:24px;}
.analysis-card{border:1px solid var(--pni-line);border-radius:22px;background:#fff;padding:20px;}
.analysis-status{font-weight:900;color:var(--pni-blue-900);display:flex;align-items:center;gap:10px;margin-bottom:16px;}
.analysis-dot{width:10px;height:10px;border-radius:50%;background:#94a3b8;box-shadow:0 0 0 6px rgba(148,163,184,.15);}
.analysis-panel.is-running .analysis-dot{background:#0ea5e9;box-shadow:0 0 0 6px rgba(14,165,233,.16);}
.timeline{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;list-style:none;margin:0;padding:0;}
.timeline li{
  display:flex;gap:10px;align-items:flex-start;
  padding:14px;border-radius:16px;background:#f7fbff;border:1px solid var(--pni-line);
  color:#536278;font-weight:700;
}
.timeline li span{width:12px;height:12px;border-radius:50%;background:#cbd5e1;margin-top:4px;flex:0 0 auto;}
.timeline li.done span{background:#008766;box-shadow:0 0 0 6px rgba(0,135,102,.12);}
.timeline li.active span{background:#0ea5e9;box-shadow:0 0 0 6px rgba(14,165,233,.14);}
.result-grid{display:grid;grid-template-columns:1.2fr 1fr 1fr;gap:14px;}
.result-main{grid-row:span 2;}
.result-main,.result-card{
  background:#fff;border:1px solid var(--pni-line);border-radius:22px;padding:22px;box-shadow:0 12px 28px rgba(6,43,79,.07);
}
.result-main h3,.result-card h3{margin:0 0 10px;color:var(--pni-blue-800);font-size:20px;letter-spacing:-.03em;}
.result-main p,.result-card li{color:#43536a;line-height:1.65;font-weight:600;}
ul{padding-left:20px;}

/* =========================================================
   7. PRODUCTOS Y PREVIEW
   ========================================================= */

.products-header p,.section-header p{margin:0;color:#60718a;font-weight:650;max-width:650px;line-height:1.55;}
.product-grid,.deep-dive-grid,.export-actions-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px;}
.product-card,.deep-dive-card,.export-action{
  border:1px solid var(--pni-line);background:#fff;border-radius:20px;padding:16px;text-align:left;
  min-height:140px;box-shadow:0 12px 28px rgba(6,43,79,.07);transition:.18s ease;
}
.product-card:hover,.deep-dive-card:hover,.export-action:hover{transform:translateY(-3px);border-color:#95d9ff;box-shadow:0 20px 42px rgba(6,43,79,.13);}
.product-icon,.product-card span,.deep-dive-card span,.export-action span{display:block;font-size:28px;margin-bottom:12px;}
.product-card strong,.deep-dive-card strong,.export-action strong{display:block;color:var(--pni-blue-950);font-size:16px;margin-bottom:6px;}
.product-card small,.deep-dive-card small,.export-action small{display:block;color:#66758b;font-weight:650;line-height:1.4;}
.preview-actions{display:flex;gap:10px;}
.preview-actions button{min-height:44px;padding:0 18px;}
.preview-canvas{
  min-height:260px;border:1px solid var(--pni-line);border-radius:24px;background:#fff;padding:24px;overflow:auto;
}
.preview-empty{text-align:center;color:#7a8798;padding:46px 20px;}
.preview-empty span{font-size:44px;display:block;margin-bottom:12px;}
.preview-empty h3{margin:0 0 8px;color:var(--pni-blue-900);}

.report-document,.brief-document,.mail-preview,.wa-phone,.infographic-preview,.ppt-deck{background:#fff;color:var(--pni-ink);}
.report-cover{border-radius:22px;padding:28px;background:linear-gradient(135deg,var(--pni-blue-900),var(--pni-blue-600));color:#fff;margin-bottom:18px;}
.report-logo img{width:118px;margin-bottom:20px;}
.report-cover h1{font-size:38px;margin:6px 0;}
.report-cover h2{font-size:20px;margin:0 0 18px;color:rgba(255,255,255,.88);}
.report-section{border:1px solid var(--pni-line);border-radius:18px;padding:18px;margin-bottom:12px;background:#fbfdff;}
.ppt-deck{display:grid;gap:16px;}
.ppt-slide{aspect-ratio:16/9;border-radius:18px;border:1px solid var(--pni-line);padding:26px;background:linear-gradient(135deg,#fff,#f3faff);box-shadow:var(--pni-shadow-soft);}
.ppt-slide.cover{background:linear-gradient(135deg,var(--pni-blue-900),var(--pni-blue-500));color:#fff;}
.ppt-big-number{font-size:56px;font-weight:900;color:var(--pni-blue-700);}
.mail-preview{border:1px solid var(--pni-line);border-radius:18px;overflow:hidden;}
.mail-header{background:#f4f9ff;padding:16px;border-bottom:1px solid var(--pni-line);}
.mail-body{padding:20px;line-height:1.65;}
.wa-phone{max-width:390px;margin:auto;border-radius:34px;padding:16px;background:#102a43;box-shadow:var(--pni-shadow);}
.wa-screen{background:#e7f6ee;border-radius:26px;padding:18px;min-height:520px;}
.wa-bubble{background:#dcf8c6;border-radius:16px 16px 4px 16px;padding:14px;line-height:1.55;box-shadow:0 8px 18px rgba(0,0,0,.12);}
.infographic-preview{border-radius:24px;border:1px solid var(--pni-line);overflow:hidden;}
.infographic-header{background:linear-gradient(135deg,var(--pni-blue-900),var(--pni-blue-500));color:#fff;padding:26px;}
.infographic-body{padding:26px;display:grid;grid-template-columns:1fr 1fr;gap:16px;}
.info-big{font-size:54px;font-weight:900;color:var(--pni-blue-700);}

/* =========================================================
   8. INTELIGENCIA, OPERACIONES, HISTORIAL
   ========================================================= */

.insight-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;}
.insight-card,.operation-card,.history-item,.activity-item,.setting-card{
  background:#fff;border:1px solid var(--pni-line);border-radius:20px;padding:18px;box-shadow:0 12px 26px rgba(6,43,79,.07);
}
.insight-card header{display:grid;gap:10px;margin-bottom:8px;}
.insight-tag{width:max-content;border-radius:999px;padding:7px 10px;font-size:10px;letter-spacing:.1em;text-transform:uppercase;font-weight:900;background:#eaf6ff;color:var(--pni-blue-700);}
.insight-tag.critical{background:#ffe8ea;color:#b91c1c;}.insight-tag.warning{background:#fff4d6;color:#a16207;}.insight-tag.success{background:#e7fff6;color:#047857;}.insight-tag.info{background:#eaf6ff;color:#0369a1;}
.insight-card h3{margin:0;color:var(--pni-blue-950);}
.operations-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;}
.operation-card small{display:block;text-transform:uppercase;letter-spacing:.12em;color:#71829a;font-weight:900;font-size:11px;margin-bottom:8px;}
.operation-card strong{font-size:28px;color:var(--pni-blue-800);}
.mini-progress{height:8px;border-radius:99px;background:#e2edf7;margin-top:12px;overflow:hidden;}
.mini-progress-bar{height:100%;width:0;background:linear-gradient(90deg,var(--pni-blue-600),var(--pni-green));border-radius:99px;}
.history-list,.activity-log{display:grid;gap:10px;}
.history-item{display:flex;justify-content:space-between;gap:14px;align-items:center;}
.history-item span{color:#6b7d94;font-weight:700;}
.export-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-bottom:14px;}
.export-summary>div{background:#fff;border:1px solid var(--pni-line);border-radius:18px;padding:16px;}
.export-summary small{display:block;text-transform:uppercase;letter-spacing:.12em;color:#71829a;font-size:11px;font-weight:900;margin-bottom:6px;}
.export-summary strong{color:var(--pni-blue-800);}
.activity-item{display:flex;gap:12px;align-items:flex-start;}
.activity-dot{width:12px;height:12px;border-radius:50%;margin-top:5px;flex:0 0 auto;background:#94a3b8;}
.activity-dot.success{background:#008766;}.activity-dot.info{background:#0ea5e9;}.activity-dot.warning{background:#f59e0b;}
.activity-item p{margin:4px 0 0;color:#66758b;line-height:1.5;}
.settings-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;}
.setting-card span{display:block;font-weight:900;color:var(--pni-blue-950);margin-bottom:8px;}
.setting-card select{width:100%;border:1px solid var(--pni-line);border-radius:14px;padding:12px;background:#f8fbff;font-weight:800;color:var(--pni-blue-900);}
.footer{padding:22px 24px;display:flex;justify-content:space-between;gap:16px;align-items:center;color:#66758b;}
.footer strong{display:block;color:var(--pni-blue-950);}.footer span{display:block;font-weight:650;margin-top:3px;}.footer p{margin:0;font-weight:700;}

/* =========================================================
   9. ESTADOS, ANIMACIONES Y RESPONSIVE
   ========================================================= */

.is-hidden{display:none !important;}
.pni-typing::after{content:"";display:inline-block;width:8px;height:18px;background:currentColor;margin-left:4px;vertical-align:-3px;animation:pniBlink .8s steps(2,end) infinite;}
@keyframes pniBlink{50%{opacity:0;}}
.finding,.hero,.assistant-area,.header,.today,.analysis-panel,.analysis-result,.products-area,.preview-area{animation:pniRise .45s ease both;}
@keyframes pniRise{from{opacity:0;transform:translateY(12px);}to{opacity:1;transform:translateY(0);}}

@media (max-width:1180px){
  #pni-app{grid-template-columns:1fr;}
  .sidebar{position:relative;height:auto;display:block;padding:14px;}
  .conversation-list{grid-template-columns:repeat(4,1fr);}
  .sidebar-footer{display:none;}
  .hero{grid-template-columns:1fr;}
  .cards,.insight-grid{grid-template-columns:repeat(2,1fr);}
  .product-grid,.deep-dive-grid,.export-actions-grid{grid-template-columns:repeat(3,1fr);}
}
@media (max-width:820px){
  .main{padding:14px;}
  .header,.assistant-header,.result-header,.products-header,.preview-header,.section-header,.footer{flex-direction:column;align-items:flex-start;}
  .hero-intelligence-list,.cards,.result-grid,.insight-grid,.operations-grid,.export-summary,.settings-grid{grid-template-columns:1fr;}
  .product-grid,.deep-dive-grid,.export-actions-grid{grid-template-columns:1fr 1fr;}
  .timeline{grid-template-columns:1fr;}
  .composer{grid-template-columns:1fr;}
  .composer button{min-height:52px;}
}
@media (max-width:560px){
  .conversation-list{grid-template-columns:1fr;}
  .product-grid,.deep-dive-grid,.export-actions-grid{grid-template-columns:1fr;}
  .logo{width:92px;}
  .hero,.assistant-area,.analysis-panel,.analysis-result,.products-area,.preview-area,.intelligence-center,.operations-panel,.history-panel,.deep-dive-panel,.export-center,.system-activity,.quick-settings{padding:18px;}
}

/* =========================================================
   PATCH v3 · Limpieza WordPress/Divi + experiencia más compacta
   ========================================================= */

/* Oculta footer/cabecera externos cuando esta página contiene PNI Insight */
body:has(#pni-app) footer:not(#pni-app footer),
body:has(#pni-app) .site-footer,
body:has(#pni-app) .footer-widget,
body:has(#pni-app) .footer-widgets,
body:has(#pni-app) .main-footer,
body:has(#pni-app) #footer,
body:has(#pni-app) #footer-bottom,
body:has(#pni-app) .et_pb_section:has(.footer-widget),
body.pni-insight-mode footer:not(#pni-app footer),
body.pni-insight-mode .site-footer,
body.pni-insight-mode .footer-widget,
body.pni-insight-mode .footer-widgets,
body.pni-insight-mode .main-footer,
body.pni-insight-mode #footer,
body.pni-insight-mode #footer-bottom{
  display:none !important;
  visibility:hidden !important;
  height:0 !important;
  overflow:hidden !important;
}

/* Reduce altura inicial y evita que el chat quede demasiado abajo */
.main{
  gap:14px !important;
  padding-top:18px !important;
  padding-bottom:24px !important;
}
.header{
  padding:14px 18px !important;
}
.logo{
  width:92px !important;
}
.hero{
  min-height:0 !important;
  padding:26px 26px !important;
  grid-template-columns:minmax(0,1.55fr) minmax(280px,.9fr) !important;
}
.hero h2{
  max-width:800px !important;
  font-size:clamp(34px,4.2vw,58px) !important;
  line-height:.96 !important;
}
.hero p{
  max-width:760px !important;
  margin-top:14px !important;
}
.hero-card{
  padding:18px 20px !important;
}
.hero-card strong{
  font-size:clamp(23px,2.2vw,34px) !important;
}
.today{
  margin-top:2px !important;
}
.cards{
  grid-template-columns:repeat(4,minmax(0,1fr)) !important;
  gap:12px !important;
}
.finding{
  min-height:118px !important;
  padding:18px 18px !important;
}
.assistant-area{
  margin-top:8px !important;
  padding:24px !important;
}
.chat-window{
  min-height:170px !important;
  padding:18px !important;
}
.bubble{
  max-width:760px !important;
}
.composer textarea{
  min-height:64px !important;
}
.footer{
  margin-top:10px !important;
}

/* Más sensación de “analista”: hallazgos con mejor lectura */
.finding h3{
  font-size:20px !important;
  letter-spacing:-.03em !important;
}
.finding p{
  color:#405167 !important;
  line-height:1.45 !important;
}

/* Sidebar menos dominante */
#pni-app{
  grid-template-columns:250px minmax(0,1fr) !important;
}
.sidebar{
  padding:18px 14px !important;
}

@media (max-width:1100px){
  #pni-app{grid-template-columns:1fr !important;}
  .sidebar{position:relative !important;height:auto !important;}
  .hero{grid-template-columns:1fr !important;}
  .cards{grid-template-columns:repeat(2,minmax(0,1fr)) !important;}
}
@media (max-width:700px){
  .cards{grid-template-columns:1fr !important;}
  .header{align-items:flex-start !important;flex-direction:column !important;}
  .hero{padding:22px !important;}
}

/* =========================================================
   PNI Insight 3.0 · Ajustes v6
   - Chat con altura fija y scroll interno
   - Selector de grupo objetivo en sidebar
   - Oculta registro del asistente
   - Exportaciones avanzadas deshabilitadas visualmente
========================================================= */

.chat-window{
  height: 330px !important;
  max-height: 330px !important;
  overflow-y: auto !important;
  overflow-x: hidden !important;
  scroll-behavior: smooth;
  overscroll-behavior: contain;
}

.chat-window::-webkit-scrollbar{ width: 8px; }
.chat-window::-webkit-scrollbar-thumb{
  background: rgba(7, 92, 146, .22);
  border-radius: 99px;
}

.group-title{
  margin-top: 22px !important;
}

.group-list{
  display:flex;
  flex-direction:column;
  gap:8px;
  padding:0 12px 16px 12px;
}

.group-option{
  width:100%;
  border:1px solid rgba(255,255,255,.14);
  background:rgba(255,255,255,.06);
  color:#dbeafe;
  border-radius:14px;
  padding:10px 12px;
  text-align:left;
  font-weight:800;
  font-size:12px;
  cursor:pointer;
  transition:.18s ease;
}

.group-option:hover{
  background:rgba(255,255,255,.12);
  transform:translateX(2px);
}

.group-option.active{
  background:#ffffff;
  color:#073b63;
  border-color:#ffffff;
  box-shadow:0 10px 24px rgba(0,0,0,.18);
}

.active-context-pill{
  margin-top:18px;
  display:inline-flex;
  align-items:center;
  gap:10px;
  padding:10px 14px;
  border-radius:999px;
  background:rgba(255,255,255,.74);
  border:1px solid rgba(186,230,253,.9);
  box-shadow:0 10px 24px rgba(8,47,73,.08);
}

.active-context-pill span{
  font-size:11px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.09em;
  color:#64748b;
}

.active-context-pill strong{
  color:#075985;
  font-weight:900;
}

#systemActivity{
  display:none !important;
}

.export-action.disabled,
.export-action:disabled{
  opacity:.46;
  cursor:not-allowed;
  filter:grayscale(.3);
  background:#f8fafc !important;
}

.export-action.disabled:hover,
.export-action:disabled:hover{
  transform:none !important;
  box-shadow:none !important;
}

.export-action.disabled::after,
.export-action:disabled::after{
  content:'Próximamente';
  display:inline-flex;
  margin-top:10px;
  padding:4px 8px;
  border-radius:999px;
  background:#e2e8f0;
  color:#475569;
  font-size:10px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.08em;
}

@media (max-width: 900px){
  .chat-window{
    height:300px !important;
    max-height:300px !important;
  }
}


/* =========================================================
   PNI Insight 3.0 · v7 ajustes solicitados
   - Retira productos PPT/Infografía desde HTML.
   - Mantiene cambio de grupo sin desplazamiento automático.
========================================================= */


/* =========================================================
   PNI Insight 3.0 · v8 Sin chat
   Ajustes solicitados: sin chat, sin menú lateral inferior,
   panel ejecutivo de acción y fecha de corte estabilizada.
   ========================================================= */

.sidebar-footer,
.assistant-area,
.chat-window,
.composer,
.prompt-suggestions{
  display:none !important;
}

.decision-panel{
  background:rgba(255,255,255,.88);
  border:1px solid rgba(160,210,245,.55);
  border-radius:28px;
  padding:28px;
  box-shadow:0 18px 50px rgba(8,47,73,.08);
  margin-top:22px;
}

.decision-header{
  display:flex;
  justify-content:space-between;
  gap:24px;
  align-items:flex-start;
  margin-bottom:22px;
}

.decision-header h2{
  margin:4px 0 8px;
  font-size:clamp(26px,3vw,38px);
  line-height:1.05;
  color:#082f49;
  letter-spacing:-.04em;
}

.decision-header p{
  margin:0;
  max-width:760px;
  color:#52657f;
  font-weight:650;
  line-height:1.55;
}

.decision-grid{
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:16px;
}

.decision-card{
  appearance:none;
  text-align:left;
  border:1px solid rgba(125,191,235,.55);
  background:linear-gradient(180deg,#ffffff,#f7fbff);
  border-radius:22px;
  padding:20px;
  min-height:156px;
  cursor:pointer;
  box-shadow:0 16px 36px rgba(8,47,73,.06);
  transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease;
}

.decision-card:hover{
  transform:translateY(-3px);
  border-color:#0284c7;
  box-shadow:0 22px 48px rgba(2,132,199,.16);
}

.decision-card span{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  width:36px;
  height:36px;
  border-radius:12px;
  background:#e0f2fe;
  color:#0369a1;
  font-weight:900;
  margin-bottom:14px;
}

.decision-card strong{
  display:block;
  color:#082f49;
  font-size:17px;
  line-height:1.2;
  margin-bottom:8px;
}

.decision-card small{
  display:block;
  color:#64748b;
  font-weight:700;
  line-height:1.4;
}

.sidebar{
  padding-bottom:20px !important;
}

.group-list{
  margin-bottom:20px;
}

@media (max-width:1100px){
  .decision-grid{grid-template-columns:repeat(2,minmax(0,1fr));}
  .decision-header{flex-direction:column;}
}

@media (max-width:700px){
  .decision-grid{grid-template-columns:1fr;}
}
</style><script>/* Visor Influenza Escolar y Preescolar 2026 - PNI/MINSAL - V4
   Instrucción: suba el CSV a WordPress y reemplace DEFAULT_CSV_URL por la URL pública.
   El visor también permite cargar un archivo CSV local desde el navegador. */
(function(){
  'use strict';
  function iniciarVisorInfluenzaEscolar2026(){
  const DEFAULT_CSV_URL = 'https://vacunas.minsal.cl/wp-content/uploads/2026/06/MINEDUC-influenza-2026.csv';
  const META = 85;
  const ROOT_ID = 'pniInfluenzaEscolar2026';
  const REGION_CANONICAL = [
    'ARICA Y PARINACOTA',
    'TARAPACÁ',
    'ANTOFAGASTA',
    'ATACAMA',
    'COQUIMBO',
    'VALPARAÍSO',
    'METROPOLITANA',
    "O'HIGGINS",
    'MAULE',
    'ÑUBLE',
    'BIOBÍO',
    'ARAUCANÍA',
    'LOS RÍOS',
    'LOS LAGOS',
    'AYSÉN',
    'MAGALLANES'
  ];
  const REGION_ALIASES = {
    'arica':'ARICA Y PARINACOTA','arica y parinacota':'ARICA Y PARINACOTA','xv':'ARICA Y PARINACOTA',
    'tarapaca':'TARAPACÁ','i':'TARAPACÁ',
    'antofagasta':'ANTOFAGASTA','ii':'ANTOFAGASTA',
    'atacama':'ATACAMA','iii':'ATACAMA',
    'coquimbo':'COQUIMBO','iv':'COQUIMBO',
    'valparaiso':'VALPARAÍSO','v':'VALPARAÍSO',
    'metropolitana':'METROPOLITANA','region metropolitana':'METROPOLITANA','rm':'METROPOLITANA','metropolitana de santiago':'METROPOLITANA',
    'ohiggins':"O'HIGGINS",'o higgins':"O'HIGGINS",'libertador bernardo ohiggins':"O'HIGGINS",'libertador general bernardo ohiggins':"O'HIGGINS",'vi':"O'HIGGINS",
    'maule':'MAULE','vii':'MAULE',
    'nuble':'ÑUBLE','xvi':'ÑUBLE',
    'biobio':'BIOBÍO','bio bio':'BIOBÍO','biobío':'BIOBÍO','viii':'BIOBÍO',
    'araucania':'ARAUCANÍA','la araucania':'ARAUCANÍA','ix':'ARAUCANÍA',
    'los rios':'LOS RÍOS','los ríos':'LOS RÍOS','xiv':'LOS RÍOS',
    'los lagos':'LOS LAGOS','x':'LOS LAGOS',
    'aysen':'AYSÉN','aysén':'AYSÉN','aisen':'AYSÉN','xi':'AYSÉN',
    'magallanes':'MAGALLANES','magallanes y antartica chilena':'MAGALLANES','xii':'MAGALLANES'
  };
  let raw = [], filtered = [], activeTab = 'baja';
  const $ = (id)=>document.getElementById(id);
  const root = $(ROOT_ID);
  if(!root) return;

  const els = {
    alert:$('pniIeAlert'), fecha:$('pniIeFechaAct'), total:$('pniIeTotalRegistros'), url:$('pniIeCsvUrl'), btnCargar:$('pniIeBtnCargar'), file:$('pniIeFile'), btnReset:$('pniIeBtnReset'),
    region:$('pniIeRegion'), comuna:$('pniIeComuna'), tipo:$('pniIeTipo'), nivel:$('pniIeNivel'), search:$('pniIeSearch'), filtroResumen:$('pniIeFiltroResumen'),
    kCob:$('pniIeKpiCobertura'), kEstado:$('pniIeKpiEstado'), kMat:$('pniIeKpiMatriculados'), kVac:$('pniIeKpiVacunados'), kPend:$('pniIeKpiPendientes'), kBrecha:$('pniIeKpiBrecha'), kEst:$('pniIeKpiEstablecimientos'),
    nivelChart:$('pniIeChartNivel'), regionChart:$('pniIeChartRegion'), rankingComunas:$('pniIeRankingComunas'), rankingEst:$('pniIeRankingEstablecimientos'), downloadCount:$('pniIeDownloadCount'), btnCsv:$('pniIeBtnCsv'), btnPrint:$('pniIeBtnPrint'), searchList:$('pniIeSearchList'), selectedCard:$('pniIeEstablecimientoDestacado'), estNombre:$('pniIeEstNombre'), estDetalle:$('pniIeEstDetalle'), estCobertura:$('pniIeEstCobertura')
  };

  function fmt(n){return Number(n||0).toLocaleString('es-CL');}
  function pct(n){return (Number(n||0)).toLocaleString('es-CL',{minimumFractionDigits:1,maximumFractionDigits:1})+'%';}
  function norm(v){return String(v??'').trim();}
  function normKey(v){return norm(v).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'');}
  function covClass(c){return c>=85?'ok':(c>=75?'warn':'bad');}
  function labelRegion(value){
    const rawValue = norm(value);
    const key = normKey(rawValue).replace(/[’']/g,'').replace(/region /g,'').trim();
    return REGION_ALIASES[key] || rawValue.toUpperCase() || 'SIN REGIÓN';
  }
  function regionOrderIndex(value){
    const idx = REGION_CANONICAL.indexOf(labelRegion(value));
    return idx === -1 ? 999 : idx;
  }
  function sortRegions(values){
    return values.sort((a,b)=>regionOrderIndex(a)-regionOrderIndex(b) || labelRegion(a).localeCompare(labelRegion(b),'es'));
  }
  function setAlert(msg,type){els.alert.textContent=msg; els.alert.className='pni-ie-alert '+(type||'');}
  function cobertura(mat,vac){return mat>0 ? (vac/mat*100) : 0;}
  function parseNumber(v){if(typeof v==='number')return v; const s=String(v??'0').replace(/\./g,'').replace(',','.').replace(/[^0-9.-]/g,''); return Number(s)||0;}

  function parseCSV(text){
    const clean = text.replace(/^\uFEFF/,'').replace(/\r/g,'');
    const lines = clean.split('\n').filter(l=>l.trim().length);
    if(lines.length<2) return [];
    const sep = (lines[0].split(';').length >= lines[0].split(',').length) ? ';' : ',';
    const headers = splitLine(lines[0], sep).map(h=>normKey(h).replace(/\s+/g,'_'));
    return lines.slice(1).map(line=>{
      const parts = splitLine(line, sep); const obj={}; headers.forEach((h,i)=>obj[h]=parts[i]??''); return normalizeRow(obj);
    }).filter(r=>r.region && r.comuna && r.establecimiento && r.matriculados>=0);
  }
  function splitLine(line, sep){
    const out=[]; let cur='', q=false;
    for(let i=0;i<line.length;i++){const ch=line[i]; if(ch==='"'){ if(q && line[i+1]==='"'){cur+='"'; i++;} else q=!q; } else if(ch===sep && !q){out.push(cur); cur='';} else cur+=ch;}
    out.push(cur); return out.map(s=>s.trim().replace(/^"|"$/g,''));
  }
  function normalizeRow(o){
    const region = norm(o.region || o.Region);
    const comuna = norm(o.comuna || o.Comuna);
    const establecimiento = norm(o.establecimiento || o.Establecimiento);
    const tipo = norm(o.tipo_escuela || o['tipo escuela'] || o.tipo || o.Tipo);
    const nivel = norm(o.nivel_escolar || o.nivel || o.Nivel);
    const matriculados = parseNumber(o.matriculados || o.Matriculados);
    const vacunados = parseNumber(o.vacunados || o.Vacunados);
    return {region, comuna, establecimiento, tipo, nivel, matriculados, vacunados, cobertura: cobertura(matriculados,vacunados)};
  }
  function aggregate(rows, key){
    const map = new Map();
    rows.forEach(r=>{const k=typeof key==='function'?key(r):r[key]; if(!map.has(k)) map.set(k,{key:k,matriculados:0,vacunados:0,establecimientos:new Set()}); const x=map.get(k); x.matriculados+=r.matriculados; x.vacunados+=r.vacunados; x.establecimientos.add(r.establecimiento+'|'+r.comuna+'|'+r.region);});
    return Array.from(map.values()).map(x=>({key:x.key, matriculados:x.matriculados, vacunados:x.vacunados, establecimientos:x.establecimientos.size, cobertura:cobertura(x.matriculados,x.vacunados)}));
  }
  function total(rows){const matriculados=rows.reduce((s,r)=>s+r.matriculados,0), vacunados=rows.reduce((s,r)=>s+r.vacunados,0); const establecimientos=new Set(rows.map(r=>r.establecimiento+'|'+r.comuna+'|'+r.region)).size; return {matriculados,vacunados,establecimientos,cobertura:cobertura(matriculados,vacunados)};}
  function uniq(rows,key){return Array.from(new Set(rows.map(r=>r[key]).filter(Boolean))).sort((a,b)=>String(a).localeCompare(String(b),'es'));}
  function fillSelect(sel, values, labeler, placeholder){const current=sel.value; const first=placeholder || 'Todas'; sel.innerHTML='<option value="">'+escapeHtml(first)+'</option>'+values.map(v=>`<option value="${escapeHtml(v)}">${escapeHtml(labeler?labeler(v):v)}</option>`).join(''); if(values.includes(current)) sel.value=current;}
  function fillDatalist(list, values){ if(!list) return; list.innerHTML = values.map(v=>`<option value="${escapeHtml(v)}"></option>`).join(''); }
  function escapeHtml(s){return String(s??'').replace(/[&<>"]/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m]));}

  function applyFilters(){
    const reg=els.region.value, com=els.comuna.value, tip=els.tipo.value, niv=els.nivel.value, est=norm(els.search.value);
    const estKey = normKey(est);
    filtered = raw.filter(r=>(!reg||r.region===reg)&&(!com||r.comuna===com)&&(!tip||r.tipo===tip)&&(!niv||r.nivel===niv)&&(!estKey||normKey(r.establecimiento).includes(estKey)));
    renderAll();
  }
  function refreshDependentFilters(){
    const reg=els.region.value;
    const baseCom = reg ? raw.filter(r=>r.region===reg) : raw;
    fillSelect(els.comuna, uniq(baseCom,'comuna'));
    fillSelect(els.tipo, uniq(raw,'tipo'));
    fillSelect(els.nivel, orderLevels(uniq(raw,'nivel')));
    refreshEstablecimientos();
  }
  function refreshEstablecimientos(){
    if(!els.search) return;
    const current=els.search.value;
    const reg=els.region.value, com=els.comuna.value, tip=els.tipo.value, niv=els.nivel.value;
    const base = raw.filter(r=>(!reg||r.region===reg)&&(!com||r.comuna===com)&&(!tip||r.tipo===tip)&&(!niv||r.nivel===niv));
    const values = Array.from(new Set(base.map(r=>r.establecimiento).filter(Boolean))).sort((a,b)=>a.localeCompare(b,'es'));
    fillDatalist(els.searchList, values);
    if(current && !values.some(v=>normKey(v).includes(normKey(current)) || normKey(current).includes(normKey(v)))) els.search.value='';
  }
  function orderLevels(arr){const order=['Pre kinder','Prekinder','PK','Kinder','K','1°','2°','3°','4°','5°']; return arr.sort((a,b)=>{const ia=order.findIndex(x=>normKey(a)===normKey(x)); const ib=order.findIndex(x=>normKey(b)===normKey(x)); return (ia<0?99:ia)-(ib<0?99:ib)||a.localeCompare(b,'es');});}

  function renderAll(){renderSummary(); renderBars(); renderRankings(); renderDownloadInfo(); renderFilterChip(); renderSelectedEstablecimiento();}
  function renderSummary(){
    const t=total(filtered); const deficit=Math.max(0, Math.ceil(t.matriculados*META/100)-t.vacunados); const cls=covClass(t.cobertura);
    els.kCob.textContent=pct(t.cobertura); els.kEstado.textContent=cls==='ok'?'Meta 85% alcanzada':(cls==='warn'?'Cercano a la meta':'Bajo meta programática');
    els.kMat.textContent=fmt(t.matriculados); els.kVac.textContent=fmt(t.vacunados); els.kPend.textContent=fmt(deficit); els.kBrecha.textContent=deficit===0?'Sin brecha para meta 85%':'Dosis requeridas para 85%'; els.kEst.textContent=fmt(t.establecimientos);
  }
  function renderFilterChip(){const parts=[]; if(els.region.value)parts.push(labelRegion(els.region.value)); if(els.comuna.value)parts.push(els.comuna.value); if(els.tipo.value)parts.push(els.tipo.value); if(els.nivel.value)parts.push(els.nivel.value); if(els.search.value)parts.push('Establecimiento: '+els.search.value); els.filtroResumen.textContent=parts.length?parts.join(' · '):'Vista nacional';}
  function renderSelectedEstablecimiento(){
    if(!els.selectedCard || !els.estNombre || !els.estDetalle || !els.estCobertura) return;
    const t=total(filtered);
    const cls=covClass(t.cobertura);
    els.selectedCard.className='pni-ie-selected-card '+(filtered.length?cls:'');
    if(els.search.value){
      const comunas=Array.from(new Set(filtered.map(r=>r.comuna).filter(Boolean))).join(' / ');
      const regiones=Array.from(new Set(filtered.map(r=>labelRegion(r.region)).filter(Boolean))).join(' / ');
      const niveles=Array.from(new Set(filtered.map(r=>r.nivel).filter(Boolean))).join(', ');
      els.estNombre.textContent=els.search.value;
      els.estDetalle.textContent=(regiones||'Sin región')+' · '+(comunas||'Sin comuna')+' · '+fmt(t.vacunados)+' vacunados / '+fmt(t.matriculados)+' matriculados'+(niveles?' · Niveles: '+niveles:'');
      els.estCobertura.textContent=pct(t.cobertura);
    } else {
      const ambito=[]; if(els.region.value) ambito.push(labelRegion(els.region.value)); if(els.comuna.value) ambito.push(els.comuna.value); if(els.tipo.value) ambito.push(els.tipo.value); if(els.nivel.value) ambito.push(els.nivel.value);
      els.estNombre.textContent=ambito.length?ambito.join(' · '):'Vista nacional / territorial';
      els.estDetalle.textContent=ambito.length?'Seleccione un establecimiento específico para ver el detalle nominal del recinto.':'Seleccione región, comuna o establecimiento para focalizar el análisis.';
      els.estCobertura.textContent=filtered.length?pct(t.cobertura):'--';
    }
  }
  function renderBars(){
    const niveles=aggregate(filtered,'nivel').sort((a,b)=>orderLevels([a.key,b.key])[0]===a.key?-1:1);
    els.nivelChart.innerHTML = niveles.map(x=>bar(x.key,x.cobertura,x.vacunados,x.matriculados)).join('') || '<div class="pni-ie-empty">Sin datos para los filtros seleccionados.</div>';
    const regiones=aggregate(filtered,'region').sort((a,b)=>b.cobertura-a.cobertura).slice(0,16);
    els.regionChart.innerHTML = regiones.map(x=>bar(labelRegion(x.key),x.cobertura,x.vacunados,x.matriculados)).join('') || '<div class="pni-ie-empty">Sin datos regionales.</div>';
  }
  function bar(label,c,v,m){return `<div class="pni-ie-bar-row" title="${escapeHtml(fmt(v)+' vacunados de '+fmt(m)+' matriculados')}"><div class="pni-ie-bar-label">${escapeHtml(label)}</div><div class="pni-ie-bar-track"><div class="pni-ie-bar-fill ${covClass(c)}" style="width:${Math.min(100,Math.max(0,c))}%"></div></div><div class="pni-ie-bar-value">${pct(c)}</div></div>`;}
  function renderRankings(){
    const comunas=aggregate(filtered,r=>r.region+'|'+r.comuna).filter(x=>x.matriculados>0).sort((a,b)=>a.cobertura-b.cobertura).slice(0,10);
    els.rankingComunas.innerHTML = comunas.map((x,i)=>{const [reg,com]=x.key.split('|'); return rank(i+1,com,labelRegion(reg)+' · '+fmt(x.vacunados)+'/'+fmt(x.matriculados),x.cobertura);}).join('') || '<div class="pni-ie-empty">Sin datos comunales.</div>';
    const est=aggregate(filtered,r=>r.region+'|'+r.comuna+'|'+r.establecimiento).filter(x=>x.matriculados>0).sort((a,b)=>activeTab==='baja'?a.cobertura-b.cobertura:b.cobertura-a.cobertura).slice(0,12);
    els.rankingEst.innerHTML = est.map((x,i)=>{const [reg,com,establecimiento]=x.key.split('|'); return rank(i+1,establecimiento,`${labelRegion(reg)} · ${com} · ${fmt(x.vacunados)}/${fmt(x.matriculados)}`,x.cobertura);}).join('') || '<div class="pni-ie-empty">Sin datos de establecimientos.</div>';
  }
  function rank(n,title,sub,c){return `<div class="pni-ie-rank-item"><div class="pni-ie-rank-num">${n}</div><div><div class="pni-ie-rank-title">${escapeHtml(title)}</div><div class="pni-ie-rank-sub">${escapeHtml(sub)}</div></div><div class="pni-ie-rank-val"><span class="pni-ie-pill ${covClass(c)}">${pct(c)}</span></div></div>`;}
  function renderDownloadInfo(){
    if(!els.downloadCount) return;
    const n = filtered.length;
    const t = total(filtered);
    els.downloadCount.textContent = fmt(n)+' registros disponibles · '+fmt(t.vacunados)+' vacunados / '+fmt(t.matriculados)+' matriculados';
  }
  function exportCsv(){
    const headers=['region','comuna','establecimiento','tipo_escuela','nivel_escolar','matriculados','vacunados','cobertura'];
    const lines=[headers.join(';')].concat(filtered.map(r=>[labelRegion(r.region),r.comuna,r.establecimiento,r.tipo,r.nivel,r.matriculados,r.vacunados,pct(r.cobertura).replace('%','')].map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(';')));
    const blob=new Blob(['\uFEFF'+lines.join('\n')],{type:'text/csv;charset=utf-8;'}); const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download='influenza_escolar_2026_filtrado.csv'; document.body.appendChild(a); a.click(); a.remove(); setTimeout(()=>URL.revokeObjectURL(a.href),1000);
  }
  async function loadFromUrl(url){
    if(!url){setAlert('Debe pegar la URL pública del CSV o cargar un archivo local.','err');return;}
    setAlert('Cargando CSV desde WordPress...');
    try{const res=await fetch(url+(url.includes('?')?'&':'?')+'nocache='+Date.now(),{cache:'no-store'}); if(!res.ok) throw new Error('HTTP '+res.status); const text=await res.text(); setData(parseCSV(text), 'CSV cargado correctamente desde URL.');}
    catch(e){setAlert('No fue posible cargar la URL indicada. Revise que el CSV sea público, que no tenga bloqueo CORS y que la ruta sea correcta. También puede usar “Cargar archivo local”.','err'); console.error(e);}
  }
  function setData(rows,msg){
    raw=rows; filtered=rows.slice(); if(!raw.length){setAlert('El CSV no contiene registros válidos. Revise encabezados y separador.', 'err'); return;}
    els.fecha.textContent=new Date().toLocaleString('es-CL',{dateStyle:'short',timeStyle:'short'}); els.total.textContent=fmt(raw.length)+' registros cargados';
    fillSelect(els.region, sortRegions(uniq(raw,'region')), labelRegion); fillSelect(els.comuna, uniq(raw,'comuna')); fillSelect(els.tipo, uniq(raw,'tipo')); fillSelect(els.nivel, orderLevels(uniq(raw,'nivel'))); refreshEstablecimientos();
    setAlert(msg || 'Base cargada correctamente.', 'ok'); applyFilters();
  }
  function resetFilters(){els.region.value=''; refreshDependentFilters(); els.comuna.value=''; els.tipo.value=''; els.nivel.value=''; els.search.value=''; applyFilters();}

  els.url.value=DEFAULT_CSV_URL;
  els.btnCargar.addEventListener('click',()=>loadFromUrl(els.url.value.trim()));
  els.file.addEventListener('change',(ev)=>{const file=ev.target.files&&ev.target.files[0]; if(!file)return; const reader=new FileReader(); reader.onload=()=>setData(parseCSV(String(reader.result||'')), 'Archivo local cargado correctamente.'); reader.onerror=()=>setAlert('No fue posible leer el archivo local.','err'); reader.readAsText(file,'utf-8');});
  els.btnReset.addEventListener('click',resetFilters);
  [els.region,els.tipo,els.nivel].forEach(el=>el.addEventListener('change',()=>{if(el===els.region) refreshDependentFilters(); else refreshEstablecimientos(); applyFilters();}));
  els.comuna.addEventListener('change',()=>{refreshEstablecimientos(); applyFilters();});
  els.search.addEventListener('input',applyFilters);
  els.search.addEventListener('change',applyFilters);
  document.querySelectorAll('#'+ROOT_ID+' .pni-ie-tabs button').forEach(btn=>btn.addEventListener('click',()=>{document.querySelectorAll('#'+ROOT_ID+' .pni-ie-tabs button').forEach(b=>b.classList.remove('active')); btn.classList.add('active'); activeTab=btn.dataset.tab; renderRankings();}));
  if(els.btnCsv) els.btnCsv.addEventListener('click',exportCsv); if(els.btnPrint) els.btnPrint.addEventListener('click',()=>window.print());
  loadFromUrl(DEFAULT_CSV_URL);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', iniciarVisorInfluenzaEscolar2026);
  } else {
    iniciarVisorInfluenzaEscolar2026();
  }
})();
</script><style class="wpcode-css-snippet">/* Visor Influenza Escolar y Preescolar 2026 - PNI/MINSAL */
#pniInfluenzaEscolar2026{--azul:#0b3a6f;--azul2:#0f5e9c;--celeste:#eaf4ff;--borde:#d8e4f0;--texto:#16243a;--muted:#61738b;--ok:#1f9254;--warn:#c98200;--bad:#c23a3a;--bg:#f5f8fc;font-family:Inter,Segoe UI,Roboto,Arial,sans-serif;color:var(--texto);max-width:1420px;margin:0 auto;padding:18px;background:var(--bg)}
#pniInfluenzaEscolar2026 *{box-sizing:border-box}
.pni-ie-hero{border-radius:28px;padding:28px;background:linear-gradient(135deg,#07305f,#0c5794 58%,#0f77b7);color:#fff;box-shadow:0 18px 45px rgba(8,50,94,.24);overflow:hidden;position:relative}
.pni-ie-hero:after{content:"";position:absolute;right:-120px;top:-140px;width:360px;height:360px;border-radius:50%;background:rgba(255,255,255,.12)}
.pni-ie-hero-top,.pni-ie-hero-body{position:relative;z-index:1}.pni-ie-hero-top{display:flex;align-items:center;justify-content:space-between;gap:18px;margin-bottom:26px}.pni-ie-logo{max-height:92px;width:auto;object-fit:contain}.pni-ie-badge{padding:9px 14px;border-radius:999px;background:rgba(255,255,255,.15);border:1px solid rgba(255,255,255,.28);font-weight:700;font-size:13px;letter-spacing:.02em}.pni-ie-hero-body{display:grid;grid-template-columns:1fr 280px;gap:22px;align-items:end}.pni-ie-kicker{text-transform:uppercase;letter-spacing:.14em;font-size:12px;font-weight:800;margin:0 0 8px;opacity:.9}.pni-ie-hero h1{font-size:clamp(30px,4vw,52px);line-height:1.02;margin:0 0 12px;color:#fff}.pni-ie-subtitle{font-size:17px;line-height:1.55;max-width:860px;margin:0;opacity:.94}.pni-ie-hero-card{background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.25);border-radius:22px;padding:18px;backdrop-filter:blur(6px)}.pni-ie-hero-card span,.pni-ie-hero-card small{display:block;opacity:.9}.pni-ie-hero-card strong{display:block;font-size:23px;margin:6px 0;color:#fff}.pni-ie-alert{margin:16px 0;padding:13px 16px;border-radius:16px;background:#fff7e6;border:1px solid #f2d38f;color:#6b4700;font-weight:700}.pni-ie-alert.ok{background:#eaf8f0;border-color:#bfe8cf;color:#17643c}.pni-ie-alert.err{background:#fff0f0;border-color:#f0b9b9;color:#8d1f1f}.pni-ie-toolbar,.pni-ie-filters,.pni-ie-panel,.pni-ie-kpi{background:#fff;border:1px solid var(--borde);box-shadow:0 12px 30px rgba(31,63,96,.08)}.pni-ie-toolbar{display:flex;gap:12px;align-items:end;flex-wrap:wrap;margin:18px 0;padding:16px;border-radius:22px}.pni-ie-field{display:flex;flex-direction:column;gap:7px;min-width:170px;flex:1}.pni-ie-field label{font-size:12px;color:var(--muted);font-weight:800;text-transform:uppercase;letter-spacing:.05em}.pni-ie-field input,.pni-ie-field select{width:100%;border:1px solid var(--borde);border-radius:14px;padding:12px 13px;font-size:14px;background:#fff;color:var(--texto);outline:none}.pni-ie-field input:focus,.pni-ie-field select:focus{border-color:#4d91c9;box-shadow:0 0 0 4px rgba(33,113,178,.12)}.pni-ie-btn,.pni-ie-file-btn{border:1px solid var(--borde);background:#fff;color:var(--azul);border-radius:14px;padding:12px 15px;font-weight:800;cursor:pointer;line-height:1;white-space:nowrap}.pni-ie-btn:hover,.pni-ie-file-btn:hover{transform:translateY(-1px);box-shadow:0 8px 18px rgba(20,55,90,.12)}.pni-ie-btn-primary{background:var(--azul);border-color:var(--azul);color:#fff}.pni-ie-file-btn{display:inline-flex;align-items:center;min-height:40px}.pni-ie-file-btn input{display:none}.pni-ie-summary-grid{display:grid;grid-template-columns:1.2fr repeat(4,1fr);gap:14px;margin:18px 0}.pni-ie-kpi{border-radius:22px;padding:18px;position:relative;overflow:hidden}.pni-ie-kpi:after{content:"";position:absolute;right:-24px;bottom:-24px;width:90px;height:90px;border-radius:50%;background:var(--celeste)}.pni-ie-kpi span,.pni-ie-kpi small{display:block;color:var(--muted);position:relative;z-index:1}.pni-ie-kpi span{font-weight:900;font-size:12px;text-transform:uppercase;letter-spacing:.06em}.pni-ie-kpi strong{display:block;font-size:clamp(25px,3vw,39px);margin:9px 0 4px;position:relative;z-index:1;color:var(--azul)}.pni-ie-kpi.kpi-main{background:linear-gradient(135deg,#fff,#eef7ff)}.pni-ie-filters{border-radius:24px;padding:18px;margin:18px 0}.pni-ie-filter-head,.pni-ie-panel-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:16px}.pni-ie-filter-head h2,.pni-ie-panel h2{margin:0 0 4px;color:var(--azul);font-size:21px}.pni-ie-filter-head p,.pni-ie-panel p{margin:0;color:var(--muted);font-size:14px}.pni-ie-chip{padding:10px 13px;border-radius:999px;background:var(--celeste);color:var(--azul);font-weight:900;font-size:13px}.pni-ie-filter-grid{display:grid;grid-template-columns:repeat(4,1fr) 1.4fr;gap:12px}.pni-ie-layout{display:grid;grid-template-columns:1.05fr .95fr;gap:18px;margin:18px 0}.pni-ie-layout.two{grid-template-columns:1fr 1fr}.pni-ie-panel{border-radius:24px;padding:18px;min-width:0}.pni-ie-legend{font-size:12px;color:var(--muted);white-space:nowrap}.pni-ie-legend i{display:inline-block;width:10px;height:10px;border-radius:50%;margin:0 4px 0 10px}.pni-ie-legend .ok{background:var(--ok)}.pni-ie-legend .warn{background:var(--warn)}.pni-ie-legend .bad{background:var(--bad)}.pni-ie-map-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}.pni-ie-region-tile{border:1px solid var(--borde);border-radius:16px;padding:12px;background:#f8fbff;cursor:pointer;min-height:88px;transition:.18s}.pni-ie-region-tile:hover,.pni-ie-region-tile.active{transform:translateY(-2px);box-shadow:0 12px 22px rgba(20,55,90,.13);border-color:#7db4e0}.pni-ie-region-tile strong{display:block;font-size:14px;color:var(--azul);margin-bottom:8px}.pni-ie-region-tile span{display:block;font-weight:900;font-size:22px}.pni-ie-region-tile small{color:var(--muted)}.pni-ie-region-tile.ok{border-left:6px solid var(--ok)}.pni-ie-region-tile.warn{border-left:6px solid var(--warn)}.pni-ie-region-tile.bad{border-left:6px solid var(--bad)}.pni-ie-bars{display:flex;flex-direction:column;gap:12px}.pni-ie-bar-row{display:grid;grid-template-columns:135px 1fr 68px;gap:10px;align-items:center}.pni-ie-bars.compact .pni-ie-bar-row{grid-template-columns:120px 1fr 62px}.pni-ie-bar-label{font-weight:850;color:var(--texto);font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.pni-ie-bar-track{height:18px;background:#eef3f8;border-radius:999px;overflow:hidden;border:1px solid #e1eaf3}.pni-ie-bar-fill{height:100%;width:0;border-radius:999px;transition:width .35s ease;background:linear-gradient(90deg,#0d5d9d,#49a0d8)}.pni-ie-bar-fill.ok{background:linear-gradient(90deg,#16804a,#33b56d)}.pni-ie-bar-fill.warn{background:linear-gradient(90deg,#b87900,#e7aa30)}.pni-ie-bar-fill.bad{background:linear-gradient(90deg,#a83232,#d95b5b)}.pni-ie-bar-value{text-align:right;font-weight:900;color:var(--azul);font-size:13px}.pni-ie-ranking{display:flex;flex-direction:column;gap:10px}.pni-ie-rank-item{display:grid;grid-template-columns:36px 1fr auto;gap:10px;align-items:center;border:1px solid var(--borde);border-radius:16px;padding:11px;background:#fbfdff}.pni-ie-rank-num{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;background:var(--celeste);font-weight:900;color:var(--azul)}.pni-ie-rank-title{font-weight:900;color:var(--texto);line-height:1.22}.pni-ie-rank-sub{font-size:12px;color:var(--muted);margin-top:3px}.pni-ie-rank-val{font-weight:950;font-size:19px;color:var(--azul);white-space:nowrap}.pni-ie-ranking.cards{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}.pni-ie-tabs{display:flex;gap:8px;background:#f0f5fa;padding:5px;border-radius:999px}.pni-ie-tabs button{border:0;background:transparent;padding:9px 12px;border-radius:999px;font-weight:900;color:var(--azul);cursor:pointer}.pni-ie-tabs button.active{background:#fff;box-shadow:0 4px 12px rgba(20,55,90,.12)}.pni-ie-actions{display:flex;gap:8px;flex-wrap:wrap}.pni-ie-table-wrap{width:100%;overflow:auto;border:1px solid var(--borde);border-radius:16px}.pni-ie-table{width:100%;border-collapse:separate;border-spacing:0;font-size:13px;min-width:980px}.pni-ie-table th{position:sticky;top:0;background:#0b3a6f;color:#fff;text-align:left;padding:12px;font-size:12px;text-transform:uppercase;letter-spacing:.04em}.pni-ie-table td{padding:11px 12px;border-bottom:1px solid #edf2f7;vertical-align:top}.pni-ie-table tbody tr:nth-child(even){background:#f9fbfe}.pni-ie-table .cov{font-weight:900}.pni-ie-pill{display:inline-flex;align-items:center;border-radius:999px;padding:4px 8px;font-size:12px;font-weight:900}.pni-ie-pill.ok{background:#e8f7ef;color:var(--ok)}.pni-ie-pill.warn{background:#fff4dc;color:#9a6200}.pni-ie-pill.bad{background:#fff0f0;color:var(--bad)}.pni-ie-footer{margin:18px 0 0;padding:14px 4px;color:var(--muted);font-size:13px}.pni-ie-empty{padding:16px;border:1px dashed var(--borde);border-radius:16px;color:var(--muted);background:#fbfdff}.pni-ie-map-panel{min-height:420px}@media(max-width:1100px){.pni-ie-hero-body,.pni-ie-layout,.pni-ie-layout.two{grid-template-columns:1fr}.pni-ie-summary-grid{grid-template-columns:repeat(2,1fr)}.pni-ie-filter-grid{grid-template-columns:repeat(2,1fr)}.pni-ie-map-grid{grid-template-columns:repeat(3,1fr)}}@media(max-width:720px){#pniInfluenzaEscolar2026{padding:10px}.pni-ie-hero{padding:20px;border-radius:22px}.pni-ie-hero-top{align-items:flex-start;flex-direction:column}.pni-ie-logo{max-height:74px}.pni-ie-toolbar{align-items:stretch}.pni-ie-btn,.pni-ie-file-btn{width:100%;justify-content:center}.pni-ie-summary-grid,.pni-ie-filter-grid,.pni-ie-ranking.cards{grid-template-columns:1fr}.pni-ie-filter-head,.pni-ie-panel-head{flex-direction:column}.pni-ie-map-grid{grid-template-columns:repeat(2,1fr)}.pni-ie-bar-row,.pni-ie-bars.compact .pni-ie-bar-row{grid-template-columns:92px 1fr 58px}.pni-ie-legend{white-space:normal}.pni-ie-rank-item{grid-template-columns:32px 1fr}.pni-ie-rank-val{grid-column:2;text-align:left}}
@media print{#pniInfluenzaEscolar2026{background:#fff;max-width:none}.pni-ie-toolbar,.pni-ie-actions,.pni-ie-tabs{display:none!important}.pni-ie-panel,.pni-ie-kpi,.pni-ie-filters,.pni-ie-hero{box-shadow:none}.pni-ie-table th{position:static}}

/* Ajustes V2: se oculta la tabla extensa y se deja panel de descarga filtrada */
#pniInfluenzaEscolar2026 .pni-ie-layout-single{grid-template-columns:1fr}
#pniInfluenzaEscolar2026 .pni-ie-download-panel{background:linear-gradient(135deg,#ffffff,#f5faff)}
#pniInfluenzaEscolar2026 .pni-ie-download-box{display:flex;align-items:center;justify-content:space-between;gap:16px;border:1px dashed var(--borde);background:#fbfdff;border-radius:18px;padding:18px}
#pniInfluenzaEscolar2026 .pni-ie-download-box strong{display:block;color:var(--azul);font-size:20px;margin-bottom:4px}
#pniInfluenzaEscolar2026 .pni-ie-download-box span{display:block;color:var(--muted);font-size:14px;line-height:1.45}
@media(max-width:720px){#pniInfluenzaEscolar2026 .pni-ie-download-box{align-items:flex-start;flex-direction:column}}


/* Ajustes V3: selector desplegable de establecimiento y tarjeta destacada */
#pniInfluenzaEscolar2026 .pni-ie-selected-card{display:grid;grid-template-columns:auto 1fr auto;gap:16px;align-items:center;margin:18px 0;padding:18px 20px;border-radius:24px;background:linear-gradient(135deg,#07305f,#0f6dab);color:#fff;box-shadow:0 16px 36px rgba(8,50,94,.20);border:1px solid rgba(255,255,255,.18);position:relative;overflow:hidden}
#pniInfluenzaEscolar2026 .pni-ie-selected-card:after{content:"";position:absolute;right:-55px;top:-75px;width:190px;height:190px;border-radius:50%;background:rgba(255,255,255,.12)}
#pniInfluenzaEscolar2026 .pni-ie-selected-icon{width:52px;height:52px;border-radius:18px;display:grid;place-items:center;background:rgba(255,255,255,.16);font-size:28px;position:relative;z-index:1}
#pniInfluenzaEscolar2026 .pni-ie-selected-content,#pniInfluenzaEscolar2026 .pni-ie-selected-metric{position:relative;z-index:1}
#pniInfluenzaEscolar2026 .pni-ie-selected-content span,#pniInfluenzaEscolar2026 .pni-ie-selected-metric span{display:block;font-size:12px;text-transform:uppercase;letter-spacing:.08em;font-weight:900;opacity:.82}
#pniInfluenzaEscolar2026 .pni-ie-selected-content strong{display:block;font-size:clamp(20px,2.4vw,32px);line-height:1.12;margin:5px 0;color:#fff}
#pniInfluenzaEscolar2026 .pni-ie-selected-content small{display:block;font-size:14px;line-height:1.45;opacity:.92}
#pniInfluenzaEscolar2026 .pni-ie-selected-metric{min-width:150px;text-align:center;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.25);border-radius:18px;padding:12px 14px}
#pniInfluenzaEscolar2026 .pni-ie-selected-metric strong{display:block;font-size:30px;line-height:1.1;margin-top:5px;color:#fff}
#pniInfluenzaEscolar2026 .pni-ie-selected-card.ok{background:linear-gradient(135deg,#07543a,#1f9254)}
#pniInfluenzaEscolar2026 .pni-ie-selected-card.warn{background:linear-gradient(135deg,#704800,#c98200)}
#pniInfluenzaEscolar2026 .pni-ie-selected-card.bad{background:linear-gradient(135deg,#6f1d1d,#c23a3a)}
@media(max-width:720px){#pniInfluenzaEscolar2026 .pni-ie-selected-card{grid-template-columns:1fr;text-align:left}#pniInfluenzaEscolar2026 .pni-ie-selected-metric{text-align:left;min-width:0}}


/* Ajustes V4: orden nacional de regiones, establecimiento buscable y mayor presencia institucional */
#pniInfluenzaEscolar2026 .pni-ie-logo{max-height:118px !important;}
#pniInfluenzaEscolar2026 .pni-ie-search{min-width:280px;}
#pniInfluenzaEscolar2026 input[list]::-webkit-calendar-picker-indicator{opacity:.75;cursor:pointer;}
#pniInfluenzaEscolar2026 .pni-ie-chip{text-transform:uppercase;}
#pniInfluenzaEscolar2026 .pni-ie-selected-card{margin-top:20px;margin-bottom:20px;}
@media(max-width:720px){#pniInfluenzaEscolar2026 .pni-ie-logo{max-height:92px !important;}}
</style><script>(function () {
  const CSV_URL = "https://vacunas.minsal.cl/wp-content/uploads/2026/06/mpox_regiones.csv?nocache=" + Date.now();
  const GEOJSON_URLS = [
    "https://raw.githubusercontent.com/caracena/chile-geojson/master/regiones.json",
    "https://cdn.jsdelivr.net/gh/caracena/chile-geojson@master/regiones.json"
  ];

  let map, geoLayer, selectedLayer = null, DATA = [], TOTAL = null;

  function ready(fn) {
    if (document.readyState !== "loading") fn();
    else document.addEventListener("DOMContentLoaded", fn);
  }

  function loadCss(href) {
    if ([...document.styleSheets].some(s => s.href && s.href.includes(href))) return Promise.resolve();
    return new Promise((resolve) => {
      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = href;
      link.onload = resolve;
      document.head.appendChild(link);
    });
  }

  function loadScript(src) {
    if (window.L) return Promise.resolve();
    return new Promise((resolve, reject) => {
      const s = document.createElement("script");
      s.src = src;
      s.onload = resolve;
      s.onerror = reject;
      document.head.appendChild(s);
    });
  }

  function setStatus(txt, type) {
    const el = document.getElementById("mpoxStatus");
    if (!el) return;
    el.textContent = txt;
    el.className = "mpox-geo-status" + (type ? " " + type : "");
  }

  function parseNumber(v) {
    if (v == null) return 0;
    let s = String(v).trim().replace(/\s/g, "");
    if (s.includes(",") && s.includes(".")) s = s.replace(/\./g, "").replace(",", ".");
    else if (s.includes(",")) s = s.replace(",", ".");
    else {
      const parts = s.split(".");
      if (parts.length > 2 || (parts.length === 2 && parts[1].length === 3)) s = s.replace(/\./g, "");
    }
    const n = Number(s);
    return Number.isFinite(n) ? n : 0;
  }

  function parseCSV(text) {
    const lines = text.replace(/^\uFEFF/, "").split(/\r?\n/).filter(Boolean);
    const sep = lines[0].includes(";") ? ";" : ",";
    const headers = splitLine(lines[0], sep).map(h => normKey(h));
    return lines.slice(1).map(line => {
      const cells = splitLine(line, sep);
      const obj = {};
      headers.forEach((h, i) => obj[h] = (cells[i] || "").trim());
      const region = obj.region || obj.región || obj.Region || obj.Región || obj.nombre || "";
      return {
        region: region.trim(),
        key: normName(region),
        dosis_1: parseNumber(obj.dosis_1 || obj.dosis1 || obj["dosis 1"]),
        dosis_2: parseNumber(obj.dosis_2 || obj.dosis2 || obj["dosis 2"]),
        total: parseNumber(obj.total),
        esquema: parseNumber(obj.esquema_completo || obj.esquema || obj["esquema completo"] || obj["esquema_completo(%)"])
      };
    }).filter(d => d.region);
  }

  function splitLine(line, sep) {
    const out = []; let cur = ""; let q = false;
    for (let i = 0; i < line.length; i++) {
      const ch = line[i];
      if (ch === '"') { q = !q; continue; }
      if (ch === sep && !q) { out.push(cur); cur = ""; continue; }
      cur += ch;
    }
    out.push(cur); return out;
  }

  function normKey(s) { return String(s || "").trim().toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").replace(/[^a-z0-9]+/g, "_").replace(/^_|_$/g, ""); }
  function normName(s) {
    let x = String(s || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
    x = x.replace(/regi[oó]n de /g, "").replace(/region del /g, "").replace(/region /g, "");
    x = x.replace(/libertador general bernardo o.?higgins/g, "libertador bernardo ohiggins");
    x = x.replace(/libertador bernardo o.?higgins/g, "libertador bernardo ohiggins");
    x = x.replace(/metropolitana de santiago/g, "metropolitana");
    x = x.replace(/biobio|bio bio|bío bío|bío-bío/g, "bio-bio");
    x = x.replace(/araucania/g, "araucania");
    x = x.replace(/nuble/g, "nuble");
    return x.replace(/[^a-z0-9]+/g, " ").trim();
  }

  function fmtInt(n) { return Math.round(n || 0).toLocaleString("es-CL"); }
  function fmtPct(n) { return (n || 0).toLocaleString("es-CL", { minimumFractionDigits: 1, maximumFractionDigits: 1 }) + "%"; }

  function color(v) {
    if (v >= 90) return "#139565";
    if (v >= 80) return "#168f73";
    if (v >= 70) return "#e3a400";
    return "#cc3b2f";
  }
  function clasif(v) {
    if (v >= 90) return "≥90%";
    if (v >= 80) return "80–89%";
    if (v >= 70) return "70–79%";
    return "<70%";
  }
  function interp(v) {
    if (v >= 90) return "La región presenta una cobertura muy alta de esquemas completos, compatible con un nivel avanzado de adherencia al esquema.";
    if (v >= 80) return "La región presenta una cobertura alta de esquemas completos, aunque mantiene margen para consolidar el cierre de esquemas pendientes.";
    if (v >= 70) return "La región presenta una cobertura intermedia de esquemas completos, por lo que se recomienda reforzar el seguimiento de personas con esquema iniciado.";
    return "La región presenta una cobertura baja de esquemas completos, constituyendo un territorio prioritario para acciones focalizadas de rescate y seguimiento.";
  }

  function getFeatureName(feature) {
    const p = feature.properties || {};
    const keys = ["Region", "REGION", "NOM_REG", "NOMBRE", "Nombre", "nom_reg", "name", "NAME", "CUT_REG"];
    for (const k of keys) if (p[k]) return String(p[k]);
    return Object.values(p).find(v => typeof v === "string") || "Región";
  }

  function byFeature(feature) {
    const name = getFeatureName(feature);
    const k = normName(name);
    let d = DATA.find(x => x.key === k);
    if (!d) d = DATA.find(x => k.includes(x.key) || x.key.includes(k));
    return d || null;
  }



  function featureIsValparaiso(feature) {
    const n = normName(getFeatureName(feature));
    return n.includes("valparaiso");
  }

  function polygonMaxLon(poly) {
    let maxLon = -Infinity;
    const scan = (arr) => {
      if (!Array.isArray(arr)) return;
      if (typeof arr[0] === "number" && typeof arr[1] === "number") {
        if (arr[0] > maxLon) maxLon = arr[0];
        return;
      }
      arr.forEach(scan);
    };
    scan(poly);
    return maxLon;
  }

  function removeValparaisoRemoteIslands(geojson) {
    /*
      El GeoJSON público incorpora territorios insulares de Valparaíso
      (por ejemplo, Rapa Nui/Juan Fernández). Para este panel se excluyen
      las geometrías alejadas al oeste, manteniendo sólo el polígono continental.
    */
    const clone = JSON.parse(JSON.stringify(geojson));
    const features = Array.isArray(clone.features) ? clone.features : [];

    features.forEach((feature) => {
      if (!feature || !feature.geometry || !featureIsValparaiso(feature)) return;

      const geom = feature.geometry;
      const MAINLAND_LON_LIMIT = -76; // Chile continental central queda al este de este umbral.

      if (geom.type === "MultiPolygon") {
        geom.coordinates = geom.coordinates.filter((poly) => polygonMaxLon(poly) > MAINLAND_LON_LIMIT);
      }

      if (geom.type === "Polygon") {
        if (polygonMaxLon(geom.coordinates) <= MAINLAND_LON_LIMIT) {
          geom.coordinates = [];
        }
      }
    });

    clone.features = features.filter((feature) => {
      if (!feature.geometry) return false;
      if (feature.geometry.type === "MultiPolygon") return feature.geometry.coordinates.length > 0;
      if (feature.geometry.type === "Polygon") return feature.geometry.coordinates.length > 0;
      return true;
    });

    return clone;
  }

  function setKPIs() {
    TOTAL = DATA.find(d => normName(d.region) === "total") || {
      dosis_1: DATA.reduce((a,b)=>a+b.dosis_1,0), dosis_2: DATA.reduce((a,b)=>a+b.dosis_2,0), total: DATA.reduce((a,b)=>a+b.total,0), esquema: 0, region:"Total nacional"
    };
    if (!TOTAL.esquema && TOTAL.dosis_1) TOTAL.esquema = TOTAL.dosis_2 / TOTAL.dosis_1 * 100;
    document.getElementById("mpoxKpiDosis1").textContent = fmtInt(TOTAL.dosis_1);
    document.getElementById("mpoxKpiDosis2").textContent = fmtInt(TOTAL.dosis_2);
    document.getElementById("mpoxKpiTotal").textContent = fmtInt(TOTAL.total);
    document.getElementById("mpoxKpiCobertura").textContent = fmtPct(TOTAL.esquema);
    updateDetail(null);
  }

  function updateDetail(d) {
    const v = d ? d.esquema : (TOTAL ? TOTAL.esquema : 0);
    document.getElementById("mpoxSelectedRegion").textContent = d ? d.region : "Total nacional";
    document.getElementById("mpoxRing").style.setProperty("--pct", Math.max(0, Math.min(100, v)));
    document.getElementById("mpoxRing").style.background = `conic-gradient(${color(v)} ${Math.max(0, Math.min(100, v))}%, #eaf0f6 0)`;
    document.getElementById("mpoxRingValue").textContent = d || TOTAL ? fmtPct(v) : "—";
    document.getElementById("mpoxRingValue").style.color = color(v);
    document.getElementById("mpoxInterpretation").textContent = d ? interp(v) : "Seleccione una región para visualizar indicadores regionales.";
    document.getElementById("mpoxDetailD1").textContent = d ? fmtInt(d.dosis_1) : "—";
    document.getElementById("mpoxDetailD2").textContent = d ? fmtInt(d.dosis_2) : "—";
    document.getElementById("mpoxDetailTotal").textContent = d ? fmtInt(d.total) : "—";
    document.getElementById("mpoxDetailClass").textContent = d ? clasif(v) : "—";
  }

  function makeLegend() {
    const items = [["#139565", "≥90%"], ["#168f73", "80–89%"], ["#e3a400", "70–79%"], ["#cc3b2f", "<70%"]];
    document.getElementById("mpoxLegend").innerHTML = items.map(i => `<span class="item"><i style="background:${i[0]}"></i>${i[1]}</span>`).join("");
  }

  function renderRanking() {
    const rows = DATA.filter(d => normName(d.region) !== "total").sort((a,b)=>b.esquema-a.esquema);
    document.getElementById("mpoxRanking").innerHTML = rows.map((d,i)=>`<div class="mpox-geo-rank-row"><span>${i+1}</span><span>${d.region}</span><strong>${fmtPct(d.esquema)}</strong></div>`).join("");
    document.getElementById("mpoxBars").innerHTML = rows.map(d=>`<div class="mpox-geo-bar-row"><span>${d.region}</span><div class="mpox-geo-bar-track"><div class="mpox-geo-bar-fill" style="width:${Math.min(100,d.esquema)}%;background:${color(d.esquema)}"></div></div><strong>${fmtPct(d.esquema)}</strong></div>`).join("");
  }

  async function fetchFirst(urls) {
    let lastErr;
    for (const url of urls) {
      try {
        const r = await fetch(url, { cache: "no-store" });
        if (!r.ok) throw new Error("HTTP " + r.status);
        return await r.json();
      } catch (e) { lastErr = e; }
    }
    throw lastErr || new Error("No se pudo cargar GeoJSON");
  }

  function initMap(geojson) {
    if (map) map.remove();
    map = L.map("mpoxChileMap", { zoomControl: true, attributionControl: true, scrollWheelZoom: false });
    L.control.attribution({ prefix: false }).addTo(map).addAttribution("GeoJSON público: caracena/chile-geojson");

    geoLayer = L.geoJSON(geojson, {
      style: function(feature) {
        const d = byFeature(feature);
        return { color: "#ffffff", weight: 1.2, opacity: 1, fillColor: d ? color(d.esquema) : "#b8c7d6", fillOpacity: d ? 0.92 : 0.35 };
      },
      onEachFeature: function(feature, layer) {
        const d = byFeature(feature);
        const name = d ? d.region : getFeatureName(feature);
        layer.bindTooltip(`<div class="mpox-geo-tooltip"><strong>${name}</strong>${d ? `<span>Dosis 1: ${fmtInt(d.dosis_1)}</span><span>Dosis 2: ${fmtInt(d.dosis_2)}</span><span>Total: ${fmtInt(d.total)}</span><span>Esquema completo: ${fmtPct(d.esquema)}</span>` : `<span>Sin dato vinculado</span>`}</div>`, { sticky: true, direction: "top", opacity: 1, className: "mpox-geo-tooltip-wrap" });
        layer.on("mouseover", function(){ this.setStyle({ weight: 2.4, fillOpacity: 1 }); });
        layer.on("mouseout", function(){ if (this !== selectedLayer) geoLayer.resetStyle(this); });
        layer.on("click", function(){
          if (selectedLayer) geoLayer.resetStyle(selectedLayer);
          selectedLayer = this;
          this.setStyle({ weight: 3, color: "#003b71", fillOpacity: 1 });
          updateDetail(d);
          try { map.fitBounds(this.getBounds(), { padding: [30,30] }); } catch(e) {}
        });
      }
    }).addTo(map);

    try { map.fitBounds(geoLayer.getBounds(), { padding: [20,20] }); } catch(e) { map.setView([-35.5, -71], 4); }
    setTimeout(() => map.invalidateSize(), 400);
  }

  async function boot() {
    const root = document.getElementById("mpoxGeoPanel");
    if (!root) return;
    try {
      setStatus("Cargando datos regionales…");
      await loadCss("https://unpkg.com/leaflet@1.9.4/dist/leaflet.css");
      await loadScript("https://unpkg.com/leaflet@1.9.4/dist/leaflet.js");
      const csvText = await fetch(CSV_URL, { cache: "no-store" }).then(r => { if(!r.ok) throw new Error("CSV HTTP " + r.status); return r.text(); });
      DATA = parseCSV(csvText);
      setKPIs(); makeLegend(); renderRanking();
      setStatus("Cargando geometría regional de Chile…");
      const geojson = await fetchFirst(GEOJSON_URLS);
      initMap(removeValparaisoRemoteIslands(geojson));
      setStatus("Mapa regional cargado correctamente.", "ok");
      const reset = document.getElementById("mpoxResetMap");
      if (reset) reset.onclick = function(){ if (selectedLayer) geoLayer.resetStyle(selectedLayer); selectedLayer = null; updateDetail(null); map.fitBounds(geoLayer.getBounds(), { padding: [20,20] }); };
    } catch (e) {
      console.error("Mpox mapa:", e);
      setStatus("No se pudo cargar el mapa GeoJSON. Revise bloqueo de recursos externos, CORS o consola del navegador: " + e.message, "error");
    }
  }

  ready(boot);
})();
</script><style class="wpcode-css-snippet">#mpoxGeoPanel, #mpoxGeoPanel * { box-sizing: border-box; }
#mpoxGeoPanel { --azul:#003b71; --azul2:#006fb6; --borde:#d9e7f5; --fondo:#eef6fd; --texto:#0b315d; --muted:#7890aa; --verde:#139565; --amarillo:#e3a400; --rojo:#cc3b2f; max-width: 1400px; margin: 0 auto 48px; font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; color: var(--texto); background: linear-gradient(180deg,#f5fbff 0%,#eef6fd 100%); border-radius: 26px; overflow: hidden; box-shadow: 0 24px 60px rgba(0,59,113,.12); }
.mpox-geo-hero { display:flex; justify-content:space-between; gap:32px; align-items:center; padding:42px 40px; color:#fff; background: radial-gradient(circle at right,#3c84c2 0%,#005c9f 38%,#003b71 100%); }
.mpox-geo-badge { display:inline-flex; border:1px solid rgba(255,255,255,.35); padding:9px 15px; border-radius:999px; text-transform:uppercase; letter-spacing:.08em; font-size:12px; font-weight:800; margin-bottom:16px; }
.mpox-geo-hero h1 { margin:0; color:#fff; font-size: clamp(30px, 4vw, 48px); line-height:1.05; font-weight:850; }
.mpox-geo-hero p { max-width:790px; margin:18px 0 0; color:rgba(255,255,255,.86); font-size:18px; line-height:1.45; }
.mpox-geo-source { min-width:240px; padding:22px; border-radius:20px; background:rgba(255,255,255,.14); border:1px solid rgba(255,255,255,.24); }
.mpox-geo-source span { display:block; font-size:13px; color:rgba(255,255,255,.7); margin-bottom:10px; }
.mpox-geo-source strong { color:#fff; font-size:18px; }
.mpox-geo-kpis { display:grid; grid-template-columns: repeat(4,1fr); gap:18px; padding:24px 30px; }
.mpox-geo-kpis article { background:#fff; border:1px solid var(--borde); border-radius:20px; padding:22px; box-shadow: 0 10px 28px rgba(0,59,113,.06); min-height:110px; }
.mpox-geo-kpis span, .mpox-geo-detail-kpis span { display:block; font-size:13px; font-weight:800; color:#738aa6; margin-bottom:12px; }
.mpox-geo-kpis strong { display:block; font-size: clamp(30px, 3vw, 44px); line-height:1; color:var(--azul); letter-spacing:-.03em; }
.mpox-geo-kpi-main { background: linear-gradient(135deg,#004b8d,#0081c9)!important; border:0!important; }
.mpox-geo-kpi-main span, .mpox-geo-kpi-main strong { color:#fff!important; }
.mpox-geo-grid { display:grid; grid-template-columns: minmax(0, 2fr) minmax(320px,.9fr); gap:24px; padding:0 30px 28px; }
.mpox-geo-bottom { display:grid; grid-template-columns:1fr 1.25fr; gap:24px; padding:0 30px 36px; }
.mpox-geo-card { background:#fff; border:1px solid var(--borde); border-radius:22px; padding:24px; box-shadow: 0 12px 34px rgba(0,59,113,.07); }
.mpox-geo-card h2 { margin:0 0 12px; color:var(--azul); font-size:24px; font-weight:850; }
.mpox-geo-card p { margin:0; color:#738aa6; line-height:1.45; }
.mpox-geo-card-head { display:flex; justify-content:space-between; gap:18px; align-items:flex-start; margin-bottom:18px; }
#mpoxResetMap { border:0; background:#eaf4ff; color:var(--azul); border-radius:999px; padding:11px 16px; font-weight:850; cursor:pointer; }
.mpox-geo-map { width:100%; height:640px; min-height:540px; border-radius:18px; overflow:hidden; background:#e6f2fb; border:1px solid var(--borde); }
.mpox-geo-map .leaflet-container { font-family:inherit; }
.mpox-geo-map .leaflet-control-attribution { font-size:10px; }
.mpox-geo-tooltip { padding:12px 14px; border-radius:14px; color:#0b315d; box-shadow:0 12px 28px rgba(0,0,0,.16); border:1px solid #d8e7f5; }
.mpox-geo-tooltip strong { display:block; margin-bottom:6px; color:#003b71; }
.mpox-geo-tooltip span { display:block; font-size:13px; line-height:1.45; }
.mpox-geo-legend { display:flex; flex-wrap:wrap; gap:12px 18px; margin-top:16px; font-size:13px; font-weight:800; color:#536b87; }
.mpox-geo-legend .item { display:flex; align-items:center; gap:8px; }
.mpox-geo-legend i { width:16px; height:16px; border-radius:5px; display:block; }
.mpox-geo-eyebrow { display:block; color:#7890aa; text-transform:uppercase; letter-spacing:.08em; font-size:12px; font-weight:900; margin-bottom:10px; }
.mpox-geo-detail-card h2 { font-size:24px; margin-bottom:28px; }
.mpox-geo-ring { --pct:0; width:160px; height:160px; margin:0 auto 24px; border-radius:50%; display:grid; place-items:center; background: conic-gradient(var(--verde) calc(var(--pct)*1%), #eaf0f6 0); position:relative; }
.mpox-geo-ring::after { content:""; position:absolute; inset:22px; border-radius:50%; background:#fff; }
.mpox-geo-ring span { position:relative; z-index:1; font-size:32px; font-weight:900; color:var(--verde); }
.mpox-geo-detail-kpis { display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:28px; }
.mpox-geo-detail-kpis div { background:#f6faff; border:1px solid var(--borde); border-radius:16px; padding:16px; min-height:88px; }
.mpox-geo-detail-kpis strong { display:block; color:var(--azul); font-size:22px; }
.mpox-geo-ranking { display:grid; gap:10px; }
.mpox-geo-rank-row { display:grid; grid-template-columns:42px 1fr auto; align-items:center; gap:12px; padding:13px 14px; border:1px solid var(--borde); border-radius:14px; background:#f7fbff; font-weight:800; }
.mpox-geo-rank-row span:first-child { color:#7890aa; }
.mpox-geo-rank-row strong { color:var(--azul); }
.mpox-geo-bars { display:grid; gap:12px; }
.mpox-geo-bar-row { display:grid; grid-template-columns:170px 1fr 64px; gap:12px; align-items:center; font-size:13px; font-weight:800; color:#294c72; }
.mpox-geo-bar-track { height:14px; border-radius:999px; background:#e8f0f8; overflow:hidden; }
.mpox-geo-bar-fill { height:100%; border-radius:999px; width:0%; background:var(--azul2); transition:width .4s ease; }
.mpox-geo-status { margin:0 30px 30px; padding:14px 18px; border-radius:12px; background:#fff8e9; border:1px solid #ffd99a; color:#9b5f16; font-weight:800; }
.mpox-geo-status.ok { background:#eaf8f1; border-color:#bdebd7; color:#08724c; }
.mpox-geo-status.error { background:#fff0f0; border-color:#ffc8c8; color:#a32727; }
@media (max-width: 980px) { .mpox-geo-hero, .mpox-geo-grid, .mpox-geo-bottom { grid-template-columns:1fr; display:grid; } .mpox-geo-hero { display:block; } .mpox-geo-source { margin-top:24px; } .mpox-geo-kpis { grid-template-columns:1fr 1fr; } .mpox-geo-map { height:560px; } }
@media (max-width: 640px) { #mpoxGeoPanel { border-radius:0; } .mpox-geo-hero, .mpox-geo-kpis, .mpox-geo-grid, .mpox-geo-bottom { padding-left:16px; padding-right:16px; } .mpox-geo-kpis { grid-template-columns:1fr; } .mpox-geo-map { height:520px; } .mpox-geo-bar-row { grid-template-columns:1fr; } }
</style><script>/* =========================================================
