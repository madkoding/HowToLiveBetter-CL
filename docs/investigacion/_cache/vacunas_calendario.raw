document.addEventListener("DOMContentLoaded", () => {

const HITOS = [
 {anio:1765,titulo:"Primera variolación",categoria:"historia",periodo:"origenes",descripcion:"Primera variolación o inoculación contra la viruela, antecedente temprano de las acciones de inmunización en el territorio nacional.",keywords:"viruela inoculación variolación historia",imagen:"",imagenTitulo:"Antecedente histórico de la inmunización",imagenTexto:"Representa el inicio de las prácticas preventivas frente a viruela, antes de la consolidación de programas nacionales de vacunación."},
