var I18N={es:{appSub:'Intérprete Internacional de Carnés de Vacunación',login:'Iniciar Sesión',register:'Registrarse',email:'Correo electrónico',password:'Contraseña',name:'Nombre completo',confirmPass:'Confirmar contraseña',noAccount:'¿No tienes cuenta?',hasAccount:'¿Ya tienes cuenta?',registerHere:'Regístrate aquí',loginHere:'Inicia sesión aquí',logout:'Cerrar sesión',dashboard:'Dashboard',uploadTitle:'Subir Carné',history:'Historial',catalog:'Catálogo PNI',settings:'Configuración',totalDocs:'Documentos',vaccinesInterp:'Vacunas Interpretadas',successRate:'Éxito',pniVaccines:'Vacunas PNI',recentDocs:'Recientes',quickActions:'Acciones',uploadCard:'Subir Carné de Vacunación',dragDrop:'Arrastra tu archivo o haz clic aquí',formats:'JPG, PNG, WEBP, PDF (máx. 20MB)',selectCountry:'País de origen',selectLang:'Idioma',startProcessing:'Procesar Carné',uploadFirst:'Sube un documento primero.',ocrResults:'Resultados OCR',ocrText:'Texto Extraído',confidence:'Confianza',interpretation:'Interpretación IA',patientData:'Datos del Paciente',vaccinesFound:'Vacunas Detectadas',sourceVaccine:'Vacuna Original',mappedTo:'Equivalencia PNI',equivalences:'Mapeo PNI',report:'Reporte Final',patientInfo:'Información del Paciente',vaccineList:'Vacunas Identificadas',compliance:'Cumplimiento Calendario PNI 2026',recommendations:'Recomendaciones',back:'Volver',next:'Siguiente',dose:'Dosis',received:'Recibidas',missing:'Faltantes',complete:'Completo',incomplete:'Parcial',pending:'Pendiente',status:'Estado',doseLabel:'Dosis',confidenceLabel:'Confianza',newDocument:'Nuevo Carné',uploadNew:'Subir Carné',noDocuments:'No hay documentos procesados.',countryLabel:'País',languageLabel:'Idioma',processingStage:'Etapa',uploadSuccess:'Subido correctamente',ocrComplete:'OCR completado',interpretComplete:'Interpretación lista',mappingComplete:'Mapeo completado',demoUser:'Usuario Demo',healthPro:'Prof. Salud',settingsTitle:'Configuración',languageSetting:'Idioma',storageInfo:'Almacenamiento',docsStored:'Docume