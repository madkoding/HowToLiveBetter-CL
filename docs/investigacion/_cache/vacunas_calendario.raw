  function pad(n){return n<10 ? "0"+n : ""+n;}
  function hoyISO(){var d=new Date(); return d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate());}
  function fechaLocal(iso){if(!iso) return null; var p=iso.split("-"); return new Date(parseInt(p[0],10),parseInt(p[1],10)-1,parseInt(p[2],10));}
  function fechaCL(d){if(!d) return ""; return pad(d.getDate())+"-"+pad(d.getMonth()+1)+"-"+d.getFullYear();}
  function sumarMeses(fecha, meses){var d=new Date(fecha.getTime()); var dia=d.getDate(); d.setMonth(d.getMonth()+meses); if(d.getDate()<dia){d.setDate(0);} return d;}
  function diffMeses(f1,f2){return (f2.getFullYear()-f1.getFullYear())*12 + (f2.getMonth()-f1.getMonth()) + ((f2.getDate()>=f1.getDate())?0:-1);}
  function val(id){var e=document.getElementById(id); return e ? e.value : "";}
  function textoSeguro(x){return (x && String(x).trim()) ? String(x).trim() : "No registrado";}
  function ordinalDosis(n){return n+"° dosis";}
  function nombreArchivoSeguro(x){return textoSeguro(x).replace(/[^a-zA-Z0-9áéíóúÁÉÍÓÚñÑ_-]+/g,"_").substring(0,60);}

  function mesesEdad(){
    var a=parseInt(val("edadAniosPni")||"0",10);
    var m=parseInt(val("edadMesesPni")||"0",10);
    if(m<0){m=0;} if(m>11){m=11; document.getElementById("edadMesesPni").value=11;}
    return (a*12)+m;
  }
  function grupoPorMeses(m){
    if(m<=6) return "0-6m"; if(m<=11) return "7-11m"; if(m<=23) return "12-23m";
    if(m<=59) return "2-4a"; if(m<=83) return "5-6a"; if(m<=131) return "7-10a";
    if(m<=179) return "11-14a"; if(m<=215) return "15-17a"; return "";
  }
  function etiquetaGrupo(g){
    var mapa={"0-6m":"0 a 6 meses","7-11m":"7 a 11 meses","12-23m":"12 a 23 meses","2-4a":"2 a 4 años","5-6a":"5 a 6 años","7-10a":"7 a 10 años","11-14a":"11 a 14 años","15-17a":"15 a 17 años"};
    return mapa[g]||"fuera del rango de esta calculadora";
  }
  function totalAjustado(v, edadMeses){return (v.totalMenor36 && edadMeses<36) ? v.totalMenor36 : v.total;}
  function mesesTexto(n, fechaBase){var f=sumarMeses(fechaBase,n); if(n===0) return "Hoy ("+fechaCL(f)+")"; if(n===1) return "En 1 mes ("+fechaCL(f)+")"; return "En "+n+" meses ("+fechaCL(f)+")";}
  function fechaConsulta(){return fechaLocal(val("fechaConsultaPni") || hoyISO());}
  function fechaNacimiento(){return val("fechaNacimientoPni") ? fechaLocal(val("fechaNacimientoPni")) : null;}
  function esFechaMayorIgual(fecha, yyyy, mm, dd){
    if(!fecha) return false;
    var corte=new Date(yyyy,mm-1,dd);
    return fecha>=corte;
  }
  function calcularEdadExacta(){
    var fn=fechaNacimiento(), fc=fechaConsulta();
    if(!fn || !fc || fn>fc){return;}
    var y=fc.getFullYear()-fn.getFullYear();
    var m=fc.getMonth()-fn.getMonth();
    var d=fc.getDate()-fn.getDate();
    if(d<0){m--;}
    if(m<0){y--;m+=12;}
    if(y<0){y=0;m=0;}
    var anios=document.getElementById("edadAniosPni"), meses=document.getElementById("edadMesesPni");
    if(anios){anios.value=y;}
    if(meses){meses.value=m;}
  }
  function clonarVacuna(v){
    var o={};
    for(var k in v){
      if(Array.isArray(v[k])){o[k]=v[k].slice();} else {o[k]=v[k];}
    }
    return o;
  }
  function existeVacuna(lista,nombre){
    for(var i=0;i<lista.length;i++){if(lista[i].nombre===nombre){return true;}}
    return false;
  }
  function vacunasAplicables(grupo, edadMeses, fn){
    var base=datosBase[grupo] || [];
    var lista=[];
    for(var i=0;i<base.length;i++){lista.push(clonarVacuna(base[i]));}

    /* Tabla N°1: considerar año/cohorte de incorporación al calendario PNI, además de la edad al momento de la evaluación. */
    if(fn && esFechaMayorIgual(fn,2019,1,1) && edadMeses>=36 && !existeVacuna(lista,"Varicela")){
      lista.push({nombre:"Varicela",total:2,antecedenteMax:2,viva:true,esquema:"2 dosis: 0 y 3 meses",nota:"Incorporación según Tabla N°1: 1ª dosis desde 2020 para nacidos/as desde el 01-01-2019 y 2ª dosis a los 36 meses desde 2022. Evaluar puesta al día si corresponde a cohorte beneficiaria.",offsets:[0,3],intervalos:[3],cohorte:true});
    }

    if(fn && esFechaMayorIgual(fn,2023,5,1) && edadMeses>=18){
      for(var j=0;j<lista.length;j++){
        if(lista[j].nombre==="Meningocócica serogrupo B" && lista[j].total<3){
          lista[j].total=3;
          lista[j].antecedenteMax=3;
          lista[j].esquema="2 dosis + 1 refuerzo según cohorte";
          lista[j].nota += " Refuerzo incorporado desde el 01-11-2024 para lactantes nacidos/as desde el 01-05-2023.";
          lista[j].offsets=[0,2,14];
          lista[j].intervalos=[2,12];
        }
      }
    }
    return lista;
  }


  function actualizarCamposFechaPorTarjeta(card){
    if(!card){return;}
    var estado = card.querySelector(".estado-vacuna-pni");
    var dosisBox = card.querySelector(".dosis-select");
    var fechasBox = card.querySelector(".fechas-dosis");
    var recibidasSelect = card.querySelector(".recibidas-pni");

    if(estado && estado.value === "aldia"){
      if(dosisBox){dosisBox.style.display = "none";}
      if(fechasBox){fechasBox.style.display = "none";}
      return;
    }

    if(dosisBox){dosisBox.style.display = "flex";}
    if(fechasBox){fechasBox.style.display = "grid";}

    var recibidas = recibidasSelect ? parseInt(recibidasSelect.value || "0", 10) : 0;
    var campos = card.querySelectorAll(".fecha-dosis-box");

    for(var i = 0; i < campos.length; i++){
      var input = campos[i].querySelector(".fecha-dosis-pni");
      var dosis = input ? parseInt(input.getAttribute("data-dosis") || "0", 10) : 0;

      if(dosis <= recibidas){
        campos[i].style.display = "block";
      } else {
        campos[i].style.display = "none";
        if(input){ input.value = ""; }
      }
    }
  }

  function actualizarTodosLosCamposFecha(){
    var cards = document.querySelectorAll(".vacuna-card");
    for(var i = 0; i < cards.length; i++){
      actualizarCamposFechaPorTarjeta(cards[i]);
    }
  }

  function renderizar(){
    calcularEdadExacta();
    var edadMeses=mesesEdad(), grupo=grupoPorMeses(edadMeses);
    var contenedor=document.getElementById("vacunasContainer"), estado=document.getElementById("grupoEdadDetectadoPni"), resultado=document.getElementById("resultadoPuestaDia");
    var sinDoc=document.getElementById("sinDocumentoPni").checked, rapa=document.getElementById("rapaNuiPni").checked;
    contenedor.innerHTML=""; resultado.innerHTML="";
    if(!grupo){estado.innerHTML="<strong>Edad fuera de rango:</strong> esta versión está configurada para usuarios/as de 0 a 17 años."; return;}
    if(!fechaNacimiento()){estado.innerHTML="<strong>Ingrese fecha de nacimiento:</strong> el aplicativo calculará automáticamente la edad y mostrará las vacunas aplicables."; return;}
    estado.innerHTML="<strong>Grupo detectado:</strong> "+etiquetaGrupo(grupo)+". Fecha de evaluación: "+fechaCL(fechaConsulta())+". Edad calculada automáticamente desde la fecha de nacimiento.";
    if(sinDoc){estado.innerHTML += "<br><strong>Modo sin respaldo:</strong> el aplicativo considerará 0 dosis recibidas en todos los esquemas.";}

    var vacunas=vacunasAplicables(grupo, edadMeses, fechaNacimiento());
    var htmlGrid='<div class="pni-vacunas-grid">';
    for(var i=0;i<vacunas.length;i++){
      var v=vacunas[i], total=totalAjustado(v,edadMeses), maxAntecedente=(v.antecedenteMax && v.antecedenteMax>total ? v.antecedenteMax : total), clase=v.viva?"vacuna-card viva":"vacuna-card", extra="";
      if(v.soloRapa && !rapa){continue;}
      if(v.maxMeses!==undefined && edadMeses>v.maxMeses){clase+=" alerta"; extra+='<div class="alerta-amarilla"><strong>Alerta:</strong> por edad exacta, esta vacuna no corresponde administrar.</div>';}
      if(v.minMeses!==undefined && edadMeses<v.minMeses){clase+=" alerta"; extra+='<div class="alerta-amarilla"><strong>Alerta:</strong> aún no cumple la edad de administración indicada; programar cuando corresponda.</div>';}

      var opts="";
      for(var d=0;d<=maxAntecedente;d++){opts+='<option value="'+d+'">'+d+' dosis recibida(s)</option>';}

      var fechas="";
      for(var fd=1;fd<=maxAntecedente;fd++){
        fechas+='<div class="fecha-dosis-box"><label>Fecha dosis '+fd+' recibida</label><input type="date" class="fecha-dosis-pni" data-vacuna="'+i+'" data-dosis="'+fd+'"></div>';
      }

      htmlGrid+='<div class="'+clase+'">'+
        '<h3>'+v.nombre+' <span class="badge '+(v.viva?'badge-viva':'badge-inactiva')+'">'+(v.viva?'Viva atenuada':'Inactivada / recombinante')+'</span></h3>'+
        '<div class="vacuna-meta"><strong>Esquema:</strong> '+v.esquema+'</div>'+
        '<div class="estado-esquema"><label>Estado del esquema según antecedente disponible</label><select class="estado-vacuna-pni" data-vacuna="'+i+'" '+(sinDoc?'disabled':'')+'><option value="pendiente">No está al día / requiere vacunación</option><option value="aldia">Está al día según calendario vigente</option></select></div>'+
        '<div class="dosis-select"><label><strong>Dosis con registro válido:</strong></label><select class="recibidas-pni" data-vacuna="'+i+'" '+(sinDoc?'disabled':'')+'>'+opts+'</select></div>'+
        '<div class="fechas-dosis">'+fechas+'</div>'+
        '<p class="nota"><strong>Nota técnica:</strong> '+v.nota+'</p>'+(v.antecedenteMax && v.antecedenteMax>total ? '<p class="nota"><strong>Antecedentes:</strong> puede registrar dosis previas del calendario infantil, aunque la puesta al día por edad indique una dosis de rescate.</p>' : '')+extra+
      '</div>';
    }
    htmlGrid+='</div>';
    contenedor.innerHTML=htmlGrid;

    if(sinDoc){
      var selects=document.querySelectorAll(".recibidas-pni");
      for(var s=0;s<selects.length;s++){selects[s].value="0";}
      var estados=document.querySelectorAll(".estado-vacuna-pni");
      for(var e=0;e<estados.length;e++){estados[e].value="pendiente";}
    }

    actualizarTodosLosCamposFecha();
  }

  function validarIntervalos(v,i,recibidas,alertasIntervalo){
    if(recibidas<2) return;
    for(var d=1; d<recibidas; d++){
      var fAntEl=document.querySelector('input[data-vacuna="'+i+'"][data-dosis="'+d+'"]');
      var fActEl=document.querySelector('input[data-vacuna="'+i+'"][data-dosis="'+(d+1)+'"]');
      if(!fAntEl || !fActEl || !fAntEl.value || !fActEl.value) continue;
      var f1=fechaLocal(fAntEl.value), f2=fechaLocal(fActEl.value);
      if(f2<f1){alertasIntervalo.push(v.nombre+": la fecha de dosis "+(d+1)+" es anterior a la dosis "+d+"."); continue;}
      var min=v.intervalos[d-1]!==undefined ? v.intervalos[d-1] : 0;
      if(diffMeses(f1,f2)<min){
        alertasIntervalo.push(v.nombre+": intervalo menor al mínimo entre dosis "+d+" y "+(d+1)+" ("+min+" mes(es)).");
      }
    }
  }

  function fechaISODesdeDate(d){return d.getFullYear()+"-"+pad(d.getMonth()+1)+"-"+pad(d.getDate());}
  function agregarCita(citas, fecha, texto){
    var key=fechaISODesdeDate(fecha);
    if(!citas[key]){citas[key]={fecha:fecha, items:[]};}
    citas[key].items.push(texto);
  }
  function fechaUltimaDosis(i, recibidas){
    if(recibidas<1) return null;
    var el=document.querySelector('input[data-vacuna="'+i+'"][data-dosis="'+recibidas+'"]');
    return (el && el.value) ? fechaLocal(el.value) : null;
  }

  function calcular(){
    calcularEdadExacta();
    var edadMeses=mesesEdad(), grupo=grupoPorMeses(edadMeses), resultado=document.getElementById("resultadoPuestaDia");
    if(!fechaNacimiento()){resultado.innerHTML='<div class="resultado-box">Debe ingresar la fecha de nacimiento para calcular la edad y determinar la puesta al día.</div>'; return;}
    if(!grupo){resultado.innerHTML='<div class="resultado-box">Debe ingresar una edad entre 0 y 17 años.</div>'; return;}
    var fechaBase=fechaConsulta(), vacunas=datosBase[grupo], rapa=document.getElementById("rapaNuiPni").checked, sinDoc=document.getElementById("sinDocumentoPni").checked, migrante=document.getElementById("registroMigrantePni").checked;
    var administrarHoy=[], completas=[], citas={}, alertas=[], vivasHoy=[], alertasIntervalo=[];

    for(var i=0;i<vacunas.length;i++){
      var v=vacunas[i], total=totalAjustado(v,edadMeses);
      var sel=document.querySelector('select.recibidas-pni[data-vacuna="'+i+'"]');
      var estadoEl=document.querySelector('select.estado-vacuna-pni[data-vacuna="'+i+'"]');
      var estadoVacuna=estadoEl ? estadoEl.value : "pendiente";
      if(!sinDoc && estadoVacuna==="aldia"){
        completas.push(v.nombre+": no requiere puesta al día; esquema declarado al día según antecedente ingresado.");
        continue;
      }
      var recibidas=sinDoc ? 0 : (sel ? parseInt(sel.value||"0",10) : 0);

      validarIntervalos(v,i,recibidas,alertasIntervalo);

      if(v.soloRapa && !rapa){alertas.push(v.nombre+": no se incluye en administración porque no se marcó Rapa Nui."); continue;}
      if(v.maxMeses!==undefined && edadMeses>v.maxMeses){alertas.push(v.nombre+": no corresponde por edad exacta."); continue;}
      if(v.minMeses!==undefined && edadMeses<v.minMeses){
        var faltanParaEdad=v.minMeses-edadMeses;
        agregarCita(citas, sumarMeses(fechaBase, faltanParaEdad), v.nombre+" "+ordinalDosis(1)+", al cumplir edad mínima.");
        continue;
      }

      if(recibidas>=total){completas.push(v.nombre+": esquema completo según antecedente ingresado."); continue;}

      var proxima=recibidas+1;
      var fechaProxima=null;

      if(recibidas===0){
        fechaProxima=fechaBase;
      } else {
        var ultima=fechaUltimaDosis(i,recibidas);
        var intervaloMin=v.intervalos[recibidas-1]!==undefined ? v.intervalos[recibidas-1] : (v.offsets[recibidas]!==undefined ? v.offsets[recibidas] : 0);
        if(ultima){
          fechaProxima=sumarMeses(ultima,intervaloMin);
        } else {
          var baseOffset=v.offsets[recibidas]!==undefined ? v.offsets[recibidas] : 0;
          fechaProxima=sumarMeses(fechaBase,baseOffset);
        }
      }

      if(fechaProxima<=fechaBase){
        administrarHoy.push(v.nombre+" "+ordinalDosis(proxima));
        if(v.viva) vivasHoy.push(v.nombre);

        var fechaReferencia=fechaBase;
        for(var d=proxima; d<total; d++){
          var intervaloPosterior=v.intervalos[d-1]!==undefined ? v.intervalos[d-1] : 0;
          fechaReferencia=sumarMeses(fechaReferencia,intervaloPosterior);
          agregarCita(citas,fechaReferencia,v.nombre+" "+ordinalDosis(d+1));
        }
      } else {
        agregarCita(citas,fechaProxima,v.nombre+" "+ordinalDosis(proxima));
        var fechaReferenciaFutura=fechaProxima;
        for(var df=proxima; df<total; df++){
          var intervaloPosteriorF=v.intervalos[df-1]!==undefined ? v.intervalos[df-1] : 0;
          fechaReferenciaFutura=sumarMeses(fechaReferenciaFutura,intervaloPosteriorF);
          agregarCita(citas,fechaReferenciaFutura,v.nombre+" "+ordinalDosis(df+1));
        }
      }
    }

    var nombre=textoSeguro(val("nombrePersonaPni"));
    var tipoDocumento=textoSeguro(val("tipoDocumentoPni"));
    var numeroDocumento=textoSeguro(val("numeroDocumentoPni"));
    var sexo=textoSeguro(val("sexoPersonaPni"));
    var vacunatorio=textoSeguro(val("vacunatorioPni"));
    var funcionario=textoSeguro(val("funcionarioPni"));
    var nacimiento=val("fechaNacimientoPni") ? fechaCL(fechaNacimiento()) : "No registrada";
    var observaciones=textoSeguro(val("observacionesPni"));

    var html='<div class="resultado-box" id="planImpresionPni">';
    html+='<div class="print-title"><h2>Plan de Puesta al Día de Vacunas PNI</h2><p>Fecha de evaluación: '+fechaCL(fechaBase)+'</p></div>';
    html+='<h3>Resultado de puesta al día</h3>';
    html+='<div class="pni-identificacion">'+
      '<div><strong>Nombre:</strong><br>'+nombre+'</div>'+
      '<div><strong>Documento:</strong><br>'+tipoDocumento+' '+numeroDocumento+'</div>'+      '<div><strong>Fecha nacimiento:</strong><br>'+nacimiento+'</div>'+
      '<div><strong>Sexo:</strong><br>'+sexo+'</div>'+
      '<div><strong>Vacunatorio:</strong><br>'+vacunatorio+'</div>'+
      '<div><strong>Funcionario/a:</strong><br>'+funcionario+'</div>'+
      '<div><strong>Edad:</strong><br>'+val("edadAniosPni")+' años y '+val("edadMesesPni")+' meses</div>'+
      '<div><strong>Grupo:</strong><br>'+etiquetaGrupo(grupo)+'</div>'+
      '<div><strong>Fecha evaluación:</strong><br>'+fechaCL(fechaBase)+'</div>'+
    '</div>';

    html+='<h4>Vacunas a administrar hoy</h4>';
    html+=administrarHoy.length ? '<ul><li>'+administrarHoy.join('</li><li>')+'</li></ul>' : '<p>No se identifican dosis para administrar hoy según lo informado.</p>';

    html+='<h4>Calendario de próximas citaciones</h4><div class="pni-citas">';
    var keys=Object.keys(citas).sort();
    if(keys.length){
      for(var k=0;k<keys.length;k++){
        var c=citas[keys[k]];
        var titulo=(fechaISODesdeDate(c.fecha)===fechaISODesdeDate(fechaBase)) ? "Hoy ("+fechaCL(c.fecha)+")" : fechaCL(c.fecha);
        html+='<div class="cita-card"><h4>'+titulo+'</h4><ul><li>'+c.items.join('</li><li>')+'</li></ul></div>';
      }
    } else {
      html+='<p>No quedan próximas citaciones pendientes.</p>';
    }
    html+='</div>';

    if(completas.length){html+='<h4>Esquemas completos</h4><ul><li>'+completas.join('</li><li>')+'</li></ul>';}
    if(alertas.length){html+='<div class="alerta-amarilla"><strong>Alertas inteligentes:</strong><br><ul><li>'+alertas.join('</li><li>')+'</li></ul></div>';}
    if(alertasIntervalo.length){html+='<div class="alerta-roja"><strong>Validación de intervalos mínimos:</strong><br><ul><li>'+alertasIntervalo.join('</li><li>')+'</li></ul></div>';}

    var modo=[];
    if(sinDoc){modo.push("Sin respaldo documental: considerar no vacunado/a");}
    if(migrante){modo.push("Migrante con registro válido: homologar antecedente según calendario vigente en Chile");}
    if(rapa){modo.push("Rapa Nui: considerar indicación territorial de Fiebre Amarilla cuando corresponda");}
    if(modo.length){html+='<div class="alerta-amarilla"><strong>Condiciones seleccionadas:</strong><br><ul><li>'+modo.join('</li><li>')+'</li></ul></div>';}
    if(observaciones!=="No registrado"){html+='<div class="alerta-tecnica"><strong>Observaciones del equipo vacunador:</strong><br>'+observaciones+'</div>';}

    html+='<div class="alerta-tecnica"><strong>Consideraciones generales:</strong><br>Si existe registro válido, las dosis previas se consideran válidas. Si no existe respaldo documental, la persona debe considerarse no vacunada. En esquemas atrasados, se completan las dosis pendientes y no se reinicia esquema.</div>';
    html+='<div class="alerta-vivas"><strong>Vacunas vivas atenuadas:</strong><br>SRP, Varicela, BCG y Fiebre Amarilla deben administrarse simultáneamente o separadas por un intervalo mínimo de 4 semanas cuando corresponda.';
    if(vivasHoy.length){html+='<br><br><strong>Vivas identificadas para hoy:</strong> '+vivasHoy.join(", ")+'.';}
    html+='</div>';
    html+='</div>';
    resultado.innerHTML=html;
  }

  function cargarScript(src, testGlobal, cb){
    if(testGlobal()){cb();return;}
    var s=document.createElement("script");
    s.src=src; s.onload=cb; s.onerror=function(){alert("No se pudo cargar la librería necesaria para generar el PDF.");};
    document.head.appendChild(s);
  }

  function descargarPDF(){
    var plan=document.getElementById("planImpresionPni");
    if(!plan){alert("Primero debe calcular la puesta al día.");return;}

    cargarScript("https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js",function(){return !!(window.jspdf && window.jspdf.jsPDF);},function(){
      var jsPDF=window.jspdf.jsPDF;
      var pdf=new jsPDF("p","mm","a4");

      var nombre=textoSeguro(val("nombrePersonaPni"));
      var tipoDocumento=textoSeguro(val("tipoDocumentoPni"));
      var numeroDocumento=textoSeguro(val("numeroDocumentoPni"));
      var sexo=textoSeguro(val("sexoPersonaPni"));
      var vacunatorio=textoSeguro(val("vacunatorioPni"));
      var funcionario=textoSeguro(val("funcionarioPni"));
    var nacimiento=val("fechaNacimientoPni") ? fechaCL(fechaNacimiento()) : "No registrada";
    var observaciones=textoSeguro(val("observacionesPni"));
      var fechaBase=fechaConsulta();
      var edadTexto=textoSeguro(val("edadAniosPni"))+" años y "+textoSeguro(val("edadMesesPni"))+" meses";
      var grupo=grupoPorMeses(mesesEdad());

      var margin=14, y=18, pageW=210, pageH=297, maxW=pageW-(margin*2);
      var azul=[0,105,170], celeste=[235,247,255], borde=[198,228,247], rojo=[185,35,35], rojoFondo=[255,241,241], amarillo=[255,248,229], verde=[29,127,95];

      function addPageIfNeeded(extra){
        if(y+extra>282){
          footer();
          pdf.addPage();
          y=18;
        }
      }
      function footer(){
        pdf.setDrawColor(210,225,235);
        pdf.line(margin,287,pageW-margin,287);
        pdf.setFont("helvetica","italic");
        pdf.setFontSize(8);
        pdf.setTextColor(90,100,110);
        pdf.text("Documento generado como apoyo técnico. Validar siempre con registro vigente, normativa PNI y evaluación del equipo vacunador.", margin, 292);
      }
      function header(){
        pdf.setFillColor(azul[0],azul[1],azul[2]);
        pdf.roundedRect(margin,12,pageW-(margin*2),24,4,4,"F");
        pdf.setTextColor(255,255,255);
        pdf.setFont("helvetica","bold");
        pdf.setFontSize(15);
        pdf.text("Plan de Puesta al Día de Vacunas PNI",margin+6,22);
        pdf.setFont("helvetica","normal");
        pdf.setFontSize(9);
        pdf.text("Fecha de generación: "+fechaCL(new Date()),margin+6,29);
        pdf.setTextColor(20,35,45);
        y=44;
      }
      function sectionTitle(txt,colorArr){
        addPageIfNeeded(12);
        colorArr=colorArr||azul;
        pdf.setFillColor(colorArr[0],colorArr[1],colorArr[2]);
        pdf.roundedRect(margin,y,maxW,8,2,2,"F");
        pdf.setTextColor(255,255,255);
        pdf.setFont("helvetica","bold");
        pdf.setFontSize(11);
        pdf.text(txt,margin+4,y+5.5);
        pdf.setTextColor(20,35,45);
        y+=12;
      }
      function infoGrid(items){
        var colW=(maxW-6)/3, rowH=17;
        for(var i=0;i<items.length;i++){
          var col=i%3, row=Math.floor(i/3);
          if(col===0){addPageIfNeeded(rowH+2);}
          var x=margin+col*(colW+3);
          var yy=y+row*(rowH+3);
          pdf.setFillColor(celeste[0],celeste[1],celeste[2]);
          pdf.setDrawColor(borde[0],borde[1],borde[2]);
          pdf.roundedRect(x,yy,colW,rowH,2,2,"FD");
          pdf.setFont("helvetica","bold");
          pdf.setFontSize(8);
          pdf.setTextColor(0,92,153);
          pdf.text(items[i].label,x+3,yy+5);
          pdf.setFont("helvetica","normal");
          pdf.setFontSize(9);
          pdf.setTextColor(25,35,45);
          var lines=pdf.splitTextToSize(items[i].value,colW-6);
          pdf.text(lines.slice(0,2),x+3,yy+10);
        }
        y += Math.ceil(items.length/3)*(rowH+3)+2;
      }
      function bulletList(items, emptyText, style){
        if(!items || !items.length){
          paragraph(emptyText || "Sin registros.");
          return;
        }
        for(var i=0;i<items.length;i++){card(items[i],style);}
      }
      function paragraph(txt){
        pdf.setFont("helvetica","normal");
        pdf.setFontSize(9.5);
        pdf.setTextColor(25,35,45);
        var lines=pdf.splitTextToSize(String(txt||""),maxW);
        addPageIfNeeded(lines.length*5+2);
        pdf.text(lines,margin,y);
        y+=lines.length*5+3;
      }
      function card(txt,style){
        style=style||"blue";
        var fill=celeste, stroke=borde, bar=azul;
        if(style==="red"){fill=rojoFondo;stroke=[242,184,184];bar=rojo;}
        if(style==="yellow"){fill=amarillo;stroke=[240,207,115];bar=[224,168,0];}
        if(style==="green"){fill=[239,250,246];stroke=[187,225,210];bar=verde;}
        pdf.setFont("helvetica","normal");
        pdf.setFontSize(9.5);
        var lines=pdf.splitTextToSize(String(txt||""),maxW-16);
        var h=Math.max(12,lines.length*5+7);
        addPageIfNeeded(h+3);
        pdf.setFillColor(fill[0],fill[1],fill[2]);
        pdf.setDrawColor(stroke[0],stroke[1],stroke[2]);
        pdf.roundedRect(margin,y,maxW,h,3,3,"FD");
        pdf.setFillColor(bar[0],bar[1],bar[2]);
        pdf.roundedRect(margin,y,3,h,2,2,"F");
        pdf.setTextColor(25,35,45);
        pdf.text(lines,margin+8,y+7);
        y+=h+3;
      }
      function getListAfterHeading(title){
        var h4s=plan.querySelectorAll("h4");
        for(var h=0;h<h4s.length;h++){
          if(h4s[h].innerText.indexOf(title)>-1){
            var next=h4s[h].nextElementSibling;
            if(next && next.tagName==="UL"){
              var lis=next.querySelectorAll("li"), arr=[];
              for(var i=0;i<lis.length;i++){arr.push(lis[i].innerText);}
              return arr;
            }
          }
        }
        return [];
      }
      function nombreMes(m){
        var meses=["Enero","Febrero","Marzo","Abril","Mayo","Junio","Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre"];
        return meses[m] || "";
      }
      function claveMes(fecha){
        return fecha.getFullYear()+"-"+pad(fecha.getMonth()+1);
      }
      function parseFechaCLDesdeTitulo(txt){
        var m=String(txt||"").match(/(\d{2})-(\d{2})-(\d{4})/);
        if(!m){return null;}
        return new Date(parseInt(m[3],10),parseInt(m[2],10)-1,parseInt(m[1],10));
      }
      function extraerCitacionesCalendario(){
        var citas=plan.querySelectorAll(".cita-card");
        var eventos=[];
        for(var c=0;c<citas.length;c++){
          var titulo=citas[c].querySelector("h4") ? citas[c].querySelector("h4").innerText : "";
          var fecha=parseFechaCLDesdeTitulo(titulo);
          if(!fecha){continue;}
          var items=citas[c].querySelectorAll("li");
          for(var i=0;i<items.length;i++){
            eventos.push({fecha:fecha, texto:items[i].innerText});
          }
        }
        return eventos;
      }
      function dibujarCalendarioMensual(fechaMes,eventosMes){
        var year=fechaMes.getFullYear();
        var month=fechaMes.getMonth();
        var titulo=nombreMes(month)+" "+year;
        var colW=maxW/7;
        var headerH=7;
        var cellH=17;
        var titleH=8;
        var first=new Date(year,month,1);
        var lastDay=new Date(year,month+1,0).getDate();
        var start=((first.getDay()+6)%7);
        var rows=Math.ceil((start+lastDay)/7);
        var totalH=titleH+headerH+(rows*cellH)+8;
        addPageIfNeeded(totalH);

        pdf.setFont("helvetica","bold");
        pdf.setFontSize(11);
        pdf.setTextColor(20,35,45);
        pdf.text(titulo,margin,y);
        y+=titleH;

        var dias=["Lun","Mar","Mié","Jue","Vie","Sáb","Dom"];
        pdf.setDrawColor(30,80,110);
        pdf.setFillColor(0,105,170);
        pdf.setTextColor(255,255,255);
        pdf.setFont("helvetica","bold");
        pdf.setFontSize(8.5);

        for(var d=0;d<7;d++){
          pdf.rect(margin+(d*colW),y,colW,headerH,"FD");
          pdf.text(dias[d],margin+(d*colW)+(colW/2),y+4.8,{align:"center"});
        }
        y+=headerH;

        var eventosPorDia={};
        for(var e=0;e<eventosMes.length;e++){
          var dia=eventosMes[e].fecha.getDate();
          if(!eventosPorDia[dia]){eventosPorDia[dia]=[];}
          eventosPorDia[dia].push(eventosMes[e].texto);
        }

        var day=1;
        for(var r=0;r<rows;r++){
          for(var c=0;c<7;c++){
            var x=margin+(c*colW);
            var isCurrent=(r>0 || c>=start) && day<=lastDay;
            var hasEvent=isCurrent && eventosPorDia[day];

            if(hasEvent){ pdf.setFillColor(180,255,70); }
            else { pdf.setFillColor(255,255,255); }

            pdf.setDrawColor(120,120,120);
            pdf.rect(x,y,colW,cellH,"FD");

            if(isCurrent){
              pdf.setFont("helvetica","bold");
              pdf.setFontSize(7.3);
              pdf.setTextColor(20,35,45);
              pdf.text(String(day),x+1.5,y+4.3);

              if(hasEvent){
                pdf.setFont("helvetica","bold");
                pdf.setFontSize(6.5);
                var lineY=y+8;
                for(var ev=0;ev<eventosPorDia[day].length;ev++){
                  var clean=eventosPorDia[day][ev].replace(/\s+/g," ");
                  var lines=pdf.splitTextToSize(clean,colW-3);
                  for(var li=0;li<Math.min(lines.length,2);li++){
                    if(lineY<y+cellH-1){
                      pdf.text(lines[li],x+1.5,lineY);
                      lineY+=3.2;
                    }
                  }
                }
              }
              day++;
            }
          }
          y+=cellH;
        }
        y+=8;
      }

      header();

      sectionTitle("Identificación del usuario/a");
      infoGrid([
        {label:"Nombre",value:nombre},
        {label:"Documento",value:tipoDocumento+" "+numeroDocumento},
        {label:"Fecha nacimiento",value:nacimiento},
        {label:"Sexo",value:sexo},
        {label:"Vacunatorio",value:vacunatorio},
        {label:"Funcionario/a",value:funcionario},
        {label:"Fecha evaluación",value:fechaCL(fechaBase)},
        {label:"Edad",value:edadTexto},
        {label:"Grupo de edad",value:etiquetaGrupo(grupo)},
        {label:"Tipo de documento",value:tipoDocumento}
      ]);

      sectionTitle("Vacunas a administrar hoy", verde);
      bulletList(getListAfterHeading("Vacunas a administrar hoy"), "No se identifican dosis para administrar hoy según lo informado.", "green");

      sectionTitle("Calendario de próximas citaciones");
      var eventosCalendario=extraerCitacionesCalendario();
      if(eventosCalendario.length){
        var mesesMap={};
        for(var ec=0;ec<eventosCalendario.length;ec++){
          var key=claveMes(eventosCalendario[ec].fecha);
          if(!mesesMap[key]){mesesMap[key]=[];}
          mesesMap[key].push(eventosCalendario[ec]);
        }
        var mesesKeys=Object.keys(mesesMap).sort();
        for(var mk=0;mk<mesesKeys.length;mk++){
          var partes=mesesKeys[mk].split("-");
          var fechaMes=new Date(parseInt(partes[0],10),parseInt(partes[1],10)-1,1);
          dibujarCalendarioMensual(fechaMes,mesesMap[mesesKeys[mk]]);
        }
        card("Las fechas corresponden a intervalos mínimos calculados desde la fecha de evaluación o desde la última dosis registrada. Validar según calendario vigente y criterio del equipo vacunador.","yellow");
      } else {
        paragraph("No quedan próximas citaciones pendientes.");
      }

      var completas=getListAfterHeading("Esquemas completos");
      if(completas.length){
        sectionTitle("Esquemas completos", verde);
        bulletList(completas,"","green");
      }

      if(observaciones!=="No registrado"){
        sectionTitle("Observaciones del equipo vacunador", [90,100,110]);
        card(observaciones,"blue");
      }

      var alertas=plan.querySelectorAll(".alerta-amarilla,.alerta-roja,.alerta-tecnica,.alerta-vivas");
      if(alertas.length){
        sectionTitle("Observaciones y alertas técnicas", [90,100,110]);
        for(var a=0;a<alertas.length;a++){
          var clase=alertas[a].className || "";
          var style=clase.indexOf("roja")>-1 || clase.indexOf("vivas")>-1 ? "red" : (clase.indexOf("amarilla")>-1 ? "yellow" : "blue");
          card(alertas[a].innerText.replace("Descargar plan de vacunación","").trim(),style);
        }
      }

      sectionTitle("Nota de uso", [90,100,110]);
      paragraph("Documento generado como apoyo técnico. La indicación final debe ser validada por el equipo vacunador según registro válido, calendario vigente, normativa del Programa Nacional de Inmunizaciones y situación clínica del usuario/a.");

      footer();

      var archivo="plan_puesta_dia_"+nombreArchivoSeguro(val("nombrePersonaPni"))+"_"+hoyISO()+".pdf";
      pdf.save(archivo);
    });
  }

  function iniciar(){
    var fecha=document.getElementById("fechaConsultaPni");
    if(fecha && !fecha.value){fecha.value=hoyISO();}
    calcularEdadExacta();
    var btnEdad=document.getElementById("determinarEdadPni"), btnCalc=document.getElementById("calcularPuestaDia");
    var controles=["fechaNacimientoPni","fechaConsultaPni","sinDocumentoPni","registroMigrantePni","rapaNuiPni"];
    if(!btnEdad || !btnCalc){return;}
    btnEdad.addEventListener("click",renderizar);
    btnCalc.addEventListener("click",calcular);
    document.addEventListener("change",function(ev){
      if(ev.target && ev.target.classList && (ev.target.classList.contains("estado-vacuna-pni") || ev.target.classList.contains("recibidas-pni"))){
        var card=ev.target.closest(".vacuna-card");
        actualizarCamposFechaPorTarjeta(card);
      }
    });
    for(var i=0;i<controles.length;i++){
      var el=document.getElementById(controles[i]);
      if(el){el.addEventListener("change",renderizar);}
    }
    renderizar();
  }

  if(document.readyState==="loading"){document.addEventListener("DOMContentLoaded",iniciar);} else {iniciar();}
})();</script><style class="wpcode-css-snippet">@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

/* =========================================================
   VISOR VACUNACIÓN ESPECIAL - CSS PARA WPCode
   Usar como snippet tipo CSS. No incluir etiquetas <style>.
   ========================================================= */

#vac-chile-2025-app{
  --blue-900:#0c2d48;
  --blue-800:#154360;
  --blue-700:#1a5276;
  --blue-600:#1f6d9a;
  --blue-500:#2980b9;
  --blue-100:#d4e6f1;
  --blue-50:#eaf2f8;
  --gray-50:#f8f9fa;
  --gray-100:#f0f2f4;
  --gray-200:#e2e5e9;
  --gray-300:#ccd0d5;
  --gray-500:#6c757d;
  --gray-600:#4a5568;
  --gray-700:#374151;
  --gray-800:#1f2937;
  --amber-100:#fef3c7;
  --amber-700:#92400e;
  --white:#ffffff;
  --radius:8px;
  --shadow-sm:0 1px 2px rgba(0,0,0,.06);
  --shadow-md:0 4px 6px -1px rgba(0,0,0,.1),0 2px 4px -2px rgba(0,0,0,.1);

  display:block !important;
  width:100% !important;
  max-width:1180px !important;
  margin:0 auto !important;
  box-sizing:border-box !important;
  font-family:'Inter',system-ui,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif !important;
  background:var(--gray-50) !important;
  color:var(--gray-800) !important;
  line-height:1.5 !important;
  font-size:16px !important;
  clear:both !important;
  isolation:isolate !important;
}

#vac-chile-2025-app,
#vac-chile-2025-app *,
#vac-chile-2025-app *::before,
#vac-chile-2025-app *::after{
  box-sizing:border-box !important;
}

#vac-chile-2025-app *{
  font-family:inherit !important;
}

#vac-chile-2025-app .app-shell{
  display:block !important;
  width:100% !important;
  margin:0 auto !important;
  background:var(--gray-50) !important;
  overflow:visible !important;
}

#vac-chile-2025-app .header{
  display:block !important;
  width:100% !important;
  background:linear-gradient(135deg,var(--blue-900),var(--blue-700)) !important;
  color:var(--white) !important;
  padding:1.125rem 1.35rem !important;
}

#vac-chile-2025-app .header-inner{
  width:100% !important;
  max-width:1060px !important;
  margin:0 auto !important;
  display:flex !important;
  align-items:center !important;
  gap:.9rem !important;
}

#vac-chile-2025-app .logo-icon{
  flex:0 0 auto !important;
  display:block !important;
}

#vac-chile-2025-app .logo-icon svg{display:block !important;}

#vac-chile-2025-app .header h1{
  margin:0 !important;
  padding:0 !important;
  font-size:1.125rem !important;
  font-weight:700 !important;
  line-height:1.25 !important;
  color:var(--white) !important;
}

#vac-chile-2025-app .header p{
  margin:.12rem 0 0 0 !important;
  padding:0 !important;
  font-size:.731rem !important;
  opacity:.85 !important;
  color:var(--white) !important;
}

#vac-chile-2025-app .main{
  display:block !important;
  width:100% !important;
  max-width:1060px !important;
  margin:0 auto !important;
  padding:1.25rem 1.35rem !important;
  overflow:visible !important;
}

#vac-chile-2025-app .controls{
  display:flex !important;
  flex-direction:column !important;
  gap:.675rem !important;
  width:100% !important;
  margin:0 0 1.125rem 0 !important;
  padding:0 !important;
}

#vac-chile-2025-app .controls > div{
  display:block !important;
  width:100% !important;
}

#vac-chile-2025-app .selection-label{
  display:block !important;
  margin:0 0 .225rem 0 !important;
  padding:0 !important;
  font-size:.675rem !important;
  font-weight:700 !important;
  color:var(--gray-600) !important;
  text-transform:uppercase !important;
  letter-spacing:.04em !important;
}

#vac-chile-2025-app .search-box{
  position:relative !important;
  display:block !important;
  width:100% !important;
}

#vac-chile-2025-app .search-box input{
  display:block !important;
  width:100% !important;
  height:auto !important;
  padding:.5625rem .675rem .5625rem 2.25rem !important;
  border:1.5px solid var(--gray-300) !important;
  border-radius:var(--radius) !important;
  background:var(--white) !important;
  color:var(--gray-800) !important;
  font-size:.844rem !important;
  line-height:1.4 !important;
  outline:none !important;
  box-shadow:none !important;
}

#vac-chile-2025-app .search-box input:focus{
  border-color:var(--blue-500) !important;
  box-shadow:0 0 0 3px rgba(41,128,185,.15) !important;
}

#vac-chile-2025-app .search-box input::placeholder{color:var(--gray-500) !important;}

#vac-chile-2025-app .search-icon{
  position:absolute !important;
  left:.675rem !important;
  top:50% !important;
  transform:translateY(-50%) !important;
  color:var(--gray-500) !important;
  pointer-events:none !important;
  z-index:2 !important;
}

#vac-chile-2025-app .dropdown{
  position:absolute !important;
  top:calc(100% + 4px) !important;
  left:0 !important;
  right:0 !important;
  display:none !important;
  width:auto !important;
  max-height:320px !important;
  overflow-y:auto !important;
  background:var(--white) !important;
  border:1.5px solid var(--gray-200) !important;
  border-radius:var(--radius) !important;
  box-shadow:var(--shadow-md) !important;
  z-index:9999 !important;
}

#vac-chile-2025-app .dropdown.open{display:block !important;}

#vac-chile-2025-app .dropdown-item{
  display:flex !important;
  align-items:baseline !important;
  gap:.3375rem !important;
  width:100% !important;
  padding:.45rem .675rem !important;
  border-bottom:1px solid var(--gray-100) !important;
  cursor:pointer !important;
  font-size:.788rem !important;
  color:var(--gray-800) !important;
  background:var(--white) !important;
}

#vac-chile-2025-app .dropdown-item:hover,
#vac-chile-2025-app .dropdown-item.active{background:var(--blue-50) !important;}

#vac-chile-2025-app .cap-badge{
  display:inline-block !important;
  flex:0 0 auto !important;
  padding:.1125rem .3375rem !important;
  border-radius:4px !important;
  background:var(--blue-100) !important;
  color:var(--blue-700) !important;
  font-size:.619rem !important;
  font-weight:700 !important;
  white-space:nowrap !important;
}

#vac-chile-2025-app .dropdown-empty{
  padding:.675rem !important;
  text-align:center !important;
  font-size:.788rem !important;
  color:var(--gray-500) !important;
}

#vac-chile-2025-app .age-selector{
  display:flex !important;
  gap:.45rem !important;
  flex-wrap:wrap !important;
  width:100% !important;
}

#vac-chile-2025-app .age-btn{
  display:inline-block !important;
  width:auto !important;
  padding:.3375rem .675rem !important;
  border:1.5px solid var(--gray-300) !important;
  border-radius:var(--radius) !important;
  background:var(--white) !important;
  color:var(--gray-700) !important;
  font-size:.731rem !important;
  font-weight:600 !important;
  line-height:1.3 !important;
  cursor:pointer !important;
}

#vac-chile-2025-app .age-btn:hover{border-color:var(--blue-500) !important;color:var(--blue-700) !important;}
#vac-chile-2025-app .age-btn.selected{background:var(--blue-700) !important;border-color:var(--blue-700) !important;color:var(--white) !important;}

#vac-chile-2025-app #activeSelection{
  display:block !important;
  width:100% !important;
}

#vac-chile-2025-app .active-selection{
  display:flex !important;
  align-items:center !important;
  gap:.3375rem !important;
  width:fit-content !important;
  max-width:100% !important;
  margin:0 0 .675rem 0 !important;
  padding:.3375rem .5625rem !important;
  background:var(--blue-700) !important;
  color:var(--white) !important;
  border-radius:var(--radius) !important;
  font-size:.731rem !important;
  font-weight:600 !important;
}

#vac-chile-2025-app .active-selection button{
  display:inline-block !important;
  padding:0 0 0 .225rem !important;
  border:0 !important;
  background:transparent !important;
  color:rgba(255,255,255,.75) !important;
  cursor:pointer !important;
  font-size:.9rem !important;
  line-height:1 !important;
}

#vac-chile-2025-app .results-area{
  display:block !important;
  width:100% !important;
  max-width:100% !important;
  min-height:200px !important;
  overflow:visible !important;
}

#vac-chile-2025-app .empty-state{
  display:block !important;
  width:100% !important;
  padding:2.7rem .9rem !important;
  text-align:center !important;
  color:var(--gray-500) !important;
}

#vac-chile-2025-app .empty-state svg{
  display:block !important;
  margin:0 auto .675rem auto !important;
  opacity:.4 !important;
}

#vac-chile-2025-app .empty-state p{
  display:block !important;
  margin:0 !important;
  text-align:center !important;
  font-size:.844rem !important;
  color:var(--gray-500) !important;
}

#vac-chile-2025-app .empty-state .hint{
  margin-top:.225rem !important;
  font-size:.731rem !important;
}

#vac-chile-2025-app .cat-card{
  display:block !important;
  width:100% !important;
  max-width:100% !important;
  margin:0 0 1rem 0 !important;
  clear:both !important;
  float:none !important;
  position:relative !important;
  background:var(--blue-50) !important;
  border:1px solid var(--blue-100) !important;
  border-radius:var(--radius) !important;
  overflow:hidden !important;
  box-shadow:var(--shadow-sm) !important;
}

#vac-chile-2025-app .cat-card + .cat-card{margin-top:1rem !important;}

#vac-chile-2025-app .cat-header{
  display:flex !important;
  justify-content:space-between !important;
  align-items:center !important;
  flex-wrap:wrap !important;
  gap:.3375rem !important;
  width:100% !important;
  padding:.675rem .9rem !important;
  background:var(--blue-50) !important;
  border-bottom:1px solid var(--blue-100) !important;
}

#vac-chile-2025-app .cat-header h3{
  display:block !important;
  margin:0 !important;
  padding:0 !important;
  font-size:.844rem !important;
  font-weight:700 !important;
  color:var(--blue-800) !important;
}

#vac-chile-2025-app .cat-meta{
  display:flex !important;
  gap:.675rem !important;
  flex-wrap:wrap !important;
  font-size:.675rem !important;
  color:var(--blue-600) !important;
  font-weight:600 !important;
}

#vac-chile-2025-app .age-badge{
  display:inline-block !important;
  padding:.1125rem .45rem !important;
  border-radius:4px !important;
  background:var(--amber-100) !important;
  color:var(--amber-700) !important;
  font-size:.619rem !important;
  font-weight:700 !important;
}

/* TABLAS: centradas, apiladas y sin texto cortado */
#vac-chile-2025-app .vac-table-wrap{
  display:block !important;
  width:100% !important;
  max-width:100% !important;
  overflow-x:auto !important;
  overflow-y:hidden !important;
  -webkit-overflow-scrolling:touch !important;
  background:var(--white) !important;
}

#vac-chile-2025-app table.vac-table{
  display:table !important;
  width:100% !important;
  min-width:920px !important;
  max-width:none !important;
  margin:0 auto !important;
  table-layout:fixed !important;
  border-collapse:collapse !important;
  border-spacing:0 !important;
  background:var(--white) !important;
  font-size:.731rem !important;
  border:0 !important;
}

#vac-chile-2025-app table.vac-table col.col-vacuna{width:22% !important;}
#vac-chile-2025-app table.vac-table col.col-dosis{width:8% !important;}
#vac-chile-2025-app table.vac-table col.col-esquema{width:32% !important;}
#vac-chile-2025-app table.vac-table col.col-obs{width:38% !important;}

#vac-chile-2025-app table.vac-table thead{display:table-header-group !important;}
#vac-chile-2025-app table.vac-table tbody{display:table-row-group !important;}
#vac-chile-2025-app table.vac-table tr{display:table-row !important;height:auto !important;}

#vac-chile-2025-app table.vac-table th,
#vac-chile-2025-app table.vac-table td{
  display:table-cell !important;
  position:static !important;
  float:none !important;
  height:auto !important;
  max-height:none !important;
  padding:.5rem .65rem !important;
  border:0 !important;
  border-bottom:1px solid var(--gray-100) !important;
  vertical-align:top !important;
  text-align:left !important;
  white-space:normal !important;
  word-break:normal !important;
  overflow-wrap:anywhere !important;
  overflow:visible !important;
  text-overflow:clip !important;
  line-height:1.45 !important;
}

#vac-chile-2025-app table.vac-table th{
  background:var(--blue-700) !important;
  color:var(--white) !important;
  font-size:.675rem !important;
  font-weight:700 !important;
  text-transform:uppercase !important;
  letter-spacing:.03em !important;
}

#vac-chile-2025-app table.vac-table td{
  color:var(--gray-800) !important;
  font-size:.731rem !important;
  font-weight:500 !important;
}

#vac-chile-2025-app table.vac-table td:first-child{
  color:var(--blue-800) !important;
  font-weight:700 !important;
}

#vac-chile-2025-app table.vac-table td:nth-child(2){text-align:center !important;}
#vac-chile-2025-app table.vac-table tr:nth-child(even) td{background:var(--gray-50) !important;}
#vac-chile-2025-app table.vac-table tr:hover td{background:var(--blue-50) !important;}

#vac-chile-2025-app table.vac-table td::before,
#vac-chile-2025-app table.vac-table td::after,
#vac-chile-2025-app table.vac-table th::before,
#vac-chile-2025-app table.vac-table th::after{
  content:none !important;
  display:none !important;
}

#vac-chile-2025-app .no-age-match{
  display:block !important;
  padding:.9rem !important;
  text-align:center !important;
  color:var(--gray-500) !important;
  font-size:.788rem !important;
}

#vac-chile-2025-app .disclaimer{
  display:block !important;
  width:100% !important;
  margin-top:1.35rem !important;
  padding:.675rem .9rem !important;
  border:1px solid #f0d9a0 !important;
  border-radius:var(--radius) !important;
  background:var(--amber-100) !important;
  color:var(--amber-700) !important;
  font-size:.675rem !important;
  line-height:1.6 !important;
}

#vac-chile-2025-app .disclaimer strong{font-weight:700 !important;}
#vac-chile-2025-app .disclaimer a{color:var(--amber-700) !important;text-decoration:underline !important;}

#vac-chile-2025-app .app-footer{
  display:block !important;
  width:100% !important;
  margin-top:.9rem !important;
  padding:.9rem 1.35rem !important;
  background:var(--blue-900) !important;
  color:rgba(255,255,255,.75) !important;
  text-align:center !important;
  font-size:.675rem !important;
}

@media(max-width:700px){
  #vac-chile-2025-app{max-width:100% !important;}
  #vac-chile-2025-app .main{padding:1rem !important;}
  #vac-chile-2025-app .header-inner{flex-direction:column !important;text-align:center !important;}
  #vac-chile-2025-app .header h1{text-align:center !important;font-size:1.0125rem !important;}
  #vac-chile-2025-app .header p{text-align:center !important;}
  #vac-chile-2025-app .age-selector{justify-content:center !important;}
  #vac-chile-2025-app table.vac-table{min-width:850px !important;font-size:.675rem !important;}
  #vac-chile-2025-app table.vac-table th,
  #vac-chile-2025-app table.vac-table td{padding:.42rem .5rem !important;}
}
