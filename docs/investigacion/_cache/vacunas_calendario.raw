/* ═══ STORE ═══ */
var S={_k:'intvac_v4',data:{user:null,lang:'es',docs:[],cdoc:null,step:0}};
S.load=function(){try{var d=localStorage.getItem(this._k);if(d){var p=JSON.parse(d);this.data.user=p.user||null;this.data.lang=p.lang||'es';this.data.docs=p.docs||[];this.data.cdoc=p.cdoc||null;this.data.step=p.step||0;}}catch(e){}return this;};
S.save=function(){try{localStorage.setItem(this._k,JSON.stringify(this.data));}catch(e){}};
S.user=function(){return this.data.user;};
S.setUser=function(u){this.data.user=u;this.save();};
S.lang=function(){return this.data.lang;};
S.setLang=function(l){this.data.lang=l;this.save();var s=document.getElementById('intvac-lang-select');if(s)s.value=l;};
S.docs=function(){return this.data.docs;};
S.addDoc=function(d){d.id='DOC-'+Date.now();d.createdAt=new Date().toISOString();d.status='uploaded';this.data.docs.unshift(d);if(this.data.docs.length>50)this.data.docs.length=50;this.save();return d;};
S.upd=function(id,u){var ds=this.data.docs;for(var i=0;i<ds.length;i++){if(ds[i].id===id){for(var k in u)ds[i][k]=u[k];this.save();return ds[i];}}return null;};
S.doc=function(id){var ds=this.data.docs;for(var i=0;i<ds.length;i++){if(ds[i].id===id)return ds[i];}return null;};
S.cdoc=function(){return this.data.cdoc;};
S.setCDoc=function(d){this.data.cdoc=d;this.save();};
S.step=function(){return this.data.step;};
S.setStep=function(s){this.data.step=s;this.save();};
S.remove=function(id){this.data.docs=this.data.docs.filter(function(d){return d.id!==id;});if(this.data.cdoc&&this.data.cdoc.id===id){this.data.cdoc=null;this.data.step=0;}this.save();};
S.clear=function(){this.data={user:null,lang:this.data.lang||'es',docs:[],cdoc:null,step:0};this.save();};
S.load();

/* ═══ HELPERS ═══ */
function T(k){return (I18N[S.lang()]||I18N.es)[k]||k;}
function $(id){return document.getElementById(id);}
function E(tag,cls,html){var e=document.createElement(tag);if(cls)e.className=cls;if(html!==undefined)e.innerHTML=html;return e;}
function esc(t){return t?String(t).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'):'';}
function B(t,tx){return '<span class="intvac-badge intvac-badge-'+t+'">'+esc(tx)+'</span>';}
function Toast(ttl,msg,tp){var c=$('intvac-toasts');if(!c)return;var d=E('div','intvac-toast '+(tp||'info'));d.innerHTML='<div class="intvac-toast-title">'+esc(ttl)+'</div><div class="intvac-toast-msg">'+esc(msg)+'</div>';c.appendChild(d);setTimeout(function(){d.style.opacity='0';d.style.transform='translateX(100%)';d.style.transition='all .3s';setTimeout(function(){d.remove();},300);},3500);}

/* ═══ TESSERACT OCR ═══ */
var _tesseractReady=false,_tesseractLoading=false;
function loadTesseract(cb){
  if(_tesseractReady){cb(true);return;}
  if(typeof Tesseract!=='undefined'){_tesseractReady=true;cb(true);return;}
  if(_tesseractLoading){setTimeout(function(){loadTesseract(cb);},300);return;}
  _tesseractLoading=true;
  var s=document.createElement('script');
  s.src='https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js';
  s.onload=function(){_tesseractReady=true;_tesseractLoading=false;cb(true);};
  s.onerror=function(){_tesseractLoading=false;cb(false);};
  document.head.appendChild(s);
}
function doOCRImage(file,lang,cb){
  loadTesseract(function(ok){
    if(!ok){cb(null,'Tesseract.js no pudo cargarse. Usa "Carné Demo" para probar.');return;}
    var reader=new FileReader();
    reader.onload=function(e){
      Tesseract.recognize(e.target.result,lang||'spa',{
        logger:function(m){if(m.status==='recognizing text'&&cb.onProgress)cb.onProgress(m.progress);}
      }).then(function(r){cb(r.data.text,Math.round(r.data.confidence));})
      .catch(function(err){cb(null,'Error OCR: '+err.message);});
    };
    reader.readAsDataURL(file);
  });
}

/* ═══ INTERPRETATION ═══ */
function interpret(txt){
  if(!txt||txt.trim().length<10)return{vaccines:[],patient:{}};
  var t=txt.toLowerCase(),res=[],used={};
  for(var i=0;i<VDB.length;i++){var v=VDB[i];for(var j=0;j<v.entries.length;j++){var e=v.entries[j],n=e.n.toLowerCase();if(t.indexOf(n)>=0&&!used[e.n]){res.push({sourceName:e.n,pniCode:v.pni,pniName:v.name,confidence:e.c,type:e.t});used[e.n]=true;break;}}}
  var p={};
  var nm=txt.match(/(?:Nombre|Name|Patient|Paciente)\s*[:\s]+([A-ZÁÉÍÓÚÑa-záéíóúñ]+\s+[A-ZÁÉÍÓÚÑa-záéíóúñ]+)/i);
  if(nm)p.name=nm[1].trim();
  var db=txt.match(/(?:Fecha\s+(?:de\s+)?nacimiento|Date\s+of\s+birth|DOB|Nacimiento|Nac)\s*[:\s]+([\d]{1,2}[\/\-\.][\d]{1,2}[\/\-\.][\d]{2,4})/i);
  if(db)p.dateOfBirth=db[1].trim();
  var ag=txt.match(/(?:Edad|Age)\s*[:\s]+(\d+)\s*(?:años|years|a)/i);
  if(ag)p.age=parseInt(ag[1]);
  return{vaccines:res,patient:p};
}
function comparePNI(mapped){var res=[];for(var i=0;i<PNI.length;i++){var pni=PNI[i],found=mapped.filter(function(v){return v.pniCode===pni.code;}),rec=found.length,exp=pni.schedule.length;res.push({code:pni.code,name:pni.name,full:pni.full,disease:pni.disease,dosesExpected:exp,dosesReceived:rec,dosesMissing:Math.max(0,exp-rec),complete:rec>=exp,schedule:pni.schedule});}return res;}

/* ═══ RENDER: Sidebar ═══ */
function rSidebar(pg){
  var s=$('intvac-sidebar'),u=S.user(),init=(u&&u.name?u.name.split(' ').map(function(w){return w[0];}).join('').toUpperCase().slice(0,2):'AG');
  var it=[{id:'dashboard',ic:'📊',lb:T('dashboard')},{id:'upload',ic:'📤',lb:T('uploadTitle')},{id:'history',ic:'📋',lb:T('history')},{id:'catalog',ic:'💉',lb:T('catalog')},{id:'settings',ic:'⚙️',lb:T('settings')}];
  s.innerHTML='<div class="intvac-sidebar-logo"><span class="intvac-sidebar-logo-icon">🔰</span><span class="intvac-sidebar-logo-name">INTVAC</span></div><nav class="intvac-sidebar-nav"><div class="intvac-sidebar-section">Principal</div>'+it.map(function(i){return '<button class="intvac-sidebar-item'+(pg===i.id?' active':'')+'" data-action="nav-'+i.id+'"><span>'+i.ic+'</span> '+i.lb+'</button>';}).join('')+'</nav><div class="intvac-sidebar-footer"><div class="intvac-sidebar-user"><div class="intvac-sidebar-avatar">'+init+'</div><div style="line-height:1.3;"><div class="intvac-sidebar-user-name">'+(u?u.name:T('demoUser'))+'</div><div class="intvac-sidebar-user-role">'+T('healthPro')+'</div></div></div><button class="intvac-sidebar-logout" data-action="logout">'+T('logout')+'</button></div>';
}

/* ═══ RENDER: Auth ═══ */
function rAuth(mode){
  var il=(mode==='login'),fh='';
  if(!il)fh+='<div class="intvac-form-group"><label class="intvac-form-label">'+T('name')+'</label><input class="intvac-form-input" id="auth-name" placeholder="Ana García"></div>';
  fh+='<div class="intvac-form-group"><label class="intvac-form-label">'+T('email')+'</label><input class="intvac-form-input" id="auth-email" type="email" placeholder="demo@intvac.cl" value="'+(il?'demo@intvac.cl':'')+'"></div><div class="intvac-form-group"><label class="intvac-form-label">'+T('password')+'</label><input class="intvac-form-input" id="auth-pass" type="password" placeholder="••••••••" value="'+(il?'demo123':'')+'"></div>';
  if(!il)fh+='<div class="intvac-form-group"><label class="intvac-form-label">'+T('confirmPass')+'</label><input class="intvac-form-input" id="auth-pass2" type="password" placeholder="••••••••"></div>';
  fh+='<button class="intvac-btn intvac-btn-primary intvac-btn-block" style="margin-top:8px;" data-action="'+(il?'doLogin':'doRegister')+'">'+T(il?'login':'register')+'</button>';
  var l=$('intvac-landing'),a=$('intvac-auth'),d=$('intvac-dashboard');
  if(l){l.classList.add('intvac-hidden');l.style.display='none';}
  if(a){a.classList.remove('intvac-hidden');a.style.display='block';}
  if(d){d.classList.add('intvac-hidden');d.style.display='none';}
  var t=$('intvac-auth-title'),st=$('intvac-auth-subtitle'),f=$('intvac-auth-form'),ft=$('intvac-auth-footer');
  if(t)t.textContent=T(il?'login':'register');if(st)st.textContent=il?'Accede a tu cuenta INTVAC':'Crea tu cuenta gratuita';
  if(f)f.innerHTML=fh;if(ft)ft.innerHTML=il?(T('noAccount')+' <a data-action="showRegister" style="color:var(--primary-700);font-weight:600;cursor:pointer;text-decoration:underline;">'+T('registerHere')+'</a>'):(T('hasAccount')+' <a data-action="showLogin" style="color:var(--primary-700);font-weight:600;cursor:pointer;text-decoration:underline;">'+T('loginHere')+'</a>');
  setTimeout(function(){var el=$('auth-email');if(el)el.focus();},150);
}

/* ═══ RENDER: Dashboard ═══ */
function rDashboard(){
  rSidebar('dashboard');var ds=S.docs(),t=ds.length,co=ds.filter(function(d){return d.status==='completed';}).length,tv=ds.reduce(function(s,d){return s+(d.mapped?d.mapped.length:0);},0),sr=t?Math.round((co/t)*100):0;
  var m=$('intvac-main');
  m.innerHTML='<div class="intvac-page-header"><h1 class="intvac-page-title">'+T('dashboard')+'</h1><p class="intvac-page-subtitle">'+T('appSub')+'</p></div>'+
  '<div class="intvac-stats-grid"><div class="intvac-stat-card"><div class="intvac-stat-icon">📄</div><div class="intvac-stat-value">'+t+'</div><div class="intvac-stat-label">'+T('totalDocs')+'</div></div><div class="intvac-stat-card"><div class="intvac-stat-icon">💉</div><div class="intvac-stat-value">'+tv+'</div><div class="intvac-stat-label">'+T('vaccinesInterp')+'</div></div><div class="intvac-stat-card"><div class="intvac-stat-icon">✅</div><div class="intvac-stat-value">'+sr+'%</div><div class="intvac-stat-label">'+T('successRate')+'</div></div><div class="intvac-stat-card"><div class="intvac-stat-icon">🏥</div><div class="intvac-stat-value">'+PNI.length+'</div><div class="intvac-stat-label">'+T('pniVaccines')+'</div></div></div>'+
  '<div class="intvac-flex intvac-gap-12 intvac-mb-5"><button class="intvac-btn intvac-btn-primary" data-action="nav-upload">📤 '+T('uploadNew')+'</button><button class="intvac-btn intvac-btn-secondary" data-action="nav-history">📋 '+T('history')+'</button><button class="intvac-btn intvac-btn-secondary" data-action="nav-catalog">💉 '+T('catalog')+'</button></div>'+
  '<div class="intvac-card"><div class="intvac-card-header"><h3 class="intvac-card-title">'+T('recentDocs')+'</h3></div><div class="intvac-card-body" style="padding:0;">'+
  (t===0?'<div style="text-align:center;padding:40px;color:var(--neutral-600);">'+T('noDocuments')+'</div>':'<table class="intvac-table"><thead><tr><th>ID</th><th>País</th><th>Vacunas</th><th>Estado</th><th>Fecha</th></tr></thead><tbody>'+ds.slice(0,5).map(function(d){var c=COUNTRIES.find(function(x){return x.code===d.country;})||{};return '<tr data-action="viewDoc-'+d.id+'" class="intvac-tr"><td style="font-weight:500;">'+d.id+'</td><td>'+(c.flag||'🌐')+' '+(d.country||'N/A')+'</td><td>'+(d.mapped?d.mapped.length:0)+'</td><td>'+B(d.status==='completed'?'success':d.status==='processing'?'warning':'info',d.status||'uploaded')+'</td><td>'+new Date(d.createdAt).toLocaleDateString('es-CL')+'</td></tr>';}).join('')+'</tbody></table>')+'</div></div>';
}

/* ═══ UPLOAD ═══ */
var _upFile=null,_upDataUrl=null;
function rUpload(){
  if(S.cdoc()){rPipeline();return;}
  rSidebar('upload');var m=$('intvac-main');
  m.innerHTML='<div class="intvac-page-header"><h1 class="intvac-page-title">'+T('uploadTitle')+'</h1><p class="intvac-page-subtitle">'+T('uploadSub')+'</p></div>'+
  '<div class="intvac-card"><div class="intvac-card-body"><div class="intvac-upload-zone" id="izone"><div class="intvac-upload-icon">📤</div><h3 class="intvac-upload-title">'+T('uploadCard')+'</h3><p class="intvac-upload-subtitle">'+T('dragDrop')+'</p><p class="intvac-upload-hint">'+T('formats')+'</p><img class="intvac-upload-preview" id="ipreview"></div><input type="file" id="iinput" accept="image/*,.pdf" style="display:none;"></div></div>'+
  '<div class="intvac-card" style="margin-top:16px;"><div class="intvac-card-body"><div class="intvac-grid-2"><div class="intvac-form-group"><label class="intvac-form-label">'+T('countryLabel')+'</label><select class="intvac-form-select" id="icountry">'+COUNTRIES.map(function(c){return '<option value="'+c.code+'">'+c.flag+' '+c.name+'</option>';}).join('')+'</select></div><div class="intvac-form-group"><label class="intvac-form-label">'+T('languageLabel')+'</label><select class="intvac-form-select" id="ilang"><option value="spa">🇪🇸 Español</option><option value="eng">🇬🇧 English</option><option value="por">🇧🇷 Português</option><option value="fra">🇫🇷 Français</option><option value="deu">🇩🇪 Deutsch</option><option value="ita">🇮🇹 Italiano</option></select></div></div>'+
  '<div style="margin-top:16px;display:flex;gap:12px;flex-wrap:wrap;"><button class="intvac-btn intvac-btn-primary intvac-btn-lg" id="ibtn" data-action="doProc" disabled>🔍 '+T('startProcessing')+'</button><button class="intvac-btn intvac-btn-secondary intvac-btn-lg" data-action="loadDemo">📋 Usar Carné Demo</button></div></div></div>';
  _setupUZ();
}
function _setupUZ(){
  var z=$('izone'),inp=$('iinput');if(!z||!inp)return;
  z.addEventListener('dragover',function(e){e.preventDefault();z.classList.add('dragover');});
  z.addEventListener('dragleave',function(){z.classList.remove('dragover');});
  z.addEventListener('drop',function(e){e.preventDefault();z.classList.remove('dragover');if(e.dataTransfer.files[0])_hf(e.dataTransfer.files[0]);});
  z.addEventListener('click',function(){inp.click();});
  inp.addEventListener('change',function(e){if(e.target.files[0])_hf(e.target.files[0]);});
}
function _hf(f){
  if(!f.type.match(/image\/(jpeg|png|webp)/)&&f.type!=='application/pdf'){Toast('Formato no soportado','Usa JPG, PNG, WEBP o PDF.','error');return;}
  if(f.size>20*1024*1024){Toast('Archivo muy grande','Máximo 20MB.','error');return;}
  _upFile=f;
  if(f.type.startsWith('image/')){
    var r=new FileReader();r.onload=function(e){_upDataUrl=e.target.result;var p=$('ipreview');if(p){p.src=e.target.result;p.classList.add('show');}};r.readAsDataURL(f);
  }
  var b=$('ibtn');if(b){b.disabled=false;b.textContent='🔍 '+T('startProcessing');}
  Toast('Archivo listo',f.name,'success');
}

/* ═══ PIPELINE STEPS ═══ */
function rPipeline(){
  var doc=S.cdoc(),step=S.step();rSidebar('upload');
  var sts=[{ic:'📤',lb:T('uploadTitle')},{ic:'🔍',lb:T('ocrResults')},{ic:'🧠',lb:T('interpretation')},{ic:'🇨🇱',lb:T('equivalences')}],sh='';
  for(var i=0;i<sts.length;i++){var cls='intvac-step-item';if(i<step)cls+=' completed';else if(i===step)cls+=' active';if(i>0)sh+='<div class="intvac-step-line'+(i<step?' done':'')+'"></div>';sh+='<div class="'+cls+'"><div class="intvac-step-dot"></div><span class="intvac-step-label">'+sts[i].ic+' '+sts[i].lb+'</span></div>';}
  var ct='';
  if(step===0)ct=_rUStep();else if(step===1)ct=_rOCRStep(doc);else if(step===2)ct=_rIStep(doc);else if(step===3)ct=_rMStep(doc);else ct=_rRStep(doc);
  var m=$('intvac-main');if(m)m.innerHTML='<div class="intvac-page-header"><h1 class="intvac-page-title">'+T('uploadTitle')+'</h1><p class="intvac-page-subtitle">'+T('processingStage')+': '+sts[Math.min(step,3)].lb+'</p></div><div class="intvac-step-indicator intvac-mb-5">'+sh+'</div>'+ct;
}
function _rUStep(){return '<div class="intvac-card"><div class="intvac-card-body"><div class="intvac-upload-zone" id="izone"><div class="intvac-upload-icon">📤</div><h3 class="intvac-upload-title">'+T('uploadCard')+'</h3><p class="intvac-upload-subtitle">'+T('dragDrop')+'</p><p class="intvac-upload-hint">'+T('formats')+'</p><img class="intvac-upload-preview" id="ipreview"></div><input type="file" id="iinput" accept="image/*,.pdf" style="display:none;"></div></div><div class="intvac-card" style="margin-top:16px;"><div class="intvac-card-body"><div class="intvac-grid-2"><div class="intvac-form-group"><label class="intvac-form-label">'+T('countryLabel')+'</label><select class="intvac-form-select" id="icountry">'+COUNTRIES.map(function(c){return '<option value="'+c.code+'">'+c.flag+' '+c.name+'</option>';}).join('')+'</select></div><div class="intvac-form-group"><label class="intvac-form-label">'+T('languageLabel')+'</label><select class="intvac-form-select" id="ilang"><option value="spa">🇪🇸 Español</option><option value="eng">🇬🇧 English</option><option value="por">🇧🇷 Português</option><option value="fra">🇫🇷 Français</option><option value="deu">🇩🇪 Deutsch</option><option value="ita">🇮🇹 Italiano</option></select></div></div><div style="margin-top:16px;display:flex;gap:12px;flex-wrap:wrap;"><button class="intvac-btn intvac-btn-primary intvac-btn-lg" id="ibtn" data-action="doProc" disabled>🔍 '+T('startProcessing')+'</button><button class="intvac-btn intvac-btn-secondary intvac-btn-lg" data-action="loadDemo">📋 Usar Carné Demo</button></div></div></div>';}
function _rOCRStep(doc){var conf=doc.ocrConfidence||0,txt=doc.ocrText||'';return '<div class="intvac-card"><div class="intvac-card-header"><h3 class="intvac-card-title">🔍 '+T('ocrResults')+'</h3>'+(conf>0?B('success',T('ocrComplete')):B('warning','Procesando'))+'</div><div class="intvac-card-body"><div class="intvac-flex-between intvac-mb-3"><strong>'+T('confidence')+':</strong><span id="oconf">'+(conf>0?conf+'%':'--')+'</span></div><div class="intvac-progress"><div class="intvac-progress-bar" id="oprog" style="width:'+(conf>0?'100%':'50%')+';"></div></div><div style="margin-top:16px;"><strong>'+T('ocrText')+':</strong></div><pre style="background:var(--neutral-50);padding:16px;border-radius:var(--radius-md);font-size:13px;white-space:pre-wrap;max-height:300px;overflow-y:auto;margin-top:8px;">'+esc(txt)+'</pre></div><div class="intvac-card-footer"><button class="intvac-btn intvac-btn-secondary" data-action="goStep-0">'+T('back')+'</button><button class="intvac-btn intvac-btn-primary" data-action="doInterp">'+T('next')+': '+T('interpretation')+' →</button></div></div>';}
function _rIStep(doc){var v=doc.interp||[],p=doc.patient||{};return '<div class="intvac-card"><div class="intvac-card-header"><h3 class="intvac-card-title">🧠 '+T('interpretation')+'</h3>'+B('success','Completado')+'</div><div class="intvac-card-body"><h4 style="margin:0 0 8px;">'+T('patientData')+'</h4><div class="intvac-mb-4" style="display:grid;grid-template-columns:1fr 1fr;gap:8px;"><div><strong>'+T('name')+':</strong> '+esc(p.name||'No detectado')+'</div><div><strong>Fecha Nac.:</strong> '+esc(p.dateOfBirth||'No detectada')+'</div>'+(p.age?'<div><strong>Edad:</strong> '+p.age+' años</div>':'')+'</div><h4 style="margin:0 0 8px;">'+T('vaccinesFound')+' ('+v.length+')</h4>'+(v.length===0?'<div style="text-align:center;padding:20px;color:var(--neutral-600);">No se detectaron vacunas. Prueba con "Usar Carné Demo".</div>':'<div style="overflow-x:auto;"><table class="intvac-table"><thead><tr><th>'+T('sourceVaccine')+'</th><th>'+T('mappedTo')+'</th><th>'+T('confidence')+'</th></tr></thead><tbody>'+v.map(function(x){var pn=PNI.find(function(p){return p.code===x.pniCode;})||{};return '<tr><td><strong>'+esc(x.sourceName)+'</strong></td><td>'+esc(pn.full||x.pniName)+'</td><td>'+Math.round(x.confidence*100)+'%</td></tr>';}).join('')+'</tbody></table></div>')+'</div><div class="intvac-card-footer"><button class="intvac-btn intvac-btn-secondary" data-action="goStep-1">'+T('back')+'</button><button class="intvac-btn intvac-btn-primary" data-action="doMap">'+T('next')+': '+T('equivalences')+' →</button></div></div>';}
function _rMStep(doc){var m=doc.mapped||[],cp=doc.comp||[],sum=cp.length?{t:cp.length,c:cp.filter(function(c){return c.complete;}).length,i:cp.filter(function(c){return !c.complete&&c.dosesReceived>0;}).length,m:cp.filter(function(c){return c.dosesReceived===0;}).length}:null;return '<div class="intvac-card"><div class="intvac-card-header"><h3 class="intvac-card-title">🇨🇱 '+T('equivalences')+'</h3>'+B('success',T('mappingComplete'))+'</div><div class="intvac-card-body">'+(sum?'<div class="intvac-stats-grid intvac-mb-5"><div class="intvac-stat-card"><div class="intvac-stat-value" style="color:var(--success-700);">'+sum.c+'</div><div class="intvac-stat-label">'+T('complete')+'</div></div><div class="intvac-stat-card"><div class="intvac-stat-value" style="color:var(--warning-700);">'+sum.i+'</div><div class="intvac-stat-label">'+T('incomplete')+'</div></div><div class="intvac-stat-card"><div class="intvac-stat-value" style="color:var(--error-600);">'+sum.m+'</div><div class="intvac-stat-label">'+T('missing')+'</div></div></div>':'')+'<h4 style="margin:0 0 8px;">'+T('vaccinesFound')+'</h4><div style="overflow-x:auto;"><table class="intvac-table"><thead><tr><th>'+T('sourceVaccine')+'</th><th>PNI</th><th>'+T('confidenceLabel')+'</th></tr></thead><tbody>'+m.map(function(x){var pn=PNI.find(function(p){return p.code===x.pniCode;})||{};return '<tr><td><strong>'+esc(x.sourceName)+'</strong></td><td>'+esc(pn.full||x.pniName)+'</td><td>'+Math.round(x.confidence*100)+'%</td></tr>';}).join('')+'</tbody></table></div></div><div class="intvac-card-footer"><button class="intvac-btn intvac-btn-secondary" data-action="goStep-2">'+T('back')+'</button><button class="intvac-btn intvac-btn-primary" data-action="goStep-4">'+T('next')+': '+T('report')+' →</button></div></div>';}
function _rRStep(doc){var m=doc.mapped||[],cp=doc.comp||[],p=doc.patient||{},cname=COUNTRIES.find(function(x){return x.code===doc.country;}),inc=cp.filter(function(c){return !c.complete;});return '<div class="intvac-card"><div class="intvac-card-header"><h3 class="intvac-card-title">📋 '+T('report')+'</h3><div class="intvac-flex intvac-gap-8"><button class="intvac-btn intvac-btn-sm intvac-btn-secondary" data-action="printReport">🖨️ Imprimir</button><button class="intvac-btn intvac-btn-sm intvac-btn-primary" data-action="newDoc">📤 '+T('newDocument')+'</button></div></div><div class="intvac-card-body"><div class="intvac-report" id="printr"><div class="intvac-report-header"><h2 class="intvac-report-title">'+T('reportHeader')+'</h2><p class="intvac-report-subtitle">'+T('reportSub')+'</p></div><div class="intvac-report-section"><h3>'+T('patientInfo')+'</h3><div class="intvac-report-row"><span class="intvac-report-label">'+T('name')+'</span><span class="intvac-report-value">'+esc(p.name||'No detectado')+'</span></div><div class="intvac-report-row"><span class="intvac-report-label">Fecha Nac.</span><span class="intvac-report-value">'+esc(p.dateOfBirth||'No detectada')+'</span></div><div class="intvac-report-row"><span class="intvac-report-label">'+T('countryLabel')+'</span><span class="intvac-report-value">'+esc(cname?cname.name:doc.country||'N/A')+'</span></div><div class="intvac-report-row"><span class="intvac-report-label">ID</span><span class="intvac-report-value">'+doc.id+'</span></div></div><div class="intvac-report-section"><h3>'+T('vaccineList')+'</h3>'+m.map(function(x){var pn=PNI.find(function(p){return p.code===x.pniCode;})||{};return '<div class="intvac-report-row"><span class="intvac-report-label">'+esc(x.sourceName)+'</span><span class="intvac-report-value">'+esc(pn.full||x.pniName)+' ('+Math.round(x.confidence*100)+'%)</span></div>';}).join('')+'</div><div class="intvac-report-section"><h3>'+T('compliance')+'</h3>'+(cp.length===0?'<p>Sin datos de comparación.</p>':'<div style="overflow-x:auto;"><table class="intvac-table"><thead><tr><th>Vacuna PNI</th><th>'+T('received')+'</th><th>'+T('expected')+'</th><th>'+T('status')+'</th></tr></thead><tbody>'+cp.map(function(c){return '<tr><td><strong>'+c.name+'</strong> <span style="font-size:11px;color:var(--neutral-600);">('+c.disease+')</span></td><td>'+c.dosesReceived+'</td><td>'+c.dosesExpected+'</td><td>'+B(c.complete?'success':c.dosesReceived>0?'warning':'error',c.complete?T('complete'):c.dosesReceived>0?T('incomplete'):T('pending'))+'</td></tr>';}).join('')+'</tbody></table></div>')+'</div><div class="intvac-report-section"><h3>'+T('recommendations')+'</h3>'+(inc.length===0?'<p style="color:var(--success-600);">✅ Todas las vacunas del calendario PNI están cubiertas.</p>':'<ul style="margin:0;padding-left:20px;">'+inc.map(function(c){return '<li style="margin-bottom:8px;"><strong>'+c.name+':</strong> Faltan '+c.dosesMissing+' dosis. Esquema: '+c.schedule.map(function(s){return s.age;}).join(', ')+'.</li>';}).join('')+'</ul>')+'</div></div></div></div>';}

/* ═══ History, Catalog, Settings ═══ */
function rHistory(){rSidebar('history');var ds=S.docs();$('intvac-main').innerHTML='<div class="intvac-page-header"><h1 class="intvac-page-title">'+T('history')+'</h1><p class="intvac-page-subtitle">'+ds.length+' '+T('totalDocs').toLowerCase()+'</p></div><div class="intvac-card"><div class="intvac-card-body" style="padding:0;">'+(ds.length===0?'<div style="text-align:center;padding:40px;color:var(--neutral-600);">'+T('noDocuments')+'</div>':'<div style="overflow-x:auto;"><table class="intvac-table"><thead><tr><th>ID</th><th>País</th><th>Vacunas</th><th>Estado</th><th>Fecha</th><th></th></tr></thead><tbody>'+ds.map(function(d){var c=COUNTRIES.find(function(x){return x.code===d.country;})||{};return '<tr><td style="font-weight:500;">'+d.id+'</td><td>'+(c.flag||'🌐')+' '+(d.country||'')+'</td><td>'+(d.mapped?d.mapped.length:0)+'</td><td>'+B(d.status==='completed'?'success':d.status==='processing'?'warning':'info',d.status||'uploaded')+'</td><td>'+new Date(d.createdAt).toLocaleDateString('es-CL')+'</td><td><button class="intvac-btn intvac-btn-sm intvac-btn-secondary" data-action="viewDoc-'+d.id+'">Ver</button> <button class="intvac-btn intvac-btn-sm intvac-btn-danger" data-action="deleteDoc-'+d.id+'">✕</button></td></tr>';}).join('')+'</tbody></table></div>')+'</div></div>';}
function rCatalog(){rSidebar('catalog');$('intvac-main').innerHTML='<div class="intvac-page-header"><h1 class="intvac-page-title">'+T('catalog')+'</h1><p class="intvac-page-subtitle">Calendario PNI Chile 2026 · '+PNI.length+' vacunas</p></div><div class="intvac-card"><div class="intvac-card-body" style="padding:0;"><div style="overflow-x:auto;"><table class="intvac-table"><thead><tr><th>Código</th><th>Vacuna</th><th>Enfermedad</th><th style="text-align:center;">'+T('doseLabel')+'s</th><th>Esquema</th></tr></thead><tbody>'+PNI.map(function(v){return '<tr><td style="font-weight:600;color:var(--primary-700);">'+v.code+'</td><td><strong>'+v.name+'</strong><br><span style="font-size:12px;color:var(--neutral-600);">'+v.full+'</span></td><td>'+v.disease+'</td><td style="text-align:center;">'+v.doses+'</td><td style="font-size:12px;">'+v.schedule.map(function(s){return s.age;}).join(', ')+'</td></tr>';}).join('')+'</tbody></table></div></div></div>';}
function rSettings(){rSidebar('settings');var ds=S.docs();$('intvac-main').innerHTML='<div class="intvac-page-header"><h1 class="intvac-page-title">'+T('settingsTitle')+'</h1></div><div class="intvac-card intvac-mb-4"><div class="intvac-card-body"><div class="intvac-form-group"><label class="intvac-form-label">'+T('languageSetting')+'</label><select class="intvac-form-select" id="slang" style="max-width:250px;"><option value="es"'+(S.lang()==='es'?' selected':'')+'>🇪🇸 Español</option><option value="en"'+(S.lang()==='en'?' selected':'')+'>🇬🇧 English</option></select></div></div></div><div class="intvac-card"><div class="intvac-card-body"><h4 style="margin:0 0 8px;">'+T('storageInfo')+'</h4><p class="intvac-text-sm">'+T('docsStored')+': '+ds.length+'</p><button class="intvac-btn intvac-btn-danger intvac-btn-sm" data-action="clearAll" style="margin-top:12px;">🗑️ '+T('clearAll')+'</button></div></div>';}

/* ═══ ACTIONS ═══ */
function nav(pg){var u=S.user();if(!u){rAuth('login');return;}var l=$('intvac-landing'),a=$('intvac-auth'),d=$('intvac-dashboard');if(l){l.classList.add('intvac-hidden');l.style.display='none';}if(a){a.classList.add('intvac-hidden');a.style.display='none';}if(d){d.classList.remove('intvac-hidden');d.style.display='block';}if(pg==='dashboard')rDashboard();else if(pg==='upload')rUpload();else if(pg==='history')rHistory();else if(pg==='catalog')rCatalog();else if(pg==='settings')rSettings();else rDashboard();}
function goStep(s){S.setStep(s);rPipeline();}

function doLogin(){
  var e=$('auth-email'),p=$('auth-pass');if(!e||!p||!e.value.trim()||!p.value.trim()){Toast('Error','Completa todos los campos.','error');return;}
  if(e.value.trim()==='demo@intvac.cl'&&p.value.trim()==='demo123')S.setUser({name:'Ana García',email:'demo@intvac.cl'});else S.setUser({name:'Usuario',email:e.value.trim()});
  Toast('Inicio de sesión','Bienvenido a INTVAC','success');nav('dashboard');
}
function doRegister(){
  var n=$('auth-name'),e=$('auth-email'),p=$('auth-pass'),p2=$('auth-pass2');
  if(!n||!n.value.trim()){Toast('Error','Ingresa tu nombre.','error');return;}
  if(!e||!e.value.trim()){Toast('Error','Ingresa tu correo.','error');return;}
  if(!p||!p.value.trim()){Toast('Error','Ingresa una contraseña.','error');return;}
  if(p2&&p.value!==p2.value){Toast('Error','Las contraseñas no coinciden.','error');return;}
  S.setUser({name:n.value.trim(),email:e.value.trim()});Toast('Registro exitoso','Bienvenido '+n.value.trim(),'success');nav('dashboard');
}
function doLogout(){S.setUser(null);S.setCDoc(null);S.setStep(0);_upFile=null;_upDataUrl=null;var l=$('intvac-landing'),a=$('intvac-auth'),d=$('intvac-dashboard');if(l){l.classList.remove('intvac-hidden');l.style.display='block';}if(a){a.classList.add('intvac-hidden');a.style.display='none';}if(d){d.classList.add('intvac-hidden');d.style.display='none';}}

function doProc(){
  if(!_upFile){Toast('Error',T('uploadFirst'),'error');return;}
  var cy=$('icountry')||$('upload-country'),lg=$('ilang')||$('upload-lang'),country=cy?cy.value:'CL',lang=lg?lg.value:'spa';
  var doc=S.addDoc({fileName:_upFile.name,fileType:_upFile.type,country:country,lang:lang});S.setCDoc(doc);S.setStep(0);
  if(_upFile.type.startsWith('image/')&&_upDataUrl){
    doc.status='processing';S.save();
    doOCRImage(_upFile,lang,function(text,confidence){
      if(!text){Toast('OCR','Usando modo simulado. '+confidence,'warning');text='[OCR Simulado]\n\nNombre: No detectado\n\nVacunas detectadas:\n- BCG\n- Hepatitis B\n- Hexavalente\n- Neumocócica\n';}
      S.upd(doc.id,{ocrText:text,ocrConfidence:confidence||0,status:'ocr_done'});S.setStep(1);
      var ir=interpret(text);S.upd(doc.id,{interp:ir.vaccines,patient:ir.patient,status:'interpreted'});
      var mapped=(ir.vaccines||[]).map(function(x){var pn=PNI.find(function(p){return p.code===x.pniCode;})||{};return{sourceName:x.sourceName,pniCode:x.pniCode,pniName:x.pniName,confidence:x.confidence,type:x.type,pniFull:pn.full||x.pniName};});
      S.upd(doc.id,{mapped:mapped,comp:comparePNI(mapped),status:'completed'});S.setStep(4);_upFile=null;_upDataUrl=null;
      Toast('Completado','Carné procesado. '+(ir.vaccines.length)+' vacunas detectadas.','success');rPipeline();
    });
  }else{
    var simT='[OCR Simulado - PDF]\n\nNombre: Carlos Silva Oliveira\nFecha de nacimiento: 15/03/2021\nEdad: 4 años\n\nVacunas:\nBCG - Dosis única\nHepatitis B - Dosis única\nHexavalente - 2 dosis\nNeumocócica Prevenar 13\nRotavirus Rotarix\nMeningocócica C\nSRP (Triple Viral)\nVaricela\nHepatitis A\nInfluenza 2025\nCOVID-19 Pfizer (2 dosis)\n';
    S.upd(doc.id,{ocrText:simT,ocrConfidence:0,status:'ocr_done'});var ir=interpret(simT);
    S.upd(doc.id,{interp:ir.vaccines,patient:ir.patient||{name:'Carlos Silva Oliveira',dateOfBirth:'15/03/2021',age:4}});
    var mapped=(ir.vaccines||[]).map(function(x){var pn=PNI.find(function(p){return p.code===x.pniCode;})||{};return{sourceName:x.sourceName,pniCode:x.pniCode,pniName:x.pniName,confidence:x.confidence,type:x.type,pniFull:pn.full||x.pniName};});
    S.upd(doc.id,{mapped:mapped,comp:comparePNI(mapped),status:'completed'});S.setStep(4);_upFile=null;_upDataUrl=null;
    Toast('Completado','Carné procesado (PDF modo simulado).','success');rPipeline();
  }
}

function doInterp(){var doc=S.cdoc();if(!doc)return;var ir=interpret(doc.ocrText||'');S.upd(doc.id,{interp:ir.vaccines,patient:ir.patient,status:'interpreted'});S.setStep(2);rPipeline();Toast('Interpretación lista',ir.vaccines.length+' vacunas detectadas.','success');}
function doMap(){var doc=S.cdoc();if(!doc)return;var v=doc.interp||[],mapped=v.map(function(x){var pn=PNI.find(function(p){return p.code===x.pniCode;})||{};return{sourceName:x.sourceName,pniCode:x.pniCode,pniName:x.pniName,confidence:x.confidence,type:x.type,pniFull:pn.full||x.pniName};});S.upd(doc.id,{mapped:mapped,comp:comparePNI(mapped),status:'completed'});S.setStep(3);rPipeline();Toast('Mapeo completado','','success');}

function loadDemo(){
  var txt='CERTIFICADO DE VACUNACIÓN\nMinisterio de Salud de Brasil\nNombre del paciente: Carlos Silva Oliveira\nFecha de nacimiento: 15/03/2021\nEdad: 4 años\n\nVACUNAS RECIBIDAS:\n------------------\nBCG - Dosis única - 16/03/2021\nHepatitis B - Dosis única - 16/03/2021\nHexavalente - 1ra dosis - 15/05/2021\nHexavalente - 2da dosis - 15/07/2021\nHexavalente - 3ra dosis - 15/09/2021\nNeumocócica (Prevenar 13) - 1ra dosis - 15/05/2021\nNeumocócica (Prevenar 13) - 2da dosis - 15/07/2021\nRotavirus (Rotarix) - 1ra dosis - 15/05/2021\nRotavirus (Rotarix) - 2da dosis - 15/07/2021\nMeningocócica C - 1ra dosis - 15/03/2022\nSRP (Triple Viral) - 1ra dosis - 15/03/2022\nVaricela - Dosis única - 15/09/2022\nHepatitis A - Dosis única - 15/09/2022\nInfluenza - Campaña 2025 - 01/04/2025\nCOVID-19 (Pfizer) - 1ra dosis - 10/07/2022\nCOVID-19 (Pfizer) - 2da dosis - 10/08/2022\n';
  var doc=S.addDoc({fileName:'demo-vacunacion-brasil.txt',fileType:'text/plain',country:'BR',lang:'por',status:'processing',ocrText:txt,ocrConfidence:100});
  S.setCDoc(doc);var ir=interpret(txt);
  S.upd(doc.id,{interp:ir.vaccines,patient:ir.patient||{name:'Carlos Silva Oliveira',dateOfBirth:'15/03/2021',age:4}});
  var mapped=(ir.vaccines||[]).map(function(x){var pn=PNI.find(function(p){return p.code===x.pniCode;})||{};return{sourceName:x.sourceName,pniCode:x.pniCode,pniName:x.pniName,confidence:x.confidence,type:x.type,pniFull:pn.full||x.pniName};});
  S.upd(doc.id,{mapped:mapped,comp:comparePNI(mapped),status:'completed'});S.setStep(4);_upFile=null;_upDataUrl=null;
  Toast('Carné Demo','Procesado: '+ir.vaccines.length+' vacunas. Revisa el reporte.','success');rPipeline();
}
function vDoc(id){var d=S.doc(id);if(!d){Toast('Error','No encontrado.','error');return;}S.setCDoc(d);if(d.status==='completed')S.setStep(4);else if(d.mapped)S.setStep(3);else if(d.interp)S.setStep(2);else if(d.ocrText)S.setStep(1);else S.setStep(0);_upFile=null;_upDataUrl=null;rPipeline();}
function delDoc(id){if(!confirm('¿Eliminar?'))return;S.remove(id);rHistory();Toast('Eliminado','','success');}
function newDoc(){S.setCDoc(null);S.setStep(0);_upFile=null;_upDataUrl=null;rUpload();}
function clearAll(){if(!confirm(T('clearConfirm')))return;S.clear();  _upFile=null;_upDataUrl=null;var l=$('intvac-landing'),a=$('intvac-auth'),d=$('intvac-dashboard');if(l){l.classList.remove('intvac-hidden');l.style.display='block';}if(a){a.classList.add('intvac-hidden');a.style.display='none';}if(d){d.classList.add('intvac-hidden');d.style.display='none';}Toast('Limpio','','warning');}
function printReport(){var r=$('printr');if(!r)return;var w=window.open('','_blank','width=900,height=700');w.document.write('<!DOCTYPE html><html><head><title>INTVAC</title><style>body{font:16px system-ui;padding:30px;color:#1a1a2e}.intvac-report{max-width:800px;margin:0 auto}h2{font-size:20px;color:#0033A0}.intvac-report-header{text-align:center;border-bottom:2px solid #0033A0;padding-bottom:20px;margin-bottom:24px}.intvac-report-subtitle{font-size:13px;color:#718096}.intvac-report-section{margin-bottom:20px}h3{font-size:15px;color:#0033A0;border-bottom:1px solid #e2e8f0;padding-bottom:6px}.intvac-report-row{display:flex;justify-content:space-between;padding:6px 0;font-size:13px;border-bottom:1px solid #f3f4f6}.intvac-report-label{color:#718096}.intvac-report-value{font-weight:500}table{width:100%;border-collapse:collapse;font-size:12px}th{padding:8px;text-align:left;font-weight:600;background:#f9fafb;border-bottom:2px solid #e2e8f0}td{padding:8px;border-bottom:1px solid #f3f4f6}.badge{display:inline-block;padding:2px 8px;border-radius:12px;font-size:11px}.badge-success{background:#dcfce7;color:#15803d}.badge-warning{background:#fef3c7;color:#b45309}.badge-error{background:#fee2e2;color:#b91c1c}ul{margin:0;padding-left:20px}li{margin-bottom:8px}</style></head><body>'+r.outerHTML+'</body></html>');w.document.close();setTimeout(function(){w.print();},500);}

/* ═══ EVENT DELEGATION ═══ */
document.addEventListener('click',function(e){
  var el=e.target;
  while(el&&el!==document.body){
    var a=el.getAttribute('data-action');if(!a){el=el.parentElement;continue;}
    if(a==='showLogin'){rAuth('login');return;}if(a==='showRegister'){rAuth('register');return;}
    if(a==='doLogin'){doLogin();return;}if(a==='doRegister'){doRegister();return;}
    if(a==='logout'){doLogout();return;}if(a==='doProc'){doProc();return;}
    if(a==='loadDemo'){loadDemo();return;}if(a==='doInterp'){doInterp();return;}
    if(a==='doMap'){doMap();return;}if(a==='printReport'){printReport();return;}
    if(a==='newDoc'){newDoc();return;}if(a==='clearAll'){clearAll();return;}
    if(a.indexOf('nav-')===0){nav(a.replace('nav-',''));return;}
    if(a.indexOf('goStep-')===0){goStep(parseInt(a.split('-')[1]));return;}
    if(a.indexOf('viewDoc-')===0){vDoc(a.replace('viewDoc-',''));return;}
    if(a.indexOf('deleteDoc-')===0){delDoc(a.replace('deleteDoc-',''));return;}
    el=el.parentElement;
  }
});
document.addEventListener('change',function(e){var t=e.target;if(t.id==='slang'){S.setLang(t.value);rSettings();}});
document.addEventListener('keydown',function(e){if(e.key==='Enter'){var af=$('auth-email');if(af&&$('intvac-auth')&&!$('intvac-auth').classList.contains('intvac-hidden')){if($('auth-pass2'))doRegister();else doLogin();}}});

/* ═══ INIT ═══ */
(function loop(n){n=n||0;var r=$('intvac-root');if(!r){if(n<200)setTimeout(function(){loop(n+1);},50);return;}
  var ls=$('intvac-lang-select');
  if(ls){ls.value=S.lang();ls.addEventListener('change',function(){S.setLang(this.value);if(S.user())nav('dashboard');});}
  var btns=r.querySelectorAll('[data-action]');
  for(var i=0;i<btns.length;i++){(function(b){var a=b.getAttribute('data-action');if(a==='showLogin')b.onclick=function(e){e.preventDefault();rAuth('login');};else if(a==='showRegister')b.onclick=function(e){e.preventDefault();rAuth('register');};})(btns[i]);}
  var u=S.user(),cd=S.cdoc();
  if(u&&cd)rPipeline();
  else if(u)nav('dashboard');
  else{var l=$('intvac-landing');if(l){l.classList.remove('intvac-hidden');l.style.display='block';}}
})();

})();
</script><script>/* =========================================================
   EPRO INSIGHT — VISOR DE ERRORES PROGRAMÁTICOS EN INMUNIZACIÓN
   JavaScript institucional para WordPress + Divi + WPCode
   Versión: 1.2
   Autoría funcional: PNI / MINSAL

   IMPORTANTE — PRIVACIDAD:
   Este script NO visualiza ni exporta campos personales o identificatorios.
   Se excluyen explícitamente: nombre, iniciales, RUT/RUN, número de identificación,
   fecha de nacimiento, folio, dirección, teléfono, correo e identificadores internos.

   INSTRUCCIÓN DE USO:
   1) Subir el Excel anonimizado/base EPRO a la Biblioteca de Medios de WordPress.
   2) Copiar la URL pública del archivo .xlsx o .csv.
   3) Este archivo ya viene configurado con la URL pública del Excel en WordPress.
   4) Pegar este JS en WPCode o en el espacio destinado a JavaScript.

   Requiere conexión para cargar SheetJS y Plotly desde CDN.
   ========================================================= */

(function () {
  "use strict";

  /* =========================================================
     1. CONFIGURACIÓN GENERAL
     ========================================================= */

  const EPRO_DATA_URL = window.EPRO_DATA_URL || "https://vacunas.minsal.cl/wp-content/uploads/2026/07/EPRO-ENE-ABR-2026-2025.xlsx";
  const EPRO_GEOJSON_URLS = window.EPRO_GEOJSON_URLS || [
    window.EPRO_GEOJSON_URL || "https://raw.githubusercontent.com/caracena/chile-geojson/master/regiones.json",
    "https://cdn.jsdelivr.net/gh/caracena/chile-geojson@master/regiones.json"
  ];

  const CDN = {
    xlsx: "https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js",
    plotly: "https://cdn.plot.ly/plotly-2.35.2.min.js",
    leafletCss: "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css",
    leafletJs: "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
  };

  const APP = {
    raw: [],
    data: [],
    filtered: [],
    currentPage: 1,
    rowsPerPage: 20,
    search: "",
    filters: {},
    loaded: false,
    geojson: null,
    geojsonReady: false,
    leafletMap: null,
    leafletLayer: null,
    leafletSelectedLayer: null,
    leafletPromise: null,
    leafletBounds: null
  };

  const PRIVATE_PATTERNS = [
    /rut/i,
    /run/i,
    /identific/i,
    /nacimiento/i,
    /nombre/i,
    /inicial/i,
    /folio/i,
    /direcci/i,
    /telefono/i,
    /teléfono/i,
    /correo/i,
    /email/i,
    /mail/i,
    /usuario/i,
    /paciente/i
  ];

  const MONTHS = {
    "enero": 1,
    "febrero": 2,
    "marzo": 3,
    "abril": 4,
    "mayo": 5,
    "junio": 6,
    "julio": 7,
    "agosto": 8,
    "septiembre": 9,
    "setiembre": 9,
    "octubre": 10,
    "noviembre": 11,
    "diciembre": 12
  };

  const MONTH_NAMES = [
    "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
    "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"
  ];

  const REGION_ORDER = [
    "Arica y Parinacota",
    "Tarapacá",
    "Antofagasta",
    "Atacama",
    "Coquimbo",
    "Valparaíso",
    "Metropolitana de Santiago",
    "O'Higgins",
    "Maule",
    "Ñuble",
    "Biobío",
    "La Araucanía",
    "Los Ríos",
    "Los Lagos",
    "Aysén",
    "Magallanes"
  ];

  const COLORS = {
    primary: "#0b3a75",
    secondary: "#1464a5",
    accent: "#00a3e0",
    soft: "#eaf4fb",
    danger: "#b42318",
    warning: "#b54708",
    success: "#067647",
    gray: "#667085"
  };

  /* =========================================================
     2. UTILIDADES DOM Y FORMATO
     ========================================================= */

  const $ = (selector) => document.querySelector(selector);
  const $$ = (selector) => Array.from(document.querySelectorAll(selector));

  function setText(id, value) {
    const el = document.getElementById(id);
    if (el) el.textContent = value;
  }

  function setHTML(id, value) {
    const el = document.getElementById(id);
    if (el) el.innerHTML = value;
  }

  function formatNumber(value) {
    const n = Number(value || 0);
    return n.toLocaleString("es-CL");
  }

  function formatPercent(value, decimals = 1) {
    if (!Number.isFinite(value)) return "—";
    return `${value.toLocaleString("es-CL", { minimumFractionDigits: decimals, maximumFractionDigits: decimals })}%`;
  }

  function cleanText(value) {
    if (value === null || value === undefined) return "";
    return String(value)
      .replace(/\s+/g, " ")
      .replace(/\u00a0/g, " ")
      .trim();
  }

  function normalizeKey(value) {
    return cleanText(value)
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9]+/g, " ")
      .trim();
  }

  function titleCase(value) {
    const txt = cleanText(value).toLowerCase();
    if (!txt) return "Sin información";
    return txt.replace(/\b\p{L}/gu, c => c.toUpperCase())
      .replace(/\bDe\b/g, "de")
      .replace(/\bDel\b/g, "del")
      .replace(/\bLa\b/g, "La")
      .replace(/\bLos\b/g, "Los")
      .replace(/\bY\b/g, "y");
  }

  function canonicalRegion(value) {
    const raw = cleanText(value);
    if (!raw) return "Sin información";

    /*
      Normalización territorial robusta.
      La base mezcla nomenclaturas 2025 y 2026, por ejemplo:
      - "Maule" / "del Maule"
      - "Metropolitana" / "Metropolitana de Santiago"
      - "Biobío" / "del BioBío"
      - "Aysén" / "de Aisén del Gral. Carlos Ibañez Del Campo"
      Además, el GeoJSON puede traer nombres oficiales con "Región de/del...".
    */
    let key = normalizeKey(raw)
      .replace(/\bregion\b/g, " ")
      .replace(/\bde\b/g, " ")
      .replace(/\bdel\b/g, " ")
      .replace(/\bla\b/g, " ")
      .replace(/\blos\b/g, " los ")
      .replace(/\by\b/g, " y ")
      .replace(/\s+/g, " ")
      .trim();

    const aliases = [
      { test: /arica.*parinacota/, name: "Arica y Parinacota" },
      { test: /tarapaca/, name: "Tarapacá" },
      { test: /antofagasta/, name: "Antofagasta" },
      { test: /atacama/, name: "Atacama" },
      { test: /coquimbo/, name: "Coquimbo" },
      { test: /valparaiso/, name: "Valparaíso" },
      { test: /metropolitana|santiago/, name: "Metropolitana de Santiago" },
      { test: /ohiggins|o higgins|bernardo o higgins|libertador/, name: "O'Higgins" },
      { test: /maule/, name: "Maule" },
      { test: /nuble|ñuble/, name: "Ñuble" },
      { test: /biobio|bio bio|bio/, name: "Biobío" },
      { test: /araucania/, name: "La Araucanía" },
      { test: /los rios|rios/, name: "Los Ríos" },
      { test: /los lagos|lagos/, name: "Los Lagos" },
      { test: /aisen|aysen|ibanez|ibáñez/, name: "Aysén" },
      { test: /magallanes|antartica|antártica/, name: "Magallanes" }
    ];

    const hit = aliases.find(item => item.test.test(key));
    if (hit) return hit.name;

    const pretty = titleCase(raw)
      .replace(/^Región\s+(de|del|la|los)?\s*/i, "")
      .replace(/^(de|del|la|los)\s+/i, "");

    const found = REGION_ORDER.find(r => normalizeKey(r) === normalizeKey(pretty));
    return found || pretty || "Sin información";
  }

  function parseDate(value) {
    if (!value) return null;
    if (value instanceof Date && !isNaN(value)) return value;

    if (typeof value === "number") {
      try {
        const parsed = XLSX.SSF.parse_date_code(value);
        if (parsed) return new Date(parsed.y, parsed.m - 1, parsed.d);
      } catch (e) { return null; }
    }

    const txt = cleanText(value);
    const match = txt.match(/^(\d{1,2})[-\/](\d{1,2})[-\/](\d{2,4})$/);
    if (match) {
      const day = Number(match[1]);
      const month = Number(match[2]) - 1;
      let year = Number(match[3]);
      if (year < 100) year += 2000;
      const d = new Date(year, month, day);
      return isNaN(d) ? null : d;
    }

    const d = new Date(txt);
    return isNaN(d) ? null : d;
  }

  function dateDiffDays(start, end) {
    if (!start || !end) return null;
    const ms = end.getTime() - start.getTime();
    return Math.round(ms / 86400000);
  }

  function getMonthNameFromDate(date) {
    if (!date) return "Sin información";
    return MONTH_NAMES[date.getMonth()];
  }

  function getMonthNumber(value, fallbackDate) {
    const txt = normalizeKey(value);
    if (MONTHS[txt]) return MONTHS[txt];
    if (fallbackDate) return fallbackDate.getMonth() + 1;
    return 99;
  }

  function loadScript(src) {
    return new Promise((resolve, reject) => {
      if (src.includes("xlsx") && window.XLSX) return resolve();
      if (src.includes("plotly") && window.Plotly) return resolve();
      if (src.includes("leaflet") && window.L && window.L.geoJSON) return resolve();

      const existing = Array.from(document.scripts).find(s => s.src === src || s.getAttribute("data-epro-src") === src);
      if (existing) {
        existing.addEventListener("load", resolve, { once: true });
        existing.addEventListener("error", reject, { once: true });
        if (src.includes("leaflet") && window.L && window.L.geoJSON) resolve();
        return;
      }

      const script = document.createElement("script");
      script.src = src;
      script.async = true;
      script.defer = true;
      script.setAttribute("data-epro-src", src);
      script.onload = resolve;
      script.onerror = reject;
      document.head.appendChild(script);
    });
  }

  function loadStyle(href) {
    return new Promise(resolve => {
      if (document.querySelector(`link[href="${href}"]`)) return resolve();
      const link = document.createElement("link");
      link.rel = "stylesheet";
      link.href = href;
      link.onload = resolve;
      link.onerror = resolve;
      document.head.appendChild(link);
    });
  }

  async function ensureLeaflet() {
    if (window.L && window.L.geoJSON) return;
    if (APP.leafletPromise) return APP.leafletPromise;
    APP.leafletPromise = Promise.all([
      loadStyle(CDN.leafletCss),
      loadScript(CDN.leafletJs)
    ]).then(() => {
      if (!window.L || !window.L.geoJSON) throw new Error("Leaflet no quedó disponible.");
    });
    return APP.leafletPromise;
  }

  function isPrivateColumn(header) {
    return PRIVATE_PATTERNS.some(pattern => pattern.test(String(header || "")));
  }

  function safeCell(row, candidates) {
    for (const key of candidates) {
      if (Object.prototype.hasOwnProperty.call(row, key)) {
        const value = row[key];
        if (value !== null && value !== undefined && cleanText(value) !== "") return value;
      }
    }
    return "";
  }

  function unique(arr) {
    return Array.from(new Set(arr.filter(v => cleanText(v) !== "")));
  }

  function countBy(data, field) {
    const map = new Map();
    data.forEach(row => {
      const key = cleanText(row[field]) || "Sin información";
      map.set(key, (map.get(key) || 0) + 1);
    });
    return Array.from(map, ([name, value]) => ({ name, value }))
      .sort((a, b) => b.value - a.value || a.name.localeCompare(b.name, "es"));
  }

  function pct(part, total) {
    return total ? (part / total) * 100 : 0;
  }

  function median(values) {
    const nums = values.filter(Number.isFinite).sort((a, b) => a - b);
    if (!nums.length) return null;
    const mid = Math.floor(nums.length / 2);
    return nums.length % 2 ? nums[mid] : (nums[mid - 1] + nums[mid]) / 2;
  }

  /* =========================================================
     3. CARGA Y NORMALIZACIÓN DE BASE
     ========================================================= */

  async function loadData() {
    updateStatus("Cargando librerías de análisis...", true);
    await Promise.all([loadScript(CDN.xlsx), loadScript(CDN.plotly)]);

    if (!EPRO_DATA_URL) {
      updateStatus("Configura EPRO_DATA_URL con la URL pública del Excel o CSV.", false);
      renderEmptyAll();
      return;
    }

    updateStatus("Cargando base EPRO...", true);

    const dataUrl = EPRO_DATA_URL + (EPRO_DATA_URL.includes("?") ? "&" : "?") + "nocache=" + Date.now();
    const response = await fetch(dataUrl, { cache: "no-store" });
    if (!response.ok) throw new Error(`No se pudo cargar la base: ${response.status}`);

    const buffer = await response.arrayBuffer();
    const workbook = XLSX.read(buffer, { type: "array", cellDates: true });

    const rows = [];
    workbook.SheetNames.forEach(sheetName => {
      const sheet = workbook.Sheets[sheetName];
      const json = XLSX.utils.sheet_to_json(sheet, { defval: "", raw: false });
      json.forEach(row => rows.push({ __sheet: sheetName, ...row }));
    });

    APP.raw = rows;
    APP.data = rows.map(normalizeRow).filter(Boolean);
    APP.filtered = [...APP.data];
    APP.loaded = true;
    await loadGeoJSON();

    updateStatus(`Base cargada: ${formatNumber(APP.data.length)} registros anonimizados`, false);
    initFilters();
    applyFilters();
  }


  async function loadGeoJSON() {
    const urls = Array.isArray(EPRO_GEOJSON_URLS) ? EPRO_GEOJSON_URLS.filter(Boolean) : [];
    let lastError = null;

    for (const baseUrl of urls) {
      try {
        const url = baseUrl + (baseUrl.includes("?") ? "&" : "?") + "nocache=" + Date.now();
        const response = await fetch(url, { cache: "no-store" });
        if (!response.ok) throw new Error(`GeoJSON ${response.status}`);
        const geojson = await response.json();
        if (!geojson || !Array.isArray(geojson.features)) throw new Error("GeoJSON sin features");

        geojson.features.forEach(feature => {
          const props = feature.properties || {};
          const rawName = props._epro_region || props.Region || props.REGION || props.region || props.NOMBRE_REG || props.NOM_REG || props.nom_reg || props.name || props.nombre || props.NOMBRE || props.NAME || props.region_name || props.RegionName || "";
          props._epro_region = canonicalRegion(rawName);
          feature.properties = props;
        });

        APP.geojson = geojson;
        APP.geojsonReady = true;
        return;
      } catch (error) {
        lastError = error;
      }
    }

    console.warn("EPRO Insight: no se pudo cargar GeoJSON, se usará mapa esquemático.", lastError);
    APP.geojson = null;
    APP.geojsonReady = false;
  }

  function normalizeRow(row) {
    const yearFromSheet = Number(String(row.__sheet || "").match(/20\d{2}/)?.[0]) || null;

    const fechaNotif = parseDate(safeCell(row, [
      "FECHA NOTIFICACIÓN",
      "FECHA DE NOTIFICACIÓN",
      "Fecha notificación",
      "FECHA DE RECEPCIÓN"
    ]));

    const fechaVac = parseDate(safeCell(row, [
      "FECHA DE VACUNACIÓN",
      "FECHA VACUNACIÓN",
      "Fecha vacunación"
    ]));

    const mesRaw = safeCell(row, ["Mes de notificación", "Mes de notiricación", "MES", "Mes"]);
    const mesNumero = getMonthNumber(mesRaw, fechaNotif);
    const mes = mesNumero >= 1 && mesNumero <= 12 ? MONTH_NAMES[mesNumero - 1] : getMonthNameFromDate(fechaNotif);

    const year = yearFromSheet || (fechaNotif ? fechaNotif.getFullYear() : "Sin información");

    const region = canonicalRegion(safeCell(row, ["REGIÓN", "REGION", "Región"]));
    const comuna = titleCase(safeCell(row, [
      "COMUNA ESTABLECIMIENTO",
      "COMUNA ESTABLECIMIENTO NOTIFICADOR",
      "COMUNA",
      "Comuna"
    ]));

    const establecimiento = titleCase(safeCell(row, [
      "ESTABLECIMIENTO NOTIFICADOR",
      "Establecimiento notificador"
    ]));

    const tipoEpro = cleanText(safeCell(row, [
      "TIPO DE ERROR PROGRAMATICO",
      "TIPO DE ERROR PROGRAMÁTICO",
      "TIPO DE EPRO",
      "Tipo de EPRO"
    ])) || "Sin información";

    const vacuna = cleanText(safeCell(row, [
      "VACUNA",
      "TIPO DE VACUNA",
      "Tipo de vacuna"
    ])).toUpperCase() || "Sin información";

    const lote = cleanText(safeCell(row, ["LOTE", "Lote"])).toUpperCase() || "Sin información";
    const dosis = cleanText(safeCell(row, ["DOSIS", "Dosis"])) || "Sin información";
    const grupoEtario = cleanText(safeCell(row, ["Grupo Etario", "GRUPO ETARIO", "Grupo etario"])) || "Sin información";
    const sexo = titleCase(safeCell(row, ["SEXO", "Sexo"])) || "Sin información";

    const manifestaciones = normalizeYesNo(safeCell(row, [
      "¿MANIFESTACIONES POST-VACUNACIÓN?",
      "TUVO MANIFESTACIONES",
      "Manifestaciones posteriores"
    ]));

    const esavi = normalizeYesNo(safeCell(row, [
      "¿SE NOTIFICÓ COMO ESAVI?",
      "¿SE NOTIFICÓ ESAVI?",
      "ESAVI"
    ]));

    const sector = titleCase(safeCell(row, ["Publico-Privado", "Público-Privado", "Sector"])) || "Sin información";
    const magnitud = cleanText(safeCell(row, ["Masivo", "MAGNITUD", "Magnitud"]));
    const masivo = normalizeMasivo(magnitud);
    const diasNotificacion = dateDiffDays(fechaVac, fechaNotif);

    return {
      anio: String(year),
      mes,
      mesNumero,
      region,
      comuna,
      establecimiento,
      vacuna,
      lote,
      tipoEpro,
      grupoEtario,
      sexo,
      dosis,
      esavi,
      manifestaciones,
      sector,
      masivo,
      fechaNotificacion: fechaNotif,
      fechaVacunacion: fechaVac,
      diasNotificacion,
      searchText: normalizeKey([
        year, mes, region, comuna, establecimiento, vacuna, lote, tipoEpro,
        grupoEtario, sexo, dosis, esavi, manifestaciones, sector, masivo
      ].join(" "))
    };
  }

  function normalizeYesNo(value) {
    const txt = normalizeKey(value);
    if (!txt) return "Sin información";
    if (["si", "sí", "s", "yes", "1", "verdadero"].includes(txt)) return "Sí";
    if (["no", "n", "0", "falso"].includes(txt)) return "No";
    return titleCase(value);
  }

  function normalizeMasivo(value) {
    const txt = normalizeKey(value);
    if (!txt) return "Sin información";
    if (txt.includes("no masivo")) return "No";
    if (txt === "no") return "No";
    if (txt.includes("masivo") || txt === "si" || txt === "sí") return "Sí";
    return titleCase(value);
  }

  /* =========================================================
     4. FILTROS E INTERACCIÓN
     ========================================================= */

  const FILTERS = [
    ["filtroAnio", "anio"],
    ["filtroMes", "mes"],
    ["filtroRegion", "region"],
    ["filtroComuna", "comuna"],
    ["filtroEstablecimiento", "establecimiento"],
    ["filtroVacuna", "vacuna"],
    ["filtroTipoEpro", "tipoEpro"],
    ["filtroGrupoEtario", "grupoEtario"],
    ["filtroSexo", "sexo"],
    ["filtroDosis", "dosis"],
    ["filtroEsavi", "esavi"],
    ["filtroManifestacion", "manifestaciones"],
    ["filtroSector", "sector"],
    ["filtroMasivo", "masivo"]
  ];

  function initFilters() {
    FILTERS.forEach(([id, field]) => populateFilter(id, field));
    FILTERS.forEach(([id]) => {
      const el = document.getElementById(id);
      if (el) el.addEventListener("change", applyFilters);
    });
  }

  function populateFilter(id, field) {
    const el = document.getElementById(id);
    if (!el) return;

    const current = el.value;
    let values = unique(APP.data.map(row => row[field]));

    if (field === "region") {
      values.sort((a, b) => REGION_ORDER.indexOf(a) - REGION_ORDER.indexOf(b));
      values = values.filter(v => v && v !== "Sin información").concat(values.filter(v => v === "Sin información"));
    } else if (field === "mes") {
      values.sort((a, b) => MONTH_NAMES.indexOf(a) - MONTH_NAMES.indexOf(b));
    } else if (field === "anio") {
      values.sort((a, b) => Number(b) - Number(a));
    } else {
      values.sort((a, b) => a.localeCompare(b, "es"));
    }

    const defaultText = el.querySelector("option")?.textContent || "Todos";
    el.innerHTML = `<option value="">${defaultText}</option>` + values.map(v => `<option value="${escapeAttr(v)}">${escapeHTML(v)}</option>`).join("");
    if (values.includes(current)) el.value = current;
  }

  function applyFilters() {
    APP.filters = {};
    FILTERS.forEach(([id, field]) => {
      const el = document.getElementById(id);
      if (el && el.value) APP.filters[field] = el.value;
    });

    const searchValue = normalizeKey(APP.search || "");

    APP.filtered = APP.data.filter(row => {
      for (const [field, value] of Object.entries(APP.filters)) {
        if (String(row[field]) !== String(value)) return false;
      }
      if (searchValue && !row.searchText.includes(searchValue)) return false;
      return true;
    });

    APP.currentPage = 1;
    refreshAll();
  }

  function resetFilters() {
    FILTERS.forEach(([id]) => {
      const el = document.getElementById(id);
      if (el) el.value = "";
    });
    const search = document.getElementById("eproBuscarTabla");
    if (search) search.value = "";
    APP.search = "";
    applyFilters();
  }

  function bindEvents() {
    ["eproBtnReset", "eproLimpiarFiltros"].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.addEventListener("click", resetFilters);
    });

    const aplicar = document.getElementById("eproAplicarFiltros");
    if (aplicar) aplicar.addEventListener("click", applyFilters);

    const buscar = document.getElementById("eproBuscarTabla");
    if (buscar) {
      buscar.addEventListener("input", debounce((e) => {
        APP.search = e.target.value;
        applyFilters();
      }, 200));
    }

    const prev = document.getElementById("eproPaginaAnterior");
    const next = document.getElementById("eproPaginaSiguiente");
    if (prev) prev.addEventListener("click", () => changePage(-1));
    if (next) next.addEventListener("click", () => changePage(1));

    const exportBtn = document.getElementById("eproBtnExport");
    const exportTableBtn = document.getElementById("eproDescargarTabla");
    if (exportBtn) exportBtn.addEventListener("click", exportFilteredCSV);
    if (exportTableBtn) exportTableBtn.addEventListener("click", exportFilteredCSV);

    const full = document.getElementById("eproBtnFullscreen");
    if (full) full.addEventListener("click", togglePresentation);

    const toggle = document.getElementById("eproToggleSidebar");
    if (toggle) toggle.addEventListener("click", () => {
      document.getElementById("eproInsightApp")?.classList.toggle("epro-sidebar-collapsed");
    });
  }

  function debounce(fn, wait) {
    let t;
    return (...args) => {
      clearTimeout(t);
      t = setTimeout(() => fn(...args), wait);
    };
  }

  function changePage(delta) {
    const totalPages = Math.max(1, Math.ceil(APP.filtered.length / APP.rowsPerPage));
    APP.currentPage = Math.min(totalPages, Math.max(1, APP.currentPage + delta));
  }

  function togglePresentation() {
    const app = document.getElementById("eproInsightApp");
    if (!app) return;
    app.classList.toggle("epro-presentation-mode");

    if (document.fullscreenElement) {
      document.exitFullscreen?.();
    } else {
      app.requestFullscreen?.().catch(() => {});
    }
  }

  /* =========================================================
     5. RENDER GENERAL
     ========================================================= */

  function refreshAll() {
    renderKPIs();
    renderSummary();
    renderAlerts();
    renderCharts();
    renderRankings();
    renderMapGeoJSON();
  }

  function renderEmptyAll() {
    renderKPIs();
    renderSummary();
    renderAlerts();
  }

  function updateStatus(message, loading) {
    setText("eproEstadoCarga", message);
    const dot = document.querySelector(".epro-status-dot");
    if (dot) dot.classList.toggle("is-loading", !!loading);
  }

  /* =========================================================
     6. KPIs Y RESUMEN INTELIGENTE
     ========================================================= */

  function renderKPIs() {
    const data = APP.filtered || [];
    const total = data.length;
    const y2025 = data.filter(r => r.anio === "2025").length;
    const y2026 = data.filter(r => r.anio === "2026").length;
    const variacion = y2025 ? ((y2026 - y2025) / y2025) * 100 : null;

    const esaviSi = data.filter(r => r.esavi === "Sí").length;
    const maniSi = data.filter(r => r.manifestaciones === "Sí").length;
    const dias = data.map(r => r.diasNotificacion).filter(v => Number.isFinite(v) && v >= 0);
    const promedioDias = dias.length ? dias.reduce((a, b) => a + b, 0) / dias.length : null;

    setText("kpiTotalEpro", formatNumber(total));
    setText("kpiTotalEproSub", total === APP.data.length ? "Total base cargada" : "Registros filtrados");
    setText("kpiVariacion", variacion === null ? "—" : `${variacion >= 0 ? "+" : ""}${formatPercent(variacion, 1)}`);
    setText("kpiRegiones", formatNumber(unique(data.map(r => r.region)).length));
    setText("kpiEstablecimientos", formatNumber(unique(data.map(r => r.establecimiento)).length));
    setText("kpiVacunas", formatNumber(unique(data.map(r => r.vacuna)).length));
    setText("kpiEsavi", total ? formatPercent(pct(esaviSi, total), 1) : "—");
    setText("kpiManifestaciones", total ? formatPercent(pct(maniSi, total), 1) : "—");
    setText("kpiOportunidad", promedioDias === null ? "—" : `${promedioDias.toLocaleString("es-CL", { maximumFractionDigits: 1 })} días`);

    setText("eproPeriodoHero", getPeriodLabel(data));
  }

  function getPeriodLabel(data) {
    if (!data.length) return "Sin datos cargados";
    const years = unique(data.map(r => r.anio)).sort().join("–");
    const months = unique(data.map(r => r.mes)).sort((a, b) => MONTH_NAMES.indexOf(a) - MONTH_NAMES.indexOf(b));
    if (!months.length) return years;
    return `${months[0]}–${months[months.length - 1]} ${years}`;
  }

  function renderSummary() {
    const data = APP.filtered || [];
    const total = data.length;
    if (!total) {
      setHTML("eproResumenInteligente", "Cargue la base para generar un resumen automático de los registros EPRO.");
      return;
    }

    const topRegion = countBy(data, "region")[0];
    const topVacuna = countBy(data, "vacuna")[0];
    const topTipo = countBy(data, "tipoEpro")[0];
    const topEst = countBy(data, "establecimiento")[0];
    const esaviSi = data.filter(r => r.esavi === "Sí").length;
    const maniSi = data.filter(r => r.manifestaciones === "Sí").length;
    const dias = data.map(r => r.diasNotificacion).filter(v => Number.isFinite(v) && v >= 0);
    const medianaDias = median(dias);

    const html = `
      <p>
        En la selección actual se analizan <strong>${formatNumber(total)} registros EPRO</strong>.
        La mayor concentración territorial corresponde a <strong>${escapeHTML(topRegion?.name || "Sin información")}</strong>
        (${formatNumber(topRegion?.value || 0)} registros; ${formatPercent(pct(topRegion?.value || 0, total), 1)}).
      </p>
      <p>
        La vacuna con mayor frecuencia registrada es <strong>${escapeHTML(topVacuna?.name || "Sin información")}</strong>,
        mientras que el tipo de error predominante corresponde a <strong>${escapeHTML(topTipo?.name || "Sin información")}</strong>.
        El establecimiento con mayor número de notificaciones en la vista filtrada es
        <strong>${escapeHTML(topEst?.name || "Sin información")}</strong>.
      </p>
      <p>
        En términos de seguimiento, <strong>${formatPercent(pct(esaviSi, total), 1)}</strong> de los registros se encuentran
        asociados a ESAVI y <strong>${formatPercent(pct(maniSi, total), 1)}</strong> consignan manifestaciones posteriores.
        La mediana de oportunidad entre vacunación y notificación es de
        <strong>${medianaDias === null ? "—" : medianaDias.toLocaleString("es-CL", { maximumFractionDigits: 1 }) + " días"}</strong>.
      </p>
    `;

    setHTML("eproResumenInteligente", html);
  }

  function renderAlerts() {
    const data = APP.filtered || [];
    const total = data.length;
    if (!total) {
      setText("alertaPrincipal", "Sin datos cargados.");
      setText("alertaGestion", "Sin datos cargados.");
      setText("alertaCalidad", "Sin datos cargados.");
      return;
    }

    const topRegion = countBy(data, "region")[0];
    const topTipo = countBy(data, "tipoEpro")[0];
    const diasNeg = data.filter(r => Number.isFinite(r.diasNotificacion) && r.diasNotificacion < 0).length;
    const missingCore = data.filter(r => [r.region, r.establecimiento, r.vacuna, r.tipoEpro].some(v => !v || v === "Sin información")).length;

    setText("alertaPrincipal", `${topRegion.name} concentra ${formatPercent(pct(topRegion.value, total), 1)} de los EPRO en la selección actual.`);
    setText("alertaGestion", `El tipo de EPRO más frecuente es “${topTipo.name}”, con ${formatNumber(topTipo.value)} registros.`);
    setText("alertaCalidad", `${formatNumber(missingCore)} registros presentan campos clave incompletos y ${formatNumber(diasNeg)} registros tienen fechas potencialmente inconsistentes.`);
  }

  /* =========================================================
     7. GRÁFICOS
     ========================================================= */

  function renderCharts() {
    if (!window.Plotly) return;
    const data = APP.filtered || [];
    renderEvolution(data);
    renderBar("chartTipoEpro", data, "tipoEpro", 10, "h");
    renderBar("chartVacunas", data, "vacuna", 12, "h");
    renderDonut("chartGrupoEtario", data, "grupoEtario", 8);
    renderDonut("chartSexo", data, "sexo", 6);
    renderDonut("chartDosis", data, "dosis", 8);
    renderDonut("chartEsavi", data, "esavi", 4);
    renderDonut("chartManifestaciones", data, "manifestaciones", 4);
    renderSectorMasivo(data);
  }

  function plotLayout(title = "") {
    return {
      title: { text: title, font: { size: 13 } },
      margin: { l: 12, r: 12, t: title ? 30 : 12, b: 35 },
      paper_bgcolor: "rgba(0,0,0,0)",
      plot_bgcolor: "rgba(0,0,0,0)",
      font: { family: "Inter, system-ui, sans-serif", color: "#344054" },
      showlegend: true,
      legend: { orientation: "h", y: -0.2 },
      autosize: true
    };
  }

  function plotConfig() {
    return {
      responsive: true,
      displayModeBar: false,
      locale: "es"
    };
  }

  function renderEvolution(data) {
    const el = document.getElementById("chartEvolucion");
    if (!el) return;
    if (!data.length) return emptyChart(el, "Sin datos para graficar.");

    const years = unique(data.map(r => r.anio)).sort();
    const traces = years.map(year => {
      const values = MONTH_NAMES.slice(0, 12).map((month, idx) => {
        return data.filter(r => r.anio === year && r.mesNumero === idx + 1).length;
      });
      return {
        x: MONTH_NAMES,
        y: values,
        type: "scatter",
        mode: "lines+markers",
        name: year,
        line: { width: 3 }
      };
    });

    Plotly.newPlot(el, traces, {
      ...plotLayout(),
      yaxis: { title: "EPRO", rangemode: "tozero", gridcolor: "#eef2f6" },
      xaxis: { tickangle: -25 }
    }, plotConfig());
  }

  function renderBar(id, data, field, limit = 10, orientation = "h") {
    const el = document.getElementById(id);
    if (!el) return;
    if (!data.length) return emptyChart(el, "Sin datos para graficar.");

    const rows = countBy(data, field).slice(0, limit).reverse();
    const values = rows.map(r => r.value);
    const labels = rows.map(r => r.name);
    const maxValue = Math.max(...values, 1);

    const labelAnnotations = orientation === "h"
      ? rows.map(r => ({
          x: r.value,
          y: r.name,
          text: formatNumber(r.value),
          showarrow: false,
          xanchor: "left",
          yanchor: "middle",
          xshift: 7,
          font: { size: 12, color: "#0b2f4f", family: "Inter, system-ui, sans-serif" }
        }))
      : rows.map(r => ({
          x: r.name,
          y: r.value,
          text: formatNumber(r.value),
          showarrow: false,
          xanchor: "center",
          yanchor: "bottom",
          yshift: 6,
          font: { size: 12, color: "#0b2f4f", family: "Inter, system-ui, sans-serif" }
        }));

    const trace = orientation === "h"
      ? {
          x: values,
          y: labels,
          type: "bar",
          orientation: "h",
          marker: {
            color: values.map((_, i) => i >= rows.length - 3 ? "#0b5f99" : "#2b9bd8"),
            line: { color: "#083b63", width: 0.6 }
          },
          text: values.map(v => formatNumber(v)),
          textposition: "none",
          cliponaxis: false,
          hovertemplate: "%{y}<br><b>%{x} registros</b><extra></extra>"
        }
      : {
          x: labels,
          y: values,
          type: "bar",
          marker: { color: "#2b9bd8", line: { color: "#083b63", width: 0.6 } },
          text: values.map(v => formatNumber(v)),
          textposition: "none",
          cliponaxis: false,
          hovertemplate: "%{x}<br><b>%{y} registros</b><extra></extra>"
        };

    Plotly.newPlot(el, [trace], {
      ...plotLayout(),
      margin: { l: orientation === "h" ? 210 : 48, r: 82, t: 18, b: orientation === "h" ? 34 : 96 },
      annotations: labelAnnotations,
      bargap: 0.36,
      xaxis: orientation === "h"
        ? { rangemode: "tozero", gridcolor: "#eef2f6", range: [0, maxValue * 1.28], zeroline: false }
        : { automargin: true, tickangle: -25 },
      yaxis: orientation === "h"
        ? { automargin: true, tickfont: { size: 11, color: "#34465e" } }
        : { rangemode: "tozero", gridcolor: "#eef2f6", range: [0, maxValue * 1.24], zeroline: false },
      showlegend: false
    }, plotConfig());
  }

  function renderDonut(id, data, field, limit = 8) {
    const el = document.getElementById(id);
    if (!el) return;
    if (!data.length) return emptyChart(el, "Sin datos.");

    let rows = countBy(data, field);
    if (rows.length > limit) {
      const head = rows.slice(0, limit - 1);
      const other = rows.slice(limit - 1).reduce((sum, r) => sum + r.value, 0);
      rows = [...head, { name: "Otros", value: other }];
    }

    Plotly.newPlot(el, [{
      labels: rows.map(r => r.name),
      values: rows.map(r => r.value),
      type: "pie",
      hole: 0.58,
      textinfo: "percent",
      hovertemplate: "%{label}<br>%{value} registros<br>%{percent}<extra></extra>"
    }], {
      ...plotLayout(),
      margin: { l: 10, r: 10, t: 10, b: 10 },
      legend: { orientation: "h", y: -0.15 },
    }, plotConfig());
  }

  function renderSectorMasivo(data) {
    const el = document.getElementById("chartSectorMasivo");
    if (!el) return;
    if (!data.length) return emptyChart(el, "Sin datos.");

    const sector = countBy(data, "sector").slice(0, 6);
    const masivo = countBy(data, "masivo").slice(0, 6);

    Plotly.newPlot(el, [
      { x: sector.map(r => r.name), y: sector.map(r => r.value), type: "bar", name: "Sector" },
      { x: masivo.map(r => r.name), y: masivo.map(r => r.value), type: "bar", name: "Masivo" }
    ], {
      ...plotLayout(),
      barmode: "group",
      xaxis: { tickangle: -25 },
      yaxis: { rangemode: "tozero", gridcolor: "#eef2f6" }
    }, plotConfig());
  }

  function renderHeatmap(data) {
    const el = document.getElementById("chartHeatmap");
    if (!el) return;
    if (!data.length) return emptyChart(el, "Sin datos para heatmap.");

    const types = countBy(data, "tipoEpro").slice(0, 10).map(r => r.name);
    const z = types.map(type => MONTH_NAMES.map((month, i) => data.filter(r => r.tipoEpro === type && r.mesNumero === i + 1).length));

    Plotly.newPlot(el, [{
      x: MONTH_NAMES,
      y: types,
      z,
      type: "heatmap",
      colorscale: "Blues",
      hovertemplate: "%{y}<br>%{x}: %{z} registros<extra></extra>"
    }], {
      ...plotLayout(),
      yaxis: { automargin: true },
      xaxis: { tickangle: -25 }
    }, plotConfig());
  }

  function renderSankey(data) {
    const el = document.getElementById("chartSankey");
    if (!el) return;
    if (!data.length) return emptyChart(el, "Sin datos para relaciones.");

    const topVaccines = countBy(data, "vacuna").slice(0, 5).map(r => r.name);
    const topTypes = countBy(data, "tipoEpro").slice(0, 5).map(r => r.name);
    const nodes = [...topVaccines, ...topTypes, "ESAVI: Sí", "ESAVI: No"];
    const index = new Map(nodes.map((n, i) => [n, i]));
    const links = [];

    topVaccines.forEach(vac => {
      topTypes.forEach(type => {
        const value = data.filter(r => r.vacuna === vac && r.tipoEpro === type).length;
        if (value > 0) links.push({ source: index.get(vac), target: index.get(type), value });
      });
    });

    topTypes.forEach(type => {
      ["Sí", "No"].forEach(esavi => {
        const value = data.filter(r => r.tipoEpro === type && r.esavi === esavi).length;
        if (value > 0) links.push({ source: index.get(type), target: index.get(`ESAVI: ${esavi}`), value });
      });
    });

    Plotly.newPlot(el, [{
      type: "sankey",
      orientation: "h",
      node: { label: nodes, pad: 12, thickness: 14 },
      link: {
        source: links.map(l => l.source),
        target: links.map(l => l.target),
        value: links.map(l => l.value)
      }
    }], {
      ...plotLayout(),
      margin: { l: 10, r: 10, t: 10, b: 10 }
    }, plotConfig());
  }

  function emptyChart(el, message) {
    el.innerHTML = `<div class="epro-empty-state"><span>📊</span><p>${escapeHTML(message)}</p></div>`;
  }

  /* =========================================================
     8. MAPA ESQUEMÁTICO Y RANKINGS
     ========================================================= */

  function renderRankings() {
    renderRanking("rankingRegiones", countBy(APP.filtered, "region"), true);
    renderRanking("rankingEstablecimientos", countBy(APP.filtered, "establecimiento"), false);
  }

  function renderRanking(id, rows, isRegion) {
    const el = document.getElementById(id);
    if (!el) return;
    if (!rows.length) {
      el.innerHTML = `<div class="epro-empty-state"><span>📌</span><p>Sin datos.</p></div>`;
      return;
    }

    const max = Math.max(...rows.map(r => r.value), 1);
    const top = rows.slice(0, 10);
    const medal = idx => idx === 0 ? "🥇" : idx === 1 ? "🥈" : idx === 2 ? "🥉" : `${idx + 1}`;
    const kindIcon = isRegion ? "📍" : "🏥";

    el.innerHTML = top.map((r, idx) => {
      const pct = Math.max(4, (r.value / max) * 100);
      const tier = idx < 3 ? "is-top" : "";
      return `
        <button type="button" class="epro-rank-row ${tier}" data-field="${isRegion ? "region" : "establecimiento"}" data-value="${escapeAttr(r.name)}">
          <span class="epro-rank-medal">${medal(idx)}</span>
          <span class="epro-rank-main">
            <span class="epro-rank-name"><i>${kindIcon}</i>${escapeHTML(r.name)}</span>
            <span class="epro-rank-bar"><i style="width:${pct}%"></i></span>
          </span>
          <strong class="epro-rank-value">${formatNumber(r.value)}</strong>
        </button>
      `;
    }).join("");

    el.querySelectorAll(".epro-rank-row").forEach(btn => {
      btn.addEventListener("click", () => {
        const field = btn.dataset.field;
        const value = btn.dataset.value;
        const filter = FILTERS.find(([, f]) => f === field);
        if (filter) {
          const select = document.getElementById(filter[0]);
          if (select) {
            select.value = value;
            applyFilters();
          }
        }
      });
    });
  }

  function renderMapGeoJSON() {
    const el = document.getElementById("eproMapaChile");
    if (!el) return;

    const rows = countBy(APP.filtered, "region").filter(r => r.name !== "Sin información");
    if (!rows.length) {
      el.innerHTML = `<div class="epro-empty-state"><span>🗺️</span><p>Sin datos territoriales.</p></div>`;
      return;
    }

    if (APP.geojsonReady && APP.geojson && Array.isArray(APP.geojson.features)) {
      renderLeafletMap(el, rows);
      return;
    }

    renderMapFallback(el, rows);
  }

  async function renderLeafletMap(el, rows) {
    el.innerHTML = `<div class="epro-map-loading">Cargando mapa geográfico regional…</div>`;

    try {
      await ensureLeaflet();
      if (!window.L || !APP.geojsonReady || !APP.geojson) throw new Error("Leaflet o GeoJSON no disponible.");

      const rowsByRegion = new Map(rows.map(r => [canonicalRegion(r.name), r.value]));
      const max = Math.max(...rows.map(r => r.value), 1);
      const selectedRegion = canonicalRegion(document.getElementById("filtroRegion")?.value || "");

      if (APP.leafletMap) {
        try { APP.leafletMap.remove(); } catch (e) {}
        APP.leafletMap = null;
        APP.leafletLayer = null;
        APP.leafletSelectedLayer = null;
        APP.leafletBounds = null;
      }

      el.innerHTML = `<div id="eproLeafletMap" class="epro-leaflet-map" aria-label="Mapa regional de Chile"></div>`;

      APP.leafletMap = L.map("eproLeafletMap", {
        zoomControl: true,
        attributionControl: true,
        scrollWheelZoom: false,
        dragging: true
      });

      L.control.attribution({ prefix: false })
        .addTo(APP.leafletMap)
        .addAttribution("GeoJSON público: caracena/chile-geojson");

      const filteredGeoJson = removeValparaisoRemoteIslands(APP.geojson);

      let selectedBounds = null;

      APP.leafletLayer = L.geoJSON(filteredGeoJson, {
        style: function(feature) {
          const region = featureRegion(feature);
          const value = rowsByRegion.get(region) || 0;
          const intensity = value / max;
          const isSelected = selectedRegion && selectedRegion === region;
          return {
            color: isSelected ? "#003b71" : "#ffffff",
            weight: isSelected ? 2.6 : 1.05,
            opacity: 1,
            fillColor: isSelected ? "#005ea8" : mapFill(intensity, value),
            fillOpacity: value ? 0.96 : 0.48
          };
        },
        onEachFeature: function(feature, layer) {
          const region = featureRegion(feature);
          const value = rowsByRegion.get(region) || 0;
          if (selectedRegion && selectedRegion === region && layer.getBounds) {
            const b = layer.getBounds();
            selectedBounds = selectedBounds ? selectedBounds.extend(b) : b;
            APP.leafletSelectedLayer = layer;
          }
          layer.bindTooltip(`
            <div class="epro-map-tooltip">
              <strong>${escapeHTML(region || "Sin información")}</strong>
              <span>${formatNumber(value)} EPRO</span>
            </div>
          `, { sticky: true, direction: "top", opacity: 1, className: "epro-region-tooltip-wrap" });

          layer.on("mouseover", function() { this.setStyle({ weight: 2.8, fillOpacity: 1 }); });
          layer.on("mouseout", function() {
            if (APP.leafletLayer && this !== APP.leafletSelectedLayer) APP.leafletLayer.resetStyle(this);
          });
          layer.on("click", function() {
            if (!region) return;
            if (APP.leafletSelectedLayer && APP.leafletLayer) APP.leafletLayer.resetStyle(APP.leafletSelectedLayer);
            APP.leafletSelectedLayer = this;
            this.setStyle({ weight: 3.2, color: "#003b71", fillOpacity: 1 });
            const select = document.getElementById("filtroRegion");
            if (select) select.value = region;
            applyFilters();
          });
        }
      }).addTo(APP.leafletMap);

      APP.leafletBounds = APP.leafletLayer.getBounds();
      const targetBounds = selectedBounds && selectedBounds.isValid && selectedBounds.isValid() ? selectedBounds : APP.leafletBounds;
      APP.leafletMap.fitBounds(targetBounds, { padding: [18, 18], maxZoom: selectedRegion ? 6.6 : 4.25 });

      const ResetControl = L.Control.extend({
        options: { position: "topleft" },
        onAdd: function() {
          const wrap = L.DomUtil.create("div", "leaflet-control epro-map-reset-control");
          const btn = L.DomUtil.create("button", "epro-map-reset-view-btn", wrap);
          btn.type = "button";
          btn.innerHTML = `<span aria-hidden="true">🏠</span><strong>Chile completo</strong>`;
          btn.title = "Restablecer vista nacional";
          L.DomEvent.disableClickPropagation(wrap);
          L.DomEvent.on(btn, "click", function(ev) {
            L.DomEvent.preventDefault(ev);
            if (APP.leafletMap && APP.leafletBounds) APP.leafletMap.fitBounds(APP.leafletBounds, { padding: [18, 18], maxZoom: 4.25 });
          });
          return wrap;
        }
      });
      new ResetControl().addTo(APP.leafletMap);

      setTimeout(() => APP.leafletMap && APP.leafletMap.invalidateSize(), 250);
    } catch (error) {
      console.warn("EPRO Insight: mapa Leaflet no disponible; se usa SVG/respaldo.", error);
      if (APP.geojsonReady && APP.geojson && Array.isArray(APP.geojson.features)) {
        renderGeoJsonSvgMap(el, rows);
      } else {
        renderMapFallback(el, rows);
      }
    }
  }

  function featureRegion(feature) {
    const props = feature?.properties || {};
    return canonicalRegion(
      props._epro_region || props.Region || props.REGION || props.region ||
      props.NOMBRE_REG || props.NOM_REG || props.nom_reg || props.name ||
      props.nombre || props.NOMBRE || props.NAME || props.region_name || props.RegionName || ""
    );
  }

  function renderGeoJsonSvgMap(el, rows) {
    const rowsByRegion = new Map(rows.map(r => [canonicalRegion(r.name), r.value]));
    const max = Math.max(...rows.map(r => r.value), 1);

    const features = APP.geojson.features
      .map(feature => ({ feature, region: featureRegion(feature), value: rowsByRegion.get(featureRegion(feature)) || 0 }))
      .filter(item => item.region && REGION_ORDER.includes(item.region));

    if (!features.length) return renderMapFallback(el, rows);

    const mainlandBounds = getMainlandBounds(features.map(item => item.feature));
    if (!mainlandBounds) return renderMapFallback(el, rows);

    const width = 360;
    const height = 640;
    const pad = 14;
    const [minLon, minLat, maxLon, maxLat] = mainlandBounds;
    const lonSpan = maxLon - minLon || 1;
    const latSpan = maxLat - minLat || 1;
    const scale = Math.min((width - pad * 2) / lonSpan, (height - pad * 2) / latSpan);
    const mapW = lonSpan * scale;
    const mapH = latSpan * scale;
    const offsetX = (width - mapW) / 2;
    const offsetY = (height - mapH) / 2;

    const project = ([lon, lat]) => [offsetX + (lon - minLon) * scale, offsetY + (maxLat - lat) * scale];

    const paths = features.map(({ feature, region, value }) => {
      const d = geoJsonToPath(feature.geometry, project);
      if (!d) return "";
      const fill = mapFill(value / max, value);
      return `<path class="epro-map-region ${value ? "is-active" : "is-empty"}" d="${d}" fill="${fill}" data-region="${escapeAttr(region)}" data-value="${escapeAttr(String(value))}" tabindex="0" role="button"><title>${escapeHTML(region)}: ${formatNumber(value)} registros</title></path>`;
    }).join("");

    el.innerHTML = `<div class="epro-svg-map-shell epro-svg-map-shell-real"><svg class="epro-svg-map" viewBox="0 0 ${width} ${height}" preserveAspectRatio="xMidYMid meet" aria-label="Mapa regional de Chile"><g>${paths}</g></svg></div>`;

    el.querySelectorAll(".epro-map-region").forEach(path => {
      const selectRegion = () => {
        const region = path.dataset.region;
        const select = document.getElementById("filtroRegion");
        if (select && region) { select.value = region; applyFilters(); }
      };
      path.addEventListener("click", selectRegion);
      path.addEventListener("keydown", event => {
        if (event.key === "Enter" || event.key === " ") { event.preventDefault(); selectRegion(); }
      });
    });
  }

  function removeValparaisoRemoteIslands(geojson) {
    /*
      Corrección cartográfica V3:
      El GeoJSON público incluye territorios insulares y antárticos en algunas regiones.
      Si esos polígonos quedan dentro del layer, Leaflet calcula el encuadre considerando
      puntos muy alejados del Chile continental y el mapa aparece descentrado o “muy arriba/abajo”.

      Para este visor ejecutivo se usa vista continental, igual que en el Observatorio Influenza:
      - conserva Arica a Magallanes continental;
      - excluye Rapa Nui, Juan Fernández, Desventuradas y Antártica;
      - mantiene la zona austral continental y Tierra del Fuego.
    */
    if (!geojson || !Array.isArray(geojson.features)) return geojson;

    const clone = JSON.parse(JSON.stringify(geojson));
    clone.features = clone.features
      .map(feature => ({ ...feature, geometry: filterGeometryContinental(feature.geometry) }))
      .filter(feature => feature.geometry && Array.isArray(feature.geometry.coordinates) && feature.geometry.coordinates.length);

    return clone;
  }

  function filterGeometryContinental(geometry) {
    if (!geometry || !geometry.coordinates) return geometry;

    // Ventana continental ampliada: incluye Patagonia austral y Tierra del Fuego, excluye islas remotas/Antártica.
    const MIN_LON = -76.5;
    const MAX_LON = -66.0;
    const MIN_LAT = -57.2;
    const MAX_LAT = -17.0;

    const pointInMainlandBox = ([lon, lat]) => {
      const x = Number(lon);
      const y = Number(lat);
      return Number.isFinite(x) && Number.isFinite(y) && x >= MIN_LON && x <= MAX_LON && y >= MIN_LAT && y <= MAX_LAT;
    };

    const ringInMainlandBox = ring => Array.isArray(ring) && ring.some(pointInMainlandBox);

    if (geometry.type === "Polygon") {
      const rings = geometry.coordinates.filter(ringInMainlandBox);
      return rings.length ? { ...geometry, coordinates: rings } : { ...geometry, coordinates: [] };
    }

    if (geometry.type === "MultiPolygon") {
      const polys = geometry.coordinates.filter(poly => Array.isArray(poly) && poly.some(ringInMainlandBox));
      return polys.length ? { ...geometry, coordinates: polys } : { ...geometry, coordinates: [] };
    }

    return geometry;
  }

  function getMainlandBounds(features) {
    const points = [];
    features.forEach(feature => {
      flattenGeoCoordinates(feature.geometry).forEach(([lon, lat]) => {
        const lonNum = Number(lon);
        const latNum = Number(lat);
        if (!Number.isFinite(lonNum) || !Number.isFinite(latNum)) return;
        if (lonNum < -76 || lonNum > -66 || latNum < -57 || latNum > -17) return;
        points.push([lonNum, latNum]);
      });
    });

    if (!points.length) return null;
    const lons = points.map(p => p[0]);
    const lats = points.map(p => p[1]);
    return [Math.min(...lons), Math.min(...lats), Math.max(...lons), Math.max(...lats)];
  }

  function flattenGeoCoordinates(geometry) {
    if (!geometry || !geometry.coordinates) return [];
    const points = [];
    const walk = coords => {
      if (!Array.isArray(coords)) return;
      if (typeof coords[0] === "number" && typeof coords[1] === "number") { points.push(coords); return; }
      coords.forEach(walk);
    };
    walk(geometry.coordinates);
    return points;
  }

  function geoJsonToPath(geometry, project) {
    if (!geometry || !geometry.coordinates) return "";
    const polygonToPath = polygon => {
      if (!Array.isArray(polygon)) return "";
      return polygon.map(ring => {
        const filtered = ring.filter(([lon, lat]) => {
          const lonNum = Number(lon);
          const latNum = Number(lat);
          return Number.isFinite(lonNum) && Number.isFinite(latNum) && lonNum >= -76 && lonNum <= -66 && latNum >= -57 && latNum <= -17;
        });
        if (filtered.length < 3) return "";
        return filtered.map((coord, idx) => {
          const [x, y] = project(coord);
          return `${idx === 0 ? "M" : "L"}${x.toFixed(2)},${y.toFixed(2)}`;
        }).join(" ") + " Z";
      }).join(" ");
    };
    if (geometry.type === "Polygon") return polygonToPath(geometry.coordinates);
    if (geometry.type === "MultiPolygon") return geometry.coordinates.map(polygonToPath).join(" ");
    return "";
  }

  function mapFill(intensity, value) {
    if (!value) return "#dcecf8";
    if (intensity >= 0.80) return "#003b71";
    if (intensity >= 0.60) return "#005ea8";
    if (intensity >= 0.40) return "#1683c7";
    if (intensity >= 0.20) return "#54addd";
    return "#9bd2f1";
  }

  function renderMapFallback(el, rows) {
    const map = new Map(rows.map(r => [canonicalRegion(r.name), r.value]));
    const max = Math.max(...rows.map(r => r.value), 1);
    const segmentHeight = 25;
    const width = 230;
    const height = REGION_ORDER.length * segmentHeight + 28;
    const centerX = width / 2;

    const segments = REGION_ORDER.map((region, idx) => {
      const value = map.get(region) || 0;
      const fill = mapFill(value / max, value);
      const y = 14 + idx * segmentHeight;
      const wobble = Math.sin(idx * 0.85) * 11;
      const w = 62 + Math.cos(idx * 0.55) * 12;
      const x = centerX - w / 2 + wobble;
      return `<g class="epro-map-region-fallback ${value ? "is-active" : "is-empty"}" data-region="${escapeAttr(region)}" data-value="${escapeAttr(String(value))}" tabindex="0" role="button"><rect x="${x.toFixed(1)}" y="${y}" width="${w.toFixed(1)}" height="18" rx="9" fill="${fill}"></rect><text x="${(x + w / 2).toFixed(1)}" y="${y + 13}" text-anchor="middle">${idx + 1}</text><title>${escapeHTML(region)}: ${formatNumber(value)} registros</title></g>`;
    }).join("");

    const legendRows = rows.slice(0, 7).map((r, idx) => `<button type="button" class="epro-map-list-item" data-region="${escapeAttr(canonicalRegion(r.name))}"><span>${idx < 3 ? ["🥇", "🥈", "🥉"][idx] : "📍"}</span><b>${escapeHTML(canonicalRegion(r.name))}</b><strong>${formatNumber(r.value)}</strong></button>`).join("");

    el.innerHTML = `<div class="epro-map-fallback-shell"><div class="epro-map-silhouette-card"><svg class="epro-map-silhouette" viewBox="0 0 ${width} ${height}" preserveAspectRatio="xMidYMid meet" aria-label="Mapa esquemático regional de Chile"><path class="epro-map-spine" d="M${centerX},14 C${centerX-36},110 ${centerX+34},210 ${centerX-10},315 C${centerX-44},390 ${centerX+20},455 ${centerX-4},${height-18}" />${segments}</svg><div class="epro-map-note">Mapa regional esquemático · orden norte-sur</div></div><div class="epro-map-side-list"><div class="epro-map-side-title">Regiones con mayor notificación</div>${legendRows}</div></div>`;

    el.querySelectorAll(".epro-map-region-fallback, .epro-map-list-item").forEach(btn => {
      const selectRegion = () => { const region = btn.dataset.region; const select = document.getElementById("filtroRegion"); if (select && region) { select.value = region; applyFilters(); } };
      btn.addEventListener("click", selectRegion);
      btn.addEventListener("keydown", event => { if (event.key === "Enter" || event.key === " ") { event.preventDefault(); selectRegion(); } });
    });
  }

  /* =========================================================
     9. CALIDAD DE DATOS
     ========================================================= */

  function renderQuality() {
    const data = APP.filtered || [];
    const total = data.length;
    const coreFields = ["anio", "mes", "region", "comuna", "establecimiento", "vacuna", "tipoEpro"];
    const incompletos = data.filter(row => coreFields.some(f => !row[f] || row[f] === "Sin información")).length;
    const fechasInconsistentes = data.filter(row => Number.isFinite(row.diasNotificacion) && row.diasNotificacion < 0).length;

    const potentialKeys = new Set();
    let duplicados = 0;
    data.forEach(row => {
      const key = normalizeKey([row.anio, row.mes, row.region, row.comuna, row.establecimiento, row.vacuna, row.tipoEpro, row.lote, row.dosis].join("|"));
      if (potentialKeys.has(key)) duplicados += 1;
      else potentialKeys.add(key);
    });

    setText("calidadRegistros", formatNumber(total));
    setText("calidadIncompletos", formatNumber(incompletos));
    setText("calidadFechas", formatNumber(fechasInconsistentes));
    setText("calidadDuplicados", formatNumber(duplicados));

    const msg = total
      ? `La revisión de calidad se realizó sobre ${formatNumber(total)} registros filtrados. La validación considera completitud de campos programáticos, coherencia temporal entre fecha de vacunación y fecha de notificación, y duplicidad potencial sobre variables agregadas no personales.`
      : "La evaluación de calidad se generará automáticamente al cargar los datos.";
    setText("calidadDetalle", msg);
  }

  /* =========================================================
     10. TABLA ANONIMIZADA Y EXPORTACIÓN
     ========================================================= */

  function renderTable() {
    const body = document.getElementById("eproTablaBody");
    if (!body) return;

    const total = APP.filtered.length;
    const totalPages = Math.max(1, Math.ceil(total / APP.rowsPerPage));
    APP.currentPage = Math.min(APP.currentPage, totalPages);
    const start = (APP.currentPage - 1) * APP.rowsPerPage;
    const rows = APP.filtered.slice(start, start + APP.rowsPerPage);

    if (!rows.length) {
      body.innerHTML = `<tr><td colspan="15" class="epro-table-empty">Sin datos para la selección actual.</td></tr>`;
      setText("eproPaginaActual", "Página 1 de 1");
      return;
    }

    body.innerHTML = rows.map(row => `
      <tr>
        <td>${escapeHTML(row.anio)}</td>
        <td>${escapeHTML(row.mes)}</td>
        <td>${escapeHTML(row.region)}</td>
        <td>${escapeHTML(row.comuna)}</td>
        <td>${escapeHTML(row.establecimiento)}</td>
        <td>${escapeHTML(row.vacuna)}</td>
        <td>${escapeHTML(row.tipoEpro)}</td>
        <td>${escapeHTML(row.grupoEtario)}</td>
        <td>${escapeHTML(row.sexo)}</td>
        <td>${escapeHTML(row.dosis)}</td>
        <td>${escapeHTML(row.esavi)}</td>
        <td>${escapeHTML(row.manifestaciones)}</td>
        <td>${escapeHTML(row.sector)}</td>
        <td>${escapeHTML(row.masivo)}</td>
        <td>${row.diasNotificacion === null ? "—" : escapeHTML(row.diasNotificacion)}</td>
      </tr>
    `).join("");

    setText("eproPaginaActual", `Página ${APP.currentPage} de ${totalPages} · ${formatNumber(total)} registros`);
  }

  function exportFilteredCSV() {
    const rows = APP.filtered || [];
    if (!rows.length) {
      alert("No hay datos para exportar.");
      return;
    }

    const headers = [
      "Año", "Mes", "Región", "Comuna", "Establecimiento", "Vacuna", "Lote",
      "Tipo EPRO", "Grupo etario", "Sexo", "Dosis", "ESAVI", "Manifestaciones",
      "Sector", "Masivo", "Días notificación"
    ];

    const csvRows = [headers.join(";")];
    rows.forEach(row => {
      const values = [
        row.anio, row.mes, row.region, row.comuna, row.establecimiento, row.vacuna, row.lote,
        row.tipoEpro, row.grupoEtario, row.sexo, row.dosis, row.esavi, row.manifestaciones,
        row.sector, row.masivo, row.diasNotificacion === null ? "" : row.diasNotificacion
      ].map(csvEscape);
      csvRows.push(values.join(";"));
    });

    const blob = new Blob(["\ufeff" + csvRows.join("\n")], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = `EPRO_Insight_base_filtrada_${new Date().toISOString().slice(0, 10)}.csv`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function csvEscape(value) {
    const txt = cleanText(value);
    if (/[";\n\r]/.test(txt)) return `"${txt.replace(/"/g, '""')}"`;
    return txt;
  }

  /* =========================================================
     11. SEGURIDAD DE SALIDA HTML
     ========================================================= */

  function escapeHTML(value) {
    return cleanText(value)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function escapeAttr(value) {
    return escapeHTML(value).replace(/`/g, "&#096;");
  }

  /* =========================================================
     12. INICIO
     ========================================================= */

  document.addEventListener("DOMContentLoaded", async () => {
    if (!document.getElementById("eproInsightApp")) return;
    bindEvents();

    try {
      await loadData();
    } catch (error) {
      console.error("EPRO Insight:", error);
      updateStatus("No fue posible cargar la base. Revisa la URL del archivo y permisos públicos.", false);
      setHTML("eproResumenInteligente", `No fue posible cargar la base de datos. Detalle técnico: <strong>${escapeHTML(error.message)}</strong>`);
    }
  });

})();

/* =========================================================
   EPRO INSIGHT V2 REFRESH — PATCH FINAL DE INTERFAZ
   Mantiene el motor estable de mapa V7 y conecta la nueva maqueta V2:
   - Botón flotante Limpiar vista
   - Botón Limpiar vista del mapa
   - Oculta/remueve Modo presentación si existe
   - Vuelve a vista nacional limpiando todos los filtros
   ========================================================= */
(function(){
  'use strict';

  function hidePresentationButton(){
    ['eproBtnFullscreen','btnFullscreen','modoPresentacion','eproModoPresentacion'].forEach(function(id){
      var el = document.getElementById(id);
      if(el) el.remove();
    });
    Array.prototype.slice.call(document.querySelectorAll('button,a')).forEach(function(el){
      var txt = (el.textContent || '').trim().toLowerCase();
      if(txt.indexOf('modo presentación') >= 0 || txt.indexOf('modo presentacion') >= 0){
        el.remove();
      }
    });
  }

  function resetVisibleFilters(){
    var fields = Array.prototype.slice.call(document.querySelectorAll('.epro-filter, select[id^="filtro"], input[id^="filtro"]'));
    fields.forEach(function(el){
      el.value = '';
      el.dispatchEvent(new Event('input', { bubbles:true }));
      el.dispatchEvent(new Event('change', { bubbles:true }));
    });

    var search = document.getElementById('eproBuscarTabla');
    if(search){
      search.value = '';
      search.dispatchEvent(new Event('input', { bubbles:true }));
      search.dispatchEvent(new Event('change', { bubbles:true }));
    }
  }

  function clearView(){
    resetVisibleFilters();

    var resetBtn = document.getElementById('eproBtnReset') || document.getElementById('eproLimpiarFiltros');
    if(resetBtn){
      try { resetBtn.click(); } catch(e) {}
    }

    var aviso = document.getElementById('eproVistaAviso') || document.getElementById('mapaLeyenda');
    if(aviso){
      var old = aviso.textContent;
      aviso.textContent = 'Vista nacional restablecida';
      setTimeout(function(){ aviso.textContent = old && old.indexOf('restablecida') < 0 ? old : 'Vista nacional'; }, 1800);
    }

    document.body.classList.remove('epro-region-selected');
  }

  function attachResetButtons(){
    ['eproBtnResetMap','eproFloatingReset','eproBtnLimpiarMapa'].forEach(function(id){
      var btn = document.getElementById(id);
      if(btn && !btn.dataset.eproClearBound){
        btn.dataset.eproClearBound = '1';
        btn.addEventListener('click', function(ev){
          ev.preventDefault();
          clearView();
        });
      }
    });
  }

  function enhanceFloatingButton(){
    var btn = document.getElementById('eproFloatingReset');
    if(!btn) return;
    var onScroll = function(){
      if(window.scrollY > 300) btn.classList.add('is-visible');
      else btn.classList.remove('is-visible');
    };
    window.addEventListener('scroll', onScroll, { passive:true });
    onScroll();
  }

  function ensureMapResetStatus(){
    var mapActions = document.querySelector('.epro-map-actions');
    if(mapActions && !document.getElementById('eproVistaAviso')){
      var span = document.createElement('span');
      span.id = 'eproVistaAviso';
      span.className = 'epro-map-status';
      span.textContent = 'Vista nacional';
      mapActions.insertBefore(span, mapActions.firstChild);
    }
  }

  function init(){
    hidePresentationButton();
    attachResetButtons();
    enhanceFloatingButton();
    ensureMapResetStatus();

    setTimeout(function(){
      hidePresentationButton();
      attachResetButtons();
      ensureMapResetStatus();
    }, 900);
  }

  if(document.readyState === 'loading'){
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }

  window.eproClearView = clearView;
})();
</script><style class="wpcode-css-snippet">/* =========================================================
   EPRO INSIGHT V2 — REFRESH VISUAL INSTITUCIONAL
   CSS para WordPress / Divi / WPCode
   Pegar como reemplazo del CSS anterior o al final si deseas probar primero.
   ========================================================= */

:root{
  --epro-blue-950:#052247;
  --epro-blue-900:#07305f;
  --epro-blue-800:#0a417f;
  --epro-blue-700:#0c5ea8;
  --epro-blue-600:#1379c5;
  --epro-blue-100:#e8f4ff;
  --epro-blue-050:#f3f9ff;
  --epro-cyan:#2cb6e8;
  --epro-green:#039855;
  --epro-yellow:#f79009;
  --epro-red:#d92d20;
  --epro-ink:#101828;
  --epro-gray-800:#1d2939;
  --epro-gray-700:#344054;
  --epro-gray-600:#475467;
  --epro-gray-500:#667085;
  --epro-gray-300:#d0d5dd;
  --epro-gray-200:#eaecf0;
  --epro-gray-100:#f2f4f7;
  --epro-white:#ffffff;
  --epro-bg:#f4f7fb;
  --epro-border:1px solid rgba(208,213,221,.82);
  --epro-shadow:0 14px 38px rgba(16,24,40,.10);
  --epro-shadow-soft:0 8px 22px rgba(16,24,40,.075);
  --epro-radius-xl:28px;
  --epro-radius-lg:22px;
  --epro-radius-md:16px;
  --epro-font:"Inter","Segoe UI",Roboto,Arial,sans-serif;
}

#eproInsightApp,
#eproInsightApp *{box-sizing:border-box;}

#eproInsightApp{
  width:100%;
  max-width:1480px;
  margin:0 auto;
  padding:0 18px 46px;
  color:var(--epro-ink);
  font-family:var(--epro-font);
  background:
    radial-gradient(circle at 8% 0%, rgba(44,182,232,.22), transparent 28%),
    radial-gradient(circle at 90% 5%, rgba(12,94,168,.14), transparent 24%),
    var(--epro-bg);
}

#eproInsightApp button,
#eproInsightApp select,
#eproInsightApp input{font-family:inherit;}

#eproInsightApp h1,
#eproInsightApp h2,
#eproInsightApp h3,
#eproInsightApp p{margin-top:0;}

/* HERO */
.epro-hero-compact{
  position:relative;
  overflow:hidden;
  margin:0 0 14px;
  border-radius:0 0 30px 30px;
  color:#fff;
  background:linear-gradient(135deg,var(--epro-blue-950),var(--epro-blue-800) 54%,#1180be);
  box-shadow:var(--epro-shadow);
}

.epro-hero-bg{
  position:absolute;
  inset:0;
  pointer-events:none;
  background:
    radial-gradient(circle at 14% 18%,rgba(255,255,255,.20),transparent 24%),
    radial-gradient(circle at 88% 16%,rgba(44,182,232,.32),transparent 22%),
    linear-gradient(120deg,rgba(255,255,255,.10),transparent 58%);
}

.epro-hero-inner{position:relative;z-index:1;padding:22px 28px 26px;}

.epro-hero-top{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:18px;
  margin-bottom:20px;
}

.epro-logo{display:block;width:156px;max-width:42vw;height:auto;object-fit:contain;filter:drop-shadow(0 8px 16px rgba(0,0,0,.18));}

.epro-hero-badges{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8px;}

.epro-badge,
.epro-ai-pill,
.epro-mini-label{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:6px;
  border-radius:999px;
  padding:8px 12px;
  font-size:11px;
  font-weight:900;
  line-height:1;
  letter-spacing:.02em;
  white-space:nowrap;
}

.epro-badge{color:#fff;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.24);backdrop-filter:blur(12px);}
.epro-badge-light{background:rgba(255,255,255,.24);}

.epro-hero-content{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:24px;align-items:end;}
.epro-kicker{display:block;margin-bottom:7px;color:#bfeaff;font-size:12px;font-weight:950;text-transform:uppercase;letter-spacing:.12em;}
.epro-hero h1{max-width:900px;margin-bottom:10px;color:#fff;font-size:clamp(28px,3.4vw,48px);font-weight:950;line-height:1.03;letter-spacing:-.045em;}
.epro-hero-text{max-width:880px;margin-bottom:0;color:rgba(255,255,255,.88);font-size:15px;line-height:1.48;font-weight:600;}

.epro-hero-card{
  padding:18px 18px;
  border-radius:22px;
  background:rgba(255,255,255,.14);
  border:1px solid rgba(255,255,255,.24);
  backdrop-filter:blur(14px);
  box-shadow:0 12px 28px rgba(0,0,0,.14);
}
.epro-hero-card-label,.epro-hero-card small{display:block;color:rgba(255,255,255,.76);font-size:11px;font-weight:900;text-transform:uppercase;letter-spacing:.08em;}
.epro-hero-card strong{display:block;margin:8px 0;color:#fff;font-size:21px;font-weight:950;line-height:1.15;}

/* TOOLBAR */
.epro-toolbar-refresh{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:12px;
  margin:0 0 14px;
  padding:12px 14px;
  border-radius:20px;
  background:rgba(255,255,255,.90);
  border:var(--epro-border);
  box-shadow:var(--epro-shadow-soft);
  backdrop-filter:blur(14px);
}
.epro-toolbar-left,.epro-toolbar-right{display:flex;align-items:center;gap:10px;flex-wrap:wrap;}
.epro-toolbar-left{color:var(--epro-gray-700);font-size:13px;font-weight:850;}
.epro-status-dot{width:10px;height:10px;border-radius:50%;background:var(--epro-yellow);box-shadow:0 0 0 5px rgba(247,144,9,.14);}
.epro-status-dot.is-loading{animation:eproPulse 1s infinite alternate;}
.epro-status-dot.is-ready{background:var(--epro-green);box-shadow:0 0 0 5px rgba(3,152,85,.13);}
.epro-status-dot.is-error{background:var(--epro-red);box-shadow:0 0 0 5px rgba(217,45,32,.13);}
@keyframes eproPulse{to{opacity:.45;transform:scale(.84)}}

/* BOTONES */
.epro-btn{appearance:none;border:none;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;min-height:40px;padding:10px 15px;border-radius:14px;font-size:12px;font-weight:950;line-height:1;transition:transform .18s ease,box-shadow .18s ease,background .18s ease,color .18s ease;}
.epro-btn:hover{transform:translateY(-1px);}
.epro-btn:active{transform:translateY(0);}
.epro-btn-primary{color:#fff;background:linear-gradient(135deg,var(--epro-blue-800),var(--epro-blue-600));box-shadow:0 12px 22px rgba(12,94,168,.22);}
.epro-btn-soft{color:var(--epro-blue-900);background:var(--epro-blue-100);border:1px solid rgba(19,121,197,.18);}
.epro-btn-soft:hover{background:#dcf0ff;}

/* FILTROS SUPERIORES */
.epro-filter-panel-sticky{
  position:sticky;
  top:0;
  z-index:50;
  margin:0 0 16px;
  padding:15px;
  border-radius:24px;
  background:rgba(255,255,255,.94);
  border:var(--epro-border);
  box-shadow:var(--epro-shadow-soft);
  backdrop-filter:blur(18px);
}
.epro-filter-panel-head{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin-bottom:12px;}
.epro-filter-panel-head h2{margin:0;color:var(--epro-ink);font-size:19px;font-weight:950;letter-spacing:-.025em;}
.epro-filter-panel-head p{max-width:520px;margin:0;color:var(--epro-gray-500);font-size:12px;font-weight:700;line-height:1.35;text-align:right;}
.epro-section-label{display:block;margin-bottom:4px;color:var(--epro-blue-700);font-size:10px;font-weight:950;text-transform:uppercase;letter-spacing:.12em;}
.epro-filter-search-row{margin-bottom:10px;}
.epro-filter-grid-compact{display:grid;grid-template-columns:repeat(7,minmax(120px,1fr));gap:10px;}
.epro-filter-group{min-width:0;}
.epro-filter-group label{display:block;margin:0 0 5px;color:var(--epro-gray-700);font-size:11px;font-weight:950;}
.epro-filter,.epro-search{width:100%;min-height:38px;border-radius:13px;border:1px solid var(--epro-gray-300);background:#fff;color:var(--epro-ink);font-size:12px;font-weight:800;outline:none;transition:border .18s ease,box-shadow .18s ease;}
.epro-filter{padding:0 10px;}
.epro-search{padding:0 13px;}
.epro-filter:focus,.epro-search:focus{border-color:var(--epro-blue-600);box-shadow:0 0 0 4px rgba(19,121,197,.12);}

/* MAIN */
.epro-main-full{min-width:0;}

/* KPIs */
.epro-kpi-grid-refresh{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:13px;margin-bottom:16px;}
.epro-kpi-card{
  position:relative;
  overflow:hidden;
  display:flex;
  align-items:flex-start;
  gap:12px;
  min-height:118px;
  padding:16px;
  border-radius:22px;
  background:#fff;
  border:var(--epro-border);
  box-shadow:var(--epro-shadow-soft);
}
.epro-kpi-card::after{content:"";position:absolute;right:-26px;bottom:-26px;width:78px;height:78px;border-radius:50%;background:rgba(44,182,232,.13);}
.epro-kpi-card-primary{color:#fff;background:linear-gradient(135deg,var(--epro-blue-900),var(--epro-blue-700));border-color:rgba(255,255,255,.12);}
.epro-kpi-card-primary .epro-kpi-label,.epro-kpi-card-primary small{color:rgba(255,255,255,.78);}
.epro-kpi-card-primary strong{color:#fff;}
.epro-kpi-icon{position:relative;z-index:1;flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:15px;background:var(--epro-blue-100);font-size:21px;}
.epro-kpi-card-primary .epro-kpi-icon{background:rgba(255,255,255,.18);}
.epro-kpi-card div{position:relative;z-index:1;min-width:0;}
.epro-kpi-label{display:block;margin-bottom:6px;color:var(--epro-gray-600);font-size:11px;font-weight:950;text-transform:uppercase;letter-spacing:.05em;}
.epro-kpi-card strong{display:block;margin-bottom:5px;color:var(--epro-blue-950);font-size:28px;font-weight:950;line-height:1;letter-spacing:-.045em;}
.epro-kpi-card small{display:block;color:var(--epro-gray-500);font-size:11px;font-weight:750;line-height:1.32;}

/* TARJETAS */
.epro-card{margin-bottom:16px;padding:18px;border-radius:22px;background:#fff;border:var(--epro-border);box-shadow:var(--epro-shadow-soft);}
.epro-card-featured{box-shadow:var(--epro-shadow);}
.epro-card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:14px;}
.epro-card h2{margin:0;color:var(--epro-ink);font-size:19px;font-weight:950;letter-spacing:-.025em;line-height:1.15;}
.epro-mini-label{color:var(--epro-blue-900);background:var(--epro-blue-100);border:1px solid rgba(19,121,197,.16);}
.epro-grid{display:grid;gap:16px;}
.epro-grid-2{grid-template-columns:repeat(2,minmax(0,1fr));}
.epro-grid-main{align-items:stretch;}

/* RESUMEN */
.epro-ai-refresh{background:linear-gradient(135deg,rgba(232,244,255,.94),rgba(255,255,255,.98));border-color:rgba(19,121,197,.18);}
.epro-ai-pill{color:#fff;background:linear-gradient(135deg,var(--epro-blue-700),var(--epro-cyan));}
.epro-ai-body{padding:16px;border-radius:18px;background:rgba(255,255,255,.78);border:1px solid rgba(19,121,197,.12);color:var(--epro-gray-700);font-size:14px;line-height:1.62;font-weight:700;}
.epro-ai-body strong{color:var(--epro-blue-950);font-weight:950;}
.epro-insight-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:12px;}
.epro-alert-card{padding:14px;border-radius:17px;background:#fff;border:1px solid rgba(208,213,221,.9);}
.epro-alert-card strong{display:block;margin-bottom:7px;color:var(--epro-blue-950);font-size:12px;font-weight:950;}
.epro-alert-card p{margin:0;color:var(--epro-gray-600);font-size:12px;line-height:1.45;font-weight:700;}
.epro-alert-good{background:#f0fff8;border-color:rgba(3,152,85,.24);}
.epro-alert-focus{background:#fff8ec;border-color:rgba(247,144,9,.28);}
.epro-alert-risk{background:#fff4f2;border-color:rgba(217,45,32,.22);}

/* MAPA */
.epro-card-head-map{align-items:center;}
.epro-map-actions{display:flex;align-items:center;justify-content:flex-end;gap:8px;flex-wrap:wrap;}
.epro-btn-map-reset{min-height:34px;padding:9px 12px;border-radius:12px;}
.epro-map-v2{min-height:500px;background:linear-gradient(180deg,#f8fbff,#eef6ff);border:1px solid rgba(19,121,197,.12);border-radius:20px;overflow:hidden;position:relative;}
#eproMapaChile svg{width:100%;height:100%;display:block;}
.epro-map-region{transition:fill .18s ease,stroke .18s ease,opacity .18s ease,filter .18s ease;cursor:pointer;}
.epro-map-region:hover{filter:brightness(1.08);stroke:#052247!important;stroke-width:1.4!important;}
.epro-map-region.is-selected{stroke:#052247!important;stroke-width:2!important;filter:drop-shadow(0 4px 8px rgba(5,34,71,.25));}
.epro-map-tooltip{position:absolute;z-index:20;pointer-events:none;min-width:180px;padding:10px 12px;border-radius:14px;background:rgba(5,34,71,.94);color:#fff;box-shadow:0 12px 28px rgba(16,24,40,.24);font-size:12px;font-weight:800;line-height:1.35;}
.epro-map-tooltip strong{display:block;font-size:13px;font-weight:950;margin-bottom:4px;}
.epro-empty-state{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;min-height:260px;padding:24px;text-align:center;color:var(--epro-gray-500);font-weight:800;}
.epro-empty-state span{display:inline-flex;align-items:center;justify-content:center;width:60px;height:60px;border-radius:20px;background:var(--epro-blue-100);font-size:29px;}
.epro-empty-state p{margin:0;}

/* GRÁFICOS */
.epro-chart{width:100%;min-height:330px;border-radius:20px;background:linear-gradient(135deg,#fbfdff,#f6faff);border:1px solid rgba(208,213,221,.75);overflow:hidden;}
.epro-chart-v2{min-height:340px;}
.epro-chart-small{min-height:295px;}
.js-plotly-plot .plotly .modebar{display:none!important;}
.epro-chart .main-svg{font-family:var(--epro-font)!important;}

/* RANKINGS */
.epro-ranking-card{overflow:hidden;}
.epro-ranking-v2{display:grid;gap:8px;min-height:310px;align-content:start;}
.epro-rank-row{
  display:grid;
  grid-template-columns:34px minmax(0,1fr) auto;
  gap:9px;
  align-items:center;
  padding:9px 11px;
  border-radius:15px;
  background:linear-gradient(135deg,#fff,#f7fbff);
  border:1px solid rgba(208,213,221,.82);
  transition:transform .18s ease,box-shadow .18s ease,border-color .18s ease;
}
.epro-rank-row:hover{transform:translateY(-1px);box-shadow:0 10px 20px rgba(16,24,40,.08);border-color:rgba(19,121,197,.22);}
.epro-rank-num{display:inline-flex;align-items:center;justify-content:center;width:29px;height:29px;border-radius:12px;color:#fff;background:linear-gradient(135deg,var(--epro-blue-800),var(--epro-blue-600));font-size:12px;font-weight:950;}
.epro-rank-row:nth-child(1) .epro-rank-num{background:linear-gradient(135deg,#f79009,#fdb022);color:#321400;}
.epro-rank-row:nth-child(2) .epro-rank-num{background:linear-gradient(135deg,#98a2b3,#d0d5dd);color:#1d2939;}
.epro-rank-row:nth-child(3) .epro-rank-num{background:linear-gradient(135deg,#b46922,#f79009);color:#fff;}
.epro-rank-name{overflow:hidden;color:var(--epro-ink);font-size:12.5px;font-weight:900;text-overflow:ellipsis;white-space:nowrap;}
.epro-rank-value{color:var(--epro-blue-950);font-size:13px;font-weight:950;}
.epro-rank-bar{grid-column:2 / 4;height:6px;border-radius:999px;background:#deefff;overflow:hidden;}
.epro-rank-bar span{display:block;height:100%;border-radius:999px;background:linear-gradient(90deg,var(--epro-blue-700),var(--epro-cyan));animation:eproBarIn .55s ease both;}
@keyframes eproBarIn{from{width:0}}

/* BOTÓN FLOTANTE */
.epro-floating-reset{
  position:fixed;
  right:22px;
  bottom:24px;
  z-index:80;
  display:flex;
  align-items:center;
  gap:10px;
  min-width:178px;
  padding:12px 14px;
  border:none;
  border-radius:20px;
  color:#fff;
  cursor:pointer;
  background:linear-gradient(135deg,var(--epro-blue-900),var(--epro-blue-600));
  box-shadow:0 18px 36px rgba(12,94,168,.34);
  transition:transform .18s ease,box-shadow .18s ease,opacity .18s ease;
}
.epro-floating-reset:hover{transform:translateY(-2px);box-shadow:0 22px 42px rgba(12,94,168,.40);}
.epro-floating-reset span{display:inline-flex;align-items:center;justify-content:center;width:34px;height:34px;border-radius:13px;background:rgba(255,255,255,.16);font-size:18px;}
.epro-floating-reset strong{display:block;font-size:12px;font-weight:950;line-height:1.1;text-align:left;}
.epro-floating-reset small{display:block;margin-top:2px;color:rgba(255,255,255,.78);font-size:10px;font-weight:800;text-align:left;}

/* FOOTER */
.epro-footer-refresh{display:flex;justify-content:space-between;gap:16px;margin-top:8px;padding:18px 4px 0;color:var(--epro-gray-500);font-size:12px;font-weight:750;}
.epro-footer-refresh strong{display:block;color:var(--epro-blue-950);font-weight:950;}
.epro-footer-refresh span{display:block;line-height:1.4;}

/* OCULTAR ELEMENTOS ANTIGUOS SI QUEDARON EN CACHÉ */
#eproBtnFullscreen,
.epro-sidebar,
.epro-table-card,
.epro-quality-grid,
#chartHeatmap,
#chartSankey{display:none!important;}

/* RESPONSIVE */
@media (max-width:1200px){
  .epro-filter-grid-compact{grid-template-columns:repeat(4,minmax(120px,1fr));}
  .epro-kpi-grid-refresh{grid-template-columns:repeat(2,minmax(0,1fr));}
}
@media (max-width:980px){
  #eproInsightApp{padding:0 12px 42px;}
  .epro-hero-content{grid-template-columns:1fr;}
  .epro-hero-card{max-width:360px;}
  .epro-grid-2{grid-template-columns:1fr;}
  .epro-insight-grid{grid-template-columns:1fr;}
  .epro-map-v2{min-height:430px;}
}
@media (max-width:720px){
  .epro-hero-inner{padding:20px 18px 22px;}
  .epro-hero-top{flex-direction:column;align-items:flex-start;}
  .epro-hero-badges{justify-content:flex-start;}
  .epro-toolbar-refresh,.epro-filter-panel-head{align-items:flex-start;flex-direction:column;}
  .epro-filter-panel-head p{text-align:left;}
  .epro-filter-grid-compact{grid-template-columns:repeat(2,minmax(0,1fr));}
  .epro-kpi-grid-refresh{grid-template-columns:1fr;}
  .epro-card-head{flex-direction:column;}
  .epro-map-actions{justify-content:flex-start;}
  .epro-floating-reset{right:14px;bottom:14px;min-width:auto;padding:11px;border-radius:18px;}
  .epro-floating-reset strong,.epro-floating-reset small{display:none;}
}
@media (max-width:480px){
  .epro-filter-grid-compact{grid-template-columns:1fr;}
  .epro-hero h1{font-size:28px;}
}
/* =========================================================
   EPRO INSIGHT V2 — FIX MAPA NO VISIBLE
   Pegar AL FINAL del CSS actual.
   Corrige el contenedor Leaflet usado por el JS V2 refresh.
   ========================================================= */

#eproMapaChile,
#eproMapaChile.epro-chart,
#eproMapaChile.epro-map-placeholder,
#eproMapaChile.epro-map-v2 {
  display: block !important;
  position: relative !important;
  width: 100% !important;
  min-height: 560px !important;
  height: 560px !important;
  padding: 0 !important;
  overflow: hidden !important;
  border-radius: 22px !important;
  background: linear-gradient(180deg, #f8fbff 0%, #eaf4ff 100%) !important;
  border: 1px solid rgba(19, 121, 197, 0.16) !important;
}

#eproLeafletMap,
.epro-leaflet-map {
  display: block !important;
  position: absolute !important;
  inset: 0 !important;
  width: 100% !important;
  height: 100% !important;
  min-height: 560px !important;
  z-index: 1 !important;
  border-radius: 22px !important;
  overflow: hidden !important;
  background: #eef6ff !important;
}

#eproMapaChile .leaflet-container {
  width: 100% !important;
  height: 100% !important;
  min-height: 560px !important;
  font-family: var(--epro-font, "Inter", "Segoe UI", Arial, sans-serif) !important;
  background: #eef6ff !important;
  border-radius: 22px !important;
}

#eproMapaChile .leaflet-pane,
#eproMapaChile .leaflet-map-pane,
#eproMapaChile .leaflet-tile-pane,
#eproMapaChile .leaflet-overlay-pane,
#eproMapaChile .leaflet-shadow-pane,
#eproMapaChile .leaflet-marker-pane,
#eproMapaChile .leaflet-tooltip-pane,
#eproMapaChile .leaflet-popup-pane {
  z-index: auto;
}

#eproMapaChile .leaflet-control-container {
  position: relative;
  z-index: 999;
}

#eproMapaChile .leaflet-control-zoom a {
  width: 32px !important;
  height: 32px !important;
  line-height: 30px !important;
  color: #073b76 !important;
  border-color: rgba(7, 59, 118, 0.16) !important;
  font-weight: 950 !important;
}

#eproMapaChile .leaflet-control-zoom,
#eproMapaChile .leaflet-control-attribution,
#eproMapaChile .epro-map-reset-control {
  box-shadow: 0 10px 24px rgba(16, 24, 40, 0.12) !important;
  border-radius: 12px !important;
  overflow: hidden !important;
}

#eproMapaChile .leaflet-control-attribution {
  padding: 4px 8px !important;
  background: rgba(255, 255, 255, 0.86) !important;
  color: #475467 !important;
  font-size: 10px !important;
  font-weight: 700 !important;
}

.epro-map-loading {
  position: absolute !important;
  inset: 0 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  color: #073b76 !important;
  font-size: 14px !important;
  font-weight: 900 !important;
  background: linear-gradient(180deg, #f8fbff 0%, #eaf4ff 100%) !important;
  z-index: 2 !important;
}

.epro-map-reset-view-btn {
  appearance: none !important;
  border: 0 !important;
  display: inline-flex !important;
  align-items: center !important;
  gap: 7px !important;
  padding: 9px 11px !important;
  border-radius: 12px !important;
  color: #073b76 !important;
  background: rgba(255, 255, 255, 0.94) !important;
  font-size: 12px !important;
  font-weight: 950 !important;
  cursor: pointer !important;
}

.epro-region-tooltip-wrap {
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

.epro-region-tooltip-wrap::before {
  display: none !important;
}

.epro-region-tooltip-wrap .epro-map-tooltip,
.leaflet-tooltip.epro-region-tooltip-wrap {
  padding: 0 !important;
}

.epro-map-tooltip {
  min-width: 160px !important;
  padding: 10px 12px !important;
  border-radius: 14px !important;
  background: rgba(5, 34, 71, 0.96) !important;
  color: #ffffff !important;
  box-shadow: 0 14px 30px rgba(16, 24, 40, 0.25) !important;
  font-size: 12px !important;
  font-weight: 850 !important;
  line-height: 1.35 !important;
}

.epro-map-tooltip strong {
  display: block !important;
  margin-bottom: 4px !important;
  font-size: 13px !important;
  font-weight: 950 !important;
}

.epro-map-tooltip span {
  display: block !important;
  color: #dff3ff !important;
}

@media (max-width: 980px) {
  #eproMapaChile,
  #eproMapaChile.epro-chart,
  #eproMapaChile.epro-map-placeholder,
  #eproMapaChile.epro-map-v2,
  #eproLeafletMap,
  .epro-leaflet-map,
  #eproMapaChile .leaflet-container {
    min-height: 460px !important;
    height: 460px !important;
  }
}
/* =========================================================
   EPRO INSIGHT — FIX DEFINITIVO MAPA LEAFLET EN DIVI
   Pegar AL FINAL del CSS actual.

   Problema corregido:
   - Leaflet carga controles (+ / -) pero no se visualizan polígonos.
   - Divi/tema puede alterar SVG, panes o z-index del overlay.
   ========================================================= */

#eproMapaChile,
#eproMapaChile.epro-chart,
#eproMapaChile.epro-map-placeholder,
#eproMapaChile.epro-map-v2 {
  display: block !important;
  position: relative !important;
  width: 100% !important;
  min-height: 560px !important;
  height: 560px !important;
  padding: 0 !important;
  overflow: hidden !important;
  border-radius: 22px !important;
  background: linear-gradient(180deg, #f8fbff 0%, #eaf4ff 100%) !important;
  border: 1px solid rgba(19, 121, 197, 0.18) !important;
}

#eproLeafletMap,
#eproMapaChile .epro-leaflet-map,
#eproMapaChile .leaflet-container {
  display: block !important;
  position: absolute !important;
  inset: 0 !important;
  width: 100% !important;
  height: 100% !important;
  min-height: 560px !important;
  margin: 0 !important;
  padding: 0 !important;
  border-radius: 22px !important;
  overflow: hidden !important;
  background: #eaf4ff !important;
  font-family: var(--epro-font, "Inter", "Segoe UI", Arial, sans-serif) !important;
}

/* Restaurar jerarquía original de Leaflet. No dejar panes en z-index:auto. */
#eproMapaChile .leaflet-pane { position: absolute !important; }
#eproMapaChile .leaflet-map-pane { z-index: 1 !important; }
#eproMapaChile .leaflet-tile-pane { z-index: 200 !important; }
#eproMapaChile .leaflet-overlay-pane { z-index: 400 !important; }
#eproMapaChile .leaflet-shadow-pane { z-index: 500 !important; }
#eproMapaChile .leaflet-marker-pane { z-index: 600 !important; }
#eproMapaChile .leaflet-tooltip-pane { z-index: 650 !important; }
#eproMapaChile .leaflet-popup-pane { z-index: 700 !important; }
#eproMapaChile .leaflet-control-container { position: relative !important; z-index: 900 !important; }

/* Evita que Divi/tema de WordPress rompa el SVG interno de Leaflet. */
#eproMapaChile .leaflet-overlay-pane svg,
#eproMapaChile .leaflet-zoom-animated svg {
  position: absolute !important;
  display: block !important;
  width: auto !important;
  height: auto !important;
  max-width: none !important;
  max-height: none !important;
  overflow: visible !important;
  pointer-events: auto !important;
}

#eproMapaChile .leaflet-overlay-pane g,
#eproMapaChile .leaflet-overlay-pane path,
#eproMapaChile .leaflet-interactive {
  pointer-events: auto !important;
  visibility: visible !important;
}

/* Aumenta contraste del mapa para que las regiones sean visibles aun con valores bajos. */
#eproMapaChile .leaflet-interactive {
  stroke: #ffffff !important;
  stroke-width: 1.4 !important;
  stroke-opacity: 1 !important;
  fill-opacity: 0.96 !important;
  filter: drop-shadow(0 2px 3px rgba(7, 59, 118, 0.14));
}

#eproMapaChile .leaflet-interactive:hover {
  stroke: #002f5f !important;
  stroke-width: 2.4 !important;
  fill-opacity: 1 !important;
}

#eproMapaChile .leaflet-control-zoom,
#eproMapaChile .epro-map-reset-control,
#eproMapaChile .leaflet-control-attribution {
  box-shadow: 0 10px 24px rgba(16, 24, 40, 0.12) !important;
  border-radius: 12px !important;
  overflow: hidden !important;
}

#eproMapaChile .leaflet-control-zoom a {
  width: 32px !important;
  height: 32px !important;
  line-height: 30px !important;
  color: #073b76 !important;
  border-color: rgba(7, 59, 118, 0.16) !important;
  font-weight: 950 !important;
}

#eproMapaChile .leaflet-control-attribution {
  padding: 4px 8px !important;
  background: rgba(255, 255, 255, 0.86) !important;
  color: #475467 !important;
  font-size: 10px !important;
  font-weight: 700 !important;
}

.epro-map-reset-view-btn {
  appearance: none !important;
  border: 0 !important;
  display: inline-flex !important;
  align-items: center !important;
  gap: 7px !important;
  padding: 9px 11px !important;
  border-radius: 12px !important;
  color: #073b76 !important;
  background: rgba(255, 255, 255, 0.94) !important;
  font-size: 12px !important;
  font-weight: 950 !important;
  cursor: pointer !important;
}

.epro-region-tooltip-wrap {
  background: transparent !important;
  border: 0 !important;
  box-shadow: none !important;
}

.epro-region-tooltip-wrap::before { display: none !important; }

.epro-map-tooltip {
  min-width: 160px !important;
  padding: 10px 12px !important;
  border-radius: 14px !important;
  background: rgba(5, 34, 71, 0.96) !important;
  color: #ffffff !important;
  box-shadow: 0 14px 30px rgba(16, 24, 40, 0.25) !important;
  font-size: 12px !important;
  font-weight: 850 !important;
  line-height: 1.35 !important;
}

.epro-map-tooltip strong {
  display: block !important;
  margin-bottom: 4px !important;
  font-size: 13px !important;
  font-weight: 950 !important;
}

.epro-map-tooltip span {
  display: block !important;
  color: #dff3ff !important;
}

@media (max-width: 980px) {
  #eproMapaChile,
  #eproMapaChile.epro-chart,
  #eproMapaChile.epro-map-placeholder,
  #eproMapaChile.epro-map-v2,
  #eproLeafletMap,
  #eproMapaChile .epro-leaflet-map,
  #eproMapaChile .leaflet-container {
    min-height: 480px !important;
    height: 480px !important;
  }
}
</style><script>/* =========================================================
   PNI INSIGHT — ADDON MARCO REGULATORIO V1
   Programa Nacional de Inmunizaciones — Revisor Documental

   Uso en WPCode:
   1) Mantener activo: 01 - PNI Rules Library V3
   2) Crear este snippet como: 02 - PNI Marco Regulatorio Addon
   3) Cargar este snippet ANTES del JS principal del revisor.
   4) Luego cargar: Revisor Documental PNI JS V8.

   Este módulo agrega reglas derivadas del listado de documentos del
   marco regulatorio PNI entregado por el usuario. No reemplaza la
   biblioteca base; la amplía.
   ========================================================= */

(function () {
  "use strict";

  const addonRules = [
    /* =====================================================
       A. DENOMINACIONES NORMATIVAS Y DOCUMENTALES
       ===================================================== */

    {
      id: "MR-DOC-001",
      type: "Terminología",
      priority: "Media",
      pattern: /\blineamiento tecnico operativo\b/gi,
      suggestion: "Lineamiento Técnico Operativo",
      justification: "La denominación del documento debe escribirse con tildes y mayúsculas iniciales cuando corresponde al título formal.",
      reference: "Marco regulatorio PNI."
    },
    {
      id: "MR-DOC-002",
      type: "Terminología",
      priority: "Media",
      pattern: /\blineamientos tecnico operativos\b/gi,
      suggestion: "Lineamientos Técnicos Operativos",
      justification: "La denominación del documento debe escribirse con tildes y mayúsculas iniciales cuando corresponde al título formal.",
      reference: "Marco regulatorio PNI."
    },
    {
      id: "MR-DOC-003",
      type: "Terminología",
      priority: "Media",
      pattern: /\bordinario\b\s*(n|no|nro|num|numero)\b/gi,
      suggestion: "Ordinario N°",
      justification: "Se recomienda uniformar la referencia documental utilizando “Ordinario N°”.",
      reference: "Estilo documental ministerial."
    },
    {
      id: "MR-DOC-004",
      type: "Terminología",
      priority: "Media",
      pattern: /\bresolucion exenta\b/gi,
      suggestion: "Resolución Exenta",
      justification: "La denominación documental debe escribirse con tilde y mayúsculas iniciales cuando corresponde al acto administrativo.",
      reference: "Estilo documental ministerial."
    },
    {
      id: "MR-DOC-005",
      type: "Terminología",
      priority: "Media",
      pattern: /\bres\. exenta\b/gi,
      suggestion: "Resolución Exenta",
      justification: "En documentos formales se recomienda evitar abreviaturas si no han sido definidas previamente.",
      reference: "Estilo documental ministerial."
    },
    {
      id: "MR-DOC-006",
      type: "Terminología",
      priority: "Media",
      pattern: /\bdecreto exento\b/gi,
      suggestion: "Decreto Exento",
      justification: "La denominación documental debe escribirse con mayúsculas iniciales cuando corresponde al acto administrativo.",
      reference: "Estilo documental ministerial."
    },
    {
      id: "MR-DOC-007",
      type: "Formato",
      priority: "Baja",
      pattern: /\bNro\./g,
      suggestion: "N°",
      justification: "Se recomienda uniformar la nomenclatura de numeración en documentos ministeriales.",
      reference: "Estilo documental ministerial."
    },
    {
      id: "MR-DOC-008",
      type: "Formato",
      priority: "Baja",
      pattern: /\bNo\.\s*\d+/g,
      suggestion: "N°",
      justification: "Se recomienda uniformar la referencia a números de ordinarios, resoluciones o decretos.",
      reference: "Estilo documental ministerial."
    },

    /* =====================================================
       B. RNI, REGISTRO, SISTEMAS Y CALIDAD DE DATOS
       ===================================================== */

    {
      id: "MR-RNI-001",
      type: "Terminología",
      priority: "Media",
      pattern: /\bregistro nacional de inmunizaciones\b/g,
      suggestion: "Registro Nacional de Inmunizaciones (RNI)",
      justification: "La denominación formal debe escribirse con mayúsculas iniciales y sigla definida cuando corresponda.",
      reference: "Normativa y procedimientos RNI."
    },
    {
      id: "MR-RNI-002",
      type: "Terminología",
      priority: "Media",
      pattern: /\badministrador local\b/gi,
      suggestion: "administrador local del sistema RNI",
      justification: "Se recomienda precisar el rol cuando se refiere a la gestión de usuarios o funciones en RNI.",
      reference: "Marco regulatorio RNI."
    },
    {
      id: "MR-RNI-003",
      type: "Terminología",
      priority: "Media",
      pattern: /\bclave rni\b/gi,
      suggestion: "credenciales de acceso al RNI",
      justification: "Se recomienda utilizar una formulación más técnica y compatible con gestión de usuarios.",
      reference: "Procedimientos de acceso RNI."
    },
    {
      id: "MR-RNI-004",
      type: "Terminología",
      priority: "Media",
      pattern: /\busuario rni\b/gi,
      suggestion: "usuario del RNI",
      justification: "Se recomienda explicitar la relación con el Registro Nacional de Inmunizaciones.",
      reference: "Procedimientos de acceso RNI."
    },
    {
      id: "MR-RNI-005",
      type: "Coherencia",
      priority: "Media",
      pattern: /\bregistro\b.*\bmanual\b.*\brni\b/gi,
      suggestion: "Verificar si el flujo descrito corresponde al procedimiento vigente de registro en RNI.",
      justification: "Los registros en RNI deben ajustarse a los procedimientos vigentes y a la calidad esperada del dato.",
      reference: "Guía técnica de registro de inmunizaciones."
    },
    {
      id: "MR-RNI-006",
      type: "Coherencia",
      priority: "Media",
      pattern: /\bmonitoreo\b.*\bcalidad\b.*\bregistro/gi,
      suggestion: "Precisar indicador, periodicidad y responsable del monitoreo de calidad del registro.",
      justification: "El monitoreo de calidad de datos debe quedar trazable en documentos técnicos.",
      reference: "Marco regulatorio RNI."
    },
    {
      id: "MR-RNI-007",
      type: "Terminología",
      priority: "Media",
      pattern: /\bsistema de inventario\b/gi,
      suggestion: "Sistema de Control de Inventario (SCI)",
      justification: "Se recomienda utilizar la denominación institucional completa del sistema cuando corresponda.",
      reference: "Implementación SCI PNI."
    },
    {
      id: "MR-RNI-008",
      type: "Terminología",
      priority: "Media",
      pattern: /\bsci\b/g,
      suggestion: "SCI",
      justification: "La sigla debe escribirse en mayúsculas.",
      reference: "Sistema de Control de Inventario."
    },

    /* =====================================================
       C. CADENA DE FRÍO, DVI, EXCURSIONES Y PRODUCTOS
       ===================================================== */

    {
      id: "MR-CF-001",
      type: "Ortografía",
      priority: "Media",
      pattern: /\bcadena de frio\b/gi,
      suggestion: "cadena de frío",
      justification: "La palabra “frío” debe escribirse con tilde.",
      reference: "Procedimientos de cadena de frío PNI."
    },
    {
      id: "MR-CF-002",
      type: "Ortografía",
      priority: "Media",
      pattern: /\bcamara de frio\b/gi,
      suggestion: "cámara de frío",
      justification: "La expresión debe escribirse con tildes.",
      reference: "Procedimientos de cadena de frío PNI."
    },
    {
      id: "MR-CF-003",
      type: "Ortografía",
      priority: "Media",
      pattern: /\btermometria\b/gi,
      suggestion: "termometría",
      justification: "La palabra debe escribirse con tilde.",
      reference: "Uso de instrumentos de termometría."
    },
    {
      id: "MR-CF-004",
      type: "Terminología",
      priority: "Media",
      pattern: /\bquiebre de cadena de fr[ií]o\b/gi,
      suggestion: "excursión de temperatura, si corresponde al evento descrito",
      justification: "Se recomienda verificar la terminología vigente para eventos de temperatura de productos del PNI.",
      reference: "Procedimiento de notificación y manejo de excursiones de temperatura."
    },
    {
      id: "MR-CF-005",
      type: "Terminología",
      priority: "Media",
      pattern: /\bexcursion de temperatura\b/gi,
      suggestion: "excursión de temperatura",
      justification: "La palabra debe escribirse con tilde.",
      reference: "Procedimiento de notificación y manejo de excursiones de temperatura."
    },
    {
      id: "MR-CF-006",
      type: "Terminología",
      priority: "Media",
      pattern: /\bexcursiones de temperatura\b.*\bcorreo\b/gi,
      suggestion: "Verificar si corresponde utilizar el módulo vigente de notificación de excursiones de temperatura.",
      justification: "El marco regulatorio reciente formaliza herramientas y módulos específicos para notificación.",
      reference: "Piloto del módulo de notificación de excursiones de temperatura."
    },
    {
      id: "MR-CF-007",
      type: "Terminología",
      priority: "Media",
      pattern: /\bproductos biologicos\b/gi,
      suggestion: "productos biológicos",
      justification: "La palabra debe escribirse con tilde.",
      reference: "Procedimientos de productos biológicos PNI."
    },
    {
      id: "MR-CF-008",
      type: "Terminología",
      priority: "Media",
      pattern: /\binmunoglobulinas\b/gi,
      suggestion: "inmunoglobulinas",
      justification: "Verificar que la denominación del producto corresponda al lineamiento u ordinario vigente.",
      reference: "Incorporación y uso de inmunoglobulinas."
    },
    {
      id: "MR-CF-009",
      type: "Terminología",
      priority: "Media",
      pattern: /\bdvi\b/g,
      suggestion: "DVI",
      justification: "La sigla debe escribirse en mayúsculas.",
      reference: "Depósitos de Vacunas e Inmunoglobulinas."
    },
    {
      id: "MR-CF-010",
      type: "Coherencia",
      priority: "Media",
      pattern: /\bproducto vencido\b|\bvacuna vencida\b/gi,
      suggestion: "Verificar procedimiento vigente para productos biológicos vencidos o por vencer.",
      justification: "La eliminación, devolución o manejo de productos debe ajustarse a procedimiento vigente.",
      reference: "Procedimientos de eliminación, devolución y productos por vencer."
    },

    /* =====================================================
