        referencias: ["MINSAL", "OMS", "OPS", "CDC"]
      },
      {
        nombre: "Fiebre Amarilla",
        icono: "✈️",
        tipo: "viral",
        categorias: ["viajeros", "adulto", "vigilancia"],
        vacuna: "Fiebre amarilla",
        agente: "Virus de la fiebre amarilla",
        descripcion: "Enfermedad viral hemorrágica transmitida por mosquitos en zonas endémicas.",
        transmision: "Picadura de mosquitos infectados.",
        incubacion: "Generalmente 3 a 6 días.",
        sintomas: "Fiebre, cefalea, mialgias, náuseas, vómitos e ictericia en formas graves.",
        complicaciones: "Hemorragias, insuficiencia hepática y renal, shock y muerte.",
        esquema: "Vacunación indicada para viajeros a zonas de riesgo o según requerimientos sanitarios internacionales.",
        grupo: "Viajeros y personas con indicación específica.",
        estado: "vigilancia",
        gravedad: "alta",
        situacion: "Chile no es zona endémica; la vacunación se orienta principalmente a viajeros a áreas de riesgo.",
        referencias: ["OMS", "OPS", "CDC", "MINSAL"]
      }
    ];

    const vacunasProtegen = {
      "BCG": ["Tuberculosis grave infantil"],
      "Hexavalente": ["Difteria", "Tétanos", "Coqueluche", "Poliomielitis", "Hepatitis B", "Hib"],
      "SRP": ["Sarampión", "Rubéola", "Parotiditis"],
      "Varicela": ["Varicela"],
      "Rotavirus": ["Gastroenteritis grave por rotavirus"],
      "Neumocócica": ["Enfermedad neumocócica"],
      "Meningocócica ACWY": ["Enfermedad meningocócica"],
      "VPH": ["Cánceres asociados a VPH", "Infección por VPH"],
      "Influenza": ["Influenza estacional"],
      "COVID-19": ["COVID-19 grave"],
      "Nirsevimab": ["Enfermedad grave por VRS"],
      "Hepatitis A": ["Hepatitis A"],
      "Fiebre amarilla": ["Fiebre amarilla"]
    };

    let filtroActivo = "todos";

    function normalizar(texto) {
      return String(texto || "")
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "");
    }

    function coincideFiltro(e, filtro) {
      if (filtro === "todos") return true;
      if (e.tipo === filtro) return true;
      if ((e.categorias || []).includes(filtro)) return true;
      return false;
    }

    function obtenerResultados() {
      const texto = normalizar(search.value);
      return enfermedades.filter(e => {
        const textoBusqueda = normalizar([
          e.nombre,
          e.tipo,
          e.vacuna,
          e.agente,
          e.descripcion,
          e.grupo,
          ...(e.categorias || [])
        ].join(" "));
        return coincideFiltro(e, filtroActivo) && textoBusqueda.includes(texto);
      });
    }

    function etiquetaEstado(estado) {
      if (estado === "eliminada") return "Eliminada en Chile";
      if (estado === "controlada") return "Controlada por vacunación";
      return "Vigilancia activa";
    }

    function claseGravedad(gravedad) {
      if (gravedad === "alta") return "alta";
      if (gravedad === "media") return "media";
      return "baja";
    }

    function iconoVisual(e) {
      const esBacteriana = e.tipo === "bacteriana";
      const respiratoria = (e.categorias || []).includes("respiratoria");
      const escolar = (e.categorias || []).includes("escolar");
      const adulto = (e.categorias || []).includes("adulto");
      const viajero = (e.categorias || []).includes("viajeros");

      if (viajero) {
        return `<svg viewBox="0 0 64 64" aria-hidden="true"><path d="M8 36l48-20-11 39-10-17-14 12 4-18L8 36z" fill="currentColor"/></svg>`;
      }
      if (respiratoria) {
        return `<svg viewBox="0 0 64 64" aria-hidden="true"><path d="M29 8h6v22c3-6 8-11 15-11 7 0 11 7 11 17 0 13-7 21-17 21-7 0-10-5-10-11V36h-4v10c0 6-3 11-10 11C10 57 3 49 3 36c0-10 4-17 11-17 7 0 12 5 15 11V8z" fill="currentColor"/></svg>`;
      }
      if (esBacteriana) {
        return `<svg viewBox="0 0 64 64" aria-hidden="true"><path d="M45 7c9 5 12 18 7 31S35 61 21 57C9 54 7 42 12 30S32 0 45 7zm-8 12a4 4 0 100 8 4 4 0 000-8zm-15 8a3 3 0 100 6 3 3 0 000-6zm19 15a3 3 0 100 6 3 3 0 000-6z" fill="currentColor"/></svg>`;
      }
      if (escolar || adulto) {
        return `<svg viewBox="0 0 64 64" aria-hidden="true"><path d="M32 7l24 10v14c0 15-10 25-24 30C18 56 8 46 8 31V17L32 7zm0 10l-14 6v9c0 10 5 17 14 21 9-4 14-11 14-21v-9l-14-6z" fill="currentColor"/></svg>`;
      }
      return `<svg viewBox="0 0 64 64" aria-hidden="true"><path d="M32 6a6 6 0 016 6v4a16 16 0 0110 10h4a6 6 0 010 12h-4a16 16 0 01-10 10v4a6 6 0 01-12 0v-4a16 16 0 01-10-10h-4a6 6 0 010-12h4a16 16 0 0110-10v-4a6 6 0 016-6zm0 20a6 6 0 100 12 6 6 0 000-12z" fill="currentColor"/></svg>`;
    }

    function renderCards(lista) {
      if (!lista.length) {
        grid.innerHTML = `
          <div class="epi-empty">
            <h3>Sin resultados</h3>
            <p>No se encontraron enfermedades con los criterios seleccionados. Intente modificar el buscador o los filtros.</p>
          </div>
        `;
        return;
      }

      grid.innerHTML = lista.map((e) => `
        <article class="epi-card epi-card-${e.tipo}" data-nombre="${e.nombre}" tabindex="0" role="button" aria-label="Ver ficha de ${e.nombre}">
          <div class="epi-card-top">
            <div class="epi-card-icon svg-icon">${iconoVisual(e)}</div>
            <span class="epi-risk ${claseGravedad(e.gravedad)}">Gravedad ${e.gravedad}</span>
          </div>

          <h3>${e.nombre}</h3>

          <div class="epi-card-tags">
            <span>${e.tipo}</span>
            <span class="estado-chip estado-${e.estado}">${etiquetaEstado(e.estado)}</span>
          </div>

          <p>${e.descripcion}</p>

          <div class="epi-mini">
            <div>
              <small>Vacuna asociada</small>
              <strong>${e.vacuna}</strong>
            </div>
            <div>
              <small>Grupo objetivo</small>
              <strong>${e.grupo}</strong>
            </div>
          </div>

          <div class="epi-card-footer">
            <strong>${e.agente}</strong>
            <button type="button" class="epi-open">Ver ficha →</button>
          </div>
        </article>
      `).join("");

      grid.querySelectorAll(".epi-card").forEach(card => {
        card.addEventListener("click", () => abrirDetalle(card.dataset.nombre));
        card.addEventListener("keydown", (ev) => {
          if (ev.key === "Enter" || ev.key === " ") {
            ev.preventDefault();
            abrirDetalle(card.dataset.nombre);
          }
        });
      });
    }

    function actualizarEstadisticas() {
      const setVacunas = new Set();
      enfermedades.forEach(e => {
        String(e.vacuna).split("/").forEach(v => setVacunas.add(v.trim()));
      });

      const eliminadas = enfermedades.filter(e => e.estado === "eliminada").length;
      const controladas = enfermedades.filter(e => e.estado === "controlada").length;
      const vigilancia = enfermedades.filter(e => e.estado === "vigilancia").length;

      const statEliminadas = document.getElementById("statEliminadas");
      const statControladas = document.getElementById("statControladas");
      const statVigilancia = document.getElementById("statVigilancia");
      const statVacunas = document.getElementById("statVacunas");

      if (statEliminadas) statEliminadas.textContent = eliminadas;
      if (statControladas) statControladas.textContent = controladas;
      if (statVigilancia) statVigilancia.textContent = vigilancia;
      if (statVacunas) statVacunas.textContent = setVacunas.size;

      /* Compatibilidad con HTML V2, por si aún no se reemplazó el bloque de estadísticas */
      const statTotal = document.getElementById("statTotal");
      const statVirales = document.getElementById("statVirales");
      const statBacterianas = document.getElementById("statBacterianas");
      if (statTotal) statTotal.textContent = enfermedades.length;
      if (statVirales) statVirales.textContent = enfermedades.filter(e => e.tipo === "viral").length;
      if (statBacterianas) statBacterianas.textContent = enfermedades.filter(e => e.tipo === "bacteriana").length;
    }

    function cargarVacunas() {
      const contenedor = document.getElementById("vacunaProtege");
      if (!contenedor) return;

      contenedor.innerHTML = Object.entries(vacunasProtegen).map(([vacuna, lista], i) => `
        <details class="vacuna-card vacuna-accordion" ${i < 4 ? "open" : ""}>
          <summary>
            <span class="vacuna-summary-icon">💉</span>
            <span class="vacuna-summary-title">${vacuna}</span>
            <span class="vacuna-summary-count">${lista.length}</span>
          </summary>
          <ul>
            ${lista.map(item => `<li>${item}</li>`).join("")}
          </ul>
        </details>
      `).join("");
    }

    function cargarEstado() {
      const eliminadas = document.getElementById("estadoEliminada");
      const controladas = document.getElementById("estadoControlada");
      const vigilancia = document.getElementById("estadoVigilancia");
      if (!eliminadas || !controladas || !vigilancia) return;

      eliminadas.innerHTML = enfermedades
        .filter(e => e.estado === "eliminada")
        .map(e => `<li>${e.nombre}</li>`)
        .join("");

      controladas.innerHTML = enfermedades
        .filter(e => e.estado === "controlada")
        .map(e => `<li>${e.nombre}</li>`)
        .join("");

      vigilancia.innerHTML = enfermedades
        .filter(e => e.estado === "vigilancia")
        .map(e => `<li>${e.nombre}</li>`)
        .join("");
    }

    function abrirDetalle(nombre) {
      const enfermedad = enfermedades.find(e => e.nombre === nombre);
      const modal = document.getElementById("epiModal");
      const detalle = document.getElementById("epiDetalle");
      if (!enfermedad || !modal || !detalle) return;

      detalle.innerHTML = `
        <div class="detalle-header ${enfermedad.tipo}">
          <div class="detalle-icon svg-icon">${iconoVisual(enfermedad)}</div>
          <div>
            <div class="detalle-badge">${enfermedad.vacuna}</div>
            <h2>${enfermedad.nombre}</h2>
            <p>${enfermedad.descripcion}</p>
          </div>
        </div>

        <div class="detalle-meta">
          <span>${enfermedad.tipo}</span>
          <span>${etiquetaEstado(enfermedad.estado)}</span>
          <span>Gravedad ${enfermedad.gravedad}</span>
        </div>

        <div class="detalle-grid">
          <div class="detalle-box">
            <h4>🦠 Agente causal</h4>
            <p>${enfermedad.agente}</p>
          </div>
          <div class="detalle-box">
            <h4>📡 Transmisión</h4>
            <p>${enfermedad.transmision}</p>
          </div>
          <div class="detalle-box">
            <h4>⏳ Incubación</h4>
            <p>${enfermedad.incubacion}</p>
          </div>
          <div class="detalle-box">
            <h4>🤒 Manifestaciones clínicas</h4>
            <p>${enfermedad.sintomas}</p>
          </div>
          <div class="detalle-box">
            <h4>⚠️ Complicaciones</h4>
            <p>${enfermedad.complicaciones}</p>
          </div>
          <div class="detalle-box">
            <h4>💉 Vacuna / esquema</h4>
            <p><strong>${enfermedad.vacuna}</strong></p>
            <p>${enfermedad.esquema}</p>
          </div>
          <div class="detalle-box detalle-wide">
            <h4>👥 Grupo objetivo</h4>
            <p>${enfermedad.grupo}</p>
          </div>
          <div class="detalle-box detalle-wide">
            <h4>🇨🇱 Situación epidemiológica</h4>
            <p>${enfermedad.situacion}</p>
          </div>
          <div class="detalle-box detalle-wide">
            <h4>📚 Fuentes técnicas sugeridas</h4>
            <p>${enfermedad.referencias.join(" · ")}</p>
          </div>
        </div>
      `;

      modal.classList.add("active");
      document.body.classList.add("epi-no-scroll");
    }

    function cerrarModal() {
      const modal = document.getElementById("epiModal");
      if (modal) modal.classList.remove("active");
      document.body.classList.remove("epi-no-scroll");
    }

    function refrescar() {
      renderCards(obtenerResultados());
    }

    document.querySelectorAll(".epi-filter").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".epi-filter").forEach(b => b.classList.remove("active"));
        btn.classList.add("active");
        filtroActivo = btn.dataset.filter || "todos";
        refrescar();
      });
    });

    search.addEventListener("input", refrescar);

    const cerrar = document.getElementById("cerrarModal");
    if (cerrar) cerrar.addEventListener("click", cerrarModal);

    const modal = document.getElementById("epiModal");
    if (modal) {
      modal.addEventListener("click", e => {
        if (e.target.id === "epiModal") cerrarModal();
      });
    }

    document.addEventListener("keydown", e => {
      if (e.key === "Escape") cerrarModal();
    });

    actualizarEstadisticas();
    cargarVacunas();
    cargarEstado();
    refrescar();

    console.log("EPI APP V3 cargada correctamente:", enfermedades.length, "enfermedades");
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", () => iniciarEpiApp());
  } else {
    iniciarEpiApp();
  }
})();
</script><style class="wpcode-css-snippet">/* =====================================================
   ENFERMEDADES INMUNOPREVENIBLES · CSS COMPLETO
   PNI MINSAL · Divi + WPCode
   Reemplazar TODO el CSS anterior por este archivo
===================================================== */

.epi-app,
.epi-app *{
  box-sizing:border-box;
}

.epi-app{
  width:100%!important;
  max-width:1400px!important;
  margin:0 auto!important;
  padding:24px!important;
  font-family:inherit;
  color:#1f2937;
}

/* =====================================================
   HERO
===================================================== */

.epi-hero{
  width:100%;
  background:
    radial-gradient(circle at top right, rgba(255,255,255,.18), transparent 32%),
    linear-gradient(135deg,#004b7c 0%,#0067a8 48%,#0b7cc1 100%);
  color:#fff;
  border-radius:26px;
  padding:42px;
  margin:0 0 26px;
  box-shadow:0 18px 45px rgba(0,67,112,.22);
  overflow:hidden;
}

.epi-hero-content{
  display:flex;
  align-items:center;
  gap:26px;
}

.epi-logo{
  width:92px;
  max-width:92px;
  height:auto;
  flex:0 0 auto;
  filter:drop-shadow(0 8px 16px rgba(0,0,0,.18));
}

.epi-badge{
  display:inline-flex;
  align-items:center;
  gap:8px;
  background:rgba(255,255,255,.16);
  border:1px solid rgba(255,255,255,.22);
  color:#fff;
  padding:8px 14px;
  border-radius:999px;
  font-size:13px;
  font-weight:700;
  margin-bottom:14px;
  backdrop-filter:blur(6px);
}

.epi-hero h1{
  color:#fff!important;
  font-size:clamp(30px,4vw,48px);
  line-height:1.05;
  font-weight:800;
  letter-spacing:-.03em;
  margin:0 0 14px!important;
  padding:0!important;
}

.epi-hero p{
  color:rgba(255,255,255,.94);
  font-size:18px;
  line-height:1.55;
  max-width:820px;
  margin:0!important;
  padding:0!important;
}

.epi-search-wrap{
  margin-top:30px;
  position:relative;
}

#epiSearch{
  width:100%!important;
  display:block;
  border:0!important;
  outline:none!important;
  border-radius:18px!important;
  padding:18px 22px!important;
  font-size:16px!important;
  color:#0f172a!important;
  background:#fff!important;
  box-shadow:0 12px 28px rgba(0,0,0,.18)!important;
}

#epiSearch::placeholder{
  color:#64748b;
}

/* =====================================================
   ESTADÍSTICAS
===================================================== */

.epi-stats{
  display:grid!important;
  grid-template-columns:repeat(4,minmax(0,1fr))!important;
  gap:18px!important;
  width:100%;
  margin:0 0 26px!important;
}

.epi-stat{
  background:#fff;
  border:1px solid rgba(15,23,42,.08);
  border-radius:22px;
  padding:24px 18px;
  text-align:center;
  box-shadow:0 8px 24px rgba(15,23,42,.07);
}

.epi-stat span{
  display:block;
  color:#005b96;
  font-size:36px;
  line-height:1;
  font-weight:850;
  letter-spacing:-.03em;
  margin-bottom:8px;
}

.epi-stat small{
  display:block;
  color:#64748b;
  font-size:13px;
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.04em;
}

/* =====================================================
   FILTROS
===================================================== */

.epi-filters{
  display:flex!important;
  flex-wrap:wrap!important;
  align-items:center;
  gap:11px!important;
  margin:0 0 28px!important;
  width:100%;
}

.epi-filter{
  appearance:none;
  border:1px solid rgba(15,23,42,.08)!important;
  background:#f8fafc!important;
  color:#334155!important;
  border-radius:14px!important;
  padding:12px 16px!important;
  cursor:pointer;
  font-weight:800!important;
  font-size:14px!important;
  line-height:1!important;
  transition:transform .18s ease, box-shadow .18s ease, background .18s ease, color .18s ease;
  box-shadow:0 4px 12px rgba(15,23,42,.04);
}

.epi-filter:hover{
  transform:translateY(-2px);
  box-shadow:0 10px 20px rgba(15,23,42,.08);
}

.epi-filter.active{
  background:#005b96!important;
  color:#fff!important;
  border-color:#005b96!important;
  box-shadow:0 10px 22px rgba(0,91,150,.22);
}

/* =====================================================
   GRID Y TARJETAS
===================================================== */

.epi-grid{
  width:100%!important;
  display:grid!important;
  grid-template-columns:repeat(4,minmax(0,1fr))!important;
  gap:22px!important;
  margin:0 0 36px!important;
}

.epi-card{
  width:100%!important;
  min-width:0!important;
  min-height:285px;
  display:flex!important;
  flex-direction:column!important;
  justify-content:flex-start!important;
  position:relative;
  overflow:hidden;
  cursor:pointer;
  background:#fff;
  border:1px solid rgba(15,23,42,.08);
  border-radius:22px;
  padding:22px;
  box-shadow:0 8px 24px rgba(15,23,42,.07);
  transition:transform .22s ease, box-shadow .22s ease, border-color .22s ease;
}

.epi-card::before{
  content:"";
  position:absolute;
  top:0;
  left:0;
  right:0;
  height:6px;
  background:linear-gradient(90deg,#0284c7,#38bdf8);
}

.epi-card-bacteriana::before{
  background:linear-gradient(90deg,#7c3aed,#a78bfa);
}

.epi-card:hover{
  transform:translateY(-6px);
  box-shadow:0 18px 36px rgba(15,23,42,.13);
  border-color:rgba(0,91,150,.25);
}

.epi-card-top{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin-bottom:14px;
}

.epi-card-icon{
  width:58px;
  height:58px;
  min-width:58px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:18px;
  background:#eff8ff;
  font-size:32px;
  line-height:1;
}

.epi-card-bacteriana .epi-card-icon{
  background:#f3e8ff;
}

.epi-card h3{
  color:#0f172a!important;
  font-size:21px!important;
  line-height:1.18!important;
  font-weight:850!important;
  letter-spacing:-.02em;
  margin:0 0 10px!important;
  padding:0!important;
}

.epi-card p{
  color:#475569!important;
  font-size:14px!important;
  line-height:1.55!important;
  margin:0 0 16px!important;
  padding:0!important;
}

.epi-card-tags{
  display:flex;
  flex-wrap:wrap;
  gap:7px;
  margin:0 0 13px;
}

.epi-card-tags span,
.epi-card-tipo{
  display:inline-flex;
  align-items:center;
  width:auto;
  background:#e8f4fd;
  color:#005b96;
  border-radius:999px;
  padding:5px 10px;
  font-size:11px;
  font-weight:850;
  text-transform:capitalize;
  line-height:1.2;
}

.epi-card-bacteriana .epi-card-tags span{
  background:#f3e8ff;
  color:#6d28d9;
}

.epi-risk{
  display:inline-flex;
  align-items:center;
  border-radius:999px;
  padding:6px 9px;
  font-size:10px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.04em;
  line-height:1;
}

.epi-risk.alta{
  background:#fee2e2;
  color:#991b1b;
}

.epi-risk.media{
  background:#fff7db;
  color:#92400e;
}

.epi-risk.baja{
  background:#dcfce7;
  color:#166534;
}

.epi-card-footer{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:12px;
  margin-top:auto;
  padding-top:14px;
  border-top:1px solid #eef2f7;
}

.epi-card-footer strong{
  color:#005b96;
  font-size:13px;
  line-height:1.25;
  font-weight:850;
}

.epi-open{
  appearance:none;
  border:0!important;
  background:#005b96!important;
  color:#fff!important;
  border-radius:999px!important;
  padding:9px 13px!important;
  font-weight:850!important;
  font-size:12px!important;
  line-height:1!important;
  cursor:pointer;
  white-space:nowrap;
}

.epi-empty{
  grid-column:1/-1;
  background:#fff;
  border:1px dashed rgba(15,23,42,.18);
  border-radius:22px;
  padding:34px;
  text-align:center;
  box-shadow:0 8px 24px rgba(15,23,42,.05);
}

.epi-empty h3{
  color:#0f172a!important;
  margin:0 0 8px!important;
  padding:0!important;
}

.epi-empty p{
  color:#64748b!important;
  margin:0!important;
  padding:0!important;
}

/* =====================================================
   PANELES
===================================================== */

.epi-panel{
  width:100%;
  background:#fff;
  border:1px solid rgba(15,23,42,.08);
  border-radius:26px;
  padding:28px;
  margin:0 0 28px!important;
  box-shadow:0 8px 24px rgba(15,23,42,.07);
}

.epi-panel h2{
  color:#0f172a!important;
  font-size:26px!important;
  line-height:1.2!important;
  font-weight:850!important;
  letter-spacing:-.02em;
  margin:0 0 20px!important;
  padding:0!important;
}

/* =====================================================
   VACUNAS
===================================================== */

.vacuna-grid{
  display:grid!important;
  grid-template-columns:repeat(4,minmax(0,1fr))!important;
  gap:16px!important;
}

.vacuna-card{
  background:#f8fafc;
  border:1px solid rgba(15,23,42,.08);
  border-radius:18px;
  padding:18px;
  transition:transform .18s ease, box-shadow .18s ease;
}

.vacuna-card:hover{
  transform:translateY(-3px);
  box-shadow:0 12px 24px rgba(15,23,42,.10);
}

.vacuna-card-head{
  display:flex;
  align-items:center;
  gap:9px;
  margin-bottom:10px;
}

.vacuna-card h3{
  color:#005b96!important;
  font-size:18px!important;
  font-weight:850!important;
  margin:0!important;
  padding:0!important;
}

.vacuna-card ul,
.estado-card ul{
  margin:0!important;
  padding:0 0 0 18px!important;
  list-style:disc!important;
}

.vacuna-card li,
.estado-card li{
  color:#334155;
  font-size:14px;
  line-height:1.45;
  padding:3px 0;
}

/* =====================================================
   ESTADO CHILE
===================================================== */

.estado-grid{
  display:grid!important;
  grid-template-columns:repeat(3,minmax(0,1fr))!important;
  gap:18px!important;
}

.estado-card{
  border-radius:20px;
  padding:20px;
  border:1px solid rgba(15,23,42,.06);
}

.estado-card h3{
  color:#0f172a!important;
  font-size:19px!important;
  font-weight:850!important;
  margin:0 0 12px!important;
  padding:0!important;
}

.verde{
  background:#e8f7ec!important;
}

.amarillo{
  background:#fff7db!important;
}

.azul{
  background:#eaf4ff!important;
}

/* =====================================================
   TIMELINE
===================================================== */

.timeline{
  display:grid!important;
  grid-template-columns:repeat(6,minmax(0,1fr))!important;
  gap:14px!important;
}

.timeline-item{
  background:#f8fafc;
  border:1px solid rgba(15,23,42,.08);
  border-radius:18px;
  padding:16px;
  text-align:center;
}

.timeline-item span{
  display:block;
  color:#005b96;
  font-size:23px;
  font-weight:900;
  line-height:1;
  margin-bottom:8px;
}

.timeline-item p{
  color:#475569!important;
  font-size:13px!important;
  line-height:1.35!important;
  margin:0!important;
  padding:0!important;
}

/* =====================================================
   MODAL
===================================================== */

.epi-modal{
  position:fixed;
  inset:0;
  z-index:999999;
  display:none;
  align-items:center;
  justify-content:center;
  background:rgba(2,6,23,.76);
  padding:22px;
}

.epi-modal.active{
  display:flex!important;
}

.epi-modal-content{
  width:min(940px,100%);
  max-height:90vh;
  overflow:auto;
  position:relative;
  background:#fff;
  border-radius:26px;
  padding:30px;
  box-shadow:0 30px 80px rgba(0,0,0,.35);
}

#cerrarModal{
  position:sticky;
  top:0;
  float:right;
  z-index:3;
  display:flex;
  align-items:center;
  justify-content:center;
  width:42px;
  height:42px;
  border:0!important;
  border-radius:999px!important;
  background:#f1f5f9!important;
  color:#0f172a!important;
  cursor:pointer;
  font-size:18px!important;
  font-weight:900!important;
}

.detalle-header{
  display:flex;
  gap:18px;
  align-items:center;
  padding:22px;
  border-radius:22px;
  background:linear-gradient(135deg,#eef8ff,#ffffff);
  margin:0 0 16px;
}

.detalle-header.bacteriana{
  background:linear-gradient(135deg,#f3e8ff,#ffffff);
}

.detalle-icon{
  width:76px;
  height:76px;
  min-width:76px;
  border-radius:24px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#fff;
  font-size:42px;
  line-height:1;
  box-shadow:0 8px 24px rgba(15,23,42,.08);
}

.detalle-badge{
  display:inline-flex;
  align-items:center;
  background:#e8f4fd;
  color:#005b96;
  padding:7px 12px;
  border-radius:999px;
  margin:0 0 10px;
  font-size:12px;
  font-weight:850;
}

.detalle-header h2{
  color:#0f172a!important;
  font-size:30px!important;
  line-height:1.1!important;
  font-weight:900!important;
  letter-spacing:-.02em;
  margin:0 0 8px!important;
  padding:0!important;
}

.detalle-header p{
  color:#475569!important;
  line-height:1.55!important;
  margin:0!important;
  padding:0!important;
}

.detalle-meta{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin:14px 0 20px;
}

.detalle-meta span{
  background:#f1f5f9;
  color:#334155;
  border-radius:999px;
  padding:7px 12px;
  font-size:12px;
  font-weight:850;
  text-transform:capitalize;
}

.detalle-grid{
  display:grid!important;
  grid-template-columns:repeat(2,minmax(0,1fr))!important;
  gap:16px!important;
  margin-top:18px;
}

.detalle-box{
  background:#f8fafc;
  border:1px solid rgba(15,23,42,.07);
  border-radius:18px;
  padding:18px;
}

.detalle-box h4{
  color:#005b96!important;
  font-size:16px!important;
  font-weight:850!important;
  line-height:1.25!important;
  margin:0 0 8px!important;
  padding:0!important;
}

.detalle-box p{
  color:#475569!important;
  font-size:14px!important;
  line-height:1.55!important;
  margin:0!important;
  padding:0!important;
}

.detalle-wide{
  grid-column:1/-1;
}

.epi-no-scroll{
  overflow:hidden!important;
}

/* =====================================================
   RESPONSIVE
===================================================== */

@media(max-width:1280px){
  .epi-grid{
    grid-template-columns:repeat(3,minmax(0,1fr))!important;
  }

  .vacuna-grid{
    grid-template-columns:repeat(3,minmax(0,1fr))!important;
  }

  .timeline{
    grid-template-columns:repeat(3,minmax(0,1fr))!important;
  }
}

@media(max-width:980px){
  .epi-app{
    padding:18px!important;
  }

  .epi-hero{
    padding:32px;
  }

  .epi-hero-content{
    flex-direction:column;
    align-items:flex-start;
    text-align:left;
  }

  .epi-stats{
    grid-template-columns:repeat(2,minmax(0,1fr))!important;
  }

  .epi-grid{
    grid-template-columns:repeat(2,minmax(0,1fr))!important;
  }

  .vacuna-grid{
    grid-template-columns:repeat(2,minmax(0,1fr))!important;
  }

  .estado-grid{
    grid-template-columns:1fr!important;
  }

  .detalle-grid{
    grid-template-columns:1fr!important;
  }

  .detalle-header{
    align-items:flex-start;
  }
}

@media(max-width:640px){
  .epi-app{
    padding:14px!important;
  }

  .epi-hero{
    padding:26px;
    border-radius:22px;
  }

  .epi-logo{
    width:74px;
    max-width:74px;
  }

  .epi-hero p{
    font-size:15px;
  }

  .epi-stats{
    grid-template-columns:1fr!important;
  }

  .epi-filter{
    width:100%;
    justify-content:center;
  }

  .epi-grid{
    grid-template-columns:1fr!important;
  }

  .epi-card{
    min-height:auto;
  }

  .epi-card-footer{
    flex-direction:column;
    align-items:flex-start;
  }

  .epi-open{
    width:100%;
    text-align:center;
  }

  .vacuna-grid{
    grid-template-columns:1fr!important;
  }

  .timeline{
    grid-template-columns:1fr!important;
  }

  .epi-modal{
    padding:12px;
  }

  .epi-modal-content{
    padding:20px;
    border-radius:22px;
  }

  .detalle-header{
    flex-direction:column;
  }

  .detalle-header h2{
    font-size:24px!important;
  }
}


/* =====================================================
   V3 · ESTADÍSTICAS EPIDEMIOLÓGICAS, TARJETAS ENRIQUECIDAS
   Y ACORDEÓN DE VACUNAS
===================================================== */

.epi-stat{
  position:relative;
  overflow:hidden;
}

.epi-stat::after{
  content:"";
  position:absolute;
  right:-22px;
  top:-22px;
  width:80px;
  height:80px;
  border-radius:999px;
  background:rgba(255,255,255,.5);
}

.epi-stat-icon{
  position:relative;
  z-index:1;
  font-size:30px;
  line-height:1;
  margin-bottom:8px;
}

.epi-stat.eliminada{background:#e8f7ec!important}
.epi-stat.controlada{background:#fff7db!important}
.epi-stat.vigilancia{background:#eaf4ff!important}
.epi-stat.vacuna{background:#eef6fc!important}

.epi-card{
  min-height:340px!important;
}

.epi-card-icon.svg-icon,
.detalle-icon.svg-icon{
  color:#005b96;
}

.epi-card-bacteriana .epi-card-icon.svg-icon,
.detalle-header.bacteriana .detalle-icon.svg-icon{
  color:#7c3aed;
}

.svg-icon svg{
  width:34px;
  height:34px;
  display:block;
}

.detalle-icon.svg-icon svg{
  width:44px;
  height:44px;
}

.estado-chip{
  max-width:100%;
}

.estado-eliminada{
  background:#dcfce7!important;
  color:#166534!important;
}

.estado-controlada{
  background:#fef3c7!important;
  color:#92400e!important;
}

.estado-vigilancia{
  background:#dbeafe!important;
  color:#1d4ed8!important;
}

.epi-mini{
  display:grid;
  grid-template-columns:1fr;
  gap:9px;
  margin:4px 0 16px;
}

.epi-mini div{
  background:#f8fafc;
  border:1px solid rgba(15,23,42,.06);
  border-radius:14px;
  padding:10px 12px;
}

.epi-mini small{
  display:block;
  color:#64748b;
  font-size:11px;
  line-height:1.2;
  font-weight:850;
  text-transform:uppercase;
  letter-spacing:.04em;
  margin-bottom:4px;
}

.epi-mini strong{
  display:block;
  color:#0f172a;
  font-size:13px;
  line-height:1.25;
  font-weight:850;
}

.epi-card-footer strong{
  max-width:58%;
  overflow:hidden;
  display:-webkit-box;
  -webkit-line-clamp:2;
  -webkit-box-orient:vertical;
}

.vacuna-grid{
  align-items:start;
}

.vacuna-accordion{
  padding:0!important;
  overflow:hidden;
}

.vacuna-accordion summary{
  list-style:none;
  cursor:pointer;
  display:grid;
  grid-template-columns:auto 1fr auto;
  align-items:center;
  gap:10px;
  padding:16px 18px;
  background:#f8fafc;
  border-radius:18px;
}

.vacuna-accordion summary::-webkit-details-marker{
  display:none;
}

.vacuna-accordion summary::after{
  content:"▾";
  color:#005b96;
  font-size:14px;
  font-weight:900;
  transition:transform .2s ease;
}

.vacuna-accordion[open] summary::after{
  transform:rotate(180deg);
}

.vacuna-summary-icon{
  display:flex;
  align-items:center;
  justify-content:center;
  width:34px;
  height:34px;
  border-radius:12px;
  background:#e8f4fd;
}

.vacuna-summary-title{
  color:#005b96;
  font-size:17px;
  font-weight:900;
  line-height:1.2;
}

.vacuna-summary-count{
  display:flex;
  align-items:center;
  justify-content:center;
  min-width:26px;
  height:26px;
  border-radius:999px;
  background:#005b96;
  color:#fff;
  font-size:12px;
  font-weight:900;
}

.vacuna-accordion ul{
  padding:0 20px 18px 46px!important;
  margin-top:0!important;
}

.vacuna-accordion li{
  border-bottom:1px solid rgba(15,23,42,.06);
  padding:7px 0!important;
}

.vacuna-accordion li:last-child{
  border-bottom:0;
}

@media(max-width:640px){
  .epi-card{
    min-height:auto!important;
  }

  .epi-card-footer strong{
    max-width:100%;
  }

  .epi-mini{
    grid-template-columns:1fr;
  }
}
