{
  "id": "asplenia_hiposplenia_asplenia_congenita",
  "grupo": "Asplenia / hiposplenia",
  "nombre": "Asplenia congénita",
  "vacunas": [
    {
      "nombre": "Neumocócica conjugada",
      "esquema": "Según edad y antecedente vacunal",
      "inicio": "Al diagnóstico o según edad",
      "observacion": "Vacuna prioritaria por riesgo permanente de infección invasora por bacterias capsuladas."
    },
    {
      "nombre": "Neumocócica polisacárida 23v",
      "esquema": "1 dosis desde los 2 años; considerar refuerzo según normativa vigente",
      "inicio": "Posterior a vacuna neumocócica conjugada",
      "observacion": "Administrar posterior a vacuna conjugada respetando intervalo mínimo."
    },
    {
      "nombre": "Haemophilus influenzae tipo b (Hib)",
      "esquema": "1 dosis si no existe antecedente vacunal completo o confiable",
      "inicio": "Al diagnóstico o según edad",
      "observacion": "Fundamental para protección frente a bacterias capsuladas."
    },
    {
      "nombre": "Meningocócica ACWY",
      "esquema": "Según edad y antecedente vacunal; considerar refuerzos si riesgo persiste",
      "inicio": "Al diagnóstico o según edad",
      "observacion": "Vacuna prioritaria por riesgo de enfermedad meningocócica invasora."
    },
    {
      "nombre": "Meningocócica B",
      "esquema": "Según edad y formulación disponible",
      "inicio": "Al diagnóstico o según edad",
      "observacion": "Especialmente recomendada por alto riesgo de enfermedad meningocócica invasora."
    },
    {
      "nombre": "Influenza",
      "esquema": "1 dosis anual",
      "inicio": "Campaña anual",
      "observacion": "Vacunación anual recomendada durante toda la vida."
    }
  ],
  "notas": [
    "Condición de riesgo permanente para infección invasora por bacterias capsuladas.",
    "Mantener esquema PNI al día según edad; el visor destaca las vacunas específicas de riesgo para asplenia."
  ],
  "fuente": "Manual de Vacunación Especial, actualización 2025",
  "paginas": "Capítulo Asplenia / hiposplenia"
},
