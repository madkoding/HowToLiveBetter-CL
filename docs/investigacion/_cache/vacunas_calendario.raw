        reference: "Lineamientos vigentes."
      },
      {
        id: "TEC-004",
        type: "Coherencia",
        priority: "Media",
        pattern: /\bvrs\b.*\blactantes\b/gi,
        suggestion: "Verificar que la población objetivo descrita corresponda a la estrategia vigente de inmunización contra VRS.",
        justification: "La estrategia VRS debe describirse según lineamientos vigentes y cohorte definida.",
        reference: "Estrategia VRS."
      },
      {
        id: "TEC-005",
        type: "Coherencia",
        priority: "Media",
        pattern: /\bcovid\b.*\bgrupo objetivo\b/gi,
        suggestion: "Verificar que los grupos objetivo COVID-19 estén actualizados según estrategia vigente.",
        justification: "Los grupos priorizados pueden cambiar según la campaña anual o indicación sanitaria.",
        reference: "Lineamientos COVID-19."
      },
      {
        id: "TEC-006",
        type: "Coherencia",
        priority: "Media",
        pattern: /\bvph\b.*\bescolar\b/gi,
        suggestion: "Verificar que el nivel escolar y esquema descrito correspondan al calendario vigente.",
        justification: "Las estrategias escolares deben revisarse contra el calendario anual vigente.",
        reference: "Calendario de vacunación."
      },
      {
        id: "TEC-007",
        type: "Coherencia",
        priority: "Media",
        pattern: /\bsrp\b.*\bviajer/i,
        suggestion: "Verificar indicación para viajeros según lineamiento vigente.",
        justification: "Las recomendaciones para viajeros deben actualizarse según riesgo epidemiológico y normativa vigente.",
        reference: "Lineamientos sarampión/viajeros."
      },
      {
        id: "TEC-008",
        type: "Coherencia",
        priority: "Media",
        pattern: /\besquema\b.*\búnica dosis\b/gi,
        suggestion: "Verificar si el esquema descrito corresponde al producto y grupo objetivo señalado.",
        justification: "Las menciones a esquemas de vacunación deben contrastarse con el calendario o lineamiento vigente.",
        reference: "Calendario y lineamientos PNI."
      },

      /* =====================================================
         7. FORMATO
         Reglas más conservadoras. El JS principal filtra URLs,
         correos y dominios antes de mostrar observaciones.
         ===================================================== */

      {
        id: "FOR-001",
        type: "Formato",
        priority: "Baja",
        pattern: /[ \t]+([,.;:])/g,
        suggestion: "Eliminar el espacio previo al signo de puntuación.",
        justification: "La puntuación debe adherirse a la palabra anterior.",
        reference: "Formato documental."
      },
      {
        id: "FOR-002",
        type: "Formato",
        priority: "Baja",
        pattern: /[,;:][A-Za-zÁÉÍÓÚÑáéíóúñ]/g,
        suggestion: "Agregar un espacio después del signo de puntuación, cuando corresponda.",
        justification: "La separación posterior a signos de puntuación mejora la legibilidad.",
        reference: "Formato documental."
      },
      {
        id: "FOR-003",
        type: "Formato",
        priority: "Baja",
        pattern: /\b\d{1,2}[-/]\d{1,2}[-/]\d{2,4}\b/g,
        suggestion: "Verificar consistencia del formato de fecha en todo el documento.",
        justification: "La uniformidad en fechas mejora la trazabilidad y presentación institucional.",
        reference: "Formato documental."
      }
    ]
  };

  window.PNI_RULE_ENGINE = {
    applyRulesToParagraph(paragraph, paragraphNumber, pageNumber) {
      const findings = [];

      if (!window.PNI_RULES_LIBRARY || !Array.isArray(window.PNI_RULES_LIBRARY.rules)) {
        return findings;
      }

      window.PNI_RULES_LIBRARY.rules.forEach((rule) => {
        if (!rule.pattern) return;

        const regex = resetRegex(rule.pattern);
        const matches = [...String(paragraph || "").matchAll(regex)];

        if (!matches.length) return;

        matches.forEach((match) => {
          const detectedText = match[0];

          if (!detectedText || isFalsePositive(rule, detectedText, paragraph)) return;

          findings.push({
            pagina: pageNumber || 1,
            parrafo: paragraphNumber || 1,
            tipo: rule.type || "Redacción",
            prioridad: rule.priority || "Media",
            texto: detectedText,
            sugerencia: rule.suggestion || "",
            justificacion: rule.justification || "",
            referencia: rule.reference || "",
            regla: rule.id || ""
          });
        });
      });

      return findings;
    },

    getRulesCount() {
      return window.PNI_RULES_LIBRARY?.rules?.length || 0;
    }
  };

  function resetRegex(regex) {
    const flags = regex.flags.includes("g") ? regex.flags : regex.flags + "g";
    return new RegExp(regex.source, flags);
  }

  function isFalsePositive(rule, detectedText, paragraph) {
    const text = String(detectedText || "");
    const full = String(paragraph || "");

    const allowedCorrectTerms = [
      "inmunizaciones",
      "Inmunizaciones",
      "vacunarse",
      "Vacunarse",
      "varicela",
      "Varicela"
    ];

    if (allowedCorrectTerms.includes(text)) return true;

    const correctSiglas = [
      "PNI",
      "MINSAL",
      "SEREMI",
      "DEIS",
      "DIPRECE",
      "ISP",
      "CAVEI",
      "OIRS",
      "RNI",
      "SRP",
      "VPH",
      "VRS",
      "BCG",
      "ESAVI",
      "EAPV"
    ];

    if (correctSiglas.includes(text)) return true;

    const correctInstitutionalNames = [
      "Ministerio de Salud",
      "Subsecretaría de Salud Pública",
      "Programa Nacional de Inmunizaciones"
    ];

    if (correctInstitutionalNames.includes(text)) return true;

    // Filtro adicional para formato en URLs, correos, dominios, rutas o versiones.
    if (rule.id && rule.id.startsWith("FOR-")) {
      const idx = full.indexOf(text);

      if (idx >= 0) {
        const nearby = full.slice(Math.max(0, idx - 60), Math.min(full.length, idx + text.length + 60));
        if (/https?:\/\/|www\.|@|\.cl|\.gob|\.org|\.com|\.net|\/uploads|\/wp-content|\d+\.\d+/i.test(nearby)) {
          return true;
        }
      }

      if (/^\.[A-Za-zÁÉÍÓÚÑáéíóúñ]$/.test(text)) return true;
      if (/^[:.]\/$/.test(text)) return true;
      if (/^\.\)$/.test(text)) return true;
      if (/^\.,$/.test(text)) return true;
    }

    return false;
  }
})();
</script><script>/* =========================================================
   PNI INSIGHT — REVISOR DOCUMENTAL PNI — JS V12
   PARTE 1/10 — Configuración, inicio, carga DOCX/PDF
   ========================================================= */

(function () {
  "use strict";

  var PNI = {
    findings: [],
    longParagraphs: [],
    executive: null,
    documentProfile: null,

    config: {
      pdfWorker:
        "https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js",
      maxGroupedExamples: 6,
      longParagraphWords: 280,
      longParagraphCharacters: 1900,
      veryLongSentenceWords: 65
    }
  };

  var $ = function (id) {
    return document.getElementById(id);
  };

  document.addEventListener("DOMContentLoaded", function () {
    initPNIInsight();
  });

  function initPNIInsight() {
    configurePdfJs();
    bindEvents();
    resetExecutivePanel();
  }

  function bindEvents() {
    var analyzeBtn = $("pniAnalyzeBtn");
    var clearBtn = $("pniClearBtn");
    var exportBtn = $("pniExportBtn");
    var exportReportBtn = $("pniExportReportBtn");
    var searchInput = $("pniSearchFindings");
    var filterType = $("pniFilterType");
    var filterPriority = $("pniFilterPriority");
    var uploadBtn = $("pniUploadBtn");
    var docFile = $("pniDocFile");
    var dropZone = $("pniDropZone");

    if (analyzeBtn) {
      analyzeBtn.addEventListener("click", function () {
        try {
          analyzeDocument();
        } catch (error) {
          console.error("Error en revisión PNI:", error);
          renderErrorRow(
            "Ocurrió un error durante la revisión. Verifique que el JS esté completo y que la biblioteca de reglas esté cargada antes del revisor."
          );
        }
      });
    }

    if (clearBtn) clearBtn.addEventListener("click", clearDocument);
    if (exportBtn) exportBtn.addEventListener("click", exportCSV);
    if (exportReportBtn) exportReportBtn.addEventListener("click", exportExecutiveHTML);
    if (searchInput) searchInput.addEventListener("input", renderFindings);
    if (filterType) filterType.addEventListener("change", renderFindings);
    if (filterPriority) filterPriority.addEventListener("change", renderFindings);

    if (uploadBtn && docFile) {
      uploadBtn.addEventListener("click", function () {
        docFile.click();
      });

      docFile.addEventListener("change", function (event) {
        var file = event.target.files && event.target.files[0];
        if (!file) return;
        readSelectedFile(file);
      });
    }

    if (dropZone && docFile) {
      ["dragenter", "dragover"].forEach(function (eventName) {
        dropZone.addEventListener(eventName, function (event) {
          event.preventDefault();
          event.stopPropagation();
          dropZone.classList.add("dragover");
        });
      });

      ["dragleave", "drop"].forEach(function (eventName) {
        dropZone.addEventListener(eventName, function (event) {
          event.preventDefault();
          event.stopPropagation();
          dropZone.classList.remove("dragover");
        });
      });

      dropZone.addEventListener("drop", function (event) {
        event.preventDefault();
        event.stopPropagation();

        var files = event.dataTransfer && event.dataTransfer.files;
        if (!files || !files.length) return;

        readSelectedFile(files[0]);
      });
    }
  }

  function configurePdfJs() {
    if (window.pdfjsLib) {
      window.pdfjsLib.GlobalWorkerOptions.workerSrc = PNI.config.pdfWorker;
    }
  }

  async function readSelectedFile(file) {
    var lowerName = (file.name || "").toLowerCase();

    if (!lowerName.endsWith(".docx") && !lowerName.endsWith(".pdf")) {
      setFileStatus(
        "Formato no compatible. Se permiten archivos Word (.docx) y PDF (.pdf).",
        "error"
      );
      return;
    }

    try {
      if (lowerName.endsWith(".docx")) {
        await readDocxFile(file);
      }

      if (lowerName.endsWith(".pdf")) {
        await readPdfFile(file);
      }
    } catch (error) {
      console.error(error);
      setFileStatus("No fue posible leer el archivo seleccionado.", "error");
    }
  }

  async function readDocxFile(file) {
    if (!window.mammoth) {
      setFileStatus("No se pudo cargar la librería de lectura Word.", "error");
      return;
    }

    setFileStatus("Leyendo documento Word...", "");

    var arrayBuffer = await file.arrayBuffer();
    var result = await window.mammoth.extractRawText({ arrayBuffer: arrayBuffer });
    var extractedText = result.value || "";

    if (!extractedText.trim()) {
      setFileStatus(
        "El archivo Word fue leído, pero no se detectó texto utilizable.",
        "error"
      );
      return;
    }

    if ($("pniDocTitle")) {
      $("pniDocTitle").value = file.name.replace(/\.docx$/i, "");
    }

    if ($("pniDocText")) {
      $("pniDocText").value = normalizeInputText(extractedText);
    }

    setFileStatus("Archivo Word cargado correctamente: " + file.name, "ok");
  }

  async function readPdfFile(file) {
    if (!window.pdfjsLib) {
      setFileStatus("No se pudo cargar la librería de lectura PDF.", "error");
      return;
    }

    setFileStatus("Leyendo documento PDF...", "");

    var arrayBuffer = await file.arrayBuffer();
    var pdf = await window.pdfjsLib.getDocument({ data: arrayBuffer }).promise;
    var fullText = "";

    for (var pageNumber = 1; pageNumber <= pdf.numPages; pageNumber++) {
      var page = await pdf.getPage(pageNumber);
      var content = await page.getTextContent();

      var strings = content.items
        .map(function (item) {
          return item.str;
        })
        .filter(Boolean);

      var pageText = normalizeExtractedPdfText(strings.join(" "));

      if (pageText.trim()) {
        fullText += "\n\n[Página " + pageNumber + "]\n" + pageText;
      }
    }

    if (!fullText.trim()) {
      setFileStatus(
        "El PDF fue leído, pero no se detectó texto utilizable. Puede tratarse de un PDF escaneado como imagen.",
        "error"
      );
      return;
    }

    if ($("pniDocTitle")) {
      $("pniDocTitle").value = file.name.replace(/\.pdf$/i, "");
    }

    if ($("pniDocText")) {
      $("pniDocText").value = fullText.trim();
    }

    setFileStatus("Archivo PDF cargado correctamente: " + file.name, "ok");
  }

  function normalizeInputText(text) {
    return String(text || "")
      .replace(/\r/g, "")
      .replace(/[ \t]{3,}/g, " ")
      .replace(/\n{4,}/g, "\n\n")
      .trim();
  }

  function normalizeExtractedPdfText(text) {
    return String(text || "")
      .replace(/\s+/g, " ")
      .replace(/https?:\s*\/\s*\//gi, "https://")
      .replace(/www\.\s+/gi, "www.")
      .replace(/\s+([,.;:])/g, "$1")
      .replace(/([,;:])(?=[A-Za-zÁÉÍÓÚÑáéíóúñ])/g, "$1 ")
      .trim();
  }

  function setFileStatus(message, state) {
    var status = $("pniFileStatus");
    if (!status) return;

    status.textContent = message;
    status.className = "pni-file-status";

    if (state === "ok") status.classList.add("ok");
    if (state === "error") status.classList.add("error");
  }
/* =========================================================
   PARTE 2/10
   Motor principal de análisis
========================================================= */

function analyzeDocument() {

    const text = ($("pniDocText")?.value || "").trim();

    if (!text) {
        alert("Debe cargar un documento antes de ejecutar la revisión.");
        return;
    }

    PNI.findings = [];
    PNI.longParagraphs = [];

    const paragraphs = splitParagraphs(text);

    const totalWords = countWords(text);

    PNI.documentProfile = buildDocumentProfile(
        text,
        paragraphs,
        totalWords
    );

    analyzeParagraphs(paragraphs);

    finalizeLongParagraphs();

    detectGlobalIssues(text, paragraphs);

    PNI.findings = removeDuplicateFindings(PNI.findings);

    buildExecutiveSummary();

    updateKPIs();

    renderFindings();

    renderCharts();

}

function analyzeParagraphs(paragraphs){

    paragraphs.forEach(function(paragraph,index){

        const paragraphNumber = index+1;

        const pageNumber = detectPageNumber(
            paragraph,
            paragraphNumber
        );

        const cleanParagraph = paragraph
            .replace(/^\[Página\s+\d+\]/i,"")
            .trim();

        if(!cleanParagraph) return;

        runRulesLibrary(
            cleanParagraph,
            paragraphNumber,
            pageNumber
        );

        detectRepeatedWords(
            cleanParagraph,
            paragraphNumber,
            pageNumber
        );

        detectUppercaseParagraph(
            cleanParagraph,
            paragraphNumber,
            pageNumber
        );

        detectPercentageContext(
            cleanParagraph,
            paragraphNumber,
            pageNumber
        );

        detectDocumentStructureSignals(
            cleanParagraph,
            paragraphNumber,
            pageNumber
        );

        detectBasicCoherence(
            cleanParagraph,
            paragraphNumber,
            pageNumber
        );

        detectVeryLongSentence(
            cleanParagraph,
            paragraphNumber,
            pageNumber
        );

        collectLongParagraph(
            cleanParagraph,
            paragraphNumber,
            pageNumber
        );

    });

}

function buildDocumentProfile(text,paragraphs,totalWords){

    return {

        words: totalWords,

        paragraphs: paragraphs.length,

        pages:
            Math.max(
                1,
                (text.match(/\[Página\s+\d+\]/g)||[]).length
            ),

        title:
            $("pniDocTitle")?.value || "",

        findings:0,

        score:100,

        risk:"Bajo"

    };

}
/* =========================================================
   PARTE 3/10
   Puntaje, semáforo documental e informe ejecutivo
========================================================= */

function buildExecutiveSummary(){

    const findings = PNI.findings || [];
    const profile = PNI.documentProfile || {};

    const byType = countBy(findings,"tipo");
    const byPriority = countBy(findings,"prioridad");

    const score = calculateDocumentScore(
        findings,
        profile.words || 0,
        profile.paragraphs || 0
    );

    const quality = getQualityLevel(score);
    const risk = getRiskLevel(findings,score);
    const readiness = getReadinessStatus(score,byPriority);
    const correctionTime = estimateCorrectionTime(findings);

    const dominantType = getDominantKey(byType) || "--";
    const dominantPriority = getDominantKey(byPriority) || "--";

    const dimensions = calculateQualityDimensions(
        score,
        byType,
        findings,
        profile.words || 0
    );

    const topPriorities = buildTopPriorities(findings);

    const strengths = buildStrengths(
        score,
        byType,
        byPriority,
        findings
    );

    const recommendations = buildRecommendations(
        score,
        byType,
        byPriority,
        findings
    );

    const summaryText = buildExecutiveText({
        score,
        quality,
        risk,
        readiness,
        correctionTime,
        byType,
        byPriority,
        dominantType,
        dominantPriority,
        totalFindings:findings.length
    });

    PNI.executive = {
        score,
        quality,
        risk,
        readiness,
        correctionTime,
        byType,
        byPriority,
        dominantType,
        dominantPriority,
        dimensions,
        topPriorities,
        strengths,
        recommendations,
        summaryText,
        totalFindings:findings.length
    };

    PNI.documentProfile.score = score;
    PNI.documentProfile.risk = risk.label;

    renderExecutivePanel();

}

function calculateDocumentScore(findings,totalWords,totalParagraphs){

    if(!findings.length) return 100;

    let penalty = 0;

    findings.forEach(function(item){

        let value = 0;

        if(item.prioridad === "Alta") value += 8;
        if(item.prioridad === "Media") value += 4;
        if(item.prioridad === "Baja") value += 1.5;

        if(item.tipo === "Ortografía") value += 1.2;
        if(item.tipo === "Terminología") value += 1.6;
        if(item.tipo === "Coherencia") value += 2.4;
        if(item.tipo === "Estilo institucional") value += 1.4;
        if(item.tipo === "Redacción") value += 1.2;
        if(item.tipo === "Formato") value += 0.6;

        if(item.count && item.count > 1){
            value += Math.min(8,Math.log(item.count + 1) * 2);
        }

        penalty += value;

    });

    const sizeFactor = Math.max(
        1,
        Math.sqrt(Math.max(1,totalWords) / 900)
    );

    const densityFactor = Math.max(
        1,
        findings.length / Math.max(1,totalParagraphs)
    );

    let score = 100 - (penalty / sizeFactor);

    if(densityFactor > 0.45){
        score -= Math.min(8,densityFactor * 3);
    }

    return Math.max(45,Math.round(score));

}

function getQualityLevel(score){

    if(score >= 95){
        return {
            label:"Excelente",
            className:"excellent",
            emoji:"🟢"
        };
    }

    if(score >= 90){
        return {
            label:"Muy buena",
            className:"very-good",
            emoji:"🟢"
        };
    }

    if(score >= 80){
        return {
            label:"Buena",
            className:"good",
            emoji:"🟡"
        };
    }

    if(score >= 70){
        return {
            label:"Requiere ajustes",
            className:"warning",
            emoji:"🟠"
        };
    }

    return {
        label:"Revisión mayor recomendada",
        className:"critical",
        emoji:"🔴"
    };

}

function getRiskLevel(findings,score){

    const high = findings.filter(function(item){
        return item.prioridad === "Alta";
    }).length;

    const coherence = findings.filter(function(item){
        return item.tipo === "Coherencia";
    }).length;

    const terminology = findings.filter(function(item){
        return item.tipo === "Terminología";
    }).length;

    if(score < 70 || high >= 3){
        return {
            label:"Alto",
            className:"critical"
        };
    }

    if(score < 82 || high >= 1 || coherence >= 4 || terminology >= 8){
        return {
            label:"Medio",
            className:"warning"
        };
    }

    return {
        label:"Bajo",
        className:"excellent"
    };

}

function getReadinessStatus(score,byPriority){

    const high = byPriority.Alta || 0;
    const medium = byPriority.Media || 0;

    if(score >= 90 && high === 0){
        return {
            label:"Apto para revisión final",
            className:"excellent"
        };
    }

    if(score >= 80 && high === 0){
        return {
            label:"Apto con observaciones",
            className:"good"
        };
    }

    if(score >= 70 && high <= 1){
        return {
            label:"Requiere ajustes previos",
            className:"warning"
        };
    }

    return {
        label:"No recomendado para distribución",
        className:"critical"
    };

}

function estimateCorrectionTime(findings){

    if(!findings.length){
        return {
            label:"Sin correcciones relevantes",
            minutes:0
        };
    }

    let minutes = 0;

    findings.forEach(function(item){

        if(item.prioridad === "Alta") minutes += 6;
        if(item.prioridad === "Media") minutes += 3;
        if(item.prioridad === "Baja") minutes += 1;

        if(item.tipo === "Coherencia") minutes += 2;
        if(item.tipo === "Terminología") minutes += 1;
        if(item.tipo === "Formato") minutes += 0.5;

        if(item.count && item.count > 1){
            minutes += Math.min(8,item.count * 0.5);
        }

    });

    minutes = Math.max(3,Math.round(minutes));

    if(minutes < 10){
        return {
            label:minutes + " minutos",
            minutes
        };
    }

    if(minutes < 60){
        return {
            label:minutes + " minutos aprox.",
            minutes
        };
    }

    const hours = Math.floor(minutes / 60);
    const rest = minutes % 60;

    return {
        label:hours + " h " + rest + " min aprox.",
        minutes
    };

}

function calculateQualityDimensions(score,byType,findings,totalWords){

    const total = Math.max(1,findings.length);

    return {
        ortografia: dimensionScore(score,byType["Ortografía"] || 0,total,1.3),
        terminologia: dimensionScore(score,byType["Terminología"] || 0,total,1.5),
        coherencia: dimensionScore(score,byType["Coherencia"] || 0,total,1.8),
        redaccion: dimensionScore(score,byType["Redacción"] || 0,total,1.2),
        formato: dimensionScore(score,byType["Formato"] || 0,total,0.9)
    };

}

function dimensionScore(baseScore,count,total,weight){

    const penalty = (count / Math.max(1,total)) * 35 * weight;
    return Math.max(45,Math.round(baseScore - penalty));

}

function buildExecutiveText(data){

    if(data.totalFindings === 0){
        return "El documento presenta una revisión preliminar favorable. No se detectan observaciones relevantes de ortografía, terminología, coherencia, redacción o formato que requieran corrección prioritaria. Se recomienda mantener la revisión técnica final por el equipo responsable antes de su distribución institucional.";
    }

    let text =
        "El documento presenta una calidad documental " +
        data.quality.label.toLowerCase() +
        " con un puntaje de " +
        data.score +
        "/100. Se identificaron " +
        data.totalFindings +
        " observaciones agrupadas, con predominio de hallazgos de tipo “" +
        data.dominantType +
        "” y prioridad “" +
        data.dominantPriority +
        "”.";

    if((data.byPriority.Alta || 0) > 0){
        text += " Se recomienda abordar en primer lugar las observaciones de prioridad alta, dado que podrían afectar la claridad técnica, la consistencia institucional o la presentación formal del documento.";
    } else if((data.byPriority.Media || 0) > 0){
        text += " Las observaciones detectadas son principalmente corregibles mediante ajustes editoriales, terminológicos o de formato antes de la revisión final.";
    } else {
        text += " Los hallazgos son principalmente menores y no debiesen comprometer la comprensión general del documento.";
    }

    text += " El riesgo documental estimado es " + data.risk.label.toLowerCase() + " y el estado sugerido es: " + data.readiness.label + ".";

    return text;

}
/* =========================================================
   PARTE 4/10
   Fortalezas, recomendaciones y Top 5 prioridades
========================================================= */

function buildTopPriorities(findings) {
  if (!findings.length) {
    return ["No se detectan observaciones prioritarias."];
  }

  const weighted = findings
    .map(function (item) {
      let weight = 0;

      if (item.prioridad === "Alta") weight += 100;
      if (item.prioridad === "Media") weight += 60;
      if (item.prioridad === "Baja") weight += 25;

      if (item.tipo === "Coherencia") weight += 25;
      if (item.tipo === "Terminología") weight += 20;
      if (item.tipo === "Ortografía") weight += 15;
      if (item.tipo === "Estilo institucional") weight += 15;
      if (item.tipo === "Redacción") weight += 12;
      if (item.tipo === "Formato") weight += 8;

      if (item.count && item.count > 1) {
        weight += Math.min(30, item.count * 4);
      }

      return {
        item: item,
        weight: weight
      };
    })
    .sort(function (a, b) {
      return b.weight - a.weight;
    })
    .slice(0, 5);

  return weighted.map(function (entry) {
    const item = entry.item;
    return (
      item.tipo +
      " · " +
      item.prioridad +
      ": " +
      item.texto +
      " → " +
      item.sugerencia
    );
  });
}

function buildStrengths(score, byType, byPriority, findings) {
  const strengths = [];

  if ((byPriority.Alta || 0) === 0) {
    strengths.push("No se detectan observaciones de prioridad alta.");
  }

  if ((byType.Coherencia || 0) === 0) {
    strengths.push("No se identifican inconsistencias relevantes de coherencia interna.");
  }

  if ((byType.Terminología || 0) <= 2) {
    strengths.push("La terminología técnica PNI presenta un uso globalmente adecuado.");
  }

  if ((byType["Estilo institucional"] || 0) <= 1) {
    strengths.push("El documento mantiene un estilo institucional mayoritariamente consistente.");
  }

  if ((byType.Ortografía || 0) === 0) {
    strengths.push("No se detectan errores ortográficos relevantes.");
  }

  if ((byType.Formato || 0) <= 2) {
    strengths.push("El formato documental presenta baja carga de observaciones.");
  }

  if (score >= 90) {
    strengths.push("El puntaje general permite orientar el documento a revisión técnica final.");
  }

  if (!findings.length) {
    strengths.push("El documento presenta una revisión preliminar favorable.");
  }

  if (!strengths.length) {
    strengths.push("El documento cuenta con insumos suficientes para una revisión técnica dirigida.");
  }

  return strengths.slice(0, 5);
}

function buildRecommendations(score, byType, byPriority, findings) {
  const recommendations = [];

  if ((byPriority.Alta || 0) > 0) {
    recommendations.push("Resolver primero las observaciones de prioridad alta antes de distribuir el documento.");
  }

  if ((byType.Ortografía || 0) > 0) {
    recommendations.push("Aplicar una revisión ortográfica final, especialmente en términos sanitarios e institucionales.");
  }

  if ((byType.Terminología || 0) > 0) {
    recommendations.push("Uniformar la terminología PNI, siglas, nombres institucionales y denominaciones programáticas.");
  }

  if ((byType.Coherencia || 0) > 0) {
    recommendations.push("Revisar la coherencia de cifras, porcentajes, grupos objetivo, fechas y fundamentos técnicos.");
  }

  if ((byType["Estilo institucional"] || 0) > 0) {
    recommendations.push("Ajustar expresiones coloquiales o poco formales hacia lenguaje administrativo institucional.");
  }

  if ((byType.Redacción || 0) > 0) {
    recommendations.push("Revisar párrafos extensos o de alta complejidad para mejorar claridad y lectura ejecutiva.");
  }

  if ((byType.Formato || 0) > 0) {
    recommendations.push("Homogeneizar formato de fechas, anexos, tablas, puntuación y referencias internas.");
  }

  if (score >= 90 && recommendations.length === 0) {
    recommendations.push("Mantener revisión técnica final por el equipo responsable previo a su distribución.");
  }

  if (!recommendations.length) {
    recommendations.push("Realizar lectura final de control antes de la validación institucional.");
  }

  return recommendations.slice(0, 5);
}

function renderExecutivePanel() {
  const executive = PNI.executive;
  if (!executive) return;

  const scoreCard = $("pniScoreCard");
  if (scoreCard) {
    scoreCard.className = "pni-score-card " + executive.quality.className;
  }

  setText("pniExecutiveScoreMain", executive.score + "/100");
  setText("pniExecutiveQualityMain", executive.quality.emoji + " " + executive.quality.label);
  setText("pniExecutiveSummaryText", executive.summaryText);
  setText("pniExecutiveTotalFindings", String(executive.totalFindings));
  setText("pniExecutiveDominantPriority", executive.dominantPriority);
  setText("pniExecutiveDominantType", executive.dominantType);
  setText("pniExecutiveCorrectionTime", executive.correctionTime.label);
  setText("pniExecutiveRiskLevel", executive.risk.label);
  setText("pniExecutiveReadiness", executive.readiness.label);

  const scoreBar = $("pniExecutiveScoreBar");
  if (scoreBar) {
    scoreBar.style.width = Math.max(0, Math.min(100, executive.score)) + "%";
  }

  renderList("pniTopPrioritiesList", executive.topPriorities || [], "ol");
  renderList("pniStrengthsList", executive.strengths || [], "ul");
  renderList("pniRecommendationsList", executive.recommendations || [], "ol");

  renderPriorityStats();
  renderTypeStats();
  renderQualityRadar();

  const exportBtn = $("pniExportBtn");
  const exportReportBtn = $("pniExportReportBtn");

  if (exportBtn) exportBtn.disabled = PNI.findings.length === 0;
  if (exportReportBtn) exportReportBtn.disabled = false;
}

function renderPriorityStats() {
  const target = $("pniPriorityStats");
  if (!target || !PNI.executive) return;

  const data = PNI.executive.byPriority || {};
  const items = [
    { label: "Alta", value: data.Alta || 0 },
    { label: "Media", value: data.Media || 0 },
    { label: "Baja", value: data.Baja || 0 }
  ];

  renderStatBars(target, items);
}

function renderTypeStats() {
  const target = $("pniExecutiveStats");
  if (!target || !PNI.executive) return;

  const data = PNI.executive.byType || {};
  const items = [
    { label: "Ortografía", value: data.Ortografía || 0 },
    { label: "Terminología", value: data.Terminología || 0 },
    { label: "Estilo institucional", value: data["Estilo institucional"] || 0 },
    { label: "Coherencia", value: data.Coherencia || 0 },
    { label: "Redacción", value: data.Redacción || 0 },
    { label: "Formato", value: data.Formato || 0 }
  ];

  renderStatBars(target, items);
}

function renderStatBars(target, items) {
  const max = Math.max(
    1,
    ...items.map(function (item) {
      return item.value || 0;
    })
  );

  target.innerHTML = items
    .map(function (item) {
      const width = Math.round((item.value / max) * 100);

      return (
        '<div class="pni-stat-row">' +
          '<div class="pni-stat-label">' +
            "<span>" + escapeHTML(item.label) + "</span>" +
            "<strong>" + escapeHTML(item.value) + "</strong>" +
          "</div>" +
          '<div class="pni-stat-bar">' +
            '<i style="width:' + width + '%"></i>' +
          "</div>" +
        "</div>"
      );
    })
    .join("");
}

function renderQualityRadar() {
  if (!PNI.executive || !PNI.executive.dimensions) return;

  const d = PNI.executive.dimensions;

  setQualityItem("pniQualityOrthography", "pniQualityOrthographyBar", d.ortografia);
  setQualityItem("pniQualityTerminology", "pniQualityTerminologyBar", d.terminologia);
  setQualityItem("pniQualityCoherence", "pniQualityCoherenceBar", d.coherencia);
  setQualityItem("pniQualityWriting", "pniQualityWritingBar", d.redaccion);
  setQualityItem("pniQualityFormat", "pniQualityFormatBar", d.formato);
}

function setQualityItem(textId, barId, value) {
  setText(textId, value + "/100");

  const bar = $(barId);
  if (bar) {
    bar.style.width = Math.max(0, Math.min(100, value)) + "%";
  }
}
/* =========================================================
   PARTE 5/10
   Motor de reglas, hallazgos y falsos positivos
========================================================= */

function runRulesLibrary(paragraph, paragraphNumber, pageNumber) {
  if (!window.PNI_RULE_ENGINE || typeof window.PNI_RULE_ENGINE.applyRulesToParagraph !== "function") {
    addFinding({
      pagina: pageNumber,
      parrafo: paragraphNumber,
      tipo: "Formato",
      prioridad: "Media",
      texto: "Biblioteca de reglas PNI no cargada",
      sugerencia: "Verificar que el snippet de reglas esté activo y cargue antes del JS principal.",
      justificacion: "El revisor requiere la biblioteca PNI_RULE_ENGINE para ejecutar las reglas técnicas."
    });
    return;
  }

  const libraryFindings = window.PNI_RULE_ENGINE.applyRulesToParagraph(
    paragraph,
    paragraphNumber,
    pageNumber
  );

  libraryFindings
    .filter(function (finding) {
      return !shouldDiscardFinding(finding, paragraph);
    })
    .forEach(addFinding);
}

function shouldDiscardFinding(finding, paragraph) {
  const texto = String(finding.texto || "");
  const tipo = String(finding.tipo || "");

  if (!texto.trim()) return true;

  if (tipo === "Formato") {
    if (isInsideUrlOrEmail(texto, paragraph)) return true;
    if (/^[:.]\/$/.test(texto)) return true;
    if (/^\.[a-záéíóúñ]$/i.test(texto)) return true;
    if (/^[:.][)]$/.test(texto)) return true;
    if (/^\.,$/.test(texto)) return true;
    if (/^\.\.$/.test(texto)) return true;
    if (/^[,.;:]$/.test(texto.trim())) return true;
  }

  if (isLikelyTableOrList(paragraph) && tipo === "Redacción") {
    return true;
  }

  return false;
}

function isInsideUrlOrEmail(fragment, paragraph) {
  const urlLike =
    /https?:\/\/|www\.|\.cl|\.gob|\.org|\.com|\.net|@|\/wp-content|\/uploads|\/documentos/i;

  if (urlLike.test(paragraph)) {
    const idx = paragraph.indexOf(fragment);

    if (idx >= 0) {
      const start = Math.max(0, idx - 55);
      const end = Math.min(paragraph.length, idx + fragment.length + 55);
      const nearby = paragraph.slice(start, end);

      return urlLike.test(nearby);
    }
  }

  return false;
}

function addFinding(item) {
  PNI.findings.push({
    pagina: item.pagina || 1,
    parrafo: item.parrafo || 1,
    tipo: normalizeType(item.tipo || item.type || "Redacción"),
    prioridad: normalizePriority(item.prioridad || item.priority || "Media"),
    texto: item.texto || item.finding || "",
    sugerencia: item.sugerencia || item.suggestion || "",
    justificacion: item.justificacion || item.justification || "",
    referencia: item.referencia || item.reference || "",
    regla: item.regla || item.rule || "",
    count: item.count || 1,
    examples: item.examples || []
  });
}

function normalizeType(type) {
  const allowed = [
    "Ortografía",
    "Redacción",
    "Coherencia",
    "Estilo institucional",
    "Terminología",
    "Formato"
  ];

  return allowed.includes(type) ? type : "Redacción";
}

function normalizePriority(priority) {
  const allowed = ["Alta", "Media", "Baja"];
  return allowed.includes(priority) ? priority : "Media";
}

function detectRepeatedWords(paragraph, paragraphNumber, pageNumber) {
  if (paragraph.length > 900) return;
  if (isLikelyTableOrList(paragraph)) return;
  if (/[A-ZÁÉÍÓÚÑ]{5,}\s{2,}[A-ZÁÉÍÓÚÑ]/.test(paragraph)) return;

  const match = paragraph.match(/\b(\p{L}{3,})\s+\1\b/iu);
  if (!match) return;

  const word = match[1].toLowerCase();
  const ignore = ["los", "las", "del", "con", "para", "una", "uno", "por", "que"];
  if (ignore.includes(word)) return;

  addFinding({
    pagina: pageNumber,
    parrafo: paragraphNumber,
    tipo: "Redacción",
    prioridad: "Media",
    texto: match[0],
    sugerencia: `Eliminar la repetición de la palabra “${match[1]}”.`,
    justificacion: "La repetición inmediata puede corresponder a un error de edición."
  });
}

function detectUppercaseParagraph(paragraph, paragraphNumber, pageNumber) {
  if (isLikelyTableOrList(paragraph)) return;

  const letters = paragraph.replace(/[^A-Za-zÁÉÍÓÚÑáéíóúñ]/g, "");
  if (letters.length < 80) return;

  const upperLetters = letters.replace(/[^A-ZÁÉÍÓÚÑ]/g, "");
  const upperRatio = upperLetters.length / letters.length;

  if (upperRatio > 0.85 && paragraph.length > 120) {
    addFinding({
      pagina: pageNumber,
      parrafo: paragraphNumber,
      tipo: "Formato",
      prioridad: "Baja",
      texto: "Bloque con uso predominante de mayúsculas",
      sugerencia: "Usar mayúsculas solo cuando corresponda a siglas, títulos o énfasis justificado.",
      justificacion: "El uso sostenido de mayúsculas reduce la legibilidad y puede afectar la presentación formal."
    });
  }
}

function detectPercentageContext(paragraph, paragraphNumber, pageNumber) {
  if (isLikelyTableOrList(paragraph)) return;

  if (
    /\b\d{1,3}\s?%\b/.test(paragraph) &&
    !/\bmeta\b|\bcobertura\b|\bavance\b|\bporcentaje\b|\bproporción\b|\bindicador\b|\btasa\b/i.test(paragraph)
  ) {
    addFinding({
      pagina: pageNumber,
      parrafo: paragraphNumber,
      tipo: "Coherencia",
      prioridad: "Baja",
      texto: "Porcentaje sin contexto explícito",
      sugerencia: "Precisar si el porcentaje corresponde a cobertura, avance, meta, tasa u otro indicador.",
      justificacion: "Los porcentajes deben estar claramente asociados al indicador que representan."
    });
  }
}
/* =========================================================
   PARTE 6/10
   Coherencia, estructura, párrafos extensos y hallazgos globales
========================================================= */

function detectDocumentStructureSignals(paragraph, paragraphNumber, pageNumber) {
  if (isLikelyTableOrList(paragraph)) return;

  if (
    /\banexo\b/i.test(paragraph) &&
    !/\banexo\s*(n°|nº|no\.?|número)?\s*[0-9ivx]+/i.test(paragraph)
  ) {
    addFinding({
      pagina: pageNumber,
      parrafo: paragraphNumber,
      tipo: "Formato",
      prioridad: "Baja",
      texto: "Referencia a anexo sin numeración clara",
      sugerencia: "Verificar que el anexo esté numerado o identificado de manera trazable.",
      justificacion: "Las referencias a anexos deben permitir su identificación inequívoca."
    });
  }

  if (
    /\btabla\b/i.test(paragraph) &&
    !/\btabla\s*(n°|nº|no\.?|número)?\s*[0-9ivx]+/i.test(paragraph)
  ) {
    addFinding({
      pagina: pageNumber,
      parrafo: paragraphNumber,
      tipo: "Formato",
      prioridad: "Baja",
      texto: "Referencia a tabla sin numeración clara",
      sugerencia: "Verificar que la tabla esté numerada o identificada de manera trazable.",
      justificacion: "Las referencias a tablas deben permitir su identificación dentro del documento."
    });
  }
}

function detectBasicCoherence(paragraph, paragraphNumber, pageNumber) {
  if (isLikelyTableOrList(paragraph)) return;

  const hasBut = /\bpero\b|\bsin embargo\b|\bno obstante\b/i.test(paragraph);
  const hasBecause = /\bporque\b|\bdado que\b|\bdebido a\b|\bya que\b/i.test(paragraph);

  if (hasBut && paragraph.length < 90) {
    addFinding({
      pagina: pageNumber,
      parrafo: paragraphNumber,
      tipo: "Coherencia",
      prioridad: "Media",
      texto: "Conector adversativo en párrafo breve",
      sugerencia: "Revisar si la contraposición está suficientemente desarrollada.",
      justificacion: "El uso de conectores adversativos requiere que ambas ideas estén claramente explicitadas."
    });
  }

  if (hasBecause && paragraph.length < 80) {
    addFinding({
      pagina: pageNumber,
      parrafo: paragraphNumber,
      tipo: "Coherencia",
      prioridad: "Media",
      texto: "Justificación posiblemente incompleta",
      sugerencia: "Completar la causa, antecedente o fundamento técnico señalado.",
      justificacion: "Las relaciones causales deben quedar suficientemente fundamentadas en documentos técnicos."
    });
  }
}

function detectVeryLongSentence(paragraph, paragraphNumber, pageNumber) {
  if (isLikelyTableOrList(paragraph)) return;

  const sentences = paragraph
    .split(/(?<=[.!?])\s+/)
    .map(function (sentence) {
      return sentence.trim();
    })
    .filter(Boolean);

  sentences.forEach(function (sentence) {
    const words = countWords(sentence);

    if (words > PNI.config.veryLongSentenceWords) {
      addFinding({
        pagina: pageNumber,
        parrafo: paragraphNumber,
        tipo: "Redacción",
        prioridad: "Baja",
        texto: "Oración extensa",
        sugerencia: "Evaluar dividir la oración en unidades más breves y directas.",
        justificacion: "Las oraciones extensas pueden afectar la comprensión, especialmente en documentos técnicos o administrativos."
      });
    }
  });
}

function collectLongParagraph(paragraph, paragraphNumber, pageNumber) {
  if (isLikelyTableOrList(paragraph)) return;

  const words = countWords(paragraph);

  if (
    words > PNI.config.longParagraphWords ||
    paragraph.length > PNI.config.longParagraphCharacters
  ) {
    PNI.longParagraphs.push({
      pagina: pageNumber,
      parrafo: paragraphNumber,
      words: words
    });
  }
}

function finalizeLongParagraphs() {
  if (!PNI.longParagraphs.length) return;

  const examples = PNI.longParagraphs
    .slice(0, PNI.config.maxGroupedExamples)
    .map(function (item) {
      return "pág. " + item.pagina + ", párr. " + item.parrafo;
    })
    .join("; ");

  addFinding({
    pagina: PNI.longParagraphs[0].pagina,
    parrafo: PNI.longParagraphs[0].parrafo,
    tipo: "Redacción",
    prioridad: PNI.longParagraphs.length >= 5 ? "Media" : "Baja",
    texto: "Se detectan " + PNI.longParagraphs.length + " párrafos o bloques de lectura muy extensos",
    sugerencia: "Revisar la estructura del documento y dividir secciones largas solo cuando afecten la comprensión.",
    justificacion: "Observación agrupada para evitar ruido en la tabla. Ejemplos: " + examples + "."
  });
}

function detectGlobalIssues(text, paragraphs) {
  const joined = String(text || "");

  detectDateConsistency(joined);
  detectAcronymDefinitions(joined);
  detectLowSegmentation(joined, paragraphs);
}

function detectDateConsistency(text) {
  const dateFormats = {};

  if (/\b\d{1,2}[-]\d{1,2}[-]\d{2,4}\b/.test(text)) {
    dateFormats["dd-mm-aaaa"] = true;
  }

  if (/\b\d{1,2}[\/]\d{1,2}[\/]\d{2,4}\b/.test(text)) {
    dateFormats["dd/mm/aaaa"] = true;
  }

  if (/\b\d{1,2}\s+de\s+[a-záéíóúñ]+\s+de\s+\d{4}\b/i.test(text)) {
    dateFormats["texto"] = true;
  }

  if (Object.keys(dateFormats).length >= 2) {
    addFinding({
      pagina: 1,
      parrafo: 1,
      tipo: "Formato",
      prioridad: "Baja",
      texto: "Formatos de fecha no uniformes",
      sugerencia: "Unificar el formato de fechas utilizado en todo el documento.",
      justificacion: "La consistencia en fechas mejora la presentación institucional y la trazabilidad."
    });
  }
}

function detectAcronymDefinitions(text) {
  const siglasRelevantes = [
    "PNI",
    "MINSAL",
    "SEREMI",
    "DEIS",
    "DIPRECE",
    "ISP",
    "CAVEI",
    "ESAVI",
    "RNI"
  ];

  siglasRelevantes.forEach(function (sigla) {
    const regex = new RegExp("\\b" + sigla + "\\b", "g");
    const count = (text.match(regex) || []).length;

    if (count >= 3 && !hasLikelyDefinition(text, sigla)) {
      addFinding({
        pagina: 1,
        parrafo: 1,
        tipo: "Terminología",
        prioridad: "Baja",
        texto: "Sigla " + sigla + " sin definición inicial evidente",
        sugerencia: "Verificar si corresponde definir “" + sigla + "” en su primera mención.",
        justificacion: "Las siglas relevantes deben definirse cuando el documento está dirigido a públicos no especializados."
      });
    }
  });
}

function detectLowSegmentation(text, paragraphs) {
  if (paragraphs.length < 3 && countWords(text) > 500) {
    addFinding({
      pagina: 1,
      parrafo: 1,
      tipo: "Redacción",
      prioridad: "Baja",
      texto: "Documento con baja segmentación",
      sugerencia: "Evaluar dividir el contenido en secciones, subtítulos o párrafos temáticos.",
      justificacion: "La segmentación favorece la lectura, revisión técnica y trazabilidad del contenido."
    });
  }
}

function hasLikelyDefinition(text, sigla) {
  const escaped = sigla.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
  const patternA = new RegExp("\\([ ]*" + escaped + "[ ]*\\)", "i");
  const patternB = new RegExp(escaped + "[ ]*\\([^)]+\\)", "i");

  return patternA.test(text) || patternB.test(text);
}
/* =========================================================
   PARTE 7/10
   Limpieza, agrupación, orden inteligente y tabla
========================================================= */

function removeDuplicateFindings(findings) {
  const cleaned = (findings || [])
    .filter(function (item) {
      return item && item.texto && item.sugerencia;
    })
    .filter(function (item) {
      return !isLowValueFinding(item);
    });

  const grouped = groupRepeatedFindings(cleaned);

  return sortFindings(grouped);
}

function isLowValueFinding(item) {
  const text = String(item.texto || "").trim();

  if (!text) return true;

  if (item.tipo === "Formato" && text.length <= 2) return true;
  if (/^[,.;:)]$/.test(text)) return true;
  if (/^[:.]\/$/.test(text)) return true;
  if (/^\.[a-záéíóúñ]$/i.test(text)) return true;
  if (/^\.\.$/.test(text)) return true;
  if (/^\.,$/.test(text)) return true;

  return false;
}

function groupRepeatedFindings(findings) {
  const map = {};

  findings.forEach(function (item) {
    const key = [
      item.tipo,
      item.prioridad,
      normalizeForGrouping(item.texto),
      normalizeForGrouping(item.sugerencia)
    ].join("|");

    if (!map[key]) {
      map[key] = {
        pagina: item.pagina,
        parrafo: item.parrafo,
        tipo: item.tipo,
        prioridad: item.prioridad,
        texto: item.texto,
        sugerencia: item.sugerencia,
        justificacion: item.justificacion,
        referencia: item.referencia,
        regla: item.regla,
        count: 1,
        examples: ["pág. " + item.pagina + ", párr. " + item.parrafo]
      };
      return;
    }

    map[key].count += 1;

    const example = "pág. " + item.pagina + ", párr. " + item.parrafo;

    if (
      map[key].examples.indexOf(example) === -1 &&
      map[key].examples.length < PNI.config.maxGroupedExamples
    ) {
      map[key].examples.push(example);
    }
  });

  return Object.keys(map).map(function (key) {
    const item = map[key];

    if (item.count <= 1) return item;

    item.texto = item.texto + " (" + item.count + " coincidencias)";
    item.justificacion =
      item.justificacion +
      " Observación agrupada. Ejemplos: " +
      item.examples.join("; ") +
      ".";

    return item;
  });
}

function normalizeForGrouping(value) {
  return String(value || "")
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/\d+/g, "#")
    .replace(/\s+/g, " ")
    .trim();
}

function sortFindings(findings) {
  const priorityWeight = {
    Alta: 1,
    Media: 2,
    Baja: 3
  };

  const typeWeight = {
    Coherencia: 1,
    Terminología: 2,
    Ortografía: 3,
    "Estilo institucional": 4,
    Redacción: 5,
    Formato: 6
  };

  return (findings || []).sort(function (a, b) {
    const pa = priorityWeight[a.prioridad] || 9;
    const pb = priorityWeight[b.prioridad] || 9;

    if (pa !== pb) return pa - pb;

    const ta = typeWeight[a.tipo] || 9;
    const tb = typeWeight[b.tipo] || 9;

    if (ta !== tb) return ta - tb;

    if (Number(a.pagina) !== Number(b.pagina)) {
      return Number(a.pagina) - Number(b.pagina);
    }

    return Number(a.parrafo) - Number(b.parrafo);
  });
}

function renderFindings() {
  const tbody = $("pniFindingsBody");
  const exportBtn = $("pniExportBtn");

  if (!tbody) return;

  const search = (($("pniSearchFindings") && $("pniSearchFindings").value) || "")
    .toLowerCase()
    .trim();

  const type =
    (($("pniFilterType") && $("pniFilterType").value) || "Todos");

  const priority =
    (($("pniFilterPriority") && $("pniFilterPriority").value) || "Todas");

  const filtered = (PNI.findings || []).filter(function (item) {
    const matchesType = type === "Todos" || item.tipo === type;
    const matchesPriority = priority === "Todas" || item.prioridad === priority;

    const combined = [
      item.pagina,
      item.parrafo,
      item.tipo,
      item.prioridad,
      item.texto,
      item.sugerencia,
      item.justificacion
    ]
      .join(" ")
      .toLowerCase();

    return matchesType && matchesPriority && combined.includes(search);
  });

  if (!filtered.length) {
    tbody.innerHTML =
      '<tr class="pni-empty-row">' +
      '<td colspan="7">No se encontraron observaciones para los filtros aplicados.</td>' +
      "</tr>";

    if (exportBtn) exportBtn.disabled = (PNI.findings || []).length === 0;
    return;
  }

  tbody.innerHTML = filtered
    .map(function (item) {
      return (
        "<tr>" +
        "<td>" + escapeHTML(item.pagina) + "</td>" +
        "<td>" + escapeHTML(item.parrafo) + "</td>" +
        "<td>" + typeBadge(item.tipo) + "</td>" +
        "<td>" + priorityBadge(item.prioridad) + "</td>" +
        "<td class='pni-texto-detectado'>" + renderTextoDetectado(item) + "</td>" +
	    "<td>" + escapeHTML(item.sugerencia) + "</td>" +
        "<td>" + escapeHTML(item.justificacion) + "</td>" +
        "</tr>"
      );
    })
    .join("");

  if (exportBtn) exportBtn.disabled = (PNI.findings || []).length === 0;
}

function renderTextoDetectado(item) {
  const textoCompleto = String(item.texto || "");
  const limite = 180;

  if (textoCompleto.length <= limite) {
    return escapeHTML(textoCompleto);
  }

  const resumen = textoCompleto.substring(0, limite).trim() + "…";

  return (
    '<details class="pni-detected-details">' +
      '<summary>' + escapeHTML(resumen) + '</summary>' +
      '<div class="pni-detected-full">' +
        escapeHTML(textoCompleto) +
      '</div>' +
    '</details>'
  );
}

function typeBadge(type) {
  let cls = "tipo-formato";

  if (type === "Ortografía") cls = "tipo-ortografia";
  if (type === "Redacción") cls = "tipo-redaccion";
  if (type === "Estilo institucional") cls = "tipo-estilo";
  if (type === "Terminología") cls = "tipo-terminologia";
  if (type === "Coherencia") cls = "tipo-coherencia";
  if (type === "Formato") cls = "tipo-formato";

  return '<span class="pni-badge ' + cls + '">' + escapeHTML(type) + "</span>";
}

function priorityBadge(priority) {
  let cls = "baja";

  if (priority === "Alta") cls = "alta";
  if (priority === "Media") cls = "media";
  if (priority === "Baja") cls = "baja";

  return (
    '<span class="pni-priority-badge ' +
    cls +
    '">' +
    escapeHTML(priority) +
    "</span>"
  );
}

function updateKPIs() {
  const profile = PNI.documentProfile || {};
  const executive = PNI.executive || {};

  setText("pniKpiWords", formatNumber(profile.words || 0));
  setText("pniKpiParagraphs", formatNumber(profile.paragraphs || 0));
  setText("pniKpiFindings", formatNumber((PNI.findings || []).length));
  setText(
    "pniKpiScore",
    typeof executive.score === "number" ? executive.score + "/100" : "--"
  );
}

function renderErrorRow(message) {
  const tbody = $("pniFindingsBody");
  if (!tbody) return;

  tbody.innerHTML =
    '<tr class="pni-empty-row">' +
    '<td colspan="7">⚠️ ' +
    escapeHTML(message) +
    "</td>" +
    "</tr>";
}

function renderEmptyRow(message) {
  const tbody = $("pniFindingsBody");
  if (!tbody) return;

  tbody.innerHTML =
    '<tr class="pni-empty-row">' +
    '<td colspan="7">' +
    escapeHTML(message) +
    "</td>" +
    "</tr>";
}
/* =========================================================
   PARTE 8/10
   Exportación CSV e informe HTML institucional
========================================================= */

function exportCSV() {
  const findings = PNI.findings || [];

  if (!findings.length) {
    alert("No existen observaciones para exportar.");
    return;
  }

  const title = ($("pniDocTitle")?.value || "documento").trim();
  const safeTitle = getSafeFileName(title);

  const headers = [
    "Página",
    "Párrafo",
    "Tipo",
    "Prioridad",
    "Texto detectado",
    "Sugerencia",
    "Justificación"
  ];

  const rows = findings.map(function (item) {
    return [
      item.pagina,
      item.parrafo,
      item.tipo,
      item.prioridad,
      item.texto,
      item.sugerencia,
      item.justificacion
    ];
  });

  const csv = [headers]
    .concat(rows)
    .map(function (row) {
      return row.map(csvEscape).join(";");
    })
    .join("\n");

  downloadBlob(
    "\ufeff" + csv,
    "revision_pni_" + (safeTitle || "documento") + ".csv",
    "text/csv;charset=utf-8;"
  );
}

function exportExecutiveHTML() {
  if (!PNI.executive) {
    alert("Primero debe ejecutar la revisión del documento.");
    return;
  }

  const title = ($("pniDocTitle")?.value || "Documento sin título").trim();
  const docType = ($("pniDocType")?.value || "Documento técnico").trim();
  const safeTitle = getSafeFileName(title);
  const date = new Date();

  const fecha = date.toLocaleDateString("es-CL", {
    year: "numeric",
    month: "long",
    day: "numeric"
  });

  const hora = date.toLocaleTimeString("es-CL", {
    hour: "2-digit",
    minute: "2-digit"
  });

  const html =
    '<!doctype html>' +
    '<html lang="es">' +
    "<head>" +
    '<meta charset="utf-8">' +
    '<meta name="viewport" content="width=device-width, initial-scale=1">' +
    "<title>Informe de revisión documental PNI</title>" +
    getExportReportStyles() +
    "</head>" +
    "<body>" +
    buildExportReportHeader(title, docType, fecha, hora) +
    buildExportExecutiveSection() +
    buildExportMetricsSection() +
    buildExportStrengthsSection() +
    buildExportRecommendationsSection() +
    buildExportFindingsSection() +
    buildExportFooter() +
    "</body>" +
    "</html>";

  downloadBlob(
    html,
    "informe_revision_pni_" + (safeTitle || "documento") + ".html",
    "text/html;charset=utf-8;"
  );
}

function getExportReportStyles() {
  return `
<style>
  :root{
    --azul:#073b7a;
    --azul2:#005aa7;
    --celeste:#0072bc;
    --verde:#0f766e;
    --gris:#526173;
    --borde:#dbe4ef;
    --fondo:#f8fafc;
    --texto:#1f2937;
  }

  *{
    box-sizing:border-box;
  }

  body{
    margin:0;
    padding:32px;
    font-family:Arial, Helvetica, sans-serif;
    color:var(--texto);
    background:#ffffff;
    line-height:1.45;
  }

  .report{
    max-width:1100px;
    margin:0 auto;
  }

  .hero{
    padding:28px 30px;
    border-radius:22px;
    background:linear-gradient(135deg,var(--azul),var(--azul2),var(--celeste));
    color:#fff;
    margin-bottom:22px;
  }

  .hero-top{
    display:flex;
    justify-content:space-between;
    gap:18px;
    align-items:flex-start;
  }

  .hero h1{
    margin:10px 0 8px;
    font-size:30px;
    line-height:1.1;
  }

  .hero p{
    margin:0;
    color:rgba(255,255,255,0.92);
  }

  .badge{
    display:inline-flex;
    padding:7px 12px;
    border-radius:999px;
    background:rgba(255,255,255,0.15);
    border:1px solid rgba(255,255,255,0.25);
    font-size:12px;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:.04em;
  }

  .meta{
    text-align:right;
    font-size:13px;
    color:rgba(255,255,255,0.9);
  }

  .section{
    margin:18px 0;
    padding:22px;
    border:1px solid var(--borde);
    border-radius:18px;
    background:#fff;
  }

  .section.soft{
    background:var(--fondo);
  }

  h2{
    margin:0 0 12px;
    color:var(--azul);
    font-size:22px;
  }

  h3{
    margin:0 0 10px;
    color:var(--azul);
    font-size:17px;
  }

  p{
    margin:0 0 10px;
  }

  .score-grid{
    display:grid;
    grid-template-columns:1.1fr 2fr;
    gap:16px;
  }

  .score-card{
    border-radius:18px;
    padding:22px;
    color:#fff;
    background:linear-gradient(135deg,var(--verde),var(--azul2));
  }

  .score-card strong{
    display:block;
    font-size:42px;
    line-height:1;
    margin:8px 0;
  }

  .score-card span{
    display:block;
    font-size:12px;
    text-transform:uppercase;
    letter-spacing:.06em;
    font-weight:800;
    opacity:.9;
  }

  .score-card em{
    display:block;
    font-style:normal;
    font-weight:800;
    font-size:18px;
  }

  .kpi-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:12px;
    margin-top:14px;
  }

  .kpi{
    border:1px solid var(--borde);
    border-radius:14px;
    padding:14px;
    background:var(--fondo);
  }

  .kpi span{
    display:block;
    color:var(--gris);
    font-size:12px;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:.04em;
  }

  .kpi strong{
    display:block;
    margin-top:6px;
    color:var(--azul);
    font-size:20px;
  }

  .two-col{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:16px;
  }

  ul,ol{
    margin:0;
    padding-left:22px;
  }

  li{
    margin-bottom:8px;
  }

  .bar-row{
    margin-bottom:11px;
  }

  .bar-label{
    display:flex;
    justify-content:space-between;
    gap:12px;
    margin-bottom:5px;
    color:#334155;
    font-size:13px;
    font-weight:800;
  }

  .bar{
    height:9px;
    background:#e5e7eb;
    border-radius:999px;
    overflow:hidden;
  }

  .bar i{
    display:block;
    height:100%;
    background:linear-gradient(90deg,var(--celeste),var(--verde));
    border-radius:999px;
  }

  table{
    width:100%;
    border-collapse:collapse;
    font-size:12px;
  }

  th{
    background:var(--azul);
    color:#fff;
    text-align:left;
    padding:9px 8px;
  }

  td{
    border-bottom:1px solid #e5e7eb;
    padding:9px 8px;
    vertical-align:top;
  }

  tr:nth-child(even) td{
    background:#f8fafc;
  }

  .priority-alta{
    color:#b91c1c;
    font-weight:900;
  }

  .priority-media{
    color:#b45309;
    font-weight:900;
  }

  .priority-baja{
    color:#047857;
    font-weight:900;
  }

  .footer{
    margin-top:24px;
    padding-top:14px;
    border-top:1px solid var(--borde);
    color:#64748b;
    font-size:12px;
  }

  .print-note{
    margin-top:14px;
    padding:12px;
    border-radius:12px;
    background:#eef6ff;
    color:#075985;
    font-size:13px;
  }

  @media print{
    body{
      padding:0;
    }

    .section,
    .hero{
      break-inside:avoid;
    }

    .print-note{
      display:none;
    }
  }

  @media(max-width:800px){
    body{
      padding:18px;
    }

    .score-grid,
    .two-col,
    .kpi-grid{
      grid-template-columns:1fr;
    }

    .hero-top{
      flex-direction:column;
    }

    .meta{
      text-align:left;
    }
  }
</style>`;
}

function buildExportReportHeader(title, docType, fecha, hora) {
  return (
    '<main class="report">' +
    '<section class="hero">' +
    '<div class="hero-top">' +
    "<div>" +
    '<div class="badge">Programa Nacional de Inmunizaciones</div>' +
    "<h1>Informe de revisión documental PNI</h1>" +
    "<p>Revisor Documental PNI · Sistema de apoyo para evaluación técnica documental.</p>" +
    "</div>" +
    '<div class="meta">' +
    "<strong>Fecha:</strong> " +
    escapeHTML(fecha) +
    "<br>" +
    "<strong>Hora:</strong> " +
    escapeHTML(hora) +
    "</div>" +
    "</div>" +
    "</section>" +
    '<section class="section soft">' +
    "<h2>Identificación del documento</h2>" +
    "<p><strong>Documento:</strong> " +
    escapeHTML(title) +
    "</p>" +
    "<p><strong>Tipo:</strong> " +
    escapeHTML(docType) +
    "</p>" +
    "</section>"
  );
}

function buildExportExecutiveSection() {
  const e = PNI.executive;

  return (
    '<section class="section">' +
    '<div class="score-grid">' +
    '<div class="score-card">' +
    "<span>Calidad documental</span>" +
    "<strong>" +
    escapeHTML(e.score) +
    "/100</strong>" +
    "<em>" +
    escapeHTML(e.quality.emoji + " " + e.quality.label) +
    "</em>" +
    "</div>" +
    "<div>" +
    "<h2>Resumen ejecutivo</h2>" +
    "<p>" +
    escapeHTML(e.summaryText) +
    "</p>" +
    "</div>" +
    "</div>" +
    "</section>"
  );
}

function buildExportMetricsSection() {
  const e = PNI.executive;
  const p = PNI.documentProfile || {};

  return (
    '<section class="section soft">' +
    "<h2>Indicadores del documento</h2>" +
    '<div class="kpi-grid">' +
    exportKpi("Palabras", formatNumber(p.words || 0)) +
    exportKpi("Párrafos", formatNumber(p.paragraphs || 0)) +
    exportKpi("Observaciones", formatNumber(e.totalFindings || 0)) +
    exportKpi("Riesgo", e.risk.label) +
    exportKpi("Tiempo estimado", e.correctionTime.label) +
    exportKpi("Estado", e.readiness.label) +
    exportKpi("Prioridad dominante", e.dominantPriority) +
    exportKpi("Categoría dominante", e.dominantType) +
    "</div>" +
    "</section>" +
    buildExportBarsSection()
  );
}

function exportKpi(label, value) {
  return (
    '<div class="kpi">' +
    "<span>" +
    escapeHTML(label) +
    "</span>" +
    "<strong>" +
    escapeHTML(value) +
    "</strong>" +
    "</div>"
  );
}

function buildExportBarsSection() {
  const e = PNI.executive;

  return (
    '<section class="section">' +
    '<div class="two-col">' +
    "<div>" +
    "<h3>Distribución por prioridad</h3>" +
    buildBars([
      { label: "Alta", value: e.byPriority.Alta || 0 },
      { label: "Media", value: e.byPriority.Media || 0 },
      { label: "Baja", value: e.byPriority.Baja || 0 }
    ]) +
    "</div>" +
    "<div>" +
    "<h3>Distribución por categoría</h3>" +
    buildBars([
      { label: "Ortografía", value: e.byType.Ortografía || 0 },
      { label: "Terminología", value: e.byType.Terminología || 0 },
      { label: "Coherencia", value: e.byType.Coherencia || 0 },
      { label: "Redacción", value: e.byType.Redacción || 0 },
      { label: "Formato", value: e.byType.Formato || 0 }
    ]) +
    "</div>" +
    "</div>" +
    "</section>"
  );
}

function buildBars(items) {
  const max = Math.max(
    1,
    ...items.map(function (item) {
      return item.value || 0;
    })
  );

  return items
    .map(function (item) {
      const width = Math.round((item.value / max) * 100);

      return (
        '<div class="bar-row">' +
        '<div class="bar-label">' +
        "<span>" +
        escapeHTML(item.label) +
        "</span>" +
        "<strong>" +
        escapeHTML(item.value) +
        "</strong>" +
        "</div>" +
        '<div class="bar"><i style="width:' +
        width +
        '%"></i></div>' +
        "</div>"
      );
    })
    .join("");
}

function buildExportStrengthsSection() {
  const e = PNI.executive;

  return (
    '<section class="section">' +
    '<div class="two-col">' +
    "<div>" +
    "<h2>Fortalezas detectadas</h2>" +
    buildExportList(e.strengths || [], "ul") +
    "</div>" +
    "<div>" +
    "<h2>Top 5 prioridades</h2>" +
    buildExportList(e.topPriorities || [], "ol") +
    "</div>" +
    "</div>" +
    "</section>"
  );
}

function buildExportRecommendationsSection() {
  const e = PNI.executive;

  return (
    '<section class="section soft">' +
    "<h2>Recomendaciones priorizadas</h2>" +
    buildExportList(e.recommendations || [], "ol") +
    "</section>"
  );
}

function buildExportFindingsSection() {
  const findings = PNI.findings || [];

  if (!findings.length) {
    return (
      '<section class="section">' +
      "<h2>Observaciones</h2>" +
      "<p>No se detectaron observaciones relevantes.</p>" +
      "</section>"
    );
  }

  return (
    '<section class="section">' +
    "<h2>Tabla de observaciones</h2>" +
    "<table>" +
    "<thead>" +
    "<tr>" +
    "<th>Página</th>" +
    "<th>Párrafo</th>" +
    "<th>Tipo</th>" +
    "<th>Prioridad</th>" +
    "<th>Texto detectado</th>" +
    "<th>Sugerencia</th>" +
    "<th>Justificación</th>" +
    "</tr>" +
    "</thead>" +
    "<tbody>" +
    findings
      .map(function (item) {
        return (
          "<tr>" +
          "<td>" +
          escapeHTML(item.pagina) +
          "</td>" +
          "<td>" +
          escapeHTML(item.parrafo) +
          "</td>" +
          "<td>" +
          escapeHTML(item.tipo) +
          "</td>" +
          '<td class="priority-' +
          escapeHTML(String(item.prioridad || "").toLowerCase()) +
          '">' +
          escapeHTML(item.prioridad) +
          "</td>" +
          "<td>" +
          escapeHTML(item.texto) +
          "</td>" +
          "<td>" +
          escapeHTML(item.sugerencia) +
          "</td>" +
          "<td>" +
          escapeHTML(item.justificacion) +
          "</td>" +
          "</tr>"
        );
      })
      .join("") +
    "</tbody>" +
    "</table>" +
    "</section>"
  );
}

function buildExportFooter() {
  return (
    '<div class="footer">' +
    "<p><strong>Revisor Documental PNI.</strong></p>" +
    "<p>Informe generado automáticamente como apoyo a la revisión documental. Las observaciones son preliminares y deben ser validadas por el equipo técnico responsable.</p>" +
    '<div class="print-note">Para guardar como PDF, abra este archivo en el navegador y seleccione Imprimir → Guardar como PDF.</div>' +
    "</div>" +
    "</main>"
  );
}

function buildExportList(items, tag) {
  const safeTag = tag === "ol" ? "ol" : "ul";

  return (
    "<" +
    safeTag +
    ">" +
    (items || [])
      .map(function (item) {
        return "<li>" + escapeHTML(item) + "</li>";
      })
      .join("") +
    "</" +
    safeTag +
    ">"
  );
}
/* =========================================================
   PARTE 9/10
   Limpieza, reseteo, utilidades de documento y auxiliares
========================================================= */

function clearDocument() {
  if ($("pniDocTitle")) $("pniDocTitle").value = "";
  if ($("pniDocType")) $("pniDocType").value = "Documento técnico";
  if ($("pniDocText")) $("pniDocText").value = "";
  if ($("pniSearchFindings")) $("pniSearchFindings").value = "";
  if ($("pniFilterType")) $("pniFilterType").value = "Todos";
  if ($("pniFilterPriority")) $("pniFilterPriority").value = "Todas";

  const docFile = $("pniDocFile");
  if (docFile) docFile.value = "";

  PNI.findings = [];
  PNI.longParagraphs = [];
  PNI.executive = null;
  PNI.documentProfile = null;

  setFileStatus("No se ha cargado ningún archivo.", "");

  setText("pniKpiWords", "0");
  setText("pniKpiParagraphs", "0");
  setText("pniKpiFindings", "0");
  setText("pniKpiScore", "--");

  resetExecutivePanel();

  const exportBtn = $("pniExportBtn");
  const exportReportBtn = $("pniExportReportBtn");

  if (exportBtn) exportBtn.disabled = true;
  if (exportReportBtn) exportReportBtn.disabled = true;

  renderEmptyRow(
    "Aún no se ha realizado una revisión. Suba un documento Word/PDF o pegue el texto y presione “Revisar documento”."
  );
}

function resetExecutivePanel() {
  const scoreCard = $("pniScoreCard");

  if (scoreCard) {
    scoreCard.className = "pni-score-card idle";
  }

  setText("pniExecutiveScoreMain", "--");
  setText("pniExecutiveQualityMain", "Pendiente");
  setText(
    "pniExecutiveSummaryText",
    "El resumen ejecutivo se generará automáticamente después de revisar el documento."
  );

  setText("pniExecutiveTotalFindings", "--");
  setText("pniExecutiveDominantPriority", "--");
  setText("pniExecutiveDominantType", "--");
  setText("pniExecutiveCorrectionTime", "--");
  setText("pniExecutiveRiskLevel", "--");
  setText("pniExecutiveReadiness", "--");

  const scoreBar = $("pniExecutiveScoreBar");
  if (scoreBar) scoreBar.style.width = "0%";

  resetStatsPanel("pniPriorityStats");
  resetStatsPanel("pniExecutiveStats");

  resetQualityItem("pniQualityOrthography", "pniQualityOrthographyBar");
  resetQualityItem("pniQualityTerminology", "pniQualityTerminologyBar");
  resetQualityItem("pniQualityCoherence", "pniQualityCoherenceBar");
  resetQualityItem("pniQualityWriting", "pniQualityWritingBar");
  resetQualityItem("pniQualityFormat", "pniQualityFormatBar");

  renderList("pniTopPrioritiesList", ["Pendiente de revisión."], "ol");
  renderList("pniStrengthsList", ["Pendiente de revisión."], "ul");
  renderList("pniRecommendationsList", ["Pendiente de revisión."], "ol");
}

function resetStatsPanel(id) {
  const el = $(id);
  if (!el) return;

  el.innerHTML = '<div class="pni-empty-mini">Pendiente de revisión.</div>';
}

function resetQualityItem(textId, barId) {
  setText(textId, "--");

  const bar = $(barId);
  if (bar) bar.style.width = "0%";
}

function renderList(id, items, tag) {
  const el = $(id);
  if (!el) return;

  const safeTag = tag === "ol" ? "ol" : "ul";

  el.innerHTML = (items || [])
    .map(function (item) {
      return "<li>" + escapeHTML(item) + "</li>";
    })
    .join("");

  if (el.tagName.toLowerCase() !== safeTag) {
    return;
  }
}

function splitParagraphs(text) {
  return String(text || "")
    .replace(/\r/g, "")
    .split(/\n\s*\n|\n/)
    .map(function (p) {
      return p.trim();
    })
    .filter(Boolean);
}

function countWords(text) {
  const words = String(text || "").trim().match(/\b[\p{L}\p{N}]+\b/gu);
  return words ? words.length : 0;
}

function detectPageNumber(paragraph, paragraphNumber) {
  const match = String(paragraph || "").match(/^\[Página\s+(\d+)\]/i);
  if (match) return Number(match[1]);

  return Math.max(1, Math.ceil(paragraphNumber / 7));
}

function isLikelyTableOrList(paragraph) {
  const p = String(paragraph || "").trim();

  if (!p) return false;

  if (/^(•|-|–|\d+\.|[a-z]\))\s+/i.test(p)) return true;

  const separators = (p.match(/\s{2,}|;|\|/g) || []).length;
  const tokens = p.split(/\s+/).filter(Boolean);

  if (!tokens.length) return false;

  const shortTokens = tokens.filter(function (token) {
    return token.length <= 3;
  }).length;

  const numericTokens = tokens.filter(function (token) {
    return /^\d+([.,]\d+)?%?$/.test(token);
  }).length;

  return (
    separators >= 5 ||
    (tokens.length > 20 && shortTokens / tokens.length > 0.45) ||
    (tokens.length > 15 && numericTokens / tokens.length > 0.35)
  );
}

function countBy(items, prop) {
  const result = {};

  (items || []).forEach(function (item) {
    const key = item[prop] || "Sin clasificar";
    result[key] = (result[key] || 0) + 1;
  });

  return result;
}

function getDominantKey(obj) {
  const keys = Object.keys(obj || {});

  if (!keys.length) return "";

  return keys.sort(function (a, b) {
    return obj[b] - obj[a];
  })[0];
}

function setText(id, value) {
  const el = $(id);
  if (!el) return;

  el.textContent = value;
}

function formatNumber(value) {
  return Number(value || 0).toLocaleString("es-CL");
}

function getSafeFileName(title) {
  return String(title || "documento")
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/[^a-z0-9]+/gi, "_")
    .replace(/^_+|_+$/g, "");
}

function csvEscape(value) {
  const str = String(value ?? "");
  return '"' + str.replace(/"/g, '""') + '"';
}

function downloadBlob(content, filename, type) {
  const blob = new Blob([content], {
    type: type
  });

  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");

  a.href = url;
  a.download = filename;

  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);

  URL.revokeObjectURL(url);
}

function escapeHTML(value) {
  return String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}
/* =========================================================
   PARTE 10/10
   Cierre, compatibilidad y funciones finales
========================================================= */

function renderCharts() {
  /*
    Función de compatibilidad.
    En V12 los gráficos se renderizan desde:
    - renderPriorityStats()
    - renderTypeStats()
    - renderQualityRadar()
    ejecutadas dentro de renderExecutivePanel().
  */
  if (PNI.executive) {
    renderPriorityStats();
    renderTypeStats();
    renderQualityRadar();
  }
}

/* =========================================================
   Cierre del módulo principal
========================================================= */

