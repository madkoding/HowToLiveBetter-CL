      /* =====================================================
         6. ALERTAS TÉCNICAS: VERIFICACIÓN CONTRA LINEAMIENTOS
         ===================================================== */

      {
        id: "TEC-001",
        type: "Coherencia",
        priority: "Media",
        pattern: /\binfluenza\b.*\b65 años\b/gi,
        suggestion: "Verificar grupo etario vigente para la estrategia de vacunación contra la influenza.",
