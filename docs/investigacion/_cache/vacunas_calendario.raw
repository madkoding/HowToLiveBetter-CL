{
  "id": "enfermedades_cronicas_nefropatia_cronica_sindrome_nefrotico_dialisis",
  "grupo": "Enfermedades crónicas",
  "nombre": "Nefropatía crónica / síndrome nefrótico / diálisis",
  "vacunas": [
    {
      "nombre": "Influenza",
      "esquema": "1 dosis anual",
      "inicio": "Campaña anual",
      "observacion": "Vacunación anual recomendada."
    },
    {
      "nombre": "COVID-19",
      "esquema": "Según periodicidad definida por el PNI",
      "inicio": "Según estrategia vigente",
      "observacion": "Indicación por enfermedad renal crónica."
    },
    {
      "nombre": "Neumocócica conjugada",
      "esquema": "1 dosis en no vacunados",
      "inicio": "Al diagnóstico o puesta al día",
      "observacion": "Usar VNC-13V o PCV-15 seguida de VNP-23V con intervalo mínimo de 8 semanas. Si se utiliza PCV-20 o PCV-21, administrar 1 dosis sin uso posterior de VNP-23V."
    },
    {
      "nombre": "Neumocócica polisacárida 23v",
      "esquema": "1 dosis posterior a vacuna conjugada; considerar refuerzo según condición",
      "inicio": "Mínimo 8 semanas después de VNC-13V o PCV-15",
      "observacion": "No administrar si se utilizó PCV-20 o PCV-21. IRC, diálisis y síndrome nefrótico son condiciones de mayor riesgo para intervalos y revacunación según tabla neumocócica."
    },
    {
      "nombre": "Hepatitis B",
      "esquema": "3 dosis según serología; doble dosis 40 µg en pacientes en diálisis",
      "inicio": "Al diagnóstico, prediálisis o diálisis",
      "observacion": "Evaluar serología basal y respuesta postvacunal cuando corresponda."
    },
    {
      "nombre": "Varicela",
      "esquema": "2 dosis con intervalo de 3 meses",
      "inicio": "Según edad y antecedente",
      "observacion": "Administrar en personas sin historia clínica o con serología negativa, siempre que no existan contraindicaciones. Vacuna viva atenuada."
    },
    {
      "nombre": "VRS",
      "esquema": "1 dosis",
      "inicio": "Desde los 60 años",
      "observacion": "Recomendada en mayores de 60 años con insuficiencia renal crónica, según disponibilidad e indicaciones vigentes."
    },
    {
      "nombre": "dTpa/dT",
      "esquema": "1 dosis de refuerzo cada 10 años",
      "inicio": "Según antecedente vacunal",
      "observacion": "Mantener protección contra difteria, tétanos y pertussis según calendario y antecedente."
    }
  ],
  "notas": [
    "En diálisis, usar doble dosis de vacuna hepatitis B y evaluar respuesta inmunológica cuando corresponda."
  ],
  "fuente": "Manual de Vacunación Especial, actualización 2025",
  "paginas": "Tabla 8.1-8.3, págs. 105-108"
},
