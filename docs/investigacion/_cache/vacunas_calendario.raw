  function normalizar(texto) {
    return String(texto || "")
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "");
  }

  function esc(texto) {
    return String(texto || "").replace(/[&<>"']/g, function (c) {
      return {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;"
      }[c];
    });
  }

  function baseVEDisponible() {
    return typeof window.matrizCondicionesVE !== "undefined" || typeof matrizCondicionesVE !== "undefined";
  }

  function obtenerBaseVE() {
    if (typeof window.matrizCondicionesVE !== "undefined") return window.matrizCondicionesVE;
    if (typeof matrizCondicionesVE !== "undefined") return matrizCondicionesVE;
    return [];
  }

  function addMessage(text, type) {
    const row = document.createElement("div");
    row.className = "pni-msg-row " + (type === "user" ? "user" : "bot");

    const bubble = document.createElement("div");
    bubble.className = "pni-msg " + (type === "user" ? "pni-user" : "pni-bot");
    bubble.innerHTML = text;

    if (type === "bot") {
      const avatar = document.createElement("div");
      avatar.className = "pni-mini-avatar";
      avatar.innerHTML = "🤖";
      row.appendChild(avatar);
    }

    row.appendChild(bubble);
    chat.appendChild(row);
    chat.scrollTop = chat.scrollHeight;
  }

  function renderOptionsFromList(lista) {
    options.innerHTML = "";

    lista.forEach(function (op) {
      const btn = document.createElement("button");
      btn.className = "pni-option-btn";
      btn.type = "button";
      btn.innerHTML = op.texto;

      btn.addEventListener("click", function () {
        options.innerHTML = "";
        addMessage(op.texto, "user");

        if (op.url) {
          window.open(op.url, "_blank");
          setTimeout(function () {
            addMessage("Se abrió la herramienta solicitada en una nueva pestaña.", "bot");
            renderMenu("inicio", false);
          }, 350);
        } else if (op.destino) {
          renderMenu(op.destino, false);
        } else if (op.veId) {
          responderCondicionVE(op.veId);
        } else if (op.normaId) {
          responderNormaPNI(op.normaId);
        } else if (op.accion) {
          ejecutarAccion(op.accion, op.valor);
        }
      });

      options.appendChild(btn);
    });
  }

  function renderMenu(key, showUserChoice) {
    const menu = MENUS[key];
    if (!menu) return;

    casoClinico.activo = false;

    if (pendingTimer) clearTimeout(pendingTimer);
    options.innerHTML = "";

    if (showUserChoice) addMessage(showUserChoice, "user");

    if (typing) typing.style.display = "block";

    pendingTimer = setTimeout(function () {
      if (typing) typing.style.display = "none";
      addMessage(menu.mensaje, "bot");
      renderOptionsFromList(menu.opciones);
    }, 450);
  }

  function ejecutarAccion(accion, valor) {
    if (accion === "caso_inicio") iniciarCasoClinico();
    if (accion === "caso_edad") seleccionarEdadCaso(valor);
    if (accion === "caso_condicion") seleccionarCondicionCaso(valor);
    if (accion === "caso_subtipo") seleccionarSubtipoCaso(valor);
    if (accion === "caso_reiniciar") iniciarCasoClinico();
    if (accion === "norma_categoria") responderCategoriaNormativa(valor);
  }

  function iniciarCasoClinico() {
    casoClinico = {
      activo: true,
      edad: null,
      condicion: null,
      subtipo: null
    };

    addMessage(
      "<strong>Modo Caso Clínico guiado</strong><br>Para disminuir ambigüedad, primero seleccionaremos rango etario, luego condición clínica y subtipo cuando corresponda.",
      "bot"
    );

    renderOptionsFromList([
      { texto: "👶 Menor de 2 años", accion: "caso_edad", valor: "menor_2" },
      { texto: "🧒 2 a 17 años", accion: "caso_edad", valor: "2_17" },
      { texto: "🧑 18 a 64 años", accion: "caso_edad", valor: "18_64" },
      { texto: "👴 65 años o más", accion: "caso_edad", valor: "65_mas" },
      { texto: "No estoy seguro/a", accion: "caso_edad", valor: "no_seguro" },
      { texto: "Volver al inicio", destino: "inicio" }
    ]);
  }

  function seleccionarEdadCaso(valor) {
    casoClinico.activo = true;
    casoClinico.edad = valor;

    addMessage(
      "<strong>Seleccione la condición principal:</strong><br>El asistente priorizará la búsqueda según el rango etario seleccionado para evitar resultados poco pertinentes.",
      "bot"
    );

    renderOptionsFromList([
      { texto: "Asplenia / hiposplenia", accion: "caso_condicion", valor: "asplenia" },
      { texto: "VIH", accion: "caso_condicion", valor: "vih" },
      { texto: "Trasplante de órgano sólido", accion: "caso_condicion", valor: "tos" },
      { texto: "TPH", accion: "caso_condicion", valor: "tph" },
      { texto: "Prematurez", accion: "caso_condicion", valor: "prematurez" },
      { texto: "Cáncer", accion: "caso_condicion", valor: "cancer" },
      { texto: "Volver al inicio", destino: "inicio" }
    ]);
  }

  function seleccionarCondicionCaso(valor) {
    casoClinico.activo = true;
    casoClinico.condicion = valor;
    casoClinico.subtipo = null;

    const def = CONDICIONES_GUIADAS[valor];

    if (!def) {
      addMessage("No encontré una ruta guiada para esa condición.", "bot");
      renderMenu("inicio", false);
      return;
    }

    addMessage(
      "<strong>" + esc(def.etiqueta) + "</strong><br>Seleccione el subtipo que mejor representa el caso. Si no tiene el antecedente, seleccione “No estoy seguro/a”.",
      "bot"
    );

    const opts = def.subtipos.map(function (s) {
      return { texto: s.etiqueta, accion: "caso_subtipo", valor: s.id };
    });

    opts.push({ texto: "Reiniciar caso clínico", accion: "caso_reiniciar" });
    opts.push({ texto: "Volver al inicio", destino: "inicio" });

    renderOptionsFromList(opts);
  }

  function seleccionarSubtipoCaso(valor) {
    casoClinico.subtipo = valor;

    const resultados = buscarCondicionesVEGuiado(casoClinico);

    if (!resultados.length) {
      addMessage(
        "<strong>No encontré una ficha específica para esa combinación.</strong><br>Se recomienda revisar el Resumen de Vacunación Especial y/o ajustar el subtipo seleccionado.",
        "bot"
      );

      renderOptionsFromList([
        { texto: "Abrir Resumen de Vacunación Especial", url: URLS.vacunacionEspecial },
        { texto: "Reiniciar caso clínico", accion: "caso_reiniciar" },
        { texto: "Volver al inicio", destino: "inicio" }
      ]);
      return;
    }

    responderCoincidenciasVE(resultados, true);
  }

  function edadEsAdulto(edad) {
    return edad === "18_64" || edad === "65_mas";
  }

  function edadEsPediatrica(edad) {
    return edad === "menor_2" || edad === "2_17";
  }

  function textoCondicionVE(item) {
    return [
      item.grupo,
      item.nombre,
      item.id,
      item.paginas || "",
      (item.vacunas || []).map(function (v) {
        return [v.nombre, v.esquema, v.inicio].join(" ");
      }).join(" ")
    ].join(" ");
  }

  function puntuarVEGuiado(item, caso) {
    const grupo = normalizar(item.grupo);
    const nombre = normalizar(item.nombre);
    const id = normalizar(item.id);
    const texto = normalizar(textoCondicionVE(item));

    let p = 0;

    const condicion = caso.condicion;
    const subtipo = caso.subtipo;
    const edad = caso.edad;

    if (condicion === "asplenia") {
      if (grupo.includes("asplenia") || grupo.includes("hiposplenia") || id.includes("asplenia") || id.includes("hiposplenia")) p += 300;

      if (subtipo === "asplenia_congenita" && (nombre.includes("congenita") || id.includes("congenita"))) p += 140;
      if (subtipo === "asplenia_adquirida" && (nombre.includes("adquirida") || id.includes("adquirida") || nombre.includes("esplenectomia") || id.includes("esplenectomia"))) p += 140;
      if (subtipo === "asplenia_funcional" && (nombre.includes("funcional") || id.includes("funcional") || nombre.includes("hiposplenia") || id.includes("hiposplenia"))) p += 140;

      if (edadEsAdulto(edad)) {
        if (nombre.includes("adulto") || id.includes("adulto")) p += 120;
        if (nombre.includes("congenita") || id.includes("congenita") || nombre.includes("lactante") || nombre.includes("niño") || nombre.includes("pediatr")) p -= 180;
      }

      if (edadEsPediatrica(edad)) {
        if (nombre.includes("pediatr") || nombre.includes("niño") || nombre.includes("lactante") || nombre.includes("congenita")) p += 80;
        if (nombre.includes("adulto")) p -= 120;
      }

      if (subtipo === "asplenia_no_seguro") {
        if (edadEsAdulto(edad) && (nombre.includes("adulto") || id.includes("adulto"))) p += 100;
        if (edadEsAdulto(edad) && nombre.includes("congenita")) p -= 150;
      }
    }

    if (condicion === "vih") {
      if (grupo === "vih" || id.includes("vih")) p += 300;

      if (subtipo === "vih_adulto" && (nombre.includes("adulto") || nombre.includes("adolescente"))) p += 180;
      if (subtipo === "vih_pediatrico" && (nombre.includes("pediatr") || nombre.includes("vertical"))) p += 180;
      if (subtipo === "vih_expuesto" && nombre.includes("expuesto")) p += 180;

      if (edadEsAdulto(edad)) {
        if (nombre.includes("adulto") || nombre.includes("adolescente")) p += 100;
        if (nombre.includes("lactante") || nombre.includes("pediatr")) p -= 160;
      }

      if (edadEsPediatrica(edad)) {
        if (nombre.includes("pediatr") || nombre.includes("lactante") || nombre.includes("expuesto")) p += 80;
        if (nombre.includes("adulto")) p -= 80;
      }
    }

    if (condicion === "tph") {
      if (grupo === "tph" || id.includes("tph")) p += 300;

      if (subtipo === "tph_adulto" && nombre.includes("adulto")) p += 180;
      if (subtipo === "tph_estandar" && nombre.includes("estandar")) p += 160;
      if (subtipo === "tph_precoz" && nombre.includes("precoz")) p += 160;
      if (subtipo === "tph_contactos" && nombre.includes("contactos")) p += 180;

      if (edadEsAdulto(edad)) {
        if (nombre.includes("adulto")) p += 120;
        if (nombre.includes("menor de 7") || nombre.includes("7 anos") || nombre.includes("7 años")) p -= 100;
      }

      if (edadEsPediatrica(edad)) {
        if (nombre.includes("menor de 7") || nombre.includes("7 anos") || nombre.includes("7 años")) p += 80;
        if (nombre.includes("adulto")) p -= 100;
      }
    }

    if (condicion === "tos") {
      if (grupo.includes("trasplante de organo solido") || grupo.includes("trasplante de órgano sólido") || id.includes("trasplante_de_organo_solido")) p += 300;

      if (subtipo === "tos_candidato" && nombre.includes("candidato")) p += 160;
      if (subtipo === "tos_receptor" && nombre.includes("receptor")) p += 160;

      if (edadEsAdulto(edad)) {
        if (nombre.includes("adulto") || nombre.includes("adolescente")) p += 100;
        if (nombre.includes("pediatrico") || nombre.includes("pediátrico") || nombre.includes("2 meses") || nombre.includes("6 años")) p -= 120;
      }

      if (edadEsPediatrica(edad)) {
        if (nombre.includes("pediatrico") || nombre.includes("pediátrico") || nombre.includes("2 meses") || nombre.includes("7 a 15")) p += 90;
      }
    }

    if (condicion === "prematurez") {
      if (grupo.includes("prematurez") || id.includes("prematurez") || id.includes("rnpt")) p += 300;
      if (subtipo === "prematuro_sano" && nombre.includes("sano")) p += 140;
      if (subtipo === "prematuro_riesgo" && (nombre.includes("32") || nombre.includes("1500") || nombre.includes("patologia") || nombre.includes("patología"))) p += 160;

      if (edadEsAdulto(edad)) p -= 250;
    }

    if (condicion === "cancer") {
      if (grupo.includes("cancer") || grupo.includes("cáncer") || id.includes("cancer")) p += 300;

      if (subtipo === "cancer_pediatrico" && (nombre.includes("niño") || nombre.includes("adolescente"))) p += 170;
      if (subtipo === "cancer_adulto" && nombre.includes("adulto")) p += 170;
      if (subtipo === "cancer_contactos" && nombre.includes("contactos")) p += 170;

      if (edadEsAdulto(edad)) {
        if (nombre.includes("adulto")) p += 100;
        if (nombre.includes("niño") || nombre.includes("adolescente")) p -= 100;
      }

      if (edadEsPediatrica(edad)) {
        if (nombre.includes("niño") || nombre.includes("adolescente")) p += 100;
        if (nombre.includes("adulto")) p -= 100;
      }
    }

    if (p > 0 && texto.includes("contactos") && subtipo && !String(subtipo).includes("contact")) p -= 80;

    return p;
  }

  function buscarCondicionesVEGuiado(caso) {
    if (!baseVEDisponible()) return [];

    return obtenerBaseVE()
      .map(function (item) {
        return { item: item, score: puntuarVEGuiado(item, caso) };
      })
      .filter(function (x) { return x.score > 0; })
      .sort(function (a, b) { return b.score - a.score; })
      .slice(0, 4)
      .map(function (x) { return x.item; });
  }

  function puntuarVELibre(item, consulta) {
    const q = normalizar(consulta.trim());
    const nombre = normalizar(item.nombre);
    const grupo = normalizar(item.grupo);
    const id = normalizar(item.id);
    const vacunas = normalizar((item.vacunas || []).map(function (v) { return v.nombre; }).join(" "));

    let p = 0;

    if (nombre === q) p += 160;
    if (grupo === q) p += 140;
    if (id.includes(q)) p += 90;
    if (nombre.includes(q)) p += 100;
    if (grupo.includes(q)) p += 90;
    if (vacunas.includes(q)) p += 45;

    if (q === "vih" && grupo === "vih") p += 200;
    if ((q === "tph" || q.includes("trasplante progenitores")) && grupo === "tph") p += 200;
    if (q.includes("asplenia") && grupo.includes("asplenia")) p += 200;
    if (q.includes("premat") && grupo.includes("prematurez")) p += 200;
    if ((q.includes("cancer") || q.includes("cáncer")) && grupo.includes("cancer")) p += 180;
    if (q.includes("trasplante") && grupo.includes("trasplante")) p += 160;

    if ((q.includes("persona mayor") || q.includes("adulto") || q.includes("65") || q.includes("70")) && nombre.includes("congenita")) p -= 120;
    if ((q.includes("persona mayor") || q.includes("adulto") || q.includes("65") || q.includes("70")) && nombre.includes("adulto")) p += 80;

    return p;
  }

  function buscarCondicionesVELibre(consulta) {
    if (!baseVEDisponible()) return [];

    const q = normalizar(consulta.trim());
    if (q.length < 2) return [];

    return obtenerBaseVE()
      .map(function (item) {
        return { item: item, score: puntuarVELibre(item, consulta) };
      })
      .filter(function (x) { return x.score > 0; })
      .sort(function (a, b) { return b.score - a.score; })
      .slice(0, 4)
      .map(function (x) { return x.item; });
  }

  function resumenVacunasVE(item, limite) {
    return (item.vacunas || [])
      .slice(0, limite || 8)
      .map(function (v) {
        let linea = "• <strong>" + esc(v.nombre) + "</strong>";
        if (v.esquema) linea += ": " + esc(v.esquema);
        if (v.inicio) linea += " <em>(" + esc(v.inicio) + ")</em>";
        if (v.observacion) linea += "<br><span style='color:#475569;'>" + esc(v.observacion) + "</span>";
        return linea;
      })
      .join("<br><br>");
  }

  function construirRespuestaVE(item, guiado) {
    const totalVacunas = (item.vacunas || []).length;

    let html = "";
    html += guiado ? "<strong>Resultado del caso clínico guiado:</strong><br>" : "<strong>Condición encontrada en Vacunación Especial:</strong><br>";
    html += "<span style='display:inline-block;margin-top:6px;background:#eaf4fb;color:#005c97;border-radius:999px;padding:4px 10px;font-size:12px;font-weight:800;'>" + esc(item.grupo) + "</span><br>";
    html += "<strong>" + esc(item.nombre) + "</strong><br><br>";

    if (totalVacunas) {
      html += "<strong>Vacunas asociadas:</strong><br>";
      html += resumenVacunasVE(item, 8);

      if (totalVacunas > 8) {
        html += "<br><br><em>Se muestran las primeras 8 vacunas de " + totalVacunas + ". Para el detalle completo, revise el Resumen de Vacunación Especial.</em>";
      }
    } else {
      html += "No se registran vacunas asociadas en la matriz para esta condición.";
    }

    if (item.notas && item.notas.length) {
      html += "<br><br><strong>Notas relevantes:</strong><br>";
      html += item.notas.slice(0, 3).map(function (n) {
        return "• " + esc(n);
      }).join("<br>");
    }

    html += "<br><br><strong>Fuente:</strong><br>";
    html += esc(item.fuente || "Manual de Vacunación Especial");
    if (item.paginas) html += "<br>" + esc(item.paginas);

    html += "<br><br><strong>Importante:</strong> Esta es una orientación de apoyo. La indicación final debe validarse con antecedentes clínicos, edad, registro vacunal y lineamientos vigentes.";

    return html;
  }

  function responderCondicionVE(id) {
    const item = obtenerBaseVE().find(function (x) { return x.id === id; });
    if (!item) return;

    addMessage(construirRespuestaVE(item, casoClinico.activo), "bot");
    renderOptionsFromList([
      { texto: "Abrir Resumen de Vacunación Especial", url: URLS.vacunacionEspecial },
      { texto: "Abrir Calculadora de Puesta al Día", url: URLS.puestaDia },
      { texto: "Reiniciar caso clínico", accion: "caso_reiniciar" },
      { texto: "Volver al inicio", destino: "inicio" }
    ]);
  }

  function responderCoincidenciasVE(coincidencias, guiado) {
    if (!coincidencias.length) return false;

    if (coincidencias.length === 1) {
      addMessage(construirRespuestaVE(coincidencias[0], guiado), "bot");
      renderOptionsFromList([
        { texto: "Abrir Resumen de Vacunación Especial", url: URLS.vacunacionEspecial },
        { texto: "Abrir Calculadora de Puesta al Día", url: URLS.puestaDia },
        { texto: "Reiniciar caso clínico", accion: "caso_reiniciar" },
        { texto: "Volver al inicio", destino: "inicio" }
      ]);
      return true;
    }

    let html = guiado
      ? "<strong>Encontré más de una ficha compatible con el caso clínico:</strong><br><br>"
      : "<strong>Encontré varias condiciones relacionadas en Vacunación Especial:</strong><br><br>";

    coincidencias.forEach(function (item, i) {
      const vacunas = (item.vacunas || []).map(function (v) { return v.nombre; }).slice(0, 5).join("; ");
      html += (i + 1) + ". <strong>" + esc(item.nombre) + "</strong><br>";
      html += "<span style='color:#005c97;font-weight:700;'>" + esc(item.grupo) + "</span><br>";
      if (vacunas) html += "<span style='color:#475569;'>Vacunas: " + esc(vacunas) + "</span><br>";
      if (item.paginas) html += "<span style='color:#64748b;'>" + esc(item.paginas) + "</span><br>";
      html += "<br>";
    });

    html += "Seleccione la ficha que corresponda para ver el detalle resumido.";

    addMessage(html, "bot");

    const opts = coincidencias.map(function (item) {
      return { texto: item.nombre, veId: item.id };
    });

    opts.push({ texto: "Abrir Resumen de Vacunación Especial", url: URLS.vacunacionEspecial });
    opts.push({ texto: "Reiniciar caso clínico", accion: "caso_reiniciar" });
    opts.push({ texto: "Volver al inicio", destino: "inicio" });

    renderOptionsFromList(opts);
    return true;
  }


  function puntuarNormativaPNI(item, consulta) {
    const q = normalizar(consulta);
    const titulo = normalizar(item.titulo);
    const categoria = normalizar(item.categoria);
    const tipo = normalizar(item.tipo);
    const resumen = normalizar(item.resumen);
    const palabras = normalizar((item.palabras || []).join(" "));

    let p = 0;

    if (titulo === q) p += 180;
    if (categoria === q) p += 140;
    if (titulo.includes(q)) p += 100;
    if (categoria.includes(q)) p += 90;
    if (tipo.includes(q)) p += 50;
    if (palabras.includes(q)) p += 95;
    if (resumen.includes(q)) p += 30;

    if (q.includes("registro") && item.categoria.includes("Registro")) p += 160;
    if ((q.includes("cadena") || q.includes("temperatura") || q.includes("excursion") || q.includes("excursión")) && item.categoria.includes("Cadena de frío")) p += 170;
    if ((q.includes("especial") || q.includes("vih") || q.includes("asplenia") || q.includes("trasplante") || q.includes("tph")) && item.categoria.includes("Vacunación especial")) p += 170;
    if (q.includes("puesta") && item.categoria.includes("Puesta al día")) p += 170;
    if ((q.includes("influenza") || q.includes("covid") || q.includes("vrs") || q.includes("virus respiratorio sincicial") || q.includes("sarampion") || q.includes("sarampión") || q.includes("campana") || q.includes("campaña")) && item.categoria.includes("Campañas")) p += 150;
    if ((q.includes("influenza") || q.includes("covid") || q.includes("vrs")) && item.anio === 2026 && item.tipo && item.tipo.includes("vigente")) p += 120;
    if ((q.includes("escolar") || q.includes("colegio") || q.includes("escuela") || q.includes("vph")) && item.categoria.includes("Vacunación escolar")) p += 190;
    if ((q.includes("vph") || q.includes("papiloma")) && item.categoria.includes("VPH")) p += 190;
    if ((q.includes("esavi") || q.includes("vacunacion segura") || q.includes("vacunación segura")) && item.categoria.includes("ESAVI")) p += 190;
    if ((q.includes("epro") || q.includes("error programatico") || q.includes("error programático")) && item.categoria.includes("EPRO")) p += 190;
    if ((q.includes("extramural") || q.includes("punto")) && item.categoria.includes("extramural")) p += 160;
    if ((q.includes("recien nacido") || q.includes("recién nacido") || q === "rn" || q.includes("bcg") || q.includes("hepatitis b")) && item.categoria.includes("Recién nacido")) p += 160;

    if (item.vigente === true) p += 25;
    if (item.vigente === false && !q.includes("historico") && !q.includes("histórico") && !q.includes("2020")) p -= 120;
    if (item.anio) p += Math.min(30, Math.max(0, item.anio - 2020) * 5);
    if (item.prioridad) p += item.prioridad / 10;

    return p;
  }

  function buscarNormativaPNI(consulta) {
    const q = normalizar(consulta.trim());
    if (q.length < 2) return [];

    const consultaNormativa = [
      "norma", "normativa", "documento", "manual", "decreto", "resolucion", "resolución",
      "ordinario", "ord", "lineamiento", "guia", "guía", "registro", "rni",
      "cadena", "temperatura", "excursion", "extramural", "marco regulatorio"
    ].some(function (palabra) {
      return q.includes(normalizar(palabra));
    });

    const resultados = BASE_NORMATIVA_PNI
      .map(function (item) {
        return { item: item, score: puntuarNormativaPNI(item, consulta) };
      })
      .filter(function (x) { return x.score > 0; })
      .sort(function (a, b) { return b.score - a.score; })
      .slice(0, consultaNormativa ? 5 : 3)
      .map(function (x) { return x.item; });

    if (!consultaNormativa && resultados.length && puntuarNormativaPNI(resultados[0], consulta) < 120) {
      return [];
    }

    return resultados;
  }

  function construirRespuestaNormativaPNI(item) {
    let html = "";
    html += "<strong>Documento normativo/técnico encontrado:</strong><br>";
    html += "<span style='display:inline-block;margin-top:6px;background:#eaf4fb;color:#005c97;border-radius:999px;padding:4px 10px;font-size:12px;font-weight:800;'>" + esc(item.categoria) + "</span><br>";
    html += "<strong>" + esc(item.titulo) + "</strong><br>";
    html += "<span style='color:#64748b;'>" + esc(item.tipo || "Documento");
    if (item.anio) html += " · " + esc(item.anio);
    html += item.vigente === false ? " · Histórico/no vigente" : " · Vigente/referencial";
    html += "</span><br><br>";
    html += esc(item.resumen || "Documento disponible en el sitio del PNI.");
    html += "<br><br><strong>Uso sugerido:</strong><br>";
    html += "Utilícelo como referencia técnica/normativa, verificando siempre vigencia, versión oficial y eventuales actualizaciones publicadas por MINSAL.";
    return html;
  }

  function responderNormaPNI(id) {
    const item = BASE_NORMATIVA_PNI.find(function (x) { return x.id === id; });
    if (!item) return;

    addMessage(construirRespuestaNormativaPNI(item), "bot");

    renderOptionsFromList([
      { texto: "Abrir documento", url: item.url },
      { texto: "Abrir documento / sección", url: URLS.marcoRegulatorio },
      { texto: "Volver a Documentos y normativa", destino: "documentos" },
      { texto: "Volver al inicio", destino: "inicio" }
    ]);
  }

  function responderCoincidenciasNormativaPNI(resultados) {
    if (!resultados.length) return false;

    if (resultados.length === 1) {
      responderNormaPNI(resultados[0].id);
      return true;
    }

    let html = "<strong>Encontré documentos relacionados:</strong><br><br>";

    resultados.forEach(function (item, i) {
      html += (i + 1) + ". <strong>" + esc(item.titulo) + "</strong><br>";
      html += "<span style='color:#005c97;font-weight:700;'>" + esc(item.categoria) + "</span> · ";
      html += "<span style='color:#64748b;'>" + esc(item.tipo || "Documento") + "</span><br>";
      html += "<span style='color:#475569;'>" + esc(item.resumen || "") + "</span><br><br>";
    });

    html += "Seleccione un documento para abrir su ficha y enlace.";

    addMessage(html, "bot");

    const opts = resultados.map(function (item) {
      return { texto: item.titulo, normaId: item.id };
    });

    opts.push({ texto: "Abrir documento / sección", url: URLS.marcoRegulatorio });
    opts.push({ texto: "Volver al inicio", destino: "inicio" });

    renderOptionsFromList(opts);
    return true;
  }

  function responderCategoriaNormativa(categoria) {
    const cat = normalizar(categoria);

    const resultados = BASE_NORMATIVA_PNI
      .filter(function (item) {
        return normalizar(item.categoria).includes(cat) || cat.includes(normalizar(item.categoria));
      })
      .slice(0, 8);

    if (!resultados.length) {
      addMessage("No encontré documentos cargados para esa categoría. Puede revisar el Marco Regulatorio PNI.", "bot");
      renderOptionsFromList([
        { texto: "Abrir documento / sección", url: URLS.marcoRegulatorio },
        { texto: "Volver a Documentos y normativa", destino: "documentos" }
      ]);
      return;
    }

    responderCoincidenciasNormativaPNI(resultados);
  }

  function buscarRespuestaLibre(textoUsuario) {
    const texto = normalizar(textoUsuario);

    let mejor = null;
    let puntajeMejor = 0;

    CONOCIMIENTO.forEach(function (item) {
      let puntaje = 0;

      item.claves.forEach(function (clave) {
        const claveNormalizada = normalizar(clave);
        if (texto.includes(claveNormalizada)) puntaje += claveNormalizada.length;
      });

      if (puntaje > puntajeMejor) {
        puntajeMejor = puntaje;
        mejor = item;
      }
    });

    return mejor;
  }

  function responderTextoLibre() {
    if (!input) return;

    const consulta = input.value.trim();
    if (!consulta) return;

    addMessage(consulta, "user");
    input.value = "";
    options.innerHTML = "";

    if (typing) typing.style.display = "block";

    setTimeout(function () {
      if (typing) typing.style.display = "none";

      const coincidenciasNormativa = buscarNormativaPNI(consulta);

      if (coincidenciasNormativa.length > 0) {
        responderCoincidenciasNormativaPNI(coincidenciasNormativa);
        return;
      }

      const coincidenciasVE = buscarCondicionesVELibre(consulta);

      if (coincidenciasVE.length > 0) {
        responderCoincidenciasVE(coincidenciasVE, false);
        return;
      }

      const resultado = buscarRespuestaLibre(consulta);

      if (resultado) {
        addMessage(resultado.respuesta, "bot");
        renderOptionsFromList(resultado.opciones.concat([
          { texto: "Volver al inicio", destino: "inicio" }
        ]));
      } else {
        addMessage(
          "<strong>No encontré una orientación específica para esa consulta.</strong><br>Para mayor precisión, usa el <strong>Modo Caso Clínico</strong>, especialmente en condiciones con varias variantes como asplenia, VIH, TPH, cáncer, prematurez o trasplante.",
          "bot"
        );

        renderOptionsFromList([
          { texto: "🧾 Iniciar Modo Caso Clínico", accion: "caso_inicio" },
          { texto: "Ir a Vacunación Especial", url: URLS.vacunacionEspecial },
          { texto: "Ir a Puesta al Día", url: URLS.puestaDia },
          { texto: "Volver al inicio", destino: "inicio" }
        ]);
      }

    }, 500);
  }

  reset.addEventListener("click", function () {
    if (pendingTimer) clearTimeout(pendingTimer);
    chat.innerHTML = "";
    options.innerHTML = "";
    casoClinico = { activo: false, edad: null, condicion: null, subtipo: null };
    if (typing) typing.style.display = "none";
    if (input) input.value = "";
    renderMenu("inicio", false);
  });

  if (send) send.addEventListener("click", responderTextoLibre);

  if (input) {
    input.addEventListener("keydown", function (e) {
      if (e.key === "Enter") {
        e.preventDefault();
        responderTextoLibre();
      }
    });
  }

  chat.innerHTML = "";
  options.innerHTML = "";

  if (!baseVEDisponible()) {
    renderMenu("inicio", false);
    setTimeout(function () {
      addMessage("<strong>Nota técnica:</strong><br>La base de Vacunación Especial no está cargada en esta página. Para activar respuestas clínicas detalladas por condición, cargue el snippet <strong>Base VE - Asistente PNI</strong> antes del JavaScript del asistente.", "bot");
    }, 900);
  } else {
    renderMenu("inicio", false);
  }

});
</script><style class="wpcode-css-snippet">/* ==========================================
   ASISTENTE PNI V2
========================================== */

.pni-chatapp{
  max-width:900px;
  margin:0 auto;
  padding:28px 16px 60px;
  font-family:Arial,Helvetica,sans-serif;
}

/* BOTÓN VOLVER */

.pni-chat-actions-top{
  margin-bottom:14px;
}

.pni-back-suite{
  display:inline-block;
  background:#ffffff;
  color:#003057 !important;
  border:1px solid #cbd5e1;
  border-radius:999px;
  padding:10px 16px;
  font-size:14px;
  font-weight:700;
  text-decoration:none !important;
  box-shadow:0 4px 10px rgba(15,23,42,.06);
}

.pni-back-suite:hover{
  background:#eaf4fb;
}

/* CONTENEDOR */

.pni-chatapp-phone{
  background:#eef3f7;
  border-radius:32px;
  overflow:hidden;
  border:1px solid #d7e1ea;
  box-shadow:0 18px 45px rgba(0,0,0,.14);
}

/* HEADER */

.pni-chat-header{
  background:linear-gradient(135deg,#003057,#005c97);
  color:#fff;
  padding:22px;
  display:flex;
  align-items:center;
  gap:14px;
}

.pni-chat-avatar{
  width:54px;
  height:54px;
  border-radius:50%;
  background:#ffffff;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:28px;
  flex-shrink:0;
}

.pni-chat-header h1{
  margin:0;
  color:#fff !important;
  font-size:24px;
  font-weight:800;
}

.pni-chat-header p{
  margin:4px 0 0;
  font-size:14px;
  color:#dbeafe;
}

/* INTRO */

.pni-chat-intro{
  background:#ffffff;
  color:#334155;
  padding:16px 22px;
  border-bottom:1px solid #dbe5ee;
  font-size:14.5px;
  line-height:1.6;
}

.pni-chat-intro strong{
  color:#003057;
}

/* CHAT */

.pni-chat-window{
  min-height:300px;
  max-height:500px;
  overflow-y:auto;
  padding:22px;
  display:flex;
  flex-direction:column;
  gap:14px;
  background:
    radial-gradient(circle at top left, rgba(0,92,151,.08), transparent 30%),
    #f8fafc;
}

.pni-chat-window .pni-msg-row{
  width:100%;
  display:flex;
  gap:8px;
  align-items:flex-end;
}

.pni-chat-window .pni-msg-row.bot{
  justify-content:flex-start;
}

.pni-chat-window .pni-msg-row.user{
  justify-content:flex-end;
}

/* AVATAR */

.pni-chat-window .pni-mini-avatar{
  width:32px;
  height:32px;
  min-width:32px;
  border-radius:50%;
  background:#dbeafe;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:16px;
}

/* BURBUJAS */

.pni-chat-window .pni-msg{
  display:inline-block;
  min-width:120px;
  max-width:76%;
  padding:14px 16px;
  border-radius:18px;
  line-height:1.6;
  font-size:15px;
  word-break:break-word;
  box-shadow:0 4px 10px rgba(15,23,42,.06);
  animation:pniFadeIn .2s ease-out;
}

@keyframes pniFadeIn{
  from{
    opacity:0;
    transform:translateY(6px);
  }
  to{
    opacity:1;
    transform:translateY(0);
  }
}

.pni-chat-window .pni-bot{
  background:#ffffff;
  color:#1f2937;
  border-bottom-left-radius:6px;
}

.pni-chat-window .pni-user{
  background:#005c97;
  color:#ffffff;
  border-bottom-right-radius:6px;
}

.pni-chat-window .pni-bot strong{
  color:#003057;
}

.pni-chat-window .pni-user strong{
  color:#ffffff;
}

/* ESCRIBIENDO */

.pni-typing{
  padding:0 24px 12px;
  background:#f8fafc;
}

.pni-typing span{
  display:inline-block;
  width:8px;
  height:8px;
  margin-right:4px;
  background:#94a3b8;
  border-radius:50%;
  animation:pniTyping 1.2s infinite ease-in-out;
}

.pni-typing span:nth-child(2){
  animation-delay:.2s;
}

.pni-typing span:nth-child(3){
  animation-delay:.4s;
}

@keyframes pniTyping{
  0%,80%,100%{
    transform:scale(.7);
    opacity:.4;
  }
  40%{
    transform:scale(1);
    opacity:1;
  }
}

/* BOTONES DE OPCIONES */

.pni-chat-options{
  background:#f8fafc;
  padding:0 20px 20px;
  display:flex;
  flex-wrap:wrap;
  gap:10px;
}

.pni-option-btn{
  border:none;
  background:#ffffff;
  color:#003057;
  border:1px solid #cbd5e1;
  border-radius:999px;
  padding:11px 16px;
  font-size:14px;
  font-weight:700;
  cursor:pointer;
  transition:.2s;
  box-shadow:0 3px 8px rgba(15,23,42,.05);
}

.pni-option-btn:hover{
  background:#eaf4fb;
  border-color:#005c97;
  transform:translateY(-1px);
}

/* BARRA DE ENTRADA */

.pni-chat-inputbar{
  border-top:1px solid #dbe5ee;
  background:#ffffff;
  padding:14px 18px;
  display:flex;
  align-items:center;
  gap:10px;
}

.pni-input-real input{
  flex:1;
  border:1px solid #cbd5e1;
  border-radius:999px;
  padding:12px 16px;
  font-size:14px;
  outline:none;
  color:#1f2937;
  background:#ffffff;
}

.pni-input-real input:focus{
  border-color:#005c97;
  box-shadow:0 0 0 3px rgba(0,92,151,.12);
}

.pni-chat-inputbar button{
  width:42px;
  height:42px;
  border-radius:50%;
  border:none;
  background:#003057;
  color:#ffffff;
  font-size:18px;
  cursor:pointer;
  flex-shrink:0;
}

.pni-chat-inputbar button:hover{
  background:#005c97;
}

/* FOOTER */

.pni-chat-footer{
  margin-top:26px;
  padding:22px;
  background:#f8fafc;
  border-left:5px solid #005c97;
  border-radius:16px;
  color:#475569;
  line-height:1.65;
  font-size:14px;
}

/* SCROLL */

.pni-chat-window::-webkit-scrollbar{
  width:8px;
}

.pni-chat-window::-webkit-scrollbar-track{
  background:#e2e8f0;
}

.pni-chat-window::-webkit-scrollbar-thumb{
  background:#94a3b8;
  border-radius:999px;
}

/* MOBILE */

@media(max-width:768px){

  .pni-chatapp{
    padding:18px 10px 50px;
  }

  .pni-chat-window{
    min-height:320px;
    max-height:520px;
    padding:18px;
  }

  .pni-chat-window .pni-msg{
    max-width:84%;
    font-size:14.5px;
  }

  .pni-chat-options{
    padding:0 14px 18px;
  }

  .pni-chat-intro{
    padding:14px 18px;
  }

  .pni-input-real{
    gap:8px;
  }

  .pni-input-real input{
    min-width:0;
    font-size:13.5px;
  }

}</style><style class="wpcode-css-snippet">.pni-suite{
  max-width:1200px;
  margin:0 auto;
  padding:40px 20px 70px;
  font-family:Arial,Helvetica,sans-serif;
}

/* HERO */

.pni-suite-hero{
  background:linear-gradient(135deg,#003057,#005c97);
  color:#fff;
  text-align:center;
  padding:50px 35px;
  border-radius:28px;
  margin-bottom:28px;
  box-shadow:0 12px 35px rgba(0,0,0,.12);
}

.pni-logo{
  display:block;
  margin:0 auto 20px;
  max-width:180px;
  width:100%;
  height:auto;
  filter:drop-shadow(0 4px 10px rgba(0,0,0,.15));
}

.pni-suite-badge{
  display:inline-block;
  padding:8px 16px;
  border-radius:999px;
  background:rgba(255,255,255,.15);
  border:1px solid rgba(255,255,255,.25);
  font-size:14px;
  font-weight:700;
  margin-bottom:18px;
}

.pni-suite-hero h1{
  color:#fff;
  margin:0 0 15px;
  font-size:46px;
  font-weight:800;
}

.pni-suite-hero p{
  max-width:820px;
  margin:auto;
  line-height:1.7;
  font-size:18px;
}

/* ASISTENTE PNI DESTACADO */

.pni-assistant-panel{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:24px;
  width:100%;
  background:linear-gradient(135deg,#ffffff,#f2f8fc);
  border:1px solid #cfe0ec;
  border-left:7px solid #005c97;
  border-radius:24px;
  padding:22px 26px;
  margin:0 0 38px;
  text-decoration:none !important;
  color:inherit;
  box-shadow:0 10px 24px rgba(15,23,42,.08);
  transition:.25s;
}

.pni-assistant-panel:hover{
  transform:translateY(-3px);
  box-shadow:0 16px 34px rgba(15,23,42,.13);
  border-color:#b8d2e6;
}

.pni-assistant-left{
  display:flex;
  align-items:center;
  gap:18px;
  min-width:0;
}

.pni-assistant-icon{
  width:64px;
  height:64px;
  min-width:64px;
  display:flex;
  align-items:center;
  justify-content:center;
  background:#eaf4fb;
  border-radius:20px;
  font-size:34px;
}

.pni-assistant-kicker{
  display:inline-block;
  color:#005c97;
  font-size:13px;
  font-weight:800;
  text-transform:uppercase;
  letter-spacing:.03em;
  margin-bottom:4px;
}

.pni-assistant-panel h2{
  margin:0 0 6px;
  color:#003057;
  font-size:25px;
  font-weight:900;
  line-height:1.2;
}

.pni-assistant-panel p{
  margin:0;
  color:#475569;
  font-size:15px;
  line-height:1.55;
  max-width:780px;
}

.pni-assistant-action{
  background:#005c97;
  color:#fff;
  padding:11px 20px;
  border-radius:999px;
  font-weight:800;
  white-space:nowrap;
  box-shadow:0 6px 14px rgba(0,92,151,.22);
}

.pni-assistant-panel:hover .pni-assistant-action{
  background:#003057;
}

/* TITULOS */

.pni-section-title{
  display:flex;
  align-items:center;
  gap:12px;
  margin:40px 0 20px;
}

.pni-section-title span{
  font-size:28px;
}

.pni-section-title h2{
  margin:0;
  color:#003057;
  font-size:30px;
  font-weight:800;
}

/* GRID */

.pni-suite-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
  gap:24px;
}

/* TARJETAS */

.pni-tool-card{
  background:#fff;
  border-radius:24px;
  padding:28px;
  text-decoration:none !important;
  color:inherit;
  border:1px solid #dbe5ee;
  box-shadow:0 8px 20px rgba(0,0,0,.06);
  transition:.25s;
}

.pni-tool-card:hover{
  transform:translateY(-5px);
  box-shadow:0 16px 32px rgba(0,0,0,.12);
}

.pni-tool-icon{
  width:70px;
  height:70px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:34px;
  border-radius:18px;
  background:#eaf4fb;
  margin-bottom:18px;
}

.pni-tool-card h3{
  margin:0 0 12px;
  color:#003057;
  font-size:22px;
  font-weight:800;
}

.pni-tool-card p{
  margin:0 0 20px;
  line-height:1.6;
  color:#4b5563;
}

.pni-tool-card span{
  display:inline-block;
  background:#005c97;
  color:#fff;
  padding:10px 18px;
  border-radius:999px;
  font-weight:700;
}


.pni-tool-card{
  display:flex;
  flex-direction:column;
}

.pni-tool-card span{
  margin-top:auto;
  align-self:flex-start;
}

/* PIE */

.pni-footer{
  margin-top:50px;
  padding-top:25px;
  border-top:1px solid #dbe5ee;
  text-align:center;
  color:#64748b;
  font-size:14px;
  line-height:1.7;
}

/* MOBILE */

@media(max-width:768px){

  .pni-suite{
    padding:20px 12px 50px;
  }

  .pni-suite-hero{
    padding:35px 22px;
  }

  .pni-logo{
    max-width:140px;
  }

  .pni-suite-hero h1{
    font-size:34px;
  }

  .pni-suite-hero p{
    font-size:16px;
  }

  .pni-assistant-panel{
    flex-direction:column;
    align-items:flex-start;
    gap:16px;
    padding:20px;
    margin-bottom:32px;
  }

  .pni-assistant-left{
    align-items:flex-start;
  }

  .pni-assistant-icon{
    width:54px;
    height:54px;
    min-width:54px;
    font-size:28px;
    border-radius:17px;
  }

  .pni-assistant-panel h2{
    font-size:22px;
  }

  .pni-assistant-panel p{
    font-size:14.5px;
  }

  .pni-assistant-action{
    width:100%;
    text-align:center;
  }

  .pni-section-title h2{
    font-size:24px;
  }

}
/* TARJETA DESTACADA EPRO INSIGHT */

.pni-tool-card-featured{
  position:relative;
  overflow:hidden;
  border:1px solid #b8d7ee;
  background:
    linear-gradient(135deg,#ffffff 0%,#f2f8fc 48%,#eaf4fb 100%);
  box-shadow:0 12px 28px rgba(0,92,151,.12);
}

.pni-tool-card-featured::before{
  content:"Nuevo";
  position:absolute;
  top:18px;
  right:18px;
  background:#003057;
  color:#fff;
  font-size:12px;
  font-weight:800;
  padding:7px 12px;
  border-radius:999px;
  letter-spacing:.02em;
}

.pni-tool-card-featured::after{
  content:"";
  position:absolute;
  width:120px;
  height:120px;
  right:-45px;
  bottom:-45px;
  border-radius:50%;
  background:rgba(0,92,151,.10);
  pointer-events:none;
}

.pni-tool-card-featured .pni-tool-icon{
  background:#dff0ff;
  box-shadow:0 8px 20px rgba(0,92,151,.15);
}

.pni-tool-card-featured h3{
  color:#003057;
}

.pni-tool-card-featured span{
  background:#003057;
}

.pni-tool-card-featured:hover{
  border-color:#005c97;
  box-shadow:0 18px 38px rgba(0,92,151,.18);
}</style><script>const PNI_SHEETS_URL = "https://script.google.com/macros/s/AKfycbysY3M1dzEQ-sFKU6v7fjz9ahOtOErXXeP5XHh2Q-ZjtbBTw3xIEovXbRzmF9mMIs3R7Q/exec";

let pniHtml5QrCode = null;
let pniScannerActivo = false;
let pniUltimoCodigo = "";
let pniUltimoTiempo = 0;

function pniMostrarMensaje(texto, tipo) {
  const msg = document.getElementById("pniMensaje");
  if (!msg) return;

  msg.textContent = texto;
  msg.className = "pni-msg " + tipo;
}

function pniFeedbackEscaneo() {
  if (navigator.vibrate) {
    navigator.vibrate(100);
  }

  const check = document.getElementById("pniScanSuccess");
  if (!check) return;

  check.classList.add("show");

  setTimeout(function () {
    check.classList.remove("show");
  }, 800);
}

function pniCargarLibreria(callback) {
  if (window.Html5Qrcode) {
    callback();
    return;
  }

  const script = document.createElement("script");
  script.src = "https://unpkg.com/html5-qrcode";
  script.onload = callback;
  script.onerror = function () {
    pniMostrarMensaje("No se pudo cargar la librería del lector.", "error");
  };

  document.head.appendChild(script);
}

function pniLimpiarProducto() {
  document.getElementById("pniProducto").value = "";
  document.getElementById("pniTipoProducto").value = "";
  document.getElementById("pniLaboratorio").value = "";
  document.getElementById("pniPresentacion").value = "";
}

function pniBuscarProducto(codigo) {
  if (!codigo) return;

  pniMostrarMensaje("Buscando producto en hoja maestra...", "info");

  const callbackName = "pniProductoCallback_" + Date.now();

  window[callbackName] = function (data) {
    if (data && data.encontrado) {
      document.getElementById("pniProducto").value = data.producto || "";
      document.getElementById("pniTipoProducto").value = data.tipo || "";
      document.getElementById("pniLaboratorio").value = data.laboratorio || "";
      document.getElementById("pniPresentacion").value = data.presentacion || "";

      pniMostrarMensaje("Producto identificado correctamente.", "ok");
    } else {
      pniLimpiarProducto();
      pniMostrarMensaje("Código leído, pero no existe en la hoja maestra. Puede completar el producto manualmente.", "info");
    }

    delete window[callbackName];
    script.remove();
  };

  const script = document.createElement("script");
  script.src = PNI_SHEETS_URL + "?codigo=" + encodeURIComponent(codigo) + "&callback=" + callbackName;

  script.onerror = function () {
    pniMostrarMensaje("No fue posible consultar la hoja maestra.", "error");
    delete window[callbackName];
    script.remove();
  };

  document.body.appendChild(script);
}

async function pniIniciarScanner() {
  const readerId = "pniReader";
  const btnIniciar = document.getElementById("pniIniciarScanner");
  const btnDetener = document.getElementById("pniDetenerScanner");

  if (pniScannerActivo) return;

  pniCargarLibreria(async function () {
    try {
      pniHtml5QrCode = new Html5Qrcode(readerId);

      const config = {
        fps: 10,
        qrbox: function (viewfinderWidth, viewfinderHeight) {
          const minEdge = Math.min(viewfinderWidth, viewfinderHeight);
          const boxSize = Math.floor(minEdge * 0.75);
          return { width: boxSize, height: boxSize };
        },
        rememberLastUsedCamera: true
      };

      await pniHtml5QrCode.start(
        { facingMode: "environment" },
        config,
        function (decodedText) {
          const ahora = Date.now();

          if (decodedText === pniUltimoCodigo && ahora - pniUltimoTiempo < 2000) {
            return;
          }

          pniUltimoCodigo = decodedText;
          pniUltimoTiempo = ahora;

          pniFeedbackEscaneo();

          document.getElementById("pniCodigo").value = decodedText;

          pniBuscarProducto(decodedText);
        },
        function () {}
      );

      pniScannerActivo = true;
      btnIniciar.disabled = true;
      btnDetener.disabled = false;

      pniMostrarMensaje("Cámara activa. Apunte al código QR o código de barras.", "info");

    } catch (error) {
      console.error(error);
      pniMostrarMensaje("No fue posible iniciar la cámara. Verifique permisos del navegador y que la página esté en HTTPS.", "error");
    }
  });
}

async function pniDetenerScanner() {
  const btnIniciar = document.getElementById("pniIniciarScanner");
  const btnDetener = document.getElementById("pniDetenerScanner");

  try {
    if (pniHtml5QrCode && pniScannerActivo) {
      await pniHtml5QrCode.stop();
      await pniHtml5QrCode.clear();
    }

    pniScannerActivo = false;
    btnIniciar.disabled = false;
    btnDetener.disabled = true;

    pniMostrarMensaje("Cámara detenida.", "info");

  } catch (error) {
    console.error(error);
    pniMostrarMensaje("No se pudo detener correctamente la cámara.", "error");
  }
}

async function pniEnviarRegistro() {
  const funcionario = document.getElementById("pniFuncionario").value.trim();
  const establecimiento = document.getElementById("pniEstablecimiento").value.trim();
  const tipoRegistro = document.getElementById("pniTipoRegistro").value;
  const codigo = document.getElementById("pniCodigo").value.trim();
  const producto = document.getElementById("pniProducto").value.trim();
  const tipoProducto = document.getElementById("pniTipoProducto").value.trim();
  const laboratorio = document.getElementById("pniLaboratorio").value.trim();
  const presentacion = document.getElementById("pniPresentacion").value.trim();
  const observacion = document.getElementById("pniObservacion").value.trim();

  if (!funcionario || !establecimiento || !codigo) {
    pniMostrarMensaje("Debe completar funcionario, establecimiento y código leído.", "error");
    return;
  }

  const payload = {
    funcionario: funcionario,
    establecimiento: establecimiento,
    tipoRegistro: tipoRegistro,
    codigo: codigo,
    producto: producto,
    tipoProducto: tipoProducto,
    laboratorio: laboratorio,
    presentacion: presentacion,
    observacion: observacion,
    dispositivo: navigator.userAgent
  };

  try {
    pniMostrarMensaje("Enviando registro a Google Sheets...", "info");

    await fetch(PNI_SHEETS_URL, {
      method: "POST",
      mode: "no-cors",
      headers: {
        "Content-Type": "text/plain;charset=utf-8"
      },
      body: JSON.stringify(payload)
    });

    pniMostrarMensaje("Registro enviado correctamente.", "ok");

    document.getElementById("pniCodigo").value = "";
    document.getElementById("pniProducto").value = "";
    document.getElementById("pniTipoProducto").value = "";
    document.getElementById("pniLaboratorio").value = "";
    document.getElementById("pniPresentacion").value = "";
    document.getElementById("pniObservacion").value = "";

  } catch (error) {
    console.error(error);
    pniMostrarMensaje("No fue posible enviar el registro a Google Sheets.", "error");
  }
}

document.addEventListener("DOMContentLoaded", function () {
  const btnIniciar = document.getElementById("pniIniciarScanner");
  const btnDetener = document.getElementById("pniDetenerScanner");
  const btnEnviar = document.getElementById("pniEnviar");
  const codigoInput = document.getElementById("pniCodigo");

  if (btnIniciar) btnIniciar.addEventListener("click", pniIniciarScanner);
  if (btnDetener) btnDetener.addEventListener("click", pniDetenerScanner);
  if (btnEnviar) btnEnviar.addEventListener("click", pniEnviarRegistro);

  if (codigoInput) {
    codigoInput.addEventListener("change", function () {
      pniBuscarProducto(this.value.trim());
    });
  }
});</script><style class="wpcode-css-snippet">.pni-scanner-app {
  max-width: 780px;
  margin: 0 auto;
  padding: 16px;
  font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.pni-hero {
  background: linear-gradient(135deg, #005c97, #003f6b);
  color: #fff;
  border-radius: 22px;
  padding: 28px 22px;
  margin-bottom: 18px;
  box-shadow: 0 12px 30px rgba(0, 63, 107, 0.22);
}

.pni-kicker {
  margin: 0 0 8px 0;
  font-size: 13px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  opacity: 0.9;
}

.pni-hero h2 {
  color: #fff;
  margin: 0 0 8px 0;
  font-size: 26px;
  font-weight: 800;
}

.pni-hero p {
  margin: 0;
  font-size: 15px;
  line-height: 1.45;
}

.pni-card {
  background: #fff;
  border: 1px solid #dde7f0;
  border-radius: 20px;
  padding: 20px;
  box-shadow: 0 8px 24px rgba(15, 46, 78, 0.08);
}

.pni-card label {
  display: block;
  margin: 14px 0 6px;
  font-weight: 700;
  color: #12324a;
  font-size: 14px;
}

.pni-card input,
.pni-card select,
.pni-card textarea {
  width: 100%;
  border: 1px solid #cfdbe6;
  border-radius: 12px;
  padding: 12px 13px;
  font-size: 16px;
  background: #f8fbfd;
  box-sizing: border-box;
}

.pni-card textarea {
  min-height: 82px;
  resize: vertical;
}

.pni-btn {
  width: 100%;
  border: 0;
  border-radius: 14px;
  padding: 14px 16px;
  margin-top: 16px;
  background: #005c97;
  color: #fff;
  font-size: 16px;
  font-weight: 800;
  cursor: pointer;
}

.pni-btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
}

.pni-btn-secondary {
  background: #607d92;
}

.pni-btn-send {
  background: #007a5a;
}

#pniReader {
  margin-top: 18px;
  border-radius: 16px;
  overflow: hidden;
  border: 1px dashed #b9cbd9;
  background: #f3f7fa;
}

.pni-msg {
  margin-top: 16px;
  padding: 12px;
  border-radius: 12px;
  display: none;
  font-weight: 700;
}

.pni-msg.ok {
  display: block;
  background: #e8f6ef;
  color: #146c43;
}

.pni-msg.error {
  display: block;
  background: #fdecec;
  color: #a4262c;
}

.pni-msg.info {
  display: block;
  background: #edf5ff;
  color: #005c97;
}</style><script>const VACCINATION_DATA = [
  // ===================== CAPÍTULO 2: PREMATUREZ =====================
  {
    id: "cap2_prematurez",
    capitulo: "Cap 2",
    nombre: "Prematurez (<32 sem y/o <1500g, o <37 sem con patología de base)",
    subcategorias: [
      {
        id: "cap2_pni",
        nombre: "PNI en RNT y RNPT sano sin patologías de base",
        tabla: "Tabla 1.1",
        pagina: 31,
        edadGrupo: "Menor de 7 años",
