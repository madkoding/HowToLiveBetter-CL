/* ==========================================
   Carga online (Biblioteca PNI Online)
   Si el plugin está instalado, el visor usa la
   base guardada en línea. Si no responde, usa
   la base local (respaldo).
========================================== */

/* Se intentan varias rutas en orden: la canónica del plugin, la variante
   ?rest_route= (evita bloqueos de WAF sobre /wp-json) y /?bpni_docs=1
   (ruta propia del plugin, fuera del REST API, para cuando un plugin de
   seguridad restringe el REST a usuarios autenticados). */
const BPNI_API_URLS = [
  "/wp-json/bpni/v1/documentos",
  "/?rest_route=/bpni/v1/documentos",
  "/?bpni_docs=1"
];
const BPNI_CACHE_KEY = "bpni_docs_online_v1";

function guardarCacheDocumentos(lista) {
  try {
    localStorage.setItem(BPNI_CACHE_KEY, JSON.stringify({
      fecha: new Date().toISOString(),
      documentos: lista
    }));
  } catch (e) { /* almacenamiento no disponible */ }
}

function leerCacheDocumentos() {
  try {
    const crudo = localStorage.getItem(BPNI_CACHE_KEY);
    if (!crudo) return null;
    const datos = JSON.parse(crudo);
    return datos && Array.isArray(datos.documentos) ? datos.documentos : null;
  } catch (e) {
    return null;
  }
}

function bpniIntentarUrl(indice) {
  if (indice >= BPNI_API_URLS.length) {
    /* Todas las rutas fallaron (plugin inactivo, WAF, red sin acceso).
       Se usa la última copia en línea guardada en el navegador; si no
       existe, null (el visor usará la base embebida). */
    const respaldo = leerCacheDocumentos();
    if (respaldo) console.warn("Biblioteca PNI: API en línea no disponible; usando última copia guardada.");
    return Promise.resolve(respaldo);
  }
  const url = BPNI_API_URLS[indice] + (BPNI_API_URLS[indice].indexOf("?") >= 0 ? "&" : "?") + "t=" + Date.now();
  return fetch(url, { cache: "no-store", credentials: "same-origin" })
    .then(function (res) {
      if (!res.ok) throw new Error("API no disponible");
      return res.json();
    })
    .then(function (data) {
      if (data && Array.isArray(data.documentos)) {
        guardarCacheDocumentos(data.documentos);
        return data.documentos;
      }
      throw new Error("Respuesta sin documentos");
    })
    .catch(function () {
      return bpniIntentarUrl(indice + 1);
    });
}

function cargarDocumentosOnline() {
  return bpniIntentarUrl(0);
}

document.addEventListener("DOMContentLoaded", function () {
  const app = document.getElementById("biblioteca-pni-app");
  if (!app) return;

  const input = document.getElementById("bpniBuscar");
  const limpiar = document.getElementById("bpniLimpiar");
  const categoriasBox = document.getElementById("bpniCategorias");
  const resultadosBox = document.getElementById("bpniResultados");
  const resumenBox = document.getElementById("bpniResumen");
  const historicos = document.getElementById("bpniMostrarHistoricos");
  const filtroAnio = document.getElementById("bpniAnio");
  const filtroTipo = document.getElementById("bpniTipo");
  const filtroOrden = document.getElementById("bpniOrden");
  const activosBox = document.getElementById("bpniActivos");
  const statTotal = document.getElementById("bpniStatTotal");
  const statVigentes = document.getElementById("bpniStatVigentes");
  const modal = document.getElementById("bpniModal");
  const modalTitulo = document.getElementById("bpniModalTitulo");
  const modalFrame = document.getElementById("bpniPreviewFrame");
  const modalAbrir = document.getElementById("bpniModalAbrir");
  const cerrarModal = document.getElementById("bpniCerrarModal");
  const modalResumen = document.getElementById("bpniModalResumen");
  const modalMeta = document.getElementById("bpniModalMeta");

  let categoriaActiva = "Todas";

  let docs = normalizarDocumentos(BASE_NORMATIVA_PNI);

  function normalizarTexto(valor) {
    return String(valor || "")
      .toLowerCase()
      .normalize("NFD")
      .replace(/[\u0300-\u036f]/g, "")
      .replace(/[^a-z0-9ñ°\s.-]/g, " ")
      .replace(/\s+/g, " ")
      .trim();
  }

  function normalizarCategoria(categoria) {
    const original = String(categoria || "Marco regulatorio").trim();
    const c = normalizarTexto(original);

    /* Unificación de categorías equivalentes o demasiado fragmentadas */
    if (c.indexOf("vrs") !== -1 || c.indexOf("nirsevimab") !== -1) return "VRS / Nirsevimab";
    if (c.indexOf("sarampion") !== -1 || c.indexOf("srp") !== -1) return "Sarampión / SRP";
    if (c.indexOf("vacunacion escolar") !== -1 && c.indexOf("vph") !== -1) return "Vacunación escolar / VPH";
    if (c.indexOf("escolar") !== -1) return "Vacunación escolar";
    if (c.indexOf("covid") !== -1 || c.indexOf("sars") !== -1) return "COVID-19";
    if (c.indexOf("influenza") !== -1) return "Influenza";
    if (c.indexOf("cadena") !== -1 || c.indexOf("frio") !== -1) return "Cadena de frío";
    if (c.indexOf("registro") !== -1 || c.indexOf("rni") !== -1 || c.indexOf("sci") !== -1) return "Registro / sistemas";
    if (c.indexOf("esavi") !== -1) return "Vacunación segura / ESAVI";
    if (c.indexOf("epro") !== -1) return "Vacunación segura / EPRO";
    if (c.indexOf("segura") !== -1) return "Vacunación segura";
    if (c.indexOf("puesta") !== -1) return "Puesta al día";
    if (c.indexOf("especial") !== -1) return "Vacunación especial";
    if (c.indexOf("recien") !== -1 || c.indexOf("bcg") !== -1) return "Recién nacido / BCG";
    if (c.indexOf("producto") !== -1 || c.indexOf("vacunas y productos") !== -1) return "Vacunas y productos";
    if (c.indexOf("marco") !== -1 || c.indexOf("normativa") !== -1) return "Marco regulatorio";
    return original;
  }

  function obtenerConsultaNormalizada() {
    return normalizarTexto(input ? input.value : "");
  }

  function pasaBusqueda(doc, consulta) {
    if (!consulta) return true;
    const partes = consulta.split(" ").filter(function (p) { return p.length >= 2; });
    return partes.every(function (p) { return doc.texto.indexOf(p) !== -1; }) ||
           doc.texto.indexOf(consulta) !== -1;
  }

  function pasaFiltrosBase(doc, opciones) {
    opciones = opciones || {};
    const consulta = opciones.consulta != null ? opciones.consulta : obtenerConsultaNormalizada();
    const anio = filtroAnio ? filtroAnio.value : "Todos";
    const tipo = filtroTipo ? filtroTipo.value : "Todos";
    const mostrarHistoricos = historicos && historicos.checked;

    if (!mostrarHistoricos && !doc.vigente) return false;
    if (anio !== "Todos" && String(doc.anio) !== String(anio)) return false;
    if (tipo !== "Todos" && doc.tipo !== tipo) return false;
    if (!pasaBusqueda(doc, consulta)) return false;
    return true;
  }

  function normalizarDocumentos(lista) {
    const vistos = new Set();

    return (lista || [])
      .filter(function (doc) { return doc && doc.url; })
      .filter(function (doc) {
        const clave = String(doc.url).trim();
        if (vistos.has(clave)) return false;
        vistos.add(clave);
        return true;
      })
      .map(function (doc, index) {
        const textoBusqueda = [
          doc.titulo,
          doc.categoria,
          doc.tipo,
          doc.anio,
          doc.resumen,
          (doc.palabras || []).join(" "),
          doc.url
        ].join(" ");

        return {
          id: doc.id || ("doc_" + index),
          categoria: normalizarCategoria(doc.categoria),
          titulo: doc.titulo || "Documento PNI",
          tipo: doc.tipo || "Documento técnico",
          anio: doc.anio || "",
          vigente: doc.vigente !== false,
          prioridad: Number(doc.prioridad || 100),
          palabras: doc.palabras || [],
          resumen: doc.resumen || "Documento técnico, normativo u operativo del Programa Nacional de Inmunizaciones.",
          url: doc.url,
          texto: normalizarTexto(textoBusqueda)
        };
      });
  }

  function esc(valor) {
    return String(valor == null ? "" : valor)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }



  function slugClase(valor) {
    return normalizarTexto(valor)
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, "") || "documento";
  }

  function claseTipo(tipo) {
    const t = normalizarTexto(tipo);
    if (t.indexOf("resolucion") !== -1) return "bpni-chip-resolucion";
    if (t.indexOf("ordinario") !== -1 || t.indexOf("oficio") !== -1 || t === "ord") return "bpni-chip-ordinario";
    if (t.indexOf("decreto") !== -1) return "bpni-chip-decreto";
    if (t.indexOf("circular") !== -1) return "bpni-chip-circular";
    if (t.indexOf("lineamiento") !== -1 || t.indexOf("lto") !== -1) return "bpni-chip-lineamiento";
    if (t.indexOf("manual") !== -1 || t.indexOf("recomendacion") !== -1) return "bpni-chip-manual";
    if (t.indexOf("guia") !== -1 || t.indexOf("guía") !== -1) return "bpni-chip-guia";
    if (t.indexOf("procedimiento") !== -1) return "bpni-chip-procedimiento";
    if (t.indexOf("carta") !== -1) return "bpni-chip-carta";
    if (t.indexOf("presentacion") !== -1 || t.indexOf("presentación") !== -1) return "bpni-chip-presentacion";
    if (t.indexOf("calendario") !== -1) return "bpni-chip-calendario";
    return "bpni-chip-documento";
  }

  function claseCategoria(categoria) {
    const c = normalizarTexto(categoria);
    if (c.indexOf("influenza") !== -1) return "bpni-cat-influenza";
    if (c.indexOf("covid") !== -1 || c.indexOf("sars") !== -1) return "bpni-cat-covid";
    if (c.indexOf("vrs") !== -1 || c.indexOf("recien") !== -1 || c.indexOf("recién") !== -1) return "bpni-cat-vrs";
    if (c.indexOf("escolar") !== -1 || c.indexOf("vph") !== -1) return "bpni-cat-escolar";
    if (c.indexOf("sarampion") !== -1 || c.indexOf("sarampión") !== -1 || c.indexOf("srp") !== -1) return "bpni-cat-sarampion";
    if (c.indexOf("especial") !== -1 || c.indexOf("puesta") !== -1) return "bpni-cat-especial";
    if (c.indexOf("frio") !== -1 || c.indexOf("frío") !== -1 || c.indexOf("producto") !== -1) return "bpni-cat-frio";
    if (c.indexOf("registro") !== -1 || c.indexOf("rni") !== -1 || c.indexOf("sci") !== -1) return "bpni-cat-registro";
    if (c.indexOf("segura") !== -1 || c.indexOf("esavi") !== -1 || c.indexOf("epro") !== -1) return "bpni-cat-segura";
    if (c.indexOf("calendario") !== -1) return "bpni-cat-calendario";
    return "bpni-cat-general";
  }


  function iconoTipo(tipo) {
    const t = normalizarTexto(tipo);
    if (t.indexOf("resolucion") !== -1) return "⚖️";
    if (t.indexOf("decreto") !== -1) return "📜";
    if (t.indexOf("ordinario") !== -1 || t.indexOf("oficio") !== -1) return "📄";
    if (t.indexOf("circular") !== -1) return "🔁";
    if (t.indexOf("lineamiento") !== -1 || t.indexOf("lto") !== -1) return "📘";
    if (t.indexOf("manual") !== -1 || t.indexOf("recomendacion") !== -1) return "📚";
    if (t.indexOf("guia") !== -1) return "🧭";
    if (t.indexOf("procedimiento") !== -1) return "🧩";
    if (t.indexOf("carta") !== -1) return "✉️";
    if (t.indexOf("calendario") !== -1) return "📅";
    return "📌";
  }

  function contarPor(campo, lista) {
    return Array.from(new Set(lista.map(function (d) { return d[campo]; }).filter(Boolean)));
  }

  function poblarSelectores() {
    const anios = contarPor("anio", docs).sort(function (a,b) { return Number(b) - Number(a); });
    const tipos = contarPor("tipo", docs).sort(function (a,b) { return String(a).localeCompare(String(b), "es"); });

    if (filtroAnio) {
      filtroAnio.innerHTML = '<option value="Todos">Todos los años</option>' +
        anios.map(function (anio) { return '<option value="' + esc(anio) + '">' + esc(anio) + '</option>'; }).join("");
    }

    if (filtroTipo) {
      filtroTipo.innerHTML = '<option value="Todos">Todos los tipos</option>' +
        tipos.map(function (tipo) { return '<option value="' + esc(tipo) + '">' + esc(tipo) + '</option>'; }).join("");
    }
  }

  function renderStats() {
    if (statTotal) statTotal.textContent = docs.length;
    if (statVigentes) statVigentes.textContent = docs.filter(function (d) { return d.vigente; }).length;

  }

  function obtenerCategorias() {
    /*
      Las categorías se recalculan según los filtros superiores activos
      (búsqueda, año, tipo documental y vigencia).
      Así, si se selecciona "Circular", solo se muestran categorías que tienen circulares.
    */
    const base = docs.filter(function (doc) { return pasaFiltrosBase(doc); });
    const conteo = {};

    base.forEach(function (doc) {
      conteo[doc.categoria] = (conteo[doc.categoria] || 0) + 1;
    });

    const categorias = Object.keys(conteo).sort(function (a,b) {
      return conteo[b] - conteo[a] || a.localeCompare(b, "es");
    });

    return ["Todas"].concat(categorias);
  }

  function renderCategorias() {
    const cats = obtenerCategorias();

    if (categoriaActiva !== "Todas" && cats.indexOf(categoriaActiva) === -1) {
      categoriaActiva = "Todas";
    }

    const base = docs.filter(function (doc) { return pasaFiltrosBase(doc); });

    categoriasBox.innerHTML = cats.map(function (cat) {
      const activa = cat === categoriaActiva ? " activa" : "";
      const total = cat === "Todas"
        ? base.length
        : base.filter(function (d) { return d.categoria === cat; }).length;

      return '<button class="bpni-cat-btn' + activa + '" type="button" data-cat="' + esc(cat) + '">' +
        esc(cat) + ' <span>(' + total + ')</span></button>';
    }).join("");

    const titulo = document.getElementById("bpniCategoriasTitulo");
    if (titulo) {
      const tipo = filtroTipo ? filtroTipo.value : "Todos";
      titulo.innerHTML = tipo === "Todos"
        ? 'Categorías'
        : 'Categorías <small>(solo se muestran las que tienen documentos del tipo seleccionado)</small>';
    }
  }

  function scoreDocumento(doc, consulta) {
    let score = doc.prioridad || 0;
    if (!consulta) return score;

    const partes = consulta.split(" ").filter(function (p) { return p.length >= 2; });

    partes.forEach(function (p) {
      if (normalizarTexto(doc.titulo).indexOf(p) !== -1) score += 60;
      if (normalizarTexto(doc.categoria).indexOf(p) !== -1) score += 35;
      if (normalizarTexto(doc.tipo).indexOf(p) !== -1) score += 20;
      if (String(doc.anio).indexOf(p) !== -1) score += 18;
      if (doc.texto.indexOf(p) !== -1) score += 10;
    });

    if (doc.texto.indexOf(consulta) !== -1) score += 80;

    return score;
  }

  function filtrarDocumentos() {
    const consulta = obtenerConsultaNormalizada();

    return docs
      .filter(function (doc) { return pasaFiltrosBase(doc, { consulta: consulta }); })
      .filter(function (doc) { return categoriaActiva === "Todas" || doc.categoria === categoriaActiva; })
      .map(function (doc) {
        doc._score = scoreDocumento(doc, consulta);
        return doc;
      });
  }

  function ordenarDocumentos(lista) {
    const orden = filtroOrden ? filtroOrden.value : "reciente";

    return lista.sort(function (a,b) {
      if (orden === "reciente") {
        const anioA = Number(a.anio) || 0;
        const anioB = Number(b.anio) || 0;
        return anioB - anioA ||
          (b.prioridad || 0) - (a.prioridad || 0) ||
          a.titulo.localeCompare(b.titulo, "es");
      }

      if (orden === "titulo") {
        return a.titulo.localeCompare(b.titulo, "es");
      }

      if (orden === "categoria") {
        return a.categoria.localeCompare(b.categoria, "es") || a.titulo.localeCompare(b.titulo, "es");
      }

      return (b._score || 0) - (a._score || 0) ||
        Number(b.anio || 0) - Number(a.anio || 0) ||
        a.titulo.localeCompare(b.titulo, "es");
    });
  }

  function renderActivos(total) {
    if (!activosBox) return;

    const chips = [];
    const consulta = input && input.value.trim() ? input.value.trim() : "";
    const anio = filtroAnio ? filtroAnio.value : "Todos";
    const tipo = filtroTipo ? filtroTipo.value : "Todos";

    if (consulta) chips.push("Búsqueda: " + consulta);
    if (categoriaActiva !== "Todas") chips.push("Categoría: " + categoriaActiva);
    if (anio !== "Todos") chips.push("Año: " + anio);
    if (tipo !== "Todos") chips.push("Tipo: " + tipo);
    if (historicos && historicos.checked) chips.push("Incluye históricos");

    activosBox.innerHTML = chips.length
      ? chips.map(function (c) { return '<span class="bpni-active-pill">' + esc(c) + '</span>'; }).join("")
      : '<span class="bpni-active-pill">Vista inicial: documentos vigentes ordenados por fecha reciente</span>';
  }

  function renderResultados() {
    const lista = ordenarDocumentos(filtrarDocumentos());

    resumenBox.innerHTML = '<strong>' + lista.length + '</strong> documento' + (lista.length === 1 ? '' : 's') + ' encontrado' + (lista.length === 1 ? '' : 's');
    renderActivos(lista.length);

    if (!lista.length) {
      resultadosBox.innerHTML = `
        <div class="bpni-empty">
          No se encontraron documentos para la búsqueda seleccionada. Pruebe con términos como:
          <strong>sarampión</strong>, <strong>vacunación escolar</strong>, <strong>ESAVI</strong>, <strong>EPRO</strong>,
          <strong>influenza</strong>, <strong>COVID-19</strong>, <strong>VRS</strong>, <strong>registro</strong>,
          <strong>cadena de frío</strong>, <strong>recién nacido</strong>, <strong>VPH</strong> o <strong>puesta al día</strong>.
        </div>
      `;
      return;
    }

    resultadosBox.innerHTML = lista.map(function (doc) {
      const vigente = doc.vigente === false
        ? '<span class="bpni-chip bpni-chip-hist">Histórico/no vigente</span>'
        : '';
      const claseT = claseTipo(doc.tipo || "Documento técnico");
      const claseC = claseCategoria(doc.categoria || "Marco regulatorio");

      return `
        <article class="bpni-card ${claseC}">
          <div class="bpni-card-top bpni-card-top-v23">
            <div class="bpni-chip-row">
              <span class="bpni-chip bpni-chip-tipo ${claseT}">${esc(doc.tipo || "Documento técnico")}</span>
              <span class="bpni-chip bpni-chip-cat ${claseC}">${esc(doc.categoria || "Documento")}</span>
            </div>
            <div class="bpni-chip-row bpni-chip-row-meta">
              ${doc.anio ? `<span class="bpni-chip bpni-chip-year">${esc(doc.anio)}</span>` : ""}
              ${vigente}
            </div>
          </div>

          <h3>${esc(doc.titulo)}</h3>

          <div class="bpni-tipo">${esc(doc.tipo || "Documento técnico")}</div>

          <div class="bpni-meta">Categoría: ${esc(doc.categoria)} · Año del documento: ${esc(doc.anio || "s/i")}</div>

          <div class="bpni-actions">
            <a href="${esc(doc.url)}" target="_blank" rel="noopener noreferrer">Ver documento</a>
            <button class="bpni-preview" type="button" data-preview="${esc(doc.id)}">Vista previa</button>
            <button type="button" data-copy="${esc(doc.url)}">Copiar enlace</button>
          </div>
        </article>
      `;
    }).join("");
  }

  function copiarEnlace(url) {
    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(url);
      return;
    }

    const temp = document.createElement("input");
    temp.value = url;
    document.body.appendChild(temp);
    temp.select();
    document.execCommand("copy");
    document.body.removeChild(temp);
  }

  function abrirPreview(id) {
    const doc = docs.find(function (d) { return d.id === id; });
    if (!doc || !modal || !modalFrame) return;

    modalTitulo.textContent = doc.titulo;
    if (modalMeta) modalMeta.textContent = [doc.tipo || "Documento técnico", doc.categoria || "Marco regulatorio", doc.anio ? ("Año " + doc.anio) : "Año s/i"].join(" · ");
    if (modalResumen) modalResumen.innerHTML = String(doc.resumen || "").trim()
      ? '<strong>Resumen:</strong> ' + esc(doc.resumen)
      : '';
    modalFrame.src = doc.url;
    modalAbrir.href = doc.url;
    modal.classList.add("abierto");
    modal.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
  }

  function cerrarPreview() {
    if (!modal) return;
    modal.classList.remove("abierto");
    modal.setAttribute("aria-hidden", "true");
    if (modalFrame) modalFrame.src = "";
    if (modalResumen) modalResumen.innerHTML = "";
    if (modalMeta) modalMeta.textContent = "";
    document.body.style.overflow = "";
  }

  poblarSelectores();
  renderStats();
  renderCategorias();
  renderResultados();

  /* Si hay base en línea (plugin Biblioteca PNI Online), se usa en vez de la local. */
  cargarDocumentosOnline().then(function (lista) {
    if (lista) {
      docs = normalizarDocumentos(lista);
      poblarSelectores();
      renderStats();
      renderCategorias();
      renderResultados();
    }
  });

  if (input) input.addEventListener("input", function () {
    renderCategorias();
    renderResultados();
  });

  [historicos, filtroAnio, filtroTipo, filtroOrden].forEach(function (el) {
    if (!el) return;
    el.addEventListener("change", function () {
      renderCategorias();
      renderResultados();
    });
  });

  if (limpiar) {
    limpiar.addEventListener("click", function () {
      if (input) input.value = "";
      categoriaActiva = "Todas";
      if (historicos) historicos.checked = false;
      if (filtroAnio) filtroAnio.value = "Todos";
      if (filtroTipo) filtroTipo.value = "Todos";
      if (filtroOrden) filtroOrden.value = "reciente";
      renderCategorias();
      renderResultados();
      if (input) input.focus();
    });
  }

  categoriasBox.addEventListener("click", function (e) {
    const btn = e.target.closest("[data-cat]");
    if (!btn) return;

    categoriaActiva = btn.getAttribute("data-cat");
    renderCategorias();
    renderResultados();
  });

  resultadosBox.addEventListener("click", function (e) {
    const btnCopiar = e.target.closest("[data-copy]");
    if (btnCopiar) {
      copiarEnlace(btnCopiar.getAttribute("data-copy"));
      const original = btnCopiar.textContent;
      btnCopiar.textContent = "Copiado";
      setTimeout(function () {
        btnCopiar.textContent = original;
      }, 1200);
      return;
    }

    const btnPreview = e.target.closest("[data-preview]");
    if (btnPreview) {
      abrirPreview(btnPreview.getAttribute("data-preview"));
    }
  });

  if (cerrarModal) cerrarModal.addEventListener("click", cerrarPreview);

  if (modal) {
    modal.addEventListener("click", function (e) {
      if (e.target === modal) cerrarPreview();
    });
  }

  document.addEventListener("keydown", function (e) {
    if (e.key === "Escape") cerrarPreview();
  });
});
</script><style class="wpcode-css-snippet">/* ==========================================
   BIBLIOTECA PNI V3.1
   Interfaz documental tipo biblioteca técnica
========================================== */

.bpni-app{
  max-width:1220px;
  margin:0 auto;
  padding:26px 16px 64px;
  font-family:Arial, Helvetica, sans-serif;
  color:#12345a;
}

.bpni-app *{ box-sizing:border-box; }

.bpni-hero{
  display:grid;
  grid-template-columns:190px 1fr auto;
  gap:28px;
  align-items:center;
  background:
    radial-gradient(circle at top right,rgba(255,255,255,.18),transparent 34%),
    linear-gradient(135deg,#004b8d,#005c97 58%,#003057);
  border-radius:16px;
  padding:28px 30px;
  color:#fff;
  box-shadow:0 18px 42px rgba(0,48,87,.22);
  margin-bottom:18px;
  overflow:hidden;
}

.bpni-brand-block{
  display:flex;
  flex-direction:column;
  gap:18px;
  align-items:flex-start;
  justify-content:center;
  min-width:170px;
}

.bpni-logo-minsal{
  display:block;
  width:170px;
  max-width:100%;
  height:auto;
  object-fit:contain;
  filter:drop-shadow(0 8px 14px rgba(0,0,0,.20));
}

.bpni-hero-icon{
  width:150px;
  height:110px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:76px;
  line-height:1;
  filter:drop-shadow(0 12px 16px rgba(0,0,0,.22));
}

.bpni-kicker{
  display:inline-block;
  background:rgba(255,255,255,.14);
  border:1px solid rgba(255,255,255,.28);
  padding:6px 12px;
  border-radius:999px;
  font-size:12px;
  font-weight:900;
  margin-bottom:10px;
  letter-spacing:.2px;
}

.bpni-hero h1{
  margin:0 0 8px;
  color:#fff !important;
  font-size:38px;
  line-height:1.1;
  font-weight:900;
}

.bpni-hero p{
  margin:0;
  max-width:620px;
  color:#e7f2ff;
  font-size:15.5px;
  line-height:1.55;
}

.bpni-stats{
  display:flex;
  gap:18px;
  align-items:stretch;
  background:rgba(0,34,72,.36);
  border:1px solid rgba(255,255,255,.12);
  border-radius:16px;
  padding:20px 22px;
  min-width:380px;
}

.bpni-stat{
  display:flex;
  gap:12px;
  align-items:flex-start;
  color:#fff;
  min-width:96px;
}

.bpni-stat-icon{
  width:28px;
  height:28px;
  border:2px solid rgba(255,255,255,.76);
  border-radius:9px;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:15px;
  font-weight:900;
  opacity:.95;
}

.bpni-stat strong{
  display:block;
  font-size:24px;
  line-height:1;
  font-weight:900;
  color:#fff;
}

.bpni-stat small{
  display:block;
  margin-top:7px;
  color:#dbeafe;
  font-size:12.5px;
  line-height:1.35;
  font-weight:700;
}

.bpni-panel{
  background:linear-gradient(180deg,#fff,#f8fbff);
  border:1px solid #d5e1ef;
  border-radius:16px;
  padding:24px;
  box-shadow:0 14px 34px rgba(15,23,42,.07);
  margin-bottom:20px;
}

.bpni-filter-grid{
  display:grid;
  grid-template-columns:1fr 1fr 1fr;
  gap:16px;
  align-items:end;
}

.bpni-filter-grid-main{
  grid-template-columns:1.35fr 1fr 1.1fr 1fr;
}

.bpni-filter-grid label,
.bpni-search-box label{
  display:block;
  color:#003057;
  font-weight:900;
  margin-bottom:8px;
  font-size:13.5px;
}

.bpni-filter-grid select,
.bpni-search-row input{
  width:100%;
  border:1px solid #c7d4e5;
  border-radius:8px;
  padding:12px 13px;
  font-size:14px;
  outline:none;
  background:#fff;
  color:#21384f;
  min-height:44px;
}

.bpni-filter-grid select:focus,
.bpni-search-row input:focus{
  border-color:#005c97;
  box-shadow:0 0 0 3px rgba(0,92,151,.14);
}

.bpni-search-row{
  display:flex;
  gap:8px;
}

.bpni-search-row button,
.bpni-clean-btn{
  min-width:112px;
  border:1px solid #005c97;
  background:#005c97;
  color:#fff;
  border-radius:8px;
  font-size:13px;
  line-height:1;
  font-weight:900;
  cursor:pointer;
  padding:0 14px;
  white-space:nowrap;
  min-height:44px;
}

.bpni-search-row button:hover,
.bpni-clean-btn:hover{
  color:#fff;
  background:#003057;
  border-color:#003057;
}

.bpni-section-title{
  margin:24px 0 12px;
  color:#003057;
  font-weight:900;
  font-size:14px;
}

.bpni-section-title small{
  color:#60708a;
  font-weight:700;
}

.bpni-categorias{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin:0 0 18px;
}

.bpni-cat-btn{
  border:1px solid #c7d4e5;
  background:#fff;
  color:#003057;
  border-radius:999px;
  padding:10px 16px;
  font-size:13px;
  font-weight:900;
  cursor:pointer;
  box-shadow:0 4px 10px rgba(15,23,42,.04);
}

.bpni-cat-btn span{ color:inherit; opacity:.9; }

.bpni-cat-btn:hover,
.bpni-cat-btn.activa{
  background:#005c97;
  border-color:#005c97;
  color:#fff;
}

.bpni-toolbar{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:16px;
  margin-top:12px;
}

.bpni-activos{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  align-items:center;
  min-height:34px;
}

.bpni-active-pill{
  display:inline-flex;
  align-items:center;
  gap:6px;
  background:#e8f3fd;
  color:#005c97;
  border:1px solid #bee0fb;
  border-radius:999px;
  padding:8px 12px;
  font-size:12px;
  font-weight:900;
}

.bpni-toggle label{
  display:flex;
  align-items:center;
  gap:9px;
  color:#586981;
  font-size:13.5px;
  font-weight:800;
  cursor:pointer;
  white-space:nowrap;
}

.bpni-toggle input{
  width:18px;
  height:18px;
  accent-color:#005c97;
}

.bpni-results-head{
  display:flex;
  justify-content:space-between;
  align-items:center;
  margin:18px 0 12px;
}

.bpni-resumen{
  color:#12345a;
  font-size:15px;
  font-weight:800;
}

.bpni-resultados{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:20px;
}

.bpni-card{
  background:#fff;
  border:1px solid #d8e3f0;
  border-radius:16px;
  padding:20px;
  box-shadow:0 10px 22px rgba(15,23,42,.08);
  display:flex;
  flex-direction:column;
  min-height:330px;
  position:relative;
  overflow:hidden;
}

.bpni-card:before{
  content:"";
  position:absolute;
  top:0;
  left:0;
  right:0;
  height:4px;
  background:#005c97;
  opacity:.88;
}

.bpni-card-top{
  display:flex;
  justify-content:space-between;
  gap:10px;
  margin-bottom:14px;
}

.bpni-chip-row{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  align-items:flex-start;
}

.bpni-chip-row-meta{ justify-content:flex-end; }

.bpni-chip{
  display:inline-flex;
  align-items:center;
  border-radius:999px;
  padding:6px 10px;
  font-size:11px;
  line-height:1;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.25px;
  border:1px solid transparent;
}

.bpni-chip-cat{
  background:#eef6ff;
  color:#005c97;
  border-color:#c9e3fb;
}

.bpni-chip-year{
  background:#eef2ff;
  color:#3730a3;
  border-color:#d9defe;
}

.bpni-chip-hist{
  background:#f1f5f9;
  color:#475569;
  border-color:#d8e0ea;
}

.bpni-chip-resolucion{background:#f1e8ff;color:#6d28d9;border-color:#dfccff;}
.bpni-chip-ordinario{background:#fff0db;color:#b45309;border-color:#ffdca8;}
.bpni-chip-decreto{background:#ffe4e6;color:#be123c;border-color:#fecdd3;}
.bpni-chip-circular{background:#e0f2fe;color:#0369a1;border-color:#bae6fd;}
.bpni-chip-lineamiento{background:#e8f3ff;color:#005c97;border-color:#bfdbfe;}
.bpni-chip-manual{background:#dcfce7;color:#15803d;border-color:#bbf7d0;}
.bpni-chip-guia{background:#e0f7fa;color:#0f766e;border-color:#b2ebf2;}
.bpni-chip-procedimiento{background:#e5e7eb;color:#374151;border-color:#cbd5e1;}
.bpni-chip-carta{background:#fce7f3;color:#be185d;border-color:#fbcfe8;}
.bpni-chip-presentacion{background:#fef3c7;color:#92400e;border-color:#fde68a;}
.bpni-chip-calendario{background:#ede9fe;color:#5b21b6;border-color:#ddd6fe;}
.bpni-chip-documento{background:#edf2f7;color:#334155;border-color:#d7e0ea;}



.bpni-card h3{
  margin:0 0 14px;
  color:#003057;
  font-size:17px;
  line-height:1.35;
  font-weight:900;
}

.bpni-tipo{ display:none; }

.bpni-resumen-card{
  color:#475569;
  font-size:14px;
  line-height:1.58;
  margin-bottom:14px;
  flex:1;
}

.bpni-meta{
  color:#66758a;
  font-size:12.5px;
  line-height:1.45;
  margin:0 0 16px;
  font-weight:700;
}

.bpni-actions{
  display:grid;
  grid-template-columns:1fr auto auto;
  gap:10px;
  margin-top:auto;
}

.bpni-actions a,
.bpni-actions button{
  border:1px solid #c7d4e5;
  text-decoration:none !important;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  background:#fff;
  color:#005c97 !important;
  border-radius:8px;
  padding:10px 12px;
  font-size:13px;
  font-weight:900;
  cursor:pointer;
  min-height:40px;
}

.bpni-actions a{
  background:#005c97;
  color:#fff !important;
  border-color:#005c97;
}

.bpni-actions a:hover,
.bpni-actions button:hover{
  background:#003057;
  border-color:#003057;
  color:#fff !important;
}

.bpni-empty{
  grid-column:1/-1;
  background:#fff;
  border:1px dashed #b9c9dd;
  color:#66758a;
  border-radius:16px;
  padding:22px;
  line-height:1.65;
}

.bpni-footer{
  margin-top:24px;
  padding:22px;
  background:linear-gradient(180deg,#fff,#f8fbff);
  border-left:5px solid #005c97;
  border-radius:12px;
  color:#475569;
  line-height:1.65;
  font-size:13.5px;
  box-shadow:0 8px 20px rgba(15,23,42,.05);
}

.bpni-modal{
  position:fixed;
  inset:0;
  background:rgba(15,23,42,.72);
  display:none;
  z-index:999999;
  padding:26px;
}

.bpni-modal.abierto{ display:block; }

.bpni-modal-card{
  max-width:1100px;
  height:92vh;
  margin:0 auto;
  background:#fff;
  border-radius:16px;
  overflow:hidden;
  display:flex;
  flex-direction:column;
  box-shadow:0 24px 70px rgba(0,0,0,.28);
}

.bpni-modal-head{
  display:flex;
  justify-content:space-between;
  gap:18px;
  align-items:center;
  padding:18px 22px;
  background:#003057;
  color:#fff;
}

.bpni-modal-label{
  font-size:12px;
  font-weight:900;
  color:#bfdbfe;
  text-transform:uppercase;
}

.bpni-modal-head h2{
  color:#fff !important;
  margin:4px 0 0;
  font-size:20px;
}

.bpni-modal-head button{
  border:none;
  background:rgba(255,255,255,.13);
  color:#fff;
  width:40px;
  height:40px;
  border-radius:999px;
  font-size:28px;
  line-height:1;
  cursor:pointer;
}

.bpni-modal iframe{
  width:100%;
  flex:1;
  border:0;
  background:#f8fafc;
}

.bpni-modal-actions{
  padding:14px 18px;
  background:#f8fafc;
  border-top:1px solid #e2e8f0;
  text-align:right;
}

.bpni-modal-actions a{
  display:inline-block;
  background:#005c97;
  color:#fff !important;
  text-decoration:none !important;
  border-radius:999px;
  padding:10px 16px;
  font-weight:900;
}

@media(max-width:1040px){
  .bpni-hero{ grid-template-columns:1fr; }
  .bpni-brand-block{ flex-direction:row; align-items:center; min-width:0; }
  .bpni-logo-minsal{ width:160px; }
  .bpni-hero-icon{ width:64px; height:64px; font-size:44px; }
  .bpni-stats{ min-width:0; width:100%; justify-content:space-between; }
  .bpni-filter-grid-main{ grid-template-columns:1fr 1fr; }
  .bpni-resultados{ grid-template-columns:repeat(2,minmax(0,1fr)); }
}

@media(max-width:720px){
  .bpni-app{ padding:18px 10px 50px; }
  .bpni-hero{ border-radius:14px; padding:24px 18px; }
  .bpni-hero h1{ font-size:30px; }
  .bpni-brand-block{ gap:12px; }
  .bpni-logo-minsal{ width:145px; }
  .bpni-hero-icon{ width:52px; height:52px; font-size:36px; }
  .bpni-stats{ flex-direction:column; gap:12px; padding:16px; }
  .bpni-panel{ padding:18px; }
  .bpni-filter-grid-main,
  .bpni-filter-grid{ grid-template-columns:1fr; }
  .bpni-toolbar{ flex-direction:column; align-items:flex-start; }
  .bpni-toggle label{ white-space:normal; }
  .bpni-resultados{ grid-template-columns:1fr; }
  .bpni-search-row{ flex-direction:column; }
  .bpni-search-row button,.bpni-clean-btn{ width:100%; }
  .bpni-actions{ grid-template-columns:1fr; }
  .bpni-card-top{ flex-direction:column; }
  .bpni-chip-row-meta{ justify-content:flex-start; }
}


/* ==========================================
   BIBLIOTECA PNI V3
   Panel lateral, novedades y resumen inteligente
========================================== */

.bpni-v3{
  max-width:1280px;
}

.bpni-layout{
  display:grid;
  grid-template-columns:320px minmax(0,1fr);
  gap:20px;
  align-items:start;
}

.bpni-sidebar{
  position:sticky;
  top:18px;
  align-self:start;
  z-index:3;
}

.bpni-sidebar-panel{
  padding:18px;
  border-radius:18px;
}

.bpni-sidebar-head{
  display:flex;
  align-items:flex-start;
  justify-content:space-between;
  gap:12px;
  margin-bottom:16px;
  padding-bottom:14px;
  border-bottom:1px solid #dbe5ee;
}

.bpni-sidebar-head span{
  display:block;
  color:#003057;
  font-size:18px;
  font-weight:900;
  line-height:1.2;
}

.bpni-sidebar-head small{
  display:block;
  color:#64748b;
  font-size:12.5px;
  line-height:1.45;
  margin-top:4px;
}

.bpni-filter-grid-sidebar{
  display:grid;
  grid-template-columns:1fr;
  gap:12px;
  margin-top:14px;
}

.bpni-filter-grid-sidebar label,
.bpni-sidebar-panel .bpni-search-box label{
  color:#003057;
  font-size:13px;
  font-weight:900;
  margin-bottom:6px;
}

.bpni-sidebar-panel .bpni-search-row{
  display:block;
}

.bpni-sidebar-panel .bpni-search-row input,
.bpni-filter-grid-sidebar select{
  width:100%;
  min-height:44px;
  border-radius:12px;
}

.bpni-toggle-sidebar{
  margin:14px 0;
  padding:12px;
  background:#f1f5f9;
  border:1px solid #dbe5ee;
  border-radius:14px;
  color:#334155;
  font-size:13px;
  line-height:1.35;
}

.bpni-clean-btn-full{
  width:100%;
  min-height:44px;
  margin:0 0 16px;
  border-radius:12px;
  background:#003057;
  color:#fff !important;
}

.bpni-clean-btn-full:hover{
  background:#005c97;
}

.bpni-categorias-sidebar{
  display:flex;
  flex-direction:column;
  flex-wrap:nowrap;
  gap:8px;
  max-height:420px;
  overflow:auto;
  padding-right:4px;
  margin-top:10px;
}

.bpni-categorias-sidebar .bpni-cat-btn{
  width:100%;
  display:flex;
  align-items:center;
  justify-content:space-between;
  text-align:left;
  border-radius:12px;
  padding:10px 12px;
  box-shadow:none;
}

.bpni-categorias-sidebar .bpni-cat-btn span{
  background:rgba(0,48,87,.08);
  color:inherit;
  border-radius:999px;
  padding:2px 7px;
  font-size:11px;
}

.bpni-categorias-sidebar .bpni-cat-btn.activa span{
  background:rgba(255,255,255,.18);
}

.bpni-main{
  min-width:0;
}

.bpni-novedades{
  background:#ffffff;
  border:1px solid #dbe5ee;
  border-radius:18px;
  padding:18px;
  box-shadow:0 10px 28px rgba(15,23,42,.07);
  margin-bottom:18px;
}

.bpni-section-head{
  display:flex;
  justify-content:space-between;
  align-items:flex-start;
  gap:14px;
  margin-bottom:14px;
}

.bpni-section-kicker{
  display:inline-block;
  color:#005c97;
  font-size:12px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.05em;
  margin-bottom:4px;
}

.bpni-section-head h2{
  margin:0;
  color:#003057;
  font-size:23px;
  line-height:1.15;
  font-weight:900;
}

.bpni-section-head p{
  margin:5px 0 0;
  color:#64748b;
  font-size:13.5px;
}

.bpni-carousel-controls{
  display:flex;
  gap:8px;
  flex-shrink:0;
}

.bpni-carousel-controls button{
  width:36px;
  height:36px;
  border:none;
  border-radius:999px;
  background:#eef2f7;
  color:#003057;
  font-size:24px;
  font-weight:900;
  cursor:pointer;
  line-height:1;
}

.bpni-carousel-controls button:hover{
  background:#005c97;
  color:#fff;
}

.bpni-novedades-track{
  display:grid;
  grid-auto-flow:column;
  grid-auto-columns:minmax(250px,33.333%);
  gap:12px;
  overflow-x:auto;
  scroll-snap-type:x mandatory;
  scroll-behavior:smooth;
  padding-bottom:4px;
}

.bpni-novedad-card{
  scroll-snap-align:start;
  border:1px solid #dbe5ee;
  border-radius:16px;
  padding:14px;
  background:linear-gradient(180deg,#f8fafc,#fff);
  min-height:178px;
  display:flex;
  flex-direction:column;
  gap:8px;
}

.bpni-novedad-card h3{
  margin:0;
  color:#003057;
  font-size:15px;
  line-height:1.28;
  font-weight:900;
}

.bpni-novedad-card p{
  margin:0;
  color:#475569;
  font-size:12.8px;
  line-height:1.45;
  flex:1;
}

.bpni-novedad-top{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:8px;
}

.bpni-novedad-icon{
  width:34px;
  height:34px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:11px;
  background:#eaf4fb;
  color:#005c97;
  font-size:18px;
}

.bpni-novedad-year{
  font-size:12px;
  font-weight:900;
  color:#334155;
  background:#eef2ff;
  border-radius:999px;
  padding:4px 8px;
}

.bpni-novedad-actions{
  display:flex;
  gap:8px;
  margin-top:4px;
}

.bpni-novedad-actions a,
.bpni-novedad-actions button{
  border:none;
  border-radius:999px;
  padding:8px 10px;
  font-size:12px;
  font-weight:900;
  cursor:pointer;
  text-decoration:none !important;
}

.bpni-novedad-actions a{
  background:#005c97;
  color:#fff !important;
}

.bpni-novedad-actions button{
  background:#eef2f7;
  color:#003057;
}

.bpni-results-head-v3{
  margin:0 0 14px;
  padding:16px 18px;
  background:#f8fafc;
  border:1px solid #dbe5ee;
  border-radius:16px;
}

.bpni-results-head-v3 .bpni-activos{
  margin-top:8px;
}

.bpni-smart-label{
  display:flex;
  align-items:center;
  gap:8px;
  color:#005c97;
  font-size:12px;
  font-weight:900;
  text-transform:uppercase;
  letter-spacing:.04em;
  margin:6px 0 8px;
}

.bpni-smart-label::before{
  content:"";
  width:7px;
  height:7px;
  border-radius:999px;
  background:#005c97;
}

.bpni-card .bpni-resumen-card{
  background:#f8fafc;
  border:1px solid #e2e8f0;
  border-radius:14px;
  padding:12px;
  color:#334155;
}

.bpni-card h3{
  margin-top:6px;
}

.bpni-modal-meta{
  color:#64748b;
  font-size:13px;
  margin-top:6px;
}

.bpni-modal-summary{
  background:#f8fafc;
  border:1px solid #dbe5ee;
  border-radius:14px;
  padding:14px 16px;
  color:#334155;
  font-size:14px;
  line-height:1.55;
  margin:0 24px 14px;
}

@media(max-width:1040px){
  .bpni-layout{
    grid-template-columns:1fr;
  }

  .bpni-sidebar{
    position:relative;
    top:auto;
  }

  .bpni-filter-grid-sidebar{
    grid-template-columns:repeat(3,minmax(0,1fr));
  }

  .bpni-categorias-sidebar{
    flex-direction:row;
    flex-wrap:wrap;
    max-height:none;
    overflow:visible;
    padding-right:0;
  }

  .bpni-categorias-sidebar .bpni-cat-btn{
    width:auto;
    justify-content:flex-start;
    gap:8px;
  }

  .bpni-novedades-track{
    grid-auto-columns:minmax(245px,50%);
  }
}

@media(max-width:720px){
  .bpni-filter-grid-sidebar{
    grid-template-columns:1fr;
  }

  .bpni-novedades{
    padding:15px;
  }

  .bpni-section-head{
    flex-direction:column;
  }

  .bpni-novedades-track{
    grid-auto-columns:88%;
  }

  .bpni-modal-summary{
    margin:0 14px 12px;
  }
}


/* ==========================================
   AJUSTES V3.1
   - Se elimina visualmente el módulo de novedades.
   - Se corrige el desborde del control de históricos.
========================================== */

.bpni-novedades,
.bpni-section-head,
.bpni-carousel-controls,
.bpni-novedades-track,
.bpni-novedad-card{
  display:none !important;
}

.bpni-sidebar,
.bpni-sidebar-panel{
  min-width:0;
  max-width:100%;
  overflow:hidden;
}

.bpni-toggle-sidebar{
  width:100%;
  max-width:100%;
  display:block;
  overflow:hidden;
}

.bpni-toggle-sidebar label{
  width:100%;
  max-width:100%;
  display:grid !important;
  grid-template-columns:20px minmax(0,1fr);
  align-items:start !important;
  gap:10px !important;
  white-space:normal !important;
  overflow-wrap:anywhere;
  word-break:normal;
  line-height:1.35;
}

.bpni-toggle-sidebar input{
  width:18px;
  height:18px;
  margin-top:1px;
  flex:0 0 auto;
}

.bpni-clean-btn-full{
  display:flex;
  align-items:center;
  justify-content:center;
  width:100%;
  max-width:100%;
}

.bpni-results-head-v3{
  margin-top:0;
}

@media(max-width:980px){
  .bpni-sidebar{
    position:relative;
    top:auto;
  }
}
