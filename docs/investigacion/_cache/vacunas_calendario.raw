#observatorio-influenza input[type="range"]{
  -webkit-appearance: none !important;
  appearance: none !important;
  height: 8px !important;
  border-radius: 999px !important;
  background: #ffffff !important;
  outline: none !important;
}

#observatorio-influenza input[type="range"]::-webkit-slider-thumb{
  -webkit-appearance: none !important;
  appearance: none !important;
  width: 24px !important;
  height: 24px !important;
  border-radius: 50% !important;
  background: #ef3340 !important;
  border: 3px solid #ffffff !important;
  box-shadow: 0 4px 12px rgba(15,23,42,.35) !important;
  cursor: pointer !important;
}

#observatorio-influenza input[type="range"]::-moz-range-thumb{
  width: 24px !important;
  height: 24px !important;
  border-radius: 50% !important;
  background: #ef3340 !important;
  border: 3px solid #ffffff !important;
  box-shadow: 0 4px 12px rgba(15,23,42,.35) !important;
  cursor: pointer !important;
}
#observatorio-influenza .pace-badge.good{
  background:#dcfce7 !important;
  color:#14532d !important;
  border:1px solid #86efac !important;
}

#observatorio-influenza .pace-badge.warn{
  background:#fef3c7 !important;
  color:#92400e !important;
  border:1px solid #fcd34d !important;
}

#observatorio-influenza .pace-badge.bad{
  background:#fee2e2 !important;
  color:#991b1b !important;
  border:1px solid #fca5a5 !important;
}
/* Título principal en blanco */
.oi-widget h1{
    color:#ffffff !important;
}

/* Subtítulo también más visible */
.oi-widget .subtitle{
    color:rgba(255,255,255,.95) !important;
}
.oi-widget .tag{
    display:none !important;
}

/* =========================
   V5.1 · Módulos ejecutivos
   ========================= */
.oi-widget h1{color:#ffffff!important}.oi-widget .subtitle{color:rgba(255,255,255,.95)!important}.oi-widget .tag{display:none!important}
.oi-widget .meta-target-control{margin:12px 0 14px;padding:14px 16px;border:1px solid #bae6fd;background:#f0f9ff;border-radius:20px;display:flex;justify-content:space-between;align-items:center;gap:12px}.oi-widget .meta-target-label{display:block;color:#64748b;font-size:12px;font-weight:950;text-transform:uppercase;letter-spacing:.055em}.oi-widget .meta-target-control strong{display:block;color:#075985;font-size:26px;line-height:1;margin-top:4px}.oi-widget .meta-target-control select{min-width:120px;border-radius:14px;background:#fff;color:#075985;font-weight:950}
.oi-widget .selected-meta-mini{border-color:#0ea5e9;background:linear-gradient(135deg,#eff6ff,#ffffff)}.oi-widget .oi-v51-grid{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:18px}.oi-widget .gauge-card{background:linear-gradient(135deg,#f8fafc,#ffffff);border:1px solid #e0f2fe;border-radius:24px;padding:18px}.oi-widget .gauge-main span{display:block;font-size:42px;font-weight:950;color:#075985;letter-spacing:-.05em}.oi-widget .gauge-main small{display:block;color:#64748b;font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.055em}.oi-widget .gauge-track{height:24px;background:#e2e8f0;border-radius:999px;overflow:hidden;margin:18px 0 10px;border:1px solid #cbd5e1}.oi-widget .gauge-fill{height:100%;width:0%;background:linear-gradient(90deg,#38bdf8,#075985,#ef3340);border-radius:999px;transition:width .35s ease}.oi-widget .gauge-meta-row{display:flex;justify-content:space-between;gap:10px;color:#334155;font-weight:850;font-size:13px}.oi-widget .gauge-note{margin-top:12px;color:#334155;line-height:1.45}.oi-widget .gauge-pending{margin-top:10px;background:#f0f9ff;border:1px solid #bae6fd;border-radius:14px;padding:10px 12px;color:#075985;font-weight:850}.oi-widget .week-highlight-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.oi-widget .week-card{border-radius:20px;padding:16px;border:1px solid #e0f2fe;background:#fff}.oi-widget .week-card.best{background:#f0fdf4;border-color:#bbf7d0}.oi-widget .week-card.worst{background:#fff7ed;border-color:#fed7aa}.oi-widget .week-card strong{display:block;margin-top:8px;color:#0f172a}.oi-widget .week-value{font-size:24px;font-weight:950;color:#075985;margin-top:8px;letter-spacing:-.03em}.oi-widget .week-card p{margin:8px 0 0;color:#64748b;font-size:13px;line-height:1.35}.oi-widget .weekly-chart{height:300px}@media(max-width:980px){.oi-widget .oi-v51-grid{grid-template-columns:1fr}.oi-widget .week-highlight-grid{grid-template-columns:1fr}.oi-widget .meta-target-control{align-items:flex-start;flex-direction:column}.oi-widget .meta-target-control select{width:100%}}


/* V5.2 semana epidemiológica */
.oi-widget .weekly-chart{height:340px;}


/* V5.3 - Lectura ejecutiva reforzada */
.oi-widget #quickRead p{
  margin:0 0 10px;
}
.oi-widget #quickRead p:last-child{
  margin-bottom:0;
}
.oi-widget #quickRead strong{
  color:#075985;
}
.oi-widget #quickRead .good{
  color:#047857 !important;
}
.oi-widget #quickRead .bad{
  color:#ef3340 !important;
}


/* Panel V5.4: cobertura actual por grupo objetivo */
.oi-widget .oi-group-coverage-panel{
  background:rgba(255,255,255,.98);
}
.oi-widget .oi-view-toggle{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
  justify-content:flex-end;
}
.oi-widget .oi-group-summary{
  margin:4px 0 14px;
  padding:14px 16px;
  border:1px solid #bae6fd;
  background:#f0f9ff;
  border-radius:18px;
  color:#334155;
  line-height:1.55;
  font-size:14px;
}
.oi-widget .oi-group-summary strong{
  color:#075985;
}
.oi-widget .oi-group-chart{
  height:520px;
  overflow:hidden;
}
.oi-widget .oi-group-chart svg text{
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
}
.oi-widget .oi-group-legend{
  display:flex;
  flex-wrap:wrap;
  gap:14px;
  margin-top:10px;
  color:#475569;
  font-size:12px;
  font-weight:800;
}
.oi-widget .oi-group-legend span{
  display:inline-flex;
  align-items:center;
  gap:6px;
}
.oi-widget .oi-group-legend i{
  width:20px;
  border-top:3px solid;
  display:inline-block;
}
.oi-widget .oi-group-legend .goal-75{
  border-color:#ef3340;
  border-style:dashed;
}
.oi-widget .oi-group-legend .goal-85{
  border-color:#047857;
  border-style:dashed;
}
.oi-widget .oi-group-table-wrap{
  overflow-x:auto;
}
.oi-widget .oi-group-table{
  min-width:680px;
}
.oi-widget .oi-status-pill{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  padding:5px 9px;
  border-radius:999px;
  font-size:12px;
  font-weight:950;
  white-space:nowrap;
}
.oi-widget .oi-status-ok{
  background:#dcfce7;
  color:#14532d;
  border:1px solid #86efac;
}
.oi-widget .oi-status-mid{
  background:#fef3c7;
  color:#92400e;
  border:1px solid #fcd34d;
}
.oi-widget .oi-status-low{
  background:#fee2e2;
  color:#991b1b;
  border:1px solid #fca5a5;
}
@media(max-width:720px){
  .oi-widget .oi-group-chart{height:620px;}
  .oi-widget .oi-view-toggle{justify-content:flex-start;}
}

.whatif-grid{display:flex;gap:16px;align-items:center;flex-wrap:wrap}
#whatIfDaily{padding:8px 10px;border:1px solid #ccc;border-radius:8px}
#whatIfResult{font-weight:700}


/* V5.6 · Tabla histórica por grupo objetivo */
.oi-widget .oi-hist-groups-panel{
  background:rgba(255,255,255,.98);
}
.oi-widget .oi-hist-groups-table-wrap{
  overflow:auto;
}
.oi-widget .oi-hist-groups-table{
  width:100%;
  min-width:0;
  border-collapse:collapse;
  font-size:15px;
}
.oi-widget .oi-hist-groups-table th{
  text-align:center;
  background:#f0f9ff;
  color:#075985;
  font-weight:950;
  text-transform:none;
  letter-spacing:0;
  font-size:14px;
}
.oi-widget .oi-hist-groups-table td{
  text-align:right;
  font-weight:850;
  padding:12px 14px;
}
.oi-widget .oi-hist-groups-table td:first-child,
.oi-widget .oi-hist-groups-table th:first-child{
  text-align:center;
  color:#0f172a;
  font-weight:950;
}
.oi-widget .oi-hist-groups-source{
  margin-top:10px;
  color:#64748b;
  font-size:13px;
  font-weight:700;
}
@media(max-width:640px){
  .oi-widget .oi-hist-groups-table{
    font-size:13px;
    min-width:680px;
  }
  .oi-widget .oi-hist-groups-table th{
    font-size:12px;
  }
}


/* V5.7 · Controles tabla histórica */
.oi-widget .oi-hist-controls{
  display:grid;
  grid-template-columns:180px 280px 1fr;
  gap:12px;
  align-items:end;
  margin:14px 0 18px;
  padding:14px;
  border:1px solid #bae6fd;
  background:#f0f9ff;
  border-radius:18px;
}
.oi-widget .oi-hist-control-item label{
  display:block;
  font-size:12px;
  font-weight:950;
  text-transform:uppercase;
  letter-spacing:.05em;
  color:#075985;
  margin-bottom:6px;
}
.oi-widget .oi-hist-control-item input{
  width:100%;
  height:42px;
  border:1px solid #bae6fd;
  background:#fff;
  color:#0f172a;
  border-radius:12px;
  padding:8px 12px;
  font-size:16px;
  font-weight:900;
}
.oi-widget .oi-hist-date-row{
  display:grid;
  grid-template-columns:1fr auto;
  gap:8px;
}
.oi-widget .oi-hist-control-status{
  color:#475569;
  font-size:13px;
  line-height:1.35;
  font-weight:700;
}
@media(max-width:820px){
  .oi-widget .oi-hist-controls{grid-template-columns:1fr;}
}

/* V5.8 · Panel ritmo requerido vs observado */
.oi-widget .velocity-legend span{font-weight:900}
.oi-widget .velocity-legend i{border-top-width:4px}


/* V5.9 · Escenarios de cumplimiento */
.oi-widget .oi-scenario-panel .scenario-controls{
  display:grid;
  grid-template-columns:repeat(2,minmax(220px,1fr));
  gap:14px;
  margin:14px 0 18px;
}
.oi-widget .oi-scenario-panel .scenario-controls label{
  display:flex;
  flex-direction:column;
  gap:8px;
  font-size:12px;
  color:#64748b;
  font-weight:950;
  text-transform:uppercase;
  letter-spacing:.05em;
}
.oi-widget .oi-scenario-panel .scenario-controls input{
  height:44px;
  border:1px solid #bae6fd;
  background:#fff;
  color:#0f172a;
  border-radius:14px;
  padding:8px 12px;
  font-size:18px;
  font-weight:900;
}
.oi-widget .scenario-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:14px;
}
.oi-widget .scenario-card{
  background:#f8fafc;
  border:1px solid #dbeafe;
  border-radius:20px;
  padding:16px;
}
.oi-widget .scenario-card .scenario-value{
  margin-top:8px;
  font-size:26px;
  font-weight:950;
  color:#075985;
  letter-spacing:-.03em;
}
.oi-widget .scenario-card .scenario-date{
  margin-top:8px;
  font-size:18px;
  font-weight:950;
  color:#0f172a;
}
.oi-widget .scenario-card .scenario-note{
  margin-top:8px;
  color:#64748b;
  font-size:13px;
  line-height:1.45;
}
.oi-widget .scenario-read{
  margin-top:14px;
  background:#075985;
  color:#fff;
  border-radius:20px;
  padding:16px 18px;
  line-height:1.6;
}
@media(max-width:900px){
  .oi-widget .oi-scenario-panel .scenario-controls,
  .oi-widget .scenario-grid{
    grid-template-columns:1fr;
  }
}


/* V5.10 · Ventaja/desventaja histórica: tabla ajustada + gráfico centrado en 0 */
.oi-widget .oi-adv-panel .oi-adv-table-wrap{
  overflow-x:auto;
  margin-top:8px;
}
.oi-widget .oi-adv-panel #advTable{
  width:auto !important;
  min-width:0 !important;
  table-layout:auto !important;
  margin:0 auto;
  border:1px solid #dbeafe;
  border-radius:12px;
  overflow:hidden;
}
.oi-widget .oi-adv-panel #advTable th,
.oi-widget .oi-adv-panel #advTable td{
  padding:10px 18px !important;
  white-space:nowrap !important;
  text-align:center;
}
.oi-widget .oi-adv-panel #advTable th:first-child,
.oi-widget .oi-adv-panel #advTable td:first-child{
  text-align:left;
}
.oi-widget .oi-adv-chart-head{
  margin:18px 0 8px;
}
.oi-widget .oi-adv-chart-head h3{
  margin:0;
  font-size:18px;
  color:#0f172a;
}
.oi-widget .oi-adv-chart-head p{
  margin:6px 0 0;
  color:#64748b;
  font-size:13px;
}
.oi-widget .oi-adv-chart{
  width:100%;
  min-height:270px;
  border:1px solid #e0f2fe;
  background:linear-gradient(180deg,#fff,#f8fafc);
  border-radius:20px;
  padding:8px;
  overflow:hidden;
}
.oi-widget .oi-adv-chart svg{
  width:100%;
  height:100%;
  display:block;
}
@media(max-width:700px){
  .oi-widget .oi-adv-panel #advTable th,
  .oi-widget .oi-adv-panel #advTable td{
    padding:9px 12px !important;
    font-size:12px;
  }
  .oi-widget .oi-adv-chart{
    overflow-x:auto;
  }
  .oi-widget .oi-adv-chart svg{
    min-width:620px;
  }
}


/* =========================
   V6 · Vistas Nacional / Regional / Servicio de Salud
   ========================= */
.oi-widget .oi-main-tabs{
  margin:18px 0 18px;
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  justify-content:center;
  background:#ffffff;
  border:1px solid #dbeafe;
  border-radius:999px;
  padding:8px;
  box-shadow:0 10px 26px rgba(15,23,42,.08);
}
.oi-widget .oi-main-tab{
  border:1px solid #bae6fd;
  background:#f8fafc;
  color:#075985;
  border-radius:999px;
  padding:11px 18px;
  font-weight:950;
  cursor:pointer;
}
.oi-widget .oi-main-tab.active{
  background:#075985;
  color:#fff;
  border-color:#075985;
}
.oi-widget .oi-view{display:none}
.oi-widget .oi-view.oi-view-active{display:block}

.oi-widget .oi-territory-layout{
  display:grid;
  grid-template-columns:minmax(280px,.8fr) minmax(320px,1.2fr);
  gap:18px;
  align-items:start;
}
.oi-widget .oi-map-card{
  background:#f8fafc;
  border:1px solid #dbeafe;
  border-radius:24px;
  padding:16px;
}
.oi-widget .oi-map-title{
  font-size:16px;
  font-weight:950;
  color:#075985;
}
.oi-widget .oi-map-subtitle{
  margin-top:4px;
  font-size:13px;
  color:#64748b;
}
.oi-widget .oi-chile-map{
  margin-top:14px;
  display:flex;
  flex-direction:column;
  gap:5px;
  max-width:340px;
}
.oi-widget .oi-region-tile{
  display:grid;
  grid-template-columns:1fr auto;
  gap:8px;
  align-items:center;
  border:1px solid #dbeafe;
  border-radius:12px;
  padding:8px 10px;
  background:#e2e8f0;
  color:#0f172a;
  cursor:pointer;
  transition:transform .12s ease, box-shadow .12s ease, border-color .12s ease;
  font-size:12px;
  font-weight:850;
}
.oi-widget .oi-region-tile:hover{
  transform:translateX(4px);
  box-shadow:0 8px 18px rgba(15,23,42,.12);
}
.oi-widget .oi-region-tile.active{
  border-color:#075985;
  box-shadow:0 0 0 3px rgba(7,89,133,.16);
}
.oi-widget .oi-region-tile.ok{background:#dcfce7}
.oi-widget .oi-region-tile.mid{background:#fef3c7}
.oi-widget .oi-region-tile.low{background:#fee2e2}
.oi-widget .oi-region-tile .region-tile-name{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.oi-widget .oi-region-tile .region-tile-value{font-weight:950}
.oi-widget .oi-map-legend{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin-top:12px;
  color:#64748b;
  font-size:12px;
  font-weight:800;
}
.oi-widget .oi-map-legend i{
  display:inline-block;
  width:12px;
  height:12px;
  border-radius:4px;
  margin-right:5px;
  vertical-align:-2px;
}
.oi-widget .oi-map-legend .low{background:#fee2e2;border:1px solid #fca5a5}
.oi-widget .oi-map-legend .mid{background:#fef3c7;border:1px solid #fcd34d}
.oi-widget .oi-map-legend .ok{background:#dcfce7;border:1px solid #86efac}
.oi-widget .oi-territory-kpis{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:12px;
}
.oi-widget .oi-territory-read{
  margin-top:14px;
}
.oi-widget .oi-territory-chart{
  min-height:360px;
  width:100%;
  border:1px solid #e0f2fe;
  background:linear-gradient(180deg,#fff,#f8fafc);
  border-radius:20px;
  padding:8px;
  overflow:hidden;
}
.oi-widget .oi-territory-chart svg{
  width:100%;
  height:100%;
  display:block;
}
.oi-widget .oi-territory-table{
  min-width:920px;
}
.oi-widget .oi-territory-table td,
.oi-widget .oi-territory-table th{
  white-space:nowrap;
}
.oi-widget .oi-territory-table tr.active-row{
  background:#eff6ff;
}
.oi-widget .territory-status{
  display:inline-flex;
  border-radius:999px;
  padding:4px 9px;
  font-weight:900;
  font-size:12px;
}
.oi-widget .territory-status.ok{background:#dcfce7;color:#14532d}
.oi-widget .territory-status.mid{background:#fef3c7;color:#92400e}
.oi-widget .territory-status.low{background:#fee2e2;color:#991b1b}

@media(max-width:1000px){
  .oi-widget .oi-territory-layout,
  .oi-widget .oi-territory-kpis{
    grid-template-columns:1fr;
  }
  .oi-widget .oi-main-tabs{
    border-radius:22px;
  }
  .oi-widget .oi-main-tab{
    flex:1 1 160px;
  }
}
@media(max-width:700px){
  .oi-widget .oi-territory-chart{
    overflow-x:auto;
  }
  .oi-widget .oi-territory-chart svg{
    min-width:720px;
  }
}


/* V6.1 · Mapa real de Chile por GeoJSON y orden regional oficial */
.oi-widget .oi-chile-map{
  align-items:center;
}
.oi-widget .oi-chile-svg-map{
  width:100%;
  max-width:320px;
  height:640px;
  display:block;
  margin:0 auto;
}
.oi-widget .oi-region-path{
  stroke:#ffffff;
  stroke-width:1.05;
  cursor:pointer;
  transition:opacity .12s ease, filter .12s ease, stroke-width .12s ease;
}
.oi-widget .oi-region-path:hover{
  opacity:1 !important;
  filter:drop-shadow(0 5px 10px rgba(15,23,42,.28));
  stroke-width:1.8;
}
.oi-widget .oi-region-path.active{
  opacity:1 !important;
  stroke:#0f172a;
  stroke-width:2.8;
  filter:drop-shadow(0 7px 14px rgba(15,23,42,.35));
}
@media(max-width:700px){
  .oi-widget .oi-chile-svg-map{
    height:560px;
    max-width:280px;
  }
}

/* V6.3 · Selector nacional dinámico por grupo objetivo */
.oi-widget{--group-accent:#0072bc}
.oi-widget .group-select-wrap{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.oi-widget .active-group-badge{display:inline-flex;align-items:center;gap:7px;border:1.5px solid var(--group-accent);color:var(--group-accent);background:#fff;border-radius:999px;padding:8px 12px;font-weight:950;font-size:13px;box-shadow:0 8px 20px rgba(15,23,42,.08)}
.oi-widget .active-group-icon{font-size:17px;line-height:1}
.oi-widget #groupSelect{border-color:var(--group-accent);box-shadow:0 0 0 3px color-mix(in srgb, var(--group-accent) 14%, transparent)}
.oi-widget .main-blue-panel{border-top:5px solid var(--group-accent)}


/* V6.5 · Mapa regional real Leaflet/GeoJSON para coberturas por región */
.oi-widget .oi-territory-layout{
  grid-template-columns:minmax(420px,1.15fr) minmax(320px,.85fr);
}
.oi-widget .oi-map-card{
  background:#ffffff;
  border:1px solid #dbeafe;
  border-radius:24px;
  padding:18px;
  box-shadow:0 16px 38px rgba(15,23,42,.08);
}
.oi-widget .oi-chile-map{
  width:100%;
  max-width:none;
  height:720px;
  min-height:560px;
  display:block;
  margin-top:14px;
  border-radius:18px;
  border:1px solid #dbeafe;
  background:#eaf4fc;
  overflow:hidden;
  position:relative;
}
.oi-widget .oi-chile-map .leaflet-container,
.oi-widget .leaflet-container{
  font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
}
.oi-widget .leaflet-control-attribution{
  font-size:10px;
}
.oi-widget .oi-region-tooltip-wrap{
  border:0!important;
  border-radius:16px!important;
  box-shadow:0 14px 32px rgba(0,45,85,.25)!important;
  padding:0!important;
  overflow:hidden;
}
.oi-widget .oi-region-tooltip{
  min-width:240px;
  padding:14px 16px;
  color:#0b355e;
  background:#fff;
}
.oi-widget .oi-region-tooltip strong{
  display:block;
  color:#003b71;
  font-size:15px;
  margin-bottom:10px;
}
.oi-widget .oi-region-tooltip span{
  display:flex;
  justify-content:space-between;
  gap:14px;
  font-size:13px;
  padding:4px 0;
  border-top:1px solid #eef4fb;
}
.oi-widget .oi-region-tooltip b{
  color:#003b71;
  font-weight:950;
}
.oi-widget .oi-map-legend{
  display:flex;
  gap:10px 16px;
  flex-wrap:wrap;
  margin-top:14px;
  color:#64748b;
  font-size:12px;
  font-weight:850;
}
.oi-widget .oi-map-legend i{
  display:inline-block;
  width:14px;
  height:14px;
  border-radius:5px;
  margin-right:6px;
  vertical-align:-2px;
  box-shadow:inset 0 0 0 1px rgba(0,0,0,.10);
}
.oi-widget .oi-map-legend .low{background:#ef3340;border:0}
.oi-widget .oi-map-legend .mid{background:#f59e0b;border:0}
.oi-widget .oi-map-legend .ok{background:#047857;border:0}
.oi-widget .oi-map-legend .nodata{background:#b8c7d6;border:0}
.oi-widget .oi-map-loading{
  min-height:420px;
  display:grid;
  place-items:center;
  text-align:center;
  color:#075985;
  font-weight:900;
  padding:24px;
}
@media(max-width:1000px){
  .oi-widget .oi-territory-layout{grid-template-columns:1fr;}
  .oi-widget .oi-chile-map{height:620px;}
}
@media(max-width:700px){
  .oi-widget .oi-chile-map{height:560px;min-height:500px;}
}


/* V6.7 · Botón para restablecer vista nacional del mapa regional */
.oi-widget .oi-map-reset-control{
  margin-left:10px!important;
  margin-top:72px!important;
  box-shadow:none!important;
}
.oi-widget .oi-map-reset-view-btn{
  display:none;
  align-items:center;
  gap:7px;
  border:1px solid #bfdbfe;
  border-radius:999px;
  background:#ffffff;
  color:#003b71;
  padding:9px 12px;
  font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  font-size:12px;
  font-weight:950;
  line-height:1;
  cursor:pointer;
  box-shadow:0 10px 26px rgba(0,45,85,.18);
}
.oi-widget .oi-map-reset-view-btn.is-visible{
  display:inline-flex;
}
.oi-widget .oi-map-reset-view-btn:hover{
  background:#eff6ff;
  border-color:#93c5fd;
  transform:translateY(-1px);
}
.oi-widget .oi-map-reset-view-btn strong{
  font-weight:950;
}
@media(max-width:700px){
  .oi-widget .oi-map-reset-control{margin-top:68px!important;}
  .oi-widget .oi-map-reset-view-btn{font-size:11px;padding:8px 10px;}
}


/* V6.8 · Vista por Servicio de Salud */
.oi-widget .oi-service-controls{
  display:grid;
  grid-template-columns:repeat(3,minmax(180px,1fr));
  gap:12px;
  margin:14px 0 18px;
  padding:14px;
  border:1px solid #bae6fd;
  background:#f0f9ff;
  border-radius:20px;
}
.oi-widget .oi-service-controls label{
  display:flex;
  flex-direction:column;
  gap:7px;
  color:#075985;
  font-size:12px;
  font-weight:950;
  text-transform:uppercase;
  letter-spacing:.05em;
}
.oi-widget .oi-service-controls select{
  width:100%;
  min-height:42px;
  border-radius:14px;
  border:1px solid #bae6fd;
  background:#fff;
  color:#0f172a;
  font-size:14px;
  font-weight:850;
  text-transform:none;
  letter-spacing:0;
}
.oi-widget .oi-service-table{
  min-width:1080px;
}
@media(max-width:900px){
  .oi-widget .oi-service-controls{
    grid-template-columns:1fr;
  }
}


/* V6.9 · Ajustes específicos vista Servicio de Salud
   - KPIs y lectura ejecutiva arriba.
   - Ranking a ancho completo bajo los KPIs.
   - Tabla final sin columna oculta y con ajuste responsivo de texto. */
.oi-widget .oi-service-panel .oi-territory-layout{
  display:grid !important;
  grid-template-columns:1fr !important;
  gap:20px !important;
}
.oi-widget .oi-service-panel .oi-territory-kpis{
  grid-template-columns:repeat(3,minmax(0,1fr)) !important;
}
.oi-widget .oi-service-panel .oi-territory-read{
  margin-top:14px;
  max-width:none;
}
.oi-widget .oi-service-panel #serviceRankChart{
  min-height:620px;
  width:100%;
}
.oi-widget #serviceGroupChart{
  min-height:460px;
}
.oi-widget .oi-service-table{
  width:100% !important;
  min-width:0 !important;
  table-layout:fixed !important;
  font-size:12px !important;
}
.oi-widget .oi-service-table th,
.oi-widget .oi-service-table td{
  white-space:normal !important;
  word-break:normal !important;
  overflow-wrap:anywhere !important;
  padding:9px 8px !important;
  vertical-align:middle;
}
.oi-widget .oi-service-table th:nth-child(1),
.oi-widget .oi-service-table td:nth-child(1){width:24%;}
.oi-widget .oi-service-table th:nth-child(2),
.oi-widget .oi-service-table td:nth-child(2){width:13%;}
.oi-widget .oi-service-table th:nth-child(3),
.oi-widget .oi-service-table td:nth-child(3){width:10%;}
.oi-widget .oi-service-table th:nth-child(4),
.oi-widget .oi-service-table td:nth-child(4){width:12%;}
.oi-widget .oi-service-table th:nth-child(5),
.oi-widget .oi-service-table td:nth-child(5){width:13%;}
.oi-widget .oi-service-table th:nth-child(6),
.oi-widget .oi-service-table td:nth-child(6){width:10%;}
.oi-widget .oi-service-table th:nth-child(7),
.oi-widget .oi-service-table td:nth-child(7){width:10%;}
.oi-widget .oi-service-table th:nth-child(8),
.oi-widget .oi-service-table td:nth-child(8){width:8%;}
.oi-widget .oi-service-table .territory-status{
  white-space:normal;
  text-align:center;
  line-height:1.2;
  padding:5px 7px;
}
@media(max-width:1000px){
  .oi-widget .oi-service-panel .oi-territory-kpis{
    grid-template-columns:repeat(2,minmax(0,1fr)) !important;
  }
}
@media(max-width:700px){
  .oi-widget .oi-service-panel .oi-territory-kpis{
    grid-template-columns:1fr !important;
  }
  .oi-widget .oi-service-table{
    min-width:920px !important;
  }
}


/* V6.7 · Ranking SS optimizado */
.oi-widget #serviceRankChart{
  min-height:520px;
  padding:14px 16px;
}
.oi-widget #serviceRankChart svg{
  transition:opacity .22s ease, transform .22s ease;
}
.oi-widget #serviceRankChart .oi-ranking-bar{
  transition:width .28s ease, opacity .22s ease;
}
.oi-widget .oi-territory-table{
  min-width:0 !important;
  width:100% !important;
  table-layout:auto;
  font-size:13px;
}
.oi-widget .oi-territory-table th,
.oi-widget .oi-territory-table td{
  padding:9px 10px !important;
}
.oi-widget .oi-territory-table th:nth-child(1),
.oi-widget .oi-territory-table td:nth-child(1){
  width:24%;
  white-space:normal !important;
}
.oi-widget .oi-territory-table th:nth-child(2),
.oi-widget .oi-territory-table td:nth-child(2){
  width:14%;
}
.oi-widget .oi-territory-table th:nth-child(8),
.oi-widget .oi-territory-table td:nth-child(8){
  width:14%;
  white-space:normal !important;
}
@media(max-width:900px){
  .oi-widget .oi-territory-table{
    min-width:820px !important;
  }
}


/* V6.10 · Mapa por Servicio de Salud + botón limpiar + KPIs con íconos */
.oi-widget .oi-service-controls-v6{grid-template-columns:repeat(3,minmax(180px,1fr)) auto;align-items:end}.oi-widget .oi-clear-btn{min-height:42px;border:1px solid #fecaca;background:#fff;color:#b91c1c;border-radius:14px;padding:0 18px;font-weight:950;cursor:pointer;box-shadow:0 8px 18px rgba(185,28,28,.08)}.oi-widget .oi-clear-btn:hover{background:#fff1f2;transform:translateY(-1px)}
.oi-widget .oi-service-top-layout{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(320px,.75fr);gap:18px;align-items:stretch;margin-top:12px}.oi-widget .oi-service-kpi-zone{min-width:0}.oi-widget .oi-service-kpis-icons .mini{display:grid;grid-template-columns:48px 1fr;gap:12px;align-items:center}.oi-widget .mini-icon{width:42px;height:42px;display:grid;place-items:center;border-radius:14px;background:linear-gradient(135deg,#dbeafe,#eff6ff);border:1px solid #bfdbfe;font-size:24px;box-shadow:inset 0 0 0 1px rgba(255,255,255,.7)}.oi-widget .oi-service-map-card{height:100%;display:flex;flex-direction:column}.oi-widget .oi-service-map{height:560px;min-height:500px;flex:1;background:#f8fbff}.oi-widget .oi-service-ranking-full{margin-top:20px}.oi-widget .oi-service-panel #serviceRankChart{min-height:620px;width:100%}.oi-widget .oi-service-map .warning-note{margin:12px}.oi-widget .oi-service-tooltip strong{display:block;color:#003b71;font-size:15px;margin-bottom:8px}.oi-widget .oi-service-tooltip span{display:flex;justify-content:space-between;gap:12px;font-size:13px;padding:4px 0;border-top:1px solid #eef4fb}.oi-widget .oi-service-tooltip b{color:#003b71;font-weight:950}@media(max-width:1100px){.oi-widget .oi-service-controls-v6{grid-template-columns:1fr 1fr}.oi-widget .oi-service-top-layout{grid-template-columns:1fr}.oi-widget .oi-service-map{height:620px}}@media(max-width:700px){.oi-widget .oi-service-controls-v6{grid-template-columns:1fr}.oi-widget .oi-service-kpis-icons .mini{grid-template-columns:42px 1fr}.oi-widget .mini-icon{width:38px;height:38px;font-size:21px}.oi-widget .oi-service-map{height:560px;min-height:500px}}


/* V6.11 · Mapa SS: respaldo esquemático operativo */
.oi-widget .oi-service-map-fallback{
  width:100%;height:100%;min-height:500px;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;gap:10px;padding:12px;background:linear-gradient(180deg,#ffffff,#f8fbff);border-radius:22px;overflow:hidden;
}
.oi-widget .oi-service-map-fallback svg{width:100%;height:100%;min-height:450px;display:block;}
.oi-widget .oi-service-map-note{width:100%;border:1px solid #bfdbfe;background:#eff6ff;color:#334155;border-radius:16px;padding:10px 12px;line-height:1.35;font-size:12px;}
.oi-widget .oi-service-map-note strong{display:block;color:#075985;font-size:13px;margin-bottom:3px;}
.oi-widget .oi-service-map-note span{display:block;}
.oi-widget .oi-ss-map-seg{cursor:pointer;transition:transform .18s ease, opacity .18s ease;}
.oi-widget .oi-ss-map-seg:hover{opacity:.86;}
.oi-widget .oi-ss-map-seg text{paint-order:stroke;stroke:#fff;stroke-width:3px;stroke-linejoin:round;pointer-events:none;}
.oi-widget .oi-ss-map-seg.selected rect{filter:drop-shadow(0 8px 12px rgba(0,59,113,.22));}


/* V8 · Mapa oficial optimizado por Servicio de Salud */
.oi-widget .oi-service-map-legend{
  background:rgba(255,255,255,.96);
  border:1px solid #dbeafe;
  border-radius:14px;
  padding:10px 12px;
  box-shadow:0 10px 24px rgba(15,23,42,.16);
  color:#334155;
  font-size:12px;
  line-height:1.35;
}
.oi-widget .oi-service-map-legend strong{
  display:block;
  color:#075985;
  margin-bottom:6px;
  font-size:12px;
  text-transform:uppercase;
  letter-spacing:.04em;
}
.oi-widget .oi-service-map-legend span{
  display:flex;
  align-items:center;
  gap:7px;
  margin:4px 0;
  font-weight:850;
}
.oi-widget .oi-service-map-legend i{
  width:14px;
  height:14px;
  border-radius:4px;
  display:inline-block;
  border:1px solid rgba(15,23,42,.16);
}
.oi-widget .leaflet-container{
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
}
.oi-widget .oi-service-tooltip span{
  display:block;
  margin-top:3px;
}
.oi-widget .oi-service-tooltip strong{
  color:#075985;
  font-size:13px;
}


/* =========================
   V9 FINAL · Servicio de Salud con mapa oficial IDE-MINSAL
   ========================= */
.oi-widget .oi-service-final{overflow:visible;background:linear-gradient(135deg,#ffffff,#f8fbff);}
.oi-widget .oi-service-head-final{align-items:center;}
.oi-widget .oi-service-actions-final{display:flex;gap:10px;flex-wrap:wrap;justify-content:flex-end;}
.oi-widget .oi-service-controls-final{
  display:grid;
  grid-template-columns:repeat(3,minmax(180px,1fr));
  gap:14px;
  align-items:end;
  margin:16px 0 18px;
  padding:16px 18px;
  border:1px solid #bae6fd;
  background:#f0f9ff;
  border-radius:22px;
}
.oi-widget .oi-service-controls-final label{font-size:12px;font-weight:950;text-transform:uppercase;letter-spacing:.07em;color:#075985;}
.oi-widget .oi-service-controls-final select{margin-top:8px;width:100%;height:42px;border-radius:12px;border:1px solid #bae6fd;background:#fff;color:#0f172a;font-weight:900;padding:6px 12px;}
.oi-widget .oi-service-dashboard-final{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(430px,.95fr);gap:18px;align-items:stretch;}
.oi-widget .oi-service-left-final{min-width:0;display:flex;flex-direction:column;gap:16px;}
.oi-widget .oi-service-kpis-final{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px;}
.oi-widget .oi-service-kpis-final .mini{display:grid;grid-template-columns:50px 1fr;align-items:center;gap:13px;min-height:128px;background:linear-gradient(135deg,#f8fafc,#ffffff);border-color:#dbeafe;}
.oi-widget .oi-service-kpis-final .mini .v{font-size:clamp(22px,2.4vw,32px);line-height:1.05;}
.oi-widget .oi-service-kpis-final .mini .n{font-size:14px;}
.oi-widget .oi-service-read-final{font-size:17px;line-height:1.6;border-color:#bae6fd;background:#f8fbff;}
.oi-widget .mini-icon{width:44px;height:44px;display:grid;place-items:center;border-radius:16px;background:linear-gradient(135deg,#dbeafe,#eff6ff);border:1px solid #bfdbfe;font-size:24px;box-shadow:inset 0 0 0 1px rgba(255,255,255,.75),0 8px 18px rgba(7,89,133,.08)}
.oi-widget .oi-service-map-card-final{display:flex;flex-direction:column;min-height:100%;background:#ffffff;border:1px solid #dbeafe;border-radius:26px;padding:18px;box-shadow:0 12px 28px rgba(15,23,42,.07)}
.oi-widget .oi-service-map-card-final .oi-map-title{font-size:22px;font-weight:950;color:#075985;margin-bottom:6px;}
.oi-widget .oi-service-map-card-final .oi-map-subtitle{font-size:14px;color:#64748b;line-height:1.45;margin-bottom:14px;}
.oi-widget .oi-service-map{height:720px;min-height:620px;flex:1;border:1px solid #dbeafe;border-radius:22px;overflow:hidden;background:linear-gradient(180deg,#f8fbff,#ffffff);}
.oi-widget .oi-service-map .leaflet-container{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;}
.oi-widget .oi-service-legend-final{margin-top:14px;}
.oi-widget .oi-service-ranking-final{margin-top:18px;background:#fff;}
.oi-widget .oi-service-ranking-final #serviceRankChart{min-height:690px;width:100%;}
.oi-widget .oi-service-groups-final #serviceGroupChart{min-height:360px;}
.oi-widget .oi-service-table-panel-final{background:#fff;}
.oi-widget .oi-service-table-wrap-final{overflow-x:visible;}
.oi-widget .oi-service-table-final{min-width:0!important;width:100%!important;table-layout:fixed;font-size:13px;}
.oi-widget .oi-service-table-final th,.oi-widget .oi-service-table-final td{padding:10px 9px!important;white-space:normal!important;word-break:normal;vertical-align:middle;}
.oi-widget .oi-service-table-final th:nth-child(1),.oi-widget .oi-service-table-final td:nth-child(1){width:23%;}
.oi-widget .oi-service-table-final th:nth-child(2),.oi-widget .oi-service-table-final td:nth-child(2){width:12%;}
.oi-widget .oi-service-table-final th:nth-child(3),.oi-widget .oi-service-table-final td:nth-child(3){width:10%;}
.oi-widget .oi-service-table-final th:nth-child(4),.oi-widget .oi-service-table-final td:nth-child(4){width:12%;}
.oi-widget .oi-service-table-final th:nth-child(5),.oi-widget .oi-service-table-final td:nth-child(5){width:13%;}
.oi-widget .oi-service-table-final th:nth-child(6),.oi-widget .oi-service-table-final td:nth-child(6){width:10%;}
.oi-widget .oi-service-table-final th:nth-child(7),.oi-widget .oi-service-table-final td:nth-child(7){width:10%;}
.oi-widget .oi-service-table-final th:nth-child(8),.oi-widget .oi-service-table-final td:nth-child(8){width:10%;}
.oi-widget .oi-service-table-final .active-row td{background:#eff6ff!important;}
.oi-widget .oi-service-table-final .territory-status{font-size:11px;padding:5px 7px;white-space:normal;}
.oi-widget .oi-service-map-legend{background:rgba(255,255,255,.96);border:1px solid #dbeafe;border-radius:16px;padding:12px 14px;box-shadow:0 10px 24px rgba(15,23,42,.12);font-size:12px;color:#334155;}
.oi-widget .oi-service-map-legend strong{display:block;margin-bottom:8px;color:#075985;font-size:13px;}
.oi-widget .oi-service-map-legend span{display:flex;align-items:center;gap:7px;margin:5px 0;font-weight:800;}
.oi-widget .oi-service-map-legend i{width:13px;height:13px;border-radius:4px;display:inline-block;}
.oi-widget .oi-service-tooltip strong{display:block;color:#003b71;font-size:15px;margin-bottom:8px;}
.oi-widget .oi-service-tooltip span{display:flex;justify-content:space-between;gap:18px;font-size:13px;padding:4px 0;border-top:1px solid #eef4fb;}
.oi-widget .oi-service-tooltip b{color:#003b71;font-weight:950;}
.oi-widget .oi-service-map-loading{height:100%;display:grid;place-items:center;color:#075985;font-weight:950;background:#f8fbff;}
.oi-widget .oi-map-reset-service-btn{display:none;align-items:center;gap:6px;border:1px solid #bae6fd;background:#fff;color:#075985;border-radius:999px;padding:7px 11px;font-size:12px;font-weight:950;box-shadow:0 8px 18px rgba(15,23,42,.14);cursor:pointer;}
.oi-widget .oi-map-reset-service-btn.is-visible{display:inline-flex;}
.oi-widget #serviceRankChart .oi-ranking-bar{transition:opacity .18s ease, filter .18s ease;}
.oi-widget #serviceRankChart svg text{font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;}
@media(max-width:1180px){
  .oi-widget .oi-service-dashboard-final{grid-template-columns:1fr;}
  .oi-widget .oi-service-map{height:720px;}
}
@media(max-width:820px){
  .oi-widget .oi-service-controls-final{grid-template-columns:1fr;}
  .oi-widget .oi-service-kpis-final{grid-template-columns:1fr;}
  .oi-widget .oi-service-map{height:620px;min-height:560px;}
  .oi-widget .oi-service-table-wrap-final{overflow-x:auto;}
  .oi-widget .oi-service-table-final{min-width:980px!important;}
}


/* =========================
   Corrección final SS · mapa visible y KPIs sin desborde
   ========================= */
.oi-widget .oi-service-dashboard-final{
  grid-template-columns:1fr !important;
  gap:20px !important;
}
.oi-widget .oi-service-left-final{
  width:100% !important;
  min-width:0 !important;
}
.oi-widget .oi-service-kpis-final{
  grid-template-columns:repeat(3,minmax(0,1fr)) !important;
  gap:14px !important;
}
.oi-widget .oi-service-kpis-final .mini{
  min-width:0 !important;
  overflow:hidden !important;
  grid-template-columns:48px minmax(0,1fr) !important;
}
.oi-widget .oi-service-kpis-final .mini .v{
  font-size:clamp(22px,2.1vw,30px) !important;
  max-width:100% !important;
  overflow:hidden !important;
  text-overflow:clip !important;
  white-space:normal !important;
  word-break:normal !important;
}
.oi-widget .oi-service-kpis-final .mini .n,
.oi-widget .oi-service-kpis-final .mini .label{
  max-width:100% !important;
}
.oi-widget .oi-service-map-card-final{
  width:100% !important;
}
.oi-widget .oi-service-map{
  width:100% !important;
  height:680px !important;
  min-height:580px !important;
}
.oi-widget .oi-service-table-wrap-final{
  overflow-x:auto !important;
}
.oi-widget .oi-service-table-final{
  min-width:980px !important;
}
@media(min-width:1380px){
  .oi-widget .oi-service-dashboard-final{
    grid-template-columns:minmax(0,1fr) minmax(520px,.9fr) !important;
    align-items:stretch !important;
  }
  .oi-widget .oi-service-kpis-final{
    grid-template-columns:repeat(2,minmax(0,1fr)) !important;
  }
}
@media(max-width:980px){
  .oi-widget .oi-service-kpis-final{
    grid-template-columns:repeat(2,minmax(0,1fr)) !important;
  }
  .oi-widget .oi-service-map{height:600px !important;min-height:520px !important;}
}
@media(max-width:620px){
  .oi-widget .oi-service-kpis-final{
    grid-template-columns:1fr !important;
  }
  .oi-widget .oi-service-map{height:540px !important;min-height:500px !important;}
}

/* =========================
   Corrección FINAL SVG · mapa visible + KPIs compactos
   ========================= */
.oi-widget .oi-service-kpis-final{
  grid-template-columns:repeat(2,minmax(0,1fr)) !important;
  gap:12px !important;
}
.oi-widget .oi-service-kpis-final .mini{
  min-height:108px !important;
  padding:13px !important;
  grid-template-columns:40px minmax(0,1fr) !important;
  gap:10px !important;
}
.oi-widget .oi-service-kpis-final .mini-icon,
.oi-widget .mini-icon{
  width:36px !important;
  height:36px !important;
  border-radius:13px !important;
  font-size:19px !important;
}
.oi-widget .oi-service-kpis-final .mini .label{
  font-size:10px !important;
  letter-spacing:.06em !important;
  line-height:1.2 !important;
}
.oi-widget .oi-service-kpis-final .mini .v{
  font-size:24px !important;
  line-height:1.05 !important;
  letter-spacing:-.04em !important;
  white-space:normal !important;
  overflow:visible !important;
}
.oi-widget .oi-service-kpis-final .mini .n{
  font-size:12px !important;
  line-height:1.25 !important;
}
.oi-widget .oi-service-map{
  height:700px !important;
  min-height:620px !important;
  background:#f8fbff !important;
  position:relative !important;
}
.oi-widget .oi-service-svg-shell{
  width:100%;
  height:100%;
  min-height:620px;
  display:grid;
  grid-template-rows:1fr auto;
  background:linear-gradient(180deg,#f8fbff,#ffffff);
}
.oi-widget .oi-service-svg-map{
  width:100%;
  height:100%;
  display:block;
}
.oi-widget .oi-service-svg-path{
  cursor:pointer;
  transition:opacity .15s ease, filter .15s ease, stroke-width .15s ease;
  vector-effect:non-scaling-stroke;
}
.oi-widget .oi-service-svg-path.is-hover{
  opacity:1 !important;
  filter:drop-shadow(0 8px 10px rgba(15,23,42,.22));
  stroke:#003b71 !important;
  stroke-width:2.2 !important;
}
.oi-widget .oi-service-svg-path.is-selected{
  filter:drop-shadow(0 10px 14px rgba(0,59,113,.28));
}
.oi-widget .oi-service-svg-caption{
  margin:0 12px 12px;
  padding:10px 12px;
  border:1px solid #dbeafe;
  background:rgba(255,255,255,.92);
  border-radius:14px;
  color:#475569;
  font-size:12px;
  line-height:1.35;
}
.oi-widget .oi-service-svg-caption strong{
  display:block;
  color:#075985;
  font-size:13px;
  margin-bottom:2px;
}
@media(max-width:980px){
  .oi-widget .oi-service-kpis-final{grid-template-columns:repeat(2,minmax(0,1fr)) !important;}
  .oi-widget .oi-service-map{height:620px !important;min-height:560px !important;}
}
@media(max-width:620px){
  .oi-widget .oi-service-kpis-final{grid-template-columns:1fr !important;}
  .oi-widget .oi-service-map{height:560px !important;min-height:500px !important;}
}


/* =========================
   Corrección V10 · mapa SVG con zoom y botón de restablecer vista
   ========================= */
.oi-widget .oi-service-svg-shell{
  position:relative !important;
  grid-template-rows:auto 1fr auto !important;
}
.oi-widget .oi-service-svg-toolbar{
  min-height:42px;
  display:flex;
  justify-content:flex-end;
  align-items:center;
  padding:10px 12px 0;
  pointer-events:none;
}
.oi-widget .oi-service-svg-reset{
  pointer-events:auto;
  border:1px solid #bae6fd;
  background:#ffffff;
  color:#075985;
  border-radius:999px;
  padding:8px 12px;
  font-size:12px;
  font-weight:950;
  cursor:pointer;
  box-shadow:0 8px 18px rgba(15,23,42,.10);
}
.oi-widget .oi-service-svg-reset:hover{
  background:#f0f9ff;
  transform:translateY(-1px);
}
.oi-widget .oi-service-svg-path.bajo{
  fill:#ef3340;
}
.oi-widget .oi-service-svg-path.medio{
  fill:#f59e0b;
}
.oi-widget .oi-service-svg-path.ok{
  fill:#047857;
}
.oi-widget .oi-service-svg-path.sin-dato{
  fill:#cbd5e1;
}
.oi-widget .oi-service-svg-path.is-selected{
  stroke:#003b71 !important;
  stroke-width:3.2 !important;
  opacity:1 !important;
  filter:drop-shadow(0 12px 16px rgba(0,59,113,.34));
}
.oi-widget .oi-service-kpis-final .mini .v{
  font-size:22px !important;
}
.oi-widget .oi-service-kpis-final .mini .n{
  font-size:11px !important;
}
@media(max-width:620px){
  .oi-widget .oi-service-svg-toolbar{justify-content:flex-start;}
}


/* Ajuste final: KPI regionales con iconografía homogénea */
.oi-widget .oi-region-kpis-icons{
  display:grid;
  grid-template-columns:repeat(2,minmax(0,1fr));
  gap:12px;
}
.oi-widget .oi-region-kpis-icons .mini{
  display:grid;
  grid-template-columns:46px minmax(0,1fr);
  align-items:center;
  gap:12px;
  min-height:112px;
  background:linear-gradient(135deg,#f8fafc,#ffffff);
  border-color:#dbeafe;
  overflow:hidden;
}
.oi-widget .oi-region-kpis-icons .mini .label{
  font-size:11px;
  line-height:1.25;
}
.oi-widget .oi-region-kpis-icons .mini .v{
  font-size:clamp(20px,2.1vw,28px);
  line-height:1.06;
  word-break:normal;
  overflow-wrap:anywhere;
}
.oi-widget .oi-region-kpis-icons .mini .n{
  font-size:12px;
  line-height:1.25;
}
.oi-widget .oi-region-kpis-icons .mini-icon{
  width:40px;
  height:40px;
  border-radius:15px;
  font-size:22px;
}
@media(max-width:820px){
  .oi-widget .oi-region-kpis-icons{grid-template-columns:1fr;}
}


/* =========================
   Centro de reportes ejecutivo
   ========================= */
.oi-widget .oi-report-center{background:rgba(255,255,255,.98)}
