function normalizarPNI(texto) {
  return String(texto || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");
}

function iconoGrupoPNI(grupo) {
  var mapa = {
    "Infantil": "👶",
    "Escolar": "🧒",
    "Embarazada": "🤰",
    "Adultos": "👨‍🦳",
    "Campañas": "📢"
  };
  return mapa[grupo] || "💉";
}

function iniciarAppPNI() {
  var app = document.getElementById("appPNI");
  if (!app) return;

  vacunasPNI.sort(function(a, b) {
    return Number(a.Orden || 0) - Number(b.Orden || 0);
  });

  var grupos = [];
  vacunasPNI.forEach(function(v) {
    if (grupos.indexOf(v.Grupo) === -1) grupos.push(v.Grupo);
  });

  var html = "";
  grupos.forEach(function(g) {
  html += '<button class="pni-btn" data-grupo="' + g + '" onclick="mostrarGrupoPNI(\'' + g.replace(/'/g, "\\'") + '\')">' + iconoGrupoPNI(g) + ' ' + g + '</button>';
});

  html += '<a class="pni-btn pni-btn-secundario" href="https://vacunas.minsal.cl/calendarios-de-vacunacion/" target="_blank" rel="noopener">📅 Ver calendarios años anteriores</a>';

document.getElementById("pniGrupos").innerHTML = html;
	mostrarGrupoPNI(grupos[0]);
}

function activarBotonPNI(grupo) {
  var botones = document.querySelectorAll(".pni-btn");
  botones.forEach(function(btn) {
    btn.classList.toggle("activo", btn.getAttribute("data-grupo") === grupo);
  });
}

function mostrarGrupoPNI(grupo) {
  activarBotonPNI(grupo);
  document.getElementById("pniBuscar").value = "";
  var datos = vacunasPNI.filter(function(v) {
    return v.Grupo === grupo;
  });
  renderizarPNI(datos, iconoGrupoPNI(grupo) + " " + grupo);
}

function buscarPNI(texto) {
  var q = normalizarPNI(texto);
  if (!q) {
    mostrarGrupoPNI("Infantil");
    return;
  }

  var datos = vacunasPNI.filter(function(v) {
    var combinado = [
      v.Grupo, v.Edad, v.Vacuna, v.Dosis, v.Previene, v.Observaciones
    ].join(" ");
    return normalizarPNI(combinado).indexOf(q) !== -1;
  });
  activarBotonPNI("");
  renderizarPNI(datos, "Resultados de búsqueda");
}

function renderizarPNI(datos, titulo) {
  var cont = document.getElementById("pniResultados");
  var tituloEl = document.getElementById("pniTituloResultado");
  tituloEl.innerHTML = titulo;

  if (!datos.length) {
    cont.innerHTML = '<div class="pni-vacio">No se encontraron vacunas asociadas a la búsqueda ingresada.</div>';
    return;
  }

  var html = "";
  var edadActual = null;
  var abierto = false;

  datos.forEach(function(v, i) {
    if (v.Edad !== edadActual) {
      if (abierto) html += '</div>';
      edadActual = v.Edad;
      html += '<div class="pni-edad">' + edadActual + '</div>';
      html += '<div class="pni-grid">';
      abierto = true;
    }

    html += '<div class="pni-card" onclick="abrirFichaPNI(' + vacunasPNI.indexOf(v) + ')">';
    html += '<h4>💉 ' + v.Vacuna + '</h4>';
    html += '<p><strong>Dosis:</strong> ' + (v.Dosis || "No especificada") + '</p>';
    html += '<p><strong>Previene:</strong> ' + (v.Previene || "Información no especificada") + '</p>';
    if (v.Observaciones && v.Observaciones !== "-") {
      html += '<span class="pni-tag">' + v.Observaciones + '</span>';
    }
    html += '</div>';
  });

  if (abierto) html += '</div>';
  cont.innerHTML = html;
}

function abrirFichaPNI(index) {
  var v = vacunasPNI[index];
  var html = "";
  html += '<h3>💉 ' + v.Vacuna + '</h3>';
  html += '<p><strong>Grupo:</strong> ' + v.Grupo + '</p>';
  html += '<p><strong>Edad:</strong> ' + v.Edad + '</p>';
  html += '<p><strong>Dosis:</strong> ' + (v.Dosis || "No especificada") + '</p>';
  html += '<p><strong>Previene:</strong> ' + (v.Previene || "Información no especificada") + '</p>';
  html += '<div class="pni-observaciones"><strong>Observaciones:</strong><br>' + ((v.Observaciones && v.Observaciones !== "-") ? v.Observaciones : "Sin observaciones registradas.") + '</div>'; 
	if (v.Ficha) {
    html += '<a class="pni-link" href="' + v.Ficha + '" target="_blank" rel="noopener">Ver más detalles</a>';
  }
  document.getElementById("pniFicha").innerHTML = html;
  document.getElementById("pniModalBg").style.display = "flex";
}

function cerrarFichaPNI(event) {
  if (event && event.stopPropagation) event.stopPropagation();
  if (!event || event.target.id === "pniModalBg" || event.target.classList.contains("pni-cerrar")) {
    document.getElementById("pniModalBg").style.display = "none";
  }
}

document.addEventListener("DOMContentLoaded", iniciarAppPNI);
