   ========================================================= */

#pni-review-app .pni-executive-panel {
  margin-top: 20px;
  margin-bottom: 20px;
  border: 1px solid #dbe4ef;
}

#pni-review-app .pni-executive-top {
  display: grid;
  grid-template-columns: 280px minmax(0, 1fr);
  gap: 22px;
  align-items: stretch;
  margin-bottom: 18px;
}

#pni-review-app .pni-score-card {
  padding: 22px;
  border-radius: 22px;
  color: #ffffff;
  background: linear-gradient(135deg, #64748b, #475569);
  box-shadow: 0 18px 34px rgba(15, 23, 42, 0.16);
}

#pni-review-app .pni-score-card.excellent {
  background: linear-gradient(135deg, #047857, #0f766e);
}

#pni-review-app .pni-score-card.very-good {
  background: linear-gradient(135deg, #0f766e, #0072bc);
}

#pni-review-app .pni-score-card.good {
  background: linear-gradient(135deg, #0072bc, #0284c7);
}

#pni-review-app .pni-score-card.warning {
  background: linear-gradient(135deg, #b45309, #f59e0b);
}

#pni-review-app .pni-score-card.critical {
  background: linear-gradient(135deg, #b91c1c, #ef4444);
}

#pni-review-app .pni-score-card.idle {
  background: linear-gradient(135deg, #64748b, #475569);
}

#pni-review-app .pni-score-card span {
