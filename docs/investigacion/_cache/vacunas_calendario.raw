 {anio:2022,titulo:"Varicela segunda dosis 36 meses",categoria:"vacunas",periodo:"modernizacion",descripcion:"Vacunación varicela segunda dosis a los 36 meses.",keywords:"varicela segunda dosis 36 meses",imagen:"",imagenTitulo:"Refuerzo varicela",imagenTexto:"La segunda dosis permite mejorar la protección individual y colectiva frente a varicela."},
 {anio:2023,titulo:"Meningocócica B lactantes",categoria:"vacunas",periodo:"modernizacion",descripcion:"Vacunación anti-meningocócica serogrupo B en lactantes de 2 y 4 meses.",keywords:"menb meningocócica b lactantes",imagen:"",imagenTitulo:"MenB lactantes",imagenTexto:"La incorporación de MenB fortalece la prevención de enfermedad meningocócica invasora en lactantes."},
 {anio:2024,titulo:"VPH nonavalente",categoria:"vacunas",periodo:"modernizacion",descripcion:"Incorporación de vacuna VPH nonavalente en vacunación escolar durante el segundo semestre de 2024.",keywords:"vph nonavalente escolar",imagen:"",imagenTitulo:"VPH nonavalente",imagenTexto:"La vacuna nonavalente amplía la cobertura frente a genotipos de VPH de importancia sanitaria."},
 {anio:2024,titulo:"Nirsevimab VRS",categoria:"vacunas",periodo:"modernizacion",descripcion:"Incorporación de anticuerpo monoclonal contra el Virus Respiratorio Sincicial, nirsevimab.",keywords:"vrs nirsevimab anticuerpo monoclonal",imagen:"",imagenTitulo:"Nirsevimab contra VRS",imagenTexto:"La incorporación de nirsevimab marca un avance en la prevención de enfermedad grave por VRS en lactantes."},
 {anio:2024,titulo:"Refuerzo MenB 18 meses",categoria:"vacunas",periodo:"modernizacion",descripcion:"Incorporación de dosis de refuerzo de vacuna anti-meningocócica serogrupo B en lactantes de 18 meses.",keywords:"menb refuerzo 18 meses",imagen:"",imagenTitulo:"Refuerzo MenB",imagenTexto:"La dosis de refuerzo busca sostener la protección durante la primera infancia."}
];

const $ = (id) => document.getElementById(id);

const timeline = $("pniTlTimeline");
const total = $("pniTlTotalHitos");
const visible = $("pniTlVisibleCount");
const activeFilter = $("pniTlActiveFilter");
const range = $("pniTlRange");
const search = $("pniTlSearch");
const clearBtn = $("pniTlClearSearch");
const stage = $("pniTlStage");

const detailEmpty = $("pniTlDetailEmpty");
const detailContent = $("pniTlDetailContent");
const dYear = $("pniTlDetailYear");
const dCat = $("pniTlDetailCategory");
const dTitle = $("pniTlDetailTitle");
const dDesc = $("pniTlDetailDescription");
const dPeriod = $("pniTlDetailPeriod");
const dType = $("pniTlDetailType");
const dKeywords = $("pniTlDetailKeywords");
const dNote = $("pniTlDetailNote");

const tooltip = $("pniTlTooltip");
const tYear = $("pniTlTooltipYear");
const tTitle = $("pniTlTooltipTitle");
const tCat = $("pniTlTooltipCategory");

let categoriaActual = "todas";
let periodoActual = "todos";
let listaActual = [];
let playIndex = 0;
let playTimer = null;
let isPlaying = false;

const categoriaNombres = {
 vacunas: "Vacunas e inmunización",
 gestion: "Gestión y normativa",
 eliminacion: "Eliminación y control",
 sistemas: "Sistemas y registros",
 documentos: "Documentos técnicos",
 campanas: "Campañas extraordinarias",
 historia: "Historia"
};

const periodoNombres = {
 origenes: "1765–1950 · Orígenes",
 consolidacion: "1951–1978 · Consolidación",
 expansion: "1979–2010 · Expansión",
 modernizacion: "2011–2024 · Modernización"
};

function categoriaLabel(c){ return categoriaNombres[c] || c; }
function periodoLabel(p){ return periodoNombres[p] || p; }

function normalizar(txt){
 return String(txt || "")
   .toLowerCase()
   .normalize("NFD")
   .replace(/[\u0300-\u036f]/g, "");
}

function crearPlaybar(){
 const museum = document.querySelector("#pni-timeline-app .pni-tl-museum");
 if (!museum || $("pniTlPlaybar")) return;

 const bar = document.createElement("div");
 bar.className = "pni-tl-playbar";
 bar.id = "pniTlPlaybar";
 bar.innerHTML = `
   <div class="pni-tl-playbar__text">
     <strong>Modo exposición</strong>
     Active una reproducción automática para recorrer cronológicamente los hitos del PNI.
   </div>
   <div class="pni-tl-playbar__actions">
     <button type="button" class="pni-tl-playbtn" id="pniTlPlay">▶ Reproducir historia del PNI</button>
     <button type="button" class="pni-tl-playbtn is-secondary" id="pniTlPause">⏸ Pausar</button>
     <button type="button" class="pni-tl-playbtn is-secondary" id="pniTlReset">↺ Reiniciar</button>
   </div>
 `;
 const header = museum.querySelector(".pni-tl-museum__header");
 if (header) header.insertAdjacentElement("afterend", bar);

 $("pniTlPlay")?.addEventListener("click", iniciarExposicion);
 $("pniTlPause")?.addEventListener("click", pausarExposicion);
 $("pniTlReset")?.addEventListener("click", reiniciarExposicion);
}

function actualizarResumen(lista){
 if (visible) visible.textContent = lista.length + " hitos";
 if (total) total.textContent = HITOS.length;

 const filtros = [];
 if (categoriaActual !== "todas") filtros.push(categoriaLabel(categoriaActual));
 if (periodoActual !== "todos") filtros.push(periodoLabel(periodoActual));
 const q = search ? search.value.trim() : "";
 if (q) filtros.push("Búsqueda: “" + q + "”");
 if (activeFilter) activeFilter.textContent = filtros.length ? filtros.join(" · ") : "Todos los hitos";

 if (range) {
   if (!lista.length) {
     range.textContent = "Sin resultados";
   } else {
     const min = Math.min(...lista.map(h => h.anio));
     const max = Math.max(...lista.map(h => h.anio));
     range.textContent = min + "–" + max;
   }
 }
}

function filtrar(){
 let datos = [...HITOS];
 const txt = normalizar(search ? search.value : "");

 if (categoriaActual !== "todas") datos = datos.filter(h => h.categoria === categoriaActual);
 if (periodoActual !== "todos") datos = datos.filter(h => h.periodo === periodoActual);

 if (txt) {
   datos = datos.filter(h => normalizar([
     h.anio, h.titulo, h.descripcion, h.keywords,
     categoriaLabel(h.categoria), periodoLabel(h.periodo)
   ].join(" ")).includes(txt));
 }

 listaActual = datos;
 playIndex = 0;
 renderTimeline(datos);
 actualizarResumen(datos);
}

function renderTimeline(lista){
 if (!timeline) return;
 timeline.innerHTML = "";

 if (!lista.length) {
   const empty = document.createElement("div");
   empty.className = "pni-tl-empty";
   empty.innerHTML = "<strong>Sin resultados</strong><span>Ajuste la búsqueda o los filtros seleccionados.</span>";
   timeline.appendChild(empty);
   return;
 }

 lista.forEach((h, i) => {
   const node = document.createElement("button");
   node.type = "button";
   node.className = "pni-tl-node" + (i % 2 ? " is-alt" : "");
   node.dataset.category = h.categoria;
   node.dataset.index = i;
   node.setAttribute("aria-label", h.anio + ", " + h.titulo);

   node.innerHTML = `
     <div class="pni-tl-node__year">${h.anio}</div>
     <div class="pni-tl-node__stem"></div>
     <div class="pni-tl-node__dot"></div>
     <div class="pni-tl-node__card">
       <div class="pni-tl-node__title">${h.titulo}</div>
       <div class="pni-tl-node__tag">${categoriaLabel(h.categoria)}</div>
     </div>
   `;

   node.addEventListener("mouseenter", (e) => showTooltip(e, h));
   node.addEventListener("mousemove", moveTooltip);
   node.addEventListener("mouseleave", hideTooltip);
   node.addEventListener("focus", (e) => showTooltip(e, h));
   node.addEventListener("blur", hideTooltip);
   node.addEventListener("click", () => {
     pausarExposicion(false);
     seleccionarHito(h, node, true);
   });

   timeline.appendChild(node);
 });
}

function mediaHTML(h){
 if (h.imagen) {
   return `
     <div class="pni-tl-detail__image">
       <img src="${h.imagen}" alt="${h.imagenTitulo || h.titulo}" loading="lazy">
     </div>
   `;
 }

 return `
   <div class="pni-tl-detail__image">
     <div class="pni-tl-detail__image-placeholder">
       <span aria-hidden="true">🏛️</span>
       <strong>${h.imagenTitulo || "Hito histórico del PNI"}</strong>
     </div>
   </div>
 `;
}

function seleccionarHito(h, node, scrollDetalle){
 document.querySelectorAll("#pni-timeline-app .pni-tl-node").forEach(n => {
   n.classList.remove("is-selected");
   n.classList.remove("is-playing");
 });

 if (node) {
   node.classList.add("is-selected");
   if (isPlaying) node.classList.add("is-playing");
   node.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" });
 }

 if (detailEmpty) detailEmpty.hidden = true;
 if (detailContent) detailContent.hidden = false;

 if (dYear) dYear.textContent = h.anio;
 if (dCat) {
   dCat.textContent = categoriaLabel(h.categoria);
   dCat.dataset.category = h.categoria;
 }
 if (dTitle) dTitle.textContent = h.titulo;
 if (dDesc) dDesc.textContent = h.descripcion;
 if (dPeriod) dPeriod.textContent = periodoLabel(h.periodo);
 if (dType) dType.textContent = categoriaLabel(h.categoria);
 if (dKeywords) dKeywords.textContent = h.keywords;
 if (dNote) {
   dNote.textContent = "Este hito forma parte de la línea histórica interactiva del Programa Nacional de Inmunizaciones en Chile.";
 }

 let media = $("pniTlDetailMedia");
 if (!media && detailContent && dDesc) {
   media = document.createElement("div");
   media.id = "pniTlDetailMedia";
   media.className = "pni-tl-detail__media";
   dDesc.insertAdjacentElement("afterend", media);
 }

 if (media) {
   media.innerHTML = `
     ${mediaHTML(h)}
     <div class="pni-tl-detail__caption">
       <strong>${h.imagenTitulo || h.titulo}</strong>
       ${h.imagenTexto || "Espacio preparado para incorporar fotografía, afiche, documento o imagen histórica asociada a este hito."}
     </div>
   `;
 }

 if (scrollDetalle) {
   const detailPanel = $("pniTlDetailPanel");
   if (detailPanel) detailPanel.scrollIntoView({ behavior: "smooth", block: "start" });
 }
}

function showTooltip(e,h){
 if (!tooltip) return;
 if (tYear) tYear.textContent = h.anio;
 if (tTitle) tTitle.textContent = h.titulo;
 if (tCat) tCat.textContent = categoriaLabel(h.categoria);

 let desc = tooltip.querySelector(".pni-tl-tooltip__desc");
 if (!desc) {
   desc = document.createElement("div");
   desc.className = "pni-tl-tooltip__desc";
   tooltip.appendChild(desc);
 }
 desc.textContent = h.descripcion;

 tooltip.hidden = false;
 moveTooltip(e);
}

function moveTooltip(e){
 if (!tooltip) return;
 const x = e.clientX || (e.target && e.target.getBoundingClientRect().left) || 0;
 const y = e.clientY || (e.target && e.target.getBoundingClientRect().top) || 0;
 tooltip.style.left = x + "px";
 tooltip.style.top = y + "px";
}

function hideTooltip(){
 if (tooltip) tooltip.hidden = true;
}

function iniciarExposicion(){
 if (!listaActual.length) return;
 isPlaying = true;
 clearInterval(playTimer);
 reproducirPaso();
 playTimer = setInterval(reproducirPaso, 4200);
}

function pausarExposicion(limpiar=true){
 clearInterval(playTimer);
 playTimer = null;
 isPlaying = false;
 if (limpiar) {
   document.querySelectorAll("#pni-timeline-app .pni-tl-node").forEach(n => n.classList.remove("is-playing"));
 }
}

function reiniciarExposicion(){
 pausarExposicion();
 playIndex = 0;
 if (stage) stage.scrollTo({ left: 0, behavior: "smooth" });
 if (listaActual.length) {
   const node = document.querySelector("#pni-timeline-app .pni-tl-node[data-index='0']");
   seleccionarHito(listaActual[0], node, false);
 }
}

function reproducirPaso(){
 if (!listaActual.length) return;

 if (playIndex >= listaActual.length) {
   playIndex = 0;
 }

 const h = listaActual[playIndex];
 const node = document.querySelector(`#pni-timeline-app .pni-tl-node[data-index='${playIndex}']`);
 seleccionarHito(h, node, false);
 playIndex++;
}

document.querySelectorAll("#pni-timeline-app [data-filter-type='categoria']").forEach(btn => {
 btn.addEventListener("click", () => {
   pausarExposicion();
   document.querySelectorAll("#pni-timeline-app [data-filter-type='categoria']").forEach(b => b.classList.remove("is-active"));
   btn.classList.add("is-active");
   categoriaActual = btn.dataset.filterValue;
   filtrar();
 });
});

document.querySelectorAll("#pni-timeline-app [data-filter-type='periodo']").forEach(btn => {
 btn.addEventListener("click", () => {
   pausarExposicion();
   document.querySelectorAll("#pni-timeline-app [data-filter-type='periodo']").forEach(b => b.classList.remove("is-active"));
   btn.classList.add("is-active");
   periodoActual = btn.dataset.filterValue;
   filtrar();
 });
});

if (search) {
 search.addEventListener("input", () => {
   pausarExposicion();
   filtrar();
 });
}

if (clearBtn) {
 clearBtn.addEventListener("click", () => {
   pausarExposicion();
   if (search) search.value = "";
   filtrar();
   if (search) search.focus();
 });
}

$("pniTlScrollLeft")?.addEventListener("click", () => {
 if (stage) stage.scrollBy({ left: -520, behavior: "smooth" });
});

$("pniTlScrollRight")?.addEventListener("click", () => {
 if (stage) stage.scrollBy({ left: 520, behavior: "smooth" });
});

/* Limpieza preventiva por si quedó HTML antiguo */
document.querySelectorAll("#pni-timeline-app .pni-tl-grid-section").forEach(el => el.remove());
document.querySelectorAll("#pni-timeline-app #pniTlCards").forEach(el => {
 el.innerHTML = "";
 el.hidden = true;
 el.setAttribute("aria-hidden", "true");
 el.style.display = "none";
});

crearPlaybar();

if (total) total.textContent = HITOS.length;
filtrar();

});
</script><style class="wpcode-css-snippet">/* =========================================================
   LÍNEA DE TIEMPO INTERACTIVA DEL PNI EN CHILE
   VERSIÓN FINAL - CSS WPCODE
   Uso: pegar este contenido en WPCode como CSS global o por página.
   Requiere HTML Divi y JS complementario.
   ========================================================= */

/* -----------------------------
   VARIABLES GENERALES
----------------------------- */

#pni-timeline-app {
  --pni-azul: #005ea8;
  --pni-azul-2: #0072ce;
  --pni-azul-3: #0b7bd3;
  --pni-azul-oscuro: #073763;
  --pni-celeste: #eaf5ff;
  --pni-celeste-2: #f4f9ff;
  --pni-borde: #d7e4f2;
  --pni-texto: #1f2937;
  --pni-texto-2: #4b5563;
  --pni-muted: #6b7280;
  --pni-blanco: #ffffff;
  --pni-sombra: 0 18px 45px rgba(7, 55, 99, 0.12);
  --pni-sombra-suave: 0 10px 28px rgba(7, 55, 99, 0.08);

  --cat-vacunas: #0b7bd3;
  --cat-gestion: #5b6ee1;
  --cat-eliminacion: #e28413;
  --cat-sistemas: #118866;
  --cat-documentos: #7c3aed;
  --cat-campanas: #d14343;
  --cat-historia: #64748b;

  width: 100%;
  max-width: 1440px;
  margin: 0 auto;
  color: var(--pni-texto);
  font-family: inherit;
  box-sizing: border-box;
}

#pni-timeline-app,
#pni-timeline-app *,
#pni-timeline-app *::before,
#pni-timeline-app *::after {
  box-sizing: border-box;
}

#pni-timeline-app button,
#pni-timeline-app input {
  font-family: inherit;
}

#pni-timeline-app button {
  -webkit-tap-highlight-color: transparent;
}

/* -----------------------------
   HERO
----------------------------- */

.pni-tl-hero {
  position: relative;
  overflow: hidden;
  border-radius: 28px;
  padding: 44px;
  color: var(--pni-blanco);
  background:
    radial-gradient(circle at 92% 18%, rgba(255,255,255,.22), transparent 26%),
    radial-gradient(circle at 8% 92%, rgba(255,255,255,.12), transparent 30%),
    linear-gradient(135deg, var(--pni-azul-oscuro), var(--pni-azul), var(--pni-azul-3));
  box-shadow: var(--pni-sombra);
}

.pni-tl-hero::after {
  content: "";
  position: absolute;
  inset: auto -80px -120px auto;
  width: 360px;
  height: 360px;
  border-radius: 999px;
  border: 38px solid rgba(255,255,255,.08);
  pointer-events: none;
}

.pni-tl-hero__content {
  position: relative;
  z-index: 1;
  max-width: 980px;
}

.pni-tl-hero__top {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
  margin-bottom: 26px;
}

.pni-tl-logo-box {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 142px;
  min-height: 54px;
  padding: 8px 12px;
  border-radius: 16px;
  background: rgba(255,255,255,.96);
  box-shadow: 0 10px 24px rgba(0,0,0,.12);
}

.pni-tl-logo {
  display: block;
  max-width: 130px;
  height: auto;
}

.pni-tl-kicker {
  display: inline-flex;
  align-items: center;
  width: fit-content;
  min-height: 38px;
  padding: 8px 16px;
  border-radius: 999px;
  background: rgba(255,255,255,.16);
  border: 1px solid rgba(255,255,255,.22);
  color: rgba(255,255,255,.96);
  font-size: 14px;
  font-weight: 700;
  letter-spacing: .02em;
}

.pni-tl-hero h1 {
  margin: 0 0 18px;
  color: var(--pni-blanco);
  font-size: clamp(34px, 4vw, 58px);
  line-height: 1.02;
  font-weight: 850;
  letter-spacing: -0.04em;
}

.pni-tl-hero__lead {
  max-width: 880px;
  margin: 0;
  color: rgba(255,255,255,.92);
  font-size: clamp(17px, 1.7vw, 21px);
  line-height: 1.6;
}

.pni-tl-hero__meta {
  display: grid;
  grid-template-columns: repeat(3, minmax(150px, 1fr));
  gap: 14px;
  margin-top: 30px;
  max-width: 760px;
}

.pni-tl-stat {
  padding: 16px 18px;
  border-radius: 18px;
  background: rgba(255,255,255,.13);
  border: 1px solid rgba(255,255,255,.18);
  backdrop-filter: blur(8px);
}

.pni-tl-stat__number {
  display: block;
  color: var(--pni-blanco);
  font-size: 28px;
  line-height: 1;
  font-weight: 850;
  letter-spacing: -0.03em;
}

.pni-tl-stat__label {
  display: block;
  margin-top: 7px;
  color: rgba(255,255,255,.84);
  font-size: 13px;
  line-height: 1.35;
}

/* -----------------------------
   INTRO
----------------------------- */

.pni-tl-intro {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 18px;
  align-items: flex-start;
  margin: 22px 0;
  padding: 24px;
  border: 1px solid var(--pni-borde);
  border-radius: 24px;
  background: linear-gradient(180deg, #fff, var(--pni-celeste-2));
  box-shadow: var(--pni-sombra-suave);
}

.pni-tl-intro__icon {
  width: 54px;
  height: 54px;
  display: grid;
  place-items: center;
  border-radius: 18px;
  background: var(--pni-celeste);
  font-size: 26px;
}

.pni-tl-intro h2 {
  margin: 0 0 8px;
  color: var(--pni-azul-oscuro);
  font-size: 22px;
  font-weight: 850;
  letter-spacing: -0.02em;
}

.pni-tl-intro p {
  margin: 0;
  color: var(--pni-texto-2);
  line-height: 1.65;
  font-size: 15.5px;
}

/* -----------------------------
   CONTROLES
----------------------------- */

.pni-tl-controls {
  display: grid;
  gap: 18px;
  margin: 22px 0;
  padding: 22px;
  border-radius: 24px;
  border: 1px solid var(--pni-borde);
  background: #fff;
  box-shadow: var(--pni-sombra-suave);
}

.pni-tl-label {
  display: block;
  margin: 0 0 8px;
  color: var(--pni-azul-oscuro);
  font-size: 13px;
  line-height: 1.25;
  font-weight: 850;
  text-transform: uppercase;
  letter-spacing: .06em;
}

.pni-tl-search-box {
  position: relative;
  display: flex;
  align-items: center;
}

.pni-tl-search-icon {
  position: absolute;
  left: 15px;
  top: 50%;
  transform: translateY(-50%);
  color: var(--pni-muted);
  pointer-events: none;
}

.pni-tl-search {
  width: 100%;
  min-height: 52px;
  padding: 14px 48px 14px 46px;
  border: 1px solid var(--pni-borde);
  border-radius: 16px;
  background: #fbfdff;
  color: var(--pni-texto);
  font-size: 15px;
  outline: none;
  transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
}

.pni-tl-search:focus {
  border-color: rgba(0,114,206,.7);
  background: #fff;
  box-shadow: 0 0 0 4px rgba(0,114,206,.12);
}

.pni-tl-clear {
  position: absolute;
  right: 10px;
  width: 34px;
  height: 34px;
  border: 0;
  border-radius: 999px;
  background: #edf5fc;
  color: var(--pni-azul);
  font-size: 23px;
  line-height: 1;
  cursor: pointer;
  display: grid;
  place-items: center;
  transition: transform .16s ease, background .16s ease;
}

.pni-tl-clear:hover {
  transform: scale(1.05);
  background: #dceefb;
}

.pni-tl-filter-block {
  display: grid;
  gap: 8px;
}

.pni-tl-filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.pni-tl-filter,
.pni-tl-period,
.pni-tl-decade {
  min-height: 40px;
  padding: 9px 14px;
  border-radius: 999px;
  border: 1px solid var(--pni-borde);
  background: #fff;
  color: var(--pni-texto-2);
  font-size: 13.5px;
  font-weight: 750;
  cursor: pointer;
  transition: transform .16s ease, border-color .16s ease, background .16s ease, color .16s ease, box-shadow .16s ease;
}

.pni-tl-filter:hover,
.pni-tl-period:hover,
.pni-tl-decade:hover {
  transform: translateY(-1px);
  border-color: rgba(0,114,206,.45);
  background: var(--pni-celeste-2);
  color: var(--pni-azul-oscuro);
}

.pni-tl-filter.is-active,
.pni-tl-period.is-active,
.pni-tl-decade.is-active {
  border-color: var(--pni-azul);
  background: var(--pni-azul);
  color: #fff;
  box-shadow: 0 8px 18px rgba(0,94,168,.22);
}

/* -----------------------------
   DÉCADAS
----------------------------- */

.pni-tl-decade-nav {
  margin: 22px 0;
  padding: 18px 20px;
  border: 1px solid var(--pni-borde);
  border-radius: 22px;
  background: #fff;
  box-shadow: var(--pni-sombra-suave);
}

.pni-tl-decade-nav__items {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding-bottom: 4px;
  scrollbar-width: thin;
}

/* -----------------------------
   RESUMEN DINÁMICO
----------------------------- */

.pni-tl-summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(160px, 1fr));
  gap: 14px;
  margin: 22px 0;
}

.pni-tl-summary__item {
  padding: 18px 20px;
  border-radius: 22px;
  border: 1px solid var(--pni-borde);
  background: linear-gradient(180deg, #fff, #f8fbff);
  box-shadow: var(--pni-sombra-suave);
}

.pni-tl-summary__label {
  display: block;
  margin-bottom: 6px;
  color: var(--pni-muted);
  font-size: 12px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .06em;
}

.pni-tl-summary strong {
  display: block;
  color: var(--pni-azul-oscuro);
  font-size: 18px;
  line-height: 1.25;
}

/* -----------------------------
   MUSEO / ESCENARIO
----------------------------- */

.pni-tl-museum {
  margin: 22px 0;
  padding: 24px;
  border-radius: 28px;
  border: 1px solid var(--pni-borde);
  background:
    linear-gradient(180deg, rgba(255,255,255,.96), rgba(246,250,255,.96)),
    radial-gradient(circle at 12% 24%, rgba(0,114,206,.08), transparent 28%);
  box-shadow: var(--pni-sombra);
  overflow: hidden;
}

.pni-tl-museum__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 18px;
}

.pni-tl-museum__header h2 {
  margin: 0 0 7px;
  color: var(--pni-azul-oscuro);
  font-size: clamp(22px, 2vw, 30px);
  font-weight: 850;
  letter-spacing: -0.03em;
}

.pni-tl-museum__header p {
  max-width: 780px;
  margin: 0;
  color: var(--pni-texto-2);
  font-size: 15px;
  line-height: 1.6;
}

.pni-tl-museum__actions {
  display: flex;
  gap: 10px;
  flex-shrink: 0;
}

.pni-tl-navbtn {
  width: 44px;
  height: 44px;
  border: 1px solid var(--pni-borde);
  border-radius: 14px;
  background: #fff;
  color: var(--pni-azul);
  font-size: 22px;
  font-weight: 850;
  cursor: pointer;
  box-shadow: 0 8px 18px rgba(7,55,99,.07);
  transition: transform .16s ease, background .16s ease, color .16s ease;
}

.pni-tl-navbtn:hover {
  transform: translateY(-1px);
  background: var(--pni-azul);
  color: #fff;
}

.pni-tl-stage {
  position: relative;
  min-height: 360px;
  overflow-x: auto;
  overflow-y: visible;
  padding: 68px 34px 74px;
  border-radius: 24px;
  background:
    linear-gradient(90deg, rgba(0,94,168,.05) 1px, transparent 1px),
    linear-gradient(180deg, #fbfdff, #ffffff);
  background-size: 92px 100%, auto;
  border: 1px solid rgba(215,228,242,.9);
  scroll-behavior: smooth;
  scrollbar-width: thin;
  outline: none;
}

.pni-tl-stage:focus {
  box-shadow: 0 0 0 4px rgba(0,114,206,.10);
}

.pni-tl-axis {
  position: absolute;
  left: 50px;
  right: 50px;
  top: 178px;
  height: 6px;
  border-radius: 999px;
  background: linear-gradient(90deg, rgba(0,94,168,.18), rgba(0,114,206,.55), rgba(0,94,168,.18));
  pointer-events: none;
}

.pni-tl-timeline {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: flex-start;
  gap: 56px;
  min-width: max-content;
}

/* -----------------------------
   NODOS
----------------------------- */

.pni-tl-node {
  position: relative;
  width: 136px;
  min-height: 220px;
  display: flex;
  flex-direction: column;
  align-items: center;
  cursor: pointer;
  border: 0;
  background: transparent;
  color: inherit;
  text-align: center;
}

.pni-tl-node:focus-visible {
  outline: 4px solid rgba(0,114,206,.22);
  outline-offset: 8px;
  border-radius: 20px;
}

.pni-tl-node__year {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 72px;
  padding: 7px 11px;
  border-radius: 999px;
  background: #fff;
  border: 1px solid var(--pni-borde);
  color: var(--pni-azul-oscuro);
  font-size: 15px;
  font-weight: 900;
  box-shadow: 0 8px 18px rgba(7,55,99,.08);
}

.pni-tl-node__stem {
  width: 2px;
  height: 58px;
  margin: 6px 0 0;
  background: linear-gradient(180deg, rgba(0,114,206,.22), rgba(0,114,206,.72));
}

.pni-tl-node__dot {
  position: relative;
  z-index: 3;
  width: 28px;
  height: 28px;
  border-radius: 999px;
  border: 5px solid #fff;
  background: var(--pni-azul-2);
  box-shadow: 0 0 0 5px rgba(0,114,206,.14), 0 12px 28px rgba(0,94,168,.24);
  transition: transform .18s ease, box-shadow .18s ease;
}

.pni-tl-node:hover .pni-tl-node__dot,
.pni-tl-node.is-selected .pni-tl-node__dot {
  transform: scale(1.18);
  box-shadow: 0 0 0 8px rgba(0,114,206,.16), 0 16px 34px rgba(0,94,168,.28);
}

.pni-tl-node__card {
  width: 136px;
  min-height: 86px;
  margin-top: 14px;
  padding: 12px 10px;
  border-radius: 18px;
  border: 1px solid var(--pni-borde);
  background: rgba(255,255,255,.94);
  box-shadow: 0 10px 24px rgba(7,55,99,.08);
  transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
}

.pni-tl-node:hover .pni-tl-node__card,
.pni-tl-node.is-selected .pni-tl-node__card {
  transform: translateY(-4px);
  border-color: rgba(0,114,206,.45);
  box-shadow: 0 16px 34px rgba(7,55,99,.13);
}

.pni-tl-node__title {
  display: block;
  color: var(--pni-texto);
  font-size: 13px;
  font-weight: 850;
  line-height: 1.24;
}

.pni-tl-node__tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  margin-top: 8px;
  max-width: 100%;
  padding: 4px 8px;
  border-radius: 999px;
  background: var(--pni-celeste);
  color: var(--pni-azul-oscuro);
  font-size: 10.5px;
  font-weight: 850;
  white-space: nowrap;
}

/* nodos alternos */
.pni-tl-node.is-alt {
  flex-direction: column-reverse;
  padding-top: 74px;
}

.pni-tl-node.is-alt .pni-tl-node__card {
  margin-top: 0;
  margin-bottom: 14px;
}

.pni-tl-node.is-alt .pni-tl-node__stem {
  margin: 0 0 6px;
  background: linear-gradient(0deg, rgba(0,114,206,.22), rgba(0,114,206,.72));
}

/* colores por categoría */
.pni-tl-node[data-category="vacunas"] .pni-tl-node__dot,
.pni-tl-card[data-category="vacunas"] .pni-tl-card__marker,
.pni-tl-detail__category[data-category="vacunas"],
.pni-tl-modal__category[data-category="vacunas"] {
  background: var(--cat-vacunas);
}

.pni-tl-node[data-category="gestion"] .pni-tl-node__dot,
.pni-tl-card[data-category="gestion"] .pni-tl-card__marker,
.pni-tl-detail__category[data-category="gestion"],
.pni-tl-modal__category[data-category="gestion"] {
  background: var(--cat-gestion);
}

.pni-tl-node[data-category="eliminacion"] .pni-tl-node__dot,
.pni-tl-card[data-category="eliminacion"] .pni-tl-card__marker,
.pni-tl-detail__category[data-category="eliminacion"],
.pni-tl-modal__category[data-category="eliminacion"] {
  background: var(--cat-eliminacion);
}

.pni-tl-node[data-category="sistemas"] .pni-tl-node__dot,
.pni-tl-card[data-category="sistemas"] .pni-tl-card__marker,
.pni-tl-detail__category[data-category="sistemas"],
.pni-tl-modal__category[data-category="sistemas"] {
  background: var(--cat-sistemas);
}

.pni-tl-node[data-category="documentos"] .pni-tl-node__dot,
.pni-tl-card[data-category="documentos"] .pni-tl-card__marker,
.pni-tl-detail__category[data-category="documentos"],
.pni-tl-modal__category[data-category="documentos"] {
  background: var(--cat-documentos);
}

.pni-tl-node[data-category="campanas"] .pni-tl-node__dot,
.pni-tl-card[data-category="campanas"] .pni-tl-card__marker,
.pni-tl-detail__category[data-category="campanas"],
.pni-tl-modal__category[data-category="campanas"] {
  background: var(--cat-campanas);
}

.pni-tl-node[data-category="historia"] .pni-tl-node__dot,
.pni-tl-card[data-category="historia"] .pni-tl-card__marker,
.pni-tl-detail__category[data-category="historia"],
.pni-tl-modal__category[data-category="historia"] {
  background: var(--cat-historia);
}

.pni-tl-mobile-hint {
  display: none;
  margin-top: 12px;
  color: var(--pni-muted);
  font-size: 13px;
  font-weight: 700;
}

/* -----------------------------
   FICHA DE DETALLE
----------------------------- */

.pni-tl-detail {
  margin: 22px 0;
  border-radius: 28px;
  border: 1px solid var(--pni-borde);
  background: #fff;
  box-shadow: var(--pni-sombra);
  overflow: hidden;
}

.pni-tl-detail__empty {
  padding: 34px;
  text-align: center;
  background:
    radial-gradient(circle at 50% 0%, rgba(0,114,206,.08), transparent 34%),
    linear-gradient(180deg, #fff, #f8fbff);
}

.pni-tl-detail__empty-icon {
  width: 56px;
  height: 56px;
  display: grid;
  place-items: center;
  margin: 0 auto 16px;
  border-radius: 999px;
  background: var(--pni-celeste);
  color: var(--pni-azul);
  font-size: 20px;
}

.pni-tl-detail__empty h2 {
  margin: 0 0 8px;
  color: var(--pni-azul-oscuro);
  font-size: 24px;
  font-weight: 850;
}

.pni-tl-detail__empty p {
  max-width: 680px;
  margin: 0 auto;
  color: var(--pni-texto-2);
  line-height: 1.6;
}

.pni-tl-detail__content {
  padding: 30px;
}

.pni-tl-detail__top,
.pni-tl-modal__header {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-wrap: wrap;
  margin-bottom: 14px;
}

.pni-tl-detail__year,
.pni-tl-modal__year {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 7px 12px;
  border-radius: 999px;
  background: var(--pni-azul-oscuro);
  color: #fff;
  font-size: 14px;
  font-weight: 900;
}

.pni-tl-detail__category,
.pni-tl-modal__category {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 7px 12px;
  border-radius: 999px;
  color: #fff;
  font-size: 12.5px;
  font-weight: 850;
}

.pni-tl-detail h2 {
  margin: 0 0 12px;
  color: var(--pni-azul-oscuro);
  font-size: clamp(24px, 2.8vw, 38px);
  line-height: 1.12;
  font-weight: 900;
  letter-spacing: -0.035em;
}

.pni-tl-detail__description {
  margin: 0 0 20px;
  color: var(--pni-texto);
  font-size: 17px;
  line-height: 1.65;
}

.pni-tl-detail__meta {
  display: grid;
  grid-template-columns: repeat(3, minmax(160px, 1fr));
  gap: 14px;
  margin: 22px 0 0;
}

.pni-tl-detail__meta div {
  padding: 16px;
  border: 1px solid var(--pni-borde);
  border-radius: 18px;
  background: #f8fbff;
}

.pni-tl-detail__meta dt {
  margin-bottom: 7px;
  color: var(--pni-muted);
  font-size: 12px;
  text-transform: uppercase;
  letter-spacing: .06em;
  font-weight: 850;
}

.pni-tl-detail__meta dd {
  margin: 0;
  color: var(--pni-azul-oscuro);
  font-size: 14px;
  line-height: 1.45;
  font-weight: 800;
}

.pni-tl-detail__note {
  margin-top: 18px;
  padding: 16px 18px;
  border-left: 5px solid var(--pni-azul);
  border-radius: 16px;
  background: var(--pni-celeste-2);
  color: var(--pni-texto-2);
  line-height: 1.6;
  font-size: 14.5px;
}

/* -----------------------------
   TARJETAS
----------------------------- */

.pni-tl-grid-section {
  margin: 22px 0;
  padding: 24px;
  border-radius: 28px;
  border: 1px solid var(--pni-borde);
  background: #fff;
  box-shadow: var(--pni-sombra-suave);
}

.pni-tl-grid-section__header {
  margin-bottom: 18px;
}

.pni-tl-grid-section__header h2 {
  margin: 0 0 7px;
  color: var(--pni-azul-oscuro);
  font-size: 26px;
  font-weight: 900;
  letter-spacing: -0.03em;
}

.pni-tl-grid-section__header p {
  margin: 0;
  color: var(--pni-texto-2);
  line-height: 1.6;
}

.pni-tl-cards {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.pni-tl-card {
  position: relative;
  display: flex;
  gap: 14px;
  align-items: flex-start;
  min-height: 150px;
  padding: 18px;
  border: 1px solid var(--pni-borde);
  border-radius: 22px;
  background: linear-gradient(180deg, #fff, #fbfdff);
  cursor: pointer;
  transition: transform .18s ease, border-color .18s ease, box-shadow .18s ease;
}

.pni-tl-card:hover,
.pni-tl-card.is-selected {
  transform: translateY(-3px);
  border-color: rgba(0,114,206,.42);
  box-shadow: 0 16px 34px rgba(7,55,99,.12);
}

.pni-tl-card__marker {
  width: 12px;
  min-width: 12px;
  height: 48px;
  border-radius: 999px;
  background: var(--pni-azul);
}

.pni-tl-card__year {
  display: inline-block;
  margin-bottom: 7px;
  color: var(--pni-azul);
  font-size: 14px;
  font-weight: 900;
}

.pni-tl-card__title {
  margin: 0 0 8px;
  color: var(--pni-azul-oscuro);
  font-size: 16px;
  line-height: 1.25;
  font-weight: 900;
}

.pni-tl-card__desc {
  margin: 0;
  color: var(--pni-texto-2);
  font-size: 13.5px;
  line-height: 1.48;
}

/* -----------------------------
   MODAL
----------------------------- */

.pni-tl-modal {
  position: fixed;
  inset: 0;
  z-index: 999999;
  display: grid;
  place-items: center;
  padding: 22px;
}

.pni-tl-modal[hidden] {
  display: none;
}

.pni-tl-modal__overlay {
  position: absolute;
  inset: 0;
  background: rgba(7, 31, 55, .62);
  backdrop-filter: blur(7px);
}

.pni-tl-modal__box {
  position: relative;
  z-index: 1;
  width: min(860px, 96vw);
  max-height: 88vh;
  overflow: auto;
  padding: 30px;
  border-radius: 28px;
  background: #fff;
  box-shadow: 0 32px 88px rgba(0,0,0,.28);
  animation: pniModalIn .22s ease-out;
}

@keyframes pniModalIn {
  from {
    opacity: 0;
    transform: translateY(18px) scale(.98);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.pni-tl-modal__close {
  position: absolute;
  top: 16px;
  right: 16px;
  width: 42px;
  height: 42px;
  border: 0;
  border-radius: 999px;
  background: #eef5fb;
  color: var(--pni-azul-oscuro);
  font-size: 28px;
  line-height: 1;
  cursor: pointer;
}

.pni-tl-modal__close:hover {
  background: var(--pni-azul);
  color: #fff;
}

.pni-tl-modal h2 {
  margin: 0 46px 14px 0;
  color: var(--pni-azul-oscuro);
  font-size: clamp(25px, 3vw, 42px);
  line-height: 1.1;
  font-weight: 900;
  letter-spacing: -0.04em;
}

.pni-tl-modal__description {
  margin: 0 0 20px;
  color: var(--pni-texto);
  font-size: 17px;
  line-height: 1.65;
}

.pni-tl-modal__body {
  display: grid;
  grid-template-columns: 1.3fr .9fr;
  gap: 18px;
}

.pni-tl-modal__block {
  padding: 18px;
  border: 1px solid var(--pni-borde);
  border-radius: 20px;
  background: #f8fbff;
}

.pni-tl-modal__block h3 {
  margin: 0 0 9px;
  color: var(--pni-azul-oscuro);
  font-size: 17px;
  font-weight: 900;
}

.pni-tl-modal__block p {
  margin: 0;
  color: var(--pni-texto-2);
  line-height: 1.6;
}

.pni-tl-modal__list {
  margin: 0;
  padding-left: 18px;
  color: var(--pni-texto-2);
  line-height: 1.8;
}

/* -----------------------------
   TOOLTIP
----------------------------- */

.pni-tl-tooltip {
  position: fixed;
  z-index: 1000000;
  width: min(300px, 84vw);
  padding: 14px 15px;
  border-radius: 18px;
  border: 1px solid rgba(215,228,242,.95);
  background: rgba(255,255,255,.98);
  color: var(--pni-texto);
  box-shadow: 0 20px 52px rgba(7,55,99,.20);
  pointer-events: none;
  transform: translate(-50%, calc(-100% - 14px));
}

.pni-tl-tooltip[hidden] {
  display: none;
}

.pni-tl-tooltip::after {
  content: "";
  position: absolute;
  left: 50%;
  bottom: -8px;
  width: 16px;
  height: 16px;
  transform: translateX(-50%) rotate(45deg);
  background: #fff;
  border-right: 1px solid rgba(215,228,242,.95);
  border-bottom: 1px solid rgba(215,228,242,.95);
}

.pni-tl-tooltip__year {
  display: inline-flex;
  margin-bottom: 7px;
  padding: 5px 8px;
  border-radius: 999px;
  background: var(--pni-azul);
  color: #fff;
  font-size: 12px;
  font-weight: 900;
}

.pni-tl-tooltip__title {
  color: var(--pni-azul-oscuro);
  font-size: 14px;
  line-height: 1.35;
  font-weight: 900;
}

.pni-tl-tooltip__category {
  margin-top: 7px;
  color: var(--pni-muted);
  font-size: 12px;
  font-weight: 750;
}

/* -----------------------------
   FOOTER
----------------------------- */

.pni-tl-footer {
  margin: 24px 0 0;
  padding: 20px 24px;
  border-radius: 20px;
  background: #f8fbff;
  border: 1px solid var(--pni-borde);
  color: var(--pni-texto-2);
  font-size: 13.5px;
  line-height: 1.55;
}

.pni-tl-footer p {
  margin: 0;
}

.pni-tl-footer p + p {
  margin-top: 6px;
}

/* -----------------------------
   ESTADOS VACÍOS
----------------------------- */

.pni-tl-empty {
  width: min(680px, calc(100vw - 60px));
  padding: 26px;
  border: 1px dashed rgba(0,94,168,.35);
  border-radius: 22px;
  background: var(--pni-celeste-2);
  color: var(--pni-texto-2);
  text-align: center;
}

.pni-tl-empty strong {
  display: block;
  margin-bottom: 6px;
  color: var(--pni-azul-oscuro);
  font-size: 18px;
}

/* -----------------------------
   RESPONSIVE
----------------------------- */

@media (max-width: 1100px) {
  .pni-tl-cards {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .pni-tl-summary {
    grid-template-columns: 1fr;
  }

  .pni-tl-detail__meta,
  .pni-tl-modal__body {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 768px) {
  #pni-timeline-app {
    max-width: 100%;
  }

  .pni-tl-hero {
    padding: 28px 22px;
    border-radius: 22px;
  }

  .pni-tl-hero__top {
    align-items: flex-start;
    flex-direction: column;
  }

  .pni-tl-hero__meta {
    grid-template-columns: 1fr;
  }

  .pni-tl-intro {
    grid-template-columns: 1fr;
    padding: 20px;
  }

  .pni-tl-controls,
  .pni-tl-museum,
  .pni-tl-grid-section {
    padding: 18px;
    border-radius: 22px;
  }

  .pni-tl-filter-row {
    flex-wrap: nowrap;
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .pni-tl-filter,
  .pni-tl-period {
    white-space: nowrap;
  }

  .pni-tl-museum__header {
    flex-direction: column;
  }

  .pni-tl-museum__actions {
    width: 100%;
  }

  .pni-tl-navbtn {
    flex: 1;
  }

  .pni-tl-stage {
    min-height: 320px;
    padding: 54px 22px 64px;
  }

  .pni-tl-axis {
    left: 32px;
    right: 32px;
    top: 164px;
  }

  .pni-tl-timeline {
    gap: 40px;
  }

  .pni-tl-node {
    width: 124px;
  }

  .pni-tl-node__card {
    width: 124px;
  }

  .pni-tl-mobile-hint {
    display: block;
  }

  .pni-tl-detail__content,
  .pni-tl-detail__empty {
    padding: 22px;
  }

  .pni-tl-cards {
    grid-template-columns: 1fr;
  }

  .pni-tl-modal {
    padding: 12px;
  }

  .pni-tl-modal__box {
    padding: 24px 20px;
    border-radius: 22px;
  }
}

@media (max-width: 480px) {
  .pni-tl-logo-box {
    min-width: 132px;
  }

  .pni-tl-hero h1 {
    font-size: 32px;
  }

  .pni-tl-search {
    font-size: 14px;
  }

  .pni-tl-node {
    width: 112px;
  }

  .pni-tl-node__card {
    width: 112px;
    padding: 11px 8px;
  }

  .pni-tl-node__title {
    font-size: 12.3px;
  }
}

/* -----------------------------
   ACCESIBILIDAD / REDUCCIÓN DE MOVIMIENTO
----------------------------- */

@media (prefers-reduced-motion: reduce) {
  #pni-timeline-app *,
  #pni-timeline-app *::before,
  #pni-timeline-app *::after {
    animation: none !important;
    transition: none !important;
    scroll-behavior: auto !important;
  }
}
/* =========================================================
   PARCHE FINAL - OCULTAR LISTADO INFERIOR DE HITOS
   Pegar al FINAL del CSS WPCode de la Línea de Tiempo PNI.
   ========================================================= */

#pni-timeline-app .pni-tl-grid-section,
#pni-timeline-app #pniTlCards,
#pni-timeline-app .pni-tl-cards {
  display: none !important;
  visibility: hidden !important;
  height: 0 !important;
  min-height: 0 !important;
  max-height: 0 !important;
  overflow: hidden !important;
  margin: 0 !important;
  padding: 0 !important;
  border: 0 !important;
}
/* =========================================================
   LINEA DE TIEMPO PNI - PARCHE CSS MODO EXPOSICIÓN + IMÁGENES
   Pegar al FINAL del CSS actual en WPCode.
   ========================================================= */

/* Botón modo exposición */
#pni-timeline-app .pni-tl-playbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  flex-wrap: wrap;
  margin: 18px 0 0;
  padding: 16px 18px;
  border: 1px solid var(--pni-borde);
  border-radius: 20px;
  background: linear-gradient(180deg, #ffffff, #f6fbff);
  box-shadow: 0 10px 24px rgba(7,55,99,.08);
}

#pni-timeline-app .pni-tl-playbar__text {
  color: var(--pni-texto-2);
  font-size: 14px;
  line-height: 1.45;
}

#pni-timeline-app .pni-tl-playbar__text strong {
  display: block;
  color: var(--pni-azul-oscuro);
  font-size: 15px;
  margin-bottom: 2px;
}

#pni-timeline-app .pni-tl-playbar__actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
}

#pni-timeline-app .pni-tl-playbtn {
  min-height: 42px;
  padding: 10px 16px;
  border: 1px solid var(--pni-azul);
  border-radius: 999px;
  background: var(--pni-azul);
  color: #fff;
  font-size: 13.5px;
  font-weight: 850;
  cursor: pointer;
  box-shadow: 0 10px 22px rgba(0,94,168,.18);
  transition: transform .16s ease, background .16s ease, color .16s ease;
}

#pni-timeline-app .pni-tl-playbtn:hover {
  transform: translateY(-1px);
  background: var(--pni-azul-oscuro);
}

#pni-timeline-app .pni-tl-playbtn.is-secondary {
  background: #fff;
  color: var(--pni-azul);
}

#pni-timeline-app .pni-tl-playbtn.is-secondary:hover {
  background: var(--pni-celeste);
  color: var(--pni-azul-oscuro);
}

/* Estado destacado durante reproducción */
#pni-timeline-app .pni-tl-node.is-playing .pni-tl-node__dot {
  animation: pniPulseNode 1.1s infinite;
}

@keyframes pniPulseNode {
  0% { box-shadow: 0 0 0 5px rgba(0,114,206,.14), 0 12px 28px rgba(0,94,168,.24); }
  70% { box-shadow: 0 0 0 14px rgba(0,114,206,0), 0 12px 28px rgba(0,94,168,.24); }
  100% { box-shadow: 0 0 0 5px rgba(0,114,206,.14), 0 12px 28px rgba(0,94,168,.24); }
}

/* Imagen histórica en ficha */
#pni-timeline-app .pni-tl-detail__media {
  display: grid;
  grid-template-columns: 220px 1fr;
  gap: 18px;
  align-items: stretch;
  margin: 20px 0;
  padding: 16px;
  border: 1px solid var(--pni-borde);
  border-radius: 22px;
  background: linear-gradient(180deg, #fff, #f8fbff);
}

#pni-timeline-app .pni-tl-detail__image {
  min-height: 150px;
  border-radius: 18px;
  overflow: hidden;
  background:
    radial-gradient(circle at 80% 20%, rgba(255,255,255,.28), transparent 28%),
    linear-gradient(135deg, var(--pni-azul-oscuro), var(--pni-azul), var(--pni-azul-3));
  display: grid;
  place-items: center;
  color: #fff;
  position: relative;
}

#pni-timeline-app .pni-tl-detail__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

/* Placeholder institucional cuando no hay fotografía */
#pni-timeline-app .pni-tl-detail__image-placeholder {
  text-align: center;
  padding: 16px;
}

#pni-timeline-app .pni-tl-detail__image-placeholder span {
  display: block;
  font-size: 34px;
  margin-bottom: 8px;
}

#pni-timeline-app .pni-tl-detail__image-placeholder strong {
  display: block;
  font-size: 14px;
  line-height: 1.25;
}

#pni-timeline-app .pni-tl-detail__caption {
  color: var(--pni-texto-2);
  font-size: 14.5px;
  line-height: 1.6;
}

#pni-timeline-app .pni-tl-detail__caption strong {
  display: block;
  margin-bottom: 6px;
  color: var(--pni-azul-oscuro);
  font-size: 16px;
}

/* Modal con imagen */
#pni-timeline-app .pni-tl-modal__media {
  margin: 18px 0;
  border-radius: 22px;
  overflow: hidden;
  border: 1px solid var(--pni-borde);
  background: #f8fbff;
}

#pni-timeline-app .pni-tl-modal__media img {
  width: 100%;
  max-height: 320px;
  object-fit: cover;
  display: block;
}

#pni-timeline-app .pni-tl-modal__media-placeholder {
  min-height: 220px;
  display: grid;
  place-items: center;
  text-align: center;
  padding: 24px;
  color: #fff;
  background:
    radial-gradient(circle at 80% 20%, rgba(255,255,255,.25), transparent 30%),
    linear-gradient(135deg, var(--pni-azul-oscuro), var(--pni-azul), var(--pni-azul-3));
}

#pni-timeline-app .pni-tl-modal__media-placeholder span {
  display: block;
  font-size: 42px;
  margin-bottom: 8px;
}

#pni-timeline-app .pni-tl-modal__media-placeholder strong {
  font-size: 18px;
}

/* Tooltip enriquecido */
#pni-timeline-app .pni-tl-tooltip__desc {
  margin-top: 8px;
  color: var(--pni-texto-2);
  font-size: 12.5px;
  line-height: 1.4;
}

/* Responsive */
@media (max-width: 768px) {
  #pni-timeline-app .pni-tl-playbar {
    align-items: flex-start;
  }

  #pni-timeline-app .pni-tl-playbar__actions,
  #pni-timeline-app .pni-tl-playbtn {
    width: 100%;
  }

  #pni-timeline-app .pni-tl-detail__media {
    grid-template-columns: 1fr;
  }
}
