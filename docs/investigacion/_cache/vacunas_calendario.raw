{
  "id": "asplenia_hiposplenia_esplenectomia_con_vacunaciones_previas",
  "grupo": "Asplenia / hiposplenia",
  "nombre": "Esplenectomía con vacunaciones previas",
  "vacunas": [
    {
      "nombre": "Neumocócica conjugada",
      "esquema": "Según antecedente vacunal",
      "inicio": "Idealmente al menos 14 días antes de esplenectomía programada",
      "observacion": "Completar o actualizar esquema neumocócico antes de la cirugía cuando sea posible."
    },
    {
      "nombre": "Neumocócica polisacárida 23v",
      "esquema": "1 dosis posterior a vacuna conjugada; considerar refuerzo según normativa vigente",
      "inicio": "Posterior a vacuna neumocócica conjugada",
      "observacion": "Administrar posterior a vacuna conjugada respetando intervalo mínimo."
    },
    {
      "nombre": "Haemophilus influenzae tipo b (Hib)",
      "esquema": "1 dosis si no existe antecedente vacunal completo o confiable",
      "inicio": "Idealmente al menos 14 días antes de esplenectomía programada",
      "observacion": "Indicada si no cuenta con esquema completo o antecedente confiable."
    },
    {
      "nombre": "Meningocócica ACWY",
      "esquema": "Según edad y antecedente vacunal; considerar refuerzos si riesgo persiste",
      "inicio": "Idealmente al menos 14 días antes de esplenectomía programada",
      "observacion": "Priorizar antes de la cirugía cuando sea posible."
    },
    {
      "nombre": "Meningocócica B",
      "esquema": "Según edad y formulación disponible",
      "inicio": "Idealmente al menos 14 días antes de esplenectomía programada",
      "observacion": "Priorizar antes de la cirugía cuando sea posible."
    },
    {
      "nombre": "Influenza",
      "esquema": "1 dosis anual",
      "inicio": "Campaña anual",
      "observacion": "Vacunación anual recomendada durante toda la vida."
    },
    {
      "nombre": "COVID-19",
      "esquema": "Según estrategia vigente",
      "inicio": "Según campaña o recomendación vigente",
      "observacion": "Mantener esquema actualizado según recomendaciones vigentes."
    }
  ],
  "notas": [
    "En esplenectomía programada, administrar vacunas idealmente al menos 14 días antes del procedimiento.",
    "Mantener esquema PNI al día según edad."
  ],
  "fuente": "Manual de Vacunación Especial, actualización 2025",
  "paginas": "Capítulo Asplenia / hiposplenia"
},
{
  "id": "asplenia_hiposplenia_esplenectomia_sin_vacunaciones_previas",
  "grupo": "Asplenia / hiposplenia",
  "nombre": "Esplenectomía sin vacunaciones previas",
  "vacunas": [
    {
      "nombre": "Neumocócica conjugada",
      "esquema": "Según edad y antecedente vacunal",
      "inicio": "Idealmente al menos 14 días antes de esplenectomía programada o una vez estabilizado el paciente",
      "observacion": "Iniciar esquema prioritariamente por riesgo de infección invasora por bacterias capsuladas."
    },
    {
      "nombre": "Neumocócica polisacárida 23v",
      "esquema": "1 dosis posterior a vacuna conjugada; considerar refuerzo según normativa vigente",
      "inicio": "Posterior a vacuna neumocócica conjugada",
      "observacion": "Administrar posterior a vacuna conjugada respetando intervalo mínimo."
    },
    {
      "nombre": "Haemophilus influenzae tipo b (Hib)",
      "esquema": "1 dosis si no existe antecedente vacunal completo o confiable",
      "inicio": "Idealmente al menos 14 días antes de esplenectomía programada o una vez estabilizado el paciente",
      "observacion": "Indicada si no cuenta con esquema completo o antecedente confiable."
    },
    {
      "nombre": "Meningocócica ACWY",
      "esquema": "Según edad y antecedente vacunal; considerar refuerzos si riesgo persiste",
      "inicio": "Idealmente al menos 14 días antes de esplenectomía programada o una vez estabilizado el paciente",
      "observacion": "Priorizar antes de la cirugía cuando sea posible."
    },
    {
      "nombre": "Meningocócica B",
      "esquema": "Según edad y formulación disponible",
      "inicio": "Idealmente al menos 14 días antes de esplenectomía programada o una vez estabilizado el paciente",
      "observacion": "Priorizar antes de la cirugía cuando sea posible."
    },
    {
      "nombre": "Influenza",
      "esquema": "1 dosis anual",
      "inicio": "Campaña anual",
      "observacion": "Vacunación anual recomendada durante toda la vida."
    },
    {
      "nombre": "COVID-19",
      "esquema": "Según estrategia vigente",
      "inicio": "Según campaña o recomendación vigente",
      "observacion": "Mantener esquema actualizado según recomendaciones vigentes."
    }
  ],
  "notas": [
    "Si no fue posible vacunar antes de la cirugía, iniciar esquema una vez estabilizado el paciente y según criterio clínico.",
    "Mantener esquema PNI al día según edad."
  ],
  "fuente": "Manual de Vacunación Especial, actualización 2025",
  "paginas": "Capítulo Asplenia / hiposplenia"
},
{
  "id": "enfermedades_cronicas_neumopatia_cronica_epoc_asma_persistente_moderada_o_grave",
  "grupo": "Enfermedades crónicas",
  "nombre": "Neumopatía crónica / EPOC / asma persistente moderada o grave",
  "vacunas": [
    {
      "nombre": "Influenza",
      "esquema": "1 dosis anual",
      "inicio": "Campaña anual",
      "observacion": "Indicada en personas con enfermedad pulmonar crónica, asma persistente moderada o grave, bronquiectasias, EPOC, enfermedad pulmonar intersticial, sarcoidosis, neumonectomía u otras neumopatías crónicas."
    },
    {
      "nombre": "COVID-19",
      "esquema": "Según periodicidad definida por el PNI",
      "inicio": "Según estrategia vigente",
      "observacion": "Indicación por condición respiratoria crónica."
    },
    {
      "nombre": "Neumocócica conjugada",
      "esquema": "1 dosis en no vacunados",
      "inicio": "Al diagnóstico o puesta al día",
      "observacion": "Usar VNC-13V o PCV-15 seguida de VNP-23V con intervalo mínimo de 8 semanas. Si se utiliza PCV-20 o PCV-21, administrar 1 dosis sin uso posterior de VNP-23V."
    },
    {
      "nombre": "Neumocócica polisacárida 23v",
      "esquema": "1 dosis posterior a vacuna conjugada",
      "inicio": "Mínimo 8 semanas después de VNC-13V o PCV-15",
      "observacion": "No administrar si se utilizó PCV-20 o PCV-21. Evaluar antecedente vacunal neumocócico previo."
    },
    {
      "nombre": "VRS",
      "esquema": "1 dosis",
      "inicio": "Desde los 60 años",
      "observacion": "Recomendada en mayores de 60 años con enfermedad pulmonar crónica, según disponibilidad e indicaciones vigentes del PNI."
    },
    {
      "nombre": "dTpa/dT",
      "esquema": "1 dosis de refuerzo cada 10 años",
      "inicio": "Según antecedente vacunal",
      "observacion": "Mantener protección contra difteria, tétanos y pertussis según calendario y antecedente."
    }
  ],
  "notas": [
    "No incluye las vacunas adicionales específicas de fibrosis quística; para esa condición usar el bloque separado de fibrosis quística.",
    "Si se utiliza PCV-20 o PCV-21 no se debe administrar VNP-23V posterior."
  ],
  "fuente": "Manual de Vacunación Especial, actualización 2025",
  "paginas": "Tabla 8.1-8.3, págs. 105-108"
},
{
  "id": "enfermedades_cronicas_fibrosis_quistica",
  "grupo": "Enfermedades crónicas",
  "nombre": "Fibrosis quística",
  "vacunas": [
    {
      "nombre": "Influenza",
      "esquema": "1 dosis anual",
      "inicio": "Campaña anual",
      "observacion": "Vacunación anual recomendada por condición respiratoria crónica."
    },
    {
      "nombre": "COVID-19",
      "esquema": "Según periodicidad definida por el PNI",
      "inicio": "Según estrategia vigente",
      "observacion": "Indicación por condición crónica."
    },
    {
      "nombre": "Neumocócica conjugada",
      "esquema": "1 dosis en no vacunados",
      "inicio": "Al diagnóstico o puesta al día",
      "observacion": "Usar VNC-13V o PCV-15 seguida de VNP-23V con intervalo mínimo de 8 semanas. Si se utiliza PCV-20 o PCV-21, administrar 1 dosis sin uso posterior de VNP-23V."
    },
    {
      "nombre": "Neumocócica polisacárida 23v",
      "esquema": "1 dosis posterior a vacuna conjugada",
      "inicio": "Mínimo 8 semanas después de VNC-13V o PCV-15",
      "observacion": "No administrar si se utilizó PCV-20 o PCV-21. Evaluar antecedente vacunal neumocócico previo."
    },
    {
      "nombre": "Hepatitis A",
      "esquema": "Según serología basal",
      "inicio": "Al diagnóstico o puesta al día",
      "observacion": "Indicada específicamente en fibrosis quística según serología basal."
    },
    {
      "nombre": "Hepatitis B",
      "esquema": "Según serología basal",
      "inicio": "Al diagnóstico o puesta al día",
      "observacion": "Indicada específicamente en fibrosis quística según serología basal. Evaluar respuesta postvacunal cuando corresponda."
    },
    {
      "nombre": "Varicela",
      "esquema": "2 dosis",
      "inicio": "Desde los 12 meses, según edad y antecedente",
      "observacion": "Vacuna viva atenuada. Verificar antecedente de enfermedad o vacunación previa y evaluar contraindicaciones antes de administrar."
    },
    {
      "nombre": "VRS",
      "esquema": "1 dosis",
      "inicio": "Desde los 60 años",
      "observacion": "Recomendada en mayores de 60 años con enfermedad pulmonar crónica, según disponibilidad e indicaciones vigentes del PNI."
    },
    {
      "nombre": "dTpa/dT",
      "esquema": "1 dosis de refuerzo cada 10 años",
      "inicio": "Según antecedente vacunal",
      "observacion": "Mantener protección contra difteria, tétanos y pertussis según calendario y antecedente."
    }
  ],
  "notas": [
    "Fibrosis quística debe mantenerse separada de otras neumopatías crónicas porque agrega Hepatitis A, Hepatitis B y Varicela."
  ],
  "fuente": "Manual de Vacunación Especial, actualización 2025",
  "paginas": "Tabla 8.1-8.3, págs. 105-108"
},
{
