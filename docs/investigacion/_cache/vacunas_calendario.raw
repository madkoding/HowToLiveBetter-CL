    }
  ],
  "notas": [
    "La indicación de VRS se restringe a mayores de 60 años con condiciones cardiovasculares de riesgo, según disponibilidad e indicaciones vigentes."
  ],
  "fuente": "Manual de Vacunación Especial, actualización 2025",
  "paginas": "Tabla 8.1-8.3, págs. 105-108"
},
{
  "id": "enfermedades_cronicas_diabetes_mellitus",
  "grupo": "Enfermedades crónicas",
  "nombre": "Diabetes mellitus",
  "vacunas": [
    {
      "nombre": "Influenza",
      "esquema": "1 dosis anual",
      "inicio": "Campaña anual",
      "observacion": "Vacunación anual recomendada."
    },
    {
      "nombre": "COVID-19",
      "esquema": "Según periodicidad definida por el PNI",
      "inicio": "Según estrategia vigente",
      "observacion": "Indicación por condición metabólica crónica."
    },
    {
      "nombre": "Neumocócica conjugada",
      "esquema": "1 dosis en no vacunados",
      "inicio": "Al diagnóstico o puesta al día",
      "observacion": "Usar VNC-13V o PCV-15 seguida de VNP-23V con intervalo mínimo de 8 semanas. Si se utiliza PCV-20 o PCV-21, administrar 1 dosis sin uso posterior de VNP-23V."
    },
    {
      "nombre": "Neumocócica polisacárida 23v",
      "esquema": "1 dosis posterior a vacuna conjugada",
      "inicio": "Mínimo 8 semanas después de VNC-13V o PCV-15",
      "observacion": "No administrar si se utilizó PCV-20 o PCV-21. Evaluar antecedente vacunal neumocócico previo."
    },
    {
      "nombre": "Hepatitis A",
      "esquema": "Según estudio serológico",
      "inicio": "Al diagnóstico o puesta al día",
      "observacion": "Administrar según resultado serológico y evaluación clínica."
    },
    {
      "nombre": "Hepatitis B",
      "esquema": "Según estudio serológico; 3 dosis si corresponde",
      "inicio": "Al diagnóstico o puesta al día",
      "observacion": "En adultos candidatos a diálisis, considerar indicación específica y evaluación de respuesta."
    },
    {
      "nombre": "Varicela",
      "esquema": "2 dosis con intervalo de 3 meses",
      "inicio": "Desde los 12 meses, según edad y antecedente",
      "observacion": "Vacuna viva atenuada. Verificar antecedente de enfermedad o vacunación previa y evaluar contraindicaciones antes de administrar."
    },
    {
      "nombre": "VRS",
      "esquema": "1 dosis",
      "inicio": "Desde los 60 años",
      "observacion": "Recomendada en mayores de 60 años con diabetes insulinorrequiriente o con complicaciones crónicas, según disponibilidad e indicaciones vigentes."
    },
    {
      "nombre": "dTpa/dT",
      "esquema": "1 dosis de refuerzo cada 10 años",
      "inicio": "Según antecedente vacunal",
      "observacion": "Mantener protección contra difteria, tétanos y pertussis según calendario y antecedente."
    }
  ],
  "notas": [
    "Se separa diabetes mellitus de obesidad severa para evitar indicar neumococo, hepatitis A/B o varicela a obesidad severa sin otra condición asociada."
  ],
  "fuente": "Manual de Vacunación Especial, actualización 2025",
  "paginas": "Tabla 8.1-8.3, págs. 105-108"
},
{
  "id": "enfermedades_cronicas_obesidad_severa",
  "grupo": "Enfermedades crónicas",
  "nombre": "Obesidad severa",
  "vacunas": [
    {
      "nombre": "Influenza",
      "esquema": "1 dosis anual",
      "inicio": "Campaña anual",
      "observacion": "Indicación por mayor riesgo de complicaciones."
    },
    {
      "nombre": "COVID-19",
      "esquema": "Según periodicidad definida por el PNI",
      "inicio": "Según estrategia vigente",
      "observacion": "Indicación por mayor riesgo de complicaciones."
    },
    {
      "nombre": "VRS",
      "esquema": "1 dosis",
      "inicio": "Desde los 60 años",
      "observacion": "Recomendada en mayores de 60 años con obesidad severa IMC >40, según disponibilidad e indicaciones vigentes."
    }
  ],
  "notas": [
    "No agregar neumocócica, hepatitis A/B ni varicela por obesidad severa aislada, salvo que exista otra condición de riesgo asociada."
