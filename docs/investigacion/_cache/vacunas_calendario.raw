  {
    "id": "tph_adulto_receptor_de_tph",
    "grupo": "TPH",
    "nombre": "Adulto receptor de TPH",
    "vacunas": [
      {
        "nombre": "Influenza",
        "esquema": "Anual",
        "inicio": "Desde 6 o 12 meses post TPH según condición",
        "observacion": "Primera campaña y campañas posteriores según tabla."
      },
      {
        "nombre": "Hexavalente/dTpa-IPV-Hib-HB",
        "esquema": "3 dosis",
        "inicio": "Desde 6 o 12 meses post TPH según condición",
        "observacion": "Inicio a los 6 meses post TPH. Las dosis programadas para los meses 6, 7 y 8 corresponden a un esquema relativo 0-1-2 meses."
      },
      {
        "nombre": "Neumocócica conjugada",
        "esquema": "3 dosis",
        "inicio": "Desde 6 o 12 meses post TPH según condición",
        "observacion": "Inicio a los 6 meses post TPH. Las dosis programadas para los meses 6, 7 y 8 corresponden a un esquema relativo 0-1-2 meses."
      },
      {
        "nombre": "Neumocócica polisacárida 23v",
        "esquema": "1 dosis",
        "inicio": "Desde 6 o 12 meses post TPH según condición",
        "observacion": "Posterior al esquema conjugado según tabla."
      },
      {
        "nombre": "Meningocócica ACWY",
        "esquema": "2 dosis",
        "inicio": "Desde 6 o 12 meses post TPH según condición",
        "observacion": "6° y 8° mes post TPH equivalen a 0-2 meses."
      },
      {
        "nombre": "Meningocócica B",
        "esquema": "2 o 3 dosis",
        "inicio": "Desde 6 o 12 meses post TPH según condición",
        "observacion": "Según formulación disponible."
      },
      {
        "nombre": "Hepatitis B",
        "esquema": "3 dosis",
        "inicio": "Desde 6 o 12 meses post TPH según condición",
        "observacion": "Evaluar respuesta anti-HBs."
      },
      {
        "nombre": "VPH",
        "esquema": "3 dosis (0-2-6 meses)",
        "inicio": "Desde 6 o 12 meses post TPH según condición",
        "observacion": "Según edad/criterio."
      },
      {
        "nombre": "SRP",
        "esquema": "2 dosis separadas por al menos 1 mes",
        "inicio": "Desde 6 o 12 meses post TPH según condición",
        "observacion": "Administrar sólo si han transcurrido al menos 24 meses post TPH, sin inmunosupresión activa, sin EICH activa y con adecuada recuperación inmune."
      },
      {
        "nombre": "Varicela",
        "esquema": "2 dosis separadas por al menos 3 meses",
        "inicio": "Desde 6 o 12 meses post TPH según condición",
        "observacion": "Administrar sólo si han transcurrido al menos 24 meses post TPH, sin inmunosupresión activa, sin EICH activa y con adecuada recuperación inmune."
      }
    ],
    "notas": [
      "Primera campaña y campañas posteriores según tabla.",
      "Meses 6-7-8 post TPH equivalen a 0-1-2 meses.",
      "Posterior al esquema conjugado según tabla.",
      "6° y 8° mes post TPH equivalen a 0-2 meses.",
      "Según formulación disponible.",
      "Evaluar respuesta anti-HBs.",
      "Según edad/criterio.",
      "Sólo si cumple criterios inmunológicos y sin inmunosupresión.",
      "Vacuna viva: requiere evaluación estricta."
    ],
    "fuente": "Manual de Vacunación Especial, actualización 2025",
    "paginas": "Tabla 6.9, pág. 88"
  },
