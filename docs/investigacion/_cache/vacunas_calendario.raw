 el producto tiene mas de una excursion de temperatura se puede acumular","observaciones":"Entre 0 a < 2°C por 30 dias. Indicaciones válidas hasta el 31 enero 2027"},{"fecha":"Actualizado 13/05/2026","vacuna":"Inmunoglobulina estandar/ Universidad Nacional de Córdoba","proveedor":"Cenabast","criterios":{"≤ 12 horas":{"-5°C a <-3°C":"eliminar","-3°C a <0°C":"eliminar","0°C a <2°C":"Consultar","8°C a 25°C":"liberar",">25°C a 37°C":"Consultar"},">12 a 24 horas":{"-5°C a <-3°C":"eliminar","-3°C a <0°C":"eliminar","0°C a <2°C":"Consultar","8°C a 25°C":"liberar",">25°C a 37°C":"Consultar"},">24 a 72 horas":{"-5°C a <-3°C":"eliminar","-3°C a <0°C":"eliminar","0°C a <2°C":"Consultar","8°C a 25°C":"liberar",">25°C a 37°C":"Consultar"}},"aplica":"Solo primera excursión","observaciones":"Indican que excursiones breves entre 0 °C y < 2 °C no necesariamente comprometen la calidad del producto, por lo que se debe consultar caso a caso."},{"fecha":"Actualizado 15/05/2026","vacuna":"Influenza (Anflu)","proveedor":"Sinovac","criterios":{"≤ 12 horas":{"-5°C a <-3°C":"liberar","-3°C a <0°C":"liberar","0°C a <2°C":"liberar","8°C a 25°C":"liberar",">25°C a 37°C":"liberar"},">12 a 24 horas":{"-5°C a <-3°C":"liberar","-3°C a <0°C":"liberar","0°C a <2°C":"liberar","8°C a 25°C":"liberar",">25°C a 37°C":"liberar"},">24 a 72 horas":{"-5°C a <-3°C":"eliminar","-3°C a <0°C":"eliminar","0°C a <2°C":"Consultar","8°C a 25°C":"liberar",">25°C a 37°C":"liberar"}},"aplica":"Si el producto tiene mas de una excursion de temperatura se puede acumular","observaciones":"El laboratorio no cuenta con estudios de termoestabilidad para temperaturas inferiores a -5 °C, por lo que las vacunas expuestas a estas condiciones deben ser eliminadas.\nRespecto a temperaturas elevadas, existen estudios de estabilidad a 25 °C ±2 °C que respaldan el uso del producto hasta por 14 días de almacenamiento, así como estudios a 37 °C ±2 °C que demuestran estabilidad por un máximo de 3 días bajo dichas condiciones.\nPara excursiones de temperatura entre -5  °C y 0 °C, existe respaldo de estabilidad por hasta 24 horas. Superado este período, el producto debe ser eliminado.  \nEn relación con excursiones entre 0 °C y <2 °C, no existen estudios específicos que definan un tiempo máximo de estabilidad. Sin embargo, de manera conservadora, se propone considerar hasta 24 horas como tiempo de referencia. Si se supera este período, se recomienda consultar al proveedor para evaluación del caso."},{"fecha":"Actualizada 23/03/2026","vacuna":"Menveo","proveedor":"GSK","criterios":{"≤ 12 horas":{"-5°C a <-3°C":"Consultar","-3°C a <0°C":"Consultar","0°C a <2°C":"De 1 a 2°C liberar. 0°C consultar","8°C a 25°C":"liberar",">25°C a 37°C":"Consultar"},">12 a 24 horas":{"-5°C a <-3°C":"Consultar","-3°C a <0°C":"Consultar","0°C a <2°C":"De 1 a 2°C liberar. 0°C consultar","8°C a 25°C":"liberar",">25°C a 37°C":"Consultar"},">24 a 72 horas":{"-5°C a <-3°C":"Consultar","-3°C a <0°C":"Consultar","0°C a <2°C":"De 1 a 2°C liberar. 0°C consultar","8°C a 25°C":"Consultar",">25°C a 37°C":"Consultar"}},"aplica":"Si el producto tiene mas de una excursion de temperatura se puede acumular","observaciones":"Excursiones entre 1 a 2ºC , son aceptables sin límites de tiempo"},{"fecha":"Actualizada al 06/02/2025","vacuna":"Nirsevimab (50 - 100 mg)","proveedor":"Sanofi","criterios":{"≤ 12 horas":{"-5°C a <-3°C":"Consultar","-3°C a <0°C":"Consultar","0°C a <2°C":"liberar","8°C a 25°C":"liberar",">25°C a 37°C":"Consultar"},">12 a 24 horas":{"-5°C a <-3°C":"Consultar","-3°C a <0°C":"Consultar","0°C a <2°C":"liberar","8°C a 25°C":"Consultar",">25°C a 37°C":"Consultar"},">24 a 72 horas":{"-5°C a <-3°C":"Consultar","-3°C a <0°C":"Consultar","0°C a <2°C":"liberar","8°C a 25°C":"Consultar",">25°C a 37°C":"Consultar"}},"aplica":"Si el producto tiene mas de una excursion de temperatura se puede acumular","observaciones":"Entre -5°C y 0°C es estable por 8 horas. Entre 0 a < 2°C por tiempo ilimitado.  Entre 8°C y 25°C es estable por 12 horas. Entre 25°C y 40°C es estable por 4 horas."},{"fecha":"Actualizada al 04/11/2025","vacuna":"Jynneos","proveedor":"Bavarian Nordic","criterios":{"≤ 12 horas":{"-5°C a <-3°C":"Consultar","-3°C a <0°C":"liberar","0°C a <2°C":"liberar","8°C a 25°C":"liberar",">25°C a 37°C":"eliminar"},">12 a 24 horas":{"-5°C a <-3°C":"Consultar","-3°C a <0°C":"liberar","0°C a <2°C":"liberar","8°C a 25°C":"Hasta 15 horas se puede utilizar, sobre este tiempo se debe consultar",">25°C a 37°C":"eliminar"},">24 a 72 horas":{"-5°C a <-3°C":"Consultar","-3°C a <0°C":"liberar","0°C a <2°C":"liberar","8°C a 25°C":"Consultar",">25°C a 37°C":"eliminar"}},"aplica":"Solo primera excursión. Consultar si tiene mas de 1 excursión.","observaciones":"Duración entre 2-8°C de 8 semanas. En el caso de -3 a 2°C también aplican las 8 semanas."},{"fecha":"Actualizada al 23/01/2025","vacuna":"Covid Moderna","proveedor":"Moderna","criterios":{"≤ 12 horas":{"-5°C a <-3°C":"https://tools.modernamedinfo.com/es-CL/excursion/introduction-landing-page","-3°C a <0°C":"","0°C a <2°C":"","8°C a 25°C":"",">25°C a 37°C":""},">12 a 24 horas":{"-5°C a <-3°C":"","-3°C a <0°C":"","0°C a <2°C":"","8°C a 25°C":"",">25°C a 37°C":""},">24 a 72 horas":{"-5°C a <-3°C":"","-3°C a <0°C":"","0°C a <2°C":"","8°C a 25°C":"",">25°C a 37°C":""}},"aplica":"Si la vacuna tiene mas de una excursion de temperatura se puede acumular y utilizar la https://tools.modernamedinfo.com/es-CL/excursion/introduction-landing-page","observaciones":""}];

function normalizarTextoExcursionPNI(texto) {
  return String(texto || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
}

function clasificarResultadoExcursionPNI(texto) {
  var t = normalizarTextoExcursionPNI(texto);
  if (t === "liberar") return "liberar";
  if (t === "eliminar") return "eliminar";
  return "consultar";
}

function esSoloPrimeraExcursionPNI(item) {
  var aplica = normalizarTextoExcursionPNI(item && item.aplica ? item.aplica : "");
  return aplica.indexOf("solo primera excursion") !== -1;
}

function etiquetaResultadoExcursionPNI(tipo, item) {
  if (tipo === "liberar") {
    if (esSoloPrimeraExcursionPNI(item)) {
      return "Liberar vacuna (solo en caso de primera excursión)";
    }
    return "Liberar vacuna";
  }
  if (tipo === "eliminar") return "Eliminar vacuna";
  return "Consultar";
}

function poblarVacunasExcursionPNI() {
  var contenedor = document.getElementById("listaVacunasExcursionPNI");
  if (!contenedor || !Array.isArray(matrizExcursionPNI)) return;

  contenedor.innerHTML = "";

  matrizExcursionPNI.forEach(function(item, index) {
    var label = document.createElement("label");
    label.className = "item-vacuna-excursion";
    label.setAttribute("data-busqueda", normalizarTextoExcursionPNI(item.vacuna + " " + item.proveedor));

    var checkbox = document.createElement("input");
    checkbox.type = "checkbox";
    checkbox.className = "check-vacuna-excursion";
    checkbox.value = index;

    var texto = document.createElement("span");
    texto.textContent = item.vacuna + (item.proveedor ? " — " + item.proveedor : "");

    label.appendChild(checkbox);
    label.appendChild(texto);
    contenedor.appendChild(label);
  });
}

function filtrarVacunasExcursionPNI() {
  var buscador = document.getElementById("buscadorVacunaExcursion");
  var filtro = normalizarTextoExcursionPNI(buscador ? buscador.value : "");
  var items = document.querySelectorAll(".item-vacuna-excursion");

  items.forEach(function(item) {
    var texto = item.getAttribute("data-busqueda") || "";
    item.style.display = texto.indexOf(filtro) !== -1 ? "flex" : "none";
  });
}

function obtenerVacunasSeleccionadasExcursionPNI() {
  var checks = document.querySelectorAll(".check-vacuna-excursion:checked");
  var seleccionadas = [];

  checks.forEach(function(check) {
    seleccionadas.push(Number(check.value));
  });

  return seleccionadas;
}

function construirResultadoVacunaExcursionPNI(item, tiempo, temperatura) {
  var criterio = item.criterios && item.criterios[tiempo] ? item.criterios[tiempo][temperatura] : "Consultar";
  if (!criterio) criterio = "Consultar";

  var tipo = clasificarResultadoExcursionPNI(criterio);
  var clase = "resultado-" + tipo;
  var soloPrimera = tipo === "liberar" && esSoloPrimeraExcursionPNI(item);
  var etiqueta = etiquetaResultadoExcursionPNI(tipo, item);

  var mensajePrincipal = "";

  if (tipo === "liberar") {
    if (soloPrimera) {
      mensajePrincipal = "De acuerdo con la matriz de estabilidad seleccionada, el producto puede ser liberado solo si corresponde a una primera excursión de temperatura. Si el producto registra más de una excursión, no debe liberarse automáticamente y se debe enviar a consulta técnica.";
    } else {
      mensajePrincipal = "De acuerdo con la matriz de estabilidad seleccionada, el producto puede ser liberado para uso, siempre que se cumplan las condiciones habituales de almacenamiento, trazabilidad y que no existan otros antecedentes que contraindiquen su utilización.";
    }
  } else if (tipo === "eliminar") {
    mensajePrincipal = "De acuerdo con la matriz de estabilidad seleccionada, el producto debe ser eliminado y no debe utilizarse para administración.";
  } else {
    mensajePrincipal = "La combinación seleccionada requiere revisión técnica. No se debe liberar ni eliminar el producto sin consultar previamente al nivel técnico correspondiente, según el procedimiento vigente.";
  }

  var html = "";

  html += '<div class="resultado-excursion ' + clase + '" style="margin-bottom:18px;">';
  html += '<h3>Resultado: ' + etiqueta + '</h3>';

  if (soloPrimera) {
    html += '<div class="advertencia-primera-excursion">';
    html += '<strong>Advertencia:</strong> esta liberación aplica únicamente cuando se trata de la primera excursión de temperatura registrada para el producto. Si existe más de una excursión, el caso debe ser enviado a consulta técnica antes de utilizar las dosis.';
    html += '</div>';
  }

  html += '<p><strong>Vacuna/producto:</strong> ' + item.vacuna + '</p>';
  html += '<p><strong>Proveedor:</strong> ' + (item.proveedor || "No especificado") + '</p>';
  html += '<p><strong>Tiempo de excursión:</strong> ' + tiempo + '</p>';
  html += '<p><strong>Temperatura alcanzada:</strong> ' + temperatura + '</p>';
  html += '<p><strong>Criterio de la matriz:</strong> ' + criterio + (soloPrimera ? ' <span class="badge-primera-excursion">Solo primera excursión</span>' : '') + '</p>';
  html += '<p>' + mensajePrincipal + '</p>';

  if (item.aplica) {
    var aplicaTexto = item.aplica.replace(
      /(https?:\/\/[^\s]+)/g,
      '<a href="$1" target="_blank" rel="noopener noreferrer">herramienta Moderna</a>'
    );

    html += '<p class="texto-secundario"><strong>Aplicación del criterio:</strong> ' + aplicaTexto + '</p>';
  }

  if (item.observaciones) {
    html += '<p class="texto-secundario"><strong>Observaciones:</strong> ' + item.observaciones + '</p>';
  }

  if (item.fecha) {
    html += '<p class="texto-secundario"><strong>Fecha de actualización:</strong> ' + item.fecha + '</p>';
  }

  html += '<p class="texto-secundario"><strong>Nota:</strong> Esta herramienta constituye un apoyo para la revisión inicial de excursiones de temperatura y debe utilizarse conforme a los lineamientos técnicos institucionales vigentes.</p>';
  html += '</div>';

  return html;
}

function seleccionarTodasVacunasExcursionPNI() {
  var checks = document.querySelectorAll(".check-vacuna-excursion");

  checks.forEach(function(check) {
    var item = check.closest(".item-vacuna-excursion");
    if (!item || item.style.display !== "none") {
      check.checked = true;
    }
  });
}

function deseleccionarTodasVacunasExcursionPNI() {
  var checks = document.querySelectorAll(".check-vacuna-excursion");

  checks.forEach(function(check) {
    check.checked = false;
  });
}

function evaluarExcursionPNI() {
  var seleccionadas = obtenerVacunasSeleccionadasExcursionPNI();
  var tiempo = document.getElementById("tiempoExcursion").value;
  var temperatura = document.getElementById("temperaturaExcursion").value;
  var salida = document.getElementById("resultadoExcursionPNI");

  if (!salida) return;

  if (seleccionadas.length === 0 || !tiempo || !temperatura) {
    salida.innerHTML = '<div class="resultado-excursion resultado-advertencia"><h3>Complete los campos requeridos</h3><p>Debe seleccionar una o más vacunas/productos, rango de tiempo y rango de temperatura para realizar la evaluación.</p></div>';
    return;
  }

  var total = 0;
  var liberar = 0;
  var eliminar = 0;
  var consultar = 0;
  var liberarSoloPrimera = 0;

  var vacunasLiberar = [];
  var vacunasEliminar = [];
  var vacunasConsultar = [];
  var vacunasLiberarSoloPrimera = [];
  var filasTabla = [];

  var htmlDetalle = "";

  seleccionadas.forEach(function(index) {
    var item = matrizExcursionPNI[index];
    if (item) {
      var criterio = item.criterios && item.criterios[tiempo] ? item.criterios[tiempo][temperatura] : "Consultar";
      if (!criterio) criterio = "Consultar";

      var tipo = clasificarResultadoExcursionPNI(criterio);
      var nombre = item.vacuna + (item.proveedor ? " — " + item.proveedor : "");
      var soloPrimera = tipo === "liberar" && esSoloPrimeraExcursionPNI(item);
      var resolucionTabla = etiquetaResultadoExcursionPNI(tipo, item);

      total++;

      if (tipo === "liberar") {
        liberar++;
        vacunasLiberar.push(nombre + (soloPrimera ? " (solo en caso de primera excursión)" : ""));
        if (soloPrimera) {
          liberarSoloPrimera++;
          vacunasLiberarSoloPrimera.push(nombre);
        }
      } else if (tipo === "eliminar") {
        eliminar++;
        vacunasEliminar.push(nombre);
      } else {
        consultar++;
        vacunasConsultar.push(nombre);
      }

      filasTabla.push({
        producto: item.vacuna || "No especificado",
        proveedor: item.proveedor || "No especificado",
        temperatura: temperatura,
        tiempo: tiempo,
        criterio: criterio,
        resolucion: resolucionTabla,
        tipo: tipo,
        soloPrimera: soloPrimera
      });

      htmlDetalle += construirResultadoVacunaExcursionPNI(item, tiempo, temperatura);
    }
  });

  function construirListaResumen(titulo, cantidad, vacunas) {
    var html = "";
    html += "<p><strong>" + titulo + ":</strong> " + cantidad + "</p>";

    if (vacunas.length > 0) {
      html += '<ul class="lista-resumen-vacunas">';
      vacunas.forEach(function(nombre) {
        html += "<li>" + nombre + "</li>";
      });
      html += "</ul>";
    }

    return html;
  }

  function construirTablaResultados(filas) {
    var html = "";

    html += '<div class="tabla-excursion-contenedor">';
    html += '<h3>Tabla de resultados de evaluación</h3>';
    html += '<p class="texto-secundario">La tabla resume solo las variables disponibles en el visor. Ante antecedentes adicionales del evento, estos deben incorporarse al registro institucional correspondiente.</p>';
    html += '<div class="tabla-excursion-scroll">';
    html += '<table class="tabla-excursion-resultados">';
    html += '<thead><tr>';
    html += '<th>Producto</th>';
    html += '<th>Proveedor</th>';
    html += '<th>T° evaluada</th>';
    html += '<th>Tiempo evaluado</th>';
    html += '<th>Criterio matriz</th>';
    html += '<th>Resolución</th>';
    html += '</tr></thead>';
    html += '<tbody>';

    filas.forEach(function(fila) {
      var claseFila = 'fila-' + fila.tipo + (fila.soloPrimera ? ' fila-solo-primera' : '');
      html += '<tr class="' + claseFila + '">';
      html += '<td>' + fila.producto + '</td>';
      html += '<td>' + fila.proveedor + '</td>';
      html += '<td>' + fila.temperatura + '</td>';
      html += '<td>' + fila.tiempo + '</td>';
      html += '<td>' + fila.criterio + (fila.soloPrimera ? '<br><span class="badge-primera-excursion">Solo primera excursión</span>' : '') + '</td>';
      html += '<td><strong>' + fila.resolucion + '</strong></td>';
      html += '</tr>';
    });

    html += '</tbody>';
    html += '</table>';
    html += '</div>';
    html += '</div>';

    return html;
  }

  var htmlResumen = "";

  htmlResumen += '<div class="resultado-excursion resultado-advertencia" style="margin-bottom:22px;">';
  htmlResumen += '<h3>Resumen consolidado de evaluación</h3>';
  htmlResumen += '<p><strong>Vacunas/productos evaluados:</strong> ' + total + '</p>';

  htmlResumen += construirListaResumen("🟢 Liberar", liberar, vacunasLiberar);

  if (liberarSoloPrimera > 0) {
    htmlResumen += '<div class="advertencia-primera-excursion resumen-primera-excursion">';
    htmlResumen += '<strong>Atención:</strong> ' + liberarSoloPrimera + ' producto(s) figuran como liberables solo si corresponden a una primera excursión de temperatura. Si alguno registra más de una excursión, debe enviarse a consulta técnica.';
    htmlResumen += '</div>';
  }

  htmlResumen += construirListaResumen("🟠 Consultar", consultar, vacunasConsultar);
  htmlResumen += construirListaResumen("🔴 Eliminar", eliminar, vacunasEliminar);

  htmlResumen += '<p class="texto-secundario"><strong>Tiempo evaluado:</strong> ' + tiempo + ' | <strong>Temperatura evaluada:</strong> ' + temperatura + '</p>';
  htmlResumen += '</div>';

  salida.innerHTML = htmlResumen + construirTablaResultados(filasTabla) + htmlDetalle;
}

document.addEventListener("DOMContentLoaded", poblarVacunasExcursionPNI);

if (document.readyState !== "loading") {
  poblarVacunasExcursionPNI();
}
</script><style>
.pni-app {
  max-width: 980px;
  margin: 0 auto;
  font-family: inherit;
  color: #1f2937;
}

.pni-hero {
  background: linear-gradient(135deg, #005EB8, #0b7bd3);
  color: #ffffff;
  border-radius: 18px;
  padding: 28px;
  margin-bottom: 22px;
  box-shadow: 0 10px 28px rgba(0, 94, 184, 0.18);
}

.pni-hero h2 {
  color: #ffffff;
  margin: 4px 0 8px 0;
  font-size: 30px;
}

.pni-hero p {
  margin: 0;
}

.pni-kicker {
  text-transform: uppercase;
  letter-spacing: .08em;
  font-size: 12px;
  font-weight: 700;
  opacity: .9;
}

.pni-grupos {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  gap: 10px;
  margin: 18px 0;
}

.pni-btn {
  background: #ffffff;
  color: #005EB8;
  border: 1px solid #cfe6fa;
  padding: 14px 16px;
  border-radius: 14px;
  cursor: pointer;
  font-size: 16px;
  font-weight: 700;
  text-align: left;
  transition: .15s ease;
  box-shadow: 0 2px 8px rgba(0,0,0,.05);
}
	
.pni-btn:hover, .pni-btn.activo {
  background: #005EB8;
  color: #ffffff;
  border-color: #005EB8;
}

.pni-busqueda {
  background: #f8fafc;
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  padding: 16px;
  margin: 18px 0;
}

.pni-busqueda input {
  width: 100%;
  margin-top: 8px;
  padding: 13px 14px;
  border: 1px solid #cbd5e1;
  border-radius: 10px;
  font-size: 16px;
}

.pni-titulo-resultado {
  margin: 18px 0 8px 0;
  font-weight: 800;
  font-size: 20px;
  color: #0f172a;
}

.pni-edad {
  margin-top: 22px;
  margin-bottom: 10px;
  padding: 10px 14px;
  background: #e6f2fc;
  border-left: 5px solid #005EB8;
  border-radius: 8px;
  color: #003b73;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: .03em;
}

.pni-observaciones {
  background: #fee2e2;
  border-left: 4px solid #dc2626;
  padding: 12px 14px;
  border-radius: 10px;
  margin-top: 12px;
  color: #7f1d1d;
  font-size: 15px;
  line-height: 1.5;
}
	
.pni-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 12px;
}

.pni-card {
  border: 1px solid #e5e7eb;
  border-radius: 14px;
  padding: 16px;
  background: #ffffff;
  box-shadow: 0 2px 10px rgba(15,23,42,.06);
  cursor: pointer;
  transition: .15s ease;
}

.pni-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 20px rgba(15,23,42,.10);
  border-color: #93c5fd;
}

.pni-card h4 {
  margin: 0 0 10px 0;
  color: #005EB8;
  font-size: 18px;
}

.pni-card p {
  margin: 5px 0;
  font-size: 14px;
}

.pni-tag {
  display: inline-block;
  background: #fef2f2;
  color: #991b1b;
  border: 1px solid #fecaca;
  border-radius: 999px;
  padding: 4px 9px;
  font-size: 12px;
  font-weight: 700;
  margin-top: 8px;
}

.pni-fuente {
  margin-top: 22px;
  font-size: 12px;
  color: #64748b;
}

.pni-vacio {
  padding: 18px;
  border: 1px dashed #cbd5e1;
  border-radius: 12px;
  background: #f8fafc;
}

.pni-modal-bg {
  display: none;
  position: fixed;
  z-index: 99999;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: rgba(15, 23, 42, .55);
  align-items: center;
  justify-content: center;
  padding: 18px;
}

.pni-modal {
  position: relative;
  background: #ffffff;
  border-radius: 18px;
  padding: 24px;
  max-width: 680px;
  width: 100%;
  max-height: 86vh;
  overflow-y: auto;
  box-shadow: 0 20px 45px rgba(0,0,0,.25);
}

.pni-modal h3 {
  color: #005EB8;
  margin-top: 0;
}

.pni-cerrar {
  position: absolute;
  top: 12px;
  right: 14px;
  border: none;
  background: #f1f5f9;
  border-radius: 999px;
  width: 34px;
  height: 34px;
  cursor: pointer;
  font-size: 22px;
  line-height: 1;
}

.pni-link {
  display: inline-block;
  margin-top: 12px;
  background: #005EB8;
  color: #ffffff !important;
  padding: 10px 14px;
  border-radius: 10px;
  text-decoration: none;
  font-weight: 700;
}

@media (max-width: 640px) {
  .pni-hero {
    padding: 22px;
  }
  .pni-hero h2 {
    font-size: 24px;
  }
}
</style>

