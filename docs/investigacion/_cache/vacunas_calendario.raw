  // ===================== CAPÍTULO 9: ENFERMEDADES CRÓNICAS =====================
  {
    id: "cap9_cronicas",
    capitulo: "Cap 9",
    nombre: "Enfermedades crónicas",
    subcategorias: [
      {
        id: "cap9_general",
        nombre: "Vacunas según patología crónica",
        tabla: "Tabla 8.1",
        pagina: 105,
        edadGrupo: "Todas las edades",
        vacunas: [
          { vacuna: "Influenza", dosis: "1", esquema: "Anual", observaciones: "Para TODAS las patologías crónicas (neumopatía, cardiopatía, hepatopatía, nefropatía, enf. neurológica, fístula LCR/implante coclear, pat. hematológica, diabetes/obesidad)." },
          { vacuna: "Neumocócica conjugada 13v (o PCV-15)", dosis: "1", esquema: "-", observaciones: "En no vacunados, seguida de VNP-23v. Si PCV-20 o PCV-21 disponible: 1 dosis sin VNP-23v." },
          { vacuna: "Neumocócica polisacárida 23v", dosis: "1", esquema: "Mín 8 semanas post conjugada", observaciones: "No usar si se usó PCV-20 o PCV-21." },
          { vacuna: "COVID-19", dosis: "-", esquema: "Según PNI", observaciones: "Para todas las patologías crónicas." },
          { vacuna: "dTpa", dosis: "1", esquema: "Refuerzo cada 10 años", observaciones: "Para todas las patologías crónicas." },
          { vacuna: "Hepatitis A y B", dosis: "Según serología", esquema: "Según producto", observaciones: "Solo para: fibrosis quística, hepatopatía, nefropatía, pat. hematológica, diabetes (Hep B solo si candidato a diálisis)." },
          { vacuna: "Varicela", dosis: "2", esquema: "0-3 meses", observaciones: "Solo para: fibrosis quística, nefropatía/síndrome nefrótico, diabetes. Sin historia clínica o serología negativa." },
          { vacuna: "Hepatitis B (doble dosis 40µg)", dosis: "3", esquema: "0-1-6 meses", observaciones: "Nefropatía: usar doble dosis para pacientes en diálisis." },
          { vacuna: "VRS", dosis: "1", esquema: "-", observaciones: "En >60 años con: neumopatía crónica, insuficiencia cardíaca, cardiopatía congénita/coronaria, nefropatía, DM insulinorrequeriente. No disponible PNI." }
        ]
      }
    ]
  },

