          { vacuna: "Neumocócica conjugada 13v", dosis: "1", esquema: "-", observaciones: "-" },
          { vacuna: "Neumocócica polisacárida 23v", dosis: "1", esquema: "8 semanas post conjugada", observaciones: "Refuerzo a los 5 años (solo 1 vez)." },
          { vacuna: "dTpa", dosis: "1 o 3", esquema: "Cada 10 años (desde 23 años). 0-1-6m si nacidos antes 1975", observaciones: "Nacidos antes de 1975 sin antecedentes: esquema completo 3 dosis." },
          { vacuna: "VPH", dosis: "3", esquema: "0-2-6 meses", observaciones: "A partir de 9 años y hasta 26 años en no vacunados." },
          { vacuna: "Hepatitis B", dosis: "3", esquema: "0-1-6 meses", observaciones: "Requisito: Anti-core total negativo. Medir Anti-HBs 1-2 meses post." },
          { vacuna: "Meningocócica recombinante B", dosis: "3", esquema: "0-1 o 2 y 6 meses", observaciones: "Solo con fármacos que afecten complemento. Bexsero® hasta 50 años. MenB-FHbp 10-65 años." },
          { vacuna: "Meningocócica conjugada ACWY", dosis: "2", esquema: "0-2 meses", observaciones: "Solo con fármacos que afecten complemento. Refuerzo a 5 años si riesgo persiste." },
          { vacuna: "Hepatitis A", dosis: "2", esquema: "0-6 meses", observaciones: "<40 años con factores de riesgo, sin antecedente de inmunización previa." },
          { vacuna: "Herpes Zóster recombinante", dosis: "2", esquema: "0-2 meses", observaciones: ">18 años con serología VVZ positiva o antecedente. No disponible PNI." },
          { vacuna: "VRS", dosis: "1", esquema: "-", observaciones: "Solo >60 años con inmunosupresión moderada a severa. No disponible PNI." }
        ]
      }
    ]
  },

