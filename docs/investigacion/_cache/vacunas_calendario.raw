#pni-review-app,
#pni-review-app * {
  box-sizing: border-box;
}

#pni-review-app {
  width: 100%;
  max-width: 1200px;
  margin: 0 auto;
  padding: 28px 18px 48px;
  font-family: Arial, Helvetica, sans-serif;
  color: #1f2937;
}

/* =========================================================
   HERO
   ========================================================= */

#pni-review-app .pni-review-hero {
  position: relative;
  overflow: hidden;
  border-radius: 28px;
  padding: 38px 34px;
  background:
    radial-gradient(circle at top right, rgba(255,255,255,0.16), transparent 34%),
    linear-gradient(135deg, #073b7a 0%, #005aa7 52%, #0072bc 100%);
  color: #ffffff;
  box-shadow: 0 22px 48px rgba(3, 37, 76, 0.24);
}

#pni-review-app .pni-review-logo {
  width: 150px;
  max-width: 48%;
  height: auto;
  display: block;
  margin-bottom: 22px;
  filter: drop-shadow(0 8px 18px rgba(0,0,0,0.18));
}

#pni-review-app .pni-review-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 14px;
  margin-bottom: 16px;
  border-radius: 999px;
  background: rgba(255,255,255,0.16);
  border: 1px solid rgba(255,255,255,0.24);
  font-size: 13px;
  font-weight: 700;
  letter-spacing: 0.03em;
  text-transform: uppercase;
}

#pni-review-app .pni-review-hero h1 {
  margin: 0 0 12px;
  color: #ffffff;
  font-size: clamp(34px, 4vw, 56px);
  line-height: 1.05;
  font-weight: 900;
}

#pni-review-app .pni-review-hero p {
  max-width: 900px;
  margin: 0;
  color: rgba(255,255,255,0.92);
  font-size: 17px;
  line-height: 1.6;
}

/* =========================================================
   LAYOUT
   ========================================================= */

#pni-review-app .pni-review-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.55fr) minmax(320px, 0.45fr);
  gap: 20px;
  margin-top: 22px;
  align-items: start;
}

#pni-review-app .pni-review-side {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

#pni-review-app .pni-review-panel {
  background: #ffffff;
  border: 1px solid #dbe4ef;
  border-radius: 24px;
  padding: 22px;
  box-shadow: 0 14px 34px rgba(15, 23, 42, 0.08);
}

#pni-review-app .pni-review-panel h2 {
  margin: 0 0 10px;
  color: #073b7a;
  font-size: 22px;
  line-height: 1.2;
  font-weight: 800;
}

#pni-review-app .pni-review-panel-header {
  margin-bottom: 18px;
}

#pni-review-app .pni-review-panel-header.results {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14px;
  flex-wrap: wrap;
}

#pni-review-app .pni-review-panel-header p,
#pni-review-app .pni-review-panel p {
  margin: 0;
  color: #526173;
  font-size: 15px;
  line-height: 1.55;
}

/* =========================================================
   UPLOAD
   ========================================================= */

#pni-review-app .pni-upload-box,
#pni-review-app #pniDropZone {
  margin: 18px 0;
  padding: 22px;
  border: 2px dashed #b7cbe2;
  border-radius: 22px;
  background: linear-gradient(180deg, #f8fbff 0%, #f2f7fc 100%);
  transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
}

#pni-review-app #pniDropZone.dragover {
  border-color: #0072bc;
  background: #eef6ff;
  box-shadow: 0 0 0 4px rgba(0, 114, 188, 0.10);
}

#pni-review-app .pni-file-status {
  margin-top: 12px;
  padding: 10px 12px;
  border-radius: 12px;
  background: #f1f5f9;
  border: 1px solid #dbe4ef;
  color: #526173;
  font-size: 14px;
  font-weight: 700;
}

#pni-review-app .pni-file-status.ok {
  background: #ecfdf5;
  border-color: #bbf7d0;
  color: #047857;
}

#pni-review-app .pni-file-status.error {
  background: #fff1f2;
  border-color: #fecdd3;
  color: #be123c;
}

/* =========================================================
   FORMULARIO
   ========================================================= */

#pni-review-app .pni-review-field {
  margin-bottom: 16px;
}

#pni-review-app .pni-review-field label {
  display: block;
  margin-bottom: 7px;
  color: #1f2937;
  font-size: 14px;
  font-weight: 800;
}

#pni-review-app .pni-review-field input,
#pni-review-app .pni-review-field select,
#pni-review-app .pni-review-field textarea,
#pni-review-app .pni-review-filters input,
#pni-review-app .pni-review-filters select {
  display: block;
  width: 100% !important;
  max-width: none !important;
  border: 1px solid #c8d5e4;
  border-radius: 14px;
  background: #f8fafc;
  color: #1f2937;
  font-size: 15px;
  outline: none;
  transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
}

#pni-review-app .pni-review-field input,
#pni-review-app .pni-review-field select,
#pni-review-app .pni-review-filters input,
#pni-review-app .pni-review-filters select {
  height: 48px !important;
  padding: 0 14px !important;
}

#pni-review-app .pni-review-field textarea {
  min-height: 320px !important;
  padding: 14px !important;
  resize: vertical;
  line-height: 1.55;
}

#pni-review-app .pni-review-field input:focus,
#pni-review-app .pni-review-field select:focus,
#pni-review-app .pni-review-field textarea:focus,
#pni-review-app .pni-review-filters input:focus,
#pni-review-app .pni-review-filters select:focus {
  border-color: #0072bc;
  background: #ffffff;
  box-shadow: 0 0 0 4px rgba(0, 114, 188, 0.13);
}

/* =========================================================
   BOTONES
   ========================================================= */

#pni-review-app .pni-review-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 18px;
}

#pni-review-app .pni-review-btn {
  appearance: none;
  border: 0;
  border-radius: 14px;
  padding: 13px 18px;
  font-size: 15px;
  font-weight: 800;
  line-height: 1;
  cursor: pointer;
  transition: transform 0.18s ease, box-shadow 0.18s ease, opacity 0.18s ease;
}

#pni-review-app .pni-review-btn:hover {
  transform: translateY(-1px);
}

#pni-review-app .pni-review-btn.primary,
#pni-review-app .pni-review-btn.upload {
  background: #005aa7;
  color: #ffffff;
  box-shadow: 0 10px 22px rgba(0, 90, 167, 0.25);
}

#pni-review-app .pni-review-btn.secondary {
  background: #eef4fb;
  color: #073b7a;
  border: 1px solid #c8d5e4;
}

#pni-review-app .pni-review-btn.export {
  background: #0f766e;
  color: #ffffff;
  white-space: nowrap;
  box-shadow: 0 10px 22px rgba(15, 118, 110, 0.18);
}

#pni-review-app .pni-review-btn:disabled {
  opacity: 0.45;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

#pni-review-app .pni-export-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

/* =========================================================
   KPIS LATERALES
   ========================================================= */

#pni-review-app .pni-review-kpis {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 18px;
}

#pni-review-app .pni-review-kpi {
  padding: 18px 14px;
  border-radius: 18px;
  background: linear-gradient(180deg, #f8fafc 0%, #eef4fb 100%);
