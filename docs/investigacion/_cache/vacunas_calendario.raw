        edadGrupo: "18 años o más",
        vacunas: [
          { vacuna: "VPH", dosis: "3", esquema: "0-2-6 meses", observaciones: "Requiere biopsia que confirme NIE II o III + documento de conización en los últimos 12 meses. Aprobada hasta los 45 años." }
        ]
      },
      {
        id: "cap11_papilomatosis",
        nombre: "Papilomatosis laríngea",
        tabla: "Tabla 10.2",
        pagina: 126,
        edadGrupo: "Todas las edades",
        vacunas: [
          { vacuna: "VPH (9-45 años)", dosis: "3", esquema: "0-2-6 meses", observaciones: "Documentos definidos en el Protocolo de vacunas especiales." }
        ]
      }
    ]
  }
];

(function(){
  'use strict';

  function ready(fn){
    if(document.readyState === 'loading'){
      document.addEventListener('DOMContentLoaded', fn, { once:true });
    } else {
      fn();
    }
  }

  function escapeHTML(value){
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function normalizeText(text){
    return String(text || '')
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');
  }

  function initVacChileWidget(){
    const root = document.getElementById('vac-chile-2025-app');
    if(!root || root.dataset.initialized === 'true') return;

    const searchInput = root.querySelector('#searchInput');
    const dropdown = root.querySelector('#dropdown');
    const ageSelector = root.querySelector('#ageSelector');
    const resultsEl = root.querySelector('#results');
    const activeSelectionEl = root.querySelector('#activeSelection');

    if(!searchInput || !dropdown || !ageSelector || !resultsEl || !activeSelectionEl) return;
    root.dataset.initialized = 'true';

    let selectedCategory = null;
    let selectedAge = 'all';
    let activeDropdownIndex = -1;

    function getAllCategories(){
      return Array.isArray(VACCINATION_DATA) ? VACCINATION_DATA : [];
    }

    function filterCategories(query){
      const q = normalizeText(query).trim();
      const all = getAllCategories();
      if(!q) return all;
      return all.filter(item => {
        const haystack = normalizeText([
          item.capitulo,
          item.nombre,
          ...(item.subcategorias || []).map(s => s.nombre),
          ...(item.subcategorias || []).flatMap(s => (s.vacunas || []).map(v => `${v.vacuna} ${v.esquema} ${v.observaciones}`))
        ].join(' '));
        return haystack.includes(q);
      });
    }

    function buildDropdown(query){
      const filtered = filterCategories(query);
      activeDropdownIndex = -1;
      dropdown.innerHTML = '';

      if(filtered.length === 0){
        dropdown.innerHTML = '<div class="dropdown-empty">No se encontraron resultados</div>';
        return;
      }

      filtered.forEach((item, index) => {
        const el = document.createElement('div');
        el.className = 'dropdown-item';
        el.dataset.index = String(index);
        el.innerHTML = `<span class="cap-badge">${escapeHTML(item.capitulo)}</span><span>${escapeHTML(item.nombre)}</span>`;
        el.addEventListener('click', () => selectItem(item));
        el.addEventListener('mouseenter', () => {
          activeDropdownIndex = index;
          highlightDropdownItem();
        });
        dropdown.appendChild(el);
      });
    }

    function highlightDropdownItem(){
      const items = dropdown.querySelectorAll('.dropdown-item');
      items.forEach((el, index) => el.classList.toggle('active', index === activeDropdownIndex));
      if(activeDropdownIndex >= 0 && items[activeDropdownIndex]){
        items[activeDropdownIndex].scrollIntoView({ block:'nearest' });
      }
    }

    function openDropdown(){
      buildDropdown(searchInput.value);
      dropdown.classList.add('open');
    }

    function closeDropdown(){
      dropdown.classList.remove('open');
      activeDropdownIndex = -1;
    }

    function selectItem(item){
      selectedCategory = item;
      searchInput.value = '';
      closeDropdown();
      render();
    }

    function clearSelection(){
      selectedCategory = null;
      searchInput.value = '';
      render();
      searchInput.focus();
    }

    function render(){
      if(selectedCategory){
        activeSelectionEl.innerHTML = `
          <div class="active-selection">
            <span>${escapeHTML(selectedCategory.capitulo)}: ${escapeHTML(selectedCategory.nombre)}</span>
            <button id="clearSelectionBtn" type="button" aria-label="Quitar selección">&times;</button>
          </div>`;
        const clearBtn = root.querySelector('#clearSelectionBtn');
        if(clearBtn) clearBtn.addEventListener('click', clearSelection);
      } else {
        activeSelectionEl.innerHTML = '';
      }

      if(!selectedCategory){
        resultsEl.innerHTML = `
          <div class="empty-state">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <p>Seleccione una patología para ver las recomendaciones de vacunación</p>
            <p class="hint">Use el buscador o explore las categorías disponibles</p>
          </div>`;
        return;
      }

      const subs = (selectedCategory.subcategorias || []).filter(sub => {
        if(selectedAge === 'all') return true;
        return sub.edadGrupo === selectedAge || sub.edadGrupo === 'Todas las edades';
      });

      if(subs.length === 0){
        resultsEl.innerHTML = '<div class="no-age-match">No hay recomendaciones específicas para el grupo etario seleccionado en esta patología. Pruebe seleccionando “Todos”.</div>';
        return;
      }

      resultsEl.innerHTML = subs.map(sub => `
        <section class="cat-card">
          <div class="cat-header">
            <h3>${escapeHTML(sub.nombre)}</h3>
            <div class="cat-meta">
              <span>${escapeHTML(sub.tabla)} — Pág. ${escapeHTML(sub.pagina)}</span>
              <span class="age-badge">${escapeHTML(sub.edadGrupo)}</span>
            </div>
          </div>
          <div class="vac-table-wrap">
            <table class="vac-table">
              <colgroup>
                <col class="col-vacuna">
                <col class="col-dosis">
                <col class="col-esquema">
                <col class="col-obs">
              </colgroup>
              <thead>
                <tr>
                  <th scope="col">Vacuna</th>
                  <th scope="col">Dosis</th>
                  <th scope="col">Esquema</th>
                  <th scope="col">Observaciones</th>
                </tr>
              </thead>
              <tbody>
                ${(sub.vacunas || []).map(v => `
                  <tr>
                    <td>${escapeHTML(v.vacuna)}</td>
                    <td>${escapeHTML(v.dosis)}</td>
                    <td>${escapeHTML(v.esquema)}</td>
                    <td>${escapeHTML(v.observaciones)}</td>
                  </tr>`).join('')}
              </tbody>
            </table>
          </div>
        </section>`).join('');
    }

    searchInput.addEventListener('focus', openDropdown);
    searchInput.addEventListener('input', () => openDropdown());
    searchInput.addEventListener('keydown', (event) => {
      const items = dropdown.querySelectorAll('.dropdown-item');
      if(event.key === 'ArrowDown'){
        event.preventDefault();
        if(!dropdown.classList.contains('open')) openDropdown();
        activeDropdownIndex = Math.min(activeDropdownIndex + 1, items.length - 1);
        highlightDropdownItem();
      }
      if(event.key === 'ArrowUp'){
        event.preventDefault();
        activeDropdownIndex = Math.max(activeDropdownIndex - 1, 0);
        highlightDropdownItem();
      }
      if(event.key === 'Enter'){
        if(dropdown.classList.contains('open') && activeDropdownIndex >= 0){
          event.preventDefault();
          const filtered = filterCategories(searchInput.value);
          if(filtered[activeDropdownIndex]) selectItem(filtered[activeDropdownIndex]);
        }
      }
      if(event.key === 'Escape') closeDropdown();
    });

    ageSelector.addEventListener('click', (event) => {
      const btn = event.target.closest('.age-btn');
      if(!btn) return;
      selectedAge = btn.dataset.age || 'all';
      ageSelector.querySelectorAll('.age-btn').forEach(b => b.classList.remove('selected'));
      btn.classList.add('selected');
      render();
    });

    document.addEventListener('click', (event) => {
      if(!root.contains(event.target)) closeDropdown();
    });

    const allBtn = ageSelector.querySelector('[data-age="all"]');
    if(allBtn) allBtn.classList.add('selected');
    render();
  }

  ready(initVacChileWidget);
})();
</script><script>const CSV_URL = "https://vacunas.minsal.cl/wp-content/uploads/2026/08/Dashboard_Data.csv?nocache=" + Date.now();
const GROUP_COVERAGE_URL = "https://vacunas.minsal.cl/wp-content/uploads/2026/08/Cobertura_Grupos.csv?nocache=" + Date.now();
const REGION_COVERAGE_URL = "https://vacunas.minsal.cl/wp-content/uploads/2026/08/Cobertura_Regiones.csv?nocache=" + Date.now();
const SERVICE_COVERAGE_URL = "https://vacunas.minsal.cl/wp-content/uploads/2026/08/Cobertura_SS.csv?nocache=" + Date.now();
let DATA = [];
  let GROUP_COVERAGE_DATA = [];
  let REGION_COVERAGE_DATA = [];
  let SERVICE_COVERAGE_DATA = [];

  function parseCSVLine(line, delimiter = ';') {
    const out = [];
    let cur = '';
    let inQuotes = false;

    for (let i = 0; i < line.length; i++) {
      const ch = line[i];
      const next = line[i + 1];

      if (ch === '"' && inQuotes && next === '"') {
        cur += '"';
        i++;
      } else if (ch === '"') {
        inQuotes = !inQuotes;
      } else if (ch === delimiter && !inQuotes) {
        out.push(cur.trim());
        cur = '';
      } else {
        cur += ch;
      }
    }

    out.push(cur.trim());
    return out;
  }

  function numberFromCSV(value) {
    if (value === undefined || value === null) return 0;
    const clean = String(value)
      .trim()
      .replace(/\./g, '')
      .replace(',', '.')
      .replace(/%/g, '');

    const n = Number(clean);
    return Number.isFinite(n) ? n : 0;
  }

  function normalizeHeader(h) {
    return String(h || '')
      .trim()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/\s+/g, '_');
  }

  function normalizeGroupKey(value) {
    return String(value || '')
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/ñ/g, 'n')
      .replace(/[^a-z0-9]+/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  const GROUP_PROFILE = {
    total: { order: 1, icon: '👥', color: '#0072bc', label: 'Total' },
    personas_mayores: { order: 2, icon: '👴', color: '#047857', label: 'Personas mayores' },
    ninos: { order: 3, icon: '👶', color: '#f97316', label: 'Niños/as 6 meses a 5 años' },
    embarazadas: { order: 4, icon: '🤰', color: '#7c3aed', label: 'Embarazadas' }
  };

  function groupProfileKey(groupName) {
    const key = normalizeGroupKey(groupName);
    if (!key || key === 'total' || key === 'todos los grupos') return 'total';
    if (key.includes('mayor') || key.includes('60') || key.includes('adulto mayor')) return 'personas_mayores';
    if (key.includes('nino') || key.includes('nina') || key.includes('6 meses') || key.includes('5 anos')) return 'ninos';
    if (key.includes('embaraz')) return 'embarazadas';
    return key.replace(/\s+/g, '_');
  }

  function getGroupProfile(groupName) {
    const key = groupProfileKey(groupName);
    if (GROUP_PROFILE[key]) return GROUP_PROFILE[key];
    const palette = ['#0f766e','#2563eb','#be123c','#9333ea','#ca8a04','#0891b2','#475569'];
    let hash = 0;
    String(groupName || '').split('').forEach(ch => { hash = ((hash << 5) - hash) + ch.charCodeAt(0); hash |= 0; });
    return { order: 999, icon: '▫️', color: palette[Math.abs(hash) % palette.length], label: cleanGroupName(groupName) };
  }

  function cleanGroupName(groupName) {
    const raw = String(groupName || '').replace(/\s+/g, ' ').trim();
    if (!raw) return 'Total';
    const key = groupProfileKey(raw);
    return GROUP_PROFILE[key]?.label || raw;
  }

  function sortGroupsForDashboard(groups) {
    return [...new Set(groups.map(cleanGroupName).filter(Boolean))].sort((a, b) => {
      const pa = getGroupProfile(a);
      const pb = getGroupProfile(b);
      if (pa.order !== pb.order) return pa.order - pb.order;
      return String(a).localeCompare(String(b), 'es');
    });
  }

  function groupOptionLabel(groupName) {
    const profile = getGroupProfile(groupName);
    return `${profile.icon} ${cleanGroupName(groupName)}`;
  }

  function applyActiveGroupTheme() {
    const root = document.getElementById('observatorio-influenza');
    if (!root) return;
    const profile = getGroupProfile(group);
    root.style.setProperty('--group-accent', profile.color);
    const label = document.getElementById('activeGroupBadge');
    if (label) {
      label.innerHTML = `<span class="active-group-icon">${profile.icon}</span><span>${cleanGroupName(group)}</span>`;
      label.style.borderColor = profile.color;
      label.style.color = profile.color;
    }
  }

  function parseCSV(text) {
    const lines = String(text || '')
      .replace(/^\uFEFF/, '')
      .split(/\r?\n/)
      .filter(line => line.trim() !== '');

    if (!lines.length) return [];

    const delimiter = lines[0].includes(';') ? ';' : ',';
    const headers = parseCSVLine(lines[0], delimiter).map(normalizeHeader);

    return lines.slice(1).map(line => {
      const values = parseCSVLine(line, delimiter);
      const row = {};

      headers.forEach((h, i) => {
        row[h] = values[i] !== undefined ? values[i].trim() : '';
      });

      return {
        "Año": numberFromCSV(row.Ano),
        "Dia_Campaña": numberFromCSV(row.Dia_Campana),
        "Fecha": row.Fecha || '',
        "Mes": row.Mes || '',
        "Grupo": cleanGroupName(row.Grupo || row.Grupo_objetivo || row.Grupo_Objetivo || row.Nombre || 'Total'),
        "Vacunados_Diarios": numberFromCSV(row.Vacunados_Diarios),
        "Vacunados_Acumulados": numberFromCSV(row.Vacunados_Acumulados),
        "Cobertura": numberFromCSV(row.Cobertura),
        "Poblacion_Objetivo": numberFromCSV(row.Poblacion_Objetivo),
        "Meta": numberFromCSV(row.Meta) || 85,
        "Año_Grupo": row.Ano_Grupo || `${row.Ano} - ${cleanGroupName(row.Grupo || row.Grupo_objetivo || row.Grupo_Objetivo || row.Nombre || 'Total')}`
      };
    }).filter(d => d.Año && d.Dia_Campaña && d.Fecha && d.Grupo);
  }

  async function loadDashboardData() {
    const response = await fetch(CSV_URL, { cache: 'no-store' });

    if (!response.ok) {
      throw new Error(`No se pudo cargar el CSV (${response.status}): ${CSV_URL}`);
    }

    const text = await response.text();
    DATA = parseCSV(text);

    if (!DATA.length) {
      throw new Error('El CSV se cargó, pero no se encontraron filas válidas.');
    }
  }


  async function loadGroupCoverageData() {
    try {
      const response = await fetch(GROUP_COVERAGE_URL, { cache: 'no-store' });
      if (!response.ok) {
        console.warn(`No se pudo cargar Cobertura_Grupos.csv (${response.status}). El panel se mostrará sin datos.`);
        GROUP_COVERAGE_DATA = [];
        return;
      }

      const text = await response.text();
      const lines = String(text || '')
        .replace(/^\uFEFF/, '')
        .split(/\r?\n/)
        .filter(line => line.trim() !== '');

      if (!lines.length) {
        GROUP_COVERAGE_DATA = [];
        return;
      }

      const delimiter = lines[0].includes(';') ? ';' : ',';
      const headers = parseCSVLine(lines[0], delimiter).map(normalizeHeader);

      GROUP_COVERAGE_DATA = lines.slice(1).map(line => {
        const values = parseCSVLine(line, delimiter);
        const row = {};
        headers.forEach((h, i) => { row[h] = values[i] !== undefined ? values[i].trim() : ''; });

const grupoOriginal = String(
  row.Grupo || row.Grupo_objetivo || row.Grupo_Objetivo || row.Nombre || ''
).replace(/\s+/g, ' ').trim();

return {
  Grupo: grupoOriginal,
  Cobertura: numberFromCSV(row.Cobertura || row.Avance || row.Porcentaje)
};
      })
      .filter(d => d.Grupo && Number.isFinite(d.Cobertura))
      .sort((a,b) => b.Cobertura - a.Cobertura);
    } catch (error) {
      console.warn('No fue posible cargar Cobertura_Grupos.csv:', error);
      GROUP_COVERAGE_DATA = [];
    }
  }

  
async function loadRegionCoverageData() {
  try {
    const response = await fetch(REGION_COVERAGE_URL, { cache: 'no-store' });
    if (!response.ok) {
      console.warn(`No se pudo cargar Cobertura_Regiones.csv (${response.status}).`);
      REGION_COVERAGE_DATA = [];
      return;
    }

    const text = await response.text();
    const lines = String(text || '')
      .replace(/^\uFEFF/, '')
      .split(/\r?\n/)
      .filter(line => line.trim() !== '');

    if (!lines.length) {
      REGION_COVERAGE_DATA = [];
      return;
    }

    const delimiter = lines[0].includes(';') ? ';' : ',';
    const headers = parseCSVLine(lines[0], delimiter).map(normalizeHeader);

    REGION_COVERAGE_DATA = lines.slice(1).map(line => {
      const values = parseCSVLine(line, delimiter);
      const row = {};
      headers.forEach((h, i) => { row[h] = values[i] !== undefined ? values[i].trim() : ''; });

      const region = row.Region || row.Region_nombre || row.Nombre || '';
      const grupo = cleanGroupName(row.Grupo || row.Grupo_objetivo || row.Grupo_Objetivo || 'Total');

      return {
        Region: normalizeRegionName(region),
        RegionOriginal: region,
        Grupo: grupo,
        Cobertura: numberFromCSV(row.Cobertura || row.Avance || row.Porcentaje),
        Vacunados: numberFromCSV(row.Vacunados || row.Vacunados_Acumulados || row.Dosis || row.Total),
        Poblacion_Objetivo: numberFromCSV(row.Poblacion_Objetivo || row.Poblacion || row.Poblacion_objetivo)
      };
    })
    .filter(d => d.Region && d.Grupo && Number.isFinite(d.Cobertura))
    .sort((a,b) => b.Cobertura - a.Cobertura);
  } catch (error) {
    console.warn('No fue posible cargar Cobertura_Regiones.csv:', error);
    REGION_COVERAGE_DATA = [];
  }
}


async function loadServiceCoverageData() {
  try {
    const response = await fetch(SERVICE_COVERAGE_URL, { cache: 'no-store' });
    if (!response.ok) {
      console.warn(`No se pudo cargar Cobertura_SS.csv (${response.status}).`);
      SERVICE_COVERAGE_DATA = [];
      return;
    }

    const text = await response.text();
    const lines = String(text || '')
      .replace(/^\uFEFF/, '')
      .split(/\r?\n/)
      .filter(line => line.trim() !== '');

    if (!lines.length) {
      SERVICE_COVERAGE_DATA = [];
      return;
    }

    const delimiter = lines[0].includes(';') ? ';' : ',';
    const headers = parseCSVLine(lines[0], delimiter).map(normalizeHeader);

    SERVICE_COVERAGE_DATA = lines.slice(1).map((line, idx) => {
      const values = parseCSVLine(line, delimiter);
      const row = {};
      headers.forEach((h, i) => { row[h] = values[i] !== undefined ? values[i].trim() : ''; });

      const servicio = row.Servicio_Salud || row.Servicio_de_Salud || row.Servicio || row.SS || row.Nombre || row.Nombre_SS || row.Nombre_Servicio || '';
      const region = row.Region || row.Region_nombre || row.Region_SS || '';
      const servicioNormalizado = normalizeServiceName(servicio);
      const regionNormalizada = normalizeRegionName(region) || regionFromService(servicioNormalizado);
      const grupo = cleanGroupName(row.Grupo || row.Grupo_objetivo || row.Grupo_Objetivo || row.Nombre_Grupo || 'Total');

      return {
        OrdenCSV: idx,
        Servicio: servicioNormalizado,
        ServicioOriginal: servicio,
        Region: regionNormalizada,
        RegionOriginal: region || regionNormalizada,
        Grupo: grupo,
        Cobertura: numberFromCSV(row.Cobertura || row.Avance || row.Porcentaje || row.Cobertura_Porcentaje),
        Vacunados: numberFromCSV(row.Vacunados || row.Vacunados_Acumulados || row.Dosis || row.Total || row.Total_vacunados),
        Poblacion_Objetivo: numberFromCSV(row.Poblacion_Objetivo || row.Poblacion || row.Poblacion_objetivo || row.Poblacion_Total)
      };
    })
    .filter(d => d.Servicio && d.Grupo && Number.isFinite(d.Cobertura))
    .sort(serviceCsvOrderSort);
  } catch (error) {
    console.warn('No fue posible cargar Cobertura_SS.csv:', error);
    SERVICE_COVERAGE_DATA = [];
  }
}

  const COLORS={2022:'#94a3b8',2023:'#64748b',2024:'#38bdf8',2025:'#075985',2026:'#ef3340',meta:'#111827'};
  let metric='Cobertura',group='Total';let projectionWindow=14;let years=[];let selectedYears=[];
  const fmtNum=new Intl.NumberFormat('es-CL'),fmtDec=new Intl.NumberFormat('es-CL',{minimumFractionDigits:2,maximumFractionDigits:2});let slider=null,tip=null;
  function rawRowsForYear(y){return DATA.filter(d=>d.Grupo===group&&d.Año===y).sort((a,b)=>a.Dia_Campaña-b.Dia_Campaña)}function currentYear(){return Math.max(...years)}function actualMaxDay(y){let rows=rawRowsForYear(y);if(y!==currentYear())return rows.length?rows.at(-1).Dia_Campaña:0;let last=0,prev=null;rows.forEach(r=>{let changed=prev===null?((+r.Vacunados_Acumulados||0)>0):((+r.Vacunados_Acumulados||0)!=(+prev.Vacunados_Acumulados||0));if((+r.Vacunados_Diarios||0)>0||changed)last=r.Dia_Campaña;prev=r});return last||0}function rowsForYear(y){let rows=rawRowsForYear(y);let max=actualMaxDay(y);return y===currentYear()?rows.filter(r=>r.Dia_Campaña<=max):rows}function byYearDay(y,day){if(y===currentYear()&&day>actualMaxDay(y))return null;return rawRowsForYear(y).find(d=>d.Dia_Campaña===day)}function latestForYear(y){let r=rowsForYear(y).filter(x=>(+x.Vacunados_Acumulados||0)>0||(+x.Cobertura||0)>0);return r[r.length-1]||rowsForYear(y).at(-1)}function maxDay(){return Math.max(...DATA.filter(d=>d.Grupo===group).map(d=>d.Dia_Campaña))}function fmtPct(v){return fmtDec.format(+v||0)+'%'}function fmtPp(v){return(v>=0?'+':'')+fmtDec.format(+v||0)+' pp'}function calcBrecha(r,meta=85){return Math.max(0,Math.round((r.Poblacion_Objetivo||0)*meta/100-(r.Vacunados_Acumulados||0)))}function metricLabel(m){return m==='Cobertura'?'Cobertura (%)':m==='Vacunados_Acumulados'?'Vacunados acumulados':'Vacunados diarios'}function metricValue(r,m){return +r[m]||0}function niceMax(v){if(metric==='Cobertura')return Math.max(100,Math.ceil(v/10)*10);let p=Math.pow(10,Math.floor(Math.log10(Math.max(1,v))));return Math.ceil(v/p)*p}
  function init(){
    slider=document.getElementById('daySlider');
    tip=document.getElementById('tip');
    if(!slider){throw new Error('No se encontró el control daySlider. Revisa que el HTML completo del visor esté pegado en Divi antes de ejecutar el JavaScript.')}
    if(!tip){tip=document.createElement('div');tip.id='tip';tip.className='tip';document.body.appendChild(tip)}

    DATA.forEach(d=>{ d.Grupo = cleanGroupName(d.Grupo); });
    years=[...new Set(DATA.map(d=>d.Año))].sort((a,b)=>a-b);
    selectedYears=[...years];

    let sel=document.getElementById('groupSelect');
    if(sel){
      const dashboardGroups=sortGroupsForDashboard(DATA.map(d=>d.Grupo));
      sel.innerHTML='';
      dashboardGroups.forEach(g=>{
        const opt=document.createElement('option');
        opt.value=g;
        opt.textContent=groupOptionLabel(g);
        sel.appendChild(opt);
      });
      group = dashboardGroups.find(g=>normalizeGroupKey(g)==='total') || dashboardGroups[0] || 'Total';
      sel.value=group;
      sel.onchange=()=>{group=sel.value;applyActiveGroupTheme();reset()};
    }
    applyActiveGroupTheme();

    let box=document.getElementById('yearChecks');
    box.innerHTML=years.map(y=>`<button class="chip active" data-y="${y}">${y}</button>`).join('');
    box.querySelectorAll('.chip').forEach(b=>b.onclick=()=>{let y=+b.dataset.y;if(selectedYears.includes(y)&&selectedYears.length>1){selectedYears=selectedYears.filter(x=>x!==y);b.classList.remove('active')}else if(!selectedYears.includes(y)){selectedYears.push(y);selectedYears.sort();b.classList.add('active')}drawAll()});
    document.querySelectorAll('#metricButtons .btn').forEach(b=>b.onclick=()=>{document.querySelectorAll('#metricButtons .btn').forEach(x=>x.classList.remove('active'));b.classList.add('active');metric=b.dataset.metric;lineChart()});
    document.querySelectorAll('#projectionMethod button').forEach(b=>b.onclick=()=>{document.querySelectorAll('#projectionMethod button').forEach(x=>x.classList.remove('active'));b.classList.add('active');projectionWindow=+b.dataset.window;updateProjection();});
    slider.oninput=()=>{setVelocitySliderFromMain();updateDay();};
    setupDateControls();
    setupVelocityControls();
    setupGroupCoverageToggle();
    const presentationBtn=document.getElementById('presentationBtn');
    if(presentationBtn) presentationBtn.onclick=()=>{document.body.classList.toggle('presentation');setTimeout(drawAll,80)};
    window.onresize=()=>setTimeout(drawAll,100);
    reset();
  }

  function reset(){
    applyActiveGroupTheme();
    slider.max=maxDay();
    let maxLbl=document.getElementById('dayMaxLabel');
    if(maxLbl)maxLbl.textContent=slider.max;
    let l=latestForYear(Math.max(...years));
    slider.value=l?l.Dia_Campaña:1;
    drawAll();
  }function lineChart(){let el=document.getElementById('mainChart'),w=el.clientWidth||900,h=el.clientHeight||430,m={l:58,r:24,t:22,b:42},iw=w-m.l-m.r,ih=h-m.t-m.b;let labels=[...new Set(DATA.filter(d=>d.Grupo===group).map(d=>d.Dia_Campaña))].sort((a,b)=>a-b),minD=Math.min(...labels),maxD=Math.max(...labels);let all=[];selectedYears.forEach(y=>rowsForYear(y).forEach(r=>all.push(metricValue(r,metric))));if(metric==='Cobertura')all.push(85);let ymax=niceMax(Math.max(...all,1));let X=d=>m.l+(d-minD)/(maxD-minD||1)*iw,Y=v=>m.t+ih-(v/ymax)*ih,p=[];for(let i=0;i<=5;i++){let val=ymax*i/5,yy=Y(val);p.push(`<line class="gridline" x1="${m.l}" x2="${w-m.r}" y1="${yy}" y2="${yy}"/><text x="${m.l-10}" y="${yy+4}" text-anchor="end">${metric==='Cobertura'?Math.round(val)+'%':fmtNum.format(Math.round(val))}</text>`)}[minD,Math.round(maxD*.25),Math.round(maxD*.5),Math.round(maxD*.75),maxD].forEach(d=>p.push(`<text x="${X(d)}" y="${h-14}" text-anchor="middle">${d}</text>`));selectedYears.forEach(yr=>{let pts=rowsForYear(yr).map(r=>`${X(r.Dia_Campaña)},${Y(metricValue(r,metric))}`).join(' ');p.push(`<polyline class="line" points="${pts}" stroke="${COLORS[yr]}" stroke-width="${yr===Math.max(...years)?4:2.4}" opacity="${yr===Math.max(...years)?1:.78}"/>`)});if(metric==='Cobertura'){p.push(`<line class="meta" x1="${m.l}" x2="${w-m.r}" y1="${Y(85)}" y2="${Y(85)}" stroke-width="2"/><text x="${w-m.r-4}" y="${Y(85)-8}" text-anchor="end" fill="#111827" font-weight="800" font-size="12">Meta 85%</text>`)}let day=+slider.value;p.push(`<line class="sel" x1="${X(day)}" x2="${X(day)}" y1="${m.t}" y2="${h-m.b}"/>`);selectedYears.forEach(yr=>{let r=byYearDay(yr,day);if(r)p.push(`<circle cx="${X(day)}" cy="${Y(metricValue(r,metric))}" r="5" fill="${COLORS[yr]}" stroke="#fff" stroke-width="2"><title>${yr} · ${r.Fecha} · ${fmtPct(r.Cobertura)}</title></circle>`)});el.innerHTML=`<svg viewBox="0 0 ${w} ${h}" class="axis"><g>${p.join('')}</g><text x="${w/2}" y="${h-2}" text-anchor="middle" fill="#64748b" font-size="12" font-weight="800">Día de campaña</text><text x="16" y="${h/2}" text-anchor="middle" transform="rotate(-90 16 ${h/2})" fill="#64748b" font-size="12" font-weight="800">${metricLabel(metric)}</text><rect x="0" y="0" width="${w}" height="${h}" fill="transparent" id="hoverArea"/></svg>`;el.querySelector('#hoverArea').onmousemove=e=>{let rect=el.querySelector('svg').getBoundingClientRect(),px=e.clientX-rect.left,d=Math.round(minD+(px-m.l)/iw*(maxD-minD));d=Math.max(minD,Math.min(maxD,d));let rows=selectedYears.map(y=>byYearDay(y,d)).filter(Boolean);tip.style.display='block';tip.style.left=e.clientX+12+'px';tip.style.top=e.clientY+12+'px';tip.innerHTML='<div class="tip-head"><strong>Día '+d+'</strong> · '+metricLabel(metric)+'</div>'+rows.sort((a,b)=>b.Año-a.Año).map(r=>{let mv=metricValue(r,metric),mvTxt=metric==='Cobertura'?fmtPct(mv):fmtNum.format(Math.round(mv));return '<div class="tip-row"><span><i class="dot" style="background:'+COLORS[r.Año]+'"></i><strong>'+r.Año+'</strong></span><span class="muted">'+r.Fecha+'</span><span><strong>'+mvTxt+'</strong></span></div><div class="muted" style="padding-left:18px;margin-bottom:4px">Acum: '+fmtNum.format(r.Vacunados_Acumulados)+' · Diario: '+fmtNum.format(r.Vacunados_Diarios)+' · Brecha 85%: '+fmtNum.format(calcBrecha(r))+'</div>'}).join('')};el.onmouseleave=()=>tip.style.display='none'}
  function barChart(rows){let el=document.getElementById('barChart'),w=el.clientWidth||380,h=el.clientHeight||280,m={l:42,r:14,t:16,b:34},iw=w-m.l-m.r,ih=h-m.t-m.b,bw=iw/Math.max(rows.length,1)*.64,p=[];for(let i=0;i<=4;i++){let val=100*i/4,yy=m.t+ih-(val/100)*ih;p.push(`<line class="gridline" x1="${m.l}" x2="${w-m.r}" y1="${yy}" y2="${yy}"/><text x="${m.l-8}" y="${yy+4}" text-anchor="end">${val}%</text>`)}rows.forEach((r,i)=>{let cx=m.l+(i+.5)*iw/rows.length,bh=r.Cobertura/100*ih,yy=m.t+ih-bh;p.push(`<rect x="${cx-bw/2}" y="${yy}" width="${bw}" height="${bh}" rx="8" fill="${COLORS[r.Año]}"><title>${r.Año} · ${fmtPct(r.Cobertura)}</title></rect><text x="${cx}" y="${h-12}" text-anchor="middle">${r.Año}</text>`)});el.innerHTML=`<svg viewBox="0 0 ${w} ${h}" class="axis">${p.join('')}</svg>`}
  function updateKpis(){let cy=Math.max(...years),r=latestForYear(cy);if(!r)return;let prev=byYearDay(cy-1,r.Dia_Campaña),diff=r.Cobertura-(prev?prev.Cobertura:0),rows=years.map(y=>byYearDay(y,r.Dia_Campaña)).filter(Boolean),leader=rows.reduce((a,b)=>b.Cobertura>a.Cobertura?b:a,rows[0]);heroCobertura.textContent=fmtPct(r.Cobertura);heroFecha.textContent=`${r.Fecha} · día ${r.Dia_Campaña}`;kpiCobertura.textContent=fmtPct(r.Cobertura);kpiDia.textContent=`Día ${r.Dia_Campaña} · ${r.Fecha}`;kpiAcum.textContent=fmtNum.format(r.Vacunados_Acumulados);kpiBrecha.textContent=fmtNum.format(calcBrecha(r));kpiDiff.textContent=fmtPp(diff);kpiDiff.className='value '+(diff>=0?'good':'bad');kpiLeader.textContent='85%';kpiLeaderNote.textContent='Objetivo de cobertura nacional'}
  function fechaToDate(fecha,year){const meses={ene:0,feb:1,mar:2,abr:3,may:4,jun:5,jul:6,ago:7,sept:8,set:8,sep:8,oct:9,nov:10,dic:11};let parts=String(fecha||'').trim().toLowerCase().split('-');let d=parseInt(parts[0],10),m=meses[parts[1]];return new Date(year,m,d)}
  function isBusinessDate(dt){let d=dt.getDay();return d!==0&&d!==6}
  function businessRows(y,n){let rows=rowsForYear(y).filter(r=>isBusinessDate(fechaToDate(r.Fecha,y))&&(+r.Vacunados_Diarios||0)>0);return rows.slice(-n)}
  function avgBusiness(y,n){let rows=businessRows(y,n);return rows.length?rows.reduce((s,r)=>s+(+r.Vacunados_Diarios||0),0)/rows.length:0}
  function addBusinessDays(dt,days){let d=new Date(dt.getTime()),added=0;while(added<days){d.setDate(d.getDate()+1);if(isBusinessDate(d))added++}return d}
  function formatDateFull(dt){let dd=String(dt.getDate()).padStart(2,'0'),mm=String(dt.getMonth()+1).padStart(2,'0'),yy=dt.getFullYear();return `${dd}-${mm}-${yy}`}
  function projection(meta,windowDays=projectionWindow){let cy=currentYear(),r=latestForYear(cy),target=r.Poblacion_Objetivo*meta/100,pending=target-r.Vacunados_Acumulados,a=avgBusiness(cy,windowDays);if(pending<=0)return{status:'ok',date:formatDateFull(fechaToDate(r.Fecha,cy)),pending:0,days:0,avg:a};if(!a)return{status:'no',pending,avg:a};let days=Math.ceil(pending/a),projectedDate=addBusinessDays(fechaToDate(r.Fecha,cy),days);return{status:'proy',date:formatDateFull(projectedDate),days,pending,avg:a}}
  function updateProjection(){let cy=currentYear();const a3=document.getElementById("avg3");if(a3)a3.textContent=fmtNum.format(Math.round(avgBusiness(cy,3)));avg7.textContent=fmtNum.format(Math.round(avgBusiness(cy,7)));avg14.textContent=fmtNum.format(Math.round(avgBusiness(cy,14)));[[75,proj75,proj75Note],[85,proj85,proj85Note]].forEach(([m,v,n])=>{let p=projection(m);if(p.status==='ok'){v.textContent='Cumplida';v.className='v good';n.textContent=`Meta alcanzada al último dato disponible (${p.date}).`}else if(p.status==='no'){v.textContent='Sin proyección';v.className='v neutral';n.textContent='No hay promedio hábil suficiente para estimar una fecha.'}else{v.textContent=p.date;v.className='v';n.textContent=`Fecha estimada con promedio de ${projectionWindow} días hábiles (${fmtNum.format(Math.round(p.avg))} dosis/día hábil). Faltan ${fmtNum.format(Math.round(p.pending))} personas; estimación en ${p.days} días hábiles.`}})}
  function updateAdv(){
  let day=+slider.value,cy=Math.max(...years),cur=byYearDay(cy,day),body=document.querySelector('#advTable tbody');
  if(!cur||!body)return;
  const rows=years.filter(y=>y<cy).sort((a,b)=>b-a).map(y=>{
    let r=byYearDay(y,day);
    if(!r)return null;
    let diff=cur.Cobertura-r.Cobertura;
    return {year:y,base:r,cur,diff,label:`${cy} vs ${y}`};
  }).filter(Boolean);

  body.innerHTML=rows.map(x=>{
    let cls=x.diff>=0?'good':'bad';
    return `<tr>
      <td><strong>${x.label}</strong></td>
      <td class="${cls}"><strong>${fmtPp(x.diff)}</strong></td>
      <td>${fmtPct(x.base.Cobertura)}</td>
      <td>${fmtPct(x.cur.Cobertura)}</td>
    </tr>`;
  }).join('');

  renderAdvDiffChart(rows);
}

function renderAdvDiffChart(rows){
  const el = document.getElementById('advDiffChart');
  if (!el) return;

  if (!rows || !rows.length) {
    el.innerHTML = '';
    return;
  }

  const w = el.clientWidth || 620;
  const rowH = 42;
  const h = Math.max(270, rows.length * rowH + 82);

  const m = { l: 140, r: 90, t: 24, b: 42 };
  const iw = w - m.l - m.r;

  const maxAbs = Math.max(
    1,
    Math.ceil(Math.max(...rows.map(x => Math.abs(x.diff))) / 5) * 5
  );

  const X = v => m.l + ((v + maxAbs) / (maxAbs * 2)) * iw;
  const Y = i => m.t + i * rowH + rowH / 2;

  let p = [];

  for (let v = -maxAbs; v <= maxAbs; v += 5) {
    const x = X(v);
    p.push(`<line x1="${x}" x2="${x}" y1="${m.t - 8}" y2="${h - m.b}" stroke="${v === 0 ? '#0f172a' : '#dbeafe'}" stroke-width="${v === 0 ? 2.2 : 1}" ${v === 0 ? '' : 'stroke-dasharray="5 5"'}/>`);
    p.push(`<text x="${x}" y="${h - 12}" text-anchor="middle" fill="#64748b" font-size="11">${v}</text>`);
  }

  rows.forEach((r, i) => {
    const y = Y(i);
    const x0 = X(0);
    const x1 = X(r.diff);
    const x = Math.min(x0, x1);
    const bw = Math.max(2, Math.abs(x1 - x0));
    const color = r.diff >= 0 ? '#047857' : '#ef3340';

    p.push(`<text x="${m.l - 18}" y="${y + 4}" text-anchor="end" fill="#334155" font-size="12" font-weight="800">${r.label}</text>`);
    p.push(`<rect x="${x}" y="${y - 10}" width="${bw}" height="20" rx="6" fill="${color}" opacity=".95"><title>${r.label} · ${fmtPp(r.diff)}</title></rect>`);

    if (r.diff >= 0) {
      p.push(`<text x="${x1 + 8}" y="${y + 4}" text-anchor="start" style="fill:#047857 !important;" font-size="12" font-weight="950">${fmtPp(r.diff)}</text>`);
    } else {
      p.push(`<text x="${x0 - 14}" y="${y + 4}" text-anchor="end" style="fill:#ffffff !important;" font-size="12" font-weight="950">${fmtPp(r.diff)}</text>`);
    }
  });

  p.push(`<text x="${w / 2}" y="${h - 2}" text-anchor="middle" fill="#475569" font-size="12" font-weight="800">Diferencia en puntos porcentuales (p.p.)</text>`);

  el.style.height = h + 'px';
  el.innerHTML = `<svg viewBox="0 0 ${w} ${h}" class="axis">${p.join('')}</svg>`;
}
  function updateRanking(){let day=+slider.value,cy=Math.max(...years),cur=byYearDay(cy,day),body=document.querySelector('#rankTable tbody');if(!body)return;let rows=years.map(y=>byYearDay(y,day)).filter(Boolean).sort((a,b)=>b.Cobertura-a.Cobertura);body.innerHTML=rows.map((r,i)=>{let diff=cur?r.Cobertura-cur.Cobertura:0,rank=i+1,medal=rank===1?'🥇':rank===2?'🥈':rank===3?'🥉':rank+'°',cls=rank===1?'rank1':rank===2?'rank2':rank===3?'rank3':'';return `<tr class="${cls}"><td><span class="rank-badge">${medal}</span></td><td><strong>${r.Año}</strong></td><td>${r.Fecha}</td><td><strong>${fmtPct(r.Cobertura)}</strong></td><td>${fmtNum.format(r.Vacunados_Acumulados)}</td><td>${r.Año===cy?'<span class="subtle">Año actual</span>':fmtPp(diff)}</td></tr>`}).join('')}
  function monthToNumber(abbr){const m={ene:'01',feb:'02',mar:'03',abr:'04',may:'05',jun:'06',jul:'07',ago:'08',sept:'09',sep:'09',oct:'10',nov:'11',dic:'12'};return m[String(abbr||'').toLowerCase().replace('.','')]||''}
  function numberToMonth(n){const m={1:'ene',2:'feb',3:'mar',4:'abr',5:'may',6:'jun',7:'jul',8:'ago',9:'sept',10:'oct',11:'nov',12:'dic'};return m[+n]||''}
  function fechaToNumeric(fecha){let [d,m]=String(fecha||'').split('-');let mm=monthToNumber(m);return d&&mm?`${String(d).padStart(2,'0')}-${mm}`:''}
function normalizeFechaInput(v){
  let x = String(v || '')
    .trim()
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g,'')
    .replace(/[\/\.\s]+/g,'-')
    .replace(/-+/g,'-');

  // Permite formato móvil sin guion: 1906 = 19-06
  let compact = x.replace(/\D/g, '');
  if (compact.length === 4) {
    x = compact.slice(0,2) + '-' + compact.slice(2,4);
  }

  let m = x.match(/^(\d{1,2})-(\d{1,2})$/);
  if(m){
    let d = String(+m[1]).padStart(2,'0');
    let mo = numberToMonth(+m[2]);
    return mo ? `${d}-${mo}` : '';
  }

  m = x.match(/^(\d{1,2})-([a-z]+)$/);
  if(m){
    let d = String(+m[1]).padStart(2,'0');
    let token = m[2];
    let aliases = {
      marzo:'mar', abril:'abr', mayo:'may', junio:'jun',
      julio:'jul', agosto:'ago', septiembre:'sept',
      setiembre:'sept', octubre:'oct', noviembre:'nov', diciembre:'dic'
    };
    let mo = aliases[token] || (token.slice(0,4)==='sept' ? 'sept' : token.slice(0,3));
    if(monthToNumber(mo)) return `${d}-${mo}`;
  }

  return '';
}
  function syncDateInput(row){let input=document.getElementById('dateInput'),status=document.getElementById('dateStatus');if(input&&row&&document.activeElement!==input)input.value=fechaToNumeric(row.Fecha);if(status&&row)status.textContent=`Fecha seleccionada: ${row.Fecha}`}
  function goToDateInput(){let input=document.getElementById('dateInput'),status=document.getElementById('dateStatus');let norm=normalizeFechaInput(input?input.value:'');if(!norm){if(status)status.textContent='Ingresa una fecha válida, por ejemplo 31-07.';return}let cy=Math.max(...years);let row=DATA.find(d=>d.Grupo===group&&d.Año===cy&&d.Fecha===norm)||DATA.find(d=>d.Grupo===group&&d.Fecha===norm);if(!row){if(status)status.textContent='Fecha no encontrada en la base disponible.';return}slider.value=row.Dia_Campaña;updateDay()}
  function setupDateControls(){let input=document.getElementById('dateInput'),btn=document.getElementById('dateGo');if(btn)btn.onclick=goToDateInput;if(input)input.addEventListener('keydown',e=>{if(e.key==='Enter')goToDateInput()})}
  function updateDay(){let day=+slider.value,rows=years.map(y=>byYearDay(y,day)).filter(Boolean);selectedDay.textContent=day;selectedDate.textContent=rows[0]?rows[0].Fecha:'--';syncDateInput(rows[0]);document.querySelector('#compareTable tbody').innerHTML=rows.map(r=>`<tr><td><span class="pill">${r.Año}</span></td><td>${r.Fecha}</td><td><strong>${fmtPct(r.Cobertura)}</strong></td><td>${fmtNum.format(r.Vacunados_Acumulados)}</td><td>${fmtNum.format(r.Vacunados_Diarios)}</td><td>${fmtNum.format(calcBrecha(r))}</td></tr>`).join('');barChart(rows.filter(r=>selectedYears.includes(r.Año)));let cy=Math.max(...years),cur=rows.find(r=>r.Año===cy),prev=rows.find(r=>r.Año===cy-1),best=rows.reduce((a,b)=>b.Cobertura>a.Cobertura?b:a,rows[0]);if(cur&&prev&&best){let diff=cur.Cobertura-prev.Cobertura;quickRead.innerHTML=`Al día <strong>${day}</strong> (${cur.Fecha}), <strong>${cy}</strong> registra <strong>${fmtPct(cur.Cobertura)}</strong> y <strong>${fmtNum.format(cur.Vacunados_Acumulados)}</strong> personas vacunadas. La diferencia frente a ${cy-1} es <strong class="${diff>=0?'good':'bad'}">${fmtPp(diff)}</strong>. La brecha estimada para alcanzar la meta de 85% es de <strong>${fmtNum.format(calcBrecha(cur))}</strong> personas.`}updateAdv();updateRanking();updateProjection();updatePace();lineChart();velocityChart()}


  function groupCoverageStatus(v){
    if(v>=85) return {cls:'oi-status-ok', label:'Meta 85% alcanzada'};
    if(v>=75) return {cls:'oi-status-mid', label:'Entre 75% y 84,9%'};
    return {cls:'oi-status-low', label:'Bajo 75%'};
  }

  function renderGroupCoverageSummary(rows){
    const el=document.getElementById('groupCoverageSummary');
    if(!el) return;
    if(!rows.length){
      el.innerHTML='No se encontraron datos en <strong>Cobertura_Grupos.csv</strong>. Verifica que el archivo exista y mantenga las columnas Grupo y Cobertura.';
      return;
    }
    const total=rows.length;
    const ok=rows.filter(r=>r.Cobertura>=85).length;
    const mid=rows.filter(r=>r.Cobertura>=75&&r.Cobertura<85).length;
    const low=rows.filter(r=>r.Cobertura<75).length;
    const lowest=[...rows].sort((a,b)=>a.Cobertura-b.Cobertura).slice(0,3);
    const highest=rows.slice(0,3);
    el.innerHTML=`De <strong>${total}</strong> grupos priorizados, <strong>${ok}</strong> alcanzan la meta programática de campaña (85%), <strong>${mid}</strong> se ubican entre 75% y 84,9%, y <strong>${low}</strong> permanecen bajo 75%. Los mayores avances corresponden a <strong>${highest.map(x=>`${x.Grupo} (${fmtPct(x.Cobertura)})`).join(', ')}</strong>. Los grupos con menor cobertura son <strong>${lowest.map(x=>`${x.Grupo} (${fmtPct(x.Cobertura)})`).join(', ')}</strong>.`;
  }

  function renderGroupCoverageTable(rows){
    const body=document.querySelector('#groupCoverageTable tbody');
    if(!body) return;
    body.innerHTML=rows.map(r=>{
      const st=groupCoverageStatus(r.Cobertura);
      const gp=getGroupProfile(r.Grupo);
      return `<tr><td><strong><span style="color:${gp.color}">${gp.icon}</span> ${r.Grupo}</strong></td><td><strong>${fmtPct(r.Cobertura)}</strong></td><td><span class="oi-status-pill ${st.cls}">${st.label}</span></td></tr>`;
    }).join('');
  }

  function renderGroupCoverageChart(rows){
    const el=document.getElementById('groupCoverageChart');
    if(!el) return;
    if(!rows.length){
      el.innerHTML='<div class="warning-note">No hay datos disponibles para graficar cobertura por grupo objetivo.</div>';
      return;
    }

    const w=el.clientWidth||980;
    const rowH=34;
    const h=Math.max(360, rows.length*rowH+70);
    el.style.height=h+'px';
    const m={l:250,r:72,t:26,b:34};
    const iw=w-m.l-m.r;
    const maxVal=Math.max(100, Math.ceil(Math.max(...rows.map(r=>r.Cobertura))/10)*10);
    const X=v=>m.l+(v/maxVal)*iw;
    const Y=i=>m.t+i*rowH+rowH/2;
    let p=[];

    for(let v=0; v<=maxVal; v+=10){
      const x=X(v);
      p.push(`<line class="gridline" x1="${x}" x2="${x}" y1="${m.t-8}" y2="${h-m.b}"/>`);
      p.push(`<text x="${x}" y="${h-12}" text-anchor="middle" fill="#64748b" font-size="11">${v}%</text>`);
    }

    [[75,'#ef3340','Meta 75%'],[85,'#047857','Meta 85%']].forEach(([v,color,label])=>{
      const x=X(v);
      p.push(`<line x1="${x}" x2="${x}" y1="${m.t-12}" y2="${h-m.b}" stroke="${color}" stroke-width="2.4" stroke-dasharray="6 5"/>`);
      p.push(`<text x="${x+4}" y="${m.t-14}" fill="${color}" font-size="11" font-weight="900">${label}</text>`);
    });

    rows.forEach((r,i)=>{
      const y=Y(i);
      const barW=Math.max(2, X(r.Cobertura)-m.l);
      const st=groupCoverageStatus(r.Cobertura);
      let fill = r.Cobertura>=85 ? '#047857' : (r.Cobertura>=75 ? '#f59e0b' : '#ef3340');
      p.push(`<text x="${m.l-12}" y="${y+4}" text-anchor="end" fill="#334155" font-size="12" font-weight="800">${r.Grupo}</text>`);
      p.push(`<rect x="${m.l}" y="${y-10}" width="${barW}" height="20" rx="8" fill="${fill}" opacity=".88"><title>${r.Grupo} · ${fmtPct(r.Cobertura)} · ${st.label}</title></rect>`);
      p.push(`<text x="${Math.min(X(r.Cobertura)+8,w-6)}" y="${y+4}" fill="#0f172a" font-size="12" font-weight="950">${fmtPct(r.Cobertura)}</text>`);
    });

    el.innerHTML=`<svg viewBox="0 0 ${w} ${h}" class="axis" preserveAspectRatio="none">${p.join('')}</svg>`;
  }

  function setupGroupCoverageToggle(){
    const chartBtn=document.getElementById('groupCoverageChartBtn');
    const tableBtn=document.getElementById('groupCoverageTableBtn');
    const chartWrap=document.getElementById('groupCoverageChartWrap');
    const tableWrap=document.getElementById('groupCoverageTableWrap');
    if(!chartBtn||!tableBtn||!chartWrap||!tableWrap) return;

    chartBtn.onclick=()=>{
      chartBtn.classList.add('active');
      tableBtn.classList.remove('active');
      chartWrap.style.display='block';
      tableWrap.style.display='none';
      renderGroupCoveragePanel();
    };
    tableBtn.onclick=()=>{
      tableBtn.classList.add('active');
      chartBtn.classList.remove('active');
      chartWrap.style.display='none';
      tableWrap.style.display='block';
    };
  }

  function nationalGroupRowsFromDashboard(){
    if(!DATA.length || !years.length) return [];
    const cy=currentYear();
    const norm=s=>String(s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/\s+/g,' ').trim();
    const groups=[...new Set(DATA.filter(d=>d.Año===cy).map(d=>d.Grupo).filter(Boolean))]
      .filter(g=>norm(g)!=='total' && norm(g)!=='todos los grupos');

    return groups.map(g=>{
      const row=DATA
        .filter(d=>d.Año===cy && d.Grupo===g && ((+d.Cobertura||0)>0 || (+d.Vacunados_Acumulados||0)>0))
        .sort((a,b)=>a.Dia_Campaña-b.Dia_Campaña)
        .at(-1);
      if(!row) return null;
      return {
        Grupo:g,
        Cobertura:+row.Cobertura||0,
        Vacunados:+row.Vacunados_Acumulados||0,
        Poblacion_Objetivo:+row.Poblacion_Objetivo||0,
        Fecha:row.Fecha||'',
        Dia_Campaña:+row.Dia_Campaña||0
      };
    }).filter(Boolean).sort((a,b)=>b.Cobertura-a.Cobertura);
  }

  function renderGroupCoveragePanel(){
    /*
      Este panel es independiente del selector superior.
      Debe alimentarse exclusivamente desde Cobertura_Grupos.csv, porque resume
      el avance nacional por grupo objetivo y no una serie histórica filtrada.
    */
    const rows=[...GROUP_COVERAGE_DATA].sort((a,b)=>b.Cobertura-a.Cobertura);
    renderGroupCoverageSummary(rows);
    renderGroupCoverageTable(rows);
    renderGroupCoverageChart(rows);
  }

  

/* V5.7 · Tabla histórica al mismo día de campaña con selector de día/fecha */
let historicalGroupsDay = null;
let historicalGroupsControlsReady = false;

function findGroupNameByAliases(aliases){
  const groups=[...new Set(DATA.map(d=>d.Grupo).filter(Boolean))];
  const norm=s=>String(s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/\s+/g,' ').trim();
  const normalizedAliases=aliases.map(norm);
  return groups.find(g=>normalizedAliases.includes(norm(g))) ||
         groups.find(g=>normalizedAliases.some(a=>norm(g).includes(a))) ||
         groups.find(g=>normalizedAliases.some(a=>a.includes(norm(g)))) ||
         aliases[0];
}

function setupHistoricalGroupsControls(totalGroup){
  if(historicalGroupsControlsReady) return;
  historicalGroupsControlsReady = true;

  const dayInput=document.getElementById('histDayInput');
  const dateInput=document.getElementById('histDateInput');
  const dateGo=document.getElementById('histDateGo');
  const status=document.getElementById('histStatus');
  const cy=currentYear();
  const maxActual=actualMaxDay(cy) || maxDay();

  if(dayInput){
    dayInput.max=maxActual;
    dayInput.addEventListener('input',()=>{
      let v=Math.round(Number(dayInput.value)||0);
      if(!v) return;
      if(v<1) v=1;
      if(v>maxActual){
        v=maxActual;
        dayInput.value=v;
        if(status) status.textContent=`El día ingresado supera el último día disponible 2026; se usó el día ${maxActual}.`;
      }
      historicalGroupsDay=v;
      updateHistoricalGroupsTable();
    });
  }

  function goToHistoricalDate(){
    if(!dateInput) return;
    const norm=normalizeFechaInput(dateInput.value);
    if(!norm){
      if(status) status.textContent='Ingresa una fecha válida, por ejemplo 1906 o 19-06.';
      return;
    }
    const row=DATA.find(d=>d.Año===cy && d.Grupo===totalGroup && d.Fecha===norm && d.Dia_Campaña<=maxActual)
           || DATA.find(d=>d.Año===cy && d.Fecha===norm && d.Dia_Campaña<=maxActual);
    if(!row){
      if(status) status.textContent=`No hay dato disponible para ${norm} en 2026.`;
      return;
    }
    historicalGroupsDay=row.Dia_Campaña;
    if(dayInput) dayInput.value=historicalGroupsDay;
    updateHistoricalGroupsTable();
  }

  if(dateGo) dateGo.onclick=goToHistoricalDate;
  if(dateInput){
    dateInput.addEventListener('keydown',e=>{ if(e.key==='Enter') goToHistoricalDate(); });
    dateInput.addEventListener('input',()=>{
      const compact=String(dateInput.value||'').replace(/\D/g,'');
      if(compact.length===4) goToHistoricalDate();
    });
  }
}

function updateHistoricalGroupsTable(){
  const table=document.getElementById('historicalGroupsTable');
  const body=document.querySelector('#historicalGroupsTable tbody');
  const head=document.querySelector('#historicalGroupsTable thead tr');
  const source=document.getElementById('historicalGroupsSource');
  const dayInput=document.getElementById('histDayInput');
  const dateInput=document.getElementById('histDateInput');
  const status=document.getElementById('histStatus');
  if(!table || !body || !DATA.length || !years.length) return;

  const cy=currentYear();
  const totalGroup=findGroupNameByAliases(['Total','Todos los grupos']);
  const norm=s=>String(s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/\s+/g,' ').trim();

  const availableGroups=[...new Set(DATA.map(d=>d.Grupo).filter(Boolean))];
  const orderedGroups=[
    totalGroup,
    ...availableGroups.filter(g=>norm(g)!==norm(totalGroup) && norm(g)!=='total' && norm(g)!=='todos los grupos')
  ];

  setupHistoricalGroupsControls(totalGroup);

  const maxActual=actualMaxDay(cy) || maxDay();
  const latestRow = DATA
    .filter(d=>d.Año===cy && d.Grupo===totalGroup && d.Dia_Campaña<=maxActual && ((+d.Cobertura||0)>0 || (+d.Vacunados_Acumulados||0)>0))
    .sort((a,b)=>a.Dia_Campaña-b.Dia_Campaña)
    .at(-1) || latestForYear(cy);

  if(!latestRow) return;

  if(!historicalGroupsDay) historicalGroupsDay = latestRow.Dia_Campaña;
  if(historicalGroupsDay>maxActual) historicalGroupsDay=maxActual;
  if(historicalGroupsDay<1) historicalGroupsDay=1;

  const day=historicalGroupsDay;
  const refRow = DATA.find(d=>d.Año===cy && d.Grupo===totalGroup && d.Dia_Campaña===day)
              || DATA.find(d=>d.Año===cy && d.Dia_Campaña===day)
              || latestRow;

  if(dayInput){
    dayInput.max=maxActual;
    if(document.activeElement!==dayInput) dayInput.value=day;
  }
  if(dateInput && refRow && document.activeElement!==dateInput){
    dateInput.value=fechaToNumeric(refRow.Fecha);
  }

  const getCoverage=(year, groupName)=>{
    if(year===cy && day>maxActual) return '--';
    const row = DATA.find(d=>d.Año===year && d.Grupo===groupName && d.Dia_Campaña===day);
    return row ? fmtPct(row.Cobertura) : '--';
  };

  if(head){
    head.innerHTML = `<th>Año</th>${orderedGroups.map(g=>`<th>${g}</th>`).join('')}`;
  }

  body.innerHTML = years.map(y=>`
    <tr>
      <td>${y}</td>
      ${orderedGroups.map(g=>`<td>${getCoverage(y,g)}</td>`).join('')}
    </tr>
  `).join('');

  const minWidth=Math.max(620, 120 + orderedGroups.length*170);
  table.style.minWidth=minWidth+'px';

  if(source){
    source.textContent = `Fuente: DEIS, datos al ${refRow.Fecha}. Comparación al día ${day} de campaña.`;
  }
  if(status){
    status.textContent = `Mostrando comparación histórica para el día ${day} de campaña (${refRow.Fecha}). Grupos incluidos: ${orderedGroups.join(', ')}.`;
  }
}

function drawAll(){updateKpis();updateDay();renderGroupCoveragePanel();updateHistoricalGroupsTable()}
  function startObservatorioInfluenza(){
    Promise.all([loadDashboardData(), loadGroupCoverageData(), loadRegionCoverageData(), loadServiceCoverageData()]).then(init).catch(error => {
      console.error(error);
      const wrap = document.querySelector('.wrap');
      if (wrap) {
        wrap.insertAdjacentHTML('afterbegin', `<div class="warning-note"><strong>No fue posible cargar los datos del observatorio.</strong><br>${error.message}</div>`);
      }
    });
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', startObservatorioInfluenza);
  } else {
    startObservatorioInfluenza();
  }
  
  
  
  function businessDaysRemaining(y){
    /*
      Para el panel de ritmo se debe considerar el horizonte completo disponible
      en la base del año 2026, no solo los días con datos ya registrados.
      Por eso se usa rawRowsForYear(y) como calendario de campaña.
    */
    const allRows=rawRowsForYear(y), last=latestForYear(y), end=allRows.at(-1);
    if(!last||!end) return 0;
    let d=fechaToDate(last.Fecha,y), endDt=fechaToDate(end.Fecha,y), n=0;
    while(d<endDt){
      d.setDate(d.getDate()+1);
      if(isBusinessDate(d)) n++;
    }
    return n;
  }
  function requiredDailyPace(r,metaPct,daysLeft){
    if(!r) return 0;
    const target=Math.round((+r.Poblacion_Objetivo||0)*metaPct/100);
    const pending=Math.max(0,target-(+r.Vacunados_Acumulados||0));
    if(pending<=0) return 0;
    if(daysLeft<=0) return null;
    return pending/daysLeft;
  }
  function coverageComparisonSentence(diffCoverage, baseYear){
    if(diffCoverage === null || diffCoverage === undefined || !Number.isFinite(diffCoverage)){
      return 'No hay comparación de cobertura disponible respecto del año anterior para el mismo día de campaña.';
    }
    const absDiff = fmtDec.format(Math.abs(diffCoverage));
    if(Math.abs(diffCoverage) < 0.005){
      return `La cobertura acumulada se mantiene equivalente a ${baseYear} para el mismo día de campaña.`;
    }
    return `No obstante, la cobertura acumulada continúa ${absDiff} p.p. ${diffCoverage>=0?'por sobre':'por debajo de'} ${baseYear} para el mismo día de campaña.`;
  }

  function paceStatus(avg3,avg7,avg14,required,pending,daysLeft,diffCoverage,baseYear){
    const comparison = coverageComparisonSentence(diffCoverage, baseYear);
    if(pending<=0) return {badge:'good',text:'Meta alcanzada',note:`La meta programática de 85% ya se encuentra alcanzada al último dato disponible. ${comparison}`};
    if(daysLeft<=0) return {badge:'bad',text:'Sin días hábiles',note:`Aún faltan ${fmtNum.format(Math.round(pending))} personas para la meta 85%, pero no quedan días hábiles en el calendario cargado. ${comparison}`};
    if(!avg7||!required) return {badge:'warn',text:'En progreso',note:`Faltan ${fmtNum.format(Math.round(pending))} personas para alcanzar la meta 85%. No hay promedio hábil suficiente para evaluar el ritmo. ${comparison}`};
    const ratio=avg7/required;
    if(ratio>=1.05) return {
      badge:'good',
      text:'Ritmo actual suficiente',
      note:`El promedio hábil de los últimos 7 días (${fmtNum.format(Math.round(avg7))} dosis/día) supera el ritmo requerido para alcanzar la meta 85% (${fmtNum.format(Math.round(required))} dosis/día). ${comparison}`
    };
    if(ratio>=0.85) return {
      badge:'warn',
      text:'Ritmo ajustado',
      note:`El promedio hábil de los últimos 7 días (${fmtNum.format(Math.round(avg7))} dosis/día) se encuentra cercano al ritmo requerido para alcanzar la meta 85% (${fmtNum.format(Math.round(required))} dosis/día). ${comparison}`
    };
    return {
      badge:'bad',
      text:'Ritmo insuficiente',
      note:`El promedio hábil de los últimos 7 días (${fmtNum.format(Math.round(avg7))} dosis/día) se encuentra por debajo del ritmo requerido para alcanzar la meta 85% (${fmtNum.format(Math.round(required))} dosis/día). ${comparison}`
    };
  }
  function updatePace(){
    const cy=currentYear(), day=+slider.value, r=byYearDay(cy,day)||latestForYear(cy);
    if(!r) return;
    const a3=avgBusiness(cy,3), a7=avgBusiness(cy,7), a14=avgBusiness(cy,14);
    const pending85=calcBrecha(r,85);
    const daysLeft=businessDaysRemaining(cy);
    const req85=requiredDailyPace(r,85,daysLeft);
    const prev=byYearDay(cy-1,day);const diffCoverage=prev?(r.Cobertura-prev.Cobertura):null;const st=paceStatus(a3,a7,a14,req85,pending85,daysLeft,diffCoverage,cy-1);
    const set=(id,v)=>{const el=document.getElementById(id); if(el) el.textContent=v};
    set('paceAvg3', fmtNum.format(Math.round(a3)));
    set('paceAvg7', fmtNum.format(Math.round(a7)));
    set('paceAvg14', fmtNum.format(Math.round(a14)));
    set('paceRequired85', pending85<=0 ? 'Meta alcanzada' : (req85===null ? 'Sin plazo' : fmtNum.format(Math.round(req85))));
    set('paceRequired85Note', pending85<=0 ? 'Meta 85% alcanzada al último dato disponible' : (req85===null ? `Faltan ${fmtNum.format(Math.round(pending85))} personas para la meta 85%; no quedan días hábiles en el calendario cargado` : `Meta 85% · ${daysLeft} días hábiles restantes estimados · faltan ${fmtNum.format(Math.round(pending85))} personas`));
    const badge=document.getElementById('paceBadge');
    if(badge){badge.textContent=st.text; badge.className='pace-badge '+st.badge}
    set('paceStatusText', `${fmtPct(r.Cobertura)} de cobertura al ${r.Fecha}`);
    set('paceStatusNote', st.note);
    set('paceCompare', prev?`${cy}: ${fmtNum.format(r.Vacunados_Diarios)} dosis/día vs ${cy-1}: ${fmtNum.format(prev.Vacunados_Diarios)} · Diferencia cobertura: ${fmtPp(r.Cobertura-prev.Cobertura)}`:'Sin comparación disponible para el día seleccionado.');
  }function movingAvgSeries(y,n){const rows=rowsForYear(y), out=[];rows.forEach((r,i)=>{const slice=rows.slice(0,i+1).filter(x=>isBusinessDate(fechaToDate(x.Fecha,y))&&(+x.Vacunados_Diarios||0)>0).slice(-n);const val=slice.length?slice.reduce((s,x)=>s+(+x.Vacunados_Diarios||0),0)/slice.length:0;out.push({day:r.Dia_Campaña,val});});return out;}function setVelocitySliderFromMain(){const vs=document.getElementById('velocitySlider');if(!vs)return;vs.max=maxDay();vs.value=slider.value;updateVelocityLabel();}function updateVelocityLabel(){const vs=document.getElementById('velocitySlider'),vd=document.getElementById('velocityDay'),vf=document.getElementById('velocityDate');if(!vs||!vd||!vf)return;const day=+vs.value;const row=byYearDay(currentYear(),day)||DATA.find(d=>d.Grupo===group&&d.Dia_Campaña===day);vd.textContent=day;vf.textContent=row?row.Fecha:'--';}function setupVelocityControls() {const vs = document.getElementById('velocitySlider');const input = document.getElementById('velocityDateInput');const btn = document.getElementById('velocityDateGo');const status = document.getElementById('velocityDateStatus');if (!vs) return;vs.max = maxDay();vs.value = slider.value;vs.oninput = () => {updateVelocityLabel();velocityChart();};function goToVelocityDate() {if (!input) return;const target = normalizeFechaInput(input.value);if (!target) {if (status) status.textContent = 'Usa formato dd-mm, por ejemplo 31-07.';return;}const row = DATA.find(d =>d.Grupo === group &&+d.Año === currentYear() &&d.Fecha === target);if (!row) {if (status) status.textContent = `No hay dato 2026 para ${target}.`;return;}vs.value = row.Dia_Campaña;updateVelocityLabel();velocityChart();if (status) status.textContent = `Mostrando ${target} · día ${row.Dia_Campaña}.`;}if (btn) btn.onclick = goToVelocityDate;if (input) {input.onkeydown = e => {if (e.key === 'Enter') goToVelocityDate();};}updateVelocityLabel();}function velocityChart(){const el=document.getElementById('velocityChart');if(!el)return;let w=el.clientWidth||520,h=el.clientHeight||320,m={l:58,r:18,t:18,b:38},iw=w-m.l-m.r,ih=h-m.t-m.b;let labels=[...new Set(DATA.filter(d=>d.Grupo===group).map(d=>d.Dia_Campaña))].sort((a,b)=>a-b),minD=Math.min(...labels),maxD=Math.max(...labels);let vals=[];selectedYears.forEach(y=>rowsForYear(y).forEach(r=>vals.push(r.Vacunados_Diarios||0)));const cy=currentYear(), ma3=movingAvgSeries(cy,3), ma7=movingAvgSeries(cy,7), ma14=movingAvgSeries(cy,14);[...ma3,...ma7,...ma14].forEach(p=>vals.push(p.val||0));let ymax=niceMax(Math.max(...vals,1)),X=d=>m.l+(d-minD)/(maxD-minD||1)*iw,Y=v=>m.t+ih-(v/ymax)*ih,p=[];for(let i=0;i<=4;i++){let val=ymax*i/4,yy=Y(val);p.push(`<line class="gridline" x1="${m.l}" x2="${w-m.r}" y1="${yy}" y2="${yy}"/><text x="${m.l-8}" y="${yy+4}" text-anchor="end">${fmtNum.format(Math.round(val))}</text>`)}[minD,Math.round(maxD*.25),Math.round(maxD*.5),Math.round(maxD*.75),maxD].forEach(d=>p.push(`<text x="${X(d)}" y="${h-12}" text-anchor="middle">${d}</text>`));selectedYears.forEach(yr=>{let pts=rowsForYear(yr).map(r=>`${X(r.Dia_Campaña)},${Y(r.Vacunados_Diarios||0)}`).join(' ');p.push(`<polyline class="line" points="${pts}" stroke="${COLORS[yr]}" stroke-width="${yr===cy?3.4:2}" opacity="${yr===cy?1:.72}" fill="none"/>`)});if(selectedYears.includes(cy)){[[ma3,'#047857',2.2,'3.4 2.4'],[ma7,'#b45309',2,'5 3'],[ma14,'#075985',2,'6 4']].forEach(([series,color,w,dash])=>{let pts=series.filter(x=>x.val>0).map(x=>`${X(x.day)},${Y(x.val)}`).join(' ');if(pts) p.push(`<polyline points="${pts}" stroke="${color}" stroke-width="${w}" stroke-dasharray="${dash}" fill="none" opacity=".92"/>`);});}const vs=document.getElementById('velocitySlider');let day=vs?+vs.value:+slider.value;p.push(`<line class="sel" x1="${X(day)}" x2="${X(day)}" y1="${m.t}" y2="${h-m.b}"/>`);selectedYears.forEach(yr=>{let r=byYearDay(yr,day);if(r)p.push(`<circle cx="${X(day)}" cy="${Y(r.Vacunados_Diarios||0)}" r="4" fill="${COLORS[yr]}" stroke="#fff" stroke-width="1.5"><title>${yr} · ${r.Fecha} · ${fmtNum.format(r.Vacunados_Diarios)} dosis</title></circle>`)});el.innerHTML=`<svg viewBox="0 0 ${w} ${h}" class="axis">${p.join('')}<text x="${w/2}" y="${h-1}" text-anchor="middle" fill="#64748b" font-size="12" font-weight="800">Día de campaña</text><text x="16" y="${h/2}" text-anchor="middle" transform="rotate(-90 16 ${h/2})" fill="#64748b" font-size="12" font-weight="800">Vacunados diarios</text><rect x="0" y="0" width="${w}" height="${h}" fill="transparent" id="velHoverArea"/></svg>`;const hover=el.querySelector('#velHoverArea');if(hover){hover.onmousemove=e=>{let rect=el.querySelector('svg').getBoundingClientRect(),px=e.clientX-rect.left,d=Math.max(minD,Math.min(maxD,Math.round(minD+(px-m.l)/iw*(maxD-minD))));let rows=selectedYears.map(y=>byYearDay(y,d)).filter(Boolean);const m3=ma3.find(x=>x.day===d)?.val||0,m7=ma7.find(x=>x.day===d)?.val||0,m14=ma14.find(x=>x.day===d)?.val||0;tip.style.display='block';tip.style.left=e.clientX+12+'px';tip.style.top=e.clientY+12+'px';tip.innerHTML='<div class="tip-head"><strong>Día '+d+' · Velocidad diaria</strong></div>'+rows.sort((a,b)=>b.Año-a.Año).map(r=>'<div class="tip-row"><span><i class="dot" style="background:'+COLORS[r.Año]+'"></i><strong>'+r.Año+'</strong></span><span class="muted">'+r.Fecha+'</span><span><strong>'+fmtNum.format(r.Vacunados_Diarios)+'</strong></span></div>').join('')+(selectedYears.includes(cy)?'<div class="muted" style="margin-top:6px">Prom. hábil 2026 · 3d: '+fmtNum.format(Math.round(m3))+' · 7d: '+fmtNum.format(Math.round(m7))+' · 14d: '+fmtNum.format(Math.round(m14))+'</div>':'');};hover.onmouseleave=()=>tip.style.display='none'}updateVelocityLabel();}const originalUpdateDayV44=updateDay;updateDay=function(){originalUpdateDayV44();setVelocitySliderFromMain();};const originalResetV44=reset;reset=function(){originalResetV44();setVelocitySliderFromMain();};function trendText(shortAvg,longAvg){if(!longAvg)return 'Sin dato suficiente';const diff=(shortAvg-longAvg)/longAvg*100;return `${diff>=0?'+':''}${fmtDec.format(diff)}% ${diff>=0?'sobre':'bajo'} promedio 14 días hábiles`;}
/* =========================
   V5.1 · Módulos ejecutivos
   - Meta dinámica 75/80/85/90
   - Velocímetro de cumplimiento
   - Ranking histórico
   - Mejor/peor semana
   - Evolución semanal
   ========================= */
let targetMeta = 85;

calcBrecha = function(r, meta = targetMeta){
  if(!r) return 0;
  return Math.max(0, Math.round((r.Poblacion_Objetivo||0)*meta/100 - (r.Vacunados_Acumulados||0)));
};

function setupTargetMetaControl(){
  const sel = document.getElementById('targetMetaSelect');
  if(!sel) return;
  sel.value = String(targetMeta);
  sel.onchange = () => {
    targetMeta = Number(sel.value) || 85;
    updateTargetMetaUI();
    drawAll();
  };
  updateTargetMetaUI();
}

function updateTargetMetaUI(){
  const metaLabels = document.querySelectorAll('[data-meta-label]');
  metaLabels.forEach(el => el.textContent = `${targetMeta}%`);
  const compareHead = document.getElementById('compareBrechaHead');
  if(compareHead) compareHead.textContent = `Brecha meta ${targetMeta}%`;
}

function axisMax(v){
  let p=Math.pow(10,Math.floor(Math.log10(Math.max(1,v))));
  return Math.ceil(v/p)*p;
}

function lineChart(){
  let el=document.getElementById('mainChart'),w=el.clientWidth||900,h=el.clientHeight||430,m={l:58,r:24,t:22,b:42},iw=w-m.l-m.r,ih=h-m.t-m.b;
  let labels=[...new Set(DATA.filter(d=>d.Grupo===group).map(d=>d.Dia_Campaña))].sort((a,b)=>a-b),minD=Math.min(...labels),maxD=Math.max(...labels);
  let all=[];selectedYears.forEach(y=>rowsForYear(y).forEach(r=>all.push(metricValue(r,metric))));if(metric==='Cobertura')all.push(targetMeta);
  let ymax=niceMax(Math.max(...all,1));let X=d=>m.l+(d-minD)/(maxD-minD||1)*iw,Y=v=>m.t+ih-(v/ymax)*ih,p=[];
  for(let i=0;i<=5;i++){let val=ymax*i/5,yy=Y(val);p.push(`<line class="gridline" x1="${m.l}" x2="${w-m.r}" y1="${yy}" y2="${yy}"/><text x="${m.l-10}" y="${yy+4}" text-anchor="end">${metric==='Cobertura'?Math.round(val)+'%':fmtNum.format(Math.round(val))}</text>`)}
  [minD,Math.round(maxD*.25),Math.round(maxD*.5),Math.round(maxD*.75),maxD].forEach(d=>p.push(`<text x="${X(d)}" y="${h-14}" text-anchor="middle">${d}</text>`));
  selectedYears.forEach(yr=>{let pts=rowsForYear(yr).map(r=>`${X(r.Dia_Campaña)},${Y(metricValue(r,metric))}`).join(' ');p.push(`<polyline class="line" points="${pts}" stroke="${COLORS[yr]}" stroke-width="${yr===Math.max(...years)?4:2.4}" opacity="${yr===Math.max(...years)?1:.78}"/>`)});
  if(metric==='Cobertura'){
    p.push(`<line class="meta" x1="${m.l}" x2="${w-m.r}" y1="${Y(targetMeta)}" y2="${Y(targetMeta)}" stroke-width="2"/><text x="${w-m.r-4}" y="${Y(targetMeta)-8}" text-anchor="end" fill="#111827" font-weight="800" font-size="12">Meta ${targetMeta}%</text>`)
  }
  let day=+slider.value;p.push(`<line class="sel" x1="${X(day)}" x2="${X(day)}" y1="${m.t}" y2="${h-m.b}"/>`);
  selectedYears.forEach(yr=>{let r=byYearDay(yr,day);if(r)p.push(`<circle cx="${X(day)}" cy="${Y(metricValue(r,metric))}" r="5" fill="${COLORS[yr]}" stroke="#fff" stroke-width="2"><title>${yr} · ${r.Fecha} · ${fmtPct(r.Cobertura)}</title></circle>`)});
  el.innerHTML=`<svg viewBox="0 0 ${w} ${h}" class="axis"><g>${p.join('')}</g><text x="${w/2}" y="${h-2}" text-anchor="middle" fill="#64748b" font-size="12" font-weight="800">Día de campaña</text><text x="16" y="${h/2}" text-anchor="middle" transform="rotate(-90 16 ${h/2})" fill="#64748b" font-size="12" font-weight="800">${metricLabel(metric)}</text><rect x="0" y="0" width="${w}" height="${h}" fill="transparent" id="hoverArea"/></svg>`;
  el.querySelector('#hoverArea').onmousemove=e=>{let rect=el.querySelector('svg').getBoundingClientRect(),px=e.clientX-rect.left,d=Math.round(minD+(px-m.l)/iw*(maxD-minD));d=Math.max(minD,Math.min(maxD,d));let rows=selectedYears.map(y=>byYearDay(y,d)).filter(Boolean);tip.style.display='block';tip.style.left=e.clientX+12+'px';tip.style.top=e.clientY+12+'px';tip.innerHTML='<div class="tip-head"><strong>Día '+d+'</strong> · '+metricLabel(metric)+'</div>'+rows.sort((a,b)=>b.Año-a.Año).map(r=>{let mv=metricValue(r,metric),mvTxt=metric==='Cobertura'?fmtPct(mv):fmtNum.format(Math.round(mv));return '<div class="tip-row"><span><i class="dot" style="background:'+COLORS[r.Año]+'"></i><strong>'+r.Año+'</strong></span><span class="muted">'+r.Fecha+'</span><span><strong>'+mvTxt+'</strong></span></div><div class="muted" style="padding-left:18px;margin-bottom:4px">Acum: '+fmtNum.format(r.Vacunados_Acumulados)+' · Diario: '+fmtNum.format(r.Vacunados_Diarios)+' · Brecha meta '+targetMeta+'%: '+fmtNum.format(calcBrecha(r))+'</div>'}).join('')};
  el.onmouseleave=()=>tip.style.display='none';
}

function updateKpis(){
  let cy=Math.max(...years),r=latestForYear(cy);if(!r)return;let prev=byYearDay(cy-1,r.Dia_Campaña),diff=r.Cobertura-(prev?prev.Cobertura:0);
  heroCobertura.textContent=fmtPct(r.Cobertura);heroFecha.textContent=`${r.Fecha} · día ${r.Dia_Campaña}`;
  kpiCobertura.textContent=fmtPct(r.Cobertura);kpiDia.textContent=`Día ${r.Dia_Campaña} · ${r.Fecha}`;
  kpiAcum.textContent=fmtNum.format(r.Vacunados_Acumulados);kpiBrecha.textContent=fmtNum.format(calcBrecha(r));
  kpiDiff.textContent=fmtPp(diff);kpiDiff.className='value '+(diff>=0?'good':'bad');
  kpiLeader.textContent=`${targetMeta}%`;kpiLeaderNote.textContent='Meta seleccionada';
}

function projection(meta,windowDays=projectionWindow){
  let cy=currentYear(),r=latestForYear(cy),target=r.Poblacion_Objetivo*meta/100,pending=target-r.Vacunados_Acumulados,a=avgBusiness(cy,windowDays);
  if(pending<=0)return{status:'ok',date:formatDateFull(fechaToDate(r.Fecha,cy)),pending:0,days:0,avg:a};
  if(!a)return{status:'no',pending,avg:a};
  let days=Math.ceil(pending/a),projectedDate=addBusinessDays(fechaToDate(r.Fecha,cy),days);return{status:'proy',date:formatDateFull(projectedDate),days,pending,avg:a};
}

function paintProjection(meta, valueEl, noteEl){
  if(!valueEl || !noteEl) return;
  let p=projection(meta);
  if(p.status==='ok'){valueEl.textContent='Cumplida';valueEl.className='v good';noteEl.textContent=`Meta ${meta}% alcanzada al último dato disponible (${p.date}).`}
  else if(p.status==='no'){valueEl.textContent='Sin proyección';valueEl.className='v neutral';noteEl.textContent='No hay promedio hábil suficiente para estimar una fecha.'}
  else{valueEl.textContent=p.date;valueEl.className='v';noteEl.textContent=`Fecha estimada con promedio de ${projectionWindow} días hábiles (${fmtNum.format(Math.round(p.avg))} dosis/día hábil). Faltan ${fmtNum.format(Math.round(p.pending))} personas; estimación en ${p.days} días hábiles.`}
}

function updateProjection(){
  let cy=currentYear();const a3=document.getElementById('avg3');if(a3)a3.textContent=fmtNum.format(Math.round(avgBusiness(cy,3)));avg7.textContent=fmtNum.format(Math.round(avgBusiness(cy,7)));avg14.textContent=fmtNum.format(Math.round(avgBusiness(cy,14)));
  paintProjection(75, document.getElementById('proj75'), document.getElementById('proj75Note'));
  paintProjection(85, document.getElementById('proj85'), document.getElementById('proj85Note'));
  const lbl=document.getElementById('projSelectedLabel'); if(lbl) lbl.textContent=`Meta seleccionada ${targetMeta}%`;
  paintProjection(targetMeta, document.getElementById('projSelected'), document.getElementById('projSelectedNote'));
}

function paceStatus(avg3,avg7,avg14,required,pending,daysLeft,diffCoverage,baseYear){
  const comparison = coverageComparisonSentence(diffCoverage, baseYear);
  if(pending<=0) return {badge:'good',text:'Meta alcanzada',note:`La meta programática de ${targetMeta}% ya se encuentra alcanzada al último dato disponible. ${comparison}`};
  if(daysLeft<=0) return {badge:'bad',text:'Sin días hábiles',note:`Aún faltan ${fmtNum.format(Math.round(pending))} personas para la meta ${targetMeta}%, pero no quedan días hábiles en el calendario cargado. ${comparison}`};
  if(!avg7||!required) return {badge:'warn',text:'En progreso',note:`Faltan ${fmtNum.format(Math.round(pending))} personas para alcanzar la meta ${targetMeta}%. No hay promedio hábil suficiente para evaluar el ritmo. ${comparison}`};
  const ratio=avg7/required;
  if(ratio>=1.05) return {badge:'good',text:'Ritmo actual suficiente',note:`El promedio hábil de los últimos 7 días (${fmtNum.format(Math.round(avg7))} dosis/día) supera el ritmo requerido para alcanzar la meta ${targetMeta}% (${fmtNum.format(Math.round(required))} dosis/día). ${comparison}`};
  if(ratio>=0.85) return {badge:'warn',text:'Ritmo ajustado',note:`El promedio hábil de los últimos 7 días (${fmtNum.format(Math.round(avg7))} dosis/día) se encuentra cercano al ritmo requerido para alcanzar la meta ${targetMeta}% (${fmtNum.format(Math.round(required))} dosis/día). ${comparison}`};
  return {badge:'bad',text:'Ritmo insuficiente',note:`El promedio hábil de los últimos 7 días (${fmtNum.format(Math.round(avg7))} dosis/día) se encuentra por debajo del ritmo requerido para alcanzar la meta ${targetMeta}% (${fmtNum.format(Math.round(required))} dosis/día). ${comparison}`};
}

function updatePace(){
  const cy=currentYear(), day=+slider.value, r=byYearDay(cy,day)||latestForYear(cy); if(!r) return;
  const a3=avgBusiness(cy,3), a7=avgBusiness(cy,7), a14=avgBusiness(cy,14);
  const pending=calcBrecha(r,targetMeta), daysLeft=businessDaysRemaining(cy), req=requiredDailyPace(r,targetMeta,daysLeft);
  const prev=byYearDay(cy-1,day); const diffCoverage=prev?(r.Cobertura-prev.Cobertura):null; const st=paceStatus(a3,a7,a14,req,pending,daysLeft,diffCoverage,cy-1);
  const set=(id,v)=>{const el=document.getElementById(id); if(el) el.textContent=v};
  set('paceAvg3', fmtNum.format(Math.round(a3))); set('paceAvg7', fmtNum.format(Math.round(a7))); set('paceAvg14', fmtNum.format(Math.round(a14)));
  set('paceRequired85', pending<=0 ? 'Meta alcanzada' : (req===null ? 'Sin plazo' : fmtNum.format(Math.round(req))));
  set('paceRequired85Note', pending<=0 ? `Meta ${targetMeta}% alcanzada al último dato disponible` : (req===null ? `Faltan ${fmtNum.format(Math.round(pending))} personas para la meta ${targetMeta}%; no quedan días hábiles en el calendario cargado` : `Meta ${targetMeta}% · ${daysLeft} días hábiles restantes estimados · faltan ${fmtNum.format(Math.round(pending))} personas`));
  const badge=document.getElementById('paceBadge'); if(badge){badge.textContent=st.text; badge.className='pace-badge '+st.badge}
  set('paceStatusText', `${fmtPct(r.Cobertura)} de cobertura al ${r.Fecha}`); set('paceStatusNote', st.note);
  set('paceCompare', prev?`${cy}: ${fmtNum.format(r.Vacunados_Diarios)} dosis/día vs ${cy-1}: ${fmtNum.format(prev.Vacunados_Diarios)} · Diferencia cobertura: ${fmtPp(r.Cobertura-prev.Cobertura)}`:'Sin comparación disponible para el día seleccionado.');
}

function updateGauge(){
  const cy=currentYear(), day=+slider.value, r=byYearDay(cy,day)||latestForYear(cy); if(!r) return;
  const pct=Math.max(0, Math.min(100, (r.Cobertura/targetMeta)*100));
  const pending=calcBrecha(r,targetMeta);
  const set=(id,v)=>{const el=document.getElementById(id); if(el) el.textContent=v};
  set('gaugeCoverage', fmtPct(r.Cobertura)); set('gaugeMeta', `${targetMeta}%`); set('gaugePending', fmtNum.format(pending));
  const fill=document.getElementById('gaugeFill'); if(fill) fill.style.width = pct + '%';
  const label=document.getElementById('gaugePercent'); if(label) label.textContent = `${fmtDec.format(pct)}% de avance relativo a la meta`;
  const note=document.getElementById('gaugeNote'); if(note) note.textContent = pending<=0 ? `Meta ${targetMeta}% alcanzada.` : `Faltan ${fmtNum.format(pending)} personas para alcanzar la meta ${targetMeta}%.`;
}

function dateToFecha(dt){
  const months=['ene','feb','mar','abr','may','jun','jul','ago','sept','oct','nov','dic'];
  return `${String(dt.getDate()).padStart(2,'0')}-${months[dt.getMonth()]}`;
}

function startOfEpiWeek1(year){
  /*
    Semana epidemiológica tipo MMWR/OPS:
    semanas de domingo a sábado; la SE 1 es la primera semana que tiene al menos
    cuatro días dentro del año calendario.
  */
  const jan1=new Date(year,0,1);
  const dow=jan1.getDay(); // 0 domingo, 6 sábado
  const start=new Date(year,0,1);
  const offset = dow<=3 ? -dow : 7-dow;
  start.setDate(start.getDate()+offset);
  start.setHours(0,0,0,0);
  return start;
}

function epiWeekInfo(dt){
  let y=dt.getFullYear();
  let start=startOfEpiWeek1(y);
  let next=startOfEpiWeek1(y+1);
  if(dt<start){
    y=y-1;
    start=startOfEpiWeek1(y);
    next=startOfEpiWeek1(y+1);
  }else if(dt>=next){
    y=y+1;
    start=startOfEpiWeek1(y);
    next=startOfEpiWeek1(y+1);
  }
  const week=Math.floor((dt-start)/(7*24*60*60*1000))+1;
  const weekStart=new Date(start.getTime());
  weekStart.setDate(start.getDate()+(week-1)*7);
  const weekEnd=new Date(weekStart.getTime());
  weekEnd.setDate(weekStart.getDate()+6);
  return {epiYear:y,week,weekStart,weekEnd,label:`SE ${String(week).padStart(2,'0')}`};
}

function weeklyStatsForYear(y){
  const groups=new Map();
  rowsForYear(y).filter(r=>(+r.Vacunados_Diarios||0)>0).forEach(r=>{
    const dt=fechaToDate(r.Fecha,y);
    const info=epiWeekInfo(dt);
    const key=`${info.epiYear}-${info.week}`;
    if(!groups.has(key)) groups.set(key,{year:y,epiYear:info.epiYear,week:info.week,label:info.label,start:dateToFecha(info.weekStart),end:dateToFecha(info.weekEnd),sum:0,count:0,days:[]});
    const g=groups.get(key);
    g.sum += (+r.Vacunados_Diarios||0);
    g.count++;
    g.days.push(r);
  });
  return [...groups.values()].sort((a,b)=>a.epiYear-b.epiYear||a.week-b.week).map(g=>({...g,avg:g.count?g.sum/g.count:0}));
}

function updateWeekHighlights(){
  const cy=currentYear(), stats=weeklyStatsForYear(cy); if(!stats.length) return;
  const best=stats.reduce((a,b)=>b.avg>a.avg?b:a,stats[0]);
  const worst=stats.reduce((a,b)=>b.avg<a.avg?b:a,stats[0]);
  const set=(id,v)=>{const el=document.getElementById(id); if(el) el.textContent=v};
  set('bestWeekTitle', `${best.label} · ${best.start} a ${best.end}`);
  set('bestWeekValue', `${fmtNum.format(Math.round(best.avg))} dosis/día`);
  set('bestWeekTotal', `${fmtNum.format(Math.round(best.sum))} dosis administradas en la semana epidemiológica`);
  set('worstWeekTitle', `${worst.label} · ${worst.start} a ${worst.end}`);
  set('worstWeekValue', `${fmtNum.format(Math.round(worst.avg))} dosis/día`);
  set('worstWeekTotal', `${fmtNum.format(Math.round(worst.sum))} dosis administradas en la semana epidemiológica`);
}

function weeklyChart(){
  const el=document.getElementById('weeklyChart'); if(!el) return;
  let w=el.clientWidth||520,h=el.clientHeight||340,m={l:68,r:18,t:18,b:44},iw=w-m.l-m.r,ih=h-m.t-m.b;
  const allStats=[];
  selectedYears.forEach(y=>weeklyStatsForYear(y).forEach(s=>allStats.push(s)));
  if(!allStats.length){el.innerHTML='';return;}
  let allWeeks=[...new Set(DATA.filter(d=>d.Grupo===group).map(d=>epiWeekInfo(fechaToDate(d.Fecha,d.Año)).week))].sort((a,b)=>a-b);
  let minW=Math.min(...allWeeks),maxW=Math.max(...allWeeks),vals=[];
  const series={}; selectedYears.forEach(y=>{series[y]=weeklyStatsForYear(y); series[y].forEach(s=>vals.push(s.sum));});
  let ymax=axisMax(Math.max(...vals,1)); const X=wk=>m.l+(wk-minW)/(maxW-minW||1)*iw, Y=v=>m.t+ih-(v/ymax)*ih; let p=[];
  for(let i=0;i<=4;i++){let val=ymax*i/4,yy=Y(val);p.push(`<line class="gridline" x1="${m.l}" x2="${w-m.r}" y1="${yy}" y2="${yy}"/><text x="${m.l-8}" y="${yy+4}" text-anchor="end">${fmtNum.format(Math.round(val))}</text>`)}
  const tickWeeks=[minW,Math.round(minW+(maxW-minW)*.25),Math.round(minW+(maxW-minW)*.5),Math.round(minW+(maxW-minW)*.75),maxW];
  [...new Set(tickWeeks)].forEach(wk=>p.push(`<text x="${X(wk)}" y="${h-14}" text-anchor="middle">SE ${wk}</text>`));
  selectedYears.forEach(y=>{let pts=(series[y]||[]).map(s=>`${X(s.week)},${Y(s.sum)}`).join(' '); if(pts) p.push(`<polyline class="line" points="${pts}" stroke="${COLORS[y]}" stroke-width="${y===currentYear()?3.4:2}" opacity="${y===currentYear()?1:.72}" fill="none"/>`)});
  el.innerHTML=`<svg viewBox="0 0 ${w} ${h}" class="axis">${p.join('')}<text x="${w/2}" y="${h-1}" text-anchor="middle" fill="#64748b" font-size="12" font-weight="800">Semana epidemiológica (SE)</text><text x="16" y="${h/2}" text-anchor="middle" transform="rotate(-90 16 ${h/2})" fill="#64748b" font-size="12" font-weight="800">Vacunados por SE</text><rect x="0" y="0" width="${w}" height="${h}" fill="transparent" id="weeklyHoverArea"/></svg>`;
  const hover=el.querySelector('#weeklyHoverArea');
  if(hover){
    hover.onmousemove=e=>{
      const rect=el.querySelector('svg').getBoundingClientRect(), px=e.clientX-rect.left;
      const wk=Math.max(minW,Math.min(maxW,Math.round(minW+(px-m.l)/iw*(maxW-minW))));
      const rows=selectedYears.map(y=>(series[y]||[]).find(s=>s.week===wk)).filter(Boolean);
      if(!rows.length){tip.style.display='none';return;}
      tip.style.display='block'; tip.style.left=e.clientX+12+'px'; tip.style.top=e.clientY+12+'px';
      tip.innerHTML='<div class="tip-head"><strong>Semana epidemiológica '+wk+'</strong></div>'+rows.sort((a,b)=>b.year-a.year).map(r=>'<div class="tip-row"><span><i class="dot" style="background:'+COLORS[r.year]+'"></i><strong>'+r.year+'</strong></span><span class="muted">'+r.start+' a '+r.end+'</span><span><strong>'+fmtNum.format(Math.round(r.sum))+'</strong></span></div><div class="muted" style="padding-left:18px;margin-bottom:4px">Promedio: '+fmtNum.format(Math.round(r.avg))+' dosis/día · días con registro: '+r.count+'</div>').join('');
    };
    hover.onmouseleave=()=>tip.style.display='none';
  }
}


function coverageRankAtDay(day, cy){
  const rows=years.map(y=>byYearDay(y,day)).filter(Boolean).sort((a,b)=>b.Cobertura-a.Cobertura);
  const pos=rows.findIndex(r=>r.Año===cy)+1;
  return {rows,pos,total:rows.length};
}

function ordinalText(n){
  return n===1?'primer':n===2?'segundo':n===3?'tercer':`${n}°`;
}

function groupRowsAtDay(day, cy){
  const groups=[...new Set(DATA.map(d=>d.Grupo))];
  return groups.map(g=>{
    let r=DATA.find(d=>d.Grupo===g&&d.Año===cy&&d.Dia_Campaña===day);
    if(!r){
      const rs=DATA.filter(d=>d.Grupo===g&&d.Año===cy&&d.Dia_Campaña<=day&&((+d.Vacunados_Acumulados||0)>0||(+d.Cobertura||0)>0)).sort((a,b)=>b.Dia_Campaña-a.Dia_Campaña);
      r=rs[0];
    }
    return r;
  }).filter(Boolean).sort((a,b)=>b.Cobertura-a.Cobertura);
}

function buildExecutiveReading(day, cur, prev){
  if(!cur) return '';
  const cy=currentYear();
  const diffPrev=prev ? cur.Cobertura-prev.Cobertura : null;
  const rank=coverageRankAtDay(day, cy);
  const pending=calcBrecha(cur,targetMeta);
  const a7=avgBusiness(cy,7);
  const daysLeft=businessDaysRemaining(cy);
  const required=requiredDailyPace(cur,targetMeta,daysLeft);
  let paceSentence='No hay promedio hábil suficiente para evaluar el ritmo actual.';
  if(pending<=0){
    paceSentence=`La meta seleccionada de ${targetMeta}% ya se encuentra cumplida para el grupo analizado.`;
  }else if(required!==null && required>0 && a7>0){
    const ratio=a7/required;
    if(ratio>=1.05){
      paceSentence=`El promedio hábil de los últimos 7 días (${fmtNum.format(Math.round(a7))} dosis/día) es suficiente para alcanzar la meta seleccionada de ${targetMeta}% (${fmtNum.format(Math.round(required))} dosis/día requeridas).`;
    }else if(ratio>=0.85){
      paceSentence=`El promedio hábil de los últimos 7 días (${fmtNum.format(Math.round(a7))} dosis/día) se encuentra cercano al ritmo requerido para alcanzar la meta seleccionada de ${targetMeta}% (${fmtNum.format(Math.round(required))} dosis/día requeridas).`;
    }else{
      paceSentence=`El promedio hábil de los últimos 7 días (${fmtNum.format(Math.round(a7))} dosis/día) es insuficiente respecto del ritmo requerido para alcanzar la meta seleccionada de ${targetMeta}% (${fmtNum.format(Math.round(required))} dosis/día requeridas).`;
    }
  }

  const groupRows=groupRowsAtDay(day, cy);
  const currentGroupRow=groupRows.find(r=>r.Grupo===group);
  const groupPos=currentGroupRow ? groupRows.findIndex(r=>r.Grupo===group)+1 : null;
  const lowest=groupRows[groupRows.length-1];
  const highest=groupRows[0];
  let groupSentence='';
  if(groupRows.length>1 && currentGroupRow){
    groupSentence=`Entre los grupos disponibles en el visor, <strong>${group}</strong> se ubica en la posición <strong>${groupPos} de ${groupRows.length}</strong>. `;
    if(lowest && highest){
      groupSentence+=`La mayor cobertura corresponde a <strong>${highest.Grupo}</strong> (${fmtPct(highest.Cobertura)}) y la menor a <strong>${lowest.Grupo}</strong> (${fmtPct(lowest.Cobertura)}).`;
    }
  }

  const diffText = diffPrev===null
    ? 'No existe comparación disponible con el año previo para este día de campaña.'
    : `Respecto de ${cy-1}, la diferencia de cobertura es <strong class="${diffPrev>=0?'good':'bad'}">${fmtPp(diffPrev)}</strong>.`;

  const rankText = rank.pos>0
    ? `En la comparación histórica para el mismo día de campaña, ${cy} se ubica en <strong>${ordinalText(rank.pos)} lugar de ${rank.total}</strong>.`
    : 'No fue posible establecer la posición histórica para este día de campaña.';

  return `
    <p>Al día <strong>${day}</strong> (${cur.Fecha}), el grupo <strong>${group}</strong> registra una cobertura de <strong>${fmtPct(cur.Cobertura)}</strong>, con <strong>${fmtNum.format(cur.Vacunados_Acumulados)}</strong> personas vacunadas acumuladas.</p>
    <p>${rankText} ${diffText}</p>
    <p>La brecha estimada para alcanzar la meta seleccionada de <strong>${targetMeta}%</strong> es de <strong>${fmtNum.format(pending)}</strong> personas. ${paceSentence}</p>
    ${groupSentence?`<p>${groupSentence}</p>`:''}
  `;
}

function updateDay(){
  let day=+slider.value,rows=years.map(y=>byYearDay(y,day)).filter(Boolean);selectedDay.textContent=day;selectedDate.textContent=rows[0]?rows[0].Fecha:'--';syncDateInput(rows[0]);
  const head=document.getElementById('compareBrechaHead'); if(head) head.textContent=`Brecha meta ${targetMeta}%`;
  document.querySelector('#compareTable tbody').innerHTML=rows.map(r=>`<tr><td><span class="pill">${r.Año}</span></td><td>${r.Fecha}</td><td><strong>${fmtPct(r.Cobertura)}</strong></td><td>${fmtNum.format(r.Vacunados_Acumulados)}</td><td>${fmtNum.format(r.Vacunados_Diarios)}</td><td>${fmtNum.format(calcBrecha(r))}</td></tr>`).join('');
  barChart(rows.filter(r=>selectedYears.includes(r.Año)));let cy=Math.max(...years),cur=rows.find(r=>r.Año===cy),prev=rows.find(r=>r.Año===cy-1),best=rows.reduce((a,b)=>b.Cobertura>a.Cobertura?b:a,rows[0]);
  if(cur){quickRead.innerHTML=buildExecutiveReading(day,cur,prev)}
  updateAdv(); updateRanking(); updateProjection(); updatePace(); updateGauge(); updateWeekHighlights(); weeklyChart(); lineChart(); velocityChart(); setVelocitySliderFromMain(); updateTargetMetaUI();
}

function drawAll(){updateKpis();updateDay();renderGroupCoveragePanel();updateHistoricalGroupsTable()}

(function initV51Controls(){
  const run=()=>setupTargetMetaControl();
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',run); else run();
})();

function updateWhatIf(){
  const input=document.getElementById('whatIfDaily');
  const out=document.getElementById('whatIfResult');
  if(!input||!out||typeof latestForYear!=='function') return;

  const cy=currentYear();
  const r=latestForYear(cy);
  if(!r) return;

  const meta=targetMeta||85;
  const target=Math.round((r.Poblacion_Objetivo||0)*meta/100);
  const pending=Math.max(0,target-(r.Vacunados_Acumulados||0));
  const daily=Math.max(1,Number(input.value)||20000);

  if(pending<=0){
    out.textContent=`La meta ${meta}% ya está cumplida.`;
    return;
  }

  const days=Math.ceil(pending/daily);
  const startDate=fechaToDate(r.Fecha,cy);
  const projectedDate=addBusinessDays(startDate,days);
  const projectedText=formatDateFull(projectedDate);

  out.textContent=`Con ${daily.toLocaleString('es-CL')} dosis/día hábil, la meta ${meta}% se alcanzaría en aproximadamente ${days} días hábiles, el ${projectedText}.`;
}

document.addEventListener('input',e=>{
  if(e.target && e.target.id==='whatIfDaily') updateWhatIf();
});

const _drawAllWhatIf = typeof drawAll==='function' ? drawAll : null;
if(_drawAllWhatIf){
  drawAll=function(){
    _drawAllWhatIf();
    updateWhatIf();
  }
}



/* =========================
   V5.8 · Reemplazo del gráfico de velocidad diaria
   Nuevo sentido: ritmo requerido vs ritmo observado 2026
   ========================= */
function businessDaysRemainingFromRow(row, y){
  const allRows = rawRowsForYear(y);
  const end = allRows.at(-1);
  if(!row || !end) return 0;
  let d = fechaToDate(row.Fecha, y);
  const endDt = fechaToDate(end.Fecha, y);
  let n = 0;
  while(d < endDt){
    d.setDate(d.getDate()+1);
    if(isBusinessDate(d)) n++;
  }
  return n;
}

function requiredPaceSeries(y){
  const rows = rowsForYear(y);
  return rows.map(r => {
    const target = Math.round((+r.Poblacion_Objetivo || 0) * (targetMeta || 85) / 100);
    const pending = Math.max(0, target - (+r.Vacunados_Acumulados || 0));
    const daysLeft = businessDaysRemainingFromRow(r, y);
    const val = pending <= 0 ? 0 : (daysLeft > 0 ? pending / daysLeft : 0);
    return { day:r.Dia_Campaña, fecha:r.Fecha, val, pending, daysLeft };
  });
}

function velocityChart(){
  const el = document.getElementById('velocityChart');
  if(!el) return;

  const cy = currentYear();
  const rows = rowsForYear(cy);
  if(!rows.length){ el.innerHTML=''; return; }

  const w = el.clientWidth || 900;
  const h = el.clientHeight || 320;
  const m = {l:68,r:24,t:18,b:40};
  const iw = w - m.l - m.r;
  const ih = h - m.t - m.b;

  const labels = [...new Set(DATA.filter(d=>d.Grupo===group).map(d=>d.Dia_Campaña))].sort((a,b)=>a-b);
  const minD = Math.min(...labels), maxD = Math.max(...labels);

  const ma3 = movingAvgSeries(cy,3);
  const ma7 = movingAvgSeries(cy,7);
  const ma14 = movingAvgSeries(cy,14);
  const req = requiredPaceSeries(cy);

  const vals = [];
  [...ma3,...ma7,...ma14,...req].forEach(p=>{ if(Number.isFinite(p.val)) vals.push(p.val || 0); });
  const ymax = axisMax(Math.max(...vals, 1));
  const X = d => m.l + (d-minD)/(maxD-minD||1)*iw;
  const Y = v => m.t + ih - (v/ymax)*ih;
  const p = [];

  for(let i=0;i<=4;i++){
    const val = ymax*i/4;
    const yy = Y(val);
    p.push(`<line class="gridline" x1="${m.l}" x2="${w-m.r}" y1="${yy}" y2="${yy}"/>`);
    p.push(`<text x="${m.l-8}" y="${yy+4}" text-anchor="end">${fmtNum.format(Math.round(val))}</text>`);
  }

  [minD,Math.round(maxD*.25),Math.round(maxD*.5),Math.round(maxD*.75),maxD].forEach(d=>{
    p.push(`<text x="${X(d)}" y="${h-12}" text-anchor="middle">${d}</text>`);
  });

  const addLine = (series, color, width, dash, label) => {
    const pts = series.filter(x=>Number.isFinite(x.val) && x.val>=0).map(x=>`${X(x.day)},${Y(x.val)}`).join(' ');
    if(pts) p.push(`<polyline points="${pts}" stroke="${color}" stroke-width="${width}" ${dash?`stroke-dasharray="${dash}"`:''} fill="none" opacity=".95"><title>${label}</title></polyline>`);
  };

  addLine(ma3, '#047857', 2.4, '3.4 2.4', 'Promedio hábil 3 días');
  addLine(ma7, '#b45309', 2.4, '5 3', 'Promedio hábil 7 días');
  addLine(ma14, '#075985', 2.4, '6 4', 'Promedio hábil 14 días');
  addLine(req, '#ef3340', 3.2, '', `Ritmo requerido meta ${targetMeta||85}%`);

  const vs = document.getElementById('velocitySlider');
  const day = vs ? +vs.value : +slider.value;
  p.push(`<line class="sel" x1="${X(day)}" x2="${X(day)}" y1="${m.t}" y2="${h-m.b}"/>`);

  const pointAt = (series, d) => series.find(x=>x.day===d)?.val || 0;
  const markers = [
    [pointAt(ma3,day),'#047857'],
    [pointAt(ma7,day),'#b45309'],
    [pointAt(ma14,day),'#075985'],
    [pointAt(req,day),'#ef3340']
  ];
  markers.forEach(([val,color])=>{
    if(Number.isFinite(val)) p.push(`<circle cx="${X(day)}" cy="${Y(val)}" r="4" fill="${color}" stroke="#fff" stroke-width="1.6"/>`);
  });

  el.innerHTML = `<svg viewBox="0 0 ${w} ${h}" class="axis">${p.join('')}<text x="${w/2}" y="${h-1}" text-anchor="middle" fill="#64748b" font-size="12" font-weight="800">Día de campaña</text><text x="16" y="${h/2}" text-anchor="middle" transform="rotate(-90 16 ${h/2})" fill="#64748b" font-size="12" font-weight="800">Dosis por día hábil</text><rect x="0" y="0" width="${w}" height="${h}" fill="transparent" id="velHoverArea"/></svg>`;

  const hover = el.querySelector('#velHoverArea');
  if(hover){
    hover.onmousemove = e => {
      const rect = el.querySelector('svg').getBoundingClientRect();
      const px = e.clientX - rect.left;
      const d = Math.max(minD, Math.min(maxD, Math.round(minD + (px-m.l)/iw*(maxD-minD))));
      const row = byYearDay(cy,d) || rows.find(x=>x.Dia_Campaña===d);
      const r3 = pointAt(ma3,d), r7 = pointAt(ma7,d), r14 = pointAt(ma14,d);
      const rq = req.find(x=>x.day===d);
      const reqVal = rq ? rq.val : 0;
      const ratio = reqVal > 0 ? r7/reqVal : null;
      let lectura = 'Sin ritmo requerido disponible para este día.';
      if(ratio !== null && Number.isFinite(ratio)){
        lectura = ratio >= 1 ? 'El promedio hábil 7 días supera el ritmo requerido.' : 'El promedio hábil 7 días está bajo el ritmo requerido.';
      }
      tip.style.display='block';
      tip.style.left=e.clientX+12+'px';
      tip.style.top=e.clientY+12+'px';
      tip.innerHTML = `<div class="tip-head"><strong>Día ${d} · Ritmo requerido</strong>${row?` · ${row.Fecha}`:''}</div>
        <div class="tip-row"><span><i class="dot" style="background:#047857"></i>3 días</span><span></span><span><strong>${fmtNum.format(Math.round(r3))}</strong></span></div>
        <div class="tip-row"><span><i class="dot" style="background:#b45309"></i>7 días</span><span></span><span><strong>${fmtNum.format(Math.round(r7))}</strong></span></div>
        <div class="tip-row"><span><i class="dot" style="background:#075985"></i>14 días</span><span></span><span><strong>${fmtNum.format(Math.round(r14))}</strong></span></div>
        <div class="tip-row"><span><i class="dot" style="background:#ef3340"></i>Requerido</span><span></span><span><strong>${fmtNum.format(Math.round(reqVal))}</strong></span></div>
        <div class="muted" style="margin-top:6px">${lectura}${rq?` Faltan ${fmtNum.format(Math.round(rq.pending))} personas; ${rq.daysLeft} días hábiles restantes.`:''}</div>`;
    };
    hover.onmouseleave=()=>tip.style.display='none';
  }
  updateVelocityLabel();
}


/* =========================
   V5.9 · Escenarios de cumplimiento
   Reemplaza la lectura gráfica compleja por tarjetas ejecutivas.
   ========================= */

function scenarioNumberFromInput(value, fallback){
  const n = Number(String(value || '').replace(/\./g,'').replace(',', '.'));
  return Number.isFinite(n) && n > 0 ? n : fallback;
}

function projectScenarioFromDaily(row, year, metaPct, daily){
  if(!row || !daily) return null;
  const target = Math.round((+row.Poblacion_Objetivo || 0) * metaPct / 100);
  const pending = Math.max(0, target - (+row.Vacunados_Acumulados || 0));
  if(pending <= 0){
    return {
      status:'ok',
      pending:0,
      days:0,
      date:formatDateFull(fechaToDate(row.Fecha, year)),
      daily
    };
  }
  const days = Math.ceil(pending / daily);
  const projectedDate = addBusinessDays(fechaToDate(row.Fecha, year), days);
  return {
    status:'projected',
    pending,
    days,
    date:formatDateFull(projectedDate),
    daily
  };
}

function scenarioCardHTML(title, projected){
  if(!projected){
    return `<div class="scenario-card"><div class="label">${title}</div><div class="scenario-value">Sin datos</div><div class="scenario-note">No hay información suficiente para estimar este escenario.</div></div>`;
  }
  if(projected.status === 'ok'){
    return `<div class="scenario-card">
      <div class="label">${title}</div>
      <div class="scenario-value">Cumplida</div>
      <div class="scenario-date">${projected.date}</div>
      <div class="scenario-note">La meta ya se encuentra alcanzada al último dato disponible.</div>
    </div>`;
  }
  return `<div class="scenario-card">
    <div class="label">${title}</div>
    <div class="scenario-value">${fmtNum.format(Math.round(projected.daily))}</div>
    <div class="scenario-date">${projected.date}</div>
    <div class="scenario-note">${projected.days} días hábiles estimados · faltan ${fmtNum.format(Math.round(projected.pending))} personas.</div>
  </div>`;
}

function updateScenarioPanel(){
  const cards = document.getElementById('scenarioCards');
  const read = document.getElementById('scenarioRead');
  const targetInput = document.getElementById('scenarioTarget');
  const dailyInput = document.getElementById('scenarioDaily');
  if(!cards || !read || !targetInput || !dailyInput || typeof latestForYear !== 'function') return;

  const cy = currentYear();
  const row = latestForYear(cy);
  if(!row) return;

  const meta = scenarioNumberFromInput(targetInput.value, targetMeta || 85);
  const manualDaily = scenarioNumberFromInput(dailyInput.value, 25000);
  const avg7 = avgBusiness(cy, 7);
  const avg14 = avgBusiness(cy, 14);

  const s7 = projectScenarioFromDaily(row, cy, meta, avg7);
  const s14 = projectScenarioFromDaily(row, cy, meta, avg14);
  const sm = projectScenarioFromDaily(row, cy, meta, manualDaily);

  cards.innerHTML = [
    scenarioCardHTML('Ritmo actual 7 días', s7),
    scenarioCardHTML('Ritmo actual 14 días', s14),
    scenarioCardHTML('Escenario manual', sm)
  ].join('');

  if(sm && sm.status === 'ok'){
    read.innerHTML = `La meta de <strong>${fmtDec.format(meta)}%</strong> ya se encuentra cumplida para el grupo seleccionado.`;
    return;
  }

  const baseText = s7 && s7.status === 'projected'
    ? `Si el ritmo se mantiene en el promedio hábil de los últimos 7 días (<strong>${fmtNum.format(Math.round(avg7))}</strong> dosis/día), la meta de <strong>${fmtDec.format(meta)}%</strong> se alcanzaría aproximadamente el <strong>${s7.date}</strong>.`
    : `No hay promedio hábil de 7 días suficiente para estimar el escenario tendencial.`;

  const manualText = sm && sm.status === 'projected'
    ? `Con un escenario manual de <strong>${fmtNum.format(Math.round(manualDaily))}</strong> dosis/día hábil, la fecha estimada sería el <strong>${sm.date}</strong>.`
    : '';

  read.innerHTML = `${baseText} ${manualText}`;
}

document.addEventListener('input', e => {
  if(e.target && (e.target.id === 'scenarioTarget' || e.target.id === 'scenarioDaily')){
    updateScenarioPanel();
  }
});

const _drawAllScenarioV59 = typeof drawAll === 'function' ? drawAll : null;
if(_drawAllScenarioV59){
  drawAll = function(){
    _drawAllScenarioV59();
    updateScenarioPanel();
  };
}


/* =========================
   V6 · Navegación Nacional / Regional / Servicio de Salud
   ========================= */

let selectedRegion = null;
let selectedRegionGroup = 'Total';

function normalizeRegionName(name){
  const raw = String(name || '').trim();
  const key = raw
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g,'')
    .replace(/[’'´`]/g,' ')
    .replace(/\bregion\b/g,' ')
    .replace(/\bde\b|\bdel\b|\bla\b/g,' ')
    .replace(/[^a-z0-9]+/g,' ')
    .replace(/\s+/g,' ')
    .trim();

  if(/arica.*parinacota/.test(key)) return 'Arica y Parinacota';
  if(/tarapaca|taparaca/.test(key)) return 'Tarapacá';
  if(/antofagasta/.test(key)) return 'Antofagasta';
  if(/atacama/.test(key)) return 'Atacama';
  if(/coquimbo/.test(key)) return 'Coquimbo';
  if(/valparaiso/.test(key)) return 'Valparaíso';
  if(/metropolitana|santiago/.test(key)) return 'Metropolitana';
  if(/ohiggins|o higgins|bernardo.*higgins|libertador/.test(key)) return "O'Higgins";
  if(/maule/.test(key)) return 'Maule';
  if(/nuble/.test(key)) return 'Ñuble';
  if(/biobio|bio bio|bio/.test(key)) return 'Biobío';
  if(/araucania/.test(key)) return 'Araucanía';
  if(/los rios/.test(key)) return 'Los Ríos';
  if(/los lagos/.test(key)) return 'Los Lagos';
  if(/aysen|aisen/.test(key)) return 'Aysén';
  if(/magallanes/.test(key)) return 'Magallanes';
  return raw;
}

function territoryStatus(v){
  if(v >= 85) return {cls:'ok', label:'Meta 85% alcanzada'};
  if(v >= 75) return {cls:'mid', label:'Entre 75% y 84,9%'};
  return {cls:'low', label:'Bajo 75%'};
}

function territoryGap(row, meta){
  if(!row) return 0;
  return Math.max(0, Math.round((+row.Poblacion_Objetivo || 0) * meta / 100 - (+row.Vacunados || 0)));
}

function setupMainTabs(){
  document.querySelectorAll('.oi-main-tab').forEach(btn=>{
    btn.onclick=()=>{
      document.querySelectorAll('.oi-main-tab').forEach(b=>b.classList.remove('active'));
      btn.classList.add('active');

      document.querySelectorAll('.oi-view').forEach(v=>v.classList.remove('oi-view-active'));
      const view = btn.dataset.view;
      if(view === 'national') document.getElementById('oiViewNational')?.classList.add('oi-view-active');
      if(view === 'territory-region') {
        document.getElementById('oiViewTerritoryRegion')?.classList.add('oi-view-active');
        setTimeout(renderRegionalView, 80);
      }
      if(view === 'territory-service') {
        document.getElementById('oiViewTerritoryService')?.classList.add('oi-view-active');
        setTimeout(renderServiceView, 80);
      }
    };
  });
}

function setupRegionalControls(){
  const groupSel=document.getElementById('territoryRegionGroupSelect');
  const regionSel=document.getElementById('territoryRegionSelect');
  if(!groupSel || !regionSel || !REGION_COVERAGE_DATA.length) return;

  const groups=[...new Set(REGION_COVERAGE_DATA.map(d=>d.Grupo))];
  const preferred = groups.includes('Total') ? 'Total' : groups[0];
  if(!selectedRegionGroup || !groups.includes(selectedRegionGroup)) selectedRegionGroup = preferred;

  groupSel.innerHTML=groups.map(g=>`<option value="${g}">${g}</option>`).join('');
  groupSel.value=selectedRegionGroup;
  groupSel.onchange=()=>{
    selectedRegionGroup=groupSel.value;
    const rows=regionalRowsForGroup();
    if(rows.length && !rows.some(r=>r.Region===selectedRegion)) selectedRegion=rows[0].Region;
    renderRegionalView();
    renderServiceView();
  };

  const regions=[...new Set(REGION_COVERAGE_DATA.map(d=>d.Region))].sort((a,b)=>a.localeCompare(b,'es'));
  if(!selectedRegion || !regions.includes(selectedRegion)){
    const totalRows=regionalRowsForGroup();
    selectedRegion = totalRows.length ? totalRows[0].Region : regions[0];
  }

  regionSel.innerHTML=regions.map(r=>`<option value="${r}">${r}</option>`).join('');
  regionSel.value=selectedRegion;
  regionSel.onchange=()=>{
    selectedRegion=regionSel.value;
    renderRegionalView();
    renderServiceView();
  };
}

function regionalRowsForGroup(){
  return REGION_COVERAGE_DATA
    .filter(d=>d.Grupo===selectedRegionGroup)
    .sort((a,b)=>b.Cobertura-a.Cobertura);
}

function regionAllGroups(region){
  return REGION_COVERAGE_DATA
    .filter(d=>d.Region===region)
    .sort((a,b)=>b.Cobertura-a.Cobertura);
}

function renderRegionalMap(rows){
  const el=document.getElementById('regionMap');
  if(!el) return;
  if(!rows.length){
    el.innerHTML='<div class="warning-note">No hay datos regionales disponibles.</div>';
    return;
  }

  const northToSouth=[
    'Arica y Parinacota','Tarapacá','Antofagasta','Atacama','Coquimbo',
    'Valparaíso','Metropolitana',"O'Higgins",'Maule','Ñuble','Biobío',
    'Araucanía','Los Ríos','Los Lagos','Aysén','Magallanes'
  ];

  const byRegion=new Map(rows.map(r=>[r.Region,r]));
  const ordered=[
    ...northToSouth.map(r=>byRegion.get(r)).filter(Boolean),
    ...rows.filter(r=>!northToSouth.includes(r.Region))
  ];

  el.innerHTML=ordered.map(r=>{
    const st=territoryStatus(r.Cobertura);
    return `<button type="button" class="oi-region-tile ${st.cls} ${r.Region===selectedRegion?'active':''}" data-region="${r.Region}">
      <span class="region-tile-name">${r.Region}</span>
      <span class="region-tile-value">${fmtPct(r.Cobertura)}</span>
    </button>`;
  }).join('');

  el.querySelectorAll('.oi-region-tile').forEach(btn=>{
    btn.onclick=()=>{
      selectedRegion=btn.dataset.region;
      const sel=document.getElementById('territoryRegionSelect');
      if(sel) sel.value=selectedRegion;
      renderRegionalView();
    };
  });
}

function renderTerritoryHorizontalChart(elId, rows, labelKey='Region'){
  const el=document.getElementById(elId);
  if(!el) return;
  if(!rows.length){
    el.innerHTML='<div class="warning-note">No hay datos disponibles.</div>';
    return;
  }

  const isServiceRanking = elId === 'serviceRankChart' && labelKey === 'Servicio';
  const chartRows = isServiceRanking
    ? [...rows].sort((a,b)=>(+b.Cobertura||0)-(+a.Cobertura||0) || serviceDisplayOrderSort(a,b))
    : [...rows];

  const w=el.clientWidth||720;
  const rowH=isServiceRanking ? 38 : 34;
  const h=Math.max(360, chartRows.length*rowH+78);
  el.style.height=h+'px';

  const m={l:isServiceRanking ? 285 : 240,r:isServiceRanking ? 92 : 70,t:30,b:38};
  const iw=w-m.l-m.r;
  const maxVal=Math.max(100, Math.ceil(Math.max(...chartRows.map(r=>r.Cobertura))/10)*10);
  const X=v=>m.l+(v/maxVal)*iw;
  const Y=i=>m.t+i*rowH+rowH/2;
  let p=[];

  for(let v=0; v<=maxVal; v+=10){
    const x=X(v);
    p.push(`<line class="gridline" x1="${x}" x2="${x}" y1="${m.t-8}" y2="${h-m.b}"/>`);
    p.push(`<text x="${x}" y="${h-12}" text-anchor="middle" fill="#64748b" font-size="11">${v}%</text>`);
  }

  [[75,'#ef3340','75%'],[85,'#047857','85%']].forEach(([v,color,label])=>{
    const x=X(v);
    p.push(`<line x1="${x}" x2="${x}" y1="${m.t-12}" y2="${h-m.b}" stroke="${color}" stroke-width="2.2" stroke-dasharray="6 5"/>`);
    p.push(`<text x="${x+4}" y="${m.t-14}" fill="${color}" font-size="11" font-weight="900">${label}</text>`);
  });

  chartRows.forEach((r,i)=>{
    const y=Y(i);
    const barW=Math.max(2, X(r.Cobertura)-m.l);
    const st=territoryStatus(r.Cobertura);
    const fill = st.cls==='ok' ? '#047857' : (st.cls==='mid' ? '#f59e0b' : '#ef3340');
    const label = r[labelKey] || r.Region || r.Grupo || '';
    const rank = i + 1;
    const medal = rank===1 ? '🥇' : (rank===2 ? '🥈' : (rank===3 ? '🥉' : `#${rank}`));
    const displayLabel = isServiceRanking ? `${medal} ${label}` : label;
    p.push(`<text x="${m.l-12}" y="${y+4}" text-anchor="end" fill="#334155" font-size="12" font-weight="900">${displayLabel}</text>`);
    p.push(`<rect class="oi-ranking-bar ${isServiceRanking && selectedService===label ? 'is-selected' : ''}" data-service="${String(label).replace(/"/g,'&quot;')}" x="${m.l}" y="${y-11}" width="${barW}" height="22" rx="9" fill="${fill}" opacity="${isServiceRanking && selectedService===label ? '1' : '.9'}" stroke="${isServiceRanking && selectedService===label ? '#003b71' : 'transparent'}" stroke-width="${isServiceRanking && selectedService===label ? '2.2' : '0'}"><title>${rank}. ${label} · ${fmtPct(r.Cobertura)}</title></rect>`);
    p.push(`<text x="${Math.min(X(r.Cobertura)+8,w-6)}" y="${y+4}" fill="#0f172a" font-size="12" font-weight="950">${fmtPct(r.Cobertura)}</text>`);
  });

  el.innerHTML=`<svg viewBox="0 0 ${w} ${h}" class="axis ${isServiceRanking ? 'oi-service-ranking-svg' : ''}" preserveAspectRatio="none">${p.join('')}</svg>`;
  if(isServiceRanking){
    el.querySelectorAll('.oi-ranking-bar[data-service]').forEach(bar=>{
      bar.style.cursor='pointer';
      bar.addEventListener('click',()=>{
        const svc=bar.getAttribute('data-service');
        if(!svc) return;
        selectedService=svc;
        const sel=document.getElementById('territoryServiceSelect');
        if(sel) sel.value=selectedService;
        renderServiceView();
      });
    });
  }
}

function renderRegionalKpis(rows){
  const row = rows.find(r=>r.Region===selectedRegion) || rows[0];
  if(!row) return;

  const set=(id,v)=>{const el=document.getElementById(id); if(el) el.textContent=v;};
  const st=territoryStatus(row.Cobertura);

  set('regionNameKpi', row.Region);
  set('regionGroupKpi', selectedRegionGroup);
  set('regionCoverageKpi', fmtPct(row.Cobertura));
  set('regionStatusKpi', st.label);
  set('regionVaccinatedKpi', fmtNum.format(row.Vacunados));
  set('regionGap85Kpi', fmtNum.format(territoryGap(row,85)));

  const read=document.getElementById('regionExecutiveRead');
  if(read){
    const rankRows=[...rows].sort((a,b)=>b.Cobertura-a.Cobertura);
    const pos=rankRows.findIndex(r=>r.Region===row.Region)+1;
    const best=rankRows[0], worst=rankRows[rankRows.length-1];
    const groups=regionAllGroups(row.Region);
    const lowGroups=groups.slice().sort((a,b)=>a.Cobertura-b.Cobertura).slice(0,3);

    read.innerHTML=`La región <strong>${row.Region}</strong> registra una cobertura de <strong>${fmtPct(row.Cobertura)}</strong> para <strong>${selectedRegionGroup}</strong>, ubicándose en la posición <strong>${pos} de ${rankRows.length}</strong> del ranking regional. La brecha estimada para alcanzar 85% es de <strong>${fmtNum.format(territoryGap(row,85))}</strong> personas. La región con mayor avance es <strong>${best.Region}</strong> (${fmtPct(best.Cobertura)}) y la de menor avance es <strong>${worst.Region}</strong> (${fmtPct(worst.Cobertura)}). ${lowGroups.length?`Dentro de la región seleccionada, los grupos con menor cobertura son <strong>${lowGroups.map(g=>`${g.Grupo} (${fmtPct(g.Cobertura)})`).join(', ')}</strong>.`:''}`;
  }
}

function renderRegionalTable(rows){
  const body=document.querySelector('#regionTable tbody');
  if(!body) return;
  body.innerHTML=rows.map(r=>{
    const st=territoryStatus(r.Cobertura);
    return `<tr class="${r.Region===selectedRegion?'active-row':''}">
      <td><strong>${r.Region}</strong></td>
      <td><strong>${fmtPct(r.Cobertura)}</strong></td>
      <td>${fmtNum.format(r.Vacunados)}</td>
      <td>${fmtNum.format(r.Poblacion_Objetivo)}</td>
      <td>${fmtNum.format(territoryGap(r,75))}</td>
      <td>${fmtNum.format(territoryGap(r,85))}</td>
      <td><span class="territory-status ${st.cls}">${st.label}</span></td>
    </tr>`;
  }).join('');

  body.querySelectorAll('tr').forEach((tr,i)=>{
    tr.onclick=()=>{
      selectedRegion=rows[i].Region;
      const sel=document.getElementById('territoryRegionSelect');
      if(sel) sel.value=selectedRegion;
      renderRegionalView();
    };
  });
}

function renderRegionalView(){
  if(!REGION_COVERAGE_DATA.length){
    const map=document.getElementById('regionMap');
    if(map) map.innerHTML='<div class="warning-note">No se pudo cargar Cobertura_Regiones.csv. Sube el archivo a WordPress con ese nombre exacto.</div>';
    return;
  }

  setupRegionalControls();

  const rows=regionalRowsForGroup();
  if(!rows.length) return;
  if(!selectedRegion || !rows.some(r=>r.Region===selectedRegion)) selectedRegion=rows[0].Region;

  const regionSel=document.getElementById('territoryRegionSelect');
  if(regionSel) regionSel.value=selectedRegion;

  renderRegionalMap(rows);
  renderRegionalKpis(rows);
  renderRegionalTable(rows);
  renderTerritoryHorizontalChart('regionRankChart', rows, 'Region');
  renderTerritoryHorizontalChart('regionGroupChart', regionAllGroups(selectedRegion), 'Grupo');
}

(function initV6Tabs(){
  const run=()=>{
    setupMainTabs();
    setupRegionalControls();
    renderRegionalView();
  };
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',run); else setTimeout(run,80);
})();


/* V6 · Asegura actualización de vista territorial después de cada redibujado */
const _drawAllTerritoryV6 = typeof drawAll === 'function' ? drawAll : null;
if(_drawAllTerritoryV6){
  drawAll = function(){
    _drawAllTerritoryV6();
    renderRegionalView();
  };
}


/* =========================
   V6.6 · Vista por Servicio de Salud desde Cobertura_SS.csv
   ========================= */

let selectedService = '__TOTAL_PAIS__';
let selectedServiceRegion = 'Todas';
let selectedServiceGroup = 'Total';

const SERVICE_REGION_MAP = {
  // Uso secundario: solo opera como respaldo cuando el CSV no trae columna Región.
  // La asignación principal se toma directamente desde Cobertura_SS.csv.
  'Arica y Parinacota': ['Arica'],
  'Tarapacá': ['Tarapacá', 'Iquique'],
  'Antofagasta': ['Antofagasta'],
  'Atacama': ['Atacama'],
  'Coquimbo': ['Coquimbo'],
  'Valparaíso': ['Aconcagua', 'Viña del Mar-Quillota', 'Valparaíso-San Antonio'],
  'Metropolitana': ['Metropolitano Norte', 'Metropolitano Central', 'Metropolitano Occidente', 'Metropolitano Sur', 'Metropolitano Sur-Oriente', 'Metropolitano Oriente'],
  "O'Higgins": ["O'Higgins"],
  'Maule': ['Maule', 'Del Maule', 'SS Del Maule'],
  'Ñuble': ['Ñuble'],
  'Biobío': ['Biobío', 'Concepción', 'Talcahuano', 'Arauco'],
  'Araucanía': ['Araucanía Norte', 'Araucanía Sur'],
  'Los Ríos': ['Los Ríos'],
  'Los Lagos': ['Osorno', 'Del Reloncaví', 'Chiloé'],
  'Aysén': ['Aysén'],
  'Magallanes': ['Magallanes']
};

const SERVICE_REGION_ORDER = [
  'Arica y Parinacota','Tarapacá','Antofagasta','Atacama','Coquimbo','Valparaíso','Metropolitana',"O'Higgins",'Maule','Ñuble','Biobío','Araucanía','Los Ríos','Los Lagos','Aysén','Magallanes'
];

const SERVICE_ORDER = SERVICE_REGION_ORDER.flatMap(region => SERVICE_REGION_MAP[region].map(service => ({region, service})));

function normalizeServiceKey(value){
  return String(value || '')
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g,'')
    .replace(/[’'´`]/g,' ')
    .replace(/^servicio\s+de\s+salud\s+/,'')
    .replace(/^ss\s+/,'')
    .replace(/^s\.s\.\s*/,'')
    .replace(/[^a-z0-9]+/g,' ')
    .replace(/\s+/g,' ')
    .trim();
}

function regionFromService(service){
  const key = normalizeServiceKey(service);
  for(const [region, services] of Object.entries(SERVICE_REGION_MAP)){
    if(services.some(s => normalizeServiceKey(s) === key)) return region;
  }
  // Respaldo adicional para variaciones frecuentes de nombre en el CSV
  if(key === 'del maule' || key === 'maule' || key.includes('maule')) return 'Maule';
  if(key === 'arica' || key.includes('arica')) return 'Arica y Parinacota';
  if(key === 'nuble' || key.includes('nuble')) return 'Ñuble';
  return '';
}

function serviceConfiguredOrder(service){
  const key = normalizeServiceKey(service);
  const pos = SERVICE_ORDER.findIndex(x => normalizeServiceKey(x.service) === key);
  return pos >= 0 ? pos : 9999;
}

function serviceCsvOrderSort(a,b){
  const oa = Number.isFinite(+a?.OrdenCSV) ? +a.OrdenCSV : 999999;
  const ob = Number.isFinite(+b?.OrdenCSV) ? +b.OrdenCSV : 999999;
  if(oa !== ob) return oa - ob;
  const ca = serviceConfiguredOrder(a?.Servicio);
  const cb = serviceConfiguredOrder(b?.Servicio);
  if(ca !== cb) return ca - cb;
  return String(a?.Servicio || '').localeCompare(String(b?.Servicio || ''),'es');
}

function serviceDisplayOrderSort(a,b){
  const oa = Number.isFinite(+a?.OrdenCSV) ? +a.OrdenCSV : 999999;
  const ob = Number.isFinite(+b?.OrdenCSV) ? +b.OrdenCSV : 999999;
  if(oa !== ob) return oa - ob;
  const ca = serviceConfiguredOrder(a?.Servicio || a);
  const cb = serviceConfiguredOrder(b?.Servicio || b);
  if(ca !== cb) return ca - cb;
  return String(a?.Servicio || a || '').localeCompare(String(b?.Servicio || b || ''),'es');
}

function normalizeServiceName(name){
  const raw = String(name || '').replace(/\s+/g,' ').trim();
  if(!raw) return '';
  return raw
    .replace(/^servicio\s+de\s+salud\s+/i,'')
    .replace(/^ss\s+/i,'SS ')
    .replace(/^s\.s\.\s*/i,'SS ')
    .trim();
}

function serviceRegionSort(a,b){
  if(a === 'Todas') return -1;
  if(b === 'Todas') return 1;
  const ia = SERVICE_REGION_ORDER.indexOf(a);
  const ib = SERVICE_REGION_ORDER.indexOf(b);
  if(ia !== -1 || ib !== -1) return (ia === -1 ? 999 : ia) - (ib === -1 ? 999 : ib);
  if(typeof oiRegionSort === 'function') return oiRegionSort(a,b);
  return String(a||'').localeCompare(String(b||''),'es');
}

function setupServiceControls(){
  const groupSel=document.getElementById('territoryServiceGroupSelect');
  const regionSel=document.getElementById('territoryServiceRegionSelect');
  const serviceSel=document.getElementById('territoryServiceSelect');
  if(!groupSel || !regionSel || !serviceSel || !SERVICE_COVERAGE_DATA.length) return;

  const groups=[...new Set(SERVICE_COVERAGE_DATA.map(d=>d.Grupo).filter(Boolean))];
  const preferredGroup=groups.includes('Total') ? 'Total' : groups[0];
  if(!selectedServiceGroup || !groups.includes(selectedServiceGroup)) selectedServiceGroup=preferredGroup;

  groupSel.innerHTML=groups.map(g=>`<option value="${g}">${g}</option>`).join('');
  groupSel.value=selectedServiceGroup;
  groupSel.onchange=()=>{
    selectedServiceGroup=groupSel.value;
    selectedService=null;
    setupServiceControls();
    renderServiceView();
  };

  const baseRows=SERVICE_COVERAGE_DATA.filter(d=>d.Grupo===selectedServiceGroup);
  const regions=['Todas', ...new Set(baseRows.map(d=>d.Region).filter(Boolean))].sort(serviceRegionSort);
  if(!selectedServiceRegion || !regions.includes(selectedServiceRegion)) selectedServiceRegion='Todas';

  regionSel.innerHTML=regions.map(r=>`<option value="${r}">${r}</option>`).join('');
  regionSel.value=selectedServiceRegion;
  regionSel.onchange=()=>{
    selectedServiceRegion=regionSel.value;
    selectedService=null;
    setupServiceControls();
    renderServiceView();
  };

  const serviceRows=serviceRowsForCurrentFilters();
  const services=serviceRows
    .filter((row, idx, arr)=>row.Servicio && arr.findIndex(x=>x.Servicio===row.Servicio)===idx)
    .map(row=>row.Servicio);
  const serviceOptions=['__TOTAL_PAIS__', ...services];
  if(!selectedService || (!serviceOptions.includes(selectedService))) selectedService='__TOTAL_PAIS__';

  serviceSel.innerHTML=serviceOptions.map(s=>`<option value="${s}">${s==='__TOTAL_PAIS__'?'Total país':s}</option>`).join('');
  serviceSel.value=selectedService || '__TOTAL_PAIS__';
  serviceSel.onchange=()=>{
    selectedService=serviceSel.value;
    renderServiceView();
  };

  const clearBtn=document.getElementById('serviceClearBtn');
  if(clearBtn){
    clearBtn.onclick=()=>{
      selectedServiceGroup='Total';
      selectedServiceRegion='Todas';
      selectedService='__TOTAL_PAIS__';
      setupServiceControls();
      renderServiceView();
    };
  }
}

function serviceRowsForCurrentFilters(){
  return SERVICE_COVERAGE_DATA
    .filter(d=>d.Grupo===selectedServiceGroup)
    .filter(d=>selectedServiceRegion==='Todas' || d.Region===selectedServiceRegion)
    .sort(serviceDisplayOrderSort);
}

function serviceAllGroups(service){
  return SERVICE_COVERAGE_DATA
    .filter(d=>d.Servicio===service)
    .sort((a,b)=>b.Cobertura-a.Cobertura);
}


function serviceAggregateRows(rows, label='Total país'){
  const vaccinated=rows.reduce((s,r)=>s+(+r.Vacunados||0),0);
  const population=rows.reduce((s,r)=>s+(+r.Poblacion_Objetivo||0),0);
  const coverage=population>0 ? vaccinated/population*100 : (rows.length ? rows.reduce((s,r)=>s+(+r.Cobertura||0),0)/rows.length : 0);
  return {Servicio:label, Region:selectedServiceRegion==='Todas'?'Todas las regiones':selectedServiceRegion, Grupo:selectedServiceGroup, Cobertura:coverage, Vacunados:vaccinated, Poblacion_Objetivo:population, IsAggregate:true};
}
function serviceAggregateGroups(){
  const base=SERVICE_COVERAGE_DATA.filter(d=>selectedServiceRegion==='Todas' || d.Region===selectedServiceRegion);
  const groups=[...new Set(base.map(d=>d.Grupo).filter(Boolean))];
  return groups.map(g=>serviceAggregateRows(base.filter(d=>d.Grupo===g),g)).sort((a,b)=>b.Cobertura-a.Cobertura);
}

function renderServiceKpis(rows){
  const isTotal = selectedService === '__TOTAL_PAIS__';
  const row = isTotal ? serviceAggregateRows(rows,'Total país') : (rows.find(r=>r.Servicio===selectedService) || rows[0]);
  if(!row) return;
  if(!isTotal) selectedService=row.Servicio;

  const set=(id,v)=>{const el=document.getElementById(id); if(el) el.textContent=v;};
  const st=territoryStatus(row.Cobertura);
  const rankRows=[...rows].sort((a,b)=>b.Cobertura-a.Cobertura);
  const pos=isTotal ? null : (rankRows.findIndex(r=>r.Servicio===row.Servicio)+1);

  set('serviceNameKpi', row.Servicio);
  set('serviceRegionKpi', selectedService==='__TOTAL_PAIS__' ? (selectedServiceRegion==='Todas'?'Todas las regiones':selectedServiceRegion) : (row.Region || 'Sin región informada'));
  set('serviceGroupKpi', selectedServiceGroup);
  set('serviceCoverageKpi', fmtPct(row.Cobertura));
  set('serviceStatusKpi', st.label);
  set('serviceVaccinatedKpi', fmtNum.format(row.Vacunados));
  set('servicePopulationKpi', fmtNum.format(row.Poblacion_Objetivo));
  set('serviceGap85Kpi', fmtNum.format(territoryGap(row,85)));

  const read=document.getElementById('serviceExecutiveRead');
  if(read){
    const best=rankRows[0], worst=rankRows[rankRows.length-1];
    const groups=isTotal ? serviceAggregateGroups() : serviceAllGroups(row.Servicio);
    const lowGroups=groups.slice().sort((a,b)=>a.Cobertura-b.Cobertura).slice(0,3);
    const scope = selectedServiceRegion === 'Todas' ? 'a nivel nacional' : `en la región ${selectedServiceRegion}`;
    if(isTotal){
      read.innerHTML=`El <strong>Total país</strong> registra una cobertura agregada de <strong>${fmtPct(row.Cobertura)}</strong> para <strong>${selectedServiceGroup}</strong>. La brecha estimada para alcanzar 85% es de <strong>${fmtNum.format(territoryGap(row,85))}</strong> personas. El mayor avance por Servicio de Salud corresponde a <strong>${best.Servicio}</strong> (${fmtPct(best.Cobertura)}) y el menor a <strong>${worst.Servicio}</strong> (${fmtPct(worst.Cobertura)}). Los grupos con menor cobertura agregada son <strong>${lowGroups.map(g=>`${g.Servicio} (${fmtPct(g.Cobertura)})`).join(', ')}</strong>.`;
    }else{
      read.innerHTML=`El Servicio de Salud <strong>${row.Servicio}</strong> registra una cobertura de <strong>${fmtPct(row.Cobertura)}</strong> para <strong>${selectedServiceGroup}</strong>, ubicándose en la posición <strong>${pos} de ${rankRows.length}</strong> ${scope}. La brecha estimada para alcanzar 85% es de <strong>${fmtNum.format(territoryGap(row,85))}</strong> personas. El mayor avance del filtro corresponde a <strong>${best.Servicio}</strong> (${fmtPct(best.Cobertura)}) y el menor a <strong>${worst.Servicio}</strong> (${fmtPct(worst.Cobertura)}). ${lowGroups.length?`Dentro del servicio seleccionado, los grupos con menor cobertura son <strong>${lowGroups.map(g=>`${g.Grupo} (${fmtPct(g.Cobertura)})`).join(', ')}</strong>.`:''}`;
    }
  }
}

function renderServiceTable(rows){
  const body=document.querySelector('#serviceTable tbody');
  if(!body) return;
  body.innerHTML=rows.map(r=>{
    const st=territoryStatus(r.Cobertura);
    return `<tr class="${r.Servicio===selectedService?'active-row':''}">
      <td><strong>${r.Servicio}</strong></td>
      <td>${r.Region || '—'}</td>
      <td><strong>${fmtPct(r.Cobertura)}</strong></td>
      <td>${fmtNum.format(r.Vacunados)}</td>
      <td>${fmtNum.format(r.Poblacion_Objetivo)}</td>
      <td>${fmtNum.format(territoryGap(r,75))}</td>
      <td>${fmtNum.format(territoryGap(r,85))}</td>
      <td><span class="territory-status ${st.cls}">${st.label}</span></td>
    </tr>`;
  }).join('');

  body.querySelectorAll('tr').forEach((tr,i)=>{
    tr.onclick=()=>{
      selectedService=rows[i].Servicio;
      const sel=document.getElementById('territoryServiceSelect');
      if(sel) sel.value=selectedService;
      renderServiceView();
    };
  });
}

function renderServiceView(){
  if(!SERVICE_COVERAGE_DATA.length){
    const panel=document.getElementById('serviceDataWarning');
    if(panel) panel.innerHTML='No se pudo cargar <strong>Cobertura_SS.csv</strong>. Verifica que el archivo esté publicado en WordPress con ese nombre exacto y que contenga columnas de Servicio de Salud, Grupo y Cobertura.';
    return;
  }

  const warning=document.getElementById('serviceDataWarning');
  if(warning) warning.style.display='none';

  setupServiceControls();
  const rows=serviceRowsForCurrentFilters();
  if(!rows.length){
    if(warning){
      warning.style.display='block';
      warning.innerHTML='No hay registros para el filtro seleccionado.';
    }
    return;
  }
  if(!selectedService || (selectedService!=='__TOTAL_PAIS__' && !rows.some(r=>r.Servicio===selectedService))) selectedService='__TOTAL_PAIS__';

  const serviceSel=document.getElementById('territoryServiceSelect');
  if(serviceSel) serviceSel.value=selectedService || '__TOTAL_PAIS__';

  const rankingRows=[...rows].sort((a,b)=>(+b.Cobertura||0)-(+a.Cobertura||0) || serviceDisplayOrderSort(a,b));
  renderServiceKpis(rankingRows);
  renderServiceTable(rankingRows);
  renderTerritoryHorizontalChart('serviceRankChart', rankingRows, 'Servicio');
  renderTerritoryHorizontalChart('serviceGroupChart', selectedService==='__TOTAL_PAIS__' ? serviceAggregateGroups() : serviceAllGroups(selectedService), selectedService==='__TOTAL_PAIS__' ? 'Servicio' : 'Grupo');
  renderServiceMap(rankingRows);
}





/* V9 FINAL · Mapa geográfico oficial por Servicio de Salud
   Capa oficial IDE-MINSAL optimizada y publicada en WordPress como JSON/GeoJSON. */
let oiServiceLeafletMap=null;
let oiServiceGeoLayer=null;
let oiServiceSelectedLayer=null;
let oiServiceGeoJsonCache=null;
let oiServiceNationalBounds=null;
let oiServiceResetControl=null;
let oiServiceMapFocused=false;

const OI_SERVICE_GEOJSON_URL='https://vacunas.minsal.cl/wp-content/uploads/2026/06/Limites_Servicios_Salud_optimizado.json';

const OI_SERVICE_GEO_TO_CSV = {
  'arica':'arica',
  'iquique':'tarapaca',
  'antofagasta':'antofagasta',
  'atacama':'atacama',
  'coquimbo':'coquimbo',
  'valparaiso san antonio':'valparaiso san antonio',
  'vina del mar quillota':'vina del mar quillota',
  'aconcagua':'aconcagua',
  'metropolitano norte':'metropolitano norte',
  'metropolitano occidente':'metropolitano occidente',
  'metropolitano central':'metropolitano central',
  'metropolitano oriente':'metropolitano oriente',
  'metropolitano sur':'metropolitano sur',
  'metropolitano suroriente':'metropolitano sur oriente',
  'metropolitano sur oriente':'metropolitano sur oriente',
  'libertador b ohiggins':'ohiggins',
  'del maule':'del maule',
  'maule':'del maule',
  'nuble':'nuble',
  'concepcion':'concepcion',
  'talcahuano':'talcahuano',
  'biobio':'biobio',
  'arauco':'arauco',
  'araucania sur':'araucania sur',
  'araucania norte':'araucania norte',
  'valdivia':'los rios',
  'los rios':'los rios',
  'osorno':'osorno',
  'del reloncavi':'del reloncavi',
  'chiloe':'chiloe',
  'aysen':'aysen',
  'magallanes':'magallanes'
};


function oiServicePolygonMaxLon(poly){
  let max=-999;
  (poly||[]).forEach(ring=>{
    (ring||[]).forEach(pt=>{
      if(Array.isArray(pt) && Number.isFinite(+pt[0])) max=Math.max(max,+pt[0]);
    });
  });
  return max;
}

function oiServicePrepareGeoJsonForWeb(geojson){
  /*
    La capa oficial incluye territorios insulares muy alejados del continente.
    Al calcular el encuadre nacional con esos polígonos, Chile continental queda
    demasiado pequeño o fuera de lectura visual. Para el tablero web se mantiene
    la jurisdicción continental de cada SS y se excluyen polígonos insulares del
    Pacífico occidental a -76° de longitud. Esto mejora el encuadre y evita que
    el mapa aparezca “vacío” en WordPress.
  */
  const LON_LIMIT=-76;
  if(!geojson || !Array.isArray(geojson.features)) return geojson;
  const features=[];
  geojson.features.forEach(f=>{
    const g=f.geometry;
    if(!g || !g.coordinates) return;
    if(g.type==='Polygon'){
      if(oiServicePolygonMaxLon(g.coordinates)>LON_LIMIT){
        features.push({...f, geometry:{...g, coordinates:g.coordinates}});
      }
      return;
    }
    if(g.type==='MultiPolygon'){
      const kept=(g.coordinates||[]).filter(poly=>oiServicePolygonMaxLon(poly)>LON_LIMIT);
      if(kept.length){
        features.push({...f, geometry:{...g, coordinates:kept}});
      }
      return;
    }
    features.push(f);
  });
  return {...geojson, features};
}

async function oiGetServiceGeoJson(){
  if(oiServiceGeoJsonCache) return oiServiceGeoJsonCache;
  const response=await fetch(OI_SERVICE_GEOJSON_URL,{cache:'force-cache'});
  if(!response.ok) throw new Error(`No fue posible cargar GeoJSON SS (${response.status})`);
  oiServiceGeoJsonCache=oiServicePrepareGeoJsonForWeb(await response.json());
  return oiServiceGeoJsonCache;
}

function oiServiceFeatureRawName(feature){
  const p=feature.properties||{};
  const keys=['NOM_SS','COD_SS','Servicio','SERVICIO','SERV_SALUD','SERVICIO_S','NOMBRE','Nombre','nom_serv','NOM_SERV','SS','name','Name'];
  for(const k of keys){ if(p[k]!==undefined && p[k]!==null && String(p[k]).trim()!=='') return String(p[k]); }
  return Object.values(p).find(v=>typeof v==='string') || '';
}

function oiServiceFeatureKey(feature){
  const raw=oiServiceFeatureRawName(feature);
  const key=normalizeServiceKey(raw);
  return OI_SERVICE_GEO_TO_CSV[key] || key;
}

function oiServiceFeatureDisplayName(feature){
  const raw=oiServiceFeatureRawName(feature);
  if(!raw) return 'Servicio de Salud';
  const key=oiServiceFeatureKey(feature);
  const row=SERVICE_COVERAGE_DATA.find(x=>normalizeServiceKey(x.Servicio)===key);
  if(row) return row.Servicio;
  return 'SS '+String(raw).toLowerCase().replace(/\b\w/g,c=>c.toUpperCase()).replace('Ohiggins',"O'Higgins").replace('Biobio','Biobío').replace('Nuble','Ñuble');
}

function oiServiceRowByFeature(feature, rows){
  const fKey=oiServiceFeatureKey(feature);
  if(!fKey) return null;
  let d=rows.find(x=>normalizeServiceKey(x.Servicio)===fKey);
  if(!d) d=rows.find(x=>fKey.includes(normalizeServiceKey(x.Servicio)) || normalizeServiceKey(x.Servicio).includes(fKey));
  return d||null;
}

function oiServiceLayerDefaultStyle(feature, rows){
  const d=oiServiceRowByFeature(feature,rows);
  return {
    color:'#ffffff',
    weight:1.15,
    opacity:1,
    fillColor:d?oiCoverageColor(d.Cobertura):'#b8c7d6',
    fillOpacity:d?0.92:0.34
  };
}

function oiServiceTooltipHtml(name,d){
  if(!d) return `<div class="oi-service-tooltip"><strong>${name||'Servicio de Salud'}</strong><span>Estado <b>Sin dato vinculado</b></span></div>`;
  return `<div class="oi-service-tooltip"><strong>${d.Servicio}</strong><span>Región <b>${d.Region||'--'}</b></span><span>Grupo <b>${d.Grupo}</b></span><span>Cobertura <b>${fmtPct(d.Cobertura)}</b></span><span>Vacunados <b>${fmtNum.format(d.Vacunados||0)}</b></span><span>Brecha 85% <b>${fmtNum.format(territoryGap(d,85))}</b></span></div>`;
}

function oiSetServiceResetVisible(visible){
  oiServiceMapFocused=!!visible;
  const btn=document.querySelector('.oi-map-reset-service-btn');
  if(btn) btn.classList.toggle('is-visible',!!visible);
}

function oiResetServiceMapView(){
  if(!oiServiceLeafletMap) return;
  const bounds=oiServiceNationalBounds || (oiServiceGeoLayer?oiServiceGeoLayer.getBounds():null);
  if(bounds){ try{oiServiceLeafletMap.fitBounds(bounds,{padding:[20,20]});}catch(e){} }
  else oiServiceLeafletMap.setView([-35.5,-71],4);
  oiSetServiceResetVisible(false);
}

function oiAddServiceResetControl(){
  if(!window.L || !oiServiceLeafletMap) return;
  if(oiServiceResetControl){try{oiServiceLeafletMap.removeControl(oiServiceResetControl);}catch(e){} oiServiceResetControl=null;}
  const ResetControl=L.Control.extend({
    options:{position:'topleft'},
    onAdd:function(){
      const wrap=L.DomUtil.create('div','leaflet-control oi-map-reset-control');
      const btn=L.DomUtil.create('button','oi-map-reset-service-btn',wrap);
      btn.type='button';
      btn.innerHTML='<span aria-hidden="true">🏠</span><strong>Chile completo</strong>';
      btn.title='Restablecer vista nacional de Servicios de Salud';
      btn.setAttribute('aria-label','Restablecer vista nacional de Servicios de Salud');
      L.DomEvent.disableClickPropagation(wrap);
      L.DomEvent.disableScrollPropagation(wrap);
      L.DomEvent.on(btn,'click',function(ev){L.DomEvent.preventDefault(ev);oiResetServiceMapView();});
      return wrap;
    }
  });
  oiServiceResetControl=new ResetControl();
  oiServiceResetControl.addTo(oiServiceLeafletMap);
  oiSetServiceResetVisible(false);
}

function oiServiceSelectFromMap(d, layer){
  if(!d) return;
  selectedService=d.Servicio;
  const sel=document.getElementById('territoryServiceSelect');
  if(sel) sel.value=selectedService;
  renderServiceView();
  setTimeout(()=>{
    if(layer && oiServiceLeafletMap){
      try{oiServiceLeafletMap.fitBounds(layer.getBounds(),{padding:[30,30]});oiSetServiceResetVisible(true);}catch(e){}
    }
  },120);
}

function oiRefreshServiceMapStyles(rows){
  if(!oiServiceGeoLayer) return;
  oiServiceSelectedLayer=null;
  oiServiceGeoLayer.eachLayer(layer=>{
    const d=oiServiceRowByFeature(layer.feature,rows);
    const name=d?d.Servicio:oiServiceFeatureDisplayName(layer.feature);
    layer.unbindTooltip();
    layer.bindTooltip(oiServiceTooltipHtml(name,d),{sticky:true,direction:'top',opacity:1,className:'oi-region-tooltip-wrap'});
    layer.setStyle(oiServiceLayerDefaultStyle(layer.feature,rows));
    if(d && selectedService && selectedService!=='__TOTAL_PAIS__' && normalizeServiceKey(d.Servicio)===normalizeServiceKey(selectedService)){
      oiServiceSelectedLayer=layer;
      layer.setStyle({weight:3.2,color:'#003b71',fillOpacity:1});
      if(layer.bringToFront) layer.bringToFront();
    }
  });
}

function renderServiceMap(rows){
  const el=document.getElementById('serviceMap');
  if(!el) return;
  if(!rows || !rows.length){el.innerHTML='<div class="warning-note">No hay datos para construir el mapa.</div>';return;}

  if(oiServiceLeafletMap && oiServiceGeoLayer){
    oiRefreshServiceMapStyles(rows);
    setTimeout(()=>oiServiceLeafletMap&&oiServiceLeafletMap.invalidateSize(),80);
    return;
  }

  el.innerHTML='<div class="oi-service-map-loading">Cargando capa oficial de Servicios de Salud…</div>';
  Promise.all([oiEnsureLeaflet(),oiGetServiceGeoJson()]).then(([,geojson])=>{
    if(!document.getElementById('serviceMap')) return;
    if(oiServiceLeafletMap){try{oiServiceLeafletMap.remove();}catch(e){} oiServiceLeafletMap=null;oiServiceGeoLayer=null;oiServiceSelectedLayer=null;}
    el.innerHTML='';
    oiServiceLeafletMap=L.map('serviceMap',{zoomControl:true,attributionControl:true,scrollWheelZoom:false});
    L.control.attribution({prefix:false}).addTo(oiServiceLeafletMap).addAttribution('Capa: IDE-MINSAL');

    const legend=L.control({position:'bottomright'});
    legend.onAdd=function(){
      const div=L.DomUtil.create('div','oi-service-map-legend');
      div.innerHTML='<strong>Cobertura</strong><span><i style="background:#047857"></i>≥85%</span><span><i style="background:#f59e0b"></i>75–84,9%</span><span><i style="background:#ef3340"></i>&lt;75%</span><span><i style="background:#b8c7d6"></i>Sin dato</span>';
      return div;
    };
    legend.addTo(oiServiceLeafletMap);

    oiServiceGeoLayer=L.geoJSON(geojson,{
      style:function(feature){return oiServiceLayerDefaultStyle(feature,rows);},
      onEachFeature:function(feature,layer){
        const d=oiServiceRowByFeature(feature,rows);
        const name=d?d.Servicio:oiServiceFeatureDisplayName(feature);
        layer.bindTooltip(oiServiceTooltipHtml(name,d),{sticky:true,direction:'top',opacity:1,className:'oi-region-tooltip-wrap'});
        layer.on('mouseover',function(){this.setStyle({weight:2.6,fillOpacity:1});if(this.bringToFront)this.bringToFront();});
        layer.on('mouseout',function(){if(this!==oiServiceSelectedLayer){this.setStyle(oiServiceLayerDefaultStyle(feature,serviceRowsForCurrentFilters()));}});
        layer.on('click',function(){const row=oiServiceRowByFeature(feature,serviceRowsForCurrentFilters());oiServiceSelectFromMap(row,this);});
      }
    }).addTo(oiServiceLeafletMap);

    try{oiServiceNationalBounds=oiServiceGeoLayer.getBounds();oiServiceLeafletMap.fitBounds(oiServiceNationalBounds,{padding:[18,18]});}
    catch(e){oiServiceNationalBounds=null;oiServiceLeafletMap.setView([-35.5,-71],4);}
    oiAddServiceResetControl();
    oiRefreshServiceMapStyles(rows);
    setTimeout(()=>oiServiceLeafletMap&&oiServiceLeafletMap.invalidateSize(),250);
  }).catch(err=>{
    console.error('Mapa SS final:',err);
    el.innerHTML='<div class="warning-note"><strong>No fue posible cargar el mapa oficial.</strong><br>Verifica que el archivo <strong>Limites_Servicios_Salud_optimizado.json</strong> esté publicado en la carpeta de medios de junio 2026.</div>';
  });
}

/* V6.6 · Asegura actualización de vista por Servicio de Salud después de cada redibujado */
const _drawAllServiceV66 = typeof drawAll === 'function' ? drawAll : null;
if(_drawAllServiceV66){
  drawAll = function(){
    _drawAllServiceV66();
    renderServiceView();
  };
}

(function initServiceViewV66(){
  const run=()=>{
    setupServiceControls();
    if(document.getElementById('oiViewTerritoryService')?.classList.contains('oi-view-active')){
      renderServiceView();
    }
  };
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',run); else setTimeout(run,120);
})();


/* =========================
   V6.7 · Mapa regional real Leaflet/GeoJSON para Influenza
   Base adaptada desde el visor MPox, con exclusión de islas remotas de Valparaíso.
   Fuente de datos: Cobertura_Regiones.csv
   ========================= */

const OI_LEAFLET_CSS = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
const OI_LEAFLET_JS = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
const OI_GEOJSON_URLS = [
  'https://raw.githubusercontent.com/caracena/chile-geojson/master/regiones.json',
  'https://cdn.jsdelivr.net/gh/caracena/chile-geojson@master/regiones.json'
];

let oiRegionLeafletMap = null;
let oiRegionGeoLayer = null;
let oiRegionSelectedLayer = null;
let oiGeoJsonCache = null;
let oiLeafletPromise = null;
let oiRegionNationalBounds = null;
let oiRegionResetControl = null;
let oiRegionMapIsFocused = false;

const OI_REGION_ORDER = [
  'Arica y Parinacota','Tarapacá','Antofagasta','Atacama','Coquimbo',
  'Valparaíso','Metropolitana',"O'Higgins",'Maule','Ñuble','Biobío',
  'Araucanía','Los Ríos','Los Lagos','Aysén','Magallanes'
];

function oiEnsureLeaflet(){
  if(window.L && window.L.geoJSON) return Promise.resolve();
  if(oiLeafletPromise) return oiLeafletPromise;
  oiLeafletPromise = new Promise((resolve,reject)=>{
    if(!document.querySelector('link[data-oi-leaflet]')){
      const link=document.createElement('link');
      link.rel='stylesheet';
      link.href=OI_LEAFLET_CSS;
      link.setAttribute('data-oi-leaflet','1');
      document.head.appendChild(link);
    }
    const existing=document.querySelector('script[data-oi-leaflet]');
    if(existing){
      existing.addEventListener('load',()=>resolve());
      existing.addEventListener('error',()=>reject(new Error('No se pudo cargar Leaflet.')));
      return;
    }
    const s=document.createElement('script');
    s.src=OI_LEAFLET_JS;
    s.async=true;
    s.defer=true;
    s.setAttribute('data-oi-leaflet','1');
    s.onload=()=>resolve();
    s.onerror=()=>reject(new Error('No se pudo cargar Leaflet.'));
    document.head.appendChild(s);
  });
  return oiLeafletPromise;
}

async function oiFetchFirstJson(urls){
  let lastErr;
  for(const url of urls){
    try{
      const r=await fetch(url,{cache:'no-store'});
      if(!r.ok) throw new Error('HTTP '+r.status);
      return await r.json();
    }catch(e){ lastErr=e; }
  }
  throw lastErr || new Error('No se pudo cargar GeoJSON regional.');
}

async function oiGetGeoJson(){
  if(oiGeoJsonCache) return oiGeoJsonCache;
  const raw=await oiFetchFirstJson(OI_GEOJSON_URLS);
  oiGeoJsonCache=oiRemoveValparaisoRemoteIslands(raw);
  return oiGeoJsonCache;
}

function oiRegionKey(name){
  const canonical = normalizeRegionName(name);
  return String(canonical||'')
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g,'')
    .replace(/[’'´`]/g,'')
    .replace(/[^a-z0-9]+/g,'')
    .trim();
}

function oiRegionNameFromCode(code){
  const c = String(code ?? '').trim().replace(/^0+/,'');
  const map = {
    '15':'Arica y Parinacota',
    '1':'Tarapacá',
    '2':'Antofagasta',
    '3':'Atacama',
    '4':'Coquimbo',
    '5':'Valparaíso',
    '13':'Metropolitana',
    '6':"O'Higgins",
    '7':'Maule',
    '16':'Ñuble',
    '8':'Biobío',
    '9':'Araucanía',
    '14':'Los Ríos',
    '10':'Los Lagos',
    '11':'Aysén',
    '12':'Magallanes'
  };
  return map[c] || null;
}

function oiFeatureCanonicalRegion(feature){
  const p = feature.properties || {};
  const codeKeys = ['CUT_REG','cut_reg','COD_REG','cod_reg','codregion','Codigo','codigo','REGION_ID','region_id'];
  for(const k of codeKeys){
    if(p[k] !== undefined && p[k] !== null && String(p[k]).trim() !== ''){
      const byCode = oiRegionNameFromCode(p[k]);
      if(byCode) return byCode;
    }
  }
  return normalizeRegionName(oiGetFeatureName(feature));
}

function oiRegionSort(a,b){
  const ia=OI_REGION_ORDER.indexOf(a.Region || a);
  const ib=OI_REGION_ORDER.indexOf(b.Region || b);
  if(ia>=0 && ib>=0) return ia-ib;
  if(ia>=0) return -1;
  if(ib>=0) return 1;
  return String(a.Region||a).localeCompare(String(b.Region||b),'es');
}

function oiGetFeatureName(feature){
  const p=feature.properties||{};
  const keys=['Region','REGION','NOM_REG','NOMBRE','Nombre','nom_reg','name','NAME','CUT_REG'];
  for(const k of keys){ if(p[k]) return String(p[k]); }
  return Object.values(p).find(v=>typeof v==='string') || 'Región';
}

function oiFeatureIsValparaiso(feature){
  return oiRegionKey(oiFeatureCanonicalRegion(feature)).includes('valparaiso');
}

function oiPolygonMaxLon(poly){
  let maxLon=-Infinity;
  const scan=(arr)=>{
    if(!Array.isArray(arr)) return;
    if(typeof arr[0]==='number' && typeof arr[1]==='number'){
      if(arr[0]>maxLon) maxLon=arr[0];
      return;
    }
    arr.forEach(scan);
  };
  scan(poly);
  return maxLon;
}

function oiRemoveValparaisoRemoteIslands(geojson){
  const clone=JSON.parse(JSON.stringify(geojson));
  const features=Array.isArray(clone.features)?clone.features:[];
  const MAINLAND_LON_LIMIT=-76;
  features.forEach(feature=>{
    if(!feature || !feature.geometry || !oiFeatureIsValparaiso(feature)) return;
    const geom=feature.geometry;
    if(geom.type==='MultiPolygon'){
      geom.coordinates=geom.coordinates.filter(poly=>oiPolygonMaxLon(poly)>MAINLAND_LON_LIMIT);
    }
    if(geom.type==='Polygon' && oiPolygonMaxLon(geom.coordinates)<=MAINLAND_LON_LIMIT){
      geom.coordinates=[];
    }
  });
  clone.features=features.filter(feature=>{
    if(!feature.geometry) return false;
    if(feature.geometry.type==='MultiPolygon') return feature.geometry.coordinates.length>0;
    if(feature.geometry.type==='Polygon') return feature.geometry.coordinates.length>0;
    return true;
  });
  return clone;
}

function oiCoverageColor(v){
  if(v>=85) return '#047857';
  if(v>=75) return '#f59e0b';
  if(v>0) return '#ef3340';
  return '#b8c7d6';
}

function oiRowByFeature(feature, rows){
  const featureName = oiFeatureCanonicalRegion(feature);
  const featureKey = oiRegionKey(featureName);
  let d = rows.find(x => oiRegionKey(x.Region) === featureKey);
  if(!d) d = rows.find(x => featureKey.includes(oiRegionKey(x.Region)) || oiRegionKey(x.Region).includes(featureKey));
  return d || null;
}

function oiTooltipHtml(name,d){
  if(!d){
    return `<div class="oi-region-tooltip"><strong>${name}</strong><span>Estado <b>Sin dato vinculado</b></span></div>`;
  }
  return `<div class="oi-region-tooltip"><strong>${d.Region}</strong>
    <span>Grupo <b>${d.Grupo}</b></span>
    <span>Cobertura <b>${fmtPct(d.Cobertura)}</b></span>
    <span>Vacunados <b>${fmtNum.format(d.Vacunados || 0)}</b></span>
    <span>Brecha 85% <b>${fmtNum.format(territoryGap(d,85))}</b></span>
  </div>`;
}

function oiSetResetViewVisible(visible){
  oiRegionMapIsFocused = !!visible;
  const btn=document.querySelector('.oi-map-reset-view-btn');
  if(btn) btn.classList.toggle('is-visible', !!visible);
}

function oiResetRegionalMapView(){
  if(!oiRegionLeafletMap) return;
  const bounds = oiRegionNationalBounds || (oiRegionGeoLayer ? oiRegionGeoLayer.getBounds() : null);
  if(bounds){
    try{ oiRegionLeafletMap.fitBounds(bounds,{padding:[18,18]}); }catch(e){}
  }else{
    oiRegionLeafletMap.setView([-35.5,-71],4);
  }
  oiSetResetViewVisible(false);
}

function oiAddResetViewControl(){
  if(!window.L || !oiRegionLeafletMap) return;
  if(oiRegionResetControl){
    try{ oiRegionLeafletMap.removeControl(oiRegionResetControl); }catch(e){}
    oiRegionResetControl=null;
  }
  const ResetControl = L.Control.extend({
    options:{position:'topleft'},
    onAdd:function(){
      const wrap=L.DomUtil.create('div','leaflet-control oi-map-reset-control');
      const btn=L.DomUtil.create('button','oi-map-reset-view-btn',wrap);
      btn.type='button';
      btn.innerHTML='<span aria-hidden="true">🏠</span><strong>Chile completo</strong>';
      btn.title='Restablecer vista nacional';
      btn.setAttribute('aria-label','Restablecer vista nacional');
      L.DomEvent.disableClickPropagation(wrap);
      L.DomEvent.disableScrollPropagation(wrap);
      L.DomEvent.on(btn,'click',function(ev){
        L.DomEvent.preventDefault(ev);
        oiResetRegionalMapView();
      });
      return wrap;
    }
  });
  oiRegionResetControl = new ResetControl();
  oiRegionResetControl.addTo(oiRegionLeafletMap);
  oiSetResetViewVisible(false);
}

// Reemplaza el antiguo listado tipo "tiles" por mapa geográfico real.
function renderRegionalMap(rows){
  const el=document.getElementById('regionMap');
  if(!el) return;
  if(!rows.length){
    el.innerHTML='<div class="warning-note">No hay datos regionales disponibles.</div>';
    return;
  }

  el.innerHTML='<div class="oi-map-loading">Cargando mapa geográfico regional…</div>';

  Promise.all([oiEnsureLeaflet(), oiGetGeoJson()]).then(([,geojson])=>{
    if(!document.getElementById('regionMap')) return;
    if(oiRegionLeafletMap){
      oiRegionLeafletMap.remove();
      oiRegionLeafletMap=null;
      oiRegionGeoLayer=null;
      oiRegionSelectedLayer=null;
      oiRegionNationalBounds=null;
      oiRegionResetControl=null;
      oiRegionMapIsFocused=false;
    }
    el.innerHTML='';
    oiRegionLeafletMap=L.map('regionMap',{zoomControl:true,attributionControl:true,scrollWheelZoom:false});
    L.control.attribution({prefix:false}).addTo(oiRegionLeafletMap).addAttribution('GeoJSON público: caracena/chile-geojson');

    oiRegionGeoLayer=L.geoJSON(geojson,{
      style:function(feature){
        const d=oiRowByFeature(feature,rows);
        return {
          color:'#ffffff',
          weight:1.15,
          opacity:1,
          fillColor:d?oiCoverageColor(d.Cobertura):'#b8c7d6',
          fillOpacity:d?0.92:0.35
        };
      },
      onEachFeature:function(feature,layer){
        const d=oiRowByFeature(feature,rows);
        const name=d?d.Region:oiFeatureCanonicalRegion(feature);
        layer.bindTooltip(oiTooltipHtml(name,d),{sticky:true,direction:'top',opacity:1,className:'oi-region-tooltip-wrap'});
        layer.on('mouseover',function(){ this.setStyle({weight:2.4,fillOpacity:1}); });
        layer.on('mouseout',function(){ if(this!==oiRegionSelectedLayer && oiRegionGeoLayer) oiRegionGeoLayer.resetStyle(this); });
        layer.on('click',function(){
          if(!d) return;
          if(oiRegionSelectedLayer && oiRegionGeoLayer) oiRegionGeoLayer.resetStyle(oiRegionSelectedLayer);
          oiRegionSelectedLayer=this;
          this.setStyle({weight:3,color:'#003b71',fillOpacity:1});
          selectedRegion=d.Region;
          const sel=document.getElementById('territoryRegionSelect');
          if(sel) sel.value=selectedRegion;
          renderRegionalKpis(rows);
          renderRegionalTable(rows);
          renderTerritoryHorizontalChart('regionGroupChart',regionAllGroups(selectedRegion),'Grupo');
          try{
            oiRegionLeafletMap.fitBounds(this.getBounds(),{padding:[30,30]});
            oiSetResetViewVisible(true);
          }catch(e){}
        });
      }
    }).addTo(oiRegionLeafletMap);

    try{
      oiRegionNationalBounds = oiRegionGeoLayer.getBounds();
      oiRegionLeafletMap.fitBounds(oiRegionNationalBounds,{padding:[18,18]});
    }
    catch(e){
      oiRegionNationalBounds = null;
      oiRegionLeafletMap.setView([-35.5,-71],4);
    }
    oiAddResetViewControl();

    // Marca visualmente la región actualmente seleccionada.
    oiRegionGeoLayer.eachLayer(layer=>{
      const d=oiRowByFeature(layer.feature,rows);
      if(d && d.Region===selectedRegion){
        oiRegionSelectedLayer=layer;
        layer.setStyle({weight:3,color:'#003b71',fillOpacity:1});
      }
    });
    setTimeout(()=>oiRegionLeafletMap && oiRegionLeafletMap.invalidateSize(),250);
  }).catch(err=>{
    console.error('Mapa regional Influenza:',err);
    el.innerHTML='<div class="warning-note">No fue posible cargar el mapa GeoJSON. Revise conexión, CORS o bloqueo de recursos externos.</div>';
  });
}

// Reordena selectores regionales en orden nacional norte-sur.
function setupRegionalControls(){
  const groupSel=document.getElementById('territoryRegionGroupSelect');
  const regionSel=document.getElementById('territoryRegionSelect');
  if(!groupSel || !regionSel || !REGION_COVERAGE_DATA.length) return;

  const groups=[...new Set(REGION_COVERAGE_DATA.map(d=>d.Grupo))];
  const preferred=groups.includes('Total')?'Total':groups[0];
  if(!selectedRegionGroup || !groups.includes(selectedRegionGroup)) selectedRegionGroup=preferred;

  groupSel.innerHTML=groups.map(g=>`<option value="${g}">${g}</option>`).join('');
  groupSel.value=selectedRegionGroup;
  groupSel.onchange=()=>{
    selectedRegionGroup=groupSel.value;
    const rows=regionalRowsForGroup();
    if(rows.length && !rows.some(r=>r.Region===selectedRegion)) selectedRegion=rows[0].Region;
    renderRegionalView();
  };

  const regions=[...new Set(REGION_COVERAGE_DATA.map(d=>d.Region))].sort((a,b)=>oiRegionSort(a,b));
  if(!selectedRegion || !regions.includes(selectedRegion)){
    const totalRows=regionalRowsForGroup();
    const orderedRows=[...totalRows].sort(oiRegionSort);
    selectedRegion=orderedRows.length?orderedRows[0].Region:regions[0];
  }

  regionSel.innerHTML=regions.map(r=>`<option value="${r}">${r}</option>`).join('');
  regionSel.value=selectedRegion;
  regionSel.onchange=()=>{
    selectedRegion=regionSel.value;
    renderRegionalView();
  };
}

// Mantiene ranking de mayor a menor, pero evita redibujar el mapa innecesariamente fuera de la vista regional.
function renderRegionalView(){
  if(!REGION_COVERAGE_DATA.length){
    const map=document.getElementById('regionMap');
    if(map) map.innerHTML='<div class="warning-note">No se pudo cargar Cobertura_Regiones.csv. Sube el archivo a WordPress con ese nombre exacto.</div>';
    return;
  }

  setupRegionalControls();
  const rows=regionalRowsForGroup();
  if(!rows.length) return;
  if(!selectedRegion || !rows.some(r=>r.Region===selectedRegion)) selectedRegion=rows[0].Region;

  const regionSel=document.getElementById('territoryRegionSelect');
  if(regionSel) regionSel.value=selectedRegion;

  renderRegionalKpis(rows);
  renderRegionalTable(rows);
  renderTerritoryHorizontalChart('regionRankChart',rows,'Region');
  renderTerritoryHorizontalChart('regionGroupChart',regionAllGroups(selectedRegion),'Grupo');
  if(document.getElementById('oiViewTerritoryRegion')?.classList.contains('oi-view-active')){
    renderRegionalMap(rows);
  }
}

/* =========================
   Corrección FINAL SVG · mapa SS visible sin dependencia de Leaflet
   ========================= */
let oiServiceSvgGeoCache = null;

function oiServiceGeoJsonCoordinates(feature){
  const g = feature && feature.geometry;
  if(!g || !g.coordinates) return [];
  return g.coordinates;
}

function oiServiceWalkCoords(coords, cb){
  if(!Array.isArray(coords)) return;
  if(typeof coords[0] === 'number' && typeof coords[1] === 'number'){
    cb(+coords[0], +coords[1]);
    return;
  }
  coords.forEach(c => oiServiceWalkCoords(c, cb));
}

function oiServiceSvgBounds(geojson){
  let minLon=999, maxLon=-999, minLat=999, maxLat=-999;
  (geojson.features || []).forEach(f => {
    oiServiceWalkCoords(oiServiceGeoJsonCoordinates(f), (lon,lat) => {
      if(!Number.isFinite(lon) || !Number.isFinite(lat)) return;
      minLon = Math.min(minLon, lon);
      maxLon = Math.max(maxLon, lon);
      minLat = Math.min(minLat, lat);
      maxLat = Math.max(maxLat, lat);
    });
  });
  if(minLon===999) return {minLon:-76,maxLon:-66,minLat:-56,maxLat:-17};
  return {minLon,maxLon,minLat,maxLat};
}

function oiServiceSvgPathForRing(ring, project){
  if(!Array.isArray(ring) || !ring.length) return '';
  let d='';
  ring.forEach((pt,i)=>{
    if(!Array.isArray(pt) || pt.length<2) return;
    const p=project(+pt[0], +pt[1]);
    d += (i===0 ? 'M' : 'L') + p.x.toFixed(2) + ',' + p.y.toFixed(2);
  });
  return d ? d + 'Z' : '';
}

function oiServiceSvgPath(feature, project){
  const g=feature.geometry || {};
  if(g.type === 'Polygon'){
    return (g.coordinates || []).map(ring => oiServiceSvgPathForRing(ring, project)).join(' ');
  }
  if(g.type === 'MultiPolygon'){
    return (g.coordinates || []).map(poly => (poly || []).map(ring => oiServiceSvgPathForRing(ring, project)).join(' ')).join(' ');
  }
  return '';
}

function oiServiceSvgColor(row){
  if(!row) return '#cbd5e1';
  return oiCoverageColor(row.Cobertura);
}

function oiServiceSvgRender(el, geojson, rows){
  const w=620, h=820;
  const pad={l:28,r:28,t:22,b:24};
  const b=oiServiceSvgBounds(geojson);
  const iw=w-pad.l-pad.r, ih=h-pad.t-pad.b;
  const lonSpan=Math.max(0.01,b.maxLon-b.minLon);
  const latSpan=Math.max(0.01,b.maxLat-b.minLat);
  const scale=Math.min(iw/lonSpan, ih/latSpan);
  const drawW=lonSpan*scale, drawH=latSpan*scale;
  const offX=pad.l+(iw-drawW)/2;
  const offY=pad.t+(ih-drawH)/2;
  const project=(lon,lat)=>({
    x:offX+(lon-b.minLon)*scale,
    y:offY+(b.maxLat-lat)*scale
  });

  const currentKey = selectedService && selectedService !== '__TOTAL_PAIS__' ? normalizeServiceKey(selectedService) : '';
  const rankRows=[...rows].sort((a,b)=>(+b.Cobertura||0)-(+a.Cobertura||0));
  const rankMap=new Map(rankRows.map((r,i)=>[normalizeServiceKey(r.Servicio), i+1]));

  const paths=(geojson.features || []).map((feature,idx)=>{
    const row=oiServiceRowByFeature(feature, rows);
    const name=row ? row.Servicio : oiServiceFeatureDisplayName(feature);
    const key=row ? normalizeServiceKey(row.Servicio) : oiServiceFeatureKey(feature);
    const selected=currentKey && key===currentKey;
    const path=oiServiceSvgPath(feature, project);
    const color=oiServiceSvgColor(row);
    const title=row
      ? `${row.Servicio}\nRegión: ${row.Region || '--'}\nCobertura: ${fmtPct(row.Cobertura)}\nVacunados: ${fmtNum.format(row.Vacunados || 0)}\nBrecha 85%: ${fmtNum.format(territoryGap(row,85))}`
      : `${name}\nSin dato vinculado`;
    return `<path class="oi-service-svg-path${selected?' is-selected':''}" data-service="${row ? String(row.Servicio).replace(/"/g,'&quot;') : ''}" d="${path}" fill="${color}" stroke="${selected?'#003b71':'#ffffff'}" stroke-width="${selected?2.8:1.05}" opacity="${row?0.94:0.42}"><title>${title.replace(/&/g,'&amp;').replace(/</g,'&lt;')}</title></path>`;
  }).join('');

  const selectedLabel = selectedService === '__TOTAL_PAIS__' ? 'Vista nacional · Total país' : selectedService;
  el.innerHTML = `
    <div class="oi-service-svg-shell">
      <svg class="oi-service-svg-map" viewBox="0 0 ${w} ${h}" role="img" aria-label="Mapa de Chile por Servicio de Salud">
        <rect x="0" y="0" width="${w}" height="${h}" rx="20" fill="#f8fbff"></rect>
        <g>${paths}</g>
      </svg>
      <div class="oi-service-svg-caption">
        <strong>${selectedLabel}</strong>
        <span>Mapa oficial IDE-MINSAL simplificado para visualización web.</span>
      </div>
    </div>`;

  el.querySelectorAll('.oi-service-svg-path').forEach(path=>{
    path.addEventListener('mouseenter',()=>path.classList.add('is-hover'));
    path.addEventListener('mouseleave',()=>path.classList.remove('is-hover'));
    path.addEventListener('click',()=>{
      const service=path.getAttribute('data-service');
      if(!service) return;
      selectedService=service;
      const sel=document.getElementById('territoryServiceSelect');
      if(sel) sel.value=selectedService;
      renderServiceView();
    });
  });
}

renderServiceMap = function(rows){
  const el=document.getElementById('serviceMap');
  if(!el) return;
  if(!rows || !rows.length){el.innerHTML='<div class="warning-note">No hay datos para construir el mapa.</div>';return;}
  el.innerHTML='<div class="oi-service-map-loading">Cargando mapa oficial de Servicios de Salud…</div>';
  oiGetServiceGeoJson()
    .then(geojson=>{oiServiceSvgGeoCache=geojson; oiServiceSvgRender(el, geojson, rows);})
    .catch(err=>{
      console.error('Mapa SVG SS:',err);
      el.innerHTML='<div class="warning-note"><strong>No fue posible cargar el mapa oficial.</strong><br>Verifica la URL del archivo <strong>Limites_Servicios_Salud_optimizado.json</strong>.</div>';
    });
};


/* =========================
   Corrección V10 · SVG SS con O'Higgins vinculado + zoom por clic + restablecer vista
   ========================= */
if (typeof OI_SERVICE_GEO_TO_CSV !== 'undefined') {
  OI_SERVICE_GEO_TO_CSV['libertador b ohiggins'] = 'o higgins';
  OI_SERVICE_GEO_TO_CSV['libertador b o higgins'] = 'o higgins';
  OI_SERVICE_GEO_TO_CSV['ohiggins'] = 'o higgins';
  OI_SERVICE_GEO_TO_CSV['o higgins'] = 'o higgins';
}

let oiServiceSvgForceNational = false;
let oiServiceSvgLastSelected = null;

function oiServiceSvgFeatureBounds(feature){
  let minLon=999, maxLon=-999, minLat=999, maxLat=-999;
  oiServiceWalkCoords(oiServiceGeoJsonCoordinates(feature), (lon,lat) => {
    if(!Number.isFinite(lon) || !Number.isFinite(lat)) return;
    minLon=Math.min(minLon,lon); maxLon=Math.max(maxLon,lon);
    minLat=Math.min(minLat,lat); maxLat=Math.max(maxLat,lat);
  });
  if(minLon===999) return null;
  let lonPad=Math.max((maxLon-minLon)*0.18,0.12);
  let latPad=Math.max((maxLat-minLat)*0.18,0.12);
  return {minLon:minLon-lonPad,maxLon:maxLon+lonPad,minLat:minLat-latPad,maxLat:maxLat+latPad};
}

function oiServiceSvgNationalBoundsExpanded(geojson){
  const b=oiServiceSvgBounds(geojson);
  const lonPad=Math.max((b.maxLon-b.minLon)*0.05,0.25);
  const latPad=Math.max((b.maxLat-b.minLat)*0.03,0.25);
  return {minLon:b.minLon-lonPad,maxLon:b.maxLon+lonPad,minLat:b.minLat-latPad,maxLat:b.maxLat+latPad};
}

function oiServiceSvgSelectedFeature(geojson, rows){
  if(!selectedService || selectedService==='__TOTAL_PAIS__') return null;
  const currentKey=normalizeServiceKey(selectedService);
  return (geojson.features || []).find(feature=>{
    const row=oiServiceRowByFeature(feature, rows);
    const key=row ? normalizeServiceKey(row.Servicio) : oiServiceFeatureKey(feature);
    return key===currentKey;
  }) || null;
}

function oiServiceSvgStatusClass(row){
  if(!row) return 'sin-dato';
  if((+row.Cobertura||0)>=85) return 'ok';
  if((+row.Cobertura||0)>=75) return 'medio';
  return 'bajo';
}

function oiServiceSvgRender(el, geojson, rows){
  if(selectedService !== oiServiceSvgLastSelected){
    if(selectedService && selectedService !== '__TOTAL_PAIS__') oiServiceSvgForceNational = false;
    oiServiceSvgLastSelected = selectedService;
  }

  const w=640, h=820;
  const pad={l:30,r:30,t:24,b:28};
  const selectedFeature=(!oiServiceSvgForceNational) ? oiServiceSvgSelectedFeature(geojson, rows) : null;
  const focusBounds=selectedFeature ? oiServiceSvgFeatureBounds(selectedFeature) : null;
  const b=focusBounds || oiServiceSvgNationalBoundsExpanded(geojson);
  const iw=w-pad.l-pad.r, ih=h-pad.t-pad.b;
  const lonSpan=Math.max(0.01,b.maxLon-b.minLon);
  const latSpan=Math.max(0.01,b.maxLat-b.minLat);
  const scale=Math.min(iw/lonSpan, ih/latSpan);
  const drawW=lonSpan*scale, drawH=latSpan*scale;
  const offX=pad.l+(iw-drawW)/2;
  const offY=pad.t+(ih-drawH)/2;
  const project=(lon,lat)=>({x:offX+(lon-b.minLon)*scale,y:offY+(b.maxLat-lat)*scale});

  const currentKey = selectedService && selectedService !== '__TOTAL_PAIS__' ? normalizeServiceKey(selectedService) : '';
  const paths=(geojson.features || []).map((feature)=>{
    const row=oiServiceRowByFeature(feature, rows);
    const name=row ? row.Servicio : oiServiceFeatureDisplayName(feature);
    const key=row ? normalizeServiceKey(row.Servicio) : oiServiceFeatureKey(feature);
    const selected=currentKey && key===currentKey;
    const path=oiServiceSvgPath(feature, project);
    if(!path) return '';
    const color=oiServiceSvgColor(row);
    const serviceAttr=row ? String(row.Servicio).replace(/&/g,'&amp;').replace(/"/g,'&quot;') : '';
    const title=row
      ? `${row.Servicio}\nRegión: ${row.Region || '--'}\nCobertura: ${fmtPct(row.Cobertura)}\nVacunados: ${fmtNum.format(row.Vacunados || 0)}\nBrecha 85%: ${fmtNum.format(territoryGap(row,85))}`
      : `${name}\nSin dato vinculado`;
    return `<path class="oi-service-svg-path ${oiServiceSvgStatusClass(row)}${selected?' is-selected':''}" data-service="${serviceAttr}" d="${path}" fill="${color}" stroke="${selected?'#003b71':'#ffffff'}" stroke-width="${selected?3.2:1.05}" opacity="${row?0.95:0.38}"><title>${title.replace(/&/g,'&amp;').replace(/</g,'&lt;')}</title></path>`;
  }).join('');

  const selectedLabel = selectedService === '__TOTAL_PAIS__' ? 'Vista nacional · Total país' : selectedService;
  const zoomNote = focusBounds ? 'Vista acercada al Servicio de Salud seleccionado.' : 'Vista nacional de los territorios de Servicios de Salud.';
  const resetButton = focusBounds ? `<button type="button" class="oi-service-svg-reset" id="serviceMapResetViewBtn">↺ Restablecer vista</button>` : '';

  el.innerHTML = `
    <div class="oi-service-svg-shell">
      <div class="oi-service-svg-toolbar">${resetButton}</div>
      <svg class="oi-service-svg-map" viewBox="0 0 ${w} ${h}" role="img" aria-label="Mapa de Chile por Servicio de Salud">
        <rect x="0" y="0" width="${w}" height="${h}" rx="20" fill="#f8fbff"></rect>
        <g>${paths}</g>
      </svg>
      <div class="oi-service-svg-caption">
        <strong>${selectedLabel}</strong>
        <span>${zoomNote} Mapa oficial IDE-MINSAL simplificado para visualización web.</span>
      </div>
    </div>`;

  const reset=document.getElementById('serviceMapResetViewBtn');
  if(reset){
    reset.onclick=()=>{
      oiServiceSvgForceNational=true;
      oiServiceSvgRender(el, geojson, rows);
    };
  }

  el.querySelectorAll('.oi-service-svg-path').forEach(path=>{
    path.addEventListener('mouseenter',()=>path.classList.add('is-hover'));
    path.addEventListener('mouseleave',()=>path.classList.remove('is-hover'));
    path.addEventListener('click',()=>{
      const service=path.getAttribute('data-service');
      if(!service) return;
      oiServiceSvgForceNational=false;
      selectedService=service;
      const sel=document.getElementById('territoryServiceSelect');
      if(sel) sel.value=selectedService;
      renderServiceView();
    });
  });
}

renderServiceMap = function(rows){
  const el=document.getElementById('serviceMap');
  if(!el) return;
  if(!rows || !rows.length){el.innerHTML='<div class="warning-note">No hay datos para construir el mapa.</div>';return;}
  el.innerHTML='<div class="oi-service-map-loading">Cargando mapa oficial de Servicios de Salud…</div>';
  oiGetServiceGeoJson()
    .then(geojson=>{oiServiceSvgGeoCache=geojson; oiServiceSvgRender(el, geojson, rows);})
    .catch(err=>{
      console.error('Mapa SVG SS:',err);
      el.innerHTML='<div class="warning-note"><strong>No fue posible cargar el mapa oficial.</strong><br>Verifica la URL del archivo <strong>Limites_Servicios_Salud_optimizado.json</strong>.</div>';
    });
};



/* =========================
   Centro de reportes · versión segura
   No interfiere con la carga principal del tablero
   ========================= */
(function(){
  function qs(id){ return document.getElementById(id); }
  function setHTML(id, html){ const el=qs(id); if(el) el.innerHTML=html; }
  function setText(id, txt){ const el=qs(id); if(el) el.textContent=txt; }
  function n(v){ return Number(v)||0; }
  function pct(v){ return (typeof fmtPct==='function') ? fmtPct(v) : ((Number(v)||0).toFixed(2).replace('.',',')+'%'); }
  function num(v){ return (typeof fmtNum!=='undefined') ? fmtNum.format(Math.round(Number(v)||0)) : String(Math.round(Number(v)||0)); }
  function normText(s){ return String(s||'').toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,' ').trim(); }
  function statusLabel(v){ return v>=85?'Meta 85% alcanzada':(v>=75?'Entre 75% y 84,9%':'Bajo 75%'); }
  function statusClass(v){ return v>=85?'ok':(v>=75?'mid':'low'); }
  function reportMonthToken(m){
    return ['ene','feb','mar','abr','may','jun','jul','ago','sept','oct','nov','dic'][m] || '';
  }
  function formatReportGeneratedDate(d){
    const dt = d instanceof Date ? d : new Date();
    const dd = String(dt.getDate()).padStart(2,'0');
    return `${dd}-${reportMonthToken(dt.getMonth())}-${dt.getFullYear()}`;
  }
  function formatReportCutDate(fecha){
    return String(fecha || 'Último dato disponible').trim() || 'Último dato disponible';
  }
  function setReportDates(cutDate, generatedDate){
    const el = qs('reportDate');
    if(!el) return;
    el.innerHTML = `<span>Corte de datos</span><strong>${cutDate}</strong><span>Informe generado</span><strong>${generatedDate}</strong>`;
  }

  function kpi(icon,label,value,note){ return `<div class="oi-report-kpi"><span class="ri">${icon}</span><div><small>${label}</small><strong>${value}</strong><em style="display:block;color:#64748b;font-size:12px;font-style:normal;margin-top:4px">${note||''}</em></div></div>`; }
  function item(icon,html){ return `<div class="oi-report-item"><span>${icon}</span><div>${html}</div></div>`; }
  function barRows(rows,labelKey,valueKey,max=10){
    rows=(rows||[]).filter(r=>Number.isFinite(n(r[valueKey]))).slice(0,max);
    if(!rows.length) return '<div class="note">Sin datos disponibles para este filtro.</div>';
    return rows.map(r=>{
      const v=n(r[valueKey]);
      return `<div class="oi-report-bar-row"><span>${r[labelKey]||''}</span><div class="oi-report-bar-track"><div class="oi-report-bar-fill ${statusClass(v)}" style="width:${Math.max(3,Math.min(100,v))}%"></div></div><span style="text-align:right"><strong>${pct(v)}</strong></span></div>`;
    }).join('');
  }
  function getGroups(){
    const fromData=[...new Set((DATA||[]).map(d=>d.Grupo).filter(Boolean))];
    const fromGroup=[...new Set((GROUP_COVERAGE_DATA||[]).map(d=>d.Grupo).filter(Boolean))];
    return (typeof sortGroupsForDashboard==='function') ? sortGroupsForDashboard([...fromData,...fromGroup]) : [...new Set([...fromData,...fromGroup])].sort();
  }
  function latestNationalRow(groupName){
    const cy = (typeof currentYear === 'function') ? currentYear() : Math.max(...(DATA||[]).map(d=>n(d.Año)).filter(Boolean));
    let rows=(DATA||[])
      .filter(d=>n(d.Año)===cy && d.Grupo===groupName && (n(d.Cobertura)>0 || n(d.Vacunados_Acumulados)>0))
      .sort((a,b)=>n(a.Dia_Campaña)-n(b.Dia_Campaña));

    /*
      Importante: la base histórica puede contener días futuros precargados
      hasta diciembre con valores arrastrados. Para el reporte se debe usar
      el último día real de campaña, el mismo que alimenta el recuadro
      “Último dato 2026” del tablero principal.
    */
    let maxActual = 0;
    try {
      if (typeof actualMaxDay === 'function') maxActual = actualMaxDay(cy) || 0;
    } catch(e) { maxActual = 0; }
    if (maxActual) rows = rows.filter(d=>n(d.Dia_Campaña)<=maxActual);

    return rows.at(-1) || null;
  }
  function serviceRows(groupName, regionName){
    let rows=(SERVICE_COVERAGE_DATA||[]).filter(r=>!groupName || r.Grupo===groupName);
    if(regionName && regionName!=='Todas') rows=rows.filter(r=>r.Region===regionName);
    return [...rows].sort((a,b)=>n(b.Cobertura)-n(a.Cobertura));
  }
  function regionRows(groupName){
    return [...(REGION_COVERAGE_DATA||[]).filter(r=>!groupName || r.Grupo===groupName)].sort((a,b)=>n(b.Cobertura)-n(a.Cobertura));
  }
  function groupRows(){
    return [...(GROUP_COVERAGE_DATA||[])].sort((a,b)=>n(a.Cobertura)-n(b.Cobertura));
  }
  function selectedOptionValue(id, fallback){ const el=qs(id); return el&&el.value ? el.value : fallback; }
  function populateReportControls(){
    if(!(DATA&&DATA.length)) return;
    const gSel=qs('reportGroupSelect'), rSel=qs('reportRegionSelect'), sSel=qs('reportServiceSelect');
    const groups=getGroups();
    if(gSel && !gSel.dataset.ready){ gSel.innerHTML=groups.map(g=>`<option value="${g}">${g}</option>`).join(''); gSel.value=groups.includes('Total')?'Total':groups[0]; gSel.dataset.ready='1'; }
    const regions=['Todas', ...[...new Set((SERVICE_COVERAGE_DATA||[]).map(r=>r.Region).filter(Boolean))]];
    if(rSel && !rSel.dataset.ready){ rSel.innerHTML=regions.map(r=>`<option value="${r}">${r}</option>`).join(''); rSel.dataset.ready='1'; }
    const services=['Total país', ...[...new Set((SERVICE_COVERAGE_DATA||[]).map(r=>r.Servicio).filter(Boolean))]];
    if(sSel && !sSel.dataset.ready){ sSel.innerHTML=services.map(s=>`<option value="${s}">${s}</option>`).join(''); sSel.dataset.ready='1'; }
  }
  function buildContext(){
    const type=selectedOptionValue('reportTypeSelect','global');
    const groupName=selectedOptionValue('reportGroupSelect','Total');
    const regionName=selectedOptionValue('reportRegionSelect','Todas');
    const serviceName=selectedOptionValue('reportServiceSelect','Total país');
    const nat=latestNationalRow(groupName)||latestNationalRow('Total');
    let focusType='Total país', focusName='Total país', cov=n(nat?.Cobertura), vac=n(nat?.Vacunados_Acumulados), pop=n(nat?.Poblacion_Objetivo);
    if(type==='regional' && regionName && regionName!=='Todas'){
      const row=(REGION_COVERAGE_DATA||[]).find(r=>r.Grupo===groupName && r.Region===regionName) || (REGION_COVERAGE_DATA||[]).find(r=>r.Region===regionName);
      if(row){ focusType='Región'; focusName=row.Region; cov=n(row.Cobertura); vac=n(row.Vacunados); pop=n(row.Poblacion_Objetivo); }
    }
    if(type==='service' && serviceName && serviceName!=='Total país'){
      const row=(SERVICE_COVERAGE_DATA||[]).find(r=>r.Grupo===groupName && r.Servicio===serviceName) || (SERVICE_COVERAGE_DATA||[]).find(r=>r.Servicio===serviceName);
      if(row){ focusType='Servicio de Salud'; focusName=row.Servicio; cov=n(row.Cobertura); vac=n(row.Vacunados); pop=n(row.Poblacion_Objetivo); }
    }
    const gap85=Math.max(0, Math.round(pop*0.85-vac));
    const gap75=Math.max(0, Math.round(pop*0.75-vac));
    return {type,groupName,regionName,serviceName,nat,focusType,focusName,cov,vac,pop,gap85,gap75};
  }
  function buildPlain(c, srvRows, regRows, lowGroups, cutDate, generatedDate){
    const topS=srvRows[0], lowS=srvRows.at(-1), topR=regRows[0], lowR=regRows.at(-1);
    const lines=[];
    lines.push('RESUMEN EJECUTIVO · CAMPAÑA DE VACUNACIÓN CONTRA INFLUENZA 2026');
    lines.push('Programa Nacional de Inmunizaciones · Ministerio de Salud');
    lines.push('');
    lines.push(`Ámbito: ${c.focusType} · ${c.focusName}`);
    lines.push(`Grupo objetivo: ${c.groupName}`);
    lines.push(`Fecha de corte de datos: ${cutDate}`);
    lines.push(`Fecha de generación del informe: ${generatedDate}`);
    lines.push('');
    lines.push('1. Situación general');
    lines.push(`La cobertura alcanza ${pct(c.cov)}, equivalente a ${num(c.vac)} personas vacunadas de una población objetivo de ${num(c.pop)}.`);
    lines.push(`La brecha estimada para alcanzar la meta de 85% es de ${num(c.gap85)} personas.`);
    lines.push('');
    lines.push('2. Hallazgos territoriales');
    if(topS&&lowS) lines.push(`El mayor avance por Servicio de Salud corresponde a ${topS.Servicio} (${pct(topS.Cobertura)}) y el menor a ${lowS.Servicio} (${pct(lowS.Cobertura)}).`);
    if(topR&&lowR) lines.push(`A nivel regional, el mayor avance corresponde a ${topR.Region} (${pct(topR.Cobertura)}) y el menor a ${lowR.Region} (${pct(lowR.Cobertura)}).`);
    lines.push('');
    lines.push('3. Grupos con menor cobertura');
    if(lowGroups.length) lowGroups.slice(0,5).forEach((g,i)=>lines.push(`${i+1}. ${g.Grupo}: ${pct(g.Cobertura)}`)); else lines.push('Sin datos suficientes por grupo objetivo.');
    lines.push('');
    lines.push('4. Priorización sugerida');
    const lowCount=srvRows.filter(r=>n(r.Cobertura)<75).length;
    if(lowCount) lines.push(`- Reforzar seguimiento en los ${lowCount} Servicios de Salud bajo 75%.`);
    if(lowS) lines.push(`- Priorizar asistencia técnica en ${lowS.Servicio}, por presentar el menor avance del ranking.`);
    if(lowGroups.length) lines.push(`- Reforzar estrategias diferenciadas para ${lowGroups.slice(0,3).map(g=>g.Grupo).join(', ')}.`);
    return lines.join('\n');
  }
  window.renderReportCenter=function(){
    const status=qs('reportStatus');
    if(!(DATA&&DATA.length)){
      if(status) status.textContent='Esperando carga de datos del Observatorio…';
      return;
    }
    populateReportControls();
    const c=buildContext();
    const srv=serviceRows(c.groupName, c.regionName);
    const regs=regionRows(c.groupName);
    const lows=groupRows();
    const topS=srv[0], lowS=srv.at(-1), topR=regs[0], lowR=regs.at(-1);
    const lowCount=srv.filter(r=>n(r.Cobertura)<75).length, midCount=srv.filter(r=>n(r.Cobertura)>=75&&n(r.Cobertura)<85).length, okCount=srv.filter(r=>n(r.Cobertura)>=85).length;
    const cutDate=formatReportCutDate(c.nat?.Fecha);
    const generatedDate=formatReportGeneratedDate(new Date());
    const title = c.type==='mail' ? 'Minuta breve de campaña' : (c.focusType==='Total país'?'Resumen ejecutivo nacional':`Resumen ejecutivo · ${c.focusName}`);
    setText('reportTitle', title);
    setText('reportSubtitle', 'Cobertura, brechas, priorización territorial y grupos con menor avance.');
    setReportDates(cutDate, generatedDate);
    setHTML('reportKpis', [
      kpi('🛡️','Cobertura',pct(c.cov),statusLabel(c.cov)),
      kpi('💉','Vacunados',num(c.vac),'Personas vacunadas acumuladas'),
      kpi('🎯','Brecha 85%',num(c.gap85),'Personas pendientes estimadas'),
      kpi('🗺️','Territorio',c.focusName,c.focusType)
    ].join(''));
    const high=[];
    high.push(item('📌',`La cobertura de <b>${c.focusName}</b> alcanza <b>${pct(c.cov)}</b> para <b>${c.groupName}</b>.`));
    high.push(item('🎯',`La brecha para alcanzar 85% es de <b>${num(c.gap85)}</b> personas${c.gap75>0?`, y para 75% es de <b>${num(c.gap75)}</b>.`:'.'}`));
    if(topS&&lowS) high.push(item('🏥',`El mayor avance por Servicio de Salud corresponde a <b>${topS.Servicio}</b> (${pct(topS.Cobertura)}) y el menor a <b>${lowS.Servicio}</b> (${pct(lowS.Cobertura)}).`));
    if(topR&&lowR) high.push(item('🗺️',`A nivel regional, el mayor avance corresponde a <b>${topR.Region}</b> (${pct(topR.Cobertura)}) y el menor a <b>${lowR.Region}</b> (${pct(lowR.Cobertura)}).`));
    high.push(item('🚦',`Distribución de SS del filtro: <b>${okCount}</b> con meta 85% alcanzada, <b>${midCount}</b> entre 75% y 84,9%, y <b>${lowCount}</b> bajo 75%.`));
    setHTML('reportHighlights', high.join(''));
    setHTML('reportNarrative', `El tablero muestra una cobertura agregada de <strong>${pct(c.cov)}</strong> para <strong>${c.groupName}</strong>. Desde una perspectiva operativa, la priorización debería concentrarse en territorios bajo 75% y en aquellos con mayor brecha absoluta hacia la meta de 85%, porque combinan rezago porcentual con mayor volumen de población pendiente. ${lows.length?`En grupos objetivo, los menores avances nacionales se observan en <strong>${lows.slice(0,3).map(g=>`${g.Grupo} (${pct(g.Cobertura)})`).join(', ')}</strong>.`:''}`);
    setHTML('reportRankBars', c.type==='regional' ? barRows(regs,'Region','Cobertura',10) : barRows(srv,'Servicio','Cobertura',10));
    setHTML('reportGroupBars', barRows(lows,'Grupo','Cobertura',8));
    const rec=[];
    if(lowCount) rec.push(item('🔴',`Focalizar seguimiento en los <b>${lowCount}</b> Servicios de Salud bajo 75%, solicitando plan de cierre de brechas y revisión de disponibilidad operativa.`));
    if(lows.length) rec.push(item('👥',`Reforzar estrategias específicas para <b>${lows.slice(0,3).map(g=>g.Grupo).join(', ')}</b>, por presentar las menores coberturas relativas.`));
    if(lowS) rec.push(item('📍',`Priorizar asistencia técnica y monitoreo diario en <b>${lowS.Servicio}</b>, por ser el menor avance del ranking de Servicios de Salud.`));
    rec.push(item('📄','Utilizar este reporte como insumo para minutas, reuniones de seguimiento y comunicación con referentes territoriales.'));
    setHTML('reportRecommendations', rec.join(''));
    const plain=buildPlain(c,srv,regs,lows,cutDate,generatedDate);
    const ta=qs('reportPlainText'); if(ta) ta.value=plain;
    if(status) status.textContent=`Reporte generado para ${c.focusName} · ${c.groupName}.`;
  };
  function setupReportControls(){
    ['reportTypeSelect','reportGroupSelect','reportRegionSelect','reportServiceSelect'].forEach(id=>{ const el=qs(id); if(el && !el.dataset.bound){ el.addEventListener('change',()=>window.renderReportCenter()); el.dataset.bound='1'; }});
    const gen=qs('reportGenerateBtn'); if(gen&&!gen.dataset.bound){gen.onclick=()=>window.renderReportCenter(); gen.dataset.bound='1';}
    const copy=qs('reportCopyBtn'); if(copy&&!copy.dataset.bound){copy.onclick=()=>{const t=qs('reportPlainText')?.value||''; if(navigator.clipboard) navigator.clipboard.writeText(t); else {const ta=qs('reportPlainText'); ta?.select(); document.execCommand('copy');} setText('reportStatus','Texto copiado al portapapeles.');}; copy.dataset.bound='1';}
    const txt=qs('reportDownloadTxtBtn'); if(txt&&!txt.dataset.bound){txt.onclick=()=>downloadReportFile('resumen_ejecutivo_observatorio_influenza.txt', qs('reportPlainText')?.value||'', 'text/plain;charset=utf-8'); txt.dataset.bound='1';}
    const html=qs('reportDownloadHtmlBtn'); if(html&&!html.dataset.bound){html.onclick=downloadReportHtmlSafe; html.dataset.bound='1';}
    const pr=qs('reportPrintBtn'); if(pr&&!pr.dataset.bound){pr.onclick=()=>window.print(); pr.dataset.bound='1';}
  }
  function downloadReportFile(name,content,type){ const blob=new Blob([content],{type}); const url=URL.createObjectURL(blob); const a=document.createElement('a'); a.href=url; a.download=name; document.body.appendChild(a); a.click(); setTimeout(()=>{URL.revokeObjectURL(url); a.remove();},250); }
  function downloadReportHtmlSafe(){
    const sheet=qs('reportSheet');
    const html='<!doctype html><html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Resumen ejecutivo Observatorio Influenza</title><style>body{margin:0;padding:24px;background:#eaf6ff;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif}.oi-widget{max-width:1180px;margin:0 auto}</style></head><body><div class="oi-widget">'+(sheet?sheet.outerHTML:'')+'</div></body></html>';
    downloadReportFile('lamina_resumen_observatorio_influenza.html', html, 'text/html;charset=utf-8');
  }

  function activateReportViewFromTop(){
    document.querySelectorAll('.oi-main-tab').forEach(b=>b.classList.remove('active'));
    document.querySelectorAll('.oi-view').forEach(v=>v.classList.remove('oi-view-active'));
    qs('oiViewReports')?.classList.add('oi-view-active');
    const top=qs('reportTopBtn');
    if(top) top.classList.add('active');
    setupReportControls();
    setTimeout(()=>window.renderReportCenter(),80);
  }
  function clearReportTopActive(){
    const top=qs('reportTopBtn');
    if(top) top.classList.remove('active');
  }

  function bindTabsWithReports(){
    document.querySelectorAll('.oi-main-tab').forEach(btn=>{
      if(btn.dataset.reportBound==='1') return;
      btn.dataset.reportBound='1';
      btn.addEventListener('click',()=>{
        const view=btn.dataset.view;
        if(view==='reports'){
          activateReportViewFromTop();
        } else {
          clearReportTopActive();
        }
      });
    });
  }
  function initReportsSafe(){
    const top=qs('reportTopBtn');
    if(top && !top.dataset.reportBound){
      top.onclick=()=>activateReportViewFromTop();
      top.dataset.reportBound='1';
    }
    bindTabsWithReports();
    setupReportControls();
    setTimeout(()=>{ populateReportControls(); if(qs('oiViewReports')?.classList.contains('oi-view-active')) window.renderReportCenter(); },500);
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded', initReportsSafe); else setTimeout(initReportsSafe,120);
  const oldDrawAll = (typeof drawAll==='function') ? drawAll : null;
  if(oldDrawAll){
    drawAll = function(){
      oldDrawAll();
      setTimeout(()=>{ populateReportControls(); if(qs('oiViewReports')?.classList.contains('oi-view-active')) window.renderReportCenter(); },50);
    };
  }
})();


/* =========================================================
   FIX FINAL · Reset interno por pestaña + vista nacional
   - No cambia a la pestaña Nacional.
   - Regional: agrega opción "Total país" y muestra agregado nacional.
   - Servicio de Salud: vuelve a Total país dentro de la misma pestaña.
   ========================================================= */
(function(){
  const REGION_TOTAL_VALUE='__TOTAL_PAIS__';

  function oiFmtNum(v){
    try{return fmtNum.format(Math.round(+v||0));}
    catch(e){return new Intl.NumberFormat('es-CL').format(Math.round(+v||0));}
  }
  function oiFmtPct(v){
    try{return fmtPct(+v||0);}
    catch(e){return new Intl.NumberFormat('es-CL',{minimumFractionDigits:2,maximumFractionDigits:2}).format(+v||0)+'%';}
  }
  function oiStatus(v){
    try{return territoryStatus(+v||0);}
    catch(e){
      if((+v||0)>=85) return {cls:'ok',label:'≥ 85%'};
      if((+v||0)>=75) return {cls:'mid',label:'Entre 75% y 84,9%'};
      return {cls:'low',label:'Bajo 75%'};
    }
  }
  function oiGap(row,meta){
    try{return territoryGap(row,meta);}
    catch(e){return Math.max(0,Math.round((+row.Poblacion_Objetivo||0)*(meta/100)-(+row.Vacunados||0)));}
  }
  function oiRegionOrder(a,b){
    try{return regionNationalOrder(a)-regionNationalOrder(b);}
    catch(e){return String(a).localeCompare(String(b),'es');}
  }
  function oiAggregateRegionRows(rows){
    const vac=rows.reduce((s,r)=>s+(+r.Vacunados||0),0);
    const pop=rows.reduce((s,r)=>s+(+r.Poblacion_Objetivo||0),0);
    return {
      Region:'Total país',
      Grupo:selectedRegionGroup || 'Total',
      Cobertura:pop ? (vac/pop*100) : 0,
      Vacunados:vac,
      Poblacion_Objetivo:pop,
      IsAggregate:true
    };
  }
  function oiRegionAllGroupsNational(){
    if(!REGION_COVERAGE_DATA || !REGION_COVERAGE_DATA.length) return [];
    const groups=[...new Set(REGION_COVERAGE_DATA.map(r=>r.Grupo).filter(Boolean))];
    return groups.map(g=>{
      const rows=REGION_COVERAGE_DATA.filter(r=>r.Grupo===g);
      const vac=rows.reduce((s,r)=>s+(+r.Vacunados||0),0);
      const pop=rows.reduce((s,r)=>s+(+r.Poblacion_Objetivo||0),0);
      return {Grupo:g,Cobertura:pop? vac/pop*100:0,Vacunados:vac,Poblacion_Objetivo:pop};
    }).filter(r=>r.Grupo).sort((a,b)=>a.Cobertura-b.Cobertura);
  }

  if(typeof setupRegionalControls==='function'){
    setupRegionalControls=function(){
      const groupSel=document.getElementById('territoryRegionGroupSelect');
      const regionSel=document.getElementById('territoryRegionSelect');
      if(!groupSel || !regionSel || !REGION_COVERAGE_DATA.length) return;

      const groups=[...new Set(REGION_COVERAGE_DATA.map(d=>d.Grupo))];
      const preferred = groups.includes('Total') ? 'Total' : groups[0];
      if(!selectedRegionGroup || !groups.includes(selectedRegionGroup)) selectedRegionGroup = preferred;

      groupSel.innerHTML=groups.map(g=>`<option value="${g}">${g}</option>`).join('');
      groupSel.value=selectedRegionGroup;
      groupSel.onchange=()=>{
        selectedRegionGroup=groupSel.value;
        selectedRegion=REGION_TOTAL_VALUE;
        renderRegionalView();
        try{renderServiceView();}catch(e){}
      };

      const regions=[...new Set(REGION_COVERAGE_DATA.map(d=>d.Region).filter(Boolean))].sort(oiRegionOrder);
      if(!selectedRegion) selectedRegion=REGION_TOTAL_VALUE;
      if(selectedRegion!==REGION_TOTAL_VALUE && !regions.includes(selectedRegion)) selectedRegion=REGION_TOTAL_VALUE;

      regionSel.innerHTML=`<option value="${REGION_TOTAL_VALUE}">Total país</option>`+regions.map(r=>`<option value="${r}">${r}</option>`).join('');
      regionSel.value=selectedRegion;
      regionSel.onchange=()=>{
        selectedRegion=regionSel.value;
        renderRegionalView();
        try{renderServiceView();}catch(e){}
      };

      const clearBtn=document.getElementById('regionClearBtn');
      if(clearBtn){
        clearBtn.onclick=function(ev){
          if(ev){ev.preventDefault();ev.stopPropagation();}
          selectedRegionGroup='Total';
          selectedRegion=REGION_TOTAL_VALUE;
          setupRegionalControls();
          renderRegionalView();
          try{ if(typeof oiResetRegionMapView==='function') oiResetRegionMapView(); }catch(e){}
          return false;
        };
        clearBtn.innerHTML='↺ Limpiar / Total país';
      }
    };
  }

  if(typeof renderRegionalKpis==='function'){
    renderRegionalKpis=function(rows){
      if(!rows || !rows.length) return;
      const isTotal = selectedRegion===REGION_TOTAL_VALUE || selectedRegion==='Total país';
      const row = isTotal ? oiAggregateRegionRows(rows) : (rows.find(r=>r.Region===selectedRegion) || rows[0]);
      if(!row) return;
      const set=(id,v)=>{const el=document.getElementById(id); if(el) el.textContent=v;};
      const st=oiStatus(row.Cobertura);

      set('regionNameKpi', row.Region);
      set('regionGroupKpi', selectedRegionGroup || 'Total');
      set('regionCoverageKpi', oiFmtPct(row.Cobertura));
      set('regionStatusKpi', st.label);
      set('regionVaccinatedKpi', oiFmtNum(row.Vacunados));
      set('regionGap85Kpi', oiFmtNum(oiGap(row,85)));

      const read=document.getElementById('regionExecutiveRead');
      if(read){
        const rankRows=[...rows].sort((a,b)=>b.Cobertura-a.Cobertura);
        const best=rankRows[0], worst=rankRows[rankRows.length-1];
        if(isTotal){
          const lowGroups=oiRegionAllGroupsNational().slice(0,3);
          read.innerHTML=`El <strong>Total país</strong> registra una cobertura agregada de <strong>${oiFmtPct(row.Cobertura)}</strong> para <strong>${selectedRegionGroup}</strong>. La brecha estimada para alcanzar 85% es de <strong>${oiFmtNum(oiGap(row,85))}</strong> personas. La región con mayor avance es <strong>${best.Region}</strong> (${oiFmtPct(best.Cobertura)}) y la de menor avance es <strong>${worst.Region}</strong> (${oiFmtPct(worst.Cobertura)}). ${lowGroups.length?`Los grupos con menor cobertura agregada son <strong>${lowGroups.map(g=>`${g.Grupo} (${oiFmtPct(g.Cobertura)})`).join(', ')}</strong>.`:''}`;
        }else{
          const pos=rankRows.findIndex(r=>r.Region===row.Region)+1;
          const groups=regionAllGroups(row.Region);
          const lowGroups=groups.slice().sort((a,b)=>a.Cobertura-b.Cobertura).slice(0,3);
          read.innerHTML=`La región <strong>${row.Region}</strong> registra una cobertura de <strong>${oiFmtPct(row.Cobertura)}</strong> para <strong>${selectedRegionGroup}</strong>, ubicándose en la posición <strong>${pos} de ${rankRows.length}</strong> del ranking regional. La brecha estimada para alcanzar 85% es de <strong>${oiFmtNum(oiGap(row,85))}</strong> personas. La región con mayor avance es <strong>${best.Region}</strong> (${oiFmtPct(best.Cobertura)}) y la de menor avance es <strong>${worst.Region}</strong> (${oiFmtPct(worst.Cobertura)}). ${lowGroups.length?`Dentro de la región seleccionada, los grupos con menor cobertura son <strong>${lowGroups.map(g=>`${g.Grupo} (${oiFmtPct(g.Cobertura)})`).join(', ')}</strong>.`:''}`;
        }
      }
    };
  }

  if(typeof renderRegionalTable==='function'){
    const originalRenderRegionalTable=renderRegionalTable;
    renderRegionalTable=function(rows){
      originalRenderRegionalTable(rows);
      const body=document.querySelector('#regionTable tbody');
      if(!body) return;
      body.querySelectorAll('tr').forEach((tr,i)=>{
        tr.classList.toggle('active-row', selectedRegion!==REGION_TOTAL_VALUE && rows[i] && rows[i].Region===selectedRegion);
      });
    };
  }

  if(typeof renderRegionalView==='function'){
    renderRegionalView=function(){
      if(!REGION_COVERAGE_DATA.length){
        const map=document.getElementById('regionMap');
        if(map) map.innerHTML='<div class="warning-note">No se pudo cargar Cobertura_Regiones.csv. Sube el archivo a WordPress con ese nombre exacto.</div>';
        return;
      }
      setupRegionalControls();
      const rows=regionalRowsForGroup();
      if(!rows.length) return;
      if(!selectedRegion) selectedRegion=REGION_TOTAL_VALUE;
      if(selectedRegion!==REGION_TOTAL_VALUE && !rows.some(r=>r.Region===selectedRegion)) selectedRegion=REGION_TOTAL_VALUE;
      const regionSel=document.getElementById('territoryRegionSelect');
      if(regionSel) regionSel.value=selectedRegion;

      renderRegionalMap(rows);
      renderRegionalKpis(rows);
      renderRegionalTable(rows);
      renderTerritoryHorizontalChart('regionRankChart', rows, 'Region');
      const groupRows=(selectedRegion===REGION_TOTAL_VALUE) ? oiRegionAllGroupsNational() : regionAllGroups(selectedRegion);
      renderTerritoryHorizontalChart('regionGroupChart', groupRows, 'Grupo');
      try{ if(selectedRegion===REGION_TOTAL_VALUE && typeof oiResetRegionMapView==='function') oiResetRegionMapView(); }catch(e){}
    };
  }

  function resetServiceInPlace(){
    selectedServiceGroup='Total';
    selectedServiceRegion='Todas';
    selectedService='__TOTAL_PAIS__';
    const g=document.getElementById('territoryServiceGroupSelect'); if(g) g.value='Total';
    const r=document.getElementById('territoryServiceRegionSelect'); if(r) r.value='Todas';
    const s=document.getElementById('territoryServiceSelect'); if(s) s.value='__TOTAL_PAIS__';
    try{setupServiceControls();}catch(e){}
    try{renderServiceView();}catch(e){}
    try{ if(typeof oiResetServiceMapView==='function') oiResetServiceMapView(); }catch(e){}
  }

  function bindServiceClear(){
    const btn=document.getElementById('serviceClearBtn');
    if(!btn) return;
    btn.onclick=function(ev){
      if(ev){ev.preventDefault();ev.stopPropagation();}
      resetServiceInPlace();
      return false;
    };
    btn.innerHTML='↺ Limpiar / Total país';
  }

  function refreshTerritoryBindings(){
    try{setupRegionalControls();}catch(e){}
    bindServiceClear();
  }

  if(document.readyState==='loading'){
    document.addEventListener('DOMContentLoaded',()=>{
      setTimeout(refreshTerritoryBindings,600);
      setTimeout(refreshTerritoryBindings,1800);
      setTimeout(refreshTerritoryBindings,3600);
    });
  }else{
    setTimeout(refreshTerritoryBindings,300);
    setTimeout(refreshTerritoryBindings,1400);
    setTimeout(refreshTerritoryBindings,3000);
  }
})();
</script><style class="wpcode-css-snippet">.oi-widget{--blue:#0072bc;--blue2:#075985;--sky:#e0f2fe;--red:#ef3340;--green:#047857;--amber:#b45309;--text:#0f172a;--muted:#64748b;--border:#dbeafe;--shadow:0 18px 45px rgba(2,48,71,.14)}.oi-widget *{box-sizing:border-box}.oi-widget{margin:0;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;background:linear-gradient(135deg,#e0f2fe,#fff 45%,#f8fafc);color:var(--text)}.oi-widget .wrap{max-width:1240px;margin:22px auto 46px;padding:0 16px}.oi-widget .hero{border-radius:32px;padding:24px;color:#fff;background:linear-gradient(135deg,#075985,#0284c7 62%,#0e7490);box-shadow:var(--shadow);display:grid;grid-template-columns:1fr auto;gap:18px;align-items:center}.oi-widget .brand{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:18px}.oi-widget .logo{width:210px;max-width:60vw;border-radius:18px;box-shadow:0 8px 20px rgba(0,0,0,.2)}.oi-widget .tag,.oi-widget .present{border:1px solid rgba(255,255,255,.36);background:rgba(255,255,255,.13);padding:9px 13px;border-radius:999px;font-size:13px;font-weight:800}.oi-widget .present{color:#fff;cursor:pointer}.oi-widget h1{margin:0;font-size:clamp(28px,4vw,48px);letter-spacing:-.04em;line-height:1.05}.oi-widget .subtitle{margin:12px 0 0;max-width:840px;line-height:1.55;opacity:.95}.oi-widget .hero-date{text-align:right;min-width:230px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.28);border-radius:22px;padding:18px}.oi-widget .hero-date span{display:block;font-size:12px;font-weight:900;text-transform:uppercase;letter-spacing:.05em}.oi-widget .hero-date strong{display:block;font-size:44px;margin:8px 0 4px;letter-spacing:-.05em}.oi-widget .cards{margin-top:18px;display:grid;grid-template-columns:repeat(5,1fr);gap:14px}.oi-widget .card,.oi-widget .panel{background:rgba(255,255,255,.97);border:1px solid var(--border);box-shadow:0 10px 26px rgba(15,23,42,.08);border-radius:24px}.oi-widget .card{padding:18px}.oi-widget .label{font-size:12px;color:var(--muted);font-weight:900;text-transform:uppercase;letter-spacing:.055em}.oi-widget .value{margin-top:8px;font-size:29px;font-weight:950;color:#075985;letter-spacing:-.04em}.oi-widget .note{margin-top:8px;color:var(--muted);font-size:13px}.oi-widget .good{color:var(--green)!important}.oi-widget .bad{color:var(--red)!important}.oi-widget .neutral{color:var(--amber)!important}.oi-widget .panel{margin-top:18px;padding:20px;border-radius:30px;box-shadow:var(--shadow)}.oi-widget .panel-head{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;margin-bottom:12px}.oi-widget h2{margin:0;font-size:22px;letter-spacing:-.03em}.oi-widget .panel-head p{margin:6px 0 0;color:var(--muted);font-size:14px}.oi-widget .controls,.oi-widget .chips{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}.oi-widget .btn,.oi-widget .chip,.oi-widget select{border:1px solid #bae6fd;background:#fff;color:#075985;border-radius:999px;padding:10px 14px;font-weight:900;cursor:pointer;font-size:13px}.oi-widget .active{background:#075985!important;color:#fff!important;border-color:#075985!important}.oi-widget .filters{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:center}.oi-widget .chart{height:430px;background:linear-gradient(180deg,#fff,#f8fafc);border:1px solid #e0f2fe;border-radius:24px;padding:10px;position:relative;overflow:hidden}.oi-widget .chart svg{width:100%;height:100%;display:block}.oi-widget .legend{display:flex;gap:16px;flex-wrap:wrap;margin-top:10px;color:var(--muted);font-size:13px}.oi-widget .dot{display:inline-block;width:10px;height:10px;border-radius:999px;margin-right:6px}.oi-widget .slider-grid{display:grid;grid-template-columns:1fr 170px;gap:18px;align-items:center;margin-top:18px}.oi-widget input[type=range]{width:100%;accent-color:#075985}.oi-widget .badge{background:#f0f9ff;border:1px solid #bae6fd;border-radius:20px;padding:14px;text-align:center}.oi-widget .badge span{display:block;color:var(--muted);f