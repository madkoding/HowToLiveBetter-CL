var PNI=[{id:'BCG',code:'BCG',name:'BCG',full:'BCG (Bacilo de Calmette-Guerin)',disease:'Tuberculosis',doses:1,schedule:[{d:1,age:'Recién nacido',minD:0,maxD:30}]},{id:'HEP-B',code:'HEP-B',name:'Hepatitis B',full:'Hepatitis B',disease:'Hepatitis B',doses:1,schedule:[{d:1,age:'Recién nacido',minD:0,maxD:30}]},{id:'HEXA',code:'HEXA',name:'Hexavalente',full:'Hexavalente (DPT-V-Hib-IPV)',disease:'Difteria,Tétanos,Tos ferina,HepB,Hib,Polio',doses:4,schedule:[{d:1,age:'2 meses',minD:60,maxD:89},{d:2,age:'4 meses',minD:120,maxD:149},{d:3,age:'6 meses',minD:180,maxD:209},{d:4,age:'18 meses',minD:540,maxD:599}]},{id:'NEUMO13',code:'NEUMO13',name:'Neumocócica 13v',full:'Neumocócica conjugada 13-valente',disease:'Enfermedad neumocócica',doses:3,schedule:[{d:1,age:'2 meses',minD:60,maxD:89},{d:2,age:'4 meses',minD:120,maxD:149},{d:3,age:'12 meses',minD:360,maxD:389}]},{id:'ROTA',code:'ROTA',name:'Rotavirus',full:'Rotavirus',disease:'Gastroenteritis por Rotavirus',doses:2,schedule:[{d:1,age:'2 meses',minD:60,maxD:89},{d:2,age:'4 meses',minD:120,maxD:149}]},{id:'MENIN',code:'MENIN',name:'Meningocócica',full:'Meningocócica conjugada ACWY',disease:'Enf. meningocócica',doses:2,schedule:[{d:1,age:'12 meses',minD:360,maxD:389},{d:2,age:'4-5 años',minD:1460,maxD:1825}]},{id:'SRP',code:'SRP',name:'Tres Vírica',full:'Sarampión,Rubéola,Parotiditis',disease:'Sarampión,Rubéola,Parotiditis',doses:2,schedule:[{d:1,age:'12 meses',minD:360,maxD:389},{d:2,age:'1° Básico',minD:2190,maxD:2555}]},{id:'DPT',code:'DPT',name:'dTpa',full:'Difteria,Tétanos,Tos ferina acelular',disease:'Difteria,Tétanos,Tos ferina',doses:2,schedule:[{d:1,age:'1° Básico',minD:2190,maxD:2555},{d:2,age:'8° Básico',minD:4745,maxD:5110}]},{id:'VPH',code:'VPH',name:'VPH',full:'Virus Papiloma Humano',disease:'Cáncer cervicouterino',doses:2,schedule:[{d:1,age:'4° Básico',minD:3285,maxD:3650},{d:2,age:'5° Básico',minD:3650,maxD:4015}]},{id:'INFLU',code:'INFLU',name:'Influenza',full:'Influenza estacional',disease:'Influenza',doses