				<div class="et_pb_module_inner">
					<span class="item-elements et_pb_with_background">
                    <span class="item-elements-group"><span class="difl_icon_item_container"><span class="difl_icon_item_icon_wrapper"><span class="icon-element"><img loading="lazy" decoding="async" width="851" height="732" src="https://vacunas.minsal.cl/wp-content/uploads/2024/07/BlueIcons-16-10.png" alt="" srcset="https://vacunas.minsal.cl/wp-content/uploads/2024/07/BlueIcons-16-10.png 851w, https://vacunas.minsal.cl/wp-content/uploads/2024/07/BlueIcons-16-10-480x413.png 480w" sizes="(min-width: 0px) and (max-width: 480px) 480px, (min-width: 481px) 851px, 100vw" class="et_pb_image_wrap wp-image-76"></span></span> <span class="difl_icon_item_content_wrapper"><h2 class="difl_icon_item_header et_pb_with_background"><span>Marco Regulatorio</span></h2></span></span></span>
