r:#0f172a}.oi-widget #reportPlainText{width:100%;min-height:680px;border:1px solid #bae6fd;border-radius:16px;padding:14px;color:#0f172a;background:#f8fafc;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono","Courier New",monospace;font-size:12px;line-height:1.55;resize:vertical}.oi-widget .oi-report-mail-mode .oi-report-charts-row{display:none}.oi-widget .oi-report-mail-mode .oi-report-recommendations{margin-top:16px}@media(max-width:1100px){.oi-widget .oi-report-layout{grid-template-columns:1fr}.oi-widget .oi-report-text-panel{position:static}.oi-widget .oi-report-controls{grid-template-columns:1fr 1fr}.oi-widget .oi-report-kpis{grid-template-columns:1fr 1fr}}@media(max-width:720px){.oi-widget .oi-report-controls,.oi-widget .oi-report-two-col,.oi-widget .oi-report-kpis{grid-template-columns:1fr}.oi-widget .oi-report-cover{flex-direction:column}.oi-widget .oi-report-actions{justify-content:flex-start}.oi-widget .oi-report-bar-row{grid-template-columns:1fr}.oi-widget .oi-report-bar-row span:last-child{text-align:left!important}}
@media print{body *{visibility:hidden!important}#reportSheet,#reportSheet *{visibility:visible!important}#reportSheet{position:absolute!important;left:0!important;top:0!important;width:100%!important;box-shadow:none!important;border:none!important}.oi-widget .oi-report-sheet{border-radius:0!important}.oi-widget .oi-report-text-panel,.oi-widget .oi-report-controls,.oi-widget .oi-report-actions,.oi-widget .oi-main-tabs,.oi-widget .hero{display:none!important}}


/* Fix report data: mantener KPIs nacionales sin desbordes */
.oi-widget .cards .value{font-size:clamp(22px,2.2vw,30px);}


/* =========================
   Centro de reportes · integración superior y fechas dobles
   ========================= */
.oi-widget .report-top-btn{
  display:inline-flex;
  align-items:center;
  gap:6px;
  margin-left:4px;
}
.oi-widget .report-top-btn.active{
  background:#ef3340 !important;
  color:#fff !important;
  border-color:#fff !important;
  box-shadow:0 8px 22px rgba(239,51,64,.25);
}
.oi-widget .oi-main-tab[data-view="reports"]{
  display:none !important;
}
.oi-widget .oi-report-date-stack{
  display:grid;
  grid-template-columns:1fr;
  gap:3px;
  min-width:172px;
  text-align:left;
}
.oi-widget .oi-report-date-stack span{
  color:#dbeafe;
  font-size:10px;
  font-weight:950;
  letter-spacing:.07em;
  text-transform:uppercase;
  line-height:1.1;
}
.oi-widget .oi-report-date-stack strong{
  color:#fff;
  font-size:18px;
  line-height:1.05;
  font-weight:950;
  letter-spacing:-.02em;
}
@media(max-width:720px){
  .oi-widget .report-top-btn{margin-left:0;}
  .oi-widget .oi-report-date-stack{min-width:0;width:100%;}
}


/* =========================
   Centro de reportes · ajuste final
   Fecha de corte dinámica + KPI verticales
   ========================= */
.oi-widget .oi-report-kpis{
  gap:14px !important;
}
.oi-widget .oi-report-kpi{
  flex-direction:column !important;
  align-items:center !important;
  justify-content:flex-start !important;
  text-align:center !important;
  gap:10px !important;
  padding:16px 12px !important;
  min-height:150px !important;
}
.oi-widget .oi-report-kpi .ri{
  width:46px !important;
  height:46px !important;
  font-size:23px !important;
  margin:0 auto !important;
}
.oi-widget .oi-report-kpi > div{
  width:100% !important;
  min-width:0 !important;
}
.oi-widget .oi-report-kpi small{
  font-size:10px !important;
  line-height:1.2 !important;
}
.oi-widget .oi-report-kpi strong{
  font-size:20px !important;
  line-height:1.05 !important;
  word-break:break-word !important;
}
.oi-widget .oi-report-kpi em{
  font-size:11px !important;
  line-height:1.25 !important;
}
@media(max-width:720px){
  .oi-widget .oi-report-kpi{
    min-height:auto !important;
  }
}

/* =========================
   Ajuste final solicitado · KPI verticales + botón limpiar territorial
   ========================= */
.oi-widget .oi-region-actions-final{
  display:flex;
  align-items:end;
  gap:8px;
  flex-wrap:wrap;
  justify-content:flex-end;
}
.oi-widget .oi-region-actions-final select{
  min-width:210px;
}
.oi-widget .oi-region-actions-final .oi-clear-btn{
  min-height:40px;
  align-self:end;
}

/* KPI regionales: ícono sobre el texto */
.oi-widget .oi-region-kpis-icons .mini,
.oi-widget .oi-service-kpis-final .mini{
  display:flex !important;
  flex-direction:column !important;
  align-items:center !important;
  justify-content:flex-start !important;
  text-align:center !important;
  gap:9px !important;
  padding:13px 10px !important;
  min-height:132px !important;
  overflow:visible !important;
}
.oi-widget .oi-region-kpis-icons .mini > div,
.oi-widget .oi-service-kpis-final .mini > div{
  width:100% !important;
  min-width:0 !important;
}
.oi-widget .oi-region-kpis-icons .mini-icon,
.oi-widget .oi-service-kpis-final .mini-icon,
.oi-widget .mini-icon{
  width:38px !important;
  height:38px !important;
  border-radius:14px !important;
  font-size:20px !important;
  flex-shrink:0 !important;
  margin:0 auto !important;
}
.oi-widget .oi-region-kpis-icons .mini .label,
.oi-widget .oi-service-kpis-final .mini .label{
  font-size:10px !important;
  line-height:1.18 !important;
  letter-spacing:.06em !important;
}
.oi-widget .oi-region-kpis-icons .mini .v,
.oi-widget .oi-service-kpis-final .mini .v{
  font-size:clamp(18px,1.85vw,24px) !important;
  line-height:1.05 !important;
  letter-spacing:-.035em !important;
  white-space:normal !important;
  overflow-wrap:anywhere !important;
  word-break:normal !important;
  margin-top:4px !important;
}
.oi-widget .oi-region-kpis-icons .mini .n,
.oi-widget .oi-service-kpis-final .mini .n{
  font-size:11px !important;
  line-height:1.22 !important;
  margin-top:4px !important;
}
.oi-widget .oi-service-kpis-final{
  grid-template-columns:repeat(3,minmax(0,1fr)) !important;
}
@media(max-width:980px){
  .oi-widget .oi-service-kpis-final{grid-template-columns:repeat(2,minmax(0,1fr)) !important;}
  .oi-widget .oi-region-actions-final{justify-content:flex-start;}
  .oi-widget .oi-region-actions-final select,
  .oi-widget .oi-region-actions-final .oi-clear-btn{width:100%;}
}
@media(max-width:620px){
  .oi-widget .oi-region-kpis-icons,
  .oi-widget .oi-service-kpis-final{grid-template-columns:1fr !important;}
  .oi-widget .oi-region-kpis-icons .mini,
  .oi-widget .oi-service-kpis-final .mini{min-height:auto !important;}
}
