<style>
#app-vacunacion-especial{
  font-family:Arial,sans-serif;
  max-width:1280px;
  margin:0 auto;
  color:#14213d;
}
#app-vacunacion-especial *{box-sizing:border-box}

#app-vacunacion-especial .ve-header{
  background:linear-gradient(135deg,#003b7a,#006fb8 55%,#00a3c8);
  color:white;
  padding:28px 30px;
  border-radius:18px;
  margin-bottom:24px;
  box-shadow:0 10px 24px rgba(0,59,122,.18);
}
#app-vacunacion-especial .ve-header h2{
  margin:0 0 8px;
  font-size:28px;
  color:white;
}
#app-vacunacion-especial .ve-header p{
  margin:0;
  font-size:16px;
  line-height:1.5;
  max-width:980px;
}

#app-vacunacion-especial .ve-buscador,
#app-vacunacion-especial .ve-selector-multiple,
#app-vacunacion-especial .ve-buscador{
  background:#f3f8fb;
  padding:20px;
  margin-bottom:18px;
}
#app-vacunacion-especial input[type="text"],
#app-vacunacion-especial input[type="number"],
#app-vacunacion-especial select{
  width:100%;
  padding:14px 16px;
  border-radius:12px;
  border:1px solid #b8dbe8;
  font-size:16px;
  box-sizing:border-box;
  background:white;
}
#app-vacunacion-especial input:focus,
#app-vacunacion-especial select:focus{
  outline:none;
  border-color:#0072bc;
  box-shadow:0 0 0 3px rgba(0,114,188,.12);
}

#app-vacunacion-especial .ve-edad-panel{
  display:grid;
  grid-template-columns:1fr 180px;
  gap:10px;
  margin-top:12px;
  align-items:end;
}
#app-vacunacion-especial .ve-edad-panel label{
  display:block;
  font-size:13px;
  font-weight:700;
  color:#374151;
  margin-bottom:5px;
}
#app-vacunacion-especial .ve-edad-info{
  grid-column:1/-1;
  font-size:13px;
  color:#004b8d;
  margin-top:2px;
  background:#eaf5ff;
  border:1px solid #b8dbe8;
  border-radius:12px;
  padding:10px 12px;
}

#app-vacunacion-especial .ve-filtros{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin:18px 0;
}
#app-vacunacion-especial .ve-filtros button,
#app-vacunacion-especial .ve-acciones button{
  border:none;
  background:#e6f3f8;
  color:#006fae;
  padding:10px 14px;
  border-radius:999px;
  cursor:pointer;
  font-weight:700;
  transition:.15s ease;
}
#app-vacunacion-especial .ve-filtros button:hover,
#app-vacunacion-especial .ve-acciones button:hover{
  transform:translateY(-1px);
  box-shadow:0 4px 10px rgba(0,114,188,.14);
}
#app-vacunacion-especial .ve-filtros button.activo{
  background:#0072bc;
  color:white;
}

#app-vacunacion-especial .ve-selector-multiple{
  padding:18px;
  margin-bottom:18px;
}
#app-vacunacion-especial .ve-selector-multiple p{
  margin-top:0;
}
#app-vacunacion-especial .ve-acciones{
  display:flex;
  gap:10px;
  flex-wrap:wrap;
  margin:8px 0 14px;
}
#app-vacunacion-especial .ve-checklist{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
  gap:10px;
  max-height:560px;
  overflow:auto;
  padding-right:4px;
}
#app-vacunacion-especial .ve-check-item{
  display:flex;
  align-items:flex-start;
  gap:8px;
  background:#f8fbfd;
  border:1px solid #e1edf3;
  border-radius:12px;
  padding:12px;
  cursor:pointer;
  font-size:14px;
  min-height:74px;
}
#app-vacunacion-especial .ve-check-item:hover{
  background:#eef8fc;
}
#app-vacunacion-especial .ve-check-item input{
  margin-top:3px;
}

#app-vacunacion-especial .ve-card{
  padding:20px;
  margin-bottom:16px;
}
#app-vacunacion-especial .ve-card h3{
  margin:0 0 14px;
  color:#0072bc;
  font-size:22px;
}
#app-vacunacion-especial .ve-grupo{
  display:inline-block;
  background:#e6f3f8;
  color:#006fae;
  padding:5px 10px;
  border-radius:999px;
  font-size:13px;
  font-weight:bold;
  margin:0 6px 8px 0;
}

/* Resultado principal en grilla: 2 a 4 tarjetas por fila según ancho */
#app-vacunacion-especial #veResultados > .ve-card:first-child{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
  gap:16px;
  align-items:stretch;
}
#app-vacunacion-especial #veResultados > .ve-card:first-child > h3,
#app-vacunacion-especial #veResultados > .ve-card:first-child > .ve-resumen-kpi,
#app-vacunacion-especial #veResultados > .ve-card:first-child > .ve-alerta-roja{
  grid-column:1/-1;
}

#app-vacunacion-especial .ve-vacuna-card{
  border:1px solid #e1edf3;
  border-radius:16px;
  padding:16px;
  margin:0;
  background:linear-gradient(180deg,#ffffff,#fbfdff);
  box-shadow:0 4px 12px rgba(15,23,42,.06);
  display:flex;
  flex-direction:column;
  min-height:260px;
}
#app-vacunacion-especial .ve-vacuna-card h4{
  margin:0 0 10px;
  color:#003b7a;
  font-size:18px;
  line-height:1.25;
}
#app-vacunacion-especial .ve-meta{
  font-size:13px;
  margin:4px 0;
  line-height:1.45;
}
#app-vacunacion-especial .ve-field{
  background:#f8fafc;
  border:1px solid #e5edf3;
  border-radius:12px;
  padding:10px;
  margin:8px 0;
  font-size:13px;
  line-height:1.45;
}
#app-vacunacion-especial .ve-field strong{
  color:#111827;
}
#app-vacunacion-especial .ve-vacuna-card details{
  margin-top:auto;
  border-top:1px solid #e5edf3;
  padding-top:10px;
}
#app-vacunacion-especial summary{
  cursor:pointer;
  font-weight:700;
  color:#006fae;
}

#app-vacunacion-especial .ve-alerta{
  background:#fff8e5;
  border-left:4px solid #f5b301;
  padding:12px;
  border-radius:8px;
  margin-top:10px;
  font-size:13px;
}
#app-vacunacion-especial .ve-alerta-roja{
  background:#fff1f2;
  border-left:4px solid #e11d48;
  padding:12px;
  border-radius:8px;
  margin-top:10px;
  font-size:14px;
}
#app-vacunacion-especial .ve-vacio{
  padding:20px;
  border-radius:14px;
  background:#f9fafb;
  color:#6b7280;
  text-align:center;
}
#app-vacunacion-especial .ve-resumen-kpi{
  display:flex;
  gap:12px;
  flex-wrap:wrap;
  margin-bottom:4px;
}
#app-vacunacion-especial .ve-kpi{
  background:#e6f3f8;
  color:#006fae;
  border-radius:999px;
  padding:9px 13px;
  font-weight:800;
  font-size:13px;
}

@media(max-width:900px){
  #app-vacunacion-especial #veResultados > .ve-card:first-child{
    grid-template-columns:repeat(auto-fit,minmax(260px,1fr));
  }
}
@media(max-width:700px){
  #app-vacunacion-especial .ve-edad-panel{grid-template-columns:1fr}
  #app-vacunacion-especial #veResultados > .ve-card:first-child{grid-template-columns:1fr}
}
@media print{
  #app-vacunacion-especial .ve-buscador,
  #app-vacunacion-especial .ve-selector-multiple,
  #app-vacunacion-especial .ve-filtros{display:none}
  #app-vacunacion-especial .ve-card{box-shadow:none!important}
}
#app-vacunacion-especial .ve-vacuna-viva {
  background: #fff1f1 !important;
  border: 2px solid #e57373 !important;
}

#app-vacunacion-especial .ve-vacuna-viva h4 {
    color:#c62828 !important;
    font-weight:700;
}

#app-vacunacion-especial .ve-vacuna-viva::before {
  content: "⚠️ VACUNA VIVA ATENUADA";
  display: inline-block;
  width: fit-content;
  margin-bottom: 10px;
  padding: 4px 10px;
  border-radius: 999px;
  background: #d32f2f;
  color: white;
  font-size: 12px;
  font-weight: 700;
}

/* =========================================================
   PARCHE DEFINITIVO: GRILLA EXPLÍCITA DE VACUNAS
   ========================================================= */
#app-vacunacion-especial .ve-vacunas-grid{
  display:grid !important;
  grid-template-columns:repeat(3,minmax(0,1fr)) !important;
  gap:16px !important;
  align-items:stretch !important;
  width:100% !important;
  box-sizing:border-box !important;
}

#app-vacunacion-especial .ve-vacunas-grid .ve-vacuna-card{
  width:100% !important;
  max-width:none !important;
  min-width:0 !important;
  margin:0 !important;
  box-sizing:border-box !important;
}

@media(max-width:1100px){
  #app-vacunacion-especial .ve-vacunas-grid{
    grid-template-columns:repeat(2,minmax(0,1fr)) !important;
  }
}

@media(max-width:700px){
  #app-vacunacion-especial .ve-vacunas-grid{
    grid-template-columns:1fr !important;
  }
}

</style>

<script>
document.addEventListener("DOMContentLoaded",function(){
  var app=document.getElementById("app-vacunacion-especial"); if(!app||typeof matrizCondicionesVE==='undefined')return;
  var filtroActivo="Todos", buscador=document.getElementById("veBuscar"), filtros=document.getElementById("veFiltros"), checklist=document.getElementById("veChecklist"), resultados=document.getElementById("veResultados");

  function esc(t){return String(t||"").replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
  function normalizar(t){return String(t||"").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"");}
  function grupos(){var l=["Todos"];matrizCondicionesVE.forEach(function(i){if(l.indexOf(i.grupo)===-1)l.push(i.grupo)});return l;}
  function seleccionadas(){return Array.from(document.querySelectorAll("#veChecklist input:checked")).map(function(cb){return cb.value;});}
  function textoItem(i){return [i.grupo,i.nombre,(i.paginas||""),i.vacunas.map(function(v){return [v.nombre,v.esquema,v.inicio,v.observacion].join(" ")}).join(" ")].join(" ");}
  function condicionesFiltradas(){var txt=normalizar(buscador.value);return matrizCondicionesVE.filter(function(i){return (filtroActivo==="Todos"||i.grupo===filtroActivo)&&normalizar(textoItem(i)).indexOf(txt)!==-1;});}
  function unicos(arr){var out=[];arr.forEach(function(x){x=String(x||"").trim();if(x&&out.indexOf(x)===-1)out.push(x)});return out;}
  function joinLista(arr){arr=unicos(arr);if(!arr.length)return "Según evaluación";return arr.map(esc).join("; ");}

  function inyectarEdad(){
    var buscadorBox=app.querySelector(".ve-buscador");
    if(!buscadorBox||document.getElementById("veEdad"))return;
    var panel=document.createElement("div");
    panel.className="ve-edad-panel";
    panel.innerHTML='<div><label for="veEdad">Edad del paciente (opcional)</label><input type="number" id="veEdad" min="0" step="1" placeholder="Ej.: 35"></div><div><label for="veUnidadEdad">Unidad</label><select id="veUnidadEdad"><option value="anios">años</option><option value="meses">meses</option></select></div><div class="ve-edad-info" id="veEdadInfo">La edad ayuda a generar advertencias operativas; no reemplaza la verificación de antecedente vacunal ni criterio clínico.</div>';
    buscadorBox.appendChild(panel);
    document.getElementById("veEdad").addEventListener("input",renderResultados);
    document.getElementById("veUnidadEdad").addEventListener("change",renderResultados);
  }
  function edadMeses(){
    var e=document.getElementById("veEdad"), u=document.getElementById("veUnidadEdad");
    if(!e||e.value==="")return null;
    var n=parseFloat(e.value); if(isNaN(n)||n<0)return null;
    return u&&u.value==="meses" ? n : n*12;
  }
  function textoEdad(){var m=edadMeses();if(m===null)return "Edad no ingresada"; if(m<24)return Math.round(m)+" meses"; return Math.floor(m/12)+" años";}

  function renderFiltros(){filtros.innerHTML="";grupos().forEach(function(g){var b=document.createElement("button");b.textContent=g;if(g===filtroActivo)b.classList.add("activo");b.onclick=function(){filtroActivo=g;renderFiltros();renderChecklist();renderResultados();};filtros.appendChild(b);});}
  function renderChecklist(){var marcadas=seleccionadas();checklist.innerHTML="";checklist.className="ve-checklist";condicionesFiltradas().forEach(function(i){var label=document.createElement("label");label.className="ve-check-item";var checked=marcadas.indexOf(i.id)!==-1?"checked":"";label.innerHTML='<input type="checkbox" value="'+esc(i.id)+'" '+checked+'> <span><strong>'+esc(i.nombre)+'</strong><br><small>'+esc(i.grupo)+'</small></span>';label.querySelector("input").addEventListener("change",renderResultados);checklist.appendChild(label);});}

  function agruparVacunas(items){
    var map={};
    items.forEach(function(item){
      item.vacunas.forEach(function(v){
        var k=normalizar(v.nombre);
        if(!map[k])map[k]={nombre:v.nombre,indicadaPor:[],detalles:[],esquemas:[],inicios:[],observaciones:[]};
        if(map[k].indicadaPor.indexOf(item.nombre)===-1)map[k].indicadaPor.push(item.nombre);
        map[k].detalles.push({condicion:item.nombre,grupo:item.grupo,esquema:v.esquema||"Según evaluación",inicio:v.inicio||"Según evaluación",observacion:v.observacion||"",paginas:item.paginas||""});
        if(v.esquema&&map[k].esquemas.indexOf(v.esquema)===-1)map[k].esquemas.push(v.esquema);
        if(v.inicio&&map[k].inicios.indexOf(v.inicio)===-1)map[k].inicios.push(v.inicio);
        if(v.observacion&&map[k].observaciones.indexOf(v.observacion)===-1)map[k].observaciones.push(v.observacion);
      });
    });
    return Object.values(map).sort(function(a,b){return a.nombre.localeCompare(b.nombre);});
  }

  function advertenciasEdad(items,vacunas){
    var m=edadMeses(); if(m===null)return [];
    var y=m/12, adv=[];
    items.forEach(function(i){
      var n=normalizar(i.nombre);
      if(y<18 && (n.indexOf("adulto")!==-1 || n.indexOf("adolescente o adulto")!==-1)) adv.push('La condición seleccionada "'+i.nombre+'" corresponde a adolescente/adulto; verificar pertinencia por edad.');
      if(y>=18 && (n.indexOf("lactante")!==-1 || n.indexOf("rnpt")!==-1 || n.indexOf("nino")!==-1 || n.indexOf("niño")!==-1 || n.indexOf("pediatrico")!==-1)) adv.push('La condición seleccionada "'+i.nombre+'" corresponde a población pediátrica; verificar pertinencia por edad.');
    });
    vacunas.forEach(function(v){
      var n=normalizar(v.nombre);
      if(n.indexOf("influenza")!==-1 && m<6) adv.push("Influenza: revisar edad mínima; en general se indica desde los 6 meses.");
      if(n.indexOf("rotavirus")!==-1 && m>8) adv.push("Rotavirus: revisar edad máxima de administración según producto.");
      if((n.indexOf("polisacarida 23")!==-1 || n.indexOf("23v")!==-1 || n.indexOf("pps")!==-1 || n.indexOf("vnp")!==-1) && m<24) adv.push("Neumocócica polisacárida 23v: verificar edad mínima; generalmente no se administra antes de los 2 años.");
      if(n.indexOf("vph")!==-1 && (y<9 || y>45)) adv.push("VPH: verificar edad y criterio específico de indicación antes de administrar.");
    });
    return unicos(adv);
  }

  function renderResultados(){
    var ids=seleccionadas();
    if(!ids.length){resultados.innerHTML='<div class="ve-vacio">Seleccione una o más condiciones de riesgo para generar el resumen consolidado.</div>';return;}
    var items=matrizCondicionesVE.filter(function(i){return ids.indexOf(i.id)!==-1;});
    var vacunas=agruparVacunas(items);
    var adv=advertenciasEdad(items,vacunas);
    var html='<div class="ve-card"><h3>Resumen consolidado de vacunas recomendadas</h3><div class="ve-resumen-kpi"><span class="ve-kpi">'+items.length+' condición(es)</span><span class="ve-kpi">'+vacunas.length+' vacuna(s)</span><span class="ve-kpi">'+esc(textoEdad())+'</span></div>';
    if(adv.length){html+='<div class="ve-alerta-roja"><strong>Advertencias por edad:</strong><ul>';adv.forEach(function(a){html+='<li>'+esc(a)+'</li>';});html+='</ul></div>';}
    html+='<div class="ve-vacunas-grid">';
    vacunas.forEach(function(v){
var esViva = vacunasVivas.some(function(nombreViva){
  return normalizar(v.nombre).indexOf(normalizar(nombreViva)) !== -1;
});

var claseViva = esViva ? " ve-vacuna-viva" : "";

html+='<div class="ve-vacuna-card'+claseViva+'"><h4>💉 '+esc(v.nombre)+'</h4>';
	  html+='<p class="ve-meta"><strong>Indicada por:</strong> '+v.indicadaPor.map(esc).join('; ')+'</p>';
      html+='<div class="ve-field"><strong>Esquema consolidado:</strong><br>'+joinLista(v.esquemas)+'</div>';
      html+='<div class="ve-field"><strong>Inicio / oportunidad:</strong><br>'+joinLista(v.inicios)+'</div>';
      if(v.observaciones.length){html+='<div class="ve-field"><strong>Observaciones consolidadas:</strong><br>'+joinLista(v.observaciones)+'</div>';}
      html+='<details><summary>Ver detalle por condición</summary>';
      v.detalles.forEach(function(d){
        html+='<div class="ve-alerta"><strong>'+esc(d.condicion)+'</strong><br><span class="ve-meta"><strong>Esquema:</strong> '+esc(d.esquema)+'</span><br><span class="ve-meta"><strong>Inicio:</strong> '+esc(d.inicio)+'</span>'+(d.observacion?'<br><span class="ve-meta"><strong>Observación:</strong> '+esc(d.observacion)+'</span>':'')+(d.paginas?'<br><span class="ve-meta"><strong>Referencia:</strong> '+esc(d.paginas)+'</span>':'')+'</div>';
      });
      html+='</details></div>';
    });
    html+='</div></div><div class="ve-card"><h3>Condiciones seleccionadas</h3>';
    items.forEach(function(i){html+='<span class="ve-grupo">'+esc(i.grupo)+'</span><p><strong>'+esc(i.nombre)+'</strong><br><small>'+esc(i.paginas||'Manual de Vacunación Especial 2025')+'</small></p>';});
    html+='</div>';
    resultados.innerHTML=html;
  }

  buscador.addEventListener("input",function(){renderChecklist();renderResultados();});
  var sel=document.querySelector(".ve-selector-multiple");
  if(sel&&!document.getElementById("veLimpiar")){
    var acc=document.createElement("div");acc.className="ve-acciones";
    acc.innerHTML='<button type="button" id="veLimpiar">Limpiar selección</button><button type="button" id="veImprimir">Imprimir resumen</button>';
    sel.insertBefore(acc,checklist);
    document.getElementById("veLimpiar").onclick=function(){document.querySelectorAll("#veChecklist input:checked").forEach(function(cb){cb.checked=false});renderResultados();};
    document.getElementById("veImprimir").onclick=function(){window.print();};
  }
  inyectarEdad();
  renderFiltros();renderChecklist();renderResultados();
});
</script><style class="wpcode-css-snippet">/* =========================================================
   VACUNACIÓN ESPECIAL - CSS PRINCIPAL CORREGIDO
   Versión limpia: resultados en tarjetas anchas (2 columnas)
   Usar como único snippet CSS en WPCode
   ========================================================= */

#app-vacunacion-especial{
  --ve-azul:#003057;
  --ve-azul-2:#005c97;
  --ve-celeste:#eaf4fb;
  --ve-borde:#dbe5ee;
  --ve-texto:#1e293b;
  --ve-muted:#64748b;
  --ve-fondo:#f6f9fc;
  --ve-rojo:#b71c1c;
  --ve-rojo-fondo:#fff8f8;
  --ve-rojo-borde:#f3b3b3;
  font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;
  color:var(--ve-texto);
  background:var(--ve-fondo);
  border-radius:24px;
  padding:0 0 28px;
  overflow:hidden;
  max-width:1180px;
  margin:28px auto;
}

/* ENCABEZADO */

#app-vacunacion-especial .ve-header{
  background:linear-gradient(135deg,var(--ve-azul),var(--ve-azul-2));
  color:#fff;
  padding:34px 28px;
  border-radius:24px 24px 0 0;
}

#app-vacunacion-especial .ve-header h1,
#app-vacunacion-especial .ve-header h2{
  margin:0 0 10px;
  color:#fff;
  font-size:34px;
  line-height:1.1;
  font-weight:850;
}

#app-vacunacion-especial .ve-header p{
  margin:0;
  max-width:900px;
  color:rgba(255,255,255,.9);
  font-size:16px;
  line-height:1.6;
}

/* CONTENEDORES */

#app-vacunacion-especial .ve-buscador,
#app-vacunacion-especial .ve-selector-multiple,
#app-vacunacion-especial .ve-filtros,
#app-vacunacion-especial #veResultados,
#app-vacunacion-especial #veBusquedaRapida{
  max-width:1100px;
  margin-left:auto;
  margin-right:auto;
  padding-left:22px;
  padding-right:22px;
  box-sizing:border-box;
}

#app-vacunacion-especial .ve-buscador{
  margin-top:24px;
  margin-bottom:18px;
}

/* BUSCADOR */

#app-vacunacion-especial #veBuscar{
  width:100%;
  box-sizing:border-box;
  border:1px solid var(--ve-borde);
  border-radius:16px;
  padding:15px 16px;
  font-size:15px;
  color:var(--ve-texto);
  background:#fff;
  outline:none;
  box-shadow:0 6px 18px rgba(15,23,42,.05);
}

#app-vacunacion-especial #veBuscar:focus{
  border-color:var(--ve-azul-2);
  box-shadow:0 0 0 4px rgba(0,92,151,.12);
}

#app-vacunacion-especial .ve-buscador-wrap{
  display:flex;
  gap:10px;
  align-items:center;
}

#app-vacunacion-especial .ve-buscador-wrap #veBuscar{
  flex:1;
}

#app-vacunacion-especial #veLimpiarBusqueda{
  border:none;
  background:var(--ve-azul);
  color:#fff;
  padding:12px 18px;
  border-radius:12px;
  font-weight:800;
  cursor:pointer;
  white-space:nowrap;
}

/* EDAD */

#app-vacunacion-especial .ve-controles,
#app-vacunacion-especial .ve-edad-box{
  max-width:1100px;
  margin:18px auto;
  padding:0 22px;
  display:flex;
  flex-wrap:wrap;
  gap:12px;
  align-items:center;
  box-sizing:border-box;
}

#app-vacunacion-especial .ve-edad-box label,
#app-vacunacion-especial .ve-controles label{
  font-size:13px;
  font-weight:800;
  color:var(--ve-azul);
}

#app-vacunacion-especial .ve-edad-box input,
#app-vacunacion-especial .ve-controles input,
#app-vacunacion-especial .ve-controles select{
  border:1px solid var(--ve-borde);
  border-radius:12px;
  padding:10px 12px;
  font-size:14px;
  background:#fff;
}

/* FILTROS */

#app-vacunacion-especial .ve-filtros{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  margin-top:16px;
  margin-bottom:18px;
}

#app-vacunacion-especial .ve-filtros button,
#app-vacunacion-especial .ve-chip,
#app-vacunacion-especial .ve-btn{
  border:1px solid var(--ve-borde);
  background:#fff;
  color:var(--ve-azul);
  border-radius:999px;
  padding:9px 13px;
  font-size:13px;
  font-weight:800;
  cursor:pointer;
}

#app-vacunacion-especial .ve-filtros button:hover,
#app-vacunacion-especial .ve-chip:hover,
#app-vacunacion-especial .ve-btn:hover{
  background:var(--ve-celeste);
  border-color:#b9d6e9;
}

#app-vacunacion-especial .ve-filtros button.activo,
#app-vacunacion-especial .ve-filtros button.active,
#app-vacunacion-especial .ve-chip.activo,
#app-vacunacion-especial .ve-btn.activo{
  background:var(--ve-azul-2);
  color:#fff;
  border-color:var(--ve-azul-2);
}

/* SELECTOR MULTIPLE */

#app-vacunacion-especial .ve-selector-multiple{
  display:block !important;
  margin-top:18px;
}

#app-vacunacion-especial .ve-selector-multiple p{
  margin:0 0 12px;
  color:var(--ve-azul);
  font-size:15px;
  font-weight:800;
}

#app-vacunacion-especial #veChecklist{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:10px;
}

#app-vacunacion-especial #veChecklist label,
#app-vacunacion-especial .ve-check-item{
  display:flex;
  gap:10px;
  align-items:flex-start;
  background:#fff;
  border:1px solid var(--ve-borde);
  border-radius:14px;
  padding:12px 13px;
  font-size:14px;
  line-height:1.35;
  cursor:pointer;
  box-shadow:0 4px 12px rgba(15,23,42,.04);
}

#app-vacunacion-especial #veChecklist input{
  margin-top:2px;
  accent-color:var(--ve-azul-2);
}

/* RESULTADOS */

#app-vacunacion-especial #veResultados{
  display:block !important;
  margin-top:22px;
}

#app-vacunacion-especial #veResultados .ve-card,
#app-vacunacion-especial .ve-resumen,
#app-vacunacion-especial .ve-panel,
#app-vacunacion-especial .ve-resultado-box{
  display:block !important;
  width:100% !important;
  max-width:none !important;
  background:#fff;
  border:1px solid var(--ve-borde);
  border-radius:22px;
  padding:20px;
  box-shadow:0 10px 28px rgba(15,23,42,.07);
  margin-bottom:18px;
  box-sizing:border-box;
}

#app-vacunacion-especial #veResultados h3,
#app-vacunacion-especial .ve-resumen h3,
#app-vacunacion-especial .ve-panel h3{
  margin:0 0 14px;
  color:var(--ve-azul);
  font-size:24px;
  line-height:1.2;
  font-weight:850;
}

/* KPIS */

#app-vacunacion-especial .ve-resumen-kpi{
  display:flex;
  flex-wrap:wrap;
  gap:8px;
  margin:8px 0 18px;
}

#app-vacunacion-especial .ve-kpi,
#app-vacunacion-especial .ve-contador,
#app-vacunacion-especial .ve-badge{
  display:inline-flex;
  align-items:center;
  gap:6px;
  border-radius:999px;
  background:var(--ve-celeste);
  color:var(--ve-azul-2);
  padding:7px 11px;
  font-size:12px;
  font-weight:850;
}

/* GRILLA REAL DE VACUNAS */

#app-vacunacion-especial .ve-vacunas-grid{
  display:grid !important;
  grid-template-columns:repeat(2,minmax(0,1fr)) !important;
  gap:18px !important;
  align-items:stretch !important;
  width:100% !important;
  max-width:none !important;
  box-sizing:border-box !important;
}

/* TARJETA DE VACUNA */

#app-vacunacion-especial .ve-vacunas-grid > .ve-vacuna-card,
#app-vacunacion-especial .ve-vacuna-card{
  position:relative;
  display:block !important;
  width:100% !important;
  max-width:none !important;
  min-width:0 !important;
  margin:0 !important;
  box-sizing:border-box !important;
  background:#fff;
  border:1px solid var(--ve-borde);
  border-radius:18px;
  padding:18px;
  box-shadow:0 7px 18px rgba(15,23,42,.06);
  overflow:visible;
  word-break:normal !important;
  overflow-wrap:break-word !important;
  white-space:normal !important;
}

#app-vacunacion-especial .ve-vacuna-card h4{
  margin:0 0 14px;
  color:var(--ve-azul);
  font-size:20px;
  line-height:1.25;
  font-weight:850;
  word-break:normal !important;
  overflow-wrap:break-word !important;
}

#app-vacunacion-especial .ve-vacuna-card p,
#app-vacunacion-especial .ve-meta{
  margin:8px 0;
  font-size:14px;
  line-height:1.5;
  color:#475569;
  word-break:normal !important;
  overflow-wrap:break-word !important;
}

#app-vacunacion-especial .ve-vacuna-card strong{
  color:#0f172a;
  font-weight:850;
}

/* CAMPOS INTERNOS */

#app-vacunacion-especial .ve-field,
#app-vacunacion-especial .ve-vacuna-linea{
  background:#f8fafc;
  border:1px solid #e2e8f0;
  border-radius:12px;
  padding:10px 12px;
  margin:10px 0;
  font-size:13.5px;
  line-height:1.45;
  color:#334155;
  word-break:normal !important;
  overflow-wrap:break-word !important;
}

#app-vacunacion-especial .ve-alerta{
  background:#fff7ed;
  border:1px solid #fed7aa;
  border-radius:12px;
  padding:10px 12px;
  margin:10px 0;
  font-size:13px;
  line-height:1.45;
  color:#7c2d12;
}

#app-vacunacion-especial .ve-alerta-roja{
  background:#fff1f2;
  border:1px solid #fecdd3;
  color:#9f1239;
  border-radius:14px;
  padding:12px 14px;
  margin:8px 0 14px;
  font-size:13.5px;
}

/* DETAILS */

#app-vacunacion-especial details{
  border-top:1px solid #e2e8f0;
  margin-top:12px;
  padding-top:10px;
}

#app-vacunacion-especial summary{
  cursor:pointer;
  color:#005c97;
  font-weight:850;
  font-size:13.5px;
}

/* VACUNAS VIVAS */

#app-vacunacion-especial .ve-vacuna-viva{
  background:var(--ve-rojo-fondo) !important;
  border:1px solid var(--ve-rojo-borde) !important;
}

#app-vacunacion-especial .ve-vacuna-viva h4{
  color:var(--ve-rojo) !important;
}

#app-vacunacion-especial .ve-vacuna-viva::before{
  content:"🔴 VACUNA VIVA ATENUADA";
  display:inline-block;
  width:auto;
  max-width:100%;
  margin-bottom:10px;
  padding:5px 11px;
  border-radius:999px;
  background:#d32f2f;
  color:#fff;
  font-size:11.5px;
  font-weight:850;
  letter-spacing:.02em;
  white-space:normal;
}

/* OBSERVACIONES */

#app-vacunacion-especial .ve-notas,
#app-vacunacion-especial .ve-observaciones{
  background:#f8fafc;
  border:1px solid #e2e8f0;
  border-radius:16px;
  padding:14px 16px;
  margin-top:16px;
}

#app-vacunacion-especial .ve-notas ul,
#app-vacunacion-especial .ve-observaciones ul{
  margin:8px 0 0 18px;
  padding:0;
}

#app-vacunacion-especial .ve-notas li,
#app-vacunacion-especial .ve-observaciones li{
  margin:5px 0;
  color:#475569;
  font-size:13.5px;
  line-height:1.45;
}

/* ESTADO VACÍO */

#app-vacunacion-especial .ve-vacio,
#app-vacunacion-especial .ve-empty{
  background:#fff;
  border:1px dashed #cbd5e1;
  color:var(--ve-muted);
  border-radius:16px;
  padding:18px;
  text-align:center;
  font-size:14px;
}

/* BÚSQUEDA RÁPIDA */

#app-vacunacion-especial #veBusquedaRapida{
  margin-top:18px;
}

#app-vacunacion-especial .ve-rapida-titulo{
  font-size:16px;
  font-weight:850;
  color:var(--ve-azul);
  margin:0 0 10px;
}

#app-vacunacion-especial .ve-rapida-ayuda{
  font-size:13px;
  color:var(--ve-muted);
  margin-bottom:12px;
}

#app-vacunacion-especial .ve-rapida-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:14px;
}

#app-vacunacion-especial .ve-rapida-card{
  background:#fff;
  border:1px solid var(--ve-borde);
  border-radius:18px;
  padding:16px;
  box-shadow:0 6px 16px rgba(15,23,42,.06);
}

#app-vacunacion-especial .ve-rapida-card h4{
  margin:0 0 8px;
  color:var(--ve-azul);
  font-size:17px;
  font-weight:850;
  line-height:1.3;
}

#app-vacunacion-especial .ve-rapida-grupo{
  display:inline-block;
  background:var(--ve-celeste);
  color:var(--ve-azul-2);
  border-radius:999px;
  padding:5px 10px;
  font-size:12px;
  font-weight:850;
  margin-bottom:10px;
}

#app-vacunacion-especial .ve-rapida-vacunas{
  font-size:13.5px;
  color:#475569;
  line-height:1.5;
  margin:8px 0 10px;
}

#app-vacunacion-especial .ve-rapida-ref{
  font-size:12.5px;
  color:var(--ve-muted);
  margin-bottom:12px;
}

#app-vacunacion-especial .ve-rapida-card button{
  border:none;
  background:var(--ve-azul-2);
  color:#fff;
  border-radius:999px;
  padding:9px 14px;
  font-weight:850;
  font-size:13px;
  cursor:pointer;
}

/* RESPONSIVE */

@media(max-width:980px){
  #app-vacunacion-especial .ve-header{
    padding:30px 22px;
  }

  #app-vacunacion-especial .ve-header h1,
  #app-vacunacion-especial .ve-header h2{
    font-size:29px;
  }

  #app-vacunacion-especial #veChecklist{
    grid-template-columns:repeat(2,minmax(0,1fr));
  }

  #app-vacunacion-especial .ve-vacunas-grid{
    grid-template-columns:1fr !important;
  }
}

@media(max-width:768px){
  #app-vacunacion-especial{
    border-radius:18px;
    margin:16px auto;
  }

  #app-vacunacion-especial .ve-header{
    border-radius:18px 18px 0 0;
    padding:26px 18px;
  }

  #app-vacunacion-especial .ve-header h1,
  #app-vacunacion-especial .ve-header h2{
    font-size:25px;
  }

  #app-vacunacion-especial .ve-buscador,
  #app-vacunacion-especial .ve-selector-multiple,
  #app-vacunacion-especial .ve-filtros,
  #app-vacunacion-especial #veResultados,
  #app-vacunacion-especial #veBusquedaRapida{
    padding-left:14px;
    padding-right:14px;
  }

  #app-vacunacion-especial .ve-buscador-wrap{
    flex-direction:column;
    align-items:stretch;
  }

  #app-vacunacion-especial #veLimpiarBusqueda{
    width:100%;
  }

  #app-vacunacion-especial #veChecklist{
    grid-template-columns:1fr;
  }

  #app-vacunacion-especial .ve-vacuna-card{
    padding:15px;
  }
}
</style><script>document.addEventListener("DOMContentLoaded", function () {

  const chat = document.getElementById("pniChat");
  const options = document.getElementById("pniOptions");
  const reset = document.getElementById("pniReset");
  const typing = document.getElementById("pniTyping");
  const input = document.getElementById("pniUserInput");
  const send = document.getElementById("pniSend");

  if (!chat || !options || !reset) return;

  let pendingTimer = null;

  const URLS = {
    puestaDia: "https://vacunas.minsal.cl/calculadora-puesta-al-dia/",
    vacunacionEspecial: "https://vacunas.minsal.cl/resumen-de-vacunacion-especial-ve/",
    calendario: "https://vacunas.minsal.cl/calendario-pni-interactivo/",
    excursion: "https://vacunas.minsal.cl/evaluacion-de-excursiones-de-temperatura/",
    influenza: "https://vacunas.minsal.cl/dashboard-campana-vacunacion-influenza/",
    documentos: "https://vacunas.minsal.cl/calendarios-de-vacunacion/",
    marcoRegulatorio: "https://vacunas.minsal.cl/marco-regulatorio/"
  };

  let casoClinico = {
    activo: false,
    edad: null,
    condicion: null,
    subtipo: null
  };

  const CONDICIONES_GUIADAS = {
    asplenia: {
      etiqueta: "Asplenia / hiposplenia",
      palabrasGrupo: ["asplenia", "hiposplenia"],
      subtipos: [
        { id: "asplenia_adquirida", etiqueta: "Asplenia anatómica/adquirida", palabras: ["asplenia adquirida", "esplenectomia", "esplenectomía", "anatómica", "anatomica"] },
        { id: "asplenia_funcional", etiqueta: "Asplenia funcional / hiposplenia", palabras: ["funcional", "hiposplenia", "disfuncion esplenica", "disfunción esplénica"] },
        { id: "asplenia_congenita", etiqueta: "Asplenia congénita", palabras: ["congenita", "congénita"] },
        { id: "asplenia_no_seguro", etiqueta: "No estoy seguro/a", palabras: [] }
      ]
    },
    vih: {
      etiqueta: "VIH",
      palabrasGrupo: ["vih"],
      subtipos: [
        { id: "vih_adulto", etiqueta: "Adolescente o adulto con VIH", palabras: ["adulto", "adolescente", "18", "mayor"] },
        { id: "vih_pediatrico", etiqueta: "Paciente pediátrico con VIH adquirido vertical", palabras: ["pediatrico", "pediátrico", "niño", "niña", "vertical"] },
        { id: "vih_expuesto", etiqueta: "Lactante expuesto a VIH durante la gestación", palabras: ["lactante", "expuesto", "gestacion", "gestación"] },
        { id: "vih_no_seguro", etiqueta: "No estoy seguro/a", palabras: [] }
      ]
    },
    tph: {
      etiqueta: "TPH",
