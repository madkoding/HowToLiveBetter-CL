<script>
function addEa11yLabel() {
  const widget = document.querySelector('#ea11y-root');

  if (!widget || document.querySelector('.ea11y-label')) return;

  const label = document.createElement('div');
  label.className = 'ea11y-label';
  label.innerText = 'Herramientas de accesibilidad';

  label.style.position = 'fixed';
  label.style.top = 'calc(50vh - 55px)';
  label.style.right = '24px';
  label.style.background = '#1C4474';
  label.style.color = '#fff';
  label.style.padding = '6px 10px';
  label.style.borderRadius = '6px';
  label.style.fontSize = '12px';
  label.style.zIndex = '9999999';

  document.body.appendChild(label);
}

// Espera a que el widget cargue
setInterval(addEa11yLabel, 1000);
</script>

