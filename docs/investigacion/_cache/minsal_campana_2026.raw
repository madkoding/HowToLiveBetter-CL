				<div class="elementor-element elementor-element-e97e6e9 elementor-widget elementor-widget-image" data-id="e97e6e9" data-element_type="widget" data-e-type="widget" data-widget_type="image.default">
				<div class="elementor-widget-container">
																<a href="https://saludresponde.minsal.cl/" target="_blank">
							<img loading="lazy" decoding="async" width="320" height="100" src="https://www.minsal.cl/wp-content/uploads/2025/11/banner-lateral_salud-responde.png" class="attachment-full size-full wp-image-136847" alt="" srcset="https://www.minsal.cl/wp-content/uploads/2025/11/banner-lateral_salud-responde.png 320w, https://www.minsal.cl/wp-content/uploads/2025/11/banner-lateral_salud-responde-300x94.png 300w" sizes="(max-width: 320px) 100vw, 320px" />								</a>
