				<div data-elementor-type="single-post" data-elementor-id="21" class="elementor elementor-21 elementor-location-single post-569 post type-post status-publish format-standard has-post-thumbnail hentry category-vacunas-e-inmunizacion" data-elementor-post-type="elementor_library">
			<div class="elementor-element elementor-element-67c31d05 e-flex e-con-boxed e-con e-parent" data-id="67c31d05" data-element_type="container">
					<div class="e-con-inner">
		<div class="elementor-element elementor-element-1e3ad9ec e-con-full e-flex e-con e-child" data-id="1e3ad9ec" data-element_type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
				<div class="elementor-element elementor-element-51da2efc elementor-widget__width-inherit elementor-widget elementor-widget-theme-post-featured-image elementor-widget-image" data-id="51da2efc" data-element_type="widget" data-widget_type="theme-post-featured-image.default">
															<img src="https://saludresponde.minsal.cl/wp-content/uploads/2025/08/calendario-vacunacion-2026-e1785847791932.png" title="calendario-vacunación-2026" alt="calendario-vacunación-2026" loading="lazy" />															</div>
				<div class="elementor-element elementor-element-1102a365 elementor-widget elementor-widget-post-info" data-id="1102a365" data-element_type="widget" data-widget_type="post-info.default">
							<ul class="elementor-inline-items elementor-icon-list-items elementor-post-info">
								<li class="elementor-icon-list-item elementor-repeater-item-6742635 elementor-inline-item" itemprop="datePublished">
										<span class="elementor-icon-list-icon">
								<svg aria-hidden="true" class="e-font-icon-svg e-fas-calendar" viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg"><path d="M12 192h424c6.6 0 12 5.4 12 12v260c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V204c0-6.6 5.4-12 12-12zm436-44v-36c0-26.5-21.5-48-48-48h-48V12c0-6.6-5.4-12-12-12h-40c-6.6 0-12 5.4-12 12v52H160V12c0-6.6-5.4-12-12-12h-40c-6.6 0-12 5.4-12 12v52H48C21.5 64 0 85.5 0 112v36c0 6.6 5.4 12 12 12h424c6.6 0 12-5.4 12-12z"></path></svg>							</span>
									<span class="elementor-icon-list-text elementor-post-info__item elementor-post-info__item--type-date">
